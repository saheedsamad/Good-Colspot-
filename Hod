<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Profile</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#eef3fb;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#6b7280;
      --line:#e5e7eb;
      --blue:#2563eb;
      --blue2:#3b82f6;
      --soft-blue:#eaf1ff;
      --danger:#d94b69;
      --danger-bg:#fdecef;
      --success:#2f9e44;
      --success-bg:#e7f7ea;
      --shadow:0 18px 40px rgba(15,23,42,.10);
      --soft-shadow:0 12px 28px rgba(37,99,235,.14);
      --radius:28px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:linear-gradient(180deg,#eaf0fa 0%, #eef3fb 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:18px 14px 110px;
      position:relative;
    }

    .profile-shell{
      background:#f8fbff;
      border-radius:30px;
      overflow:hidden;
      border:1px solid #dde6f4;
      box-shadow:var(--shadow);
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:20px 18px 14px;
      background:#ffffff;
      border-bottom:1px solid #edf2f7;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-icon{
      width:38px;
      height:38px;
      border-radius:12px;
      background:linear-gradient(135deg,#60a5fa,#2563eb);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:22px;
      font-weight:900;
      box-shadow:0 10px 20px rgba(37,99,235,.25);
      flex-shrink:0;
    }

    .brand-name{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    .logout-btn{
      border:none;
      background:#fff;
      border-radius:999px;
      padding:10px 16px;
      font-size:13px;
      font-weight:800;
      color:#111827;
      box-shadow:0 8px 18px rgba(15,23,42,.08);
      cursor:pointer;
      border:1px solid #e5e7eb;
    }

    .banner{
      min-height:150px;
      background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,.45) 0 10%, transparent 11%),
        radial-gradient(circle at 85% 15%, rgba(255,255,255,.35) 0 8%, transparent 9%),
        linear-gradient(135deg,#dbeafe 0%, #c7d2fe 58%, #f5d0fe 100%);
      padding:18px 18px 78px;
    }

    .banner-title{
      font-size:17px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    .profile-card{
      background:#fff;
      margin:-58px 14px 14px;
      border:1px solid #e8edf4;
      border-radius:28px;
      padding:16px;
      box-shadow:0 14px 28px rgba(15,23,42,.08);
      position:relative;
    }

    .profile-top{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      margin-top:-76px;
      margin-bottom:14px;
    }

    .avatar-ring{
      width:138px;
      height:138px;
      border-radius:999px;
      padding:6px;
      background:#fff;
      box-shadow:0 10px 25px rgba(15,23,42,.08);
      border:1px solid #ececec;
    }

    .avatar{
      width:100%;
      height:100%;
      border-radius:999px;
      background:linear-gradient(135deg,#9ec5ff,#4c7ef3);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:46px;
      font-weight:900;
      overflow:hidden;
    }

    .avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .profile-name{
      margin-top:14px;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    .profile-role{
      font-size:13px;
      color:#5b6472;
      margin-top:2px;
    }

    .profile-school{
      font-size:14px;
      color:#374151;
      margin-top:10px;
      font-weight:500;
    }

    .status-pill{
      margin-top:12px;
      padding:8px 18px;
      border-radius:999px;
      background:var(--success-bg);
      color:var(--success);
      font-size:13px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:7px;
      min-width:120px;
      justify-content:center;
    }

    .status-pill.disabled{
      background:#fef2f2;
      color:#b91c1c;
    }

    .status-dot{
      width:10px;
      height:10px;
      border-radius:999px;
      background:currentColor;
      opacity:.9;
    }

    .divider{
      height:1px;
      background:#eef2f7;
      margin:16px 0;
    }

    .info-group{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .info-row{
      display:flex;
      align-items:flex-start;
      gap:12px;
    }

    .info-icon{
      width:32px;
      height:32px;
      border-radius:999px;
      background:#eef3ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .info-icon svg{
      width:16px;
      height:16px;
      stroke:#5b6ddc;
      stroke-width:1.9;
      fill:none;
    }

    .info-content{
      flex:1;
      min-width:0;
    }

    .info-value{
      font-size:14px;
      color:#1f2937;
      font-weight:600;
      line-height:1.4;
      word-break:break-word;
    }

    .info-note{
      font-size:12px;
      color:#6b7280;
      margin-top:5px;
      line-height:1.45;
    }

    .action-row{
      display:flex;
      gap:10px;
      margin-top:16px;
    }

    .action-btn{
      flex:1;
      border:none;
      border-radius:999px;
      min-height:48px;
      padding:0 16px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
    }

    .action-btn svg{
      width:17px;
      height:17px;
      stroke:currentColor;
      stroke-width:2;
      fill:none;
      flex-shrink:0;
    }

    .action-btn.primary{
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      color:#fff;
      box-shadow:var(--soft-shadow);
    }

    .action-btn.danger{
      background:var(--danger-bg);
      color:var(--danger);
      border:1px solid #f8cfd8;
    }

    .action-btn.success{
      background:#eaf8ee;
      color:#1f8f45;
      border:1px solid #c8ebd3;
    }

    .section{
      padding:0 14px 14px;
    }

    .section-title{
      font-size:15px;
      font-weight:900;
      color:#111827;
      letter-spacing:-.02em;
      margin:0 0 10px;
    }

    .activity-card{
      background:#fff;
      border:1px solid #e8edf4;
      border-radius:24px;
      padding:12px;
      box-shadow:0 12px 25px rgba(15,23,42,.06);
    }

    .activity-list{
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .activity-item{
      display:flex;
      align-items:flex-start;
      gap:12px;
      padding:10px 6px;
    }

    .activity-item + .activity-item{
      border-top:1px solid #f1f5f9;
    }

    .activity-icon{
      width:38px;
      height:38px;
      border-radius:14px;
      background:#eef4ff;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#2563eb;
      flex-shrink:0;
    }

    .activity-icon svg{
      width:18px;
      height:18px;
      stroke:currentColor;
      stroke-width:2;
      fill:none;
    }

    .activity-body{
      flex:1;
      min-width:0;
    }

    .activity-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
    }

    .activity-title{
      font-size:14px;
      font-weight:800;
      color:#111827;
      line-height:1.35;
    }

    .activity-time{
      font-size:12px;
      color:#6b7280;
      white-space:nowrap;
    }

    .activity-sub{
      margin-top:4px;
      font-size:13px;
      color:#6b7280;
      line-height:1.4;
    }

    .empty{
      padding:16px 10px;
      text-align:center;
      color:#6b7280;
      font-size:13px;
    }

    .message{
      margin:0 14px 14px;
      padding:12px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      display:none;
    }

    .message.show{
      display:block;
    }

    .message.success{
      background:#ecfdf3;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .message.error{
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .modal{
      position:fixed;
      inset:0;
      background:rgba(15,23,42,.45);
      display:none;
      align-items:center;
      justify-content:center;
      padding:16px;
      z-index:200;
    }

    .modal.show{
      display:flex;
    }

    .modal-card{
      width:100%;
      max-width:360px;
      background:#fff;
      border-radius:24px;
      padding:18px;
      box-shadow:0 18px 40px rgba(15,23,42,.18);
    }

    .modal-title{
      font-size:17px;
      font-weight:900;
      color:#111827;
      margin-bottom:8px;
    }

    .modal-text{
      font-size:13px;
      color:#6b7280;
      line-height:1.5;
      margin-bottom:14px;
    }

    .reset-result{
      background:#f8fbff;
      border:1px solid #dde8ff;
      border-radius:18px;
      padding:12px;
      margin-bottom:14px;
      display:none;
    }

    .reset-result.show{
      display:block;
    }

    .reset-line{
      margin-bottom:8px;
    }

    .reset-line:last-child{
      margin-bottom:0;
    }

    .reset-label{
      display:block;
      font-size:11px;
      color:#6b7280;
      margin-bottom:3px;
    }

    .reset-value{
      font-size:14px;
      font-weight:800;
      color:#111827;
      word-break:break-word;
    }

    .modal-actions{
      display:flex;
      gap:10px;
    }

    .modal-btn{
      flex:1;
      border:none;
      border-radius:999px;
      min-height:46px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
    }

    .modal-btn.secondary{
      background:#fff;
      color:#111827;
      border:1px solid #e5e7eb;
    }

    .modal-btn.primary{
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      color:#fff;
    }

    .modal-btn.danger{
      background:#fee2e2;
      color:#b91c1c;
      border:1px solid #fecaca;
    }

    @media (max-width:360px){
      .action-row,
      .modal-actions{
        flex-direction:column;
      }

      .profile-name{
        font-size:17px;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="profile-shell">
      <div class="topbar">
        <div class="brand">
          <div class="brand-icon">C</div>
          <div class="brand-name">Colspot</div>
        </div>
        <button class="logout-btn" id="logoutBtn" type="button">Logout</button>
      </div>

      <div class="banner">
        <div class="banner-title">HOS Profile</div>
      </div>

      <div class="message" id="pageMessage"></div>

      <div class="profile-card">
        <div class="profile-top">
          <div class="avatar-ring">
            <div class="avatar" id="profileAvatar">H</div>
          </div>

          <div class="profile-name" id="profileName">Loading...</div>
          <div class="profile-role">Head of School</div>
          <div class="profile-school" id="profileSchool">School</div>

          <div class="status-pill" id="statusPill">
            <span class="status-dot"></span>
            <span id="statusText">Active</span>
          </div>
        </div>

        <div class="divider"></div>

        <div class="info-group">
          <div class="info-row">
            <div class="info-icon">
              <svg viewBox="0 0 24 24">
                <path d="M7 10V7a5 5 0 0 1 10 0v3"></path>
                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
              </svg>
            </div>
            <div class="info-content">
              <div class="info-value" id="loginIdValue">-</div>
            </div>
          </div>

          <div class="info-row">
            <div class="info-icon">
              <svg viewBox="0 0 24 24">
                <path d="M4 6h16v12H4z"></path>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
            </div>
            <div class="info-content">
              <div class="info-value" id="emailValue">No linked email</div>
            </div>
          </div>

          <div class="divider"></div>

          <div class="info-row">
            <div class="info-icon">
              <svg viewBox="0 0 24 24">
                <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
                <circle cx="12" cy="11" r="2.5"></circle>
              </svg>
            </div>
            <div class="info-content">
              <div class="info-value" id="schoolInfoValue">School</div>
              <div class="info-note">School account profile and administration access.</div>
            </div>
          </div>
        </div>

        <div class="action-row">
          <button class="action-btn primary" id="resetLoginBtn" type="button">
            <svg viewBox="0 0 24 24">
              <path d="M12 3a9 9 0 1 0 8.2 5.3"></path>
              <path d="M21 3v6h-6"></path>
            </svg>
            <span>Reset Login</span>
          </button>

          <button class="action-btn danger" id="toggleStatusBtn" type="button">
            <svg viewBox="0 0 24 24">
              <path d="M12 9v4"></path>
              <path d="M12 17h.01"></path>
              <path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"></path>
            </svg>
            <span id="toggleStatusText">Disable HOS</span>
          </button>
        </div>
      </div>

      <div class="section">
        <h3 class="section-title">Activity Log</h3>

        <div class="activity-card">
          <div class="activity-list" id="activityList">
            <div class="empty">Loading activity...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal" id="resetModal">
    <div class="modal-card">
      <div class="modal-title">Reset login</div>
      <div class="modal-text">
        Generate a new temporary password for this HOS account. Share it securely.
      </div>

      <div class="reset-result" id="resetResult">
        <div class="reset-line">
          <span class="reset-label">Login ID</span>
          <div class="reset-value" id="resetLoginId">-</div>
        </div>
        <div class="reset-line">
          <span class="reset-label">Temporary password</span>
          <div class="reset-value" id="resetPassword">-</div>
        </div>
      </div>

      <div class="modal-actions">
        <button class="modal-btn secondary" id="closeResetModalBtn" type="button">Close</button>
        <button class="modal-btn primary" id="confirmResetBtn" type="button">Generate</button>
      </div>
    </div>
  </div>

  <div class="modal" id="statusModal">
    <div class="modal-card">
      <div class="modal-title" id="statusModalTitle">Disable HOS</div>
      <div class="modal-text" id="statusModalText">
        This HOS will not be able to log in until enabled again.
      </div>

      <div class="modal-actions">
        <button class="modal-btn secondary" id="closeStatusModalBtn" type="button">Cancel</button>
        <button class="modal-btn danger" id="confirmStatusBtn" type="button">Disable</button>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
      const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
      const EDGE_BASE = `${SUPABASE_URL}/functions/v1`;

      const EDGE = {
        resetHosLogin: "reset-hos-login",
        toggleHosStatus: "toggle-hos-status"
      };

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const $ = (id) => document.getElementById(id);

      let hosSession = null;
      let hosData = null;

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function showMessage(text = "", type = "error") {
        const box = $("pageMessage");
        if (!text) {
          box.className = "message";
          box.textContent = "";
          return;
        }
        box.className = `message show ${type}`;
        box.textContent = text;
      }

      function formatDate(value) {
        if (!value) return "";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "";
        return d.toLocaleString([], {
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        });
      }

      function getAdminSession() {
        try {
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        } catch {
          return null;
        }
      }

      function getInitial(name) {
        return String(name || "").trim().charAt(0).toUpperCase() || "H";
      }

      async function invokeEdge(name, payload = {}) {
        const res = await fetch(`${EDGE_BASE}/${name}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "apikey": SUPABASE_ANON_KEY,
            "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
          },
          body: JSON.stringify(payload)
        });

        const result = await res.json().catch(() => ({}));

        if (!res.ok || !result.ok) {
          throw new Error(result.error || `Edge function failed: ${name}`);
        }

        return result;
      }

      function requireHosSession() {
        hosSession = getAdminSession();

        if (!hosSession || String(hosSession.role || "").toLowerCase() !== "hos") {
          window.location.href = "index.html";
          return false;
        }

        return true;
      }

      function renderProfile(data) {
        hosData = data;

        const fullName = data.full_name || "HOS User";
        const schoolName = data.school_name || "School";
        const loginId = data.login_id || "-";
        const linkedEmail = data.linked_email || "No linked email";
        const isActive = !!data.is_active;

        $("profileAvatar").textContent = getInitial(fullName);
        $("profileName").textContent = fullName;
        $("profileSchool").textContent = schoolName;
        $("loginIdValue").textContent = `Login ID: ${loginId}`;
        $("emailValue").textContent = linkedEmail;
        $("schoolInfoValue").textContent = schoolName;

        $("statusText").textContent = isActive ? "Active" : "Disabled";
        $("statusPill").className = isActive ? "status-pill" : "status-pill disabled";

        $("toggleStatusText").textContent = isActive ? "Disable HOS" : "Enable HOS";
        $("statusModalTitle").textContent = isActive ? "Disable HOS" : "Enable HOS";
        $("statusModalText").textContent = isActive
          ? "This HOS will not be able to log in until enabled again."
          : "This HOS account will be allowed to log in again.";
        $("confirmStatusBtn").textContent = isActive ? "Disable" : "Enable";
        $("confirmStatusBtn").className = isActive ? "modal-btn danger" : "modal-btn primary";
      }

      async function loadHosProfile() {
        showMessage("", "error");

        try {
          const { data, error } = await sb
            .from("hos_accounts")
            .select("id, full_name, school_name, login_id, linked_email, is_active, created_at")
            .eq("id", hosSession.id)
            .maybeSingle();

          if (error) throw error;
          if (!data) throw new Error("HOS profile not found.");

          renderProfile(data);
        } catch (err) {
          console.error("loadHosProfile error:", err);
          showMessage(err.message || "Could not load HOS profile.");
        }
      }

      async function loadActivity() {
        const wrap = $("activityList");
        wrap.innerHTML = '<div class="empty">Loading activity...</div>';

        try {
          const { data, error } = await sb
            .from("admin_activity_log")
            .select("title, description, created_at, type")
            .eq("created_by", hosSession.id)
            .order("created_at", { ascending: false })
            .limit(10);

          if (error) {
            wrap.innerHTML = '<div class="empty">No activity found yet.</div>';
            return;
          }

          if (!data || !data.length) {
            wrap.innerHTML = '<div class="empty">No activity found yet.</div>';
            return;
          }

          wrap.innerHTML = data.map((item) => {
            const icon = item.type === "announcement"
              ? `<svg viewBox="0 0 24 24"><path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path></svg>`
              : `<svg viewBox="0 0 24 24"><path d="M12 5v14"></path><path d="M5 12h14"></path><rect x="4" y="4" width="16" height="16" rx="3"></rect></svg>`;

            return `
              <div class="activity-item">
                <div class="activity-icon">${icon}</div>
                <div class="activity-body">
                  <div class="activity-head">
                    <div class="activity-title">${escapeHtml(item.title || "Activity")}</div>
                    <div class="activity-time">${escapeHtml(formatDate(item.created_at))}</div>
                  </div>
                  <div class="activity-sub">${escapeHtml(item.description || "")}</div>
                </div>
              </div>
            `;
          }).join("");
        } catch (err) {
          console.error("loadActivity error:", err);
          wrap.innerHTML = '<div class="empty">Could not load activity.</div>';
        }
      }

      function openResetModal() {
        $("resetModal").classList.add("show");
        $("resetResult").classList.remove("show");
        $("resetLoginId").textContent = hosData?.login_id || "-";
        $("resetPassword").textContent = "-";
      }

      function closeResetModal() {
        $("resetModal").classList.remove("show");
      }

      function openStatusModal() {
        $("statusModal").classList.add("show");
      }

      function closeStatusModal() {
        $("statusModal").classList.remove("show");
      }

      async function resetHosLogin() {
        const btn = $("confirmResetBtn");
        btn.disabled = true;
        btn.textContent = "Generating...";

        try {
          const result = await invokeEdge(EDGE.resetHosLogin, {
            hos_id: hosSession.id
          });

          $("resetLoginId").textContent = result?.account?.login_id || hosData?.login_id || "-";
          $("resetPassword").textContent = result?.temporary_password || "-";
          $("resetResult").classList.add("show");

          showMessage("Login reset successfully.", "success");
          await loadHosProfile();
          await loadActivity();
        } catch (err) {
          console.error("resetHosLogin error:", err);
          showMessage(err.message || "Could not reset login.");
        } finally {
          btn.disabled = false;
          btn.textContent = "Generate";
        }
      }

      async function toggleHosStatus() {
        const btn = $("confirmStatusBtn");
        btn.disabled = true;

        try {
          const result = await invokeEdge(EDGE.toggleHosStatus, {
            hos_id: hosSession.id,
            enable: !hosData?.is_active
          });

          showMessage(result.message || "Status updated successfully.", "success");
          closeStatusModal();
          await loadHosProfile();
          await loadActivity();
        } catch (err) {
          console.error("toggleHosStatus error:", err);
          showMessage(err.message || "Could not update account status.");
        } finally {
          btn.disabled = false;
        }
      }

      function logout() {
        localStorage.removeItem("colspot_admin_session");
        localStorage.removeItem("colspot_pending_admin");
        window.location.href = "index.html";
      }

      document.addEventListener("DOMContentLoaded", async () => {
        if (!requireHosSession()) return;

        $("logoutBtn").addEventListener("click", logout);
        $("resetLoginBtn").addEventListener("click", openResetModal);
        $("toggleStatusBtn").addEventListener("click", openStatusModal);

        $("closeResetModalBtn").addEventListener("click", closeResetModal);
        $("confirmResetBtn").addEventListener("click", resetHosLogin);

        $("closeStatusModalBtn").addEventListener("click", closeStatusModal);
        $("confirmStatusBtn").addEventListener("click", toggleHosStatus);

        $("resetModal").addEventListener("click", (e) => {
          if (e.target.id === "resetModal") closeResetModal();
        });

        $("statusModal").addEventListener("click", (e) => {
          if (e.target.id === "statusModal") closeStatusModal();
        });

        await loadHosProfile();
        await loadActivity();
      });
    })();
  </script>
</body>
</html>
