console.log("Supabase URL =", window.SUPABASE_URL || window.supabaseUrl || "not exposed");


(async () => {
  try {
    const sb = window.supabase;
    if (!sb) {
      console.log("Supabase client is missing on this page");
      return;
    }

    const { data, error } = await sb
      .from("schools")
      .select("id, name, short_code, is_active")
      .order("name", { ascending: true });

    console.log("schools data:", data);
    console.log("schools error:", error);
  } catch (e) {
    console.error("schools query crashed:", e);
  }
})();


