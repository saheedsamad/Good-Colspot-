import { serve } from "https://deno.land/std@0.224.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

function json(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json",
    },
  });
}

function mustEnv(name: string) {
  const value = Deno.env.get(name);
  if (!value) throw new Error(`Missing env: ${name}`);
  return value;
}

function cleanText(value: unknown) {
  return String(value || "").trim();
}

function normalizeSchoolName(value: unknown) {
  return String(value || "")
    .trim()
    .replace(/\s+/g, " ")
    .toUpperCase()
    .replace(/,\s*ADO-EKITI$/i, "");
}

serve(async (req) => {
  try {
    if (req.method === "OPTIONS") {
      return json({ ok: true });
    }

    if (req.method !== "POST") {
      return json({ ok: false, error: "POST only" }, 405);
    }

    const sb = createClient(
      mustEnv("SUPABASE_URL"),
      mustEnv("SUPABASE_SERVICE_ROLE_KEY"),
      { auth: { persistSession: false } }
    );

    const body = await req.json().catch(() => ({}));
    const hodId = cleanText(body.hod_id);
    const search = cleanText(body.search).toLowerCase();

    if (!hodId) {
      return json({ ok: false, error: "hod_id is required" }, 400);
    }

    const { data: hod, error: hodError } = await sb
      .from("hod_accounts")
      .select("id, full_name, school_name, department_name, login_id, is_active")
      .eq("id", hodId)
      .maybeSingle();

    if (hodError) {
      return json({ ok: false, error: hodError.message }, 500);
    }

    if (!hod) {
      return json({ ok: false, error: "HOD account not found." }, 404);
    }

    if (!hod.is_active) {
      return json({ ok: false, error: "This HOD account is disabled." }, 403);
    }

    const normalizedHodSchool = normalizeSchoolName(hod.school_name);
    if (!normalizedHodSchool) {
      return json({ ok: false, error: "HOD school name is missing." }, 400);
    }

    const { data: announcementRows, error: announcementError } = await sb
      .from("school_announcements")
      .select(`
        id,
        school_name,
        title,
        message,
        created_by_hod,
        created_at
      `)
      .eq("created_by_hod", hod.id)
      .order("created_at", { ascending: false });

    if (announcementError) {
      return json({ ok: false, error: announcementError.message }, 500);
    }

    let history = (announcementRows || [])
      .filter((row) => normalizeSchoolName(row.school_name) === normalizedHodSchool)
      .map((row) => ({
        id: row.id,
        action_type: "ANNOUNCEMENT_SENT",
        type: "Announcement",
        title: row.title || "-",
        description: row.message || "-",
        entity_type: "announcement",
        entity_id: row.id,
        payload: {
          announcement_id: row.id,
          school_name: row.school_name || "",
          created_by_hod: row.created_by_hod || null,
          department_name: hod.department_name || "",
        },
        created_at: row.created_at || null,
      }));

    if (search) {
      history = history.filter((item) => {
        const haystack = [
          item.title,
          item.description,
          item.type,
          item.action_type,
          item.entity_type,
          JSON.stringify(item.payload || {}),
        ]
          .join(" ")
          .toLowerCase();

        return haystack.includes(search);
      });
    }

    return json({
      ok: true,
      hod: {
        id: hod.id,
        full_name: hod.full_name,
        school_name: normalizedHodSchool,
        department_name: hod.department_name || "",
        login_id: hod.login_id,
      },
      totals: {
        history: history.length,
      },
      history,
    });
  } catch (e) {
    console.error("get-hod-history error:", e);
    return json({ ok: false, error: String(e) }, 500);
  }
});
