function getActorPayloadFromSession() {
  const keys = [
    "colspot_hos_session",
    "colspot_admin_session",
    "hos_session",
    "admin_session",
    "colspot_session"
  ];

  for (const key of keys) {
    const raw = localStorage.getItem(key);
    if (!raw) continue;

    try {
      const parsed = JSON.parse(raw);

      if (parsed?.hos_admin_id) return { hos_admin_id: parsed.hos_admin_id };
      if (parsed?.form_agent_id) return { form_agent_id: parsed.form_agent_id };

      if (parsed?.id && cleanText(parsed.role).toLowerCase() === "hos") {
