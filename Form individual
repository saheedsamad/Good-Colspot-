<section class="individual-view" id="individualView" style="display:none;">
  <div class="individual-shell">
    <article class="individual-list-card">
      <div class="individual-list-head">
        <div>
          <h3>Submitted Responses</h3>
          <p>View everyone that submitted this form.</p>
        </div>

        <button type="button" class="individual-refresh-btn" id="individualRefreshBtn">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 11a8 8 0 1 0 2 5.3M20 4v7h-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Refresh</span>
        </button>
      </div>

      <div class="individual-toolbar">
        <div class="individual-search-wrap">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 21L16.65 16.65M10.8 18.6A7.8 7.8 0 1 0 10.8 3a7.8 7.8 0 0 0 0 15.6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input
            type="text"
            id="individualSearchInput"
            placeholder="Search by name, programme or level"
            autocomplete="off"
          />
        </div>

        <div class="individual-filter-grid">
          <div class="individual-filter-box">
            <label for="individualProgrammeFilter">Programme</label>
            <select id="individualProgrammeFilter">
              <option value="">All Programmes</option>
            </select>
          </div>

          <div class="individual-filter-box">
            <label for="individualLevelFilter">Level</label>
            <select id="individualLevelFilter">
              <option value="">All Levels</option>
            </select>
          </div>
        </div>
      </div>

      <div class="individual-summary-strip">
        <div class="individual-mini-stat">
          <span>Total Submitted</span>
          <strong id="individualTotalCount">0</strong>
        </div>

        <div class="individual-mini-stat">
          <span>Filtered Result</span>
          <strong id="individualFilteredCount">0</strong>
        </div>
      </div>

      <div class="individual-list-wrap" id="individualListWrap">
        <div class="individual-empty-state" id="individualListEmpty">
          No submitted response found yet.
        </div>

        <div class="individual-list" id="individualList"></div>
      </div>
    </article>

    <article class="individual-detail-card">
      <div class="individual-detail-top">
        <div>
          <h3>Response Details</h3>
          <p>Click “View Details” on any submission to see full answers.</p>
        </div>
      </div>

      <div class="individual-detail-empty" id="individualDetailEmpty">
        Select a submitted response to view full details.
      </div>

      <div class="individual-detail-body" id="individualDetailBody" style="display:none;">
        <div class="individual-person-hero">
          <div class="individual-avatar" id="individualAvatar">A</div>

          <div class="individual-person-copy">
            <h4 id="individualPersonName">—</h4>
            <div class="individual-person-meta">
              <span id="individualPersonProgramme">—</span>
              <span class="dot">•</span>
              <span id="individualPersonLevel">—</span>
              <span class="dot">•</span>
              <span id="individualPersonSubmittedAt">—</span>
            </div>
          </div>
        </div>

        <div class="individual-detail-grid">
          <div class="individual-detail-stat">
            <span>Response ID</span>
            <strong id="individualResponseId">—</strong>
          </div>

          <div class="individual-detail-stat">
            <span>Identity</span>
            <strong id="individualIdentityMode">—</strong>
          </div>

          <div class="individual-detail-stat">
            <span>Answered</span>
            <strong id="individualAnsweredCount">0</strong>
          </div>

          <div class="individual-detail-stat">
            <span>Total Questions</span>
            <strong id="individualQuestionCount">0</strong>
          </div>
        </div>

        <div class="individual-answer-list" id="individualAnswerList"></div>
      </div>
    </article>
  </div>
</section>

