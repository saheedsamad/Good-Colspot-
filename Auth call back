<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Auth Callback</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1e40af;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --error: #dc2626;
      --success: #16a34a;
      --soft: #eef4ff;
      --warn-bg: #fff7ed;
      --warn-border: #fdba74;
      --warn-text: #9a3412;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    }

    html, body {
      height: 100%;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
      touch-action: manipulation;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px calc(env(safe-area-inset-bottom) + 16px);
      position: relative;
    }

    .container {
      width: 100%;
      max-width: 420px;
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 12px 6px 0;
      margin: 0 auto;
    }

    .card {
      width: 100%;
      background: var(--card);
      border-radius: 24px;
      padding: 24px 20px 20px;
      box-shadow: 0 12px 35px rgba(0,0,0,0.08);
      animation: fadeIn 0.35s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .logo {
      text-align: center;
      margin-bottom: 12px;
    }

    .logo img {
      height: 56px;
      width: auto;
      display: inline-block;
      border-radius: 12px;
      object-fit: cover;
    }

    h1 {
      text-align: center;
      font-size: 24px;
      margin: 6px 0 6px;
      color: var(--text);
    }

    .subtitle {
      text-align: center;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 18px;
      line-height: 1.45;
    }

    .soft-badge {
      width: fit-content;
      margin: 0 auto 12px;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--soft);
      border: 1px solid #dbe7ff;
      color: var(--blue);
      font-size: 12px;
      font-weight: 700;
    }

    .info-box {
      background: #f8fbff;
      border: 1px solid #dbeafe;
      padding: 13px 12px;
      border-radius: 14px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
      margin-bottom: 14px;
      text-align: center;
    }

    .warning-box {
      background: var(--warn-bg);
      border: 1px solid var(--warn-border);
      color: var(--warn-text);
    }

    label {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 6px;
      display: block;
    }

    input,
    select {
      width: 100%;
      padding: 12px 13px;
      font-size: 17px;
      border-radius: 12px;
      border: 1px solid var(--border);
      margin-bottom: 14px;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
      background: #f9fafb;
    }

    input:focus,
    select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
      background: #ffffff;
    }

    input[readonly] {
      color: #64748b;
      background: #f3f6fb;
    }

    button.primary {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      font-size: 16px;
      font-weight: 600;
      color: white;
      background: var(--blue);
      cursor: pointer;
      position: relative;
      transition: background 0.2s, transform 0.05s;
      margin-top: 4px;
    }

    button.primary:hover {
      background: var(--blue-dark);
    }

    button.primary:active {
      transform: scale(0.98);
    }

    button.primary:disabled {
      background: #93c5fd;
      cursor: not-allowed;
    }

    .secondary-btn {
      width: 100%;
      padding: 13px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
    }

    .spinner {
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: auto;
    }

    .message {
      margin-top: 12px;
      text-align: center;
      font-size: 13px;
      min-height: 18px;
      line-height: 1.45;
    }

    .error { color: var(--error); }
    .success { color: var(--success); }

    .hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: -6px;
      margin-bottom: 10px;
      line-height: 1.45;
    }

    .hidden {
      display: none !important;
    }

    .welcome-name {
      color: var(--blue);
      font-weight: 800;
    }

    .footer-note {
      margin-top: 16px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.45;
    }

    .countdown {
      font-weight: 800;
      color: var(--blue);
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <div class="container">
      <div class="card">
        <div class="logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>

        <div id="loading-panel">
          <div id="loading-badge" class="soft-badge">Checking access</div>
          <h1>Checking your account</h1>
          <p class="subtitle">Please wait while we confirm your sign in and decide the next step.</p>
          <div class="info-box">
            We are preparing your Colspot access.
          </div>
          <div class="message">Loading…</div>
        </div>

        <div id="welcome-panel" class="hidden">
          <div id="welcome-badge" class="soft-badge">Welcome</div>
          <h1>Hello <span id="welcome-name" class="welcome-name">User</span></h1>
          <p class="subtitle">Please wait while we prepare your account.</p>
          <div id="welcome-box" class="info-box">
            Your sign in was successful.
          </div>
          <div id="welcome-message" class="message success">Redirecting…</div>
        </div>

        <div id="complete-panel" class="hidden">
          <div id="complete-badge" class="soft-badge">Complete your account</div>
          <h1 id="complete-title">Finish account setup</h1>
          <p id="complete-subtitle" class="subtitle">We got your account. Now complete your details.</p>

          <div id="complete-info-box" class="info-box">
            Fill the details below once and we’ll save them to your Colspot account.
          </div>

          <form id="account-complete-form">
            <label for="account-fullname">Full name</label>
            <input id="account-fullname" type="text" placeholder="Your full name" required />

            <label for="account-email">Email</label>
            <input id="account-email" type="email" placeholder="you@example.com" readonly />

            <label for="account-schoolname">School name</label>
            <input id="account-schoolname" type="text" placeholder="Ekiti State University" required />

            <label for="account-dept">Department</label>
            <input id="account-dept" type="text" placeholder="Computer Science" required />

            <div id="student-id-wrap">
              <label for="account-student-id">Matric number</label>
              <input id="account-student-id" type="text" placeholder="e.g. CSC/21/1234" />
              <div class="hint">
                Make sure this matric number is correct. <strong>You won’t be able to change it later.</strong>
              </div>
            </div>

            <div id="lecturer-id-wrap" class="hidden">
              <label for="account-lecturer-id">Staff ID</label>
              <input id="account-lecturer-id" type="text" placeholder="Enter your staff ID" />
              <div class="hint">
                Make sure this staff ID is correct before continuing.
              </div>
            </div>

            <button id="account-complete-btn" type="submit" class="primary">
              <span id="account-complete-text">Complete account</span>
              <span id="account-complete-loader" class="spinner hidden"></span>
            </button>

            <div id="complete-message" class="message"></div>
          </form>

          <button type="button" class="secondary-btn" onclick="logoutAndReturn()">
            Use another account
          </button>
        </div>

        <div id="limit-panel" class="hidden">
          <div class="soft-badge">Device limit reached</div>
          <h1>Login blocked</h1>
          <p class="subtitle">This account has already reached the maximum device limit.</p>
          <div id="limit-box" class="info-box warning-box">
            You have already linked Colspot to 2 phones. You’ll be returned to login in
            <span id="limit-countdown" class="countdown">10</span>
            seconds.
          </div>
          <div id="limit-message" class="message error">Please use a previously linked device or contact support.</div>
          <button type="button" class="secondary-btn" onclick="goBackToIndex()">Back to login now</button>
        </div>

        <div id="error-panel" class="hidden">
          <div class="soft-badge">Something went wrong</div>
          <h1>We couldn’t continue</h1>
          <p class="subtitle">There was a problem checking your account.</p>
          <div id="error-box" class="info-box">
            Please try again.
          </div>
          <div id="error-message" class="message error"></div>
          <button type="button" class="primary" onclick="goBackToIndex()">Back to login</button>
          <button type="button" class="secondary-btn" onclick="logoutAndReturn()">Sign out and try again</button>
        </div>

        <p class="footer-note">
          Colspot uses your location to work properly. Please allow location when asked.
        </p>
      </div>
    </div>
  </div>

  <script type="module" src="./client_supabase.js"></script>

<script>
  const LOCAL_USER_KEY = "colspot_local_user";
  const AUTH_ROLE_KEY = "colspot_auth_role";

  // Change only these if your actual file names differ
  const STUDENT_VERIFY_URL = "verify_class.html";
  const LECTURER_VERIFY_URL = "lecturer_verify.html";
  const FACE_CAPTURE_URL = "face-capture.html";
  const STUDENT_MAIN_URL = "main.html";
  const LECTURER_MAIN_URL = "main_lecturer.html";
  const INDEX_URL = "index.html";

  // Change only these if lecturer uses a different verification table
  const STUDENT_VERIFICATION_TABLE = "verification_course_forms";
  const LECTURER_VERIFICATION_TABLE = "verification_course_forms";

  let activeSession = null;
  let activeRole = "student";
  let limitTimer = null;

  function showPanel(panelId) {
    const ids = ["loading-panel", "welcome-panel", "complete-panel", "limit-panel", "error-panel"];
    ids.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle("hidden", id !== panelId);
    });
  }

  function setMessage(id, text, cls = "") {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text || "";
    el.className = "message" + (cls ? " " + cls : "");
  }

  function setButtonLoading(btnId, textId, loaderId, isLoading) {
    const btn = document.getElementById(btnId);
    const text = document.getElementById(textId);
    const loader = document.getElementById(loaderId);

    if (!btn) return;
    btn.disabled = isLoading;

    if (text && loader) {
      text.classList.toggle("hidden", isLoading);
      loader.classList.toggle("hidden", !isLoading);
    }
  }

  function saveLocalUserFromSession(session, role) {
    if (!session || !session.user) return;
    try {
      const payload = {
        id: session.user.id,
        email: session.user.email || "",
        role: role || "",
        last_seen: new Date().toISOString(),
      };
      localStorage.setItem(LOCAL_USER_KEY, JSON.stringify(payload));
    } catch (e) {
      console.error("Could not write local user cache:", e);
    }
  }

  function clearLocalUser() {
    try {
      localStorage.removeItem(LOCAL_USER_KEY);
    } catch (e) {
      console.error("Could not clear local user cache:", e);
    }
  }

  function saveAuthRole(role) {
    try {
      localStorage.setItem(AUTH_ROLE_KEY, role);
    } catch (e) {
      console.error("Could not save auth role:", e);
    }
  }

  function getSavedRole() {
    try {
      return localStorage.getItem(AUTH_ROLE_KEY) || "";
    } catch (e) {
      console.error("Could not read auth role:", e);
      return "";
    }
  }

  function goBackToIndex() {
    window.location.href = INDEX_URL;
  }

  async function logoutAndReturn() {
    try {
      if (window.supabase) {
        await window.supabase.auth.signOut();
      }
    } catch (e) {
      console.error("Signout failed:", e);
    }
    clearLocalUser();
    window.location.href = INDEX_URL;
  }

  function startLimitCountdown(seconds = 10) {
    const countdownEl = document.getElementById("limit-countdown");
    let remaining = seconds;

    if (countdownEl) countdownEl.textContent = String(remaining);

    if (limitTimer) clearInterval(limitTimer);

    limitTimer = setInterval(() => {
      remaining -= 1;
      if (countdownEl) countdownEl.textContent = String(remaining);

      if (remaining <= 0) {
        clearInterval(limitTimer);
        logoutAndReturn();
      }
    }, 1000);
  }

  function generateRandomId() {
    try {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return window.crypto.randomUUID();
      }
    } catch (e) {}
    return Math.random().toString(36).slice(2) + "-" + Date.now().toString(36);
  }

  async function getOrCreateDeviceId() {
    const storageKey = "colspot_device_id_v2";

    try {
      const existing = localStorage.getItem(storageKey);
      if (existing && existing.trim()) return existing;
    } catch (e) {}

    let newId = null;
    const platform =
      window.Capacitor && typeof window.Capacitor.getPlatform === "function"
        ? window.Capacitor.getPlatform()
        : "web";

    let nativePlugin = null;
    if (window.Capacitor && window.Capacitor.Plugins) {
      nativePlugin =
        window.Capacitor.Plugins.ColspotNative ||
        window.Capacitor.Plugins.ColspotNativePlugin ||
        null;
    }

    if (
      platform === "android" &&
      nativePlugin &&
      typeof nativePlugin.getDeviceId === "function"
    ) {
      try {
        const result = await nativePlugin.getDeviceId();
        if (result && typeof result.value === "string" && result.value.trim()) {
          newId = result.value.trim();
        }
      } catch (err) {
        console.error("Android native device id failed:", err);
      }
    }

    if (platform === "ios") {
      if (!newId && nativePlugin && typeof nativePlugin.getDeviceId === "function") {
        try {
          const result = await nativePlugin.getDeviceId();
          const raw =
            (result && (result.value || result.identifier || result.id || result.uuid)) || "";
          if (raw && raw.trim()) {
            newId = raw.trim();
          }
        } catch (err) {
          console.error("iOS native device id failed:", err);
        }
      }

      if (
        !newId &&
        window.Capacitor &&
        window.Capacitor.Plugins &&
        window.Capacitor.Plugins.Device &&
        typeof window.Capacitor.Plugins.Device.getId === "function"
      ) {
        try {
          const result = await window.Capacitor.Plugins.Device.getId();
          const raw = (result && (result.identifier || result.uuid || result.id)) || "";
          if (raw && raw.trim()) {
            newId = "I-" + raw.trim();
          }
        } catch (err) {
          console.error("Device.getId failed:", err);
        }
      }
    }

    if (!newId) {
      newId = "B-" + generateRandomId();
    }

    try {
      localStorage.setItem(storageKey, newId);
    } catch (e) {}

    return newId;
  }

  async function getDeviceName() {
    try {
      if (
        window.Capacitor &&
        window.Capacitor.Plugins &&
        window.Capacitor.Plugins.Device &&
        typeof window.Capacitor.Plugins.Device.getInfo === "function"
      ) {
        const info = await window.Capacitor.Plugins.Device.getInfo();
        const platform = (info.platform || "").toLowerCase();

        if (platform === "ios") return "iPhone";

        let name = (info.model || info.name || "").trim();
        if (!name) name = "Android device";
        return name;
      }
    } catch (err) {
      console.error("getDeviceName failed:", err);
    }

    return "Browser";
  }

  async function linkDeviceForSession(session) {
    if (!session || !session.user || !window.supabase) return;

    const userId = session.user.id;
    const deviceId = await getOrCreateDeviceId();
    const deviceName = await getDeviceName();

    if (!deviceId) {
      throw new Error("We couldn’t get a device ID. Please try again.");
    }

    const { data: byDevice, error: errA } = await window.supabase
      .from("user_devices")
      .select("id,user_id,device_id")
      .eq("device_id", deviceId);

    if (errA) {
      console.error("user_devices by device error:", errA);
      throw new Error("We couldn’t link this device right now.");
    }

    if (byDevice && byDevice.length > 0) {
      const row = byDevice[0];
      if (row.user_id !== userId) {
        const conflictError = new Error("This phone is already linked to another Colspot account.");
        conflictError.code = "DEVICE_CONFLICT";
        throw conflictError;
      } else {
        return;
      }
    }

    const { data: byUser, error: errB } = await window.supabase
      .from("user_devices")
      .select("id,device_id")
      .eq("user_id", userId);

    if (errB) {
      console.error("user_devices by user error:", errB);
      throw new Error("We couldn’t link this device right now.");
    }

    if (byUser && byUser.length >= 2) {
      const limitError = new Error("You’ve already linked Colspot to 2 phones.");
      limitError.code = "DEVICE_LIMIT";
      throw limitError;
    }

    const { error: insertErr } = await window.supabase.from("user_devices").insert({
      user_id: userId,
      device_id: deviceId,
      device_name: deviceName,
    });

    if (insertErr) {
      console.error("user_devices insert error:", insertErr);

      const msg = String(insertErr.message || "").toLowerCase();
      const details = String(insertErr.details || "").toLowerCase();
      const code = String(insertErr.code || "").toLowerCase();

      if (
        msg.includes("user_devices_device_id_key") ||
        details.includes("user_devices_device_id_key") ||
        (msg.includes("duplicate key") && msg.includes("device_id")) ||
        (details.includes("duplicate key") && details.includes("device_id")) ||
        code === "23505"
      ) {
        const conflictError = new Error("This phone is already linked to another Colspot account.");
        conflictError.code = "DEVICE_CONFLICT";
        throw conflictError;
      }

      if (
        msg.includes("user_devices_user_id_key") ||
        details.includes("user_devices_user_id_key") ||
        msg.includes("already linked 2 phones") ||
        details.includes("already linked 2 phones")
      ) {
        const limitError = new Error("You’ve already linked Colspot to 2 phones.");
        limitError.code = "DEVICE_LIMIT";
        throw limitError;
      }

      throw new Error("We couldn’t finish linking your device.");
    }
  }

  async function recordLoginEvent(session) {
    if (!session || !session.user || !window.supabase) return;

    const userId = session.user.id;
    const deviceId = await getOrCreateDeviceId();
    const deviceName = await getDeviceName();
    if (!deviceId) return;

    try {
      const { error } = await window.supabase.from("user_login_events").insert({
        user_id: userId,
        device_id: deviceId,
        device_name: deviceName,
      });
      if (error) {
        console.error("recordLoginEvent insert error:", error);
      }
    } catch (err) {
      console.error("recordLoginEvent failed:", err);
    }
  }

  async function waitForSupabase(maxMs = 12000) {
    const started = Date.now();
    while (!window.supabase) {
      if (Date.now() - started > maxMs) {
        throw new Error("Supabase is not ready yet.");
      }
      await new Promise((resolve) => setTimeout(resolve, 120));
    }
    return window.supabase;
  }

  function getDisplayName(session) {
    if (!session || !session.user) return "";
    const meta = session.user.user_metadata || {};
    return (
      meta.full_name ||
      meta.name ||
      meta.user_name ||
      meta.display_name ||
      session.user.email?.split("@")[0] ||
      ""
    );
  }

  function getDesiredRole(session) {
    const metaRole = String(session?.user?.user_metadata?.role || "").toLowerCase().trim();
    const savedRole = String(getSavedRole() || "").toLowerCase().trim();

    if (metaRole === "student" || metaRole === "lecturer") return metaRole;
    if (savedRole === "student" || savedRole === "lecturer") return savedRole;
    return "student";
  }

  function roleLabel(role) {
    return role === "lecturer" ? "Lecturer" : "Student";
  }

  function updateRoleUI(role) {
    const loadingBadge = document.getElementById("loading-badge");
    const welcomeBadge = document.getElementById("welcome-badge");
    const completeBadge = document.getElementById("complete-badge");
    const completeTitle = document.getElementById("complete-title");
    const completeSubtitle = document.getElementById("complete-subtitle");
    const studentWrap = document.getElementById("student-id-wrap");
    const lecturerWrap = document.getElementById("lecturer-id-wrap");

    const label = roleLabel(role);

    if (loadingBadge) loadingBadge.textContent = `${label} access`;
    if (welcomeBadge) welcomeBadge.textContent = `${label} access`;
    if (completeBadge) completeBadge.textContent = `Complete ${label.toLowerCase()} account`;

    if (completeTitle) {
      completeTitle.textContent =
        role === "lecturer" ? "Finish lecturer setup" : "Finish student setup";
    }

    if (completeSubtitle) {
      completeSubtitle.textContent =
        role === "lecturer"
          ? "We got your account. Now complete your lecturer details."
          : "We got your account. Now complete your student details.";
    }

    if (studentWrap) studentWrap.classList.toggle("hidden", role !== "student");
    if (lecturerWrap) lecturerWrap.classList.toggle("hidden", role !== "lecturer");
  }

  async function getProfilesForSession(session) {
    const userId = session.user.id;
    const email = (session.user.email || "").trim().toLowerCase();

    const [
      studentByUser,
      lecturerByUser,
      studentByEmail,
      lecturerByEmail
    ] = await Promise.all([
      window.supabase
        .from("student_accounts")
        .select("*")
        .eq("user_id", userId)
        .maybeSingle(),
      window.supabase
        .from("lecturer_accounts")
        .select("*")
        .eq("user_id", userId)
        .maybeSingle(),
      window.supabase
        .from("student_accounts")
        .select("*")
        .eq("email", email)
        .maybeSingle(),
      window.supabase
        .from("lecturer_accounts")
        .select("*")
        .eq("email", email)
        .maybeSingle()
    ]);

    if (studentByUser.error) {
      console.error("student_accounts by user error:", studentByUser.error);
      throw new Error("We couldn’t check the student account.");
    }

    if (lecturerByUser.error) {
      console.error("lecturer_accounts by user error:", lecturerByUser.error);
      throw new Error("We couldn’t check the lecturer account.");
    }

    if (studentByEmail.error) {
      console.error("student_accounts by email error:", studentByEmail.error);
    }

    if (lecturerByEmail.error) {
      console.error("lecturer_accounts by email error:", lecturerByEmail.error);
    }

    return {
      studentByUser: studentByUser.data || null,
      lecturerByUser: lecturerByUser.data || null,
      studentByEmail: studentByEmail.data || null,
      lecturerByEmail: lecturerByEmail.data || null
    };
  }

  function analyzeRoleState(profiles, desiredRole, email) {
    const emailLower = (email || "").trim().toLowerCase();

    const studentProfile =
      profiles.studentByUser ||
      (profiles.studentByEmail && String(profiles.studentByEmail.email || "").toLowerCase() === emailLower
        ? profiles.studentByEmail
        : null);

    const lecturerProfile =
      profiles.lecturerByUser ||
      (profiles.lecturerByEmail && String(profiles.lecturerByEmail.email || "").toLowerCase() === emailLower
        ? profiles.lecturerByEmail
        : null);

    if (desiredRole === "student") {
      if (lecturerProfile && !studentProfile) {
        return {
          allowed: false,
          message:
            "This email already belongs to a lecturer account. Please go back and sign in through the Lecturer flow."
        };
      }

      return {
        allowed: true,
        role: "student",
        profile: studentProfile
      };
    }

    if (desiredRole === "lecturer") {
      if (studentProfile && !lecturerProfile) {
        return {
          allowed: false,
          message:
            "You have already created a student account with this email. Please go back and sign in instead of creating another account."
        };
      }

      return {
        allowed: true,
        role: "lecturer",
        profile: lecturerProfile
      };
    }

    return {
      allowed: false,
      message: "We could not determine your role. Please go back and try again."
    };
  }

  async function getVerificationState(userId, role) {
    const verifyTable =
      role === "lecturer"
        ? LECTURER_VERIFICATION_TABLE
        : STUDENT_VERIFICATION_TABLE;

    const { data: verificationRow, error: verificationErr } = await window.supabase
      .from(verifyTable)
      .select("id,status")
      .eq("user_id", userId)
      .eq("status", "successful")
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (verificationErr) {
      console.error("verification fetch error:", verificationErr);
      throw new Error("We couldn’t check your verification state.");
    }

    const { data: faceRow, error: faceErr } = await window.supabase
      .from("face_profiles")
      .select("user_id, face_verified, capture_status")
      .eq("user_id", userId)
      .maybeSingle();

    if (faceErr) {
      console.error("face fetch error:", faceErr);
      throw new Error("We couldn’t check your face verification state.");
    }

    const hasVerifiedForm = !!verificationRow;
    const faceStatus = String(faceRow?.capture_status || "").toLowerCase().trim();
    const hasVerifiedFace =
      !!faceRow &&
      (faceRow.face_verified === true || faceStatus === "approved" || faceStatus === "verified");

    return {
      hasVerifiedForm,
      hasVerifiedFace
    };
  }

  function fillCompleteForm(session, role, profile) {
    const fullName = profile?.full_name || getDisplayName(session);
    const email = profile?.email || session.user.email || "";
    const school = profile?.school_name || "";
    const dept = profile?.department || "";

    const fullNameInput = document.getElementById("account-fullname");
    const emailInput = document.getElementById("account-email");
    const schoolInput = document.getElementById("account-schoolname");
    const deptInput = document.getElementById("account-dept");
    const studentIdInput = document.getElementById("account-student-id");
    const lecturerIdInput = document.getElementById("account-lecturer-id");

    if (fullNameInput) fullNameInput.value = fullName;
    if (emailInput) emailInput.value = email;
    if (schoolInput) schoolInput.value = school;
    if (deptInput) deptInput.value = dept;

    if (studentIdInput) {
      studentIdInput.value = role === "student" ? (profile?.matric_number || "") : "";
      studentIdInput.required = role === "student";
    }

    if (lecturerIdInput) {
      lecturerIdInput.value = role === "lecturer" ? (profile?.staff_id || "") : "";
      lecturerIdInput.required = role === "lecturer";
    }
  }

  function getRoleRedirects(role) {
    return {
      verifyUrl: role === "lecturer" ? LECTURER_VERIFY_URL : STUDENT_VERIFY_URL,
      mainUrl: role === "lecturer" ? LECTURER_MAIN_URL : STUDENT_MAIN_URL
    };
  }

  async function goWithWelcome(message, nextUrl, role, delay = 1200) {
    const welcomeName = document.getElementById("welcome-name");
    if (welcomeName) {
      welcomeName.textContent = getDisplayName(activeSession) || roleLabel(role);
    }

    const welcomeBox = document.getElementById("welcome-box");
    if (welcomeBox) {
      welcomeBox.textContent = message;
    }

    updateRoleUI(role);
    setMessage("welcome-message", "Redirecting…", "success");
    showPanel("welcome-panel");

    setTimeout(() => {
      saveLocalUserFromSession(activeSession, role);
      saveAuthRole(role);
      window.location.href = nextUrl;
    }, delay);
  }

  async function startCallbackFlow() {
    try {
      showPanel("loading-panel");
      await waitForSupabase();

      const { data, error } = await window.supabase.auth.getSession();
      if (error) {
        console.error("getSession error:", error);
        throw new Error("We couldn’t confirm your session.");
      }

      const session = data?.session || null;
      if (!session || !session.user) {
        throw new Error("No active session was found. Please try again.");
      }

      activeSession = session;
      activeRole = getDesiredRole(session);
      updateRoleUI(activeRole);

      const profiles = await getProfilesForSession(session);
      const roleState = analyzeRoleState(
        profiles,
        activeRole,
        session.user.email || ""
      );

      if (!roleState.allowed) {
        showPanel("error-panel");
        document.getElementById("error-box").textContent = roleState.message;
        setMessage("error-message", "Please go back and sign in with the correct account flow.", "error");
        return;
      }

      activeRole = roleState.role;
      saveAuthRole(activeRole);
      updateRoleUI(activeRole);

      try {
        await linkDeviceForSession(session);
      } catch (deviceErr) {
        console.error(deviceErr);

        const deviceMessage = String(deviceErr.message || "").toLowerCase();

        if (deviceErr.code === "DEVICE_LIMIT" || deviceMessage.includes("2 phones")) {
          clearLocalUser();
          showPanel("limit-panel");
          startLimitCountdown(10);
          return;
        }

        if (deviceErr.code === "DEVICE_CONFLICT" || deviceMessage.includes("another colspot account")) {
          clearLocalUser();
          showPanel("error-panel");
          document.getElementById("error-box").textContent =
            "This device is already linked to another Colspot account.";
          setMessage("error-message", "Use the correct phone for this account or contact support.", "error");
          return;
        }

        throw deviceErr;
      }

      saveLocalUserFromSession(session, activeRole);

      try {
        await recordLoginEvent(session);
      } catch (e) {
        console.error(e);
      }

      const redirects = getRoleRedirects(activeRole);
      const verificationState = await getVerificationState(session.user.id, activeRole);

      if (roleState.profile) {
        if (verificationState.hasVerifiedForm && verificationState.hasVerifiedFace) {
          await goWithWelcome(
            `Your ${roleLabel(activeRole).toLowerCase()} account, verification, and face capture are ready.`,
            redirects.mainUrl,
            activeRole
          );
          return;
        }

        if (verificationState.hasVerifiedForm && !verificationState.hasVerifiedFace) {
          await goWithWelcome(
            "Your verification is already complete. Next, complete face capture.",
            FACE_CAPTURE_URL,
            activeRole
          );
          return;
        }

        await goWithWelcome(
          `Welcome back. Please continue with ${roleLabel(activeRole).toLowerCase()} verification.`,
          redirects.verifyUrl,
          activeRole
        );
        return;
      }

      if (verificationState.hasVerifiedForm && verificationState.hasVerifiedFace) {
        await goWithWelcome(
          "Your verification is complete. Taking you into Colspot.",
          redirects.mainUrl,
          activeRole
        );
        return;
      }

      if (verificationState.hasVerifiedForm && !verificationState.hasVerifiedFace) {
        await goWithWelcome(
          "Your verification is complete. Next, complete face capture.",
          FACE_CAPTURE_URL,
          activeRole
        );
        return;
      }

      fillCompleteForm(session, activeRole, null);
      showPanel("complete-panel");
    } catch (err) {
      console.error("Callback flow failed:", err);
      clearLocalUser();
      showPanel("error-panel");
      document.getElementById("error-box").textContent =
        err.message || "We couldn’t finish checking your account.";
      setMessage("error-message", "Please go back and try again.", "error");
    }
  }

  async function handleCompleteAccount(event) {
    event.preventDefault();
    setMessage("complete-message", "");

    if (!activeSession || !activeSession.user) {
      setMessage("complete-message", "Your session expired. Please sign in again.", "error");
      return;
    }

    const fullName = (document.getElementById("account-fullname")?.value || "").trim();
    const email = (document.getElementById("account-email")?.value || "").trim().toLowerCase();
    const schoolName = (document.getElementById("account-schoolname")?.value || "").trim();
    const dept = (document.getElementById("account-dept")?.value || "").trim();
    const studentId = (document.getElementById("account-student-id")?.value || "").trim();
    const lecturerId = (document.getElementById("account-lecturer-id")?.value || "").trim();

    if (!fullName || !email || !schoolName || !dept) {
      setMessage("complete-message", "Fill in all fields to complete your account.", "error");
      return;
    }

    if (activeRole === "student" && !studentId) {
      setMessage("complete-message", "Enter your matric number to continue.", "error");
      return;
    }

    if (activeRole === "lecturer" && !lecturerId) {
      setMessage("complete-message", "Enter your staff ID to continue.", "error");
      return;
    }

    try {
      setButtonLoading("account-complete-btn", "account-complete-text", "account-complete-loader", true);

      if (activeRole === "student") {
        const payload = {
          user_id: activeSession.user.id,
          full_name: fullName,
          school_name: schoolName,
          department: dept,
          matric_number: studentId,
          email
        };

        const { error } = await window.supabase
          .from("student_accounts")
          .upsert(payload, { onConflict: "user_id" });

        if (error) {
          console.error("student_accounts upsert error:", error);
          throw new Error("We couldn’t save your student details. Please try again.");
        }

        const { error: authMetaErr } = await window.supabase.auth.updateUser({
          data: {
            full_name: fullName,
            role: "student",
            school_name: schoolName,
            department: dept,
            matric_number: studentId
          }
        });

        if (authMetaErr) {
          console.error("auth.updateUser metadata error:", authMetaErr);
        }
      } else {
        const payload = {
          user_id: activeSession.user.id,
          full_name: fullName,
          school_name: schoolName,
          department: dept,
          staff_id: lecturerId,
          email
        };

        const { error } = await window.supabase
          .from("lecturer_accounts")
          .upsert(payload, { onConflict: "user_id" });

        if (error) {
          console.error("lecturer_accounts upsert error:", error);
          throw new Error("We couldn’t save your lecturer details. Please try again.");
        }

        const { error: authMetaErr } = await window.supabase.auth.updateUser({
          data: {
            full_name: fullName,
            role: "lecturer",
            school_name: schoolName,
            department: dept,
            staff_id: lecturerId
          }
        });

        if (authMetaErr) {
          console.error("auth.updateUser metadata error:", authMetaErr);
        }
      }

      saveLocalUserFromSession(activeSession, activeRole);
      saveAuthRole(activeRole);

      const redirects = getRoleRedirects(activeRole);

      await goWithWelcome(
        activeRole === "lecturer"
          ? "Your lecturer account has been completed. Next, continue your verification."
          : "Your student account has been completed. Next, continue your verification.",
        redirects.verifyUrl,
        activeRole,
        1000
      );
    } catch (err) {
      console.error("Complete account failed:", err);
      setMessage("complete-message", err.message || "We couldn’t complete your account.", "error");
    } finally {
      setButtonLoading("account-complete-btn", "account-complete-text", "account-complete-loader", false);
    }
  }

  document.getElementById("account-complete-form")?.addEventListener("submit", handleCompleteAccount);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCallbackFlow);
  } else {
    startCallbackFlow();
  }
</script>
