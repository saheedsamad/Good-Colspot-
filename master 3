}
  if (links[0]) links[0].addEventListener("click", showSummary);
  if (links[1]) links[1].addEventListener("click", showQuestions);
  if (links[2]) links[2].addEventListener("click", showIndividual);
  if (links[3]) links[3].addEventListener("click", showExport);

  showSummary();
}

function wireTopButtons() {
  const backBtn = document.querySelector(".back-btn");
  const previewBtn = document.getElementById("previewFormBtn");
  const closeBtn = document.getElementById("closeFormBtn");

  if (backBtn) {
    backBtn.addEventListener("click", () => {
      if (document.referrer) {
        window.history.back();
      } else {
        window.location.href = "hos.html";
      }
    });
  }

  if (previewBtn) {
    previewBtn.addEventListener("click", () => {
      if (!currentForm?.id) return;
      window.open(`form_preview.html?form_id=${encodeURIComponent(currentForm.id)}`, "_blank");
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener("click", async () => {
      if (!currentForm?.id) return;

      const confirmed = window.confirm("Are you sure you want to close this form?");
      if (!confirmed) return;

      try {
        closeBtn.disabled = true;
        const result = await invokeFormsManager({
          action: "close_form",
          form_id: currentForm.id,
          ...getActorPayloadFromSession()
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Failed to close form.");
        }

        currentForm.status = "closed";
        renderSummary();
        alert("Form closed successfully.");
      } catch (err) {
        console.error("close form error:", err);
        alert(err?.message || "Unable to close form.");
      } finally {
        closeBtn.disabled = false;
      }
    });
  }
}

async function loadSummaryPage(formId) {
  const result = await invokeFormResponseManager({
    action: "get_form_response_bundle",
    form_id: formId,
    ...getActorPayloadFromSession()
  });

  if (!result?.ok) {
    throw new Error(result?.error || "Failed to load form response bundle.");
  }

  currentForm = result.form || null;
  currentQuestions = Array.isArray(result.questions) ? result.questions : [];
  currentResponses = Array.isArray(result.individual_responses) ? result.individual_responses : [];
  currentQuestionSummaries = Array.isArray(result.question_summaries) ? result.question_summaries : [];
  currentSummary = result.summary || null;

  renderSummary();
}

function renderSummary() {
  if (!currentForm || !currentSummary) return;

  const totalResponses = Number(currentSummary.total_responses || 0);
  const expectedStudents = Number(currentSummary.expected_students || 0);
  const responseRate = Number(currentSummary.response_rate || 0);
  const latestSubmission = currentSummary.latest_submission || null;

  const identifiedRow = Array.isArray(currentSummary.identity_breakdown)
    ? currentSummary.identity_breakdown.find((row) => cleanText(row.label).toLowerCase() === "identified")
    : null;

  const anonymousRow = Array.isArray(currentSummary.identity_breakdown)
    ? currentSummary.identity_breakdown.find((row) => cleanText(row.label).toLowerCase() === "anonymous")
    : null;

  const identifiedCount = Number(identifiedRow?.count || 0);
  const anonymousCount = Number(anonymousRow?.count || 0);

  const completionRate = getCompletionRateFromSummary(currentQuestionSummaries, totalResponses);
  const programmeBreakdown = Array.isArray(currentSummary.programme_breakdown)
    ? currentSummary.programme_breakdown.map((row) => ({
        name: row.label,
        count: Number(row.count || 0)
      }))
    : [];

  const levelBreakdown = Array.isArray(currentSummary.level_breakdown)
    ? currentSummary.level_breakdown.map((row) => ({
        name: row.label,
        count: Number(row.count || 0)
      }))
    : [];

  setText("summarySchoolName", currentForm.school_name || "—");
  setText("summaryFormTitle", currentForm.title || "Untitled Form");
  setText("summaryFormAudience", buildAudienceText(currentForm));
  setText("summaryFormCreator", "Form response summary");

  setChipText("summaryStatusChip", formatStatus(currentForm.status));
  setChipText("summaryIdentityChip", formatIdentityMode(currentForm.identity_mode));

  setText("statTotalResponses", String(totalResponses));
  setText("statResponseRate", `${responseRate}%`);
  setText("statLatestSubmission", latestSubmission ? formatDateTime(latestSubmission) : "—");
  setText("statCompletionRate", `${completionRate}%`);

  setText("programmeBreakdownTotal", String(totalResponses));
  renderProgrammeLegend(programmeBreakdown);
  renderLevelBreakdown(levelBreakdown);

  setText("identityBreakdownPercent", `${totalResponses ? Math.round((identifiedCount / totalResponses) * 100) : 0}%`);
  setText("identityIdentifiedCount", String(identifiedCount));
  setText("identityAnonymousCount", String(anonymousCount));

  setText("infoQuestionCount", String(currentQuestions.length));
  setText("infoOpenDate", formatDate(currentForm.open_at));
  setText("infoCloseDate", formatDate(currentForm.close_at));
  setText("infoIdentityMode", formatIdentityMode(currentForm.identity_mode));
  setText("infoAudience", buildAudienceText(currentForm));

  setText("audienceExpectedStudents", String(expectedStudents));
  setText("audienceActualSubmissions", String(totalResponses));
  setText("questionCountBadge", `${currentQuestions.length} Question${currentQuestions.length === 1 ? "" : "s"}`);
}

function getCompletionRateFromSummary(questionSummaries, totalResponses) {
  if (!totalResponses) return 0;

  const requiredQuestions = currentQuestions.filter((q) => !!q.is_required);
  if (!requiredQuestions.length) return 100;

  const requiredIds = new Set(requiredQuestions.map((q) => String(q.id)));
  const requiredSummaries = (questionSummaries || []).filter((q) => requiredIds.has(String(q.question_id)));

  if (!requiredSummaries.length) return 0;

  const minimumAnswered = Math.min(
    ...requiredSummaries.map((q) => Number(q.answered_count || 0))
  );

  return Math.round((minimumAnswered / totalResponses) * 100);
}

function renderProgrammeLegend(items) {
  const container = document.getElementById("programmeLegendList");
  if (!container) return;

  if (!items.length) {
    container.innerHTML = `
      <div class="legend-row">
        <span class="legend-dot blue"></span>
        <span class="legend-name">No programme data yet</span>
        <span class="legend-count">0</span>
      </div>
    `;
    return;
  }

  const classes = ["blue", "mint", "orange", "red", "sky", "soft"];

  container.innerHTML = items
    .map((row, index) => {
      const dotClass = classes[index % classes.length];
      return `
        <div class="legend-row">
          <span class="legend-dot ${dotClass}"></span>
          <span class="legend-name">${escapeHtml(row.name)}</span>
          <span class="legend-count">${row.count}</span>
        </div>
      `;
    })
    .join("");
}

function renderLevelBreakdown(items) {
  const container = document.getElementById("levelBreakdownList");
  if (!container) return;

  if (!items.length) {
    container.innerHTML = `
      <div class="breakdown-row">
        <div class="breakdown-left">
          <div class="breakdown-name">No level data yet</div>
          <div class="bar w16"><span></span></div>
        </div>
        <div class="breakdown-value">0</div>
      </div>
    `;
    return;
  }

  const max = Math.max(...items.map((row) => row.count), 1);

  container.innerHTML = items
    .map((row) => {
      const widthPercent = Math.max(8, Math.round((row.count / max) * 100));
      return `
        <div class="breakdown-row">
          <div class="breakdown-left">
            <div class="breakdown-name">${escapeHtml(row.name === "Unknown" ? "Unknown Level" : `${row.name} Level`)}</div>
            <div class="bar">
              <span style="width:${widthPercent}%"></span>
            </div>
          </div>
          <div class="breakdown-value">${row.count}</div>
        </div>
      `;
    })
    .join("");
}

function buildAudienceText(form) {
  const audienceMode = cleanText(form.audience_mode || "all_students");

  if (audienceMode !== "programme_filter") {
    return "All students";
  }

  const targets = normalizeProgrammeTargets(form.programme_targets);
  if (!targets.length) return "Programme filter";

  const first = targets[0];
  const firstLevels = Array.isArray(first.levels) ? first.levels.join(", ") : "";
  const extra = targets.length > 1 ? ` +${targets.length - 1} more` : "";

  return `${toTitleCase(first.programme_name)} ${firstLevels}${extra}`.trim();
}

function formatStatus(status) {
  const value = cleanText(status);
  if (!value) return "Unknown";
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function formatIdentityMode(mode) {
  return cleanText(mode) === "anonymous" ? "Anonymous" : "Use login identity";
}

function formatDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleDateString([], {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
}

function formatDateTime(value) {
  if (!value) return "—";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleString([], {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit"
  });
}

function updateTopbarTitle(title, subtitle) {
  const h2 = document.querySelector(".topbar-title h2");
  const p = document.querySelector(".topbar-title p");
  if (h2) h2.textContent = title;
  if (p) p.textContent = subtitle;
}

function setText(id, value) {
  const el = document.getElementById(id);
  if (el) el.textContent = value ?? "";
}

function setChipText(id, value) {
  const el = document.getElementById(id);
  if (!el) return;

  const span = el.querySelector("span");
  if (span) span.textContent = value ?? "";
  else el.textContent = value ?? "";
}

function normalizeUpper(value) {
  return cleanText(value).replace(/\s+/g, " ").toUpperCase();
}

function normalizeLevelValue(value) {
  return normalizeUpper(value)
    .replace(/\bLEVEL\b/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function normalizeProgrammeTargets(value) {
  if (!Array.isArray(value)) return [];

  return value
    .map((item) => {
      const programmeName = normalizeUpper(item?.programme_name);
      const levels = Array.isArray(item?.levels)
        ? item.levels.map((v) => normalizeLevelValue(v)).filter(Boolean)
        : [];

      return {
        programme_name: programmeName,
        levels
      };
    })
    .filter((item) => item.programme_name);
}

function cleanText(value) {
  return String(value ?? "").trim();
}

function toTitleCase(value) {
  return cleanText(value)
    .toLowerCase()
    .split(" ")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function showFatalState(message) {
  const main = document.querySelector(".main");
  if (!main) return;

  main.innerHTML = `
    <section class="content-card" style="padding:28px;">
      <h2 style="margin:0 0 10px;font-size:28px;font-weight:900;color:#16213d;">Unable to load form response</h2>
      <p style="margin:0;color:#6d7895;font-size:16px;font-weight:700;">${escapeHtml(message)}</p>
    </section>
  `;
}

function getActorPayloadFromSession() {
  const session = getAnyStoredSession();

  if (session?.hos_admin_id) {
    return { hos_admin_id: session.hos_admin_id };
  }

  if (session?.form_agent_id) {
    return { form_agent_id: session.form_agent_id };
  }

  if (session?.id && cleanText(session.role).toLowerCase() === "hos") {
    return { hos_admin_id: session.id };
  }

  if (session?.id && cleanText(session.role).toLowerCase() === "form_agent") {
    return { form_agent_id: session.id };
  }

  if (session?.account?.id && cleanText(session?.role || session?.account?.role).toLowerCase() === "hos") {
    return { hos_admin_id: session.account.id };
  }

  if (session?.account?.id && cleanText(session?.role || session?.account?.role).toLowerCase() === "form_agent") {
    return { form_agent_id: session.account.id };
  }

  throw new Error("Admin session not found. Please sign in again.");
}

function getAnyStoredSession() {
  const keys = [
    "colspot_hos_session",
    "colspot_admin_session",
    "hos_session",
    "admin_session",
    "colspot_session"
  ];

  for (const key of keys) {
    const raw = localStorage.getItem(key);
    if (!raw) continue;

    try {
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        return parsed;
      }
    } catch (_) {}
  }

  return null;
}

async function invokeFormResponseManager(payload) {
  const url = `${SUPABASE_URL}/functions/v1/${FUNCTION_NAME}`;

  console.log("FORM RESPONSE BODY SENT:", JSON.stringify(payload, null, 2));

  const response = await fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "apikey": SUPABASE_ANON_KEY,
      "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
    },
    body: JSON.stringify(payload)
  });

  const result = await response.json().catch(() => ({}));

  console.log("FORM RESPONSE RAW RESULT:", result);

  if (!response.ok) {
    throw new Error(result?.error || "Edge Function returned a non-2xx status code");
  }

  return result;
}

async function invokeFormsManager(payload) {
  const url = `${SUPABASE_URL}/functions/v1/${FORMS_MANAGER_FUNCTION}`;

  const response = await fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "apikey": SUPABASE_ANON_KEY,
      "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
    },
    body: JSON.stringify(payload)
  });

  const result = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(result?.error || "Edge Function returned a non-2xx status code");
  }

  return result;
}
