  <script>
    (function () {
      const FORM_RESPONSE_FUNCTION = "form-response-manager";

      let exportSupabase = null;
      let exportFormId = null;
      let exportBundle = null;
      let exportChoice = "all";
      let exportFormat = "excel";
      let exportSelectedResponseId = null;
      let exportCustomSelectedColumns = new Set();

      document.addEventListener("DOMContentLoaded", () => {
        initExportSection().catch((err) => {
          console.error("export init error:", err);
          alert(err?.message || "Failed to load export section.");
        });
      });

      async function initExportSection() {
        ensureSupabaseReady();
        exportSupabase = getExportSupabaseClient();
        exportFormId = getFormIdFromUrl();

        if (!exportFormId) {
          throw new Error("form_id is missing in the URL.");
        }

        wireExportChoices();
        wireExportFormats();
        wireExportFilters();
        wireExportButtons();
        wireCustomBuilder();

        await loadExportBundle();
      }

      function ensureSupabaseReady() {
        if (!window.supabase || typeof window.supabase.createClient !== "function") {
          throw new Error("Supabase browser library is not loaded.");
        }
      }

      function getExportSupabaseClient() {
        if (window.__colspotExportSupabase) return window.__colspotExportSupabase;

        const url = window.SUPABASE_URL || "YOUR_SUPABASE_URL";
        const key = window.SUPABASE_ANON_KEY || "YOUR_SUPABASE_ANON_KEY";

        if (
          !url ||
          !key ||
          String(url).includes("YOUR_SUPABASE_URL") ||
          String(key).includes("YOUR_SUPABASE_ANON_KEY")
        ) {
          throw new Error("Set your real SUPABASE_URL and SUPABASE_ANON_KEY once in the page.");
        }

        window.__colspotExportSupabase = window.supabase.createClient(url, key);
        return window.__colspotExportSupabase;
      }

      function getFormIdFromUrl() {
        const params = new URLSearchParams(window.location.search);
        return cleanText(params.get("form_id"));
      }

      function wireExportChoices() {
        document.querySelectorAll(".export-choice").forEach((card) => {
          card.addEventListener("click", () => {
            exportChoice = cleanText(card.dataset.exportChoice || "all").toLowerCase();
            setActiveChoice();
            renderExportPreview();
          });
        });
      }

      function setActiveChoice() {
        document.querySelectorAll(".export-choice").forEach((card) => {
          const active = cleanText(card.dataset.exportChoice).toLowerCase() === exportChoice;
          card.classList.toggle("active", active);
        });
      }

      function wireExportFormats() {
        document.querySelectorAll(".export-format").forEach((card) => {
          card.addEventListener("click", () => {
            exportFormat = cleanText(card.dataset.format || "excel").toLowerCase();
            setActiveFormat();
            updateExportButtons();
          });
        });
      }

      function setActiveFormat() {
        document.querySelectorAll(".export-format").forEach((card) => {
          const active = cleanText(card.dataset.format).toLowerCase() === exportFormat;
          card.classList.toggle("active", active);
        });
      }

      function wireExportFilters() {
        const search = document.getElementById("exportSearchInput");
        const programme = document.getElementById("exportProgrammeSelect");
        const level = document.getElementById("exportLevelSelect");
        const identity = document.getElementById("exportIdentitySelect");

        if (search) search.addEventListener("input", debounce(renderExportPreview, 180));
        if (programme) programme.addEventListener("change", renderExportPreview);
        if (level) level.addEventListener("change", renderExportPreview);
        if (identity) identity.addEventListener("change", renderExportPreview);
      }

      function wireExportButtons() {
        const refreshBtn = document.getElementById("refreshExportPreviewBtn");
        const topExportBtn = document.getElementById("topExportBtn");
        const downloadBtn = document.getElementById("downloadExportBtn");
        const historyBtn = document.getElementById("exportHistoryBtn");

        if (refreshBtn) {
          refreshBtn.addEventListener("click", async () => {
            refreshBtn.disabled = true;
            try {
              await loadExportBundle();
            } finally {
              refreshBtn.disabled = false;
            }
          });
        }

        if (topExportBtn) {
          topExportBtn.addEventListener("click", exportCurrentPreview);
        }

        if (downloadBtn) {
          downloadBtn.addEventListener("click", exportCurrentPreview);
        }

        if (historyBtn) {
          historyBtn.addEventListener("click", () => {
            alert("Export history can be connected next.");
          });
        }
      }

      function wireCustomBuilder() {
        document.querySelectorAll(".export-check input[type='checkbox']").forEach((input) => {
          const value = cleanText(input.value);
          if (input.checked && value) exportCustomSelectedColumns.add(value);

          input.addEventListener("change", () => {
            if (input.checked) exportCustomSelectedColumns.add(value);
            else exportCustomSelectedColumns.delete(value);
            renderCustomSelectedColumns();
          });
        });

        const btn = document.getElementById("createCustomExportBtn");
        if (btn) {
          btn.addEventListener("click", exportCustomTable);
        }

        renderCustomSelectedColumns();
      }

      async function loadExportBundle() {
        const result = await invokeFormResponseManager({
          action: "get_form_response_bundle",
          form_id: exportFormId,
          ...getActorPayloadFromSession()
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Failed to load export data.");
        }

        exportBundle = result;
        hydrateHeader();
        hydrateFilters();
        hydrateQuestionCheckboxes();
        setActiveChoice();
        setActiveFormat();
        updateExportButtons();
        renderExportPreview();
      }

      function hydrateHeader() {
        const form = exportBundle?.form || {};
        const summary = exportBundle?.summary || {};

        setText("exportFormTitle", form.title || "Form");
        setText("exportAudienceMeta", buildAudienceText(form));
        setText("exportResponsesMeta", `${Number(summary.total_responses || 0)} response${Number(summary.total_responses || 0) === 1 ? "" : "s"}`);
        setText("exportIdentityMeta", formatIdentityMode(form.identity_mode));
        setText(
          "exportLastSubmissionMeta",
          summary.latest_submission
            ? `Last submission: ${formatDateTime(summary.latest_submission)}`
            : "Last submission: —"
        );
      }

      function hydrateFilters() {
        const rows = Array.isArray(exportBundle?.individual_responses) ? exportBundle.individual_responses : [];
        const programmeSelect = document.getElementById("exportProgrammeSelect");
        const levelSelect = document.getElementById("exportLevelSelect");

        const programmes = uniqueValues(rows.map((r) => cleanText(r.programme)).filter(Boolean)).sort();
        const levels = uniqueValues(rows.map((r) => cleanText(r.level)).filter(Boolean)).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

        if (programmeSelect) {
          programmeSelect.innerHTML = `<option value="">All programmes</option>` +
            programmes.map((p) => `<option value="${escapeHtmlAttr(p)}">${escapeHtml(p)}</option>`).join("");
        }

        if (levelSelect) {
          levelSelect.innerHTML = `<option value="">All levels</option>` +
            levels.map((l) => `<option value="${escapeHtmlAttr(l)}">${escapeHtml(l)}</option>`).join("");
        }
      }

      function hydrateQuestionCheckboxes() {
        const wrap = document.getElementById("exportQuestionCheckboxes");
        const questions = Array.isArray(exportBundle?.questions) ? exportBundle.questions : [];
        if (!wrap) return;

        if (!questions.length) {
          wrap.innerHTML = `<label class="export-check"><input type="checkbox" disabled><span>No questions found</span></label>`;
          return;
        }

        wrap.innerHTML = questions.map((q) => {
          const label = cleanText(q.question_text) || "Untitled question";
          return `
            <label class="export-check">
              <input type="checkbox" value="${escapeHtmlAttr(label)}">
              <span>${escapeHtml(label)}</span>
            </label>
          `;
        }).join("");

        wrap.querySelectorAll("input[type='checkbox']").forEach((input) => {
          input.addEventListener("change", () => {
            const value = cleanText(input.value);
            if (input.checked) exportCustomSelectedColumns.add(value);
            else exportCustomSelectedColumns.delete(value);
            renderCustomSelectedColumns();
          });
        });
      }

      function renderExportPreview() {
        if (!exportBundle) return;

        const filtersCard = document.getElementById("exportFiltersCard");
        const previewCard = document.getElementById("exportPreviewCard");
        const customCard = document.getElementById("exportCustomCard");

        const allRows = Array.isArray(exportBundle?.individual_responses) ? exportBundle.individual_responses : [];
        const questions = Array.isArray(exportBundle?.questions) ? exportBundle.questions : [];
        const summaries = Array.isArray(exportBundle?.question_summaries) ? exportBundle.question_summaries : [];

        if (exportChoice === "custom") {
          if (filtersCard) filtersCard.style.display = "none";
          if (previewCard) previewCard.style.display = "none";
          if (customCard) customCard.style.display = "block";
          return;
        }

        if (customCard) customCard.style.display = "none";
        if (previewCard) previewCard.style.display = "block";

        let columns = [];
        let rows = [];
        let title = "";
        let subtitle = "";

        if (exportChoice === "all") {
          if (filtersCard) filtersCard.style.display = "none";
          columns = buildAllColumns(questions);
          rows = buildAllRows(allRows, questions);
          title = "All responses export preview";
          subtitle = "This preview shows every submitted response that will be exported.";
        } else if (exportChoice === "filtered") {
          if (filtersCard) filtersCard.style.display = "block";
          const filtered = getFilteredRows(allRows);
          columns = buildAllColumns(questions);
          rows = buildAllRows(filtered, questions);
          title = "Filtered responses export preview";
          subtitle = `This preview shows ${filtered.length} matching response${filtered.length === 1 ? "" : "s"} for the selected filters.`;
        } else if (exportChoice === "single") {
          if (filtersCard) filtersCard.style.display = "block";
          const filtered = getFilteredRows(allRows);
          const selected = resolveSingleRow(filtered);
          columns = buildSingleColumns();
          rows = selected ? [buildSingleRow(selected)] : [];
          title = "Single respondent export preview";
          subtitle = selected ? "This preview shows the selected respondent that will be exported." : "No matching respondent found.";
        } else {
          if (filtersCard) filtersCard.style.display = "none";
          columns = buildSummaryColumns();
          rows = buildSummaryRows(summaries);
          title = "Question summary export preview";
          subtitle = "This preview shows grouped answer statistics that will be exported.";
        }

        setText("exportPreviewTitle", title);
        setText("exportPreviewSubtitle", subtitle);
        setText("exportRowsCount", String(rows.length));
        setText("exportColumnsCount", String(columns.length));
        setText("exportTypeLabel", toTitleCase(exportChoice));

        renderExportChips(columns);
        renderExportTable(columns, rows);
      }

      function buildAllColumns(questions) {
        const base = [
          { key: "full_name", label: "Student Name" },
          { key: "matric_number", label: "Matric Number" },
          { key: "programme", label: "Programme" },
          { key: "level", label: "Level" },
          { key: "submitted_at", label: "Submitted At" }
        ];

        const qcols = questions.map((q, index) => ({
          key: `q_${q.id}`,
          label: cleanText(q.question_text) || `Question ${index + 1}`
        }));

        return [...base, ...qcols];
      }

      function buildAllRows(rows, questions) {
        return rows.map((row) => {
          const item = {
            full_name: row.full_name || "—",
            matric_number: row.matric_number || "—",
            programme: row.programme || "—",
            level: row.level || "—",
            submitted_at: row.submitted_at ? formatDateTime(row.submitted_at) : "—"
          };

          questions.forEach((q) => {
            item[`q_${q.id}`] = "Will load from backend detail export";
          });

          return item;
        });
      }

      function buildSingleColumns() {
        return [
          { key: "full_name", label: "Student Name" },
          { key: "matric_number", label: "Matric Number" },
          { key: "programme", label: "Programme" },
          { key: "level", label: "Level" },
          { key: "submitted_at", label: "Submitted At" }
        ];
      }

      function buildSingleRow(row) {
        return {
          full_name: row.full_name || "—",
          matric_number: row.matric_number || "—",
          programme: row.programme || "—",
          level: row.level || "—",
          submitted_at: row.submitted_at ? formatDateTime(row.submitted_at) : "—"
        };
      }

      function buildSummaryColumns() {
        return [
          { key: "question_text", label: "Question" },
          { key: "question_type", label: "Type" },
          { key: "answered_count", label: "Answered" },
          { key: "total_answers", label: "Total Answers" },
          { key: "top_options", label: "Top Options" }
        ];
      }

      function buildSummaryRows(rows) {
        return rows.map((row) => ({
          question_text: row.question_text || "—",
          question_type: formatQuestionType(row.question_type),
          answered_count: String(Number(row.answered_count || 0)),
          total_answers: String(Number(row.total_answers || 0)),
          top_options: Array.isArray(row.options) && row.options.length
            ? row.options.slice(0, 3).map((opt) => `${opt.label} (${opt.count})`).join(", ")
            : "—"
        }));
      }

      function getFilteredRows(rows) {
        const search = cleanText(document.getElementById("exportSearchInput")?.value).toLowerCase();
        const programme = cleanText(document.getElementById("exportProgrammeSelect")?.value);
        const level = cleanText(document.getElementById("exportLevelSelect")?.value);
        const identity = cleanText(document.getElementById("exportIdentitySelect")?.value);

        return rows.filter((row) => {
          const programmeOk = !programme || cleanText(row.programme) === programme;
          const levelOk = !level || cleanText(row.level) === level;

          let identityOk = true;
          if (identity === "identified") identityOk = !row.is_anonymous;
          if (identity === "anonymous") identityOk = !!row.is_anonymous;

          let searchOk = true;
          if (search) {
            const hay = [
              cleanText(row.full_name),
              cleanText(row.matric_number),
              cleanText(row.programme),
              cleanText(row.level)
            ].join(" ").toLowerCase();

            searchOk = hay.includes(search);
          }

          return programmeOk && levelOk && identityOk && searchOk;
        });
      }

      function resolveSingleRow(rows) {
        if (!rows.length) {
          exportSelectedResponseId = null;
          return null;
        }

        if (exportSelectedResponseId) {
          const found = rows.find((row) => String(row.response_id) === String(exportSelectedResponseId));
          if (found) return found;
        }

        exportSelectedResponseId = rows[0].response_id;
        return rows[0];
      }

      function renderExportChips(columns) {
        const wrap = document.getElementById("exportColumnsChips");
        if (!wrap) return;

        wrap.innerHTML = columns.map((col) => `
          <span class="export-chip">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5v14" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            ${escapeHtml(col.label)}
          </span>
        `).join("");
      }

      function renderExportTable(columns, rows) {
        const headRow = document.getElementById("exportTableHeadRow");
        const body = document.getElementById("exportPreviewTableBody");
        if (!headRow || !body) return;

        headRow.innerHTML = columns.map((col) => `<th>${escapeHtml(col.label)}</th>`).join("");

        if (!rows.length) {
          body.innerHTML = `<tr><td colspan="${columns.length}" class="export-empty">No matching rows found for this export view.</td></tr>`;
          return;
        }

        body.innerHTML = rows.map((row) => `
          <tr>
            ${columns.map((col) => `<td class="${col.key.startsWith("q_") || col.key === "top_options" ? "export-answer" : ""}">${escapeHtml(String(row[col.key] ?? "—"))}</td>`).join("")}
          </tr>
        `).join("");
      }

      function updateExportButtons() {
        const text =
          exportFormat === "excel" ? "Export Excel" :
          exportFormat === "csv" ? "Export CSV" :
          exportFormat === "pdf" ? "Export PDF" :
          exportFormat === "word" ? "Export Word" :
          "Export";

        const topBtn = document.getElementById("topExportBtn");
        const downloadBtn = document.getElementById("downloadExportBtn");

        if (topBtn?.querySelector("span")) topBtn.querySelector("span").textContent = text;
        if (downloadBtn?.querySelector("span")) downloadBtn.querySelector("span").textContent = text;
      }

      function renderCustomSelectedColumns() {
        const wrap = document.getElementById("exportCustomSelectedWrap");
        const note = document.getElementById("exportCustomNote");
        if (!wrap || !note) return;

        const values = Array.from(exportCustomSelectedColumns);
        wrap.innerHTML = values.length
          ? values.map((value) => `<span class="export-mini-chip">${escapeHtml(value)}</span>`).join("")
          : `<span class="export-mini-chip">No column selected</span>`;

        note.textContent = values.length
          ? `${values.length} column(s) selected for your custom export table.`
          : "Select columns to build your custom export table.";
      }

      function exportCurrentPreview() {
        const columns = getPreviewColumns();
        const rows = getPreviewRows();

        if (!rows.length) {
          alert("No rows available to export.");
          return;
        }

        if (exportFormat === "csv" || exportFormat === "excel") {
          const csv = buildCsv(columns, rows);
          downloadBlob(csv, buildDownloadName(exportChoice, "csv"), "text/csv;charset=utf-8;");
          return;
        }

        const text = buildPlainText(columns, rows);
        downloadBlob(text, buildDownloadName(exportChoice, "txt"), "text/plain;charset=utf-8;");
      }

      function exportCustomTable() {
        const rows = getFilteredRows(Array.isArray(exportBundle?.individual_responses) ? exportBundle.individual_responses : []);
        const selected = Array.from(exportCustomSelectedColumns);

        if (!selected.length) {
          alert("Select at least one column.");
          return;
        }

        if (!rows.length) {
          alert("No matching responses to export.");
          return;
        }

        const csv = buildCustomCsv(selected, rows);
        downloadBlob(csv, buildDownloadName("custom-table", "csv"), "text/csv;charset=utf-8;");
      }

      function getPreviewColumns() {
        if (exportChoice === "summary") return buildSummaryColumns();
        if (exportChoice === "single") return buildSingleColumns();
        return buildAllColumns(Array.isArray(exportBundle?.questions) ? exportBundle.questions : []);
      }

      function getPreviewRows() {
        const allRows = Array.isArray(exportBundle?.individual_responses) ? exportBundle.individual_responses : [];
        const questions = Array.isArray(exportBundle?.questions) ? exportBundle.questions : [];
        const summaries = Array.isArray(exportBundle?.question_summaries) ? exportBundle.question_summaries : [];

        if (exportChoice === "all") return buildAllRows(allRows, questions);
        if (exportChoice === "filtered") return buildAllRows(getFilteredRows(allRows), questions);
        if (exportChoice === "single") {
          const selected = resolveSingleRow(getFilteredRows(allRows));
          return selected ? [buildSingleRow(selected)] : [];
        }
        return buildSummaryRows(summaries);
      }

      function buildCsv(columns, rows) {
        const header = columns.map((c) => csvEscape(c.label)).join(",");
        const body = rows.map((row) => columns.map((c) => csvEscape(row[c.key] ?? "")).join(",")).join("\n");
        return `${header}\n${body}`;
      }

      function buildPlainText(columns, rows) {
        const lines = [];
        lines.push(`Export Type: ${toTitleCase(exportChoice)}`);
        lines.push(`Form: ${cleanText(exportBundle?.form?.title) || "Form"}`);
        lines.push(`Rows: ${rows.length}`);
        lines.push("");

        rows.forEach((row, index) => {
          lines.push(`Row ${index + 1}`);
          columns.forEach((col) => lines.push(`${col.label}: ${row[col.key] ?? ""}`));
          lines.push("");
        });

        return lines.join("\n");
      }

      function buildCustomCsv(selectedLabels, rows) {
        const header = selectedLabels.map(csvEscape).join(",");
        const body = rows.map((row) => {
          return selectedLabels.map((label) => csvEscape(valueForCustomLabel(row, label))).join(",");
        }).join("\n");

        return `${header}\n${body}`;
      }

      function valueForCustomLabel(row, label) {
        const key = cleanText(label).toLowerCase();

        if (key === "student name") return row.full_name || "";
        if (key === "matric number") return row.matric_number || "";
        if (key === "programme") return row.programme || "";
        if (key === "level") return row.level || "";
        if (key === "submission date") return row.submitted_at ? formatDateTime(row.submitted_at) : "";
        if (key === "response id") return row.response_id || "";

        return "";
      }

      function buildDownloadName(type, ext) {
        const formName = slugify(cleanText(exportBundle?.form?.title) || "form-export");
        return `${formName}-${type}.${ext}`;
      }

      function downloadBlob(content, filename, mimeType) {
        const blob = new Blob([content], { type: mimeType });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      async function invokeFormResponseManager(payload) {
        const { data, error } = await exportSupabase.functions.invoke(
          FORM_RESPONSE_FUNCTION,
          { body: payload }
        );

        if (error) throw new Error(error.message || "Edge function request failed.");
        if (!data?.ok) throw new Error(data?.error || "Could not load export preview.");
        return data;
      }

      function getActorPayloadFromSession() {
        const keys = [
          "colspot_hos_session",
          "colspot_admin_session",
          "hos_session",
          "admin_session",
          "colspot_session"
        ];

        for (const key of keys) {
          const raw = localStorage.getItem(key);
          if (!raw) continue;

          try {
            const parsed = JSON.parse(raw);

            if (parsed?.hos_admin_id) return { hos_admin_id: parsed.hos_admin_id };
            if (parsed?.form_agent_id) return { form_agent_id: parsed.form_agent_id };

            if (parsed?.id && cleanText(parsed.role).toLowerCase() === "hos") {
              return { hos_admin_id: parsed.id };
            }

            if (parsed?.id && cleanText(parsed.role).toLowerCase() === "form_agent") {
              return { form_agent_id: parsed.id };
            }

            if (parsed?.account?.id && cleanText(parsed?.role || parsed?.account?.role).toLowerCase() === "hos") {
              return { hos_admin_id: parsed.account.id };
            }

            if (parsed?.account?.id && cleanText(parsed?.role || parsed?.account?.role).toLowerCase() === "form_agent") {
              return { form_agent_id: parsed.account.id };
            }
          } catch (_) {}
        }

        throw new Error("Admin session not found. Please sign in again.");
      }

      function buildAudienceText(form) {
        const audienceMode = cleanText(form.audience_mode || "all_students");
        if (audienceMode !== "programme_filter") return "All students";

        const targets = Array.isArray(form.programme_targets) ? form.programme_targets : [];
        if (!targets.length) return "Programme filter";

        const first = targets[0];
        const programme = toTitleCase(cleanText(first.programme_name));
        const levels = Array.isArray(first.levels) ? first.levels.join(", ") : "";
        return `${programme} ${levels}`.trim();
      }

      function formatIdentityMode(mode) {
        return cleanText(mode) === "anonymous" ? "Anonymous" : "Use login identity";
      }

      function formatDateTime(value) {
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "—";
        return d.toLocaleString([], {
          day:"numeric",
          month:"short",
          year:"numeric",
          hour:"numeric",
          minute:"2-digit"
        });
      }

      function formatQuestionType(value) {
        return toTitleCase(cleanText(value).replaceAll("_", " "));
      }

      function setText(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = value ?? "";
      }

      function cleanText(value) {
        return String(value ?? "").trim();
      }

      function toTitleCase(value) {
        return cleanText(value)
          .toLowerCase()
          .split(" ")
          .filter(Boolean)
          .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
          .join(" ");
      }

      function uniqueValues(arr) {
        return [...new Set(arr)];
      }

      function csvEscape(value) {
        const s = String(value ?? "");
        if (s.includes('"') || s.includes(",") || s.includes("\n")) {
          return `"${s.replaceAll('"', '""')}"`;
        }
        return s;
      }

      function slugify(value) {
        return cleanText(value)
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "") || "export";
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeHtmlAttr(value) {
        return escapeHtml(value);
      }

      function debounce(fn, wait) {
        let timer = null;
        return function () {
          clearTimeout(timer);
          timer = setTimeout(() => fn(), wait);
        };
      }
    })();
  </script>
