  <script>
    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const hidden = input.type === "password";
      input.type = hidden ? "text" : "password";
      if (btn) btn.textContent = hidden ? "Hide" : "Show";
    }

    function openPrivacy() {
      window.location.href = "Privacy.html";
    }

    function openTerms() {
      window.location.href = "Term.html";
    }

    function safeSetRole(role) {
      try {
        localStorage.setItem("colspot_auth_role", role);
      } catch (e) {
        console.error("Could not save auth role:", e);
      }
    }

    function showAuthSection(role) {
      const rolePanel = document.getElementById("role-select-panel");
      const studentPanel = document.getElementById("student-auth-panel");
      const lecturerPanel = document.getElementById("lecturer-auth-panel");
      const adminPanel = document.getElementById("admin-auth-panel");

      if (rolePanel) rolePanel.classList.add("hidden");
      if (studentPanel) studentPanel.classList.add("hidden");
      if (lecturerPanel) lecturerPanel.classList.add("hidden");
      if (adminPanel) adminPanel.classList.add("hidden");

      if (role === "student" && studentPanel) {
        safeSetRole("student");
        studentPanel.classList.remove("hidden");
      } else if (role === "lecturer" && lecturerPanel) {
        safeSetRole("lecturer");
        lecturerPanel.classList.remove("hidden");
      } else if (role === "admin" && adminPanel) {
        safeSetRole("admin");
        adminPanel.classList.remove("hidden");
      } else if (rolePanel) {
        rolePanel.classList.remove("hidden");
      }
    }

    function backToRoleSelection() {
      const rolePanel = document.getElementById("role-select-panel");
      const studentPanel = document.getElementById("student-auth-panel");
      const lecturerPanel = document.getElementById("lecturer-auth-panel");
      const adminPanel = document.getElementById("admin-auth-panel");

      if (studentPanel) studentPanel.classList.add("hidden");
      if (lecturerPanel) lecturerPanel.classList.add("hidden");
      if (adminPanel) adminPanel.classList.add("hidden");
      if (rolePanel) rolePanel.classList.remove("hidden");
    }

    function signInWithGoogle() {
      if (typeof window.signInWithGoogle === "function") {
        window.signInWithGoogle();
        return;
      }

      const msg = document.getElementById("student-google-message");
      if (msg) {
        msg.textContent = "Google login will be connected in auth.js.";
        msg.className = "message error";
      }
    }

    function updateLecturerSignupRoleUI() {
      const roleSelect = document.getElementById("signup-role");
      const currentRole = (roleSelect?.value || "lecturer").toLowerCase();

      const schoolWrap = document.getElementById("signup-school-wrap");
      const deptWrap = document.getElementById("signup-dept-wrap");
      const lecturerWrap = document.getElementById("lecturer-id-wrap");
      const studentWrap = document.getElementById("student-id-wrap");

      const schoolSelect = document.getElementById("signup-schoolname");
      const deptInput = document.getElementById("signup-dept");
      const lecturerInput = document.getElementById("signup-staffid");
      const studentInput = document.getElementById("signup-studentid");

      const emailLabel = document.getElementById("signup-email-label");
      const emailHint = document.getElementById("lecturer-email-hint");
      const subtitle = document.getElementById("card-subtitle");

      if (currentRole === "student") {
        if (schoolWrap) schoolWrap.classList.add("hidden");
        if (deptWrap) deptWrap.classList.add("hidden");
        if (lecturerWrap) lecturerWrap.classList.add("hidden");
        if (studentWrap) studentWrap.classList.add("hidden");

        if (schoolSelect) {
          schoolSelect.value = "";
          schoolSelect.required = false;
        }

        if (deptInput) deptInput.value = "";
        if (lecturerInput) lecturerInput.value = "";
        if (studentInput) studentInput.value = "";

        if (emailLabel) emailLabel.textContent = "Email";
        if (emailHint) {
          emailHint.textContent = "Use the same email you want to use for your student account.";
        }
        if (subtitle && document.getElementById("signup-form") && !document.getElementById("signup-form").classList.contains("hidden")) {
          subtitle.textContent = "Backup sign up flow";
        }
      } else {
        if (schoolWrap) schoolWrap.classList.remove("hidden");
        if (deptWrap) deptWrap.classList.remove("hidden");
        if (lecturerWrap) lecturerWrap.classList.remove("hidden");
        if (studentWrap) studentWrap.classList.add("hidden");

        if (schoolSelect) {
          schoolSelect.required = true;
        }

        if (studentInput) studentInput.value = "";

        if (emailLabel) emailLabel.textContent = "School email";
        if (emailHint) {
          emailHint.textContent = "Use your official school email only.";
        }
        if (subtitle && document.getElementById("signup-form") && !document.getElementById("signup-form").classList.contains("hidden")) {
          subtitle.textContent = "Sign up as a lecturer";
        }
      }
    }

    async function waitForSupabaseReady() {
      let tries = 0;
      while (!window.supabase && tries < 50) {
        await new Promise(resolve => setTimeout(resolve, 150));
        tries++;
      }

      return !!window.supabase;
    }

    function getDisplayNameFromRow(row) {
      return String(
        row?.name ||
        row?.department_name ||
        row?.title ||
        row?.school_name ||
        row?.department ||
        ""
      ).trim();
    }

    async function waitForSupabaseAndLoadSchools() {
      const schoolInput = document.getElementById("signup-schoolname");
      const schoolsList = document.getElementById("schools-list");
      const loadingNote = document.getElementById("school-loading-note");
      if (!schoolInput || !schoolsList) return;

      const ready = await waitForSupabaseReady();

      if (!ready) {
        if (loadingNote) loadingNote.textContent = "Could not load schools.";
        return;
      }

      try {
        const { data, error } = await window.supabase
          .from("schools")
          .select("id, name")
          .order("name", { ascending: true });

        if (error) throw error;

        schoolsList.innerHTML = "";

        const seen = new Set();

        (data || []).forEach((school) => {
          const schoolName = getDisplayNameFromRow(school);
          const key = schoolName.toLowerCase();

          if (!schoolName || seen.has(key)) return;
          seen.add(key);

          const option = document.createElement("option");
          option.value = schoolName;
          option.label = schoolName;
          schoolsList.appendChild(option);
        });

        if (loadingNote) {
          loadingNote.textContent = seen.size ? "Start typing to search your school." : "No schools found.";
        }
      } catch (err) {
        console.error("Failed to load schools:", err);
        if (loadingNote) loadingNote.textContent = "Could not load schools.";
      }
    }

    async function waitForSupabaseAndLoadDepartments() {
      const deptInput = document.getElementById("signup-dept");
      const departmentsList = document.getElementById("departments-list");
      const loadingNote = document.getElementById("department-loading-note");
      if (!deptInput || !departmentsList) return;

      const ready = await waitForSupabaseReady();

      if (!ready) {
        if (loadingNote) loadingNote.textContent = "Could not load departments.";
        return;
      }

      try {
        const { data, error } = await window.supabase
          .from("departments")
          .select("*")
          .order("name", { ascending: true });

        if (error) throw error;

        departmentsList.innerHTML = "";

        const seen = new Set();

        (data || []).forEach((department) => {
          const departmentName = getDisplayNameFromRow(department);
          const key = departmentName.toLowerCase();

          if (!departmentName || seen.has(key)) return;
          seen.add(key);

          const option = document.createElement("option");
          option.value = departmentName;
          option.label = departmentName;
          departmentsList.appendChild(option);
        });

        if (loadingNote) {
          loadingNote.textContent = seen.size ? "Start typing to search your department." : "No departments found.";
        }
      } catch (err) {
        console.error("Failed to load departments:", err);
        if (loadingNote) loadingNote.textContent = "Could not load departments.";
      }
    }

    (function restoreSavedRoleView() {
      try {
        const savedRole = localStorage.getItem("colspot_auth_role");
        if (savedRole === "student" || savedRole === "lecturer" || savedRole === "admin") {
          window.__colspot_saved_role__ = savedRole;
        }
      } catch (e) {
        console.error("Could not restore saved role:", e);
      }
    })();

    (function guardLecturerEmail() {
      const form = document.getElementById("signup-form");
      const emailInput = document.getElementById("signup-email");
      const roleSelect = document.getElementById("signup-role");
      const messageEl = document.getElementById("signup-message");

      if (!form || !emailInput) return;

      const blockedDomains = [
        "gmail.com", "gmail.com.ng",
        "yahoo.com", "yahoo.com.ng",
        "hotmail.com",
        "outlook.com", "outlook.com.ng",
        "live.com", "live.com.ng",
        "icloud.com", "me.com",
        "aol.com",
        "gmx.com",
        "protonmail.com", "proton.me",
        "yandex.com",
        "zoho.com"
      ];

      form.addEventListener("submit", function (event) {
        const role = (roleSelect?.value || "lecturer").toLowerCase();
        if (role !== "lecturer") return;

        const rawEmail = (emailInput.value || "").trim().toLowerCase();
        const atIndex = rawEmail.lastIndexOf("@");
        const domain = atIndex >= 0 ? rawEmail.slice(atIndex + 1) : "";

        const isBlockedDomain = blockedDomains.includes(domain);
        const looksGenericPersonal = /gmail\.|yahoo\.|hotmail\.|outlook\.|icloud\.|live\.|gmx\.|proton|yandex\.|aol\.|zoho\./.test(domain);
        const isProbablySchool = /\.edu\b/.test(domain) || /\.ac\./.test(domain) || /\.edu\./.test(domain);

        if (!domain || isBlockedDomain || (looksGenericPersonal && !isProbablySchool)) {
          event.preventDefault();
          event.stopImmediatePropagation();

          if (messageEl) {
            messageEl.textContent =
              "Lecturers must sign up with an official school email, not a personal email like Gmail/Yahoo/Outlook.";
            messageEl.classList.remove("success");
            messageEl.classList.add("error");
          }

          emailInput.focus();
        }
      });
    })();

    window.addEventListener("DOMContentLoaded", function () {
      const roleSelect = document.getElementById("signup-role");
      if (roleSelect) {
        roleSelect.value = "lecturer";
        roleSelect.addEventListener("change", updateLecturerSignupRoleUI);
      }

      updateLecturerSignupRoleUI();

      if (window.__colspot_saved_role__) {
        showAuthSection(window.__colspot_saved_role__);
      }

      waitForSupabaseAndLoadSchools();
      waitForSupabaseAndLoadDepartments();
    });
  </script>

