<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Authentication</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1e40af;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --error: #dc2626;
      --success: #16a34a;
      --soft: #eef4ff;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    }

    html,
    body {
      height: 100%;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
      touch-action: manipulation;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px calc(env(safe-area-inset-bottom) + 16px);
      position: relative;
    }

    .splash {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    .splash-card {
      background: var(--card);
      border-radius: 24px;
      padding: 32px 32px 28px;
      box-shadow: 0 18px 45px rgba(15,23,42,0.20);
      text-align: center;
    }

    .splash-logo {
      height: 72px;
      width: auto;
      border-radius: 16px;
      object-fit: cover;
      margin-bottom: 16px;
    }

    .splash-text {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .splash-spinner {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 3px solid rgba(37,99,235,0.25);
      border-top-color: var(--blue);
      animation: spin 0.8s linear infinite;
      margin: 0 auto;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .container {
      width: 100%;
      max-width: 420px;
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 12px 6px 0;
      margin: 0 auto;
    }

    .card {
      width: 100%;
      background: var(--card);
      border-radius: 28px;
      padding: 22px 18px 20px;
      box-shadow: 0 12px 35px rgba(0,0,0,0.08);
      animation: fadeIn 0.35s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .top-row {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      min-height: 56px;
    }

    .top-back-btn {
      position: absolute;
      left: 0;
      width: 46px;
      height: 46px;
      border-radius: 999px;
      border: 1px solid #dbe7ff;
      background: #f8fbff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(37,99,235,0.08);
      padding: 0;
    }

    .top-back-btn svg {
      width: 20px;
      height: 20px;
      stroke: var(--blue);
      stroke-width: 2;
      fill: none;
    }

    .logo {
      text-align: center;
    }

    .logo img {
      height: 54px;
      width: auto;
      display: inline-block;
      border-radius: 12px;
      object-fit: cover;
    }

    h1 {
      text-align: center;
      font-size: 22px;
      margin: 8px 0 4px;
      color: var(--text);
    }

    .subtitle {
      text-align: center;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 18px;
      line-height: 1.45;
    }

    .mode-toggle {
      display: flex;
      background: #e5edff;
      border-radius: 999px;
      padding: 4px;
      margin-bottom: 20px;
      gap: 4px;
    }

    .mode-btn {
      flex: 1;
      border-radius: 999px;
      border: none;
      background: transparent;
      font-size: 14px;
      padding: 8px 0;
      cursor: pointer;
      color: var(--muted);
      font-weight: 500;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .mode-btn.active {
      background: #ffffff;
      color: var(--blue);
      box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }

    label {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 6px;
      display: block;
    }

    input,
    select {
      width: 100%;
      padding: 12px 13px;
      font-size: 17px;
      border-radius: 14px;
      border: 1px solid var(--border);
      margin-bottom: 14px;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
      background: #f9fafb;
    }

    input:focus,
    select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
      background: #ffffff;
    }

    button.primary {
      width: 100%;
      padding: 14px;
      border-radius: 14px;
      border: none;
      font-size: 16px;
      font-weight: 600;
      color: white;
      background: var(--blue);
      cursor: pointer;
      position: relative;
      transition: background 0.2s, transform 0.05s;
      margin-top: 4px;
    }

    button.primary:hover {
      background: var(--blue-dark);
    }

    button.primary:active {
      transform: scale(0.98);
    }

    button.primary:disabled {
      background: #93c5fd;
      cursor: not-allowed;
    }

    .spinner {
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: auto;
    }

    .message {
      margin-top: 10px;
      text-align: center;
      font-size: 13px;
      min-height: 18px;
    }

    .error { color: var(--error); }
    .success { color: var(--success); }

    .bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      font-size: 13px;
      gap: 10px;
    }

    .bottom-row.small {
      margin-top: 6px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .text-link {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      font-weight: 500;
      padding: 0;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link:hover {
      text-decoration: underline;
    }

    .link-inline {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
    }

    .hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: -6px;
      margin-bottom: 10px;
      line-height: 1.45;
    }

    .hidden { display: none !important; }

    .verify-title {
      text-align: center;
      font-size: 18px;
      margin: 6px 0 6px;
      color: var(--text);
      font-weight: 700;
    }

    .verify-box {
      background: #f1f5ff;
      border: 1px solid #dbeafe;
      padding: 12px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 14px;
      text-align: center;
    }

    .password-row {
      display: flex;
      align-items: center;
      margin-bottom: 14px;
      gap: 8px;
    }

    .password-row input {
      margin-bottom: 0;
      flex: 1;
    }

    .password-toggle {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #f9fafb;
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
      color: var(--muted);
    }

    .password-toggle:hover {
      background: #e5e7eb;
    }

    .stepper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 6px 0 16px;
      font-size: 12px;
      color: var(--muted);
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .step-circle {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 2px solid #cbd5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      margin-bottom: 4px;
      background: #e5edff;
      color: #64748b;
    }

    .step.active .step-circle {
      background: var(--blue);
      border-color: var(--blue);
      color: #ffffff;
    }

    .step-line {
      height: 2px;
      background: #cbd5f5;
      margin: 0 4px;
      flex: 1;
    }

    .step-line.active {
      background: var(--blue);
    }

    .location-note {
      margin-top: 14px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.45;
    }

    .auth-footer-links {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      text-align: center;
    }

    .auth-footer-links button {
      border: none;
      background: transparent;
      color: var(--blue);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      padding: 0;
      cursor: pointer;
    }

    .auth-footer-links button:hover {
      text-decoration: underline;
    }

    .auth-footer-divider {
      color: #94a3b8;
      font-size: 12px;
    }

    .role-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 18px;
    }

    .role-card-btn {
      width: 100%;
      border: 1px solid #dbe7ff;
      background: #f8fbff;
      border-radius: 20px;
      padding: 16px 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      cursor: pointer;
      text-align: left;
      transition: transform 0.06s, box-shadow 0.2s, border-color 0.2s, background 0.2s;
      box-shadow: 0 8px 18px rgba(37,99,235,0.06);
    }

    .role-card-btn:hover {
      border-color: #bfd3ff;
      background: #f4f8ff;
    }

    .role-card-btn:active {
      transform: scale(0.985);
    }

    .role-icon {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px solid #dbe7ff;
      flex-shrink: 0;
    }

    .role-icon svg {
      width: 24px;
      height: 24px;
      stroke: #1d4ed8;
      stroke-width: 1.9;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .role-text {
      flex: 1;
      min-width: 0;
    }

    .role-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 3px;
    }

    .role-desc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.4;
    }

    .section-head-badge {
      width: fit-content;
      margin: 0 auto 10px;
      padding: 8px 12px;
      border-radius: 999px;
      background: #eef4ff;
      border: 1px solid #dbe7ff;
      color: var(--blue);
      font-size: 12px;
      font-weight: 700;
    }

    .social-login-wrap {
      margin-top: 10px;
    }

    .google-btn {
      width: 100%;
      min-height: 56px;
      border-radius: 14px;
      border: 1px solid #dbe2f0;
      background: #fff;
      color: #0f172a;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.05s;
      padding: 14px 16px;
    }

    .google-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .google-btn:active {
      transform: scale(0.98);
    }

    .google-g {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      color: #4285F4;
      background: #fff;
      flex-shrink: 0;
    }

    .school-loading-note {
      margin-top: -8px;
      margin-bottom: 10px;
      font-size: 12px;
      color: var(--muted);
    }

    .searchable-input-wrap {
      position: relative;
      width: 100%;
    }

    .searchable-input-wrap input {
      padding-right: 38px;
    }

    .searchable-input-icon {
      position: absolute;
      right: 13px;
      top: 14px;
      width: 16px;
      height: 16px;
      pointer-events: none;
      color: #94a3b8;
    }

    .searchable-input-icon svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .role-backup-box {
      background: #f8fbff;
      border: 1px solid #dbeafe;
      padding: 12px 12px;
      border-radius: 14px;
      margin-bottom: 14px;
    }

    .role-backup-note {
      margin-top: -6px;
      margin-bottom: 10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
    }
  </style>
</head>

<body>
  <div id="splash-screen" class="splash">
    <div class="splash-card">
      <img src="asset/logo walpaper.jpeg" alt="Colspot logo" class="splash-logo" />
      <div class="splash-text">Getting things ready…</div>
      <div class="splash-spinner"></div>
    </div>
  </div>

  <div class="phone-shell">
    <div id="auth-shell" class="container hidden">
      <div class="card">

        <div id="role-select-panel">
          <div class="top-row">
            <div class="logo">
              <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
            </div>
          </div>

          <h1>Select your role</h1>
          <p class="subtitle">Choose how you want to continue into Colspot.</p>

          <div class="role-list">
            <button type="button" class="role-card-btn" onclick="showAuthSection('student')">
              <div class="role-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M3 9l9-4 9 4-9 4-9-4Z"></path>
                  <path d="M7 11v4c0 1.8 2.2 3 5 3s5-1.2 5-3v-4"></path>
                  <path d="M21 10v5"></path>
                </svg>
              </div>
              <div class="role-text">
                <div class="role-title">Student</div>
                <div class="role-desc">Click here if you are a student</div>
              </div>
            </button>

            <button type="button" class="role-card-btn" onclick="showAuthSection('lecturer')">
              <div class="role-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M12 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"></path>
                  <path d="M5 20a7 7 0 0 1 14 0"></path>
                  <path d="M18 6h3v5h-3"></path>
                </svg>
              </div>
              <div class="role-text">
                <div class="role-title">Lecturer</div>
                <div class="role-desc">Click here if you are a lecturer</div>
              </div>
            </button>

            <button type="button" class="role-card-btn" onclick="showAuthSection('admin')">
              <div class="role-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4Z"></path>
                  <path d="M12 10v4"></path>
                  <path d="M12 17h.01"></path>
                </svg>
              </div>
              <div class="role-text">
                <div class="role-title">Admin</div>
                <div class="role-desc">Click here if you are an admin</div>
              </div>
            </button>
          </div>

          <p class="location-note">
            <strong>Colspot uses your location to work properly.</strong><br>
            Please allow location when asked, and make sure Location is turned ON.
          </p>

          <div class="auth-footer-links">
            <button type="button" onclick="openPrivacy()">Privacy Policy</button>
            <span class="auth-footer-divider">•</span>
            <button type="button" onclick="openTerms()">Terms of Service</button>
          </div>
        </div>

        <div id="student-auth-panel" class="hidden">
          <div class="top-row">
            <button type="button" class="top-back-btn" onclick="backToRoleSelection()" aria-label="Back">
              <svg viewBox="0 0 24 24">
                <path d="M15 6l-6 6 6 6"></path>
              </svg>
            </button>

            <div class="logo">
              <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
            </div>
          </div>

          <div class="section-head-badge">Student access</div>
          <h1>Continue with Google</h1>
          <p class="subtitle">Use your current login</p>

          <div class="social-login-wrap">
            <button type="button" class="google-btn" onclick="signInWithGoogle()">
              <span class="google-g">G</span>
              <span>Continue with Google</span>
            </button>
          </div>

          <div id="student-google-message" class="message"></div>

          <p class="location-note">
            <strong>Colspot uses your location to work properly.</strong><br>
            Please allow location when asked, and make sure Location is turned ON.
          </p>

          <div class="auth-footer-links">
            <button type="button" onclick="openPrivacy()">Privacy Policy</button>
            <span class="auth-footer-divider">•</span>
            <button type="button" onclick="openTerms()">Terms of Service</button>
          </div>
        </div>

        <div id="lecturer-auth-panel" class="hidden">
          <div class="top-row">
            <button type="button" class="top-back-btn" onclick="backToRoleSelection()" aria-label="Back">
              <svg viewBox="0 0 24 24">
                <path d="M15 6l-6 6 6 6"></path>
              </svg>
            </button>

            <div class="logo">
              <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
            </div>
          </div>

          <div class="section-head-badge">Lecturer access</div>
          <h1 id="card-title">Welcome back</h1>
          <p class="subtitle" id="card-subtitle">Sign in to your Colspot lecturer account</p>

          <div id="mode-toggle" class="mode-toggle">
            <button id="tab-signin" class="mode-btn active" type="button" onclick="switchMode('signin')">
              Sign in
            </button>
            <button id="tab-signup" class="mode-btn" type="button" onclick="switchMode('signup')">
              Sign up
            </button>
          </div>

          <div id="verify-panel" class="hidden">
            <div class="verify-title">Verify your email</div>

            <div class="verify-box">
              We sent a 6-digit code to:<br>
              <b id="verify-email">your@email.com</b><br><br>
              Enter the code below to finish creating your account.
            </div>

            <label for="verify-code-input">Verification code</label>
            <input id="verify-code-input" type="text" inputmode="numeric" maxlength="6" placeholder="123456" />

            <button id="verify-code-btn" type="button" class="primary">
              <span id="verify-code-text">Verify &amp; continue</span>
              <span id="verify-code-loader" class="spinner hidden"></span>
            </button>

            <div class="bottom-row">
              <button id="resend-btn" type="button" class="text-link">Resend code</button>
              <button id="back-to-signin-btn" type="button" class="text-link">Back</button>
            </div>

            <div id="verify-message" class="message"></div>
          </div>

          <div id="forgot-panel" class="hidden">
            <div class="verify-title">Forgot password</div>
            <p class="subtitle" style="margin-top:0; margin-bottom:10px;">
              Enter your email and we’ll send you a code to reset your password.
            </p>

            <div class="stepper">
              <div class="step active">
                <div class="step-circle">1</div>
                <span>Enter Email</span>
              </div>
              <div class="step-line active"></div>
              <div class="step">
                <div class="step-circle">2</div>
                <span>Verify Code</span>
              </div>
              <div class="step-line"></div>
              <div class="step">
                <div class="step-circle">3</div>
                <span>Reset Password</span>
              </div>
            </div>

            <label for="forgot-email">Email</label>
            <input id="forgot-email" type="email" placeholder="you@example.com" autocomplete="email" />

            <button id="forgot-send-btn" type="button" class="primary">
              <span id="forgot-send-text">Send verification code</span>
              <span id="forgot-send-loader" class="spinner hidden"></span>
            </button>

            <div class="bottom-row">
              <button id="forgot-back-btn" type="button" class="text-link">Back to sign in</button>
            </div>

            <div id="forgot-message" class="message"></div>
          </div>

          <div id="reset-panel" class="hidden">
            <div class="verify-title">Reset your password</div>

            <div class="stepper">
              <div class="step">
                <div class="step-circle">1</div>
                <span>Enter Email</span>
              </div>
              <div class="step-line active"></div>
              <div class="step active">
                <div class="step-circle">2</div>
                <span>Verify Code</span>
              </div>
              <div class="step-line active"></div>
              <div class="step active">
                <div class="step-circle">3</div>
                <span>Reset Password</span>
              </div>
            </div>

            <div class="verify-box">
              We sent a 6-digit reset code to:<br>
              <b id="reset-email-label">your@email.com</b><br><br>
              Enter the code and choose a new password.
            </div>

            <label for="reset-code">Reset code</label>
            <input id="reset-code" type="text" inputmode="numeric" maxlength="6" placeholder="123456" />

            <label for="reset-password">New password</label>
            <div class="password-row">
              <input id="reset-password" type="password" placeholder="At least 6 characters" />
