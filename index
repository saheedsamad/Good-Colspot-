<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Authentication</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1e40af;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --error: #dc2626;
      --success: #16a34a;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    }

    html,
    body {
      height: 100%;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
      touch-action: manipulation;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px calc(env(safe-area-inset-bottom) + 16px);
      position: relative;
    }

    .splash {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    .splash-card {
      background: var(--card);
      border-radius: 24px;
      padding: 32px 32px 28px;
      box-shadow: 0 18px 45px rgba(15,23,42,0.20);
      text-align: center;
    }

    .splash-logo {
      height: 72px;
      width: auto;
      border-radius: 16px;
      object-fit: cover;
      margin-bottom: 16px;
    }

    .splash-text {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .splash-spinner {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 3px solid rgba(37,99,235,0.25);
      border-top-color: var(--blue);
      animation: spin 0.8s linear infinite;
      margin: 0 auto;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .container {
      width: 100%;
      max-width: 420px;
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 12px 6px 0;
      margin: 0 auto;
    }

    .card {
      width: 100%;
      background: var(--card);
      border-radius: 24px;
      padding: 24px 20px 20px;
      box-shadow: 0 12px 35px rgba(0,0,0,0.08);
      animation: fadeIn 0.35s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .logo {
      text-align: center;
      margin-bottom: 12px;
    }

    .logo img {
      height: 52px;
      width: auto;
      display: inline-block;
      border-radius: 12px;
      object-fit: cover;
    }

    h1 {
      text-align: center;
      font-size: 22px;
      margin: 4px 0 4px;
      color: var(--text);
    }

    .subtitle {
      text-align: center;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 18px;
    }

    .mode-toggle {
      display: flex;
      background: #e5edff;
      border-radius: 999px;
      padding: 4px;
      margin-bottom: 20px;
      gap: 4px;
    }

    .mode-btn {
      flex: 1;
      border-radius: 999px;
      border: none;
      background: transparent;
      font-size: 14px;
      padding: 8px 0;
      cursor: pointer;
      color: var(--muted);
      font-weight: 500;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .mode-btn.active {
      background: #ffffff;
      color: var(--blue);
      box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }

    label {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 6px;
      display: block;
    }

    input,
    select {
      width: 100%;
      padding: 12px 13px;
      font-size: 17px;
      border-radius: 12px;
      border: 1px solid var(--border);
      margin-bottom: 14px;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
      background: #f9fafb;
    }

    input:focus,
    select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
      background: #ffffff;
    }

    button.primary {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      font-size: 16px;
      font-weight: 600;
      color: white;
      background: var(--blue);
      cursor: pointer;
      position: relative;
      transition: background 0.2s, transform 0.05s;
      margin-top: 4px;
    }

    button.primary:hover {
      background: var(--blue-dark);
    }

    button.primary:active {
      transform: scale(0.98);
    }

    button.primary:disabled {
      background: #93c5fd;
      cursor: not-allowed;
    }

    .spinner {
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: auto;
    }

    .message {
      margin-top: 10px;
      text-align: center;
      font-size: 13px;
      min-height: 18px;
    }

    .error { color: var(--error); }
    .success { color: var(--success); }

    .bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      font-size: 13px;
      gap: 10px;
    }

    .bottom-row.small {
      margin-top: 6px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .text-link {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      font-weight: 500;
      padding: 0;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link:hover {
      text-decoration: underline;
    }

    .link-inline {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
    }

    .hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: -6px;
      margin-bottom: 10px;
    }

    .hidden { display: none !important; }

    .verify-title {
      text-align: center;
      font-size: 18px;
      margin: 6px 0 6px;
      color: var(--text);
      font-weight: 700;
    }

    .verify-box {
      background: #f1f5ff;
      border: 1px solid #dbeafe;
      padding: 12px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 14px;
      text-align: center;
    }

    .password-row {
      display: flex;
      align-items: center;
      margin-bottom: 14px;
      gap: 8px;
    }

    .password-row input {
      margin-bottom: 0;
      flex: 1;
    }

    .password-toggle {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #f9fafb;
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
      color: var(--muted);
    }

    .password-toggle:hover {
      background: #e5e7eb;
    }

    .stepper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 6px 0 16px;
      font-size: 12px;
      color: var(--muted);
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .step-circle {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 2px solid #cbd5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      margin-bottom: 4px;
      background: #e5edff;
      color: #64748b;
    }

    .step.active .step-circle {
      background: var(--blue);
      border-color: var(--blue);
      color: #ffffff;
    }

    .step-line {
      height: 2px;
      background: #cbd5f5;
      margin: 0 4px;
      flex: 1;
    }

    .step-line.active {
      background: var(--blue);
    }

    .location-note {
      margin-top: 14px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.4;
    }

    .admin-note {
      margin-top: -6px;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.4;
    }

    .admin-back-row {
      margin-top: 10px;
      display: flex;
      justify-content: center;
    }
  </style>
</head>

<body>
  <div id="splash-screen" class="splash">
    <div class="splash-card">
      <img src="asset/logo walpaper.jpeg" alt="Colspot logo" class="splash-logo" />
      <div class="splash-text">Getting things ready…</div>
      <div class="splash-spinner"></div>
    </div>
  </div>

  <div class="phone-shell">
    <div id="auth-shell" class="container hidden">
      <div class="card">
        <div class="logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>

        <h1 id="card-title">Welcome back</h1>
        <p class="subtitle" id="card-subtitle">Sign in to your Colspot account</p>

        <div id="mode-toggle" class="mode-toggle">
          <button id="tab-signin" class="mode-btn active" type="button" onclick="switchMode('signin')">
            Sign in
          </button>
          <button id="tab-signup" class="mode-btn" type="button" onclick="switchMode('signup')">
            Sign up
          </button>
          <button id="tab-admin" class="mode-btn" type="button" onclick="switchMode('admin')">
            Admin
          </button>
        </div>

        <div id="verify-panel" class="hidden">
          <div class="verify-title">Verify your email</div>

          <div class="verify-box">
            We sent a 6-digit code to:<br>
            <b id="verify-email">your@email.com</b><br><br>
            Enter the code below to finish creating your account.
          </div>

          <label for="verify-code-input">Verification code</label>
          <input id="verify-code-input" type="text" inputmode="numeric" maxlength="6" placeholder="123456" />

          <button id="verify-code-btn" type="button" class="primary">
            <span id="verify-code-text">Verify &amp; continue</span>
            <span id="verify-code-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <button id="resend-btn" type="button" class="text-link">Resend code</button>
            <button id="back-to-signin-btn" type="button" class="text-link">Back</button>
          </div>

          <div id="verify-message" class="message"></div>
        </div>

        <div id="forgot-panel" class="hidden">
          <div class="verify-title">Forgot password</div>
          <p class="subtitle" style="margin-top:0; margin-bottom:10px;">
            Enter your email and we’ll send you a code to reset your password.
          </p>

          <div class="stepper">
            <div class="step active">
              <div class="step-circle">1</div>
              <span>Enter Email</span>
            </div>
            <div class="step-line active"></div>
            <div class="step">
              <div class="step-circle">2</div>
              <span>Verify Code</span>
            </div>
            <div class="step-line"></div>
            <div class="step">
              <div class="step-circle">3</div>
              <span>Reset Password</span>
            </div>
          </div>

          <label for="forgot-email">Email</label>
          <input id="forgot-email" type="email" placeholder="you@example.com" autocomplete="email" />

          <button id="forgot-send-btn" type="button" class="primary">
            <span id="forgot-send-text">Send verification code</span>
            <span id="forgot-send-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <button id="forgot-back-btn" type="button" class="text-link">Back to sign in</button>
          </div>

          <div id="forgot-message" class="message"></div>
        </div>

        <div id="reset-panel" class="hidden">
          <div class="verify-title">Reset your password</div>

          <div class="stepper">
            <div class="step">
              <div class="step-circle">1</div>
              <span>Enter Email</span>
            </div>
            <div class="step-line active"></div>
            <div class="step active">
              <div class="step-circle">2</div>
              <span>Verify Code</span>
            </div>
            <div class="step-line active"></div>
            <div class="step active">
              <div class="step-circle">3</div>
              <span>Reset Password</span>
            </div>
          </div>

          <div class="verify-box">
            We sent a 6-digit reset code to:<br>
            <b id="reset-email-label">your@email.com</b><br><br>
            Enter the code and choose a new password.
          </div>

          <label for="reset-code">Reset code</label>
          <input id="reset-code" type="text" inputmode="numeric" maxlength="6" placeholder="123456" />

          <label for="reset-password">New password</label>
          <div class="password-row">
            <input id="reset-password" type="password" placeholder="At least 6 characters" />
            <button type="button" class="password-toggle" onclick="togglePassword('reset-password', this)">Show</button>
          </div>
          <div class="hint">
            Use at least 6 characters, with <strong>letters and numbers</strong>.
          </div>

          <label for="reset-password2">Confirm new password</label>
          <div class="password-row">
            <input id="reset-password2" type="password" placeholder="Repeat password" />
            <button type="button" class="password-toggle" onclick="togglePassword('reset-password2', this)">Show</button>
          </div>

          <button id="reset-submit-btn" type="button" class="primary">
            <span id="reset-submit-text">Change password</span>
            <span id="reset-submit-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <button id="reset-back-btn" type="button" class="text-link">Back to sign in</button>
          </div>

          <div id="reset-message" class="message"></div>
        </div>

        <form id="signin-form">
          <label for="signin-email">Email</label>
          <input id="signin-email" type="email" placeholder="you@example.com" autocomplete="email" required />

          <label for="signin-password">Password</label>
          <div class="password-row">
            <input id="signin-password" type="password" placeholder="••••••••" autocomplete="current-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signin-password', this)">Show</button>
          </div>

          <button id="signin-btn" type="submit" class="primary">
            <span id="signin-text">Sign in</span>
            <span id="signin-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <a href="contactsettings.html" class="text-link">Contact us</a>
            <button type="button" class="text-link" onclick="openForgotPasswordPage()">
              Forgot password?
            </button>
          </div>

          <div id="signin-message" class="message"></div>
        </form>

        <form id="signup-form" class="hidden">
          <label for="signup-fullname">Full name</label>
          <input id="signup-fullname" type="text" placeholder="Saheed Samad" autocomplete="name" required />

          <label for="signup-role">Role</label>
          <select id="signup-role" required>
            <option value="">Select role</option>
            <option value="student">Student</option>
            <option value="lecturer">Lecturer</option>
          </select>

          <label for="signup-schoolname">School name</label>
          <input id="signup-schoolname" type="text" placeholder="Ekiti State University" autocomplete="organization" required />

          <div id="id-field-wrap" class="hidden">
            <label id="signup-id-label" for="signup-matric">Matric number</label>
            <input id="signup-matric" type="text" placeholder="e.g. CSC/21/1234" autocomplete="off" />
            <div id="signup-id-hint" class="hint">
              Make sure this matric number is correct. <strong>You won’t be able to change it later.</strong>
            </div>
          </div>

          <label for="signup-dept">Department</label>
          <input id="signup-dept" type="text" placeholder="Computer Science" autocomplete="organization" required />

          <label for="signup-email">Email</label>
          <input id="signup-email" type="email" placeholder="you@example.com" autocomplete="email" required />

          <div id="lecturer-email-hint" class="hint hidden">
            Lecturers: please use your official <strong>school email</strong>
            (for example <em>name@university.edu</em>). Personal emails like Gmail/Yahoo/Outlook are not allowed.
          </div>

          <label for="signup-password">Password</label>
          <div class="password-row">
            <input id="signup-password" type="password" placeholder="At least 6 characters" autocomplete="new-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signup-password', this)">Show</button>
          </div>
          <div class="hint">
            Use at least 6 characters, with <strong>letters and numbers</strong>.
          </div>

          <label for="signup-password2">Confirm password</label>
          <div class="password-row">
            <input id="signup-password2" type="password" placeholder="Repeat password" autocomplete="new-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signup-password2', this)">Show</button>
          </div>

          <button id="signup-btn" type="submit" class="primary">
            <span id="signup-text">Create account</span>
            <span id="signup-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row small">
            <span style="color:var(--muted); font-size:13px; text-align:center;">
              By signing up you agree to Colspot’s
              <button type="button" class="link-inline" onclick="openPrivacy()">Privacy &amp; Policy</button>.
            </span>
          </div>

          <div class="bottom-row small">
            <span style="color:var(--muted); font-size:13px;">Already have an account?</span>
            <button type="button" class="text-link" onclick="switchMode('signin')">Sign in</button>
          </div>

          <div id="signup-message" class="message"></div>
        </form>

        <form id="admin-form" class="hidden">
          <div class="admin-note">
            Admin accounts are created from above. Enter your admin ID and password.
          </div>

          <label for="admin-id">ID</label>
          <input id="admin-id" type="text" placeholder="Enter admin ID" autocomplete="off" />

          <label for="admin-password">Password</label>
          <div class="password-row">
            <input id="admin-password" type="password" placeholder="••••••••" autocomplete="current-password" />
            <button type="button" class="password-toggle" onclick="togglePassword('admin-password', this)">Show</button>
          </div>

          <button id="admin-btn" type="submit" class="primary">
            <span id="admin-text">Admin login</span>
            <span id="admin-loader" class="spinner hidden"></span>
          </button>

          <div id="admin-message" class="message"></div>
        </form>

        <div id="admin-link-panel" class="hidden">
          <div class="verify-title">Link your email</div>

          <div class="verify-box">
            This is your first admin login.<br>
            Add your email to link this admin account and continue.
          </div>

          <label for="admin-link-email">Email</label>
          <input id="admin-link-email" type="email" placeholder="you@example.com" autocomplete="email" />

          <button id="admin-link-btn" type="button" class="primary">
            <span id="admin-link-text">Send verification code</span>
            <span id="admin-link-loader" class="spinner hidden"></span>
          </button>

          <div class="admin-back-row">
            <button id="admin-link-back-btn" type="button" class="text-link">Back</button>
          </div>

          <div id="admin-link-message" class="message"></div>
        </div>

        <div id="admin-verify-panel" class="hidden">
          <div class="verify-title">Verify admin email</div>

          <div class="verify-box">
            We sent a 6-digit code to:<br>
            <b id="admin-verify-email-label">your@email.com</b><br><br>
            Enter the code below to finish linking this admin account.
          </div>

          <label for="admin-verify-code">Verification code</label>
          <input id="admin-verify-code" type="text" inputmode="numeric" maxlength="6" placeholder="123456" />

          <button id="admin-verify-btn" type="button" class="primary">
            <span id="admin-verify-text">Verify email</span>
            <span id="admin-verify-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <button id="admin-resend-btn" type="button" class="text-link">Resend code</button>
            <button id="admin-verify-back-btn" type="button" class="text-link">Back</button>
          </div>

          <div id="admin-verify-message" class="message"></div>
        </div>

        <div id="switch-row" class="bottom-row" style="margin-top:16px;">
          <span id="switch-text" style="font-size:13px; color:var(--muted);">
            Don’t have an account?
          </span>
          <button type="button" class="text-link" onclick="toggleAuthMode()">
            <span id="switch-link-label">Create one</span>
          </button>
        </div>

        <p class="location-note">
          <strong>Colspot uses your location to work properly.</strong><br>
          Please allow location when asked, and make sure Location is turned ON<br>
          (Android: Quick Settings • iPhone: Settings → Privacy → Location Services).
        </p>
      </div>
    </div>
  </div>

  <script>
    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const hidden = input.type === "password";
      input.type = hidden ? "text" : "password";
      if (btn) btn.textContent = hidden ? "Hide" : "Show";
    }

    function openPrivacy() {
      window.location.href = "privacy.html";
    }

    (function setupRoleUI() {
      const roleSelect = document.getElementById("signup-role");
      const idFieldWrap = document.getElementById("id-field-wrap");
      const idLabel = document.getElementById("signup-id-label");
      const idInput = document.getElementById("signup-matric");
      const idHint = document.getElementById("signup-id-hint");
      const lecturerHint = document.getElementById("lecturer-email-hint");

      if (!roleSelect) return;

      roleSelect.addEventListener("change", function () {
        const role = roleSelect.value;

        if (!role) {
          if (idFieldWrap) idFieldWrap.classList.add("hidden");
          if (lecturerHint) lecturerHint.classList.add("hidden");
          if (idInput) {
            idInput.value = "";
            idInput.required = false;
            idInput.placeholder = "";
          }
          return;
        }

        if (idFieldWrap) idFieldWrap.classList.remove("hidden");
        if (idInput) idInput.required = true;

        if (role === "student") {
          if (idLabel) idLabel.textContent = "Matric number";
          if (idInput) idInput.placeholder = "e.g. CSC/21/1234";
          if (idHint) {
            idHint.innerHTML = "Make sure this matric number is correct. <strong>You won’t be able to change it later.</strong>";
          }
          if (lecturerHint) lecturerHint.classList.add("hidden");
        } else if (role === "lecturer") {
          if (idLabel) idLabel.textContent = "Staff ID";
          if (idInput) idInput.placeholder = "Enter your staff ID";
          if (idHint) {
            idHint.innerHTML = "Make sure this staff ID is correct before continuing.";
          }
          if (lecturerHint) lecturerHint.classList.remove("hidden");
        }
      });
    })();

    (function guardLecturerEmail() {
      const form = document.getElementById("signup-form");
      const emailInput = document.getElementById("signup-email");
      const roleSelect = document.getElementById("signup-role");
      const messageEl = document.getElementById("signup-message");

      if (!form || !emailInput || !roleSelect) return;

      const blockedDomains = [
        "gmail.com", "gmail.com.ng",
        "yahoo.com", "yahoo.com.ng",
        "hotmail.com",
        "outlook.com", "outlook.com.ng",
        "live.com", "live.com.ng",
        "icloud.com", "me.com",
        "aol.com",
        "gmx.com",
        "protonmail.com", "proton.me",
        "yandex.com",
        "zoho.com"
      ];

      form.addEventListener("submit", function (event) {
        const role = roleSelect.value;
        if (role !== "lecturer") return;

        const rawEmail = (emailInput.value || "").trim().toLowerCase();
        const atIndex = rawEmail.lastIndexOf("@");
        const domain = atIndex >= 0 ? rawEmail.slice(atIndex + 1) : "";

        const isBlockedDomain = blockedDomains.includes(domain);
        const looksGenericPersonal = /gmail\.|yahoo\.|hotmail\.|outlook\.|icloud\.|live\.|gmx\.|proton|yandex\.|aol\.|zoho\./.test(domain);
        const isProbablySchool = /\.edu\b/.test(domain) || /\.ac\./.test(domain) || /\.edu\./.test(domain);

        if (!domain || isBlockedDomain || (looksGenericPersonal && !isProbablySchool)) {
          event.preventDefault();
          event.stopImmediatePropagation();

          if (messageEl) {
            messageEl.textContent =
              "Lecturers must sign up with an official school email (e.g. name@university.edu), not a personal email like Gmail/Yahoo/Outlook.";
            messageEl.classList.remove("success");
            messageEl.classList.add("error");
          }

          emailInput.focus();
        }
      });
    })();
  </script>

  <script type="module" src="./client_supabase.js"></script>
  <script src="./auth.js"></script>

  <script>
  (function adminFrontendBridge() {
    const titleEl = document.getElementById("card-title");
    const subEl = document.getElementById("card-subtitle");

    const tabSignin = document.getElementById("tab-signin");
    const tabSignup = document.getElementById("tab-signup");
    const tabAdmin = document.getElementById("tab-admin");

    const modeToggle = document.getElementById("mode-toggle");
    const switchRow = document.getElementById("switch-row");

    const signinForm = document.getElementById("signin-form");
    const signupForm = document.getElementById("signup-form");

    const verifyPanel = document.getElementById("verify-panel");
    const forgotPanel = document.getElementById("forgot-panel");
    const resetPanel = document.getElementById("reset-panel");

    const adminForm = document.getElementById("admin-form");
    const adminLinkPanel = document.getElementById("admin-link-panel");
    const adminVerifyPanel = document.getElementById("admin-verify-panel");

    const adminMessage = document.getElementById("admin-message");
    const adminLinkMessage = document.getElementById("admin-link-message");
    const adminVerifyMessage = document.getElementById("admin-verify-message");

    const adminVerifyEmailLabel = document.getElementById("admin-verify-email-label");

    const adminIdInput = document.getElementById("admin-id");
    const adminPasswordInput = document.getElementById("admin-password");
    const adminLinkEmailInput = document.getElementById("admin-link-email");
    const adminVerifyCodeInput = document.getElementById("admin-verify-code");

    function setButtonLoading(btnId, textId, loaderId, isLoading) {
      const btn = document.getElementById(btnId);
      const text = document.getElementById(textId);
      const loader = document.getElementById(loaderId);

      if (!btn) return;
      btn.disabled = isLoading;

      if (text && loader) {
        if (isLoading) {
          text.classList.add("hidden");
          loader.classList.remove("hidden");
        } else {
          text.classList.remove("hidden");
          loader.classList.add("hidden");
        }
      }
    }

    function clearAdminMessages() {
      [adminMessage, adminLinkMessage, adminVerifyMessage].forEach((el) => {
        if (!el) return;
        el.textContent = "";
        el.className = "message";
      });
    }

    function setActive(tab) {
      [tabSignin, tabSignup, tabAdmin].forEach((btn) => btn && btn.classList.remove("active"));
      if (tab) tab.classList.add("active");
    }

    function hideAllPanels() {
      [
        signinForm,
        signupForm,
        verifyPanel,
        forgotPanel,
        resetPanel,
        adminForm,
        adminLinkPanel,
        adminVerifyPanel
      ].forEach((el) => el && el.classList.add("hidden"));
    }

    function showAdminLogin() {
      hideAllPanels();
      if (titleEl) titleEl.textContent = "Admin login";
      if (subEl) subEl.textContent = "Sign in to your Colspot admin account";
      if (modeToggle) modeToggle.classList.remove("hidden");
      if (switchRow) switchRow.classList.add("hidden");
      if (adminForm) adminForm.classList.remove("hidden");
      clearAdminMessages();
      setActive(tabAdmin);
    }

    function showAdminLinkEmail(prefill = "") {
      hideAllPanels();
      if (titleEl) titleEl.textContent = "Link your email";
      if (subEl) subEl.textContent = "Add your email to continue";
      if (modeToggle) modeToggle.classList.add("hidden");
      if (switchRow) switchRow.classList.add("hidden");
      if (adminLinkPanel) adminLinkPanel.classList.remove("hidden");
      if (adminLinkEmailInput) adminLinkEmailInput.value = prefill || "";
      clearAdminMessages();
    }

    function showAdminVerify(email = "") {
      hideAllPanels();
      if (titleEl) titleEl.textContent = "Verify admin email";
      if (subEl) subEl.textContent = "Enter the code sent to your email";
      if (modeToggle) modeToggle.classList.add("hidden");
      if (switchRow) switchRow.classList.add("hidden");
      if (adminVerifyPanel) adminVerifyPanel.classList.remove("hidden");
      if (adminVerifyEmailLabel) adminVerifyEmailLabel.textContent = email || "";
      if (adminVerifyCodeInput) adminVerifyCodeInput.value = "";
      clearAdminMessages();
    }

    function restoreNormalMode(mode) {
      clearAdminMessages();
      if (mode === "signup") {
        if (typeof window.switchMode === "function" && window.switchMode.__wrapped_admin__) {
          window.switchMode.__original__("signup");
        } else if (typeof window.switchMode === "function") {
          window.switchMode("signup");
        }
      } else {
        if (typeof window.switchMode === "function" && window.switchMode.__wrapped_admin__) {
          window.switchMode.__original__("signin");
        } else if (typeof window.switchMode === "function") {
          window.switchMode("signin");
        }
      }
    }

    function getPendingAdmin() {
      try {
        return JSON.parse(localStorage.getItem("colspot_pending_admin") || "null");
      } catch {
        return null;
      }
    }

    function savePendingAdmin(data) {
      localStorage.setItem("colspot_pending_admin", JSON.stringify(data || null));
    }

    function clearPendingAdmin() {
      localStorage.removeItem("colspot_pending_admin");
    }

    function saveAdminSession(admin) {
      localStorage.setItem("colspot_admin_session", JSON.stringify(admin));
    }

    function goToDashboard(role) {
      const cleanRole = String(role || "").trim().toLowerCase();

      if (cleanRole === "super_admin") {
        window.location.href = "super_admin.html";
      } else if (cleanRole === "hos") {
        window.location.href = "hos.html";
      } else if (cleanRole === "hod") {
        window.location.href = "hod.html";
      } else {
        if (adminMessage) {
          adminMessage.textContent = "Unknown admin role.";
          adminMessage.className = "message error";
        }
      }
    }

    async function invokeEdge(functionName, body) {
      if (!window.supabase) {
        throw new Error("Supabase is not ready yet.");
      }

      const { data, error } = await window.supabase.functions.invoke(functionName, { body });

      console.log(functionName + " data:", data);
      console.log(functionName + " error:", error);

      if (error) {
        throw new Error(
          (data && data.error) ||
          error.message ||
          "Edge Function request failed."
        );
      }

      return data;
    }

    const originalSwitchMode = window.switchMode;
    const originalToggleAuthMode = window.toggleAuthMode;

    window.switchMode = function(mode) {
      if (mode === "admin") {
        showAdminLogin();
        return;
      }

      clearPendingAdmin();

      if (typeof originalSwitchMode === "function") {
        return originalSwitchMode(mode);
      }
    };
    window.switchMode.__wrapped_admin__ = true;
    window.switchMode.__original__ = originalSwitchMode;

    window.toggleAuthMode = function() {
      if (
        !adminForm.classList.contains("hidden") ||
        !adminLinkPanel.classList.contains("hidden") ||
        !adminVerifyPanel.classList.contains("hidden")
      ) {
        return restoreNormalMode("signin");
      }

      if (typeof originalToggleAuthMode === "function") {
        return originalToggleAuthMode();
      }
    };

    adminForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearAdminMessages();

      const loginId = (adminIdInput?.value || "").trim();
      const password = adminPasswordInput?.value || "";

      if (!loginId || !password) {
        adminMessage.textContent = "Please enter ID and password.";
        adminMessage.className = "message error";
        return;
      }

      try {
        setButtonLoading("admin-btn", "admin-text", "admin-loader", true);

        const result = await invokeEdge("admin-login", {
          login_id: loginId,
          password
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Admin login failed.");
        }

        const admin = {
          ...(result.account || {}),
          role: result.role || ""
        };

        console.log("result from backend:", result);
        console.log("final admin object:", admin);

        saveAdminSession(admin);

        if (admin.needs_email_link) {
          savePendingAdmin({
            id: admin.id,
            role: admin.role,
            login_id: admin.login_id,
            linked_email: admin.linked_email || ""
          });
          showAdminLinkEmail(admin.linked_email || "");
          return;
        }

        goToDashboard(admin.role);
      } catch (err) {
        console.error(err);
        adminMessage.textContent = err.message || "Could not connect to admin login.";
        adminMessage.className = "message error";
      } finally {
        setButtonLoading("admin-btn", "admin-text", "admin-loader", false);
      }
    });

    document.getElementById("admin-link-btn")?.addEventListener("click", async () => {
      clearAdminMessages();

      const pending = getPendingAdmin();
      const email = (adminLinkEmailInput?.value || "").trim().toLowerCase();

      if (!pending?.id) {
        adminLinkMessage.textContent = "Admin session not found. Please login again.";
        adminLinkMessage.className = "message error";
        return;
      }

      if (!email) {
        adminLinkMessage.textContent = "Please enter your email.";
        adminLinkMessage.className = "message error";
        return;
      }

      try {
        setButtonLoading("admin-link-btn", "admin-link-text", "admin-link-loader", true);

        const result = await invokeEdge("admin-send-link-email", {
          admin_id: pending.id,
          email
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Could not send verification code.");
        }

        savePendingAdmin({
          ...pending,
          email
        });

        showAdminVerify(email);

        if (adminVerifyMessage) {
          if (result.dev_otp) {
            adminVerifyMessage.textContent = "Verification code sent. Dev OTP: " + result.dev_otp;
          } else {
            adminVerifyMessage.textContent = result.message || "Verification code sent successfully.";
          }
          adminVerifyMessage.className = "message success";
        }
      } catch (err) {
        console.error(err);
        adminLinkMessage.textContent = err.message || "Could not send verification code.";
        adminLinkMessage.className = "message error";
      } finally {
        setButtonLoading("admin-link-btn", "admin-link-text", "admin-link-loader", false);
      }
    });

    document.getElementById("admin-verify-btn")?.addEventListener("click", async () => {
      clearAdminMessages();

      const pending = getPendingAdmin();
      const code = (adminVerifyCodeInput?.value || "").trim();

      if (!pending?.id || !pending?.email) {
        adminVerifyMessage.textContent = "Admin session not found. Please login again.";
        adminVerifyMessage.className = "message error";
        return;
      }

      if (!code) {
        adminVerifyMessage.textContent = "Please enter the verification code.";
        adminVerifyMessage.className = "message error";
        return;
      }

      try {
        setButtonLoading("admin-verify-btn", "admin-verify-text", "admin-verify-loader", true);

        const result = await invokeEdge("admin-verify-link-email", {
          admin_id: pending.id,
          email: pending.email,
          code
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Verification failed.");
        }

        const admin = {
          ...(result.admin || result.account || {}),
          role: result.role || (result.admin && result.admin.role) || ""
        };

        saveAdminSession(admin);
        clearPendingAdmin();

        adminVerifyMessage.textContent = "Email verified successfully. Redirecting...";
        adminVerifyMessage.className = "message success";

        setTimeout(() => {
          goToDashboard(admin.role);
        }, 600);
      } catch (err) {
        console.error(err);
        adminVerifyMessage.textContent = err.message || "Verification failed.";
        adminVerifyMessage.className = "message error";
      } finally {
        setButtonLoading("admin-verify-btn", "admin-verify-text", "admin-verify-loader", false);
      }
    });

    document.getElementById("admin-resend-btn")?.addEventListener("click", async () => {
      clearAdminMessages();

      const pending = getPendingAdmin();
      if (!pending?.id || !pending?.email) {
        adminVerifyMessage.textContent = "Admin session not found. Please login again.";
        adminVerifyMessage.className = "message error";
        return;
      }

      try {
        const result = await invokeEdge("admin-send-link-email", {
          admin_id: pending.id,
          email: pending.email
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Could not resend code.");
        }

        if (result.dev_otp) {
          adminVerifyMessage.textContent = "New code sent. Dev OTP: " + result.dev_otp;
        } else {
          adminVerifyMessage.textContent = result.message || "A new verification code has been sent.";
        }
        adminVerifyMessage.className = "message success";
      } catch (err) {
        console.error(err);
        adminVerifyMessage.textContent = err.message || "Could not resend code.";
        adminVerifyMessage.className = "message error";
      }
    });

    document.getElementById("admin-link-back-btn")?.addEventListener("click", () => {
      showAdminLogin();
    });

    document.getElementById("admin-verify-back-btn")?.addEventListener("click", () => {
      const pending = getPendingAdmin();
      showAdminLinkEmail(pending?.email || "");
    });
  })();
</script>
