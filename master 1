  try {
    state.announcementLoading = true;
    renderAnnouncementPreview();

    const payload = {
      action: "preview_matched_students",
      audience_mode: state.currentForm.audience_mode || "all_students",
      programme_targets: Array.isArray(state.currentForm.programme_targets)
        ? state.currentForm.programme_targets
        : [],
      ...getActorPayload()
    };

    console.log("MATCHED STUDENTS PREVIEW BODY:", payload);

    const data = await invokeFormsManager(payload);

    console.log("MATCHED STUDENTS PREVIEW RESULT:", data);

    state.matchedStudentsPreview = Array.isArray(data.matched_students)
      ? data.matched_students
      : [];

    updateAudienceMatchedCountUI();
    renderAnnouncementPreview();
  } catch (err) {
    console.error("Matched students preview error:", err);
    state.matchedStudentsPreview = [];
    updateAudienceMatchedCountUI();
    renderAnnouncementPreview();
  } finally {
    state.announcementLoading = false;
    renderAnnouncementPreview();
  }
}

