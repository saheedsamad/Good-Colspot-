  async function invokeFormsManager(body) {
    if (!state.sb) throw new Error("Supabase is not ready.");

    console.log("FORMS BODY SENT:", JSON.stringify(body, null, 2));

    const { data, error } = await state.sb.functions.invoke(FORMS_FUNCTION, { body });

    console.log("FORMS RAW DATA:", data);
