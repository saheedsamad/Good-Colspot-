<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colspot • Main HOS</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#f4f7fb;
      --panel:#ffffff;
      --line:#e5e7eb;
      --text:#0f172a;
      --muted:#6b7280;
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#eff6ff;
      --green:#16a34a;
      --green-soft:#effdf4;
      --orange:#f97316;
      --orange-soft:#fff7ed;
      --red:#ef4444;
      --red-soft:#fef2f2;
      --shadow:0 20px 45px rgba(15,23,42,.08);
      --shadow-soft:0 10px 25px rgba(37,99,235,.08);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:18px;
      --radius-sm:14px;
      --sidebar-w:270px;
      --topbar-h:88px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      height:100%;
      background:linear-gradient(180deg,#eef4ff 0%, #f7faff 28%, #ffffff 100%);
      color:var(--text);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    }

    body{
      overflow:hidden;
    }

    .app-shell{
      display:flex;
      height:100vh;
      width:100%;
    }

    .sidebar{
      width:var(--sidebar-w);
      min-width:var(--sidebar-w);
      background:
        radial-gradient(circle at top left, rgba(59,130,246,.22), transparent 35%),
        linear-gradient(180deg,#102a56 0%, #102342 52%, #0c1a31 100%);
      color:#fff;
      display:flex;
      flex-direction:column;
      border-right:1px solid rgba(255,255,255,.08);
      overflow:hidden;
    }

    .sidebar-top{
      padding:22px 20px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .brand-logo{
      width:48px;
      height:48px;
      border-radius:16px;
      background:rgba(255,255,255,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      backdrop-filter:blur(8px);
      box-shadow:0 12px 24px rgba(0,0,0,.12);
      flex-shrink:0;
    }

    .brand-logo svg{
      width:24px;
      height:24px;
      color:#fff;
    }

    .brand-text{
      min-width:0;
    }

    .brand-kicker{
      font-size:12px;
      letter-spacing:.08em;
      text-transform:uppercase;
      opacity:.78;
      font-weight:700;
      margin-bottom:2px;
    }

    .brand-title{
      font-size:24px;
      font-weight:900;
      letter-spacing:-.03em;
      white-space:nowrap;
    }

    .brand-sub{
      font-size:12px;
      opacity:.82;
      margin-top:2px;
    }

    .sidebar-nav{
      padding:16px 10px 18px;
      overflow:auto;
      flex:1;
    }

    .sidebar-nav::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .nav-group{
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .nav-btn{
      width:100%;
      border:none;
      background:transparent;
      color:rgba(255,255,255,.88);
      border-radius:18px;
      padding:14px 14px;
      display:flex;
      align-items:center;
      gap:12px;
      cursor:pointer;
      text-align:left;
      transition:.18s ease;
      font-size:15px;
      font-weight:700;
    }

    .nav-btn:hover{
      background:rgba(255,255,255,.08);
      color:#fff;
    }

    .nav-btn.active{
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      color:#fff;
      box-shadow:0 16px 30px rgba(37,99,235,.30);
    }

    .nav-icon{
      width:22px;
      height:22px;
      flex-shrink:0;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .nav-icon svg{
      width:22px;
      height:22px;
      display:block;
    }

    .sidebar-bottom{
      padding:14px 14px 18px;
      border-top:1px solid rgba(255,255,255,.08);
    }

    .school-chip{
      border-radius:20px;
      padding:14px;
      background:rgba(255,255,255,.08);
      backdrop-filter:blur(8px);
    }

    .school-chip-label{
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.08em;
      opacity:.75;
      font-weight:700;
      margin-bottom:6px;
    }

    .school-chip-name{
      font-size:15px;
      font-weight:800;
      line-height:1.3;
    }

    .main-wrap{
      flex:1;
      min-width:0;
      display:flex;
      flex-direction:column;
      height:100vh;
      overflow:hidden;
    }

    .topbar{
      min-height:var(--topbar-h);
      background:rgba(255,255,255,.78);
      backdrop-filter:blur(14px);
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      padding:18px 26px;
      flex-shrink:0;
    }

    .topbar-left{
      min-width:0;
    }

    .page-title{
      margin:0;
      font-size:20px;
      font-weight:900;
      letter-spacing:-.03em;
    }

    .page-sub{
      margin-top:4px;
      color:var(--muted);
      font-size:13px;
    }

    .topbar-right{
      display:flex;
      align-items:center;
      gap:16px;
      flex-shrink:0;
    }

    .search-box{
      width:300px;
      max-width:32vw;
      height:46px;
      background:#fff;
      border:1px solid var(--line);
      border-radius:16px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
      box-shadow:var(--shadow-soft);
    }

    .search-box svg{
      width:18px;
      height:18px;
      color:#6b7280;
      flex-shrink:0;
    }

    .search-box input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      font-size:14px;
      color:var(--text);
    }

    .identity-chip{
      display:flex;
      align-items:center;
      gap:12px;
      min-width:0;
    }

    .identity-meta{
      text-align:right;
      min-width:0;
    }

    .identity-school{
      font-size:14px;
      font-weight:800;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      max-width:240px;
    }

    .identity-role{
      font-size:12px;
      color:var(--muted);
      margin-top:2px;
    }

    .identity-avatar{
      width:46px;
      height:46px;
      border-radius:50%;
      border:none;
      background:linear-gradient(135deg,#1d4ed8,#22c55e);
      color:#fff;
      font-size:18px;
      font-weight:900;
      cursor:pointer;
      box-shadow:var(--shadow);
      flex-shrink:0;
    }

    .content-scroll{
      flex:1;
      min-height:0;
      overflow:auto;
      padding:24px 24px 28px;
    }

    .content-scroll::-webkit-scrollbar{
      width:10px;
    }

    .content-scroll::-webkit-scrollbar-thumb{
      background:#dbe3ee;
      border-radius:999px;
      border:2px solid transparent;
      background-clip:content-box;
    }

    .screen{
      display:none;
      animation:fadeIn .18s ease;
    }

    .screen.active{
      display:block;
    }

    @keyframes fadeIn{
      from{opacity:0; transform:translateY(6px);}
      to{opacity:1; transform:translateY(0);}
    }

    .message{
      display:none;
      margin-bottom:16px;
      border-radius:16px;
      padding:14px 16px;
      font-size:14px;
      line-height:1.5;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      display:block;
      background:#effdf4;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .hero{
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 60%, #60a5fa 100%);
      color:#fff;
      border-radius:var(--radius-xl);
      padding:28px;
      position:relative;
      overflow:hidden;
      box-shadow:0 24px 50px rgba(37,99,235,.22);
      margin-bottom:20px;
    }

    .hero::before{
      content:"";
      position:absolute;
      right:-40px;
      top:-28px;
      width:200px;
      height:200px;
      border-radius:50%;
      background:rgba(255,255,255,.10);
    }

    .hero::after{
      content:"";
      position:absolute;
      right:10px;
      bottom:-45px;
      width:240px;
      height:110px;
      border-radius:50%;
      background:rgba(255,255,255,.08);
      transform:rotate(-10deg);
    }

    .hero-line{
      position:relative;
      z-index:1;
      font-size:13px;
      font-weight:800;
      opacity:.95;
      margin-bottom:8px;
      letter-spacing:.03em;
    }

    .hero-title{
      position:relative;
      z-index:1;
      margin:0;
      font-size:36px;
      line-height:1.08;
      letter-spacing:-.04em;
      font-weight:900;
      max-width:760px;
    }

    .hero-sub{
      position:relative;
      z-index:1;
      margin-top:12px;
      font-size:14px;
      line-height:1.6;
      opacity:.96;
      max-width:760px;
    }

    .hero-actions{
      position:relative;
      z-index:1;
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:18px;
    }

    .hero-btn{
      border:none;
      border-radius:16px;
      padding:13px 16px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      box-shadow:0 12px 24px rgba(0,0,0,.12);
    }

    .hero-btn.primary{
      background:#fff;
      color:#1d4ed8;
    }

    .hero-btn.soft{
      background:rgba(255,255,255,.14);
      color:#fff;
      backdrop-filter:blur(10px);
    }

    .hero-btn svg{
      width:18px;
      height:18px;
    }

    .grid-cards{
      display:grid;
      grid-template-columns:repeat(6,minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px;
      min-height:126px;
      box-shadow:var(--shadow-soft);
      position:relative;
      overflow:hidden;
    }

    .stat-card::after{
      content:"";
      position:absolute;
      right:-18px;
      bottom:-18px;
      width:82px;
      height:82px;
      border-radius:50%;
      background:var(--blue-soft);
    }

    .stat-label{
      position:relative;
      z-index:1;
      color:var(--muted);
      font-size:13px;
      font-weight:700;
      margin-bottom:14px;
    }

    .stat-value{
      position:relative;
      z-index:1;
      font-size:40px;
      line-height:1;
      letter-spacing:-.06em;
      font-weight:900;
      margin-bottom:8px;
    }

    .stat-note{
      position:relative;
      z-index:1;
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
    }

    .actions-panel{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      padding:18px;
      box-shadow:var(--shadow-soft);
      margin-bottom:18px;
    }

    .actions-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:16px;
    }

    .action-btn{
      border:none;
      border-radius:18px;
      padding:18px 16px;
      color:#fff;
      cursor:pointer;
      text-align:left;
      font-weight:800;
      display:flex;
      align-items:center;
      gap:12px;
      min-height:74px;
      box-shadow:0 16px 30px rgba(15,23,42,.12);
    }

    .action-btn svg{
      width:24px;
      height:24px;
      flex-shrink:0;
    }

    .action-btn.blue{ background:linear-gradient(135deg,#2563eb,#1d4ed8); }
    .action-btn.green{ background:linear-gradient(135deg,#65a30d,#4d7c0f); }
    .action-btn.orange{ background:linear-gradient(135deg,#fb923c,#ea580c); }
    .action-btn.teal{ background:linear-gradient(135deg,#16a34a,#15803d); }

    .two-col{
      display:grid;
      grid-template-columns:1.15fr .9fr;
      gap:18px;
      margin-bottom:18px;
    }

    .panel{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:var(--shadow-soft);
      overflow:hidden;
    }

    .panel-head{
      padding:18px 20px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      background:linear-gradient(180deg,#ffffff 0%, #fafcff 100%);
    }

    .panel-title{
      font-size:16px;
      font-weight:900;
      letter-spacing:-.02em;
    }

    .panel-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:3px;
    }

    .panel-body{
      padding:18px 20px;
    }

    .live-empty{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:160px;
      text-align:center;
      color:var(--muted);
      font-size:14px;
      line-height:1.6;
      border:1px dashed #d7e0eb;
      border-radius:18px;
      background:#fbfdff;
      padding:22px;
    }

    .list-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      box-shadow:var(--shadow-soft);
      overflow:hidden;
    }

    .section-shell{
      display:grid;
      gap:18px;
    }

    .create-account-wrap{
      display:grid;
      gap:18px;
    }

    .create-account-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
    }

    .create-account-grid{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:18px;
    }

    .create-panel{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:var(--shadow-soft);
      overflow:hidden;
    }

    .create-panel-head{
      padding:18px 20px;
      border-bottom:1px solid var(--line);
      background:linear-gradient(180deg,#ffffff 0%, #fafcff 100%);
    }

    .create-panel-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    .create-panel-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.5;
    }

    .create-form{
      padding:20px;
      display:grid;
      gap:16px;
    }

    .form-row{
      display:grid;
      gap:14px;
    }

    .form-row.two{
      grid-template-columns:1fr 1fr;
    }

    .field{
      display:grid;
      gap:8px;
    }

    .field label{
      font-size:13px;
      font-weight:800;
      color:#0f172a;
    }

    .field input,
    .field select{
      width:100%;
      height:52px;
      border:1px solid #dbe3ee;
      border-radius:16px;
      outline:none;
      padding:0 15px;
      font-size:14px;
      color:#0f172a;
      background:#fff;
    }

    .field input:focus,
    .field select:focus{
      border-color:#2563eb;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    .optional-text{
      font-weight:700;
      color:var(--muted);
      font-size:12px;
    }

    .read-only-box{
      min-height:52px;
      border:1px solid #dbe3ee;
      border-radius:16px;
      padding:14px 15px;
      font-size:14px;
      color:#475569;
      background:#f8fbff;
      display:flex;
      align-items:center;
    }

    .create-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      padding-top:4px;
    }

    .primary-create-btn,
    .secondary-create-btn{
      border:none;
      border-radius:16px;
      min-height:52px;
      padding:0 18px;
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
    }

    .primary-create-btn{
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      color:#fff;
      box-shadow:0 16px 30px rgba(37,99,235,.22);
    }

    .secondary-create-btn{
      background:#eff6ff;
      color:#1d4ed8;
    }

    .primary-create-btn svg,
    .secondary-create-btn svg{
      width:18px;
      height:18px;
    }

    .primary-create-btn:disabled,
    .secondary-create-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .mini-alert{
      border-radius:16px;
      padding:13px 14px;
      font-size:13px;
      line-height:1.5;
    }

    .mini-alert.error{
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .mini-alert.success{
      background:#effdf4;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .created-state{
      padding:24px 20px;
      color:var(--muted);
      font-size:14px;
    }

    .created-list{
      padding:0 18px 18px;
    }

    .created-item{
      border:1px solid #e9eef5;
      border-radius:18px;
      padding:16px;
      margin-top:14px;
      background:#fff;
    }

    .created-item:first-child{
      margin-top:18px;
    }

    .created-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:10px;
    }

    .created-name{
      font-size:15px;
      font-weight:900;
      color:#0f172a;
      line-height:1.35;
    }

    .created-role{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      padding:6px 10px;
      font-size:11px;
      font-weight:800;
      background:#eff6ff;
      color:#1d4ed8;
      white-space:nowrap;
    }

    .created-meta{
      display:grid;
      gap:8px;
    }

    .created-meta-row{
      font-size:13px;
      color:#475569;
      line-height:1.45;
    }

    .created-meta-label{
      font-weight:800;
      color:#0f172a;
    }

    .created-empty{
      padding:24px 20px;
      color:var(--muted);
      font-size:14px;
    }

    .holder-title{
      font-size:26px;
      font-weight:900;
      letter-spacing:-.03em;
      margin:0;
    }

    .holder-sub{
      font-size:14px;
      color:var(--muted);
      line-height:1.6;
      max-width:760px;
      margin:0;
    }

    @media (max-width:1250px){
      .grid-cards{
        grid-template-columns:repeat(3,minmax(0,1fr));
      }

      .actions-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .two-col,
      .create-account-grid{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:980px){
      body{
        overflow:auto;
      }

      .app-shell{
        flex-direction:column;
        height:auto;
        min-height:100vh;
      }

      .sidebar{
        width:100%;
        min-width:0;
      }

      .sidebar-nav{
        overflow:visible;
      }

      .main-wrap{
        height:auto;
      }

      .topbar{
        flex-wrap:wrap;
        min-height:auto;
      }

      .search-box{
        width:100%;
        max-width:none;
      }

      .content-scroll{
        overflow:visible;
      }

      .grid-cards{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width:700px){
      .form-row.two{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:640px){
      .grid-cards,
      .actions-grid{
        grid-template-columns:1fr;
      }

      .topbar,
      .content-scroll{
        padding-left:16px;
        padding-right:16px;
      }

      .hero{
        padding:22px 18px;
      }

      .hero-title{
        font-size:28px;
      }

      .identity-meta{
        display:none;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-logo">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 9.5L12 4l9 5.5-9 5.5L3 9.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M7 12.3V16c0 .7.4 1.3 1 1.6 1 .5 2.4.9 4 .9s3-.4 4-.9c.6-.3 1-.9 1-1.6v-3.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="brand-text">
            <div class="brand-kicker">Colspot</div>
            <div class="brand-title">HOS</div>
            <div class="brand-sub">School control center</div>
          </div>
        </div>
      </div>

      <div class="sidebar-nav">
        <div class="nav-group">
