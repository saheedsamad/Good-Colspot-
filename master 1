        <div class="question-card" data-question-id="${q.local_id}">
          <div class="question-card-head">
            <div class="question-head-left">
              <div class="question-number">${index + 1}</div>
              <div>
                <div class="question-title-static">${escapeHtml(q.question_text || "Untitled Question")}</div>
