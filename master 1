    if (!modal) return;

    state.pickerSelectedMap = {};
    getFormProgrammeTargets().forEach((item) => {
      state.pickerSelectedMap[item.programme_name] = true;
    });

    state.pickerSearch = "";
    if ($("programmeSearchInput")) $("programmeSearchInput").value = "";
    renderProgrammePickerList();
    modal.classList.remove("forms-hidden");
  }

  function closeProgrammePicker() {
    $("programmePickerModal")?.classList.add("forms-hidden");
  }

  function applyProgrammePickerSelection() {
    ensureCurrentForm();

    const currentTargets = getFormProgrammeTargets();
    const preserved = {};
    currentTargets.forEach((item) => {
      preserved[item.programme_name] = Array.isArray(item.levels) ? item.levels.slice() : [];
    });

    const nextTargets = Object.keys(state.pickerSelectedMap)
      .filter((name) => !!state.pickerSelectedMap[name])
      .sort((a, b) => a.localeCompare(b))
      .map((name) => ({
        programme_name: name,
        levels: preserved[name] || [],
      }));

    state.currentForm.programme_targets = nextTargets;
    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function removeProgramme(programmeName) {
    ensureCurrentForm();
    state.currentForm.programme_targets = getFormProgrammeTargets().filter(
      (item) => item.programme_name !== programmeName
    );
    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function toggleProgrammeLevel(programmeName, level) {
    ensureCurrentForm();
    const target = getFormProgrammeTargets().find((item) => item.programme_name === programmeName);
    if (!target) return;

    if (!Array.isArray(target.levels)) target.levels = [];

    if (target.levels.includes(level)) {
      target.levels = target.levels.filter((v) => v !== level);
    } else {
      target.levels.push(level);
      target.levels.sort((a, b) => Number(a) - Number(b));
    }

    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function renderProgrammeTargets() {
    const wrap = $("programmeTargetWrap");
    const selectedBox = $("selectedProgrammesBox");
    const stack = $("programmeLevelStack");
    const summary = $("targetSummaryText");
    const allMode = $("audienceAllStudents")?.checked;

    if (allMode) {
      wrap?.classList.add("forms-hidden");
      if (summary) summary.textContent = "This form is for all students.";
      updateAudienceMatchedCountUI();
      return;
    }

    wrap?.classList.remove("forms-hidden");

    const targets = getFormProgrammeTargets();

    if (!targets.length) {
      if (selectedBox) {
        selectedBox.innerHTML = `<div class="forms-empty" style="min-height:100px;">No programme selected yet.</div>`;
      }
      if (stack) stack.innerHTML = "";
      if (summary) summary.textContent = "No programme and level selected yet.";
      updateAudienceMatchedCountUI();
      return;
    }

    if (selectedBox) {
      selectedBox.innerHTML = targets.map((item) => `
        <div class="programme-pill">
          <span>${escapeHtml(item.programme_name)}</span>
          <button type="button" data-remove-programme="${escapeHtml(item.programme_name)}">×</button>
