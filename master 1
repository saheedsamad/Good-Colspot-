  function renderPreview() {
    ensureCurrentForm();
    const form = state.currentForm;
    const body = $("studentPreviewBody");
    patchPreviewMeta();

    if (!body) return;

    const questions = getFormQuestions();
    if (!questions.length) {
      body.innerHTML = `<div class="forms-empty" style="min-height:150px;">No questions added yet.</div>`;
      return;
    }

    body.innerHTML = questions.map((q, index) => {
      const requiredMark = q.is_required ? '<span class="student-required">*</span>' : "";
      const type = q.question_type;

      let inputHtml = "";

      if (type === "short_answer") {
        inputHtml = `<input class="forms-input" type="text" placeholder="${escapeHtml(q.placeholder_text || "Type your answer")}">`;
      } else if (type === "paragraph") {
        inputHtml = `<textarea class="forms-textarea" placeholder="${escapeHtml(q.placeholder_text || "Write your answer")}"></textarea>`;
      } else if (["multiple_choice", "checkboxes", "dropdown", "yes_no"].includes(type)) {
        const options = type === "yes_no"
          ? ["Yes", "No"]
          : (Array.isArray(q.options_json) ? q.options_json.filter(Boolean) : []);
        inputHtml = `
          <div class="student-option-list">
            ${options.map((option) => `
              <label class="student-option">
                <input type="${type === "checkboxes" ? "checkbox" : "radio"}" name="preview_q_${index}">
                <span>${escapeHtml(option)}</span>
              </label>
            `).join("")}
          </div>
        `;
      } else if (type === "dropdown") {
        const options = Array.isArray(q.options_json) ? q.options_json.filter(Boolean) : [];
        inputHtml = `
          <select class="forms-select">
            <option value="">Select one option</option>
            ${options.map((option) => `<option>${escapeHtml(option)}</option>`).join("")}
          </select>
        `;
      } else if (type === "date") {
        inputHtml = `<input class="forms-input" type="date">`;
      } else if (type === "file_upload") {
        inputHtml = `<input class="forms-input" type="file">`;
      }

      return `
        <div class="student-q">
          <h4>${index + 1}. ${escapeHtml(q.question_text || "Untitled Question")}${requiredMark}</h4>
          <p>${escapeHtml(q.help_text || "Answer this question below.")}</p>
          ${inputHtml}
        </div>
      `;
    }).join("");
  }

  function renderAnnouncementPreview() {
    ensureCurrentForm();
    const form = state.currentForm;
    const titleInput = $("announcementTitleInput");
    const bodyInput = $("announcementBodyInput");
    const previewTitle = $("announcementPreviewTitle");
    const previewBody = $("announcementPreviewBody");
    const matchedCount = $("announcementMatchedCount");
    const targetText = $("announcementAudienceText");
    const loadingText = $("announcementLoadingText");

    if (titleInput && document.activeElement !== titleInput) {
      titleInput.value = form.notification_title || "";
    }
    if (bodyInput && document.activeElement !== bodyInput) {
      bodyInput.value = form.notification_body || "";
      updateAnnouncementBodyCount();
    }

    if (previewTitle) {
      previewTitle.textContent = form.notification_title || (form.title ? `New form: ${form.title}` : "Notification title preview");
    }

    if (previewBody) {
      previewBody.textContent = form.notification_body || (form.title ? `${form.title} is now available. Tap to respond.` : "Notification body preview");
    }

    if (matchedCount) {
      matchedCount.textContent = String(Array.isArray(state.matchedStudentsPreview) ? state.matchedStudentsPreview.length : 0);
    }

    if (targetText) {
      targetText.textContent = buildTargetSummaryText();
    }

    if (loadingText) {
      loadingText.textContent = state.announcementLoading ? "Checking matched students..." : "";
    }
  }

  function updateAnnouncementBodyCount() {
    const input = $("announcementBodyInput");
    const count = $("announcementBodyCount");
    if (!input || !count) return;
    count.textContent = String((input.value || "").length);
  }

  function serializeQuestions() {
    return getFormQuestions().map((q, index) => ({
      question_text: String(q.question_text || "").trim(),
      question_type: q.question_type || "short_answer",
      help_text: String(q.help_text || "").trim(),
      placeholder_text: String(q.placeholder_text || "").trim(),
      is_required: !!q.is_required,
      options_json: Array.isArray(q.options_json) ? q.options_json.map(v => String(v || "").trim()).filter(Boolean) : [],
      allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types.map(v => String(v || "").trim()).filter(Boolean) : [],
      max_file_size_mb: Number(q.max_file_size_mb || 5),
      max_files: Number(q.max_files || 1),
      section_name: String(q.section_name || "").trim(),
      sort_order: index + 1
    }));
  }

  function getSetupPayload() {
    const form = state.currentForm || blankForm();
    return {
      title: String(form.title || "").trim(),
      description: String(form.description || "").trim(),
      target_audience: form.target_audience || "all_students",
      audience_mode: form.audience_mode || "all_students",
      programme_targets: Array.isArray(form.programme_targets) ? form.programme_targets : [],
      response_rule: form.response_rule || "one",
      identity_mode: form.identity_mode || "auto",
      open_at: form.open_at || null,
      close_at: form.close_at || null,
      status: form.status || "draft"
    };
  }

  function getAnnouncementPayload() {
    const form = state.currentForm || blankForm();
    const fallbackTitle = form.title ? `New form: ${form.title}` : "New form available";
    const fallbackBody = form.title ? `${form.title} is now available. Tap to respond.` : "A new form has been published for you.";

    return {
      notification_title: normalizeText(form.notification_title || fallbackTitle),
      notification_body: normalizeText(form.notification_body || fallbackBody),
    };
  }

  async function loadForms() {
    try {
      state.loadingList = true;
      renderFormsList();

      const data = await invokeFormsManager({
        action: "list_forms",
        status: state.statusFilter,
        ...getActorPayload()
      });

      state.forms = Array.isArray(data.forms) ? data.forms : [];
      renderFormsList();
    } catch (err) {
      console.error(err);
      $("formsListBox").innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load forms.")}</div>`;
    } finally {
      state.loadingList = false;
      renderFormsList();
    }
  }

  async function openForm(formId, editMode) {
    try {
      setSavePill("Loading form...", "warn");
      const data = await invokeFormsManager({
        action: "get_form",
        form_id: formId,
        ...getActorPayload()
      });

      loadFormIntoEditor(data.form, data.questions || []);
      showBuilder();

      if (data.form?.status === "published" || data.form?.status === "closed" || data.form?.status === "archived") {
        setStep("preview");
      } else {
        setStep(editMode ? "setup" : "preview");
      }

      setSavePill(editMode ? "Editing form" : "Viewing form", "");
      hideTopPublishButton();
    } catch (err) {
      console.error(err);
      alert(err.message || "Could not open form.");
      setSavePill("Error loading form", "error");
    }
  }

  async function saveDraft() {
    ensureCurrentForm();
    const btn = $("formsSaveDraftBtn");

    try {
      setButtonLoading(btn, "Saving...", true);
      setSavePill("Saving draft...", "warn");

      syncFormFromInputs();

      const payload = {
        ...getSetupPayload(),
        questions: serializeQuestions(),
        ...getActorPayload()
      };

      let data;
      if (state.currentForm.id) {
        data = await invokeFormsManager({
          action: "update_form",
          form_id: state.currentForm.id,
          ...payload
        });
      } else {
        data = await invokeFormsManager({
          action: "create_form",
          ...payload
        });
      }

      if (data.form?.id) {
        state.currentForm.id = data.form.id;
      }
      state.currentForm.status = "draft";

      setSavePill("Draft saved", "");
      await loadForms();
    } catch (err) {
      console.error(err);
      setSavePill(err.message || "Save failed", "error");
      alert(err.message || "Could not save draft.");
    } finally {
      setButtonLoading(btn, "Saving...", false);
    }
  }

  async function publishCurrentForm() {
    ensureCurrentForm();
    const btn = $("formsPublishBottomBtn");

    try {
      setButtonLoading(btn, "Publishing...", true);
      setSavePill("Publishing form...", "warn");

      syncFormFromInputs();

      const basePayload = {
        ...getSetupPayload(),
        questions: serializeQuestions(),
        ...getAnnouncementPayload(),
        ...getActorPayload()
      };

      if (!state.currentForm.id) {
        const created = await invokeFormsManager({
          action: "create_form",
          ...basePayload
        });

        if (created.form?.id) {
          state.currentForm.id = created.form.id;
        }
      } else {
        await invokeFormsManager({
          action: "update_form",
          form_id: state.currentForm.id,
          ...basePayload
        });
      }

      const published = await invokeFormsManager({
        action: "publish_form",
        form_id: state.currentForm.id,
        ...getAnnouncementPayload(),
        ...getActorPayload()
      });

      state.currentForm.status = "published";
      setSavePill("Form published", "");
      alert(published.message || "Form published successfully.");
      await loadForms();
      showHome();
    } catch (err) {
      console.error(err);
      setSavePill(err.message || "Publish failed", "error");
      alert(err.message || "Could not publish form.");
    } finally {
      setButtonLoading(btn, "Publishing...", false);
    }
  }

  async function closeForm(formId) {
    if (!confirm("Close this form? Students will no longer be able to submit responses.")) return;

    try {
      await invokeFormsManager({
        action: "close_form",
        form_id: formId,
        ...getActorPayload()
      });
      await loadForms();
      alert("Form closed successfully.");
    } catch (err) {
      console.error(err);
      alert(err.message || "Could not close form.");
    }
  }

  async function archiveForm(formId) {
    if (!confirm("Archive this form? It will move to archived forms.")) return;

    try {
      await invokeFormsManager({
        action: "archive_form",
        form_id: formId,
        ...getActorPayload()
      });
      await loadForms();
      alert("Form archived successfully.");
    } catch (err) {
      console.error(err);
      alert(err.message || "Could not archive form.");
    }
  }

  async function deleteForm(formId) {
    if (!confirm("Delete this form permanently?")) return;

    try {
      await invokeFormsManager({
        action: "delete_form",
        form_id: formId,
        ...getActorPayload()
      });
      await loadForms();
      alert("Form deleted successfully.");
    } catch (err) {
      console.error(err);
      alert(err.message || "Could not delete form.");
    }
  }

  function hideTopPublishButton() {
    const topBtn = $("formsPublishBtn");
    if (topBtn) {
      topBtn.style.display = "none";
    }
  }

  function syncFormFromInputs() {
    ensureCurrentForm();

    state.currentForm.title = normalizeText($("formTitleInput")?.value || "");
    state.currentForm.description = normalizeText($("formDescriptionInput")?.value || "");
    state.currentForm.open_at = $("formOpenDateInput")?.value || "";
    state.currentForm.close_at = $("formCloseDateInput")?.value || "";
    state.currentForm.response_rule = $("formResponseRule")?.value || "one";
    state.currentForm.identity_mode = $("formIdentityMode")?.value === "anonymous" ? "anonymous" : "auto";
    state.currentForm.audience_mode = $("audienceProgrammeFilter")?.checked ? "programme_filter" : "all_students";
    state.currentForm.target_audience = "all_students";
    state.currentForm.notification_title = normalizeText($("announcementTitleInput")?.value || "");
    state.currentForm.notification_body = normalizeText($("announcementBodyInput")?.value || "");

    patchPreviewMeta();
    renderAnnouncementPreview();
  }

  function handleQuestionInput(target) {
    const questionId = target.dataset.questionId;
    const inputKey = target.dataset.questionInput;
    const optionIndex = Number(target.dataset.optionIndex || -1);
    const question = getFormQuestions().find((item) => item.local_id === questionId);
    if (!question) return;

    if (inputKey === "question_text") {
      question.question_text = target.value;
      patchQuestionHeader(questionId);
    } else if (inputKey === "question_type") {
      const nextType = target.value || "short_answer";
      question.question_type = nextType;

      if (["multiple_choice", "checkboxes", "dropdown"].includes(nextType)) {
        question.options_json = Array.isArray(question.options_json) && question.options_json.length
          ? question.options_json
          : ["", ""];
      } else if (nextType === "yes_no") {
        question.options_json = ["Yes", "No"];
      } else {
        question.options_json = [];
      }

      if (nextType !== "file_upload") {
        question.allowed_file_types = [];
        question.max_file_size_mb = 5;
        question.max_files = 1;
      }

      renderQuestionList();
    } else if (inputKey === "help_text") {
      question.help_text = target.value;
    } else if (inputKey === "placeholder_text") {
      question.placeholder_text = target.value;
    } else if (inputKey === "allowed_file_types") {
      question.allowed_file_types = String(target.value || "")
        .split(",")
        .map((v) => normalizeText(v))
        .filter(Boolean);
    } else if (inputKey === "max_file_size_mb") {
      question.max_file_size_mb = Math.max(1, Number(target.value || 5));
    } else if (inputKey === "max_files") {
      question.max_files = Math.max(1, Number(target.value || 1));
    }

    if (target.dataset.optionInput === "value" && optionIndex >= 0) {
      if (!Array.isArray(question.options_json)) question.options_json = [];
      question.options_json[optionIndex] = target.value;
    }

    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function handleQuestionAction(action, questionId, optionIndex) {
    const questions = getFormQuestions();
    const index = questions.findIndex((item) => item.local_id === questionId);
    if (index < 0) return;

    const question = questions[index];

    if (action === "toggle-required") {
      question.is_required = !question.is_required;
    } else if (action === "move-up" && index > 0) {
      [questions[index - 1], questions[index]] = [questions[index], questions[index - 1]];
    } else if (action === "move-down" && index < questions.length - 1) {
      [questions[index + 1], questions[index]] = [questions[index], questions[index + 1]];
    } else if (action === "duplicate") {
      const copy = JSON.parse(JSON.stringify(question));
      copy.local_id = uid("q");
      copy.id = null;
      questions.splice(index + 1, 0, copy);
    } else if (action === "delete") {
      questions.splice(index, 1);
    } else if (action === "add-option") {
      if (!Array.isArray(question.options_json)) question.options_json = [];
      question.options_json.push("");
    } else if (action === "remove-option") {
      if (Array.isArray(question.options_json)) {
        question.options_json.splice(Number(optionIndex), 1);
        if (!question.options_json.length && ["multiple_choice", "checkboxes", "dropdown"].includes(question.question_type)) {
          question.options_json = [""];
        }
      }
    }

    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function addQuestion(type) {
    const questions = getFormQuestions();
    questions.push(blankQuestion(type));
    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  async function handleFormAction(action, formId) {
    if (action === "open") return openForm(formId, false);
    if (action === "edit") return openForm(formId, true);
    if (action === "publish") {
      return openForm(formId, true).then(() => {
