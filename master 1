    return state.currentForm.questions;
  }

  function getFormProgrammeTargets() {
    ensureCurrentForm();
    if (!Array.isArray(state.currentForm.programme_targets)) {
      state.currentForm.programme_targets = [];
    }
    return state.currentForm.programme_targets;
  }

  async function loadProgrammes() {
    const listBox = $("programmeListBox");
    try {
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">Loading programmes...</div>`;
      }

      const { data, error } = await state.sb
        .from("programmes")
        .select("id, programme_name")
        .eq("is_active", true)
        .order("programme_name", { ascending: true });

      if (error) throw error;

      state.programmes = Array.isArray(data) ? data : [];
      renderProgrammePickerList();
    } catch (err) {
      console.error("Load programmes error:", err);
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load programmes.")}</div>`;
      }
    }
  }

  function renderProgrammePickerList() {
    const listBox = $("programmeListBox");
    if (!listBox) return;

    const search = normalizeUpper(state.pickerSearch);
    const items = (state.programmes || []).filter((item) => {
      const name = normalizeUpper(item.programme_name || "");
      return !search || name.includes(search);
    });

    if (!items.length) {
      listBox.innerHTML = `<div class="forms-empty">No programme found.</div>`;
      return;
    }

    listBox.innerHTML = items.map((item) => {
      const programmeName = String(item.programme_name || "");
      const checked = !!state.pickerSelectedMap[programmeName];

      return `
        <label class="question-card" style="cursor:pointer;">
          <div class="question-card-body" style="display:grid; grid-template-columns:1fr auto; align-items:center;">
            <div>
              <div class="question-title-static">${escapeHtml(programmeName)}</div>
            </div>
            <input type="checkbox" data-programme-pick="${escapeHtml(programmeName)}" ${checked ? "checked" : ""}>
          </div>
        </label>
      `;
    }).join("");
  }

