                  <option value="dropdown" ${q.question_type === "dropdown" ? "selected" : ""}>Dropdown</option>
                  <option value="date" ${q.question_type === "date" ? "selected" : ""}>Date</option>
                  <option value="file_upload" ${q.question_type === "file_upload" ? "selected" : ""}>File Upload</option>
                  <option value="yes_no" ${q.question_type === "yes_no" ? "selected" : ""}>Yes / No</option>
                </select>
              </div>
            </div>

            <div class="forms-field">
              <label>Help Text</label>
              <input
                class="forms-input"
                type="text"
