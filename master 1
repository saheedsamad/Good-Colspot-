      notification_title: form?.notification_title || "",
      notification_body: form?.notification_body || "",
      questions: Array.isArray(questions)
        ? questions.map((q, i) => ({
            local_id: q.id || uid("q"),
            id: q.id || null,
            question_text: q.question_text || "",
            question_type: q.question_type || "short_answer",
            help_text: q.help_text || "",
            placeholder_text: q.placeholder_text || "",
            is_required: !!q.is_required,
            options_json: Array.isArray(q.options_json) ? q.options_json.slice() : [],
            allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types.slice() : [],
            max_file_size_mb: Number(q.max_file_size_mb || 5),
            max_files: Number(q.max_files || 1),
            section_name: q.section_name || "",
            sort_order: Number.isFinite(Number(q.sort_order)) ? Number(q.sort_order) : i + 1,
          }))
        : [],
    };

    renderEditor();
    refreshMatchedStudentsPreview();
  }

  function renderEditor() {
    ensureCurrentForm();
    const form = state.currentForm;

    if ($("formTitleInput")) $("formTitleInput").value = form.title || "";
    if ($("formDescriptionInput")) $("formDescriptionInput").value = form.description || "";
    if ($("formOpenDateInput")) $("formOpenDateInput").value = form.open_at || "";
    if ($("formCloseDateInput")) $("formCloseDateInput").value = form.close_at || "";
    if ($("formResponseRule")) $("formResponseRule").value = form.response_rule || "one";

    ensureIdentityModeOptions();
    if ($("formIdentityMode")) {
      $("formIdentityMode").value = form.identity_mode === "anonymous" ? "anonymous" : "auto";
    }

    if ((form.audience_mode || "all_students") === "programme_filter") {
      if ($("audienceProgrammeFilter")) $("audienceProgrammeFilter").checked = true;
      if ($("audienceAllStudents")) $("audienceAllStudents").checked = false;
    } else {
      if ($("audienceAllStudents")) $("audienceAllStudents").checked = true;
      if ($("audienceProgrammeFilter")) $("audienceProgrammeFilter").checked = false;
    }

    if ($("announcementTitleInput")) {
      $("announcementTitleInput").value = form.notification_title || "";
    }
    if ($("announcementBodyInput")) {
      $("announcementBodyInput").value = form.notification_body || "";
      updateAnnouncementBodyCount();
    }

    renderProgrammeTargets();
    renderQuestionList();
    renderPreview();
    renderAnnouncementPreview();
  }

  function renderHomeTabs() {
    document.querySelectorAll("#formsStatusTabs [data-status]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.status === state.statusFilter);
    });
  }

  function getFormActionButtons(form) {
    const status = String(form.status || "draft").toLowerCase();
    const count = Number(form.response_count || 0);

    if (status === "draft") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
        <button type="button" class="forms-mini-btn" data-form-action="publish" data-form-id="${form.id}">Publish</button>
        <button type="button" class="forms-mini-btn red" data-form-action="delete" data-form-id="${form.id}" ${count > 0 ? "disabled" : ""}>Delete</button>
      `;
    }

    if (status === "published") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="close" data-form-id="${form.id}">Close</button>
        <button type="button" class="forms-mini-btn red" data-form-action="archive" data-form-id="${form.id}">Archive</button>
      `;
    }

    if (status === "closed") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="archive" data-form-id="${form.id}">Archive</button>
      `;
    }

    if (status === "archived") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
      `;
    }

    return `
      <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
    `;
  }

  function renderFormsList() {
    const box = $("formsListBox");
    if (!box) return;

    if (state.loadingList) {
      box.innerHTML = `<div class="forms-empty">Loading forms...</div>`;
      return;
    }

    const items = (state.forms || []).filter((item) => item.status === state.statusFilter);

    if (!items.length) {
      box.innerHTML = `<div class="forms-empty">No ${escapeHtml(state.statusFilter)} forms yet.</div>`;
      return;
    }

    box.innerHTML = items.map((form) => `
      <div class="form-item">
        <div class="form-item-head">
          <div>
            <h4 class="form-item-title">${escapeHtml(form.title || "Untitled Form")}</h4>
            <p class="form-item-desc">${escapeHtml(form.description || "No description yet.")}</p>
          </div>
          <span class="status-pill ${escapeHtml(form.status || "draft")}">${escapeHtml(form.status || "draft")}</span>
        </div>

        <div class="form-item-meta">
          <span class="meta-chip">${Number(form.question_count || 0)} Questions</span>
          <span class="meta-chip">${escapeHtml(getAudienceLabel(form))}</span>
          <span class="meta-chip">${Number(form.response_count || 0)} Responses</span>
          <span class="meta-chip">Updated ${escapeHtml(formatDate(form.updated_at || form.created_at))}</span>
        </div>

        <div class="form-item-actions">
          ${getFormActionButtons(form)}
        </div>
      </div>
    `).join("");
  }

