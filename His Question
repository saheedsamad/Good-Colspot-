    .question-info-note svg{
      width:16px;
      height:16px;
      stroke:#4f73db;
      margin-right:10px;
      flex:0 0 auto;
    }

    .questions-footer-note{
      min-height:48px;
      border-radius:16px;
      background:#f4f7ff;
      border:1px solid #e7ecfb;
      color:#5f7199;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:0 16px;
      font-size:13px;
      font-weight:900;
      text-align:center;
    }

    .questions-loading,
    .questions-empty{
      min-height:120px;
      border-radius:18px;
      border:1px dashed #d9e3fb;
      background:#fbfcff;
      color:#6d7895;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:20px;
      font-size:14px;
      font-weight:900;
      text-align:center;
    }

    @media (max-width:1200px){
      .questions-stats{
        grid-template-columns:repeat(3,minmax(0,1fr));
      }
    }

    @media (max-width:900px){
      .questions-stats{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .questions-filters{
        grid-template-columns:1fr;
      }

      .question-cards{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:640px){
      .questions-head{
        flex-direction:column;
        align-items:flex-start;
      }

      .questions-stats{
        grid-template-columns:1fr;
      }

      .question-stats-row{
        grid-template-columns:1fr;
      }

      .question-bar-row{
        grid-template-columns:1fr;
      }

      .question-bar-value{
        text-align:left;
      }

      .questions-title{
        font-size:22px;
      }
    }
  </style>

