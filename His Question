  <script>
    (function () {
      const FORM_RESPONSE_FUNCTION = "form-response-manager";

      let questionsSupabase = null;
      let questionsFormId = null;
      let questionsBundle = null;

      document.addEventListener("DOMContentLoaded", () => {
        initQuestionsSection().catch((err) => {
          console.error("questions init error:", err);
          const wrap = document.getElementById("questionsCardsWrap");
          if (wrap) {
            wrap.innerHTML = '<div class="questions-empty">' + escapeHtml(err?.message || "Failed to load questions page.") + '</div>';
          }
        });
      });

      async function initQuestionsSection() {
        ensureQuestionsSupabaseReady();
        questionsSupabase = getQuestionsSupabaseClient();
        questionsFormId = getQuestionsFormIdFromUrl();

        if (!questionsFormId) {
          throw new Error("form_id is missing in the URL.");
        }

        wireQuestionsEvents();
        await loadQuestionsBundle();
      }

      function ensureQuestionsSupabaseReady() {
        if (!window.supabase || typeof window.supabase.createClient !== "function") {
          throw new Error("Supabase browser library is not loaded.");
        }
      }

      function getQuestionsSupabaseClient() {
        if (window.__colspotQuestionsSupabase) return window.__colspotQuestionsSupabase;

        const url = window.SUPABASE_URL || "YOUR_SUPABASE_URL";
        const key = window.SUPABASE_ANON_KEY || "YOUR_SUPABASE_ANON_KEY";

        if (
          !url ||
          !key ||
          String(url).includes("YOUR_SUPABASE_URL") ||
          String(key).includes("YOUR_SUPABASE_ANON_KEY")
        ) {
          throw new Error("Set your real SUPABASE_URL and SUPABASE_ANON_KEY once in the page.");
        }

        window.__colspotQuestionsSupabase = window.supabase.createClient(url, key);
        return window.__colspotQuestionsSupabase;
      }

      function getQuestionsFormIdFromUrl() {
        const params = new URLSearchParams(window.location.search);
        return cleanText(params.get("form_id"));
      }

      function wireQuestionsEvents() {
        const searchInput = document.getElementById("questionsSearchInput");
        const typeFilter = document.getElementById("questionsTypeFilter");
        const sortBy = document.getElementById("questionsSortBy");
        const refreshBtn = document.getElementById("questionsRefreshBtn");
        const exportBtn = document.getElementById("questionsExportBtn");

        if (searchInput) searchInput.addEventListener("input", debounce(renderQuestionsCards, 180));
        if (typeFilter) typeFilter.addEventListener("change", renderQuestionsCards);
        if (sortBy) sortBy.addEventListener("change", renderQuestionsCards);

        if (refreshBtn) {
          refreshBtn.addEventListener("click", async () => {
            refreshBtn.disabled = true;
            try {
              await loadQuestionsBundle();
            } finally {
              refreshBtn.disabled = false;
            }
          });
        }

        if (exportBtn) {
          exportBtn.addEventListener("click", () => {
            const links = Array.from(document.querySelectorAll(".side-link"));
            if (typeof showExport === "function") {
              showExport();
              return;
            }
            if (links[3]) links[3].click();
          });
        }
      }

      async function loadQuestionsBundle() {
        const result = await invokeQuestionsManager({
          action: "get_form_response_bundle",
          form_id: questionsFormId,
          ...getQuestionsActorPayloadFromSession()
        });

        if (!result?.ok) {
          throw new Error(result?.error || "Failed to load question analysis.");
        }

        questionsBundle = result;
        hydrateQuestionsHeader();
        hydrateQuestionsStats();
        hydrateQuestionsTypeFilter();
        renderQuestionsCards();
      }

      function hydrateQuestionsHeader() {
        const form = questionsBundle?.form || {};
        const summary = questionsBundle?.summary || {};

        setText("questionsFormAudience", buildQuestionsAudienceText(form));
        setText("questionsFormResponses", `${Number(summary.total_responses || 0)} response${Number(summary.total_responses || 0) === 1 ? "" : "s"}`);
        setText(
          "questionsFormLastSubmission",
          summary.latest_submission
            ? `Last submission: ${formatQuestionsDateTime(summary.latest_submission)}`
            : "Last submission: —"
        );
      }

      function hydrateQuestionsStats() {
        const questions = Array.isArray(questionsBundle?.questions) ? questionsBundle.questions : [];
        const summaries = Array.isArray(questionsBundle?.question_summaries) ? questionsBundle.question_summaries : [];
        const responses = Number(questionsBundle?.summary?.total_responses || 0);

        const requiredCount = questions.filter((q) => !!q.is_required).length;
        const completion = calculateAverageCompletion(summaries, responses);
        const mostSkipped = calculateMostSkipped(summaries, responses);

        setText("questionsStatTotalQuestions", String(questions.length));
        setText("questionsStatTotalResponses", String(responses));
        setText("questionsStatRequired", String(requiredCount));
        setText("questionsStatCompletion", `${completion}%`);
        setText("questionsStatMostSkipped", String(mostSkipped));
      }

      function hydrateQuestionsTypeFilter() {
        const select = document.getElementById("questionsTypeFilter");
        const questions = Array.isArray(questionsBundle?.questions) ? questionsBundle.questions : [];
        if (!select) return;

        const types = uniqueValues(
          questions.map((q) => cleanText(q.question_type)).filter(Boolean)
        ).sort();

        select.innerHTML =
          '<option value="">All question types</option>' +
          types.map((type) => `<option value="${escapeHtmlAttr(type)}">${escapeHtml(formatQuestionType(type))}</option>`).join("");
      }

      function renderQuestionsCards() {
        const wrap = document.getElementById("questionsCardsWrap");
        if (!wrap) return;

        const questions = Array.isArray(questionsBundle?.questions) ? questionsBundle.questions : [];
        const summaries = Array.isArray(questionsBundle?.question_summaries) ? questionsBundle.question_summaries : [];
        const responses = Number(questionsBundle?.summary?.total_responses || 0);

        const search = cleanText(document.getElementById("questionsSearchInput")?.value).toLowerCase();
        const typeFilter = cleanText(document.getElementById("questionsTypeFilter")?.value);
        const sortBy = cleanText(document.getElementById("questionsSortBy")?.value || "question_order");

        const merged = questions.map((question, index) => {
          const summary = summaries.find((item) => String(item.question_id) === String(question.id)) || {};
          const answered = Number(summary.answered_count || 0);
          const skipped = Math.max(0, responses - answered);

          return {
            ...question,
            display_index: index + 1,
            answered_count: answered,
            skipped_count: skipped,
            options_summary: Array.isArray(summary.options) ? summary.options : []
          };
        });

        let filtered = merged.filter((item) => {
          const matchesSearch =
            !search ||
            cleanText(item.question_text).toLowerCase().includes(search) ||
            formatQuestionType(item.question_type).toLowerCase().includes(search);

          const matchesType = !typeFilter || cleanText(item.question_type) === typeFilter;
          return matchesSearch && matchesType;
        });

        if (sortBy === "most_answered") {
          filtered.sort((a, b) => b.answered_count - a.answered_count || a.sort_order - b.sort_order);
        } else if (sortBy === "most_skipped") {
          filtered.sort((a, b) => b.skipped_count - a.skipped_count || a.sort_order - b.sort_order);
        } else {
          filtered.sort((a, b) => Number(a.sort_order || 0) - Number(b.sort_order || 0));
        }

        if (!filtered.length) {
          wrap.innerHTML = '<div class="questions-empty">No question matched your current search or filter.</div>';
          return;
        }

        wrap.innerHTML = filtered.map((question) => buildQuestionCardHtml(question, responses)).join("");

        wrap.querySelectorAll("[data-question-view]").forEach((btn) => {
          btn.addEventListener("click", () => {
            alert("Question detail view can be connected next.");
          });
        });
      }

      function buildQuestionCardHtml(question, totalResponses) {
        const type = cleanText(question.question_type);
        const title = cleanText(question.question_text) || "Untitled question";
        const answered = Number(question.answered_count || 0);
        const skipped = Number(question.skipped_count || 0);
        const requiredBadge = question.is_required
          ? '<span class="question-badge required">Required</span>'
          : '<span class="question-badge optional">Optional</span>';

        let bodyHtml = "";

        if (["multiple_choice", "dropdown", "yes_no", "checkboxes"].includes(type)) {
          bodyHtml = buildObjectiveQuestionBody(question, totalResponses);
        } else {
          bodyHtml = buildTextQuestionBody(question);
        }

        return `
          <article class="question-card">
            <div class="question-card-head">
              <div class="question-head-left">
                <div class="question-number">${question.display_index}</div>
                <div>
                  <h3 class="question-title">${escapeHtml(title)}</h3>
                  <div class="question-badges">
                    <span class="question-badge type">${escapeHtml(formatQuestionType(type))}</span>
                    ${requiredBadge}
                  </div>
                </div>
              </div>

              <div class="question-card-actions">
                <button class="question-view-btn" type="button" data-question-view="${escapeHtmlAttr(question.id)}">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke-width="2"></path>
                    <circle cx="12" cy="12" r="3" stroke-width="2"></circle>
                  </svg>
                  <span>View details</span>
                </button>
              </div>
            </div>

            <div class="question-stats-row">
              <div class="question-mini-stat answered">
                <div class="question-mini-icon">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M16 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke-width="2.2"></path>
                    <path d="M2.5 20a5.5 5.5 0 0 1 11 0M13 20a6 6 0 0 1 9 0" stroke-width="2.2" stroke-linecap="round"></path>
                  </svg>
                </div>
                <div>
                  <div class="question-mini-value">${answered}</div>
                  <div class="question-mini-label">Answered</div>
                </div>
              </div>

              <div class="question-mini-stat skipped">
                <div class="question-mini-icon">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 8v4" stroke-width="2.2" stroke-linecap="round"></path>
                    <path d="M12 16h.01" stroke-width="2.2" stroke-linecap="round"></path>
                    <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
                  </svg>
                </div>
                <div>
                  <div class="question-mini-value">${skipped}</div>
                  <div class="question-mini-label">Skipped</div>
                </div>
              </div>
            </div>

            <div class="question-divider"></div>

            ${bodyHtml}
          </article>
        `;
      }

      function buildTextQuestionBody(question) {
        const type = cleanText(question.question_type);
        const rows = getRecentAnswerPreviews(question, 3);

        let helper = "";
        if (type === "short_answer") {
          helper = `
            <div class="question-info-note">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
                <path d="M12 10v5M12 7h.01" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
              This question collects short typed answers.
            </div>
          `;
        }

        const listHtml = rows.length
          ? rows.map((row) => `
              <div class="question-answer-item">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke-width="2"></path>
                  <path d="M4 20a8 8 0 0 1 16 0" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                <div class="question-answer-text ${type === "paragraph" ? "wrap" : ""}">${escapeHtml(row)}</div>
              </div>
            `).join("")
          : `<div class="question-answer-item"><div class="question-answer-text">No recent answers yet.</div></div>`;

        return `
          ${helper}
          <div>
            <div class="question-section-label">Recent Answers</div>
            <div class="question-answer-list">${listHtml}</div>
            <div class="question-more-row">
              <button class="question-more-btn" type="button" data-question-view="${escapeHtmlAttr(question.id)}">
                <span>View all ${Number(question.answered_count || 0)} answers</span>
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
          </div>
        `;
      }

      function buildObjectiveQuestionBody(question, totalResponses) {
        const options = Array.isArray(question.options_summary) ? question.options_summary : [];
        const colors = ["red", "green", "blue", "purple", "orange"];

        const barsHtml = options.length
          ? options.map((option, index) => {
              const count = Number(option.count || 0);
              const pct = totalResponses > 0 ? Math.round((count / totalResponses) * 100) : 0;
              const color = colors[index % colors.length];
              return `
                <div class="question-bar-row">
                  <div class="question-bar-label">${escapeHtml(option.label || "Option")}</div>
                  <div class="question-bar-track">
                    <div class="question-bar-fill ${color}" style="width:${pct}%"></div>
                  </div>
                  <div class="question-bar-value">${count} (${pct}%)</div>
                </div>
              `;
            }).join("")
          : `<div class="question-info-note">
               <svg viewBox="0 0 24 24" fill="none">
                 <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
                 <path d="M12 10v5M12 7h.01" stroke-width="2.2" stroke-linecap="round"></path>
               </svg>
               No option summary is available yet for this question.
             </div>`;

        return `
          <div class="question-bars">${barsHtml}</div>
        `;
      }

      function getRecentAnswerPreviews(question, limit) {
        const previews = [];
        const title = cleanText(question.question_text).toLowerCase();

        const rows = Array.isArray(questionsBundle?.individual_responses)
          ? questionsBundle.individual_responses
          : [];

        for (const row of rows) {
          if (previews.length >= limit) break;

          if (title.includes("name") && cleanText(row.full_name)) {
            previews.push(cleanText(row.full_name));
            continue;
          }

          if ((title.includes("matric") || title.includes("matriculation")) && cleanText(row.matric_number)) {
            previews.push(cleanText(row.matric_number));
            continue;
          }
        }

        return previews;
      }

      function calculateAverageCompletion(summaries, totalResponses) {
        if (!totalResponses || !summaries.length) return 0;

        const percentages = summaries.map((item) => {
          const answered = Number(item.answered_count || 0);
          return Math.round((answered / totalResponses) * 100);
        });

        const total = percentages.reduce((sum, item) => sum + item, 0);
        return Math.round(total / percentages.length);
      }

      function calculateMostSkipped(summaries, totalResponses) {
        if (!summaries.length || !totalResponses) return 0;

        return summaries.reduce((max, item) => {
          const skipped = Math.max(0, totalResponses - Number(item.answered_count || 0));
          return Math.max(max, skipped);
        }, 0);
      }

      async function invokeQuestionsManager(payload) {
        const { data, error } = await questionsSupabase.functions.invoke(
          FORM_RESPONSE_FUNCTION,
          { body: payload }
        );

        if (error) throw new Error(error.message || "Edge function request failed.");
        if (!data?.ok) throw new Error(data?.error || "Could not load question analysis.");
        return data;
      }

      function getQuestionsActorPayloadFromSession() {
        const keys = [
          "colspot_hos_session",
          "colspot_admin_session",
          "hos_session",
          "admin_session",
          "colspot_session"
        ];

        for (const key of keys) {
          const raw = localStorage.getItem(key);
          if (!raw) continue;

          try {
            const parsed = JSON.parse(raw);

            if (parsed?.hos_admin_id) return { hos_admin_id: parsed.hos_admin_id };
            if (parsed?.form_agent_id) return { form_agent_id: parsed.form_agent_id };

            if (parsed?.id && cleanText(parsed.role).toLowerCase() === "hos") {
              return { hos_admin_id: parsed.id };
            }

            if (parsed?.id && cleanText(parsed.role).toLowerCase() === "form_agent") {
              return { form_agent_id: parsed.id };
            }

            if (parsed?.account?.id && cleanText(parsed?.role || parsed?.account?.role).toLowerCase() === "hos") {
              return { hos_admin_id: parsed.account.id };
            }

            if (parsed?.account?.id && cleanText(parsed?.role || parsed?.account?.role).toLowerCase() === "form_agent") {
              return { form_agent_id: parsed.account.id };
            }
          } catch (_) {}
        }

        throw new Error("Admin session not found. Please sign in again.");
      }

      function buildQuestionsAudienceText(form) {
        const audienceMode = cleanText(form.audience_mode || "all_students");
        if (audienceMode !== "programme_filter") return "All students";

        const targets = Array.isArray(form.programme_targets) ? form.programme_targets : [];
        if (!targets.length) return "Programme filter";

        const first = targets[0];
        const programme = toTitleCase(cleanText(first.programme_name));
        const levels = Array.isArray(first.levels) ? first.levels.join(", ") : "";
        return `${programme} ${levels}`.trim();
      }

      function formatQuestionsDateTime(value) {
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "—";
        return d.toLocaleString([], {
          day: "numeric",
          month: "short",
          year: "numeric"
        });
      }

      function formatQuestionType(value) {
        return toTitleCase(cleanText(value).replaceAll("_", " "));
      }

      function setText(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = value ?? "";
      }

      function cleanText(value) {
        return String(value ?? "").trim();
      }

      function toTitleCase(value) {
        return cleanText(value)
          .toLowerCase()
          .split(" ")
          .filter(Boolean)
          .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
          .join(" ");
      }

      function uniqueValues(arr) {
        return [...new Set(arr)];
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeHtmlAttr(value) {
        return escapeHtml(value);
      }

      function debounce(fn, wait) {
        let timer = null;
        return function () {
          clearTimeout(timer);
          timer = setTimeout(() => fn(), wait);
        };
      }
    })();
  </script>
