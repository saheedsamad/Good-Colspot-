<section class="placeholder-card question-section-card" id="questionsPlaceholder">
  <style>
    #questionsPlaceholder{
      display:block;
      padding:0;
      background:transparent;
      border:none;
      box-shadow:none;
    }

    .questions-module{
      display:flex;
      flex-direction:column;
      gap:18px;
      color:#16213d;
    }

    .questions-box{
      background:#fff;
      border:1px solid #e2e9fb;
      border-radius:22px;
      box-shadow:0 10px 28px rgba(37,60,120,.06);
      padding:18px;
    }

    .questions-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:14px;
      flex-wrap:wrap;
    }

    .questions-title{
      margin:0;
      font-size:24px;
      line-height:1.1;
      font-weight:950;
      letter-spacing:-.02em;
      color:#16213d;
    }

    .questions-sub{
      margin:8px 0 0;
      color:#6d7895;
      font-size:14px;
      line-height:1.5;
      font-weight:700;
    }

    .questions-mini-meta{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:10px;
      color:#6d7895;
      font-size:13px;
      font-weight:800;
    }

    .questions-mini-meta span:not(:first-child)::before{
      content:"•";
      margin-right:8px;
    }

    .questions-top-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .questions-btn,
    .questions-btn-light{
      min-height:44px;
      border-radius:14px;
      padding:0 14px;
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      transition:.18s ease;
    }

    .questions-btn{
      border:none;
      color:#fff;
      background:linear-gradient(90deg,#2f6bff 0%,#5d94ff 100%);
      box-shadow:0 10px 20px rgba(47,107,255,.18);
    }

    .questions-btn-light{
      border:1px solid #e2e9fb;
      background:#fff;
      color:#16213d;
    }

    .questions-btn:hover,
    .questions-btn-light:hover{
      transform:translateY(-1px);
    }

    .questions-btn:disabled,
    .questions-btn-light:disabled{
      opacity:.65;
      cursor:not-allowed;
      transform:none;
    }

    .questions-btn svg,
    .questions-btn-light svg{
      width:16px;
      height:16px;
      stroke:currentColor;
      flex:0 0 auto;
    }

    .questions-stats{
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:12px;
    }

    .questions-stat{
      border:1px solid #edf1fb;
      border-radius:20px;
      padding:16px;
      display:flex;
      align-items:flex-start;
      gap:12px;
      min-height:98px;
    }

    .questions-stat:nth-child(1){ background:#f7f9ff; }
    .questions-stat:nth-child(2){ background:#f6fcf8; }
    .questions-stat:nth-child(3){ background:#fbf8ff; }
    .questions-stat:nth-child(4){ background:#fffaf0; }
    .questions-stat:nth-child(5){ background:#fff7fa; }

    .questions-stat-icon{
      width:44px;
      height:44px;
      border-radius:14px;
      display:grid;
      place-items:center;
      flex:0 0 auto;
    }

    .questions-stat:nth-child(1) .questions-stat-icon{ background:#e9efff; color:#3b6df5; }
    .questions-stat:nth-child(2) .questions-stat-icon{ background:#e9f8ef; color:#2aa85f; }
    .questions-stat:nth-child(3) .questions-stat-icon{ background:#efe7ff; color:#8b5cf6; }
    .questions-stat:nth-child(4) .questions-stat-icon{ background:#fff1d8; color:#f3a81f; }
    .questions-stat:nth-child(5) .questions-stat-icon{ background:#ffe6ed; color:#ea5a7a; }

    .questions-stat-icon svg{
      width:22px;
      height:22px;
      stroke:currentColor;
    }

    .questions-stat-value{
      font-size:22px;
      line-height:1;
      font-weight:950;
      color:#16213d;
      margin-bottom:8px;
    }

    .questions-stat-label{
      font-size:14px;
      line-height:1.25;
      font-weight:900;
      color:#16213d;
    }

    .questions-stat-sub{
      margin-top:6px;
      font-size:12px;
      line-height:1.35;
      color:#6d7895;
      font-weight:700;
    }

    .questions-filters{
      display:grid;
      grid-template-columns:1.2fr .8fr .8fr;
      gap:12px;
    }

    .questions-field{
      position:relative;
    }

    .questions-field label{
      display:block;
      margin:0 0 7px;
      color:#6d7895;
      font-size:13px;
      font-weight:900;
    }

    .questions-input,
