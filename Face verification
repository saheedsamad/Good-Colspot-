function readPendingNearbyJoinContextFromFace() {
  try {
    const raw = localStorage.getItem(PENDING_NEARBY_JOIN_KEY);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch (_) {
    return null;
  }
}

function clearPendingNearbyJoinContextFromFace() {
  try {
    localStorage.removeItem(PENDING_NEARBY_JOIN_KEY);
    localStorage.removeItem(NEARBY_RESUME_KEY);
  } catch (_) {}
}

function addFaceJoinToStudentHistory(entry) {
  try {
    const raw = localStorage.getItem(STUDENT_HISTORY_KEY);
    let list = [];

    if (raw) {
      try {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) list = parsed;
      } catch (_) {}
    }

    list = list.filter(
      (item) =>
        !(
          item.session_id === entry.session_id &&
          item.student_matric === entry.student_matric
        )
    );

    list.unshift(entry);
    list = list.slice(0, 50);

    localStorage.setItem(STUDENT_HISTORY_KEY, JSON.stringify(list));
  } catch (_) {}
}

