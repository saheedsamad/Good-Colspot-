function updateSequenceUI() {
  [stepCircle1, stepCircle2, stepCircle3, stepCircle4].forEach((el) => {
    if (!el) return;
    el.classList.remove("active", "done");
  });

  [stepLine1, stepLine2, stepLine3].forEach((el) => {
    if (!el) return;
    el.classList.remove("done");
  });

  if (currentStepIndex <= 0 && stepCircle1) stepCircle1.classList.add("active");
  if (currentStepIndex > 0 && stepCircle1) stepCircle1.classList.add("done");

  if (currentStepIndex === 1 && stepCircle2) stepCircle2.classList.add("active");
  if (currentStepIndex > 1 && stepCircle2) stepCircle2.classList.add("done");

  if (currentStepIndex === 2 && stepCircle3) stepCircle3.classList.add("active");
  if (currentStepIndex > 2 && stepCircle3) stepCircle3.classList.add("done");

  if (currentStepIndex === 3 && stepCircle4) stepCircle4.classList.add("active");
  if (currentStepIndex > 3 && stepCircle4) stepCircle4.classList.add("done");

  if (currentStepIndex > 0 && stepLine1) stepLine1.classList.add("done");
  if (currentStepIndex > 1 && stepLine2) stepLine2.classList.add("done");
  if (currentStepIndex > 2 && stepLine3) stepLine3.classList.add("done");
}

function resetSequenceState() {
