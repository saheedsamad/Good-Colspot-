function getCurrentPositionOnceForFace() {
  return new Promise((resolve) => {
    if (!navigator.geolocation) {
      resolve(null);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (pos) => resolve(pos),
      () => resolve(null),
      {
        enableHighAccuracy: true,
        timeout: 12000,
        maximumAge: 0,
      }
    );
  });
}

async function getBestLocationForFaceGuard(maxReads = 5, desiredAccuracy = 100) {
  const readings = [];

  for (let i = 0; i < maxReads; i++) {
    const pos = await getCurrentPositionOnceForFace();

    if (pos && pos.coords) {
      const acc =
        typeof pos.coords.accuracy === "number" &&
        !Number.isNaN(pos.coords.accuracy)
          ? pos.coords.accuracy
          : null;

      readings.push({
        lat: typeof pos.coords.latitude === "number" ? pos.coords.latitude : null,
        lng: typeof pos.coords.longitude === "number" ? pos.coords.longitude : null,
        accuracy: acc,
      });

      if (acc !== null && acc <= desiredAccuracy) {
        break;
      }
    }

    if (i < maxReads - 1) {
      await new Promise((resolve) => setTimeout(resolve, 1200));
    }
  }

  if (!readings.length) {
    return { lat: null, lng: null, accuracy: null };
  }

  let best = readings[0];

  for (const item of readings) {
    if (item.accuracy == null) continue;
    if (best.accuracy == null || item.accuracy < best.accuracy) {
      best = item;
    }
  }

  return best;
}

async function invokeNearbyGuardFromFace(session, action, payload) {
  const res = await fetch(NEARBY_GUARD_URL, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${session.access_token}`,
    },
    body: JSON.stringify({
      action,
      payload,
    }),
  });

  const result = await res.json().catch(() => ({}));

  if (!res.ok) {
    const err = new Error(
      result?.message ||
        result?.error ||
        "Face verified, but Colspot could not save attendance."
    );

    err.code = result?.code || "";
    err.result = result;
    throw err;
  }

  return result;
}

async function joinAttendanceInsideFaceVerification(session, verifyData = {}) {
  const context = readPendingNearbyJoinContextFromFace();

  if (!context || !context.sessionId) {
    throw new Error("Attendance details were not found. Please go back and start Join attendance again.");
  }

  const isAssist = context.mode === "assist" || isAssistJoinMode();

  const sessionRow = context.sessionRow || {};
  const pinCode = String(context.pinCode || context.pin_code || pageParams.get("pinCode") || pageParams.get("pin") || "").trim();

  const studentName = String(context.studentName || pageParams.get("studentName") || "").trim();
  const studentMatric = String(context.studentMatric || context.matricNumber || "").trim();
  const studentDepartment = String(context.studentDepartment || "").trim();

  const courseCode = String(sessionRow.course_code || COURSE_CODE || "attendance").trim();
  const lecturerName = String(sessionRow.lecturer_name || LECTURER_NAME || "your lecturer").trim();

  if (!pinCode) {
    throw new Error("PIN code is missing. Please go back and try joining again.");
  }

  if (isAssist && !(context.matricNumber || context.studentMatric)) {
    throw new Error("Friend matric number is missing. Please go back and try Assist Join again.");
  }

  showFaceJoinPopup("joining", {
    studentName,
    courseCode,
    lecturerName,
    assist: isAssist,
  });

  setResultPill("neutral", isAssist ? "Submitting Assist" : "Submitting");
  setResultText(
    isAssist
      ? "Face verified. Colspot is now submitting Assist Join attendance..."
      : "Face verified. Colspot is now submitting your attendance..."
  );
  setLiveChip(isAssist ? "Submitting Assist Join" : "Submitting attendance");
  showSuccess(
    isAssist
      ? "Face verified. Submitting Assist Join now..."
      : "Face verified. Submitting attendance now..."
  );

  const bestLoc = await getBestLocationForFaceGuard(5, 100);

  const action = isAssist ? "assist_join_session" : "join_session";

  const payload = isAssist
    ? {
        session_id: context.sessionId,
        pin_code: pinCode,
        matric_number: context.matricNumber || context.studentMatric,
        lat: bestLoc.lat,
        lng: bestLoc.lng,
        accuracy: bestLoc.accuracy,
        face_similarity: Number(verifyData?.similarity || 1),
      }
    : {
        session_id: context.sessionId,
        pin_code: pinCode,
        lat: bestLoc.lat,
        lng: bestLoc.lng,
        accuracy: bestLoc.accuracy,
        face_similarity: Number(verifyData?.similarity || 1),
      };

  const result = await invokeNearbyGuardFromFace(session, action, payload);

  const historyEntry = {
    session_id: result?.record?.session_id || context.sessionId,
    course_code: result?.session?.course_code || sessionRow.course_code || COURSE_CODE || "",
    course_title: result?.session?.course_title || sessionRow.course_title || COURSE_TITLE || "",
    lecturer_name: result?.session?.lecturer_name || sessionRow.lecturer_name || LECTURER_NAME || "",
    attended_at: result?.record?.created_at || new Date().toISOString(),
    pin_used: pinCode,
    student_name: result?.student?.full_name || studentName || "",
    student_matric: result?.student?.matric_number || studentMatric || "",
    student_department: result?.student?.department || studentDepartment || "",
    face_match: true,
    face_similarity: Number(verifyData?.similarity || 0),
    mode: isAssist ? "assist" : "normal",
  };

  addFaceJoinToStudentHistory(historyEntry);
  clearPendingNearbyJoinContextFromFace();

  return {
    joined: true,
    result,
    historyEntry,
    context,
    assist: isAssist,
  };
}

async function initFaceMesh() {
  if (faceMesh) return;

  if (typeof FaceMesh !== "function") {
    throw new Error("MediaPipe FaceMesh is not loaded.");
  }

  faceMesh = new FaceMesh({
    locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`,
  });

  faceMesh.setOptions({
    maxNumFaces: 1,
    refineLandmarks: true,
    minDetectionConfidence: 0.6,
    minTrackingConfidence: 0.6,
  });

  faceMesh.onResults((results) => {
    drawResults(results);

    if (!scanLoopActive || captureLocked) return;

    const faces = results.multiFaceLandmarks || [];

    if (!faces.length) {
      poseHoldFrames = 0;
      setChallengeText("Position your face inside the frame.");
      setLiveChip("Face not found");
      return;
    }

    if (faces.length > 1) {
      poseHoldFrames = 0;
      setChallengeText("Only one face should be visible.");
      setLiveChip("More than one face");
      return;
    }

    const landmarks = faces[0];
    const centered = isFaceCentered(landmarks);
    const expectedPose = scanSequence[currentStepIndex] || null;

    if (!expectedPose) {
      captureLocked = true;
      scanLoopActive = false;
      setChallengeText("Hold still. We are capturing your face now.");
      setLiveChip("Capturing");
      setTimeout(captureFrame, 400);
      return;
    }

    const pose = computePose(landmarks);

    if (!centered) {
      poseHoldFrames = 0;
      setChallengeText("Move your face into the frame.");
      setLiveChip("Adjust position");
      return;
    }

    setLiveChip(`Expected: ${currentInstruction()}`);

    if (pose === expectedPose) {
      poseHoldFrames += 1;
      setChallengeText(
        `${currentInstruction()} detected. Hold still...`
      );
    } else {
      poseHoldFrames = 0;
      setChallengeText(currentInstruction());
    }

    if (poseHoldFrames >= POSE_HOLD_TARGET) {
      currentStepIndex += 1;
      poseHoldFrames = 0;
      updateSequenceUI();

      if (currentStepIndex >= scanSequence.length) {
        captureLocked = true;
        scanLoopActive = false;
        setChallengeText("Hold still. We are capturing your face now.");
        setLiveChip("Capturing");
        setTimeout(captureFrame, 400);
        return;
      }

      setChallengeText(currentInstruction());
      setLiveChip("Step passed");
    }
  });
}

async function processVideoFrame() {
  if (!scanLoopActive || !faceMesh || !faceVideo || faceVideo.readyState < 2) {
    if (scanLoopActive) requestAnimationFrame(processVideoFrame);
    return;
  }

  try {
    await faceMesh.send({ image: faceVideo });
  } catch (err) {
    console.error("FaceMesh frame processing error:", err);
  }

  if (scanLoopActive) requestAnimationFrame(processVideoFrame);
}

async function startCamera() {
  try {
    clearFlashMessages();
    directJoinCompleted = false;
    capturedDataUrl = "";
    hideCapturedPreview();
    resetResultUi();
    resetSequenceState();
    hideFaceJoinPopup();

    await ensureSession();
    await initFaceMesh();

    stopTracksOnly();

    setChallengeText("Start by looking straight at the camera.");
    setLiveChip("Opening camera");

    mediaStream = await navigator.mediaDevices.getUserMedia({
      audio: false,
      video: {
        facingMode: "user",
        width: { ideal: 720 },
        height: { ideal: 960 },
      },
    });

    faceVideo.srcObject = mediaStream;
    await faceVideo.play();

    scanLoopActive = true;
    captureLocked = false;

    setChallengeText(currentInstruction());
    setLiveChip("Live challenge started");

    setButtonState();
    requestAnimationFrame(processVideoFrame);
  } catch (err) {
    console.error(err);
    stopTracksOnly();
    setResultPill("error", "Camera error");
    setResultText("Camera access is required for attendance face verification.");
    showError(err?.message || "Unable to start camera.");
    setButtonState();
  }
}

function captureFrame() {
  const width = faceVideo.videoWidth;
  const height = faceVideo.videoHeight;

  if (!width || !height) {
    captureLocked = false;
    scanLoopActive = true;
    showError("Camera is not ready yet. Please try again.");
    setButtonState();
    return;
  }

  captureCanvas.width = width;
  captureCanvas.height = height;

  captureCtx.save();
  captureCtx.translate(width, 0);
  captureCtx.scale(-1, 1);
  captureCtx.drawImage(faceVideo, 0, 0, width, height);
  captureCtx.restore();

  capturedDataUrl = captureCanvas.toDataURL("image/jpeg", 0.95);

  showCapturedPreview(capturedDataUrl);
  setChallengeText("Challenge complete. Your face is ready for verification.");
  setLiveChip("Ready to verify");
  setResultPill("neutral", "Captured");

  if (isAssistJoinMode()) {
    setResultText("Your friend’s live face capture is ready. Tap Verify friend and submit.");
    showSuccess("Liveness challenge completed successfully for Assist Join.");
  } else {
    setResultText("Your live face capture is ready. Tap Verify and submit.");
    showSuccess("Liveness challenge completed successfully.");
  }

  setButtonState();
}

function retakeFace() {
  clearFlashMessages();
  directJoinCompleted = false;
  capturedDataUrl = "";
  hideCapturedPreview();
  resetSequenceState();
  hideFaceJoinPopup();

  if (mediaStream && faceVideo.srcObject) {
    scanLoopActive = true;
    captureLocked = false;
    setChallengeText(currentInstruction());
    setLiveChip("Restarted challenge");
    requestAnimationFrame(processVideoFrame);
  } else {
    setChallengeText("Start the camera, then look straight first.");
    setLiveChip("Look straight, turn left, turn right, face front again");
  }

  resetResultUi();
  setButtonState();
}

async function verifyFaceAndContinue() {
  if (isVerifying) return;

  try {
    clearFlashMessages();

    if (!capturedDataUrl) {
      throw new Error("Complete the movement challenge first.");
    }

    const session = await ensureSession();
    if (!session) return;

    const context = readPendingNearbyJoinContextFromFace();
    const assist = context?.mode === "assist" || isAssistJoinMode();

    const targetUserId =
      assist
        ? String(context?.helpedUserId || TARGET_USER_ID || "").trim()
        : "";

    if (assist && !targetUserId) {
      throw new Error("Assist Join student account is missing. Please go back and try again.");
    }

    isVerifying = true;
    setButtonState();

    setResultPill("neutral", "Verifying");
    setResultText(
      assist
        ? "Please hold on while Colspot verifies your friend’s face."
        : "Please hold on while Colspot verifies your face."
    );
    setLiveChip("Sending for verification");

    const requestPayload = {
      imageBase64: capturedDataUrl,
      mimeType: "image/jpeg",
      threshold: VERIFY_THRESHOLD,
      session_id: SESSION_ID || context?.sessionId || null,
      mode: assist ? "assist_join" : "normal_join",
    };

    if (assist) {
      requestPayload.target_user_id = targetUserId;
      requestPayload.targetUserId = targetUserId;
      requestPayload.helped_user_id = targetUserId;
    }

    const res = await fetch(FACE_VERIFY_FUNCTION_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${session.access_token}`,
      },
      body: JSON.stringify(requestPayload),
    });

    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result?.face_match) {
      setResultPill("error", "Failed");
      setResultText(
        assist
          ? "Your friend’s face could not be verified for Assist Join."
          : "Your face could not be verified for attendance."
      );
      setLiveChip("Verification failed");
      showError(result?.error || result?.message || "Face verification failed. Please retake and try again.");
      return;
    }

    const directJoin = await joinAttendanceInsideFaceVerification(session, {
      similarity: result?.similarity ?? "",
      threshold: result?.threshold ?? VERIFY_THRESHOLD,
      assist,
    });

    directJoinCompleted = true;
    stopTracksOnly();

    const joinedResult = directJoin.result || {};
    const sessionData = joinedResult.session || {};
    const studentData = joinedResult.student || {};
    const historyEntry = directJoin.historyEntry || {};
    const joinContext = directJoin.context || {};
    const sessionRow = joinContext.sessionRow || {};
    const joinedAssist = !!directJoin.assist;

    const studentName =
      studentData.full_name ||
      historyEntry.student_name ||
      joinContext.studentName ||
      "Student";

    const courseCode =
      sessionData.course_code ||
      historyEntry.course_code ||
      sessionRow.course_code ||
      COURSE_CODE ||
      "attendance";

    const lecturerName =
      sessionData.lecturer_name ||
      historyEntry.lecturer_name ||
      sessionRow.lecturer_name ||
      LECTURER_NAME ||
      "your lecturer";

    setResultPill("success", joinedAssist ? "Assist submitted" : "Submitted");

    setResultText(
      joinedAssist
        ? `${studentName}, Assist Join attendance for ${courseCode} has been submitted successfully.`
        : `${studentName}, your attendance for ${courseCode} has been submitted successfully.`
    );

    setLiveChip(joinedAssist ? "Assist Join submitted" : "Attendance submitted");

    showSuccess(
      joinedResult.message ||
        (joinedAssist ? "Assist Join submitted successfully." : "Attendance submitted successfully.")
    );

    showFaceJoinPopup("success", {
      studentName,
      courseCode,
      lecturerName,
      assist: joinedAssist,
    });

    if (verifyFaceBtn) {
      verifyFaceBtn.textContent = joinedAssist ? "Assist Join submitted" : "Attendance submitted";
      verifyFaceBtn.disabled = true;
    }

    if (retakeFaceBtn) {
      retakeFaceBtn.disabled = true;
    }
  } catch (err) {
    console.error(err);

    setResultPill("error", "Error");
    setResultText("Something went wrong during face verification or attendance submission.");
    setLiveChip("Error");
    showError(err?.message || "Unable to verify face right now.");

    showFaceJoinPopup("error", {
      message:
        htmlEscape(err?.message || "Face verified, but Colspot could not submit attendance. Please go back and try again."),
      assist: isAssistJoinMode(),
    });
  } finally {
    isVerifying = false;
    setButtonState();
  }
}

function bindEvents() {
  startCameraBtn?.addEventListener("click", startCamera);
  captureFaceBtn?.addEventListener("click", verifyFaceAndContinue);
  retakeFaceBtn?.addEventListener("click", retakeFace);
  verifyFaceBtn?.addEventListener("click", verifyFaceAndContinue);

  cancelFaceBtn?.addEventListener("click", () => {
    if (isAssistJoinMode()) {
      alert("Assist Join uses face verification to confirm your friend is physically present before attendance is submitted.");
      return;
    }

    alert("This helps Colspot confirm that a real live student is the one joining attendance.");
  });

  faceBackBtn?.addEventListener("click", goBackCancelled);

  faceJoinDoneBtn?.addEventListener("click", () => {
    window.location.href = RETURN_TO || "main.html";
  });

  window.addEventListener("beforeunload", stopTracksOnly);
}

async function init() {
  try {
    applyFaceModeUi();

    setChallengeText("Start the camera, then look straight first.");
    setLiveChip(
      isAssistJoinMode()
        ? "Verify friend’s face"
        : "Look straight, turn left, turn right, face front again"
    );

    resetSequenceState();
    resetResultUi();
    setButtonState();

    if (!window.supabase?.createClient) {
      throw new Error("Supabase library is not loaded.");
    }

    if (
      typeof FaceMesh !== "function" ||
      typeof drawConnectors !== "function" ||
      typeof FACEMESH_TESSELATION === "undefined" ||
      typeof FACEMESH_FACE_OVAL === "undefined"
    ) {
      throw new Error("MediaPipe scripts are not loaded.");
    }

    if (!SUPABASE_URL || !SUPABASE_ANON_KEY || SUPABASE_ANON_KEY === "YOUR_SUPABASE_ANON_KEY_HERE") {
      throw new Error("Missing Supabase URL or anon key.");
    }

    if (!navigator.mediaDevices?.getUserMedia) {
      throw new Error("This device does not support camera access.");
    }

    await ensureSession();
  } catch (err) {
    console.error(err);
    setResultPill("error", "Unavailable");
    setResultText("Face verification cannot start on this device.");
    showError(err?.message || "Face verification is unavailable.");

    if (startCameraBtn) startCameraBtn.disabled = true;
    if (captureFaceBtn) captureFaceBtn.disabled = true;
    if (verifyFaceBtn) verifyFaceBtn.disabled = true;
    if (retakeFaceBtn) retakeFaceBtn.disabled = true;
  }
}

bindEvents();
init();
