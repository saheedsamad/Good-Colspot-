          (session && session.school_name && String(session.school_name).trim()) ||
          (session && session.school && String(session.school).trim()) ||
          (session && session.schoolName && String(session.schoolName).trim()) ||
          "School"
        );
      }

      function requireHosSession(){
        adminSession = getAdminSession();

        window.adminSession = adminSession;
        window.SUPABASE_URL = SUPABASE_URL;
        window.SUPABASE_ANON_KEY = SUPABASE_ANON_KEY;

        if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
          window.location.href = "index.html";
          return false;
        }

        const hosName = getDisplayNameFromSession(adminSession);
        const schoolName = getSchoolNameFromSession(adminSession);
        const firstLetter = hosName.charAt(0).toUpperCase() || "H";

        $("welcomeHosName").textContent = hosName;
        $("sidebarSchoolName").textContent = schoolName;
        $("topSchoolName").textContent = schoolName;
        $("avatarChip").textContent = firstLetter;
        $("topHosLabel").textContent = "Head of School";

        return true;
      }

      function updateTopbar(screenName){
        const meta = pageMeta[screenName] || pageMeta.dashboard;
        $("topPageTitle").textContent = meta.title;
        $("topPageSub").textContent = meta.sub;
      }

      function setActiveNav(screenName){
        document.querySelectorAll(".nav-btn[data-screen]").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.screen === screenName);
        });
      }

      function setActiveScreen(screenName){
        document.querySelectorAll(".screen").forEach((screen) => {
          screen.classList.remove("active");
        });

        const target = $("screen-" + screenName);
        if (target){
          target.classList.add("active");
        }

        setActiveNav(screenName);
        updateTopbar(screenName);

        const scroller = document.querySelector(".content-scroll");
        if (scroller) scroller.scrollTop = 0;
      }

      window.showHosScreen = function(screenName){
        setActiveScreen(screenName);
      };

      function bindSidebar(){
        document.querySelectorAll(".nav-btn[data-screen]").forEach((btn) => {
          btn.addEventListener("click", () => {
            setActiveScreen(btn.dataset.screen || "dashboard");
          });
        });
      }

      function renderEmptyState(id, text){
        const el = $(id);
        if (!el) return;
        el.textContent = text;
      }

      async function loadDashboardLive(){
        try{
          renderEmptyState("dashboardHistoryBox", "No live activity connected yet.");
          renderEmptyState("staffOverviewBox", "No live staff overview connected yet.");
          renderEmptyState("formsOverviewBox", "No live forms overview connected yet.");
          renderEmptyState("announcementsOverviewBox", "No live announcement overview connected yet.");

          $("totalHods").textContent = "--";
          $("totalAgents").textContent = "--";
          $("activeForms").textContent = "--";
          $("totalAnnouncements").textContent = "--";
          $("totalReports").textContent = "--";
          $("pendingActions").textContent = "--";

          if (!sb) return;
        }catch(err){
          console.error("loadDashboardLive failed:", err);
          showMessage("Could not load live dashboard data.", "error");
        }
      }

      function hideCreateMessages(){
        const err = $("createAccountError");
        const ok = $("createAccountSuccess");
        if (err) {
          err.style.display = "none";
          err.textContent = "";
        }
        if (ok) {
          ok.style.display = "none";
          ok.textContent = "";
        }
      }

      function showCreateError(message){
        const err = $("createAccountError");
        const ok = $("createAccountSuccess");
        if (ok) {
          ok.style.display = "none";
          ok.textContent = "";
        }
        if (err) {
          err.textContent = message;
          err.style.display = "block";
        }
      }

      function showCreateSuccess(message){
        const err = $("createAccountError");
        const ok = $("createAccountSuccess");
        if (err) {
          err.style.display = "none";
          err.textContent = "";
        }
        if (ok) {
          ok.textContent = message;
          ok.style.display = "block";
        }
      }

      function normalizeRoleLabel(role, functionType){
        if (role === "hod") return "HOD";
        if (role === "report_agent") return "Report Agent";
        if (role === "form_agent") return "Form Agent";
        if (role === "announcement_agent") return "Announcement Agent";
        if (role === "agent" && functionType === "report") return "Report Agent";
        if (role === "agent" && functionType === "form") return "Form Agent";
        if (role === "agent" && functionType === "announcement") return "Announcement Agent";
        return role || "Account";
      }

      function getCreateFunctionName(type){
        if (type === "hod") return "create-hod-account";
        if (type === "report_agent") return "create-report-agent-account";
        if (type === "form_agent") return "create-form-agent-account";
        if (type === "announcement_agent") return "create-announcement-agent-account";
        return "";
      }

      function setCreateLoading(isLoading){
        const btn = $("createAccountBtn");
        const btnText = $("createAccountBtnText");
        const refreshBtn = $("refreshCreatedAccountsBtn");
        if (btn) btn.disabled = isLoading;
        if (refreshBtn) refreshBtn.disabled = isLoading;
        if (btnText) btnText.textContent = isLoading ? "Creating..." : "Create Account";
      }

      function setCreatedAccountsLoading(message){
        const state = $("createdAccountsState");
        const list = $("createdAccountsList");
        if (state) {
          state.textContent = message || "Loading...";
          state.style.display = "block";
        }
        if (list) {
          list.style.display = "none";
          list.innerHTML = "";
        }
      }

      function renderCreatedAccounts(items){
        const state = $("createdAccountsState");
        const list = $("createdAccountsList");

        if (!list || !state) return;

        if (!Array.isArray(items) || !items.length) {
          state.style.display = "block";
          state.innerHTML = '<div class="created-empty">No created accounts yet.</div>';
          list.style.display = "none";
          list.innerHTML = "";
          return;
        }

        state.style.display = "none";
        list.style.display = "block";
        list.innerHTML = items.map((item) => {
          const fullName = item.full_name || "No name";
          const role = item.account_type || "";
          const functionType = item.function_type || "";
          const email = item.linked_email || "—";
          const department = item.department_name || "—";
          const loginId = item.login_id || "—";
          const activeText = item.is_active ? "Active" : "Disabled";

          return `
            <div class="created-item">
              <div class="created-top">
                <div class="created-name">${escapeHtml(fullName)}</div>
                <div class="created-role">${escapeHtml(normalizeRoleLabel(role, functionType))}</div>
              </div>

              <div class="created-meta">
                <div class="created-meta-row">
                  <span class="created-meta-label">Login ID:</span>
                  <span>${escapeHtml(loginId)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Email:</span>
                  <span>${escapeHtml(email)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Department:</span>
                  <span>${escapeHtml(department)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Status:</span>
                  <span>${escapeHtml(activeText)}</span>
                </div>
              </div>
            </div>
          `;
        }).join("");
      }

      async function callHosEdgeFunction(functionName, payload){
        const headers = {
          "Content-Type": "application/json",
          "apikey": window.SUPABASE_ANON_KEY
        };

        const res = await fetch(`${window.SUPABASE_URL}/functions/v1/${functionName}`, {
          method: "POST",
          headers,
          body: JSON.stringify(payload)
        });

        let data = null;
        try {
          data = await res.json();
        } catch {
          data = null;
        }

        if (!res.ok || !data || data.ok === false) {
          const message =
            (data && (data.error || data.message)) ||
            `Request failed for ${functionName}`;
          throw new Error(message);
        }

        return data;
      }

      function getHosAdminId(){
        if (window.adminSession) {
          return (window.adminSession.account && window.adminSession.account.id) || window.adminSession.id || "";
        }
        return "";
      }

      function getHosSchoolName(){
        if (window.adminSession) {
          return (window.adminSession.account && window.adminSession.account.school_name) || window.adminSession.school_name || "School";
        }
        return "School";
      }

      async function loadCreatedAccounts(){
        try {
          setCreatedAccountsLoading("Loading created accounts...");

          const hosAdminId = getHosAdminId();
          if (!hosAdminId) {
            throw new Error("HOS session not found.");
          }

          const data = await callHosEdgeFunction("list-hos-created-accounts", {
            hos_admin_id: hosAdminId
          });

          renderCreatedAccounts(data.accounts || []);
        } catch (error) {
          const state = $("createdAccountsState");
          const list = $("createdAccountsList");

          if (list) {
            list.style.display = "none";
            list.innerHTML = "";
          }

          if (state) {
            state.style.display = "block";
            state.textContent = error.message || "Could not load created accounts.";
          }
        }
      }

      function initCreateAccountSection(){
        const accountType = $("createAccountType");
        const fullName = $("createFullName");
        const email = $("createEmail");
        const department = $("createDepartment");
        const departmentWrap = $("departmentFieldWrap");
        const schoolDisplay = $("createSchoolDisplay");
        const form = $("createAccountForm");
        const refreshBtn = $("refreshCreatedAccountsBtn");

        if (!form) return;

        if (schoolDisplay) {
          schoolDisplay.textContent = getHosSchoolName();
        }

        function updateDepartmentVisibility(){
          const isHod = accountType.value === "hod";
          departmentWrap.style.display = isHod ? "grid" : "none";
          department.required = isHod;
          if (!isHod) department.value = "";
        }

        accountType.addEventListener("change", updateDepartmentVisibility);
        updateDepartmentVisibility();

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          hideCreateMessages();

          const type = accountType.value.trim();
          const name = fullName.value.trim();
          const mail = email.value.trim();
          const dept = department.value.trim();

          if (!type) {
            showCreateError("Select an account type.");
            return;
          }

          if (!name) {
            showCreateError("Full name is required.");
            return;
          }

          if (type === "hod" && !dept) {
            showCreateError("Department is required for HOD.");
            return;
          }

          const functionName = getCreateFunctionName(type);
          if (!functionName) {
            showCreateError("Invalid account type selected.");
            return;
          }

          const hosAdminId = getHosAdminId();
          if (!hosAdminId) {
            showCreateError("HOS session not found.");
            return;
          }

          const payload = {
            hos_admin_id: hosAdminId,
            full_name: name
          };

          if (type === "hod") {
            payload.department_name = dept;
          } else if (mail) {
            payload.email = mail;
          }

          setCreateLoading(true);

          try {
            const data = await callHosEdgeFunction(functionName, payload);

            let loginId = "";
            const tempPassword = data.temporary_password || "";

            if (type === "hod") {
              loginId = (data.hod_account && data.hod_account.login_id) || "";
            } else if (type === "report_agent") {
              loginId = (data.report_agent_account && data.report_agent_account.login_id) || "";
            } else if (type === "form_agent") {
              loginId = (data.form_agent_account && data.form_agent_account.login_id) || "";
            } else if (type === "announcement_agent") {
              loginId = (data.announcement_agent_account && data.announcement_agent_account.login_id) || "";
            }

            showCreateSuccess(
              `${normalizeRoleLabel(type)} created successfully. Login ID: ${loginId || "Generated"} | Temporary Password: ${tempPassword || "Generated"}`
            );

            form.reset();
            updateDepartmentVisibility();
            await loadCreatedAccounts();
          } catch (error) {
            showCreateError(error.message || "Could not create account.");
          } finally {
            setCreateLoading(false);
          }
        });

        if (refreshBtn) {
          refreshBtn.addEventListener("click", loadCreatedAccounts);
        }

        loadCreatedAccounts();
      }

      document.addEventListener("DOMContentLoaded", async () => {
        initSupabase();

        if (!requireHosSession()) return;

        bindSidebar();
        setActiveScreen("dashboard");
        initCreateAccountSection();
        await loadDashboardLive();
      });
    })();
  </script>
</body>
</html>
