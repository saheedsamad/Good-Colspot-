<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Colspot • HOS Dashboard</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --sidebar:#102742;
      --sidebar-2:#17385f;
      --bg:#f4f7fb;
      --card:#ffffff;
      --line:#e6ecf3;
      --text:#0f172a;
      --muted:#6b7280;
      --shadow:0 12px 30px rgba(15,23,42,.08);
      --radius:18px;
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    }

    html,body{
      height:100%;
    }

    body{
      background:var(--bg);
      color:var(--text);
      overflow:hidden;
    }

    button,
    input{
      font:inherit;
    }

    .app{
      display:flex;
      min-height:100vh;
      width:100%;
      overflow:hidden;
    }

    /* SIDEBAR */
    .sidebar{
      width:250px;
      background:linear-gradient(180deg,var(--sidebar),var(--sidebar-2));
      color:#fff;
      display:flex;
      flex-direction:column;
      border-right:1px solid rgba(255,255,255,.06);
      flex-shrink:0;
      min-height:100vh;
      overflow-y:auto;
    }

    .brand{
      height:86px;
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 22px;
      border-bottom:1px solid rgba(255,255,255,.08);
      flex-shrink:0;
    }

    .brand-badge{
      width:40px;
      height:40px;
      border-radius:12px;
      background:rgba(255,255,255,.08);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .brand-badge svg{
      width:22px;
      height:22px;
      stroke:#fff;
    }

    .brand-name{
      font-size:20px;
      font-weight:800;
      letter-spacing:.02em;
    }

    .sidebar-nav{
      padding:14px 10px 18px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .nav-btn{
      width:100%;
      border:none;
      background:transparent;
      color:rgba(255,255,255,.92);
      height:50px;
      border-radius:14px;
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 16px;
      cursor:pointer;
      font-size:15px;
      font-weight:700;
      transition:.18s ease;
      text-align:left;
    }

    .nav-btn:hover{
      background:rgba(255,255,255,.07);
    }

    .nav-btn.active{
      background:var(--blue);
      color:#fff;
    }

    .nav-btn svg{
      width:20px;
      height:20px;
      stroke:currentColor;
      flex-shrink:0;
    }

    /* MAIN */
    .main{
      flex:1;
      display:flex;
      flex-direction:column;
      min-width:0;
      min-height:100vh;
      overflow:hidden;
    }

    .topbar{
      height:86px;
      background:#f7f9fc;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 26px;
      flex-shrink:0;
      gap:16px;
    }

    .topbar-title{
      font-size:22px;
      font-weight:800;
      color:#13253d;
    }

    .topbar-right{
      display:flex;
      align-items:center;
      gap:16px;
      flex-wrap:wrap;
    }

    .search{
      width:300px;
      height:46px;
      border:1px solid var(--line);
      background:#fff;
      border-radius:12px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
    }

    .search svg{
      width:18px;
      height:18px;
      stroke:#7b8794;
      flex-shrink:0;
    }

    .search input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      color:#334155;
      font-size:14px;
    }

    .profile-chip{
      display:flex;
      align-items:center;
      gap:10px;
      color:#223754;
      font-weight:700;
      white-space:nowrap;
    }

    .profile-chip svg{
      width:18px;
      height:18px;
      stroke:#223754;
    }

    .avatar{
      width:38px;
      height:38px;
      border-radius:50%;
      background:linear-gradient(135deg,#dbeafe,#93c5fd);
      flex-shrink:0;
      border:2px solid #fff;
      box-shadow:0 6px 14px rgba(15,23,42,.08);
    }

    /* CONTENT */
    .content{
      flex:1;
      overflow-y:auto;
      overflow-x:hidden;
      padding:22px;
      min-height:0;
      -webkit-overflow-scrolling:touch;
    }

    .screen{
      display:none;
    }

    .screen.active{
      display:block;
    }

    /* DASHBOARD */
    .welcome-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      box-shadow:var(--shadow);
      padding:22px;
      margin-bottom:18px;
    }

    .welcome-label{
      font-size:12px;
      font-weight:700;
      color:var(--muted);
      margin-bottom:6px;
    }

    .welcome-title{
      font-size:28px;
      font-weight:800;
      color:#13253d;
      line-height:1.12;
      letter-spacing:-0.03em;
      margin-bottom:8px;
    }

    .welcome-title .hos-name{
      color:var(--blue);
    }

    .welcome-sub{
      font-size:14px;
      line-height:1.55;
      color:var(--muted);
      max-width:760px;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(6, minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .stat-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:16px;
      box-shadow:var(--shadow);
      padding:14px 16px;
      min-height:82px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .stat-label{
      font-size:13px;
      font-weight:700;
      color:#7b8794;
      line-height:1.2;
    }

    .stat-value{
      font-size:20px;
      font-weight:800;
      color:#0f172a;
      line-height:1;
    }

    .dashboard-grid{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:18px;
    }

    .panel{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:18px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .panel-header{
      height:54px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 18px;
      font-size:15px;
      font-weight:800;
      color:#13253d;
      background:#fff;
    }

    .panel-body{
      padding:18px;
    }

    .placeholder-box{
      min-height:180px;
      border:1px dashed #cdd8e5;
      border-radius:16px;
      background:#f9fbfe;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      color:#7b8794;
      font-size:14px;
      font-weight:700;
      padding:20px;
    }

    .quick-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .quick-btn{
      height:54px;
      border:none;
      border-radius:12px;
      color:#fff;
      font-size:14px;
      font-weight:800;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      cursor:pointer;
    }

    .quick-btn svg{
      width:18px;
      height:18px;
      stroke:#fff;
    }

    .quick-blue{ background:linear-gradient(135deg,#2563eb,#1d4ed8); }
    .quick-green{ background:linear-gradient(135deg,#65a30d,#4d7c0f); }
    .quick-orange{ background:linear-gradient(135deg,#f59e0b,#ea580c); }

    /* PLACEHOLDER SCREENS */
    .page-shell{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .page-top{
      height:72px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 22px;
      background:#fff;
    }

    .page-title-wrap{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .page-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#eff6ff;
      color:var(--blue);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .page-icon svg{
      width:20px;
      height:20px;
      stroke:currentColor;
    }

    .page-title{
      font-size:20px;
      font-weight:800;
      color:#13253d;
    }

    .page-sub{
      font-size:13px;
      font-weight:700;
      color:#7b8794;
      margin-top:2px;
    }

    .page-body{
      padding:24px;
    }

    .big-placeholder{
      min-height:400px;
      border:1px dashed #cdd8e5;
      border-radius:18px;
      background:#f9fbfe;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      color:#7b8794;
      font-size:16px;
      font-weight:800;
      padding:24px;
    }

    @media (max-width: 1400px){
      .stats-grid{
        grid-template-columns:repeat(3, minmax(0,1fr));
      }
    }

    @media (max-width: 1180px){
      .dashboard-grid{
        grid-template-columns:1fr;
      }

      .quick-grid{
        grid-template-columns:repeat(2, minmax(0,1fr));
      }
    }

    @media (max-width: 900px){
      body{
        overflow:auto;
      }

      .app{
        flex-direction:column;
      }

      .sidebar{
        width:100%;
        min-height:auto;
      }

      .topbar{
        flex-direction:column;
        align-items:flex-start;
        gap:12px;
        height:auto;
        padding:18px;
      }

      .topbar-right{
        width:100%;
        flex-wrap:wrap;
      }

      .search{
        width:100%;
      }

      .stats-grid,
      .quick-grid{
        grid-template-columns:1fr;
      }

      .welcome-title{
        font-size:24px;
      }
    }
  </style>
</head>
<body>
  <div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 8.5 12 4l10 4.5-10 4.5L2 8.5Z"/>
            <path d="M6 10.3V15c0 1.6 3 3 6 3s6-1.4 6-3v-4.7"/>
            <path d="M22 9v6"/>
          </svg>
        </div>
        <div class="brand-name">HOS</div>
      </div>

      <nav class="sidebar-nav">
        <button class="nav-btn active" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M3 11.5 12 4l9 7.5"/>
            <path d="M5 10.5V20h14v-9.5"/>
            <path d="M9 20v-5h6v5"/>
          </svg>
          <span>Dashboard</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
            <path d="M5 20a7 7 0 0 1 14 0"/>
            <path d="M18.5 8.5h5"/>
            <path d="M21 6v5"/>
          </svg>
          <span>Create Account</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
            <path d="M17 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
            <path d="M2.5 19a5.5 5.5 0 0 1 11 0"/>
            <path d="M14 19a4.5 4.5 0 0 1 8 0"/>
          </svg>
          <span>Staff &amp; Roles</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M4 14V10l11-4v12L4 14Z"/>
            <path d="M15 8h2a3 3 0 0 1 0 6h-2"/>
            <path d="M6 14.5 7.5 20h3l-1.2-4.2"/>
          </svg>
          <span>Announcements</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M7 3h7l5 5v13H7z"/>
            <path d="M14 3v5h5"/>
            <path d="M10 13h6"/>
            <path d="M10 17h6"/>
          </svg>
          <span>Reports</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M8 6h13"/>
            <path d="M8 12h13"/>
            <path d="M8 18h13"/>
            <path d="M3.5 6h.01"/>
            <path d="M3.5 12h.01"/>
            <path d="M3.5 18h.01"/>
          </svg>
          <span>Forms</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <path d="M3 4v5h5"/>
            <path d="M12 7v6l4 2"/>
          </svg>
          <span>History</span>
        </button>

        <button class="nav-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/>
            <path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 0 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.2a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.2a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3h.1a1.6 1.6 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.2a1.6 1.6 0 0 0 1 1.5h.1a1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8v.1a1.6 1.6 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.2a1.6 1.6 0 0 0-1.5 1Z"/>
          </svg>
          <span>Settings</span>
        </button>
      </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
      <header class="topbar">
        <div class="topbar-title">HOS Dashboard</div>

        <div class="topbar-right">
          <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.2-3.2"></path>
            </svg>
            <input type="text" placeholder="Search..." />
          </div>

          <div class="profile-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
              <path d="M6 10V8a6 6 0 1 1 12 0v2"/>
              <rect x="4" y="10" width="16" height="10" rx="2"/>
            </svg>
            <span>School</span>
            <div class="avatar"></div>
          </div>
        </div>
      </header>

      <section class="content">

        <!-- DASHBOARD -->
        <section class="screen active" id="screen-dashboard">
          <div class="welcome-card">
            <div class="welcome-label">Dashboard</div>
            <div class="welcome-title">
              Welcome back, <span class="hos-name">HOS Name</span>
            </div>
            <div class="welcome-sub">
              Monitor your school activities, check quick summaries, and manage HODs, agents, reports, announcements, and forms from one place.
            </div>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">Total HODs</div>
              <div class="stat-value">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Total Agents</div>
              <div class="stat-value">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Active Forms</div>
              <div class="stat-value">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Announcements</div>
              <div class="stat-value">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Reports</div>
              <div class="stat-value">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Pending Actions</div>
              <div class="stat-value">0</div>
            </div>
          </div>

          <div class="quick-grid">
            <button class="quick-btn quick-blue" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
                <path d="M5 20a7 7 0 0 1 14 0"/>
                <path d="M18.5 8.5h5"/>
                <path d="M21 6v5"/>
              </svg>
              <span>Create HOD</span>
            </button>

            <button class="quick-btn quick-green" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
                <path d="M5 20a7 7 0 0 1 14 0"/>
              </svg>
              <span>Create Agent</span>
            </button>

            <button class="quick-btn quick-orange" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <path d="M4 14V10l11-4v12L4 14Z"/>
                <path d="M15 8h2a3 3 0 0 1 0 6h-2"/>
              </svg>
              <span>Send Announcement</span>
            </button>

            <button class="quick-btn quick-green" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <path d="M8 6h13"/>
                <path d="M8 12h13"/>
                <path d="M8 18h13"/>
                <path d="M3.5 6h.01"/>
                <path d="M3.5 12h.01"/>
                <path d="M3.5 18h.01"/>
              </svg>
              <span>Create Form</span>
            </button>
          </div>

          <div class="dashboard-grid">
            <div class="panel">
              <div class="panel-header">Overview</div>
              <div class="panel-body">
                <div class="placeholder-box">
                  Dashboard overview area.<br>
                  Live data will be connected here with JavaScript.
                </div>
              </div>
            </div>

            <div class="panel">
              <div class="panel-header">Recent Activity</div>
              <div class="panel-body">
                <div class="placeholder-box">
                  Recent activity will appear here when backend data is connected.
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- CREATE ACCOUNT -->
        <section class="screen" id="screen-create-account">
          <div class="page-shell">
            <div class="page-top">
              <div class="page-title-wrap">
                <div class="page-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
                    <path d="M5 20a7 7 0 0 1 14 0"/>
                    <path d="M18.5 8.5h5"/>
                    <path d="M21 6v5"/>
                  </svg>
                </div>
                <div>
                  <div class="page-title">Create Account</div>
                  <div class="page-sub">This is create account screen as a placeholder</div>
                </div>
              </div>
            </div>

            <div class="page-body">
              <div class="big-placeholder">
                This is create account screen as a placeholder
              </div>
            </div>
          </div>
        </section>

        <!-- STAFF & ROLES -->
        <section class="screen" id="screen-staff-roles">
          <div class="page-shell">
            <div class="page-top">
              <div class="page-title-wrap">
                <div class="page-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                    <path d="M17 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                    <path d="M2.5 19a5.5 5.5 0 0 1 11 0"/>
                    <path d="M14 19a4.5 4.5 0 0 1 8 0"/>
                  </svg>
                </div>
                <div>
                  <div class="page-title">Staff &amp; Roles</div>
                  <div class="page-sub">This is staff and roles screen as a placeholder</div>
                </div>
              </div>
            </div>

            <div class="page-body">
              <div class="big-placeholder">
                This is staff and roles screen as a placeholder
              </div>
            </div>
          </div>
        </section>

        <!-- ANNOUNCEMENTS -->
        <section class="screen" id="screen-announcements">
          <div class="page-shell">
            <div class="page-top">
              <div class="page-title-wrap">
                <div class="page-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M4 14V10l11-4v12L4 14Z"/>
                    <path d="M15 8h2a3 3 0 0 1 0 6h-2"/>
                    <path d="M6 14.5 7.5 20h3l-1.2-4.2"/>
                  </svg>
                </div>
                <div>
                  <div class="page-title">Announcements</div>
                  <div class="page-sub">This is announcements screen as a placeholder</div>
                </div>
              </div>
            </div>

            <div class="page-body">
              <div class="big-placeholder">
                This is announcements screen as a placeholder
              </div>
            </div>
          </div>
        </section>

        <!-- REPORTS -->
        <section class="screen" id="screen-reports">
          <div class="page-shell">
            <div class="page-top">
