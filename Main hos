<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Colspot • HOS Dashboard</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --sidebar:#102742;
      --sidebar-2:#17385f;
      --bg:#f4f7fb;
      --card:#ffffff;
      --line:#e6ecf3;
      --text:#0f172a;
      --muted:#6b7280;
      --shadow:0 12px 30px rgba(15,23,42,.08);
      --radius:18px;
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    }

    html,body{
      height:100%;
    }

    body{
      background:var(--bg);
      color:var(--text);
      overflow:hidden;
    }

    button,
    input,
    select{
      font:inherit;
    }

    .app{
      display:flex;
      min-height:100vh;
      width:100%;
    }

    .sidebar{
      width:250px;
      background:linear-gradient(180deg,var(--sidebar),var(--sidebar-2));
      color:#fff;
      display:flex;
      flex-direction:column;
      border-right:1px solid rgba(255,255,255,.06);
      flex-shrink:0;
    }

    .brand{
      height:86px;
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 22px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .brand-badge{
      width:40px;
      height:40px;
      border-radius:12px;
      background:rgba(255,255,255,.08);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .brand-badge svg{
      width:22px;
      height:22px;
      stroke:#fff;
    }

    .brand-name{
      font-size:20px;
      font-weight:800;
      letter-spacing:.02em;
    }

    .sidebar-nav{
      padding:14px 10px 18px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .nav-btn{
      width:100%;
      border:none;
      background:transparent;
      color:rgba(255,255,255,.92);
      height:50px;
      border-radius:14px;
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 16px;
      cursor:pointer;
      font-size:15px;
      font-weight:700;
      transition:.18s ease;
      text-align:left;
    }

    .nav-btn:hover{
      background:rgba(255,255,255,.07);
    }

    .nav-btn.active{
      background:var(--blue);
      color:#fff;
    }

    .nav-btn svg{
      width:20px;
      height:20px;
      stroke:currentColor;
      flex-shrink:0;
    }

    .main{
      flex:1;
      display:flex;
      flex-direction:column;
      min-width:0;
    }

    .topbar{
      height:86px;
      background:#f7f9fc;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 26px;
      flex-shrink:0;
    }

    .topbar-title{
      font-size:22px;
      font-weight:800;
      color:#13253d;
    }

    .topbar-right{
      display:flex;
      align-items:center;
      gap:16px;
    }

    .search{
      width:300px;
      height:46px;
      border:1px solid var(--line);
      background:#fff;
      border-radius:12px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
    }

    .search svg{
      width:18px;
      height:18px;
      stroke:#7b8794;
      flex-shrink:0;
    }

    .search input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      color:#334155;
      font-size:14px;
    }

    .profile-chip{
      display:flex;
      align-items:center;
      gap:10px;
      color:#223754;
      font-weight:700;
      white-space:nowrap;
    }

    .profile-chip svg{
      width:18px;
      height:18px;
      stroke:#223754;
    }

    .avatar{
      width:38px;
      height:38px;
      border-radius:50%;
      background:linear-gradient(135deg,#dbeafe,#93c5fd);
      flex-shrink:0;
      border:2px solid #fff;
      box-shadow:0 6px 14px rgba(15,23,42,.08);
    }

    .content{
      flex:1;
      overflow:auto;
      padding:22px;
    }

    .screen{
      display:none;
    }

    .screen.active{
      display:block;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(6, minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .stat-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:16px;
      box-shadow:var(--shadow);
      padding:14px 16px;
      min-height:82px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .stat-label{
      font-size:13px;
      font-weight:700;
      color:#7b8794;
      line-height:1.2;
    }

    .stat-value{
      font-size:20px;
      font-weight:800;
      color:#0f172a;
      line-height:1;
    }

    .dashboard-grid{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:18px;
    }

    .panel{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:18px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .panel-header{
      height:54px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 18px;
      font-size:15px;
      font-weight:800;
      color:#13253d;
      background:#fff;
    }

    .panel-body{
      padding:18px;
    }

    .placeholder-box{
      min-height:180px;
      border:1px dashed #cdd8e5;
      border-radius:16px;
      background:#f9fbfe;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      color:#7b8794;
      font-size:14px;
      font-weight:700;
      padding:20px;
    }

    .quick-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .quick-btn{
      height:54px;
      border:none;
      border-radius:12px;
      color:#fff;
      font-size:14px;
      font-weight:800;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      cursor:pointer;
    }

    .quick-btn svg{
      width:18px;
      height:18px;
      stroke:#fff;
    }

    .quick-blue{ background:linear-gradient(135deg,#2563eb,#1d4ed8); }
    .quick-green{ background:linear-gradient(135deg,#65a30d,#4d7c0f); }
    .quick-orange{ background:linear-gradient(135deg,#f59e0b,#ea580c); }

    .page-shell{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .page-top{
      height:72px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 22px;
      background:#fff;
    }

    .page-title-wrap{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .page-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#eff6ff;
      color:var(--blue);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .page-icon svg{
      width:20px;
      height:20px;
      stroke:currentColor;
    }

    .page-title{
      font-size:20px;
      font-weight:800;
      color:#13253d;
    }

    .page-sub{
      font-size:13px;
      font-weight:700;
      color:#7b8794;
      margin-top:2px;
    }

    .page-body{
      padding:24px;
    }

    .big-placeholder{
      min-height:400px;
      border:1px dashed #cdd8e5;
      border-radius:18px;
      background:#f9fbfe;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      color:#7b8794;
      font-size:16px;
      font-weight:800;
      padding:24px;
    }

    /* CREATE ACCOUNT SCREEN */
    #screen-create-account{
      padding:0;
    }

    #screen-create-account .create-account-shell{
      display:flex;
      flex-direction:column;
      gap:18px;
      min-height:100%;
    }

    #screen-create-account .create-top{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      box-shadow:var(--shadow);
      padding:22px;
    }

    #screen-create-account .create-kicker{
      font-size:12px;
      font-weight:700;
      color:var(--muted);
      margin-bottom:6px;
    }

    #screen-create-account .create-main-title{
      font-size:28px;
      line-height:1.12;
      font-weight:800;
      color:#13253d;
      letter-spacing:-0.03em;
      margin-bottom:8px;
    }

    #screen-create-account .create-main-title span{
      color:var(--blue);
    }

    #screen-create-account .create-top-sub{
      font-size:14px;
      line-height:1.55;
      color:var(--muted);
      max-width:780px;
    }

    #screen-create-account .create-layout{
      display:grid;
      grid-template-columns:1.08fr .92fr;
      gap:18px;
      align-items:start;
    }

    #screen-create-account .create-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      box-shadow:var(--shadow);
      padding:20px;
    }

    #screen-create-account .card-title{
      font-size:17px;
      font-weight:800;
      color:#13253d;
      margin-bottom:4px;
    }

    #screen-create-account .card-sub{
      font-size:13px;
      line-height:1.5;
      color:var(--muted);
      margin-bottom:16px;
    }

    #screen-create-account .field-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    #screen-create-account .field{
      display:flex;
      flex-direction:column;
      gap:7px;
      margin-bottom:14px;
    }

    #screen-create-account .field.full{
      grid-column:1 / -1;
    }

    #screen-create-account .field label{
      font-size:12px;
      font-weight:700;
      color:#475569;
    }

    #screen-create-account .text-input,
    #screen-create-account .select-input,
    #screen-create-account .search-input-ca{
      width:100%;
      height:48px;
      border:1px solid var(--line);
      background:#fff;
      border-radius:14px;
      padding:0 14px;
      font-size:14px;
      color:#0f172a;
      outline:none;
      transition:.15s ease;
    }

    #screen-create-account .text-input:focus,
    #screen-create-account .select-input:focus,
    #screen-create-account .search-input-ca:focus{
      border-color:var(--blue);
      box-shadow:0 0 0 3px rgba(37,99,235,.12);
    }

    #screen-create-account .field-help{
      font-size:11px;
      color:var(--muted);
      line-height:1.45;
    }

    #screen-create-account .btn-row{
      display:flex;
      gap:10px;
      margin-top:4px;
      flex-wrap:wrap;
    }

    #screen-create-account .primary-btn,
    #screen-create-account .secondary-btn,
    #screen-create-account .mini-btn{
      border:none;
      cursor:pointer;
      font-weight:800;
      transition:.15s ease;
    }

    #screen-create-account .primary-btn{
      flex:1;
      min-width:180px;
      height:48px;
      border-radius:14px;
      color:#fff;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      box-shadow:0 14px 35px rgba(37,99,235,.28);
    }

    #screen-create-account .primary-btn:hover{
      opacity:.96;
    }

    #screen-create-account .primary-btn:disabled{
      opacity:.7;
      cursor:not-allowed;
      box-shadow:none;
    }

    #screen-create-account .secondary-btn{
      min-width:150px;
      height:48px;
      padding:0 16px;
      border-radius:14px;
      color:#223754;
      background:#fff;
      border:1px solid var(--line);
    }

    #screen-create-account .secondary-btn:hover,
    #screen-create-account .mini-btn:hover{
      background:#f8fafc;
    }

    #screen-create-account .message{
      margin-top:12px;
      padding:12px 14px;
      border-radius:14px;
      font-size:13px;
      font-weight:700;
      line-height:1.5;
      display:none;
    }

    #screen-create-account .message.error{
      color:#dc2626;
      background:#fef2f2;
      border:1px solid #fecaca;
    }

    #screen-create-account .message.success{
      color:#15803d;
      background:#f0fdf4;
      border:1px solid #bbf7d0;
    }

    #screen-create-account .result-box{
      border:1px solid var(--line);
      background:#fff;
      border-radius:18px;
      padding:16px;
      display:none;
      margin-bottom:14px;
    }

    #screen-create-account .result-title{
      font-size:14px;
      font-weight:800;
      color:#13253d;
      margin-bottom:10px;
    }

    #screen-create-account .result-row{
      display:flex;
      justify-content:space-between;
      gap:12px;
      padding:10px 0;
      border-top:1px solid #eef2f7;
    }

    #screen-create-account .result-row:first-of-type{
      border-top:none;
      padding-top:0;
    }

    #screen-create-account .result-key{
      font-size:12px;
      color:var(--muted);
      font-weight:700;
    }

    #screen-create-account .result-value{
      font-size:13px;
      color:#0f172a;
      font-weight:800;
      text-align:right;
      word-break:break-word;
    }

    #screen-create-account .mini-row{
      display:flex;
      gap:8px;
      margin-top:12px;
      flex-wrap:wrap;
    }

    #screen-create-account .mini-btn{
      flex:1;
      min-width:140px;
      height:40px;
      border-radius:12px;
      background:#fff;
      color:#1e3a8a;
      border:1px solid var(--line);
    }

    #screen-create-account .helper-box{
      border:1px solid var(--line);
      background:#f8fbff;
      border-radius:18px;
      padding:16px;
    }

    #screen-create-account .helper-title{
      font-size:14px;
      font-weight:800;
      color:#13253d;
      margin-bottom:6px;
    }

    #screen-create-account .helper-text{
      font-size:12px;
      color:var(--muted);
      line-height:1.6;
    }

    #screen-create-account .list-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      box-shadow:var(--shadow);
      padding:18px;
    }

    #screen-create-account .toolbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      margin-bottom:12px;
    }

    #screen-create-account .chip-wrap{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    #screen-create-account .stat-chip{
      display:inline-flex;
      align-items:center;
      height:34px;
      padding:0 12px;
      border-radius:999px;
      background:#fff;
      border:1px solid var(--line);
      font-size:12px;
      font-weight:800;
      color:#334155;
    }

    #screen-create-account .table-wrap-ca{
      overflow:auto;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
    }

    #screen-create-account table{
      width:100%;
      border-collapse:collapse;
      min-width:860px;
    }

    #screen-create-account th,
    #screen-create-account td{
      text-align:left;
      padding:14px;
      border-bottom:1px solid #eef2f7;
      font-size:13px;
      vertical-align:top;
    }

    #screen-create-account th{
      background:#f8fafc;
      color:#64748b;
      font-weight:800;
      position:sticky;
      top:0;
      z-index:1;
    }

    #screen-create-account td{
      color:#0f172a;
      font-weight:600;
    }

    #screen-create-account tr:last-child td{
      border-bottom:none;
    }

    #screen-create-account .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:78px;
      height:28px;
      padding:0 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:800;
      white-space:nowrap;
    }

    #screen-create-account .pill.type{
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-create-account .pill.status{
      background:#ecfdf5;
      color:#15803d;
    }

    #screen-create-account .empty-box{
      padding:26px 16px;
      text-align:center;
      color:#64748b;
      font-size:13px;
      font-weight:700;
    }

    @media (max-width: 1400px){
      .stats-grid{
        grid-template-columns:repeat(3, minmax(0,1fr));
      }
    }

    @media (max-width: 1180px){
      .dashboard-grid{
        grid-template-columns:1fr;
      }

      .quick-grid{
        grid-template-columns:repeat(2, minmax(0,1fr));
      }

      #screen-create-account .create-layout{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 900px){
      body{
        overflow:auto;
      }

      .app{
        flex-direction:column;
      }

      .sidebar{
        width:100%;
      }

      .topbar{
        flex-direction:column;
        align-items:flex-start;
        gap:12px;
        height:auto;
        padding:18px;
      }

      .topbar-right{
        width:100%;
        flex-wrap:wrap;
      }

      .search{
        width:100%;
      }

      .stats-grid,
      .quick-grid{
        grid-template-columns:1fr;
      }

      #screen-create-account .field-grid{
        grid-template-columns:1fr;
      }

      #screen-create-account .create-main-title{
        font-size:24px;
      }
    }
  </style>
</head>
<body>
  <div class="app">

    <aside class="sidebar">
      <div class="brand">
        <div class="brand-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 8.5 12 4l10 4.5-10 4.5L2 8.5Z"/>
            <path d="M6 10.3V15c0 1.6 3 3 6 3s6-1.4 6-3v-4.7"/>
            <path d="M22 9v6"/>
          </svg>
        </div>
        <div class="brand-name">HOS</div>
      </div>

      <nav class="sidebar-nav">
        <button class="nav-btn active" data-screen="dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M3 11.5 12 4l9 7.5"/>
            <path d="M5 10.5V20h14v-9.5"/>
            <path d="M9 20v-5h6v5"/>
          </svg>
          <span>Dashboard</span>
        </button>

        <button class="nav-btn" data-screen="create-account">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
            <path d="M5 20a7 7 0 0 1 14 0"/>
            <path d="M18.5 8.5h5"/>
            <path d="M21 6v5"/>
          </svg>
          <span>Create Account</span>
        </button>

        <button class="nav-btn" data-screen="staff-roles">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
            <path d="M17 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
            <path d="M2.5 19a5.5 5.5 0 0 1 11 0"/>
            <path d="M14 19a4.5 4.5 0 0 1 8 0"/>
          </svg>
          <span>Staff &amp; Roles</span>
        </button>

        <button class="nav-btn" data-screen="announcements">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M4 14V10l11-4v12L4 14Z"/>
            <path d="M15 8h2a3 3 0 0 1 0 6h-2"/>
            <path d="M6 14.5 7.5 20h3l-1.2-4.2"/>
          </svg>
          <span>Announcements</span>
        </button>

        <button class="nav-btn" data-screen="reports">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M7 3h7l5 5v13H7z"/>
            <path d="M14 3v5h5"/>
            <path d="M10 13h6"/>
            <path d="M10 17h6"/>
          </svg>
          <span>Reports</span>
        </button>

        <button class="nav-btn" data-screen="forms">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M8 6h13"/>
            <path d="M8 12h13"/>
            <path d="M8 18h13"/>
            <path d="M3.5 6h.01"/>
            <path d="M3.5 12h.01"/>
            <path d="M3.5 18h.01"/>
          </svg>
          <span>Forms</span>
        </button>

        <button class="nav-btn" data-screen="history">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <path d="M3 4v5h5"/>
            <path d="M12 7v6l4 2"/>
          </svg>
          <span>History</span>
        </button>

        <button class="nav-btn" data-screen="settings">
