  <script>
    (() => {
      const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
      const SUPABASE_ANON_KEY =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0bHJmdWpmaW14Y21zbnFybmlnIiwicm9sZSI6ImFub24iLCJ9";

      let sb = null;
      let adminSession = null;
      let currentHosScreen = "dashboard";

      const pageMeta = {
        "dashboard": {
          title: "HOS Dashboard",
          sub: "Control the school system from one clean page."
        },
        "create-account": {
          title: "Create Account",
          sub: "Create HOD and agent accounts from one place."
        },
        "staff-roles": {
          title: "Staff & Roles",
          sub: "Manage created HODs and agents."
        },
        "announcements": {
          title: "Announcements",
          sub: "Send and monitor school announcements."
        },
        "reports": {
          title: "Reports",
          sub: "Manage report-related work and agents."
        },
        "forms": {
          title: "Forms",
          sub: "Manage forms and form agents."
        },
        "history": {
          title: "History",
          sub: "See actions performed in the system."
        },
        "settings": {
          title: "Settings",
          sub: "Configure school and system settings."
        }
      };

      function $(id){
        return document.getElementById(id);
      }

      function initSupabase(){
        try{
          if (window.supabase && typeof window.supabase.createClient === "function") {
            sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
          }
        }catch(err){
          console.error("Supabase init failed:", err);
        }
      }

      function getAdminSession(){
        try{
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        }catch{
          return null;
        }
      }

      function showMessage(text, type){
        const box = $("pageMessageBox");
        if (!text){
          box.textContent = "";
          box.className = "message";
          return;
        }
        box.textContent = text;
        box.className = "message " + (type || "error");
      }

      function escapeHtml(value){
        return String(value || "")
          .replaceAll("&","&amp;")
          .replaceAll("<","&lt;")
          .replaceAll(">","&gt;")
          .replaceAll('"',"&quot;")
          .replaceAll("'","&#39;");
      }

      function getDisplayNameFromSession(session){
        return (
          (session && session.full_name && String(session.full_name).trim()) ||
          (session && session.name && String(session.name).trim()) ||
          (session && session.email && String(session.email).trim()) ||
          "HOS"
        );
      }

      function getSchoolNameFromSession(session){
        return (
          (session && session.school_name && String(session.school_name).trim()) ||
          (session && session.school && String(session.school).trim()) ||
          (session && session.schoolName && String(session.schoolName).trim()) ||
          "School"
        );
      }

      function requireHosSession(){
        adminSession = getAdminSession();

        if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
          window.location.href = "index.html";
          return false;
        }

        const hosName = getDisplayNameFromSession(adminSession);
        const schoolName = getSchoolNameFromSession(adminSession);
        const firstLetter = hosName.charAt(0).toUpperCase() || "H";

        $("welcomeHosName").textContent = hosName;
        $("sidebarSchoolName").textContent = schoolName;
        $("topSchoolName").textContent = schoolName;
        $("avatarChip").textContent = firstLetter;
        $("topHosLabel").textContent = "Head of School";

        return true;
      }

      function updateTopbar(screenName){
        const meta = pageMeta[screenName] || pageMeta.dashboard;
        $("topPageTitle").textContent = meta.title;
        $("topPageSub").textContent = meta.sub;
      }

      function setActiveNav(screenName){
        document.querySelectorAll(".nav-btn[data-screen]").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.screen === screenName);
        });
      }

      function setActiveScreen(screenName){
        document.querySelectorAll(".screen").forEach((screen) => {
          screen.classList.remove("active");
        });

        const target = $("screen-" + screenName);
        if (target){
          target.classList.add("active");
        }

        currentHosScreen = screenName;
        setActiveNav(screenName);
        updateTopbar(screenName);

        const scroller = document.querySelector(".content-scroll");
        if (scroller) scroller.scrollTop = 0;
      }

      window.showHosScreen = function(screenName){
        setActiveScreen(screenName);
      };

      function bindSidebar(){
        document.querySelectorAll(".nav-btn[data-screen]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const screenName = btn.dataset.screen || "dashboard";
            setActiveScreen(screenName);
          });
        });
      }

      function bindHeaderActions(){
        $("avatarChip").addEventListener("click", () => {
          showMessage("Avatar action is ready. Connect this to your HOS account page later.", "success");
          setTimeout(() => showMessage(""), 2200);
        });
      }

      function loadDashboardFromLocal(){
        try{
          const statsRaw = localStorage.getItem("colspot_hos_dashboard_preview");
          if (!statsRaw) return;

          const stats = JSON.parse(statsRaw);

          if ($("totalHods") && stats.total_hods != null) $("totalHods").textContent = String(stats.total_hods);
          if ($("totalAgents") && stats.total_agents != null) $("totalAgents").textContent = String(stats.total_agents);
          if ($("activeForms") && stats.active_forms != null) $("activeForms").textContent = String(stats.active_forms);
          if ($("totalAnnouncements") && stats.total_announcements != null) $("totalAnnouncements").textContent = String(stats.total_announcements);
          if ($("totalReports") && stats.total_reports != null) $("totalReports").textContent = String(stats.total_reports);
          if ($("pendingActions") && stats.pending_actions != null) $("pendingActions").textContent = String(stats.pending_actions);
        }catch(err){
          console.error("Failed to load preview dashboard stats:", err);
        }
      }

      function loadHistoryPreviewFromLocal(){
        try{
          const raw = localStorage.getItem("colspot_hos_history_preview");
          if (!raw) return;

          const items = JSON.parse(raw);
          if (!Array.isArray(items) || !items.length) return;

          const list = $("dashboardHistoryList");
          list.innerHTML = items.slice(0, 4).map((item, index) => {
            const colorClass = index % 4 === 0
              ? "green"
              : index % 4 === 1
              ? "orange"
              : index % 4 === 2
              ? "red"
              : "blue";

            return `
              <div class="history-row">
                <div class="history-main">
                  <div class="history-icon ${colorClass}">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div>
                    <div class="history-title">${escapeHtml(item.title || "System activity")}</div>
                    <div class="history-desc">${escapeHtml(item.description || "Recent action in the HOS dashboard.")}</div>
                  </div>
                </div>
                <div class="history-time">${escapeHtml(item.time || "-")}</div>
              </div>
            `;
          }).join("");
        }catch(err){
          console.error("Failed to load preview history:", err);
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        initSupabase();

        if (!requireHosSession()) return;

        bindSidebar();
        bindHeaderActions();
        loadDashboardFromLocal();
        loadHistoryPreviewFromLocal();
        setActiveScreen("dashboard");
      });
    })();
  </script>
