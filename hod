<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOD Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#eef4ff;
      --blue-soft-2:#f8fbff;
      --card:#ffffff;
      --line:#e7edf5;
      --text:#0f172a;
      --muted:#6b7280;
      --success:#166534;
      --success-bg:#ecfdf5;
      --error:#991b1b;
      --error-bg:#fef2f2;
      --shadow:0 16px 34px rgba(15,23,42,.08);
      --shadow-soft:0 12px 28px rgba(37,99,235,.10);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:18px;
      --radius-sm:14px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:
        radial-gradient(circle at top, #dfeeff 0%, #f6faff 48%, #ffffff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
      -webkit-text-size-adjust:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:
        calc(env(safe-area-inset-top) + 12px)
        14px
        calc(env(safe-area-inset-bottom) + 108px);
      position:relative;
      overflow-x:hidden;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:14px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:40px;
      height:40px;
      border-radius:14px;
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex-shrink:0;
    }

    .brand-logo img{
      width:32px;
      height:32px;
      object-fit:contain;
      display:block;
    }

    .brand-name{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.03em;
      color:#10224a;
      white-space:nowrap;
    }

    .profile-link{
      width:46px;
      height:46px;
      border-radius:999px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-decoration:none;
      color:#fff;
      font-size:17px;
      font-weight:900;
      background:linear-gradient(135deg,#2563eb 0%, #22c55e 100%);
      box-shadow:0 16px 28px rgba(37,99,235,.18);
      border:none;
      cursor:pointer;
      flex-shrink:0;
    }

    .hero{
      margin:4px 2px 16px;
      padding:22px 18px;
      border-radius:var(--radius-xl);
      background:linear-gradient(135deg,var(--blue),#3b82f6);
      color:#fff;
      position:relative;
      overflow:hidden;
      box-shadow:0 24px 44px rgba(37,99,235,.22);
    }

    .hero::before{
      content:"";
      position:absolute;
      right:-34px;
      top:-26px;
      width:150px;
      height:150px;
      border-radius:50%;
      background:rgba(255,255,255,.10);
    }

    .hero::after{
      content:"";
      position:absolute;
      right:-18px;
      bottom:-34px;
      width:190px;
      height:96px;
      border-radius:50%;
      background:rgba(255,255,255,.08);
      transform:rotate(-18deg);
    }

    .hero-line{
      font-size:13px;
      font-weight:800;
      opacity:.95;
      margin-bottom:6px;
      position:relative;
      z-index:1;
      word-break:break-word;
    }

    .hero-title{
      margin:0;
      font-size:30px;
      line-height:1.05;
      letter-spacing:-.05em;
      font-weight:900;
      position:relative;
      z-index:1;
      max-width:260px;
    }

    .hero-sub{
      margin-top:8px;
      font-size:13px;
      line-height:1.5;
      opacity:.96;
      position:relative;
      z-index:1;
      max-width:260px;
    }

    .message{
      display:none;
      margin:0 2px 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--error-bg);
      border:1px solid #fecaca;
      color:var(--error);
    }

    .message.success{
      background:var(--success-bg);
      border:1px solid #bbf7d0;
      color:var(--success);
    }

    .screen{
      display:none;
    }

    .screen.active{
      display:block;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin:0 2px 16px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:20px;
      padding:16px 14px;
      box-shadow:var(--shadow-soft);
      position:relative;
      overflow:hidden;
    }

    .stat-card::after{
      content:"";
      position:absolute;
      right:-16px;
      bottom:-18px;
      width:74px;
      height:74px;
      border-radius:50%;
      background:var(--blue-soft);
    }

    .stat-label{
      position:relative;
      z-index:1;
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
      margin-bottom:10px;
    }

    .stat-value{
      position:relative;
      z-index:1;
      font-size:30px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.05em;
      color:#0f172a;
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:0 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:16px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#111c37;
    }

    .view-all-btn{
      border:none;
      background:var(--blue-soft);
      color:var(--blue);
      padding:10px 12px;
      border-radius:12px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .quick-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin:0 2px 18px;
    }

    .quick-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      padding:16px 14px;
      box-shadow:var(--shadow-soft);
      cursor:pointer;
      text-align:left;
      min-height:120px;
    }

    .quick-icon{
      width:44px;
      height:44px;
      border-radius:14px;
      background:var(--blue-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      color:var(--blue);
      margin-bottom:12px;
    }

    .quick-icon svg{
      width:20px;
      height:20px;
    }

    .quick-title{
      font-size:16px;
      line-height:1.2;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
      margin-bottom:4px;
    }

    .quick-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:var(--shadow);
      padding:14px;
      margin:0 2px 16px;
    }

    .field{
      margin-bottom:12px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:800;
      color:#334155;
      margin-bottom:6px;
    }

    .input,.textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:15px;
      padding:13px 14px;
      background:#fff;
      font-size:14px;
      color:var(--text);
      outline:none;
      transition:.18s ease;
    }

    .input:focus,.textarea:focus{
      border-color:#93c5fd;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    .textarea{
      min-height:120px;
      resize:vertical;
      line-height:1.5;
    }

    .btn-row{
      display:flex;
      gap:10px;
      margin-top:12px;
    }

    .mini-btn{
      flex:1;
      border:none;
      border-radius:999px;
      padding:13px 14px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
    }

    .mini-btn.primary{
      color:#fff;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      box-shadow:0 16px 28px rgba(37,99,235,.20);
    }

    .mini-btn.secondary{
      color:var(--text);
      background:#fff;
      border:1px solid var(--line);
    }

    .mini-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .list-wrap{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .student-item,
    .history-item{
      display:flex;
      align-items:flex-start;
      gap:12px;
      padding:12px;
      border-radius:18px;
      background:#fff;
      border:1px solid #edf2f7;
    }

    .item-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#eef4ff;
      color:#255fe9;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .item-icon svg{
      width:20px;
      height:20px;
    }

    .item-content{
      flex:1;
      min-width:0;
    }

    .item-title{
      margin:0;
      font-size:15px;
      line-height:1.25;
      font-weight:800;
      letter-spacing:-.02em;
      color:#111c37;
    }

    .item-sub{
      margin:4px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
      word-break:break-word;
    }

    .item-time{
      flex-shrink:0;
      font-size:12px;
      color:#7a8494;
      font-weight:700;
      white-space:nowrap;
      margin-left:8px;
    }

    .history-tag{
      margin-top:8px;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border-radius:999px;
      padding:6px 10px;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:#eff6ff;
      color:var(--blue);
    }

    .empty{
      padding:16px 8px;
      text-align:center;
      font-size:13px;
      color:var(--muted);
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 24px);
      max-width:396px;
      background:rgba(255,255,255,.98);
      border:1px solid #e7edf5;
      border-radius:31px;
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      padding:10px 8px 12px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:2px;
      z-index:50;
      backdrop-filter:blur(14px);
      -webkit-backdrop-filter:blur(14px);
    }

    .nav-btn{
      color:#9aa3b2;
      text-decoration:none;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:4px;
      min-height:64px;
      border-radius:18px;
      padding:4px 2px;
      cursor:pointer;
      border:none;
      background:transparent;
    }

    .nav-btn svg{
      width:22px;
      height:22px;
    }

    .nav-btn span{
      font-size:11px;
      font-weight:700;
      letter-spacing:-.01em;
      text-align:center;
      line-height:1.2;
    }

    .nav-btn.active{
      color:#2563eb;
    }

    @media (max-width:360px){
      .hero-title{
        font-size:27px;
      }

      .quick-grid{
        grid-template-columns:1fr;
      }

      .btn-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="profile-link" id="profileLink" type="button">H</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-line" id="departmentNameText">Hello, Department</div>
        <h1 class="hero-title">HOD Dashboard</h1>
        <div class="hero-sub">
          Manage your department overview, announcements, students, and recent activity.
        </div>
      </section>

      <div class="message" id="pageMessageBox"></div>
      <div class="message" id="announcementMessageBox"></div>
      <div class="message" id="studentMessageBox"></div>

      <section class="screen active" id="screen-home">
        <section class="stats-grid">
          <article class="stat-card">
            <div class="stat-label">Students</div>
            <div class="stat-value" id="studentCount">0</div>
          </article>

          <article class="stat-card">
            <div class="stat-label">Announcements</div>
            <div class="stat-value" id="announcementCount">0</div>
          </article>
        </section>

        <div class="section-head">
          <h2 class="section-title">Quick Links</h2>
        </div>

        <section class="quick-grid">
          <button class="quick-card" type="button" id="goAnnouncementFromHome">
            <div class="quick-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path>
              </svg>
            </div>
            <div class="quick-title">Create announcement</div>
            <div class="quick-sub">Send an update to your department quickly.</div>
          </button>

          <button class="quick-card" type="button" id="goStudentsFromHome">
            <div class="quick-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
              </svg>
            </div>
            <div class="quick-title">View students</div>
            <div class="quick-sub">Search and view students in your department.</div>
          </button>
        </section>

        <div class="section-head">
          <h2 class="section-title">Recent history</h2>
          <button class="view-all-btn" id="viewAllHistoryBtn" type="button">View all</button>
        </div>

        <section class="card">
          <div class="list-wrap" id="homeHistoryList">
            <div class="empty">Loading recent history...</div>
          </div>
        </section>
      </section>

      <section class="screen" id="screen-announcements">
        <div class="section-head">
          <h2 class="section-title">Create announcement</h2>
        </div>

        <section class="card">
          <div class="field">
            <label for="announcementTitle">Title</label>
            <input id="announcementTitle" class="input" placeholder="Enter announcement title">
          </div>

          <div class="field">
            <label for="announcementBody">Message</label>
            <textarea id="announcementBody" class="textarea" placeholder="Write your department announcement here..."></textarea>
          </div>

          <div class="btn-row">
            <button class="mini-btn primary" id="sendAnnouncementBtn" type="button">Send announcement</button>
            <button class="mini-btn secondary" id="clearAnnouncementBtn" type="button">Clear</button>
          </div>
        </section>
      </section>

      <section class="screen" id="screen-students">
        <div class="section-head">
          <h2 class="section-title">Students</h2>
        </div>

        <section class="card">
          <div class="field">
            <label for="studentSearchInput">Matric number or student name</label>
            <input id="studentSearchInput" class="input" placeholder="Enter matric number or full name">
          </div>

          <div class="btn-row">
            <button class="mini-btn primary" id="searchStudentBtn" type="button">Search</button>
            <button class="mini-btn secondary" id="clearStudentBtn" type="button">Clear</button>
          </div>
        </section>

        <section class="card">
          <div class="list-wrap" id="studentList">
            <div class="empty">Loading students...</div>
          </div>
        </section>
      </section>

      <section class="screen" id="screen-history">
        <div class="section-head">
          <h2 class="section-title">All history</h2>
        </div>

        <section class="card">
          <div class="list-wrap" id="historyList">
            <div class="empty">Loading history...</div>
          </div>
        </section>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button" id="navHomeBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 10.5 12 3l9 7.5"></path>
        <path d="M5 9.5V21h14V9.5"></path>
      </svg>
      <span>Dashboard</span>
    </button>

    <button class="nav-btn" type="button" id="navAnnouncementsBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path>
      </svg>
      <span>Announcements</span>
    </button>

    <button class="nav-btn" type="button" id="navStudentsBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
      </svg>
      <span>Students</span>
    </button>

    <button class="nav-btn" type="button" id="navHistoryBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 6v6l3 3"></path>
        <path d="M5 12a7 7 0 111.75 4.6"></path>
        <path d="M5 8v4h4"></path>
      </svg>
      <span>History</span>
    </button>
  </nav>

<script>
  (() => {
    const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    const SUPABASE_ANON_KEY =
      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0bHJmdWpmaW14Y21zbnFybmlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njg1MzUzMTIsImV4cCI6MjA4NDExMTMxMn0.TksqfAitZ5Lbx9pa8fU76Qcl4iMsPGcfom-rC8rTf3Y";

    const EDGE = {
      getHistory: "get-hos-history"
    };

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let adminSession = null;
    let currentSchoolName = "";
    let currentHistory = [];

    function $(id){
      return document.getElementById(id);
    }

    function escapeHtml(value){
      return String(value || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#39;");
    }

    function formatDate(value){
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function getAdminSession(){
      try{
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      }catch{
        return null;
      }
    }

    function showMessage(id, text){
      const box = $(id);
      if (!text){
        box.textContent = "";
        box.className = "message";
        return;
      }
      box.textContent = text;
      box.className = "message error";
    }

    async function invokeEdge(functionName, body){
      const { data, error } = await sb.functions.invoke(functionName, {
        body: body || {}
      });

      if (error){
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      return data || {};
    }

    function requireHosSession(){
      adminSession = getAdminSession();

      if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
        window.location.href = "index.html";
        return false;
      }

      currentSchoolName =
        adminSession.school_name ||
        adminSession.school ||
        adminSession.schoolName ||
        "";

      $("schoolNameText").textContent = currentSchoolName || "School";
      $("avatarChip").textContent =
        ((adminSession.full_name || "H").trim().charAt(0).toUpperCase() || "H");

      return true;
    }

    async function loadHistory(){
      showMessage("pageMessage", "");
      $("historyList").innerHTML = '<div class="empty">Loading history...</div>';
      $("historyCountText").textContent = "0 items";

      try{
        const type = $("typeFilter").value || "all";
        const search = ($("searchInput").value || "").trim();

        const result = await invokeEdge(EDGE.getHistory, {
          hos_admin_id: adminSession.id,
          type,
          search
        });

        if (!result.ok){
          throw new Error(result.error || "Could not load history.");
        }

        currentHistory = Array.isArray(result.history) ? result.history : [];
        renderHistory();
      }catch(err){
        console.error("loadHistory error:", err);
        currentHistory = [];
        renderHistory();
        showMessage("pageMessage", err.message || "Could not load history.");
      }
    }

    function renderHistory(){
      const wrap = $("historyList");
      const items = currentHistory || [];

      $("historyCountText").textContent =
        `${items.length} item${items.length === 1 ? "" : "s"}`;

      if (!items.length){
        wrap.innerHTML = '<div class="empty">No history found.</div>';
        return;
      }

      wrap.innerHTML = items.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.title || "-")}</div>
              <div class="history-sub">${escapeHtml(item.description || "-")}</div>
            </div>
            <div class="pill">${escapeHtml(item.type || "Item")}</div>
          </div>

          <div class="history-meta">
            <div class="pill">Created: ${escapeHtml(formatDate(item.created_at))}</div>
          </div>
        </div>
      `).join("");
    }

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireHosSession()) return;

      $("avatarChip").addEventListener("click", () => {
        window.location.href = "hos_account.html";
      });

      $("backBtn").addEventListener("click", () => {
        window.history.back();
      });

      let searchTimer = null;
      $("searchInput").addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(loadHistory, 250);
      });

      $("typeFilter").addEventListener("change", loadHistory);

      await loadHistory();
    });
  })();
</script>
</body>
</html>
