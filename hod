<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOD Profile</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#f4f7fb;
      --card:#f9fafb;
      --white:#ffffff;
      --line:#e5e7eb;
      --text-main:#111827;
      --text-muted:#6b7280;
      --blue:#2563eb;
      --blue-soft:#e0ecff;
      --blue-soft-border:#d1ddff;
      --red:#b91c1c;
      --red-bg:#fef2f2;
      --red-border:#fecaca;
      --green:#15803d;
      --green-bg:#ecfdf5;
      --green-border:#bbf7d0;
      --shadow:0 14px 36px rgba(15,23,42,.08);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      background:var(--bg);
      color:var(--text-main);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      min-height:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:16px 14px 32px;
    }

    .account-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:4px 2px 10px;
    }

    .account-header-left{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:12px;
      background:linear-gradient(135deg,#60a5fa,#2563eb);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:22px;
      font-weight:800;
      flex-shrink:0;
      box-shadow:0 12px 22px rgba(37,99,235,.24);
    }

    .account-title{
      font-size:18px;
      font-weight:800;
      color:var(--text-main);
    }

    .account-sub{
      font-size:12px;
      color:var(--text-muted);
    }

    .account-header-actions{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .account-header-pill{
      padding:8px 16px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
    }

    .profile-card{
      background:var(--card);
      border-radius:24px;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      padding:18px 16px 18px;
      margin-bottom:14px;
    }

    .profile-top{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:10px;
      margin-bottom:10px;
    }

    .avatar-circle{
      width:92px;
      height:92px;
      border-radius:999px;
      background:radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      display:flex;
      align-items:center;
      justify-content:center;
      color:white;
      font-size:40px;
      font-weight:800;
      overflow:hidden;
      position:relative;
    }

    .profile-name{
      font-size:20px;
      font-weight:800;
      color:var(--text-main);
    }

    .profile-role{
      font-size:13px;
      color:var(--text-muted);
      margin-top:-4px;
    }

    .profile-email-line{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      font-size:13px;
      color:var(--text-muted);
      flex-wrap:wrap;
      text-align:center;
    }

    .profile-email-line svg{
      width:14px;
      height:14px;
      stroke:#6b7280;
      stroke-width:1.7;
      fill:none;
    }

    .role-pill{
      margin-top:6px;
      padding:5px 14px;
      border-radius:999px;
      background:#e5edff;
      color:#1e40af;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
    }

    .status-pill{
      margin-top:4px;
      padding:6px 14px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:1px solid var(--green-border);
      background:var(--green-bg);
      color:var(--green);
    }

    .status-pill.off{
      border-color:var(--red-border);
      background:var(--red-bg);
      color:var(--red);
    }

    .status-dot{
      width:8px;
      height:8px;
      border-radius:999px;
      background:currentColor;
    }

    .profile-detail-card{
      margin-top:12px;
      border-radius:20px;
      border:1px solid var(--line);
      background:var(--white);
      padding:4px 0;
    }

    .detail-row{
      padding:11px 14px;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .detail-row + .detail-row{
      border-top:1px solid var(--line);
    }

    .detail-icon{
      width:30px;
      height:30px;
      border-radius:999px;
      background:#eef2ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .detail-icon svg{
      width:16px;
      height:16px;
      stroke-width:1.7;
      stroke:#4f46e5;
      fill:none;
    }

    .detail-text{
      flex:1;
      min-width:0;
    }

    .detail-label{
      font-size:12px;
      color:var(--text-muted);
    }

    .detail-value{
      font-size:14px;
      color:var(--text-main);
      font-weight:600;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .section-heading{
      font-size:13px;
      font-weight:700;
      color:var(--text-muted);
      margin:10px 4px 6px;
    }

    .actions-row{
      display:flex;
      gap:8px;
      margin-bottom:8px;
    }

    .action-btn{
      flex:1;
      padding:11px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      cursor:pointer;
    }

    .action-btn svg{
      width:16px;
      height:16px;
      stroke-width:1.8;
      stroke:currentColor;
      fill:none;
    }

    .action-btn.primary{
      background:var(--blue-soft);
      border-color:var(--blue-soft-border);
      color:#1d4ed8;
    }

    .action-btn.danger{
      background:var(--red-bg);
      border-color:var(--red-border);
      color:var(--red);
    }

    .status-text{
      font-size:12px;
      margin:0 4px 8px;
      min-height:16px;
    }

    .status-text.success{ color:#16a34a; }
    .status-text.error{ color:#dc2626; }

    .device-card{
      margin-top:4px;
      margin-bottom:10px;
      border-radius:20px;
      border:1px solid var(--line);
      background:#fff;
      padding:12px 14px 10px;
    }

    .device-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-bottom:6px;
    }

    .device-title{
      font-size:13px;
      font-weight:700;
      color:var(--text-main);
    }

    .device-sub{
      font-size:11px;
      color:var(--text-muted);
      margin-top:2px;
    }

    .device-count-badge{
      padding:3px 10px;
      border-radius:999px;
      background:#eff6ff;
      border:1px solid #dbeafe;
      font-size:11px;
      color:#1d4ed8;
      font-weight:700;
      white-space:nowrap;
    }

    .device-list{
      margin-top:6px;
    }

    .device-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      padding:8px 0;
    }

    .device-row + .device-row{
      border-top:1px solid #f3f4f6;
    }

    .device-main{
      display:flex;
      align-items:center;
      gap:8px;
      min-width:0;
    }

    .device-icon{
      width:30px;
      height:30px;
      border-radius:999px;
      background:#eef2ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .device-icon svg{
      width:16px;
      height:16px;
      stroke-width:1.7;
      stroke:#4f46e5;
      fill:none;
    }

    .device-name{
      font-size:13px;
      font-weight:600;
      color:var(--text-main);
    }

    .device-meta{
      font-size:11px;
      color:var(--text-muted);
    }

    .device-tags{
      display:flex;
      flex-wrap:wrap;
      gap:4px;
      margin-top:2px;
    }

    .device-pill{
      padding:2px 8px;
      border-radius:999px;
      font-size:10px;
      border:1px solid #d1d5db;
      color:#4b5563;
      background:#f9fafb;
    }

    .device-pill.primary{
      border-color:#bbf7d0;
      background:#ecfdf5;
      color:#15803d;
    }

    .device-remove-btn{
      border-radius:999px;
      border:1px solid #fee2e2;
      background:#fff7ed;
      padding:4px 8px;
      font-size:11px;
      color:#b91c1c;
      cursor:pointer;
      white-space:nowrap;
    }

    @media (max-width:360px){
      .actions-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="account-header">
      <div class="account-header-left">
        <div class="brand-logo">C</div>
        <div>
          <div class="account-title">Colspot</div>
          <div class="account-sub">HOD account profile.</div>
        </div>
      </div>

      <div class="account-header-actions">
        <button class="account-header-pill" id="backBtn" type="button">Back</button>
        <button class="account-header-pill" id="hodLogoutBtn" type="button">Logout</button>
      </div>
    </div>

    <section class="profile-card">
      <div class="profile-top">
        <div class="avatar-circle">
          <span id="hodAvatarInitial">H</span>
        </div>

        <div class="profile-name" id="hodName">Loading...</div>
        <div class="profile-role">Head of Department</div>

        <div class="profile-email-line">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
            <circle cx="12" cy="11" r="2.5"></circle>
          </svg>
          <span id="hodDepartmentTop">Department</span>
        </div>

        <div class="role-pill">HOD Account</div>

        <div class="status-pill" id="hodStatusPill">
          <span class="status-dot"></span>
          <span id="hodStatusText">Active</span>
        </div>
      </div>

      <div class="profile-detail-card">
        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 18c1-3 3-4.5 7-4.5s6 1.5 7 4.5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Full name</div>
            <div class="detail-value" id="hodFullNameValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="14" rx="2"></rect>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Login ID</div>
            <div class="detail-value" id="hodLoginIdValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Department</div>
            <div class="detail-value" id="hodDepartmentValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">School name</div>
            <div class="detail-value" id="hodSchoolValue">-</div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-heading">Account actions</div>
    <div class="actions-row">
      <button class="action-btn primary" id="hodResetBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M12 3a9 9 0 1 0 8.2 5.3"></path>
          <path d="M21 3v6h-6"></path>
        </svg>
        Reset login
      </button>

      <button class="action-btn danger" id="hodLogoutActionBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M15 3h4v18h-4"></path>
          <path d="M10 17l5-5-5-5"></path>
          <path d="M4 12h11"></path>
        </svg>
        Log out
      </button>
    </div>

    <p id="hodStatusMessage" class="status-text"></p>

    <div class="section-heading">Devices</div>
    <div class="device-card">
      <div class="device-header">
        <div>
          <div class="device-title">Linked phones</div>
          <div class="device-sub">This HOD can be signed in on linked devices.</div>
        </div>
        <span id="hodDevicesCountBadge" class="device-count-badge">0</span>
      </div>

      <div id="hodDevicesList" class="device-list"></div>
      <p id="hodDevicesStatus" class="status-text"></p>
    </div>
  </div>

  <script>
    (() => {
      const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
      const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
      const EDGE_BASE = `${SUPABASE_URL}/functions/v1`;

      const EDGE = {
        resetHodLogin: "reset-hod-login"
      };

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const DEVICE_STORAGE_KEY = "colspot_device_id";

      let hodSession = null;
      let hodData = null;

      function $(id) {
        return document.getElementById(id);
      }

      function getSession() {
        try {
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        } catch {
          return null;
        }
      }

      function showStatus(text = "", type = "") {
        const el = $("hodStatusMessage");
        if (!el) return;
        el.textContent = text;
        el.className = "status-text";
        if (type) el.classList.add(type);
      }

      function getDeviceId() {
        try {
          return localStorage.getItem(DEVICE_STORAGE_KEY) || null;
        } catch {
          return null;
        }
      }

      async function invokeEdge(name, payload = {}) {
        const res = await fetch(`${EDGE_BASE}/${name}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "apikey": SUPABASE_ANON_KEY,
            "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
          },
          body: JSON.stringify(payload)
        });

        const result = await res.json().catch(() => ({}));

        if (!res.ok || !result.ok) {
          throw new Error(result.error || `Edge function failed: ${name}`);
        }

        return result;
      }

      function renderHod(data) {
        hodData = data || {};

        const fullName = hodData.full_name || "HOD";
        const schoolName = hodData.school_name || "-";
        const loginId = hodData.login_id || "-";
        const departmentName = hodData.department_name || "-";
        const isActive = !!hodData.is_active;

        const initial = fullName.trim()[0] ? fullName.trim()[0].toUpperCase() : "H";

        $("hodAvatarInitial").textContent = initial;
        $("hodName").textContent = fullName;
        $("hodFullNameValue").textContent = fullName;
        $("hodDepartmentTop").textContent = departmentName;
        $("hodDepartmentValue").textContent = departmentName;
        $("hodSchoolValue").textContent = schoolName;
        $("hodLoginIdValue").textContent = loginId;
        $("hodStatusText").textContent = isActive ? "Active" : "Disabled";
        $("hodStatusPill").className = isActive ? "status-pill" : "status-pill off";
      }

      async function loadHodProfile() {
        hodSession = getSession();

        if (!hodSession || String(hodSession.role || "").toLowerCase() !== "hod") {
          window.location.href = "index.html";
          return;
        }

        try {
          const { data, error } = await sb
            .from("hod_accounts")
            .select("id, full_name, school_name, department_name, login_id, is_active, created_at")
            .eq("id", hodSession.id)
            .maybeSingle();

          if (error) throw error;
          if (!data) throw new Error("HOD account not found.");

          renderHod(data);
        } catch (e) {
          console.error("loadHodProfile error:", e);
          showStatus("Could not load HOD account.", "error");
        }
      }

      async function loadHodDevices() {
        const list = $("hodDevicesList");
        const statusEl = $("hodDevicesStatus");
        const badge = $("hodDevicesCountBadge");

        if (!hodSession || !list || !statusEl || !badge) return;

        list.innerHTML = "";
        statusEl.textContent = "Loading devices...";

        try {
          const { data, error } = await sb
            .from("user_devices")
            .select("id, device_id, created_at")
            .eq("user_id", hodSession.id)
            .order("created_at", { ascending: true });

          if (error) throw error;

          const devices = data || [];
          badge.textContent = String(devices.length);

          if (!devices.length) {
            statusEl.textContent = "No linked devices yet.";
            return;
          }

          statusEl.textContent = "";
          const currentDeviceId = getDeviceId();

          devices.forEach((row) => {
            const isThis = currentDeviceId && row.device_id === currentDeviceId;

            const deviceRow = document.createElement("div");
            deviceRow.className = "device-row";

            deviceRow.innerHTML = `
              <div class="device-main">
                <div class="device-icon">
                  <svg viewBox="0 0 24 24">
                    <rect x="7" y="3" width="10" height="18" rx="2"></rect>
                    <circle cx="12" cy="17" r="1"></circle>
                  </svg>
                </div>
                <div>
                  <div class="device-name">${isThis ? "This phone" : "Linked device"}</div>
                  <div class="device-meta">${row.created_at ? new Date(row.created_at).toLocaleString() : "Linked device"}</div>
                  <div class="device-tags">
                    <span class="device-pill primary">${isThis ? "Active here" : "Signed in"}</span>
                  </div>
                </div>
              </div>
            `;
            list.appendChild(deviceRow);
          });
        } catch (e) {
          console.error("loadHodDevices error:", e);
          statusEl.textContent = "Could not load devices.";
        }
      }

      async function resetHodLogin() {
        if (!hodSession) return;

        showStatus("Resetting login...", "success");

        try {
          const result = await invokeEdge(EDGE.resetHodLogin, {
            hod_id: hodSession.id
          });

          const tempPassword = result?.temporary_password || "";
          showStatus(
            tempPassword
              ? `New temporary password: ${tempPassword}`
              : "Login reset successfully.",
            "success"
          );

          await loadHodProfile();
        } catch (e) {
          console.error("resetHodLogin error:", e);
          showStatus(e.message || "Could not reset login.", "error");
        }
      }

      function logout() {
        localStorage.removeItem("colspot_admin_session");
        localStorage.removeItem("colspot_pending_admin");
        window.location.href = "index.html";
      }

      document.addEventListener("DOMContentLoaded", async () => {
        $("backBtn").addEventListener("click", () => {
          window.location.href = "hod.html";
        });

        $("hodLogoutBtn").addEventListener("click", logout);
        $("hodLogoutActionBtn").addEventListener("click", logout);
        $("hodResetBtn").addEventListener("click", resetHodLogin);

        await loadHodProfile();
        await loadHodDevices();
      });
    })();
  </script>
</body>
</html>
