<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Agent Assistants</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#dbeafe;
      --blue-soft-2:#eff6ff;
      --purple:#5b5ce6;
      --purple-soft:#f3f0ff;
      --green:#16a34a;
      --green-soft:#ecfdf5;
      --orange:#ea580c;
      --orange-soft:#fff7ed;
      --red:#dc2626;
      --red-soft:#fef2f2;

      --text:#0f172a;
      --muted:#667085;
      --line:#e7edf7;
      --card:#ffffff;

      --shadow:0 18px 45px rgba(15,23,42,.08);
      --shadow-soft:0 10px 30px rgba(37,99,235,.10);

      --radius-xl:30px;
      --radius-lg:24px;
      --radius-md:18px;
      --radius-sm:14px;
      --nav-h:88px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:
        radial-gradient(860px 520px at 50% -8%, rgba(59,130,246,.20) 0%, rgba(59,130,246,0) 62%),
        radial-gradient(700px 420px at 0% 32%, rgba(191,219,254,.42) 0%, rgba(191,219,254,0) 68%),
        radial-gradient(700px 420px at 100% 34%, rgba(191,219,254,.34) 0%, rgba(191,219,254,0) 68%),
        linear-gradient(180deg,#f3f7ff 0%, #f8fbff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:
        calc(env(safe-area-inset-top) + 18px)
        16px
        calc(env(safe-area-inset-bottom) + var(--nav-h) + 24px);
      position:relative;
    }

    .glow{
      position:fixed;
      inset:auto -15% -10% -15%;
      height:36vh;
      pointer-events:none;
      z-index:0;
      background:
        radial-gradient(60% 100% at 50% 100%, rgba(255,255,255,.84) 0%, rgba(255,255,255,.32) 42%, rgba(255,255,255,0) 76%);
      filter:blur(8px);
    }

    .content{
      position:relative;
      z-index:1;
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:16px;
    }

    .brand{
      display:flex;
      align-items:flex-start;
      gap:12px;
      min-width:0;
    }

    .brand-logo{
      width:52px;
      height:52px;
      border-radius:18px;
      background:rgba(255,255,255,.88);
      border:1px solid rgba(255,255,255,.72);
      box-shadow:var(--shadow-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex-shrink:0;
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
    }

    .brand-logo img{
      width:42px;
      height:42px;
      object-fit:contain;
      display:block;
    }

    .brand-title{
      font-size:18px;
      font-weight:950;
      letter-spacing:-.03em;
      margin-top:2px;
      margin-bottom:2px;
      color:#10224a;
    }

    .brand-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .top-actions{
      position:relative;
      flex-shrink:0;
    }

    .avatar-btn{
      width:46px;
      height:46px;
      border:none;
      border-radius:999px;
      background:linear-gradient(135deg,#2563eb 0%, #10b981 100%);
      color:#fff;
      font-size:17px;
      font-weight:900;
      cursor:pointer;
      box-shadow:0 16px 34px rgba(37,99,235,.22);
    }

    .account-menu{
      position:absolute;
      top:54px;
      right:0;
      width:210px;
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.92);
      border-radius:20px;
      box-shadow:0 25px 50px rgba(15,23,42,.14);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      overflow:hidden;
      display:none;
      z-index:50;
    }

    .account-menu.show{
      display:block;
    }

    .menu-head{
      padding:14px 14px 12px;
      border-bottom:1px solid var(--line);
    }

    .menu-name{
      font-size:14px;
      font-weight:900;
      color:#111827;
      line-height:1.3;
    }

    .menu-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:4px;
      line-height:1.4;
    }

    .menu-btn{
      width:100%;
      border:none;
      background:#fff;
      text-align:left;
      padding:14px;
      font-size:13px;
      font-weight:800;
      color:#1f2937;
      cursor:pointer;
      border-bottom:1px solid var(--line);
    }

    .menu-btn:last-child{
      border-bottom:none;
    }

    .menu-btn.danger{
      color:#b91c1c;
    }

    .hero{
      background:
        linear-gradient(180deg, rgba(255,255,255,.94) 0%, rgba(255,255,255,.82) 100%);
      border:1px solid rgba(255,255,255,.78);
      border-radius:var(--radius-xl);
      padding:18px 16px 16px;
      box-shadow:0 24px 55px rgba(37,99,235,.10);
      margin-bottom:14px;
      position:relative;
      overflow:hidden;
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }

    .hero::before{
      content:"";
      position:absolute;
      width:170px;
      height:170px;
      border-radius:50%;
      right:-48px;
      top:-52px;
      background:radial-gradient(circle, rgba(37,99,235,.16) 0%, rgba(37,99,235,0) 70%);
      pointer-events:none;
    }

    .hero-title{
      font-size:20px;
      font-weight:950;
      line-height:1.18;
      letter-spacing:-.03em;
      margin:0 0 6px;
      color:#111827;
      position:relative;
      z-index:1;
    }

    .hero-title span{
      color:var(--blue);
    }

    .hero-sub{
      font-size:13px;
      line-height:1.55;
      color:var(--muted);
      margin-bottom:12px;
      max-width:300px;
      position:relative;
      z-index:1;
    }

    .hero-pills{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      position:relative;
      z-index:1;
    }

    .hero-pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:8px 12px;
      border-radius:999px;
      background:#eef4ff;
      color:#2563eb;
      font-size:11px;
      font-weight:800;
      line-height:1;
    }

    .message{
      display:none;
      padding:13px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.5;
      font-weight:800;
      margin-bottom:14px;
      box-shadow:var(--shadow);
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--red-soft);
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      background:var(--green-soft);
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .section{
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.9);
      border-radius:26px;
      padding:14px;
      box-shadow:var(--shadow);
      margin-bottom:14px;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:12px;
    }

    .section-title{
      margin:0;
      font-size:16px;
      font-weight:950;
      letter-spacing:-.02em;
      color:#111827;
    }

    .section-note{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
      margin-top:-4px;
      margin-bottom:12px;
    }

    .section-btn{
      border:none;
      background:#eef4ff;
      color:#2563eb;
      padding:10px 13px;
      border-radius:14px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .summary-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:10px;
    }

    .summary-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px 10px;
      text-align:center;
    }

    .summary-card h4{
      margin:0 0 6px;
      font-size:11px;
      color:#667085;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .summary-card div{
      font-size:22px;
      line-height:1;
      font-weight:950;
      letter-spacing:-.04em;
      color:#0f172a;
    }

    .field{
      margin-bottom:12px;
    }

    .field:last-child{
      margin-bottom:0;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:900;
      color:#374151;
      margin-bottom:7px;
      letter-spacing:-.01em;
    }

    .input,
    .select{
      width:100%;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      padding:14px 14px;
      font-size:14px;
      color:#111827;
      outline:none;
      transition:.18s ease;
      box-shadow:inset 0 1px 2px rgba(15,23,42,.03);
    }

    .input::placeholder{
      color:#98a2b3;
    }

    .input:focus,
    .select:focus{
      border-color:#93c5fd;
      box-shadow:
        0 0 0 4px rgba(37,99,235,.10),
        inset 0 1px 2px rgba(15,23,42,.03);
    }

    .row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    .form-actions{
      display:flex;
      gap:10px;
      margin-top:14px;
      flex-wrap:wrap;
    }

    .primary-btn,
    .ghost-btn,
    .copy-btn,
    .mini-btn{
      border:none;
      border-radius:16px;
      padding:13px 14px;
      font-size:13px;
      font-weight:900;
      cursor:pointer;
    }

    .primary-btn{
      background:linear-gradient(90deg,#2563eb 0%, #3b82f6 100%);
      color:#fff;
      box-shadow:0 18px 32px rgba(37,99,235,.22);
      flex:1;
    }

    .ghost-btn{
      background:#eef4ff;
      color:#2563eb;
      min-width:120px;
    }

    .result-card{
      display:none;
      margin-top:14px;
      border-radius:22px;
      padding:14px;
      background:linear-gradient(180deg,#ffffff 0%, #f8fffb 100%);
      border:1px solid #bbf7d0;
    }

    .result-card.show{
      display:block;
    }

    .result-title{
      font-size:15px;
      font-weight:950;
      color:#166534;
      margin-bottom:8px;
    }

    .result-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-bottom:10px;
    }

    .result-box{
      border:1px solid #d1fae5;
      background:#fff;
      border-radius:16px;
      padding:11px 12px;
    }

    .result-label{
      font-size:10px;
      font-weight:900;
      letter-spacing:.06em;
      text-transform:uppercase;
      color:#059669;
      margin-bottom:6px;
    }

    .result-value{
      font-size:14px;
      font-weight:950;
      color:#14532d;
      word-break:break-word;
    }

    .toolbar{
      display:flex;
      flex-direction:column;
      gap:12px;
    }

    .search-wrap{
      position:relative;
    }

    .search-input{
      width:100%;
      border:1px solid var(--line);
      border-radius:18px;
      background:#fff;
      padding:14px 14px 14px 44px;
      font-size:14px;
      color:#111827;
      outline:none;
    }

    .search-input:focus{
      border-color:#93c5fd;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    .search-icon{
      position:absolute;
      left:14px;
      top:50%;
      transform:translateY(-50%);
      width:18px;
      height:18px;
      color:#94a3b8;
      pointer-events:none;
    }

    .toolbar-row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    .assistant-list{
      display:flex;
      flex-direction:column;
      gap:12px;
    }

    .empty{
      text-align:center;
      font-size:13px;
      color:var(--muted);
      padding:24px 10px;
    }

    .assistant-card{
      border:1px solid var(--line);
      border-radius:22px;
      padding:14px;
      background:#fff;
      box-shadow:0 6px 18px rgba(15,23,42,.04);
    }

    .assistant-top{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
      margin-bottom:10px;
    }

    .assistant-name{
      font-size:15px;
      font-weight:950;
      line-height:1.28;
      margin-bottom:4px;
      color:#111827;
    }

    .assistant-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
    }

    .assistant-badge{
      padding:7px 10px;
      border-radius:999px;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      white-space:nowrap;
      flex-shrink:0;
    }

    .assistant-badge.active{
      background:#ecfdf5;
      color:#15803d;
    }

    .assistant-badge.disabled{
      background:#fef2f2;
      color:#dc2626;
    }

    .assistant-meta{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin:10px 0;
    }

    .meta-box{
      border:1px solid var(--line);
      border-radius:16px;
      background:#fbfdff;
      padding:10px 11px;
    }

    .meta-label{
      font-size:10px;
      font-weight:900;
      color:#64748b;
      text-transform:uppercase;
      letter-spacing:.06em;
      margin-bottom:5px;
    }

    .meta-value{
      font-size:12px;
      font-weight:800;
      line-height:1.45;
      color:#111827;
      word-break:break-word;
    }

    .assistant-actions{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:10px;
    }

    .copy-btn{
      background:#eef4ff;
      color:#2563eb;
    }

    .mini-btn{
      background:#f3f4f6;
      color:#374151;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:calc(env(safe-area-inset-bottom) + 10px);
      width:min(430px, calc(100vw - 18px));
      background:rgba(255,255,255,.92);
      border:1px solid rgba(226,232,240,.9);
      border-radius:30px;
      box-shadow:0 24px 48px rgba(15,23,42,.12);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      padding:10px 8px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:4px;
      z-index:40;
    }

    .nav-btn{
      border:none;
      background:transparent;
      border-radius:18px;
      min-height:62px;
      color:#9aa3b2;
      cursor:pointer;
      padding:6px 4px;
    }

    .nav-btn.active{
      color:#2563eb;
    }

    .nav-btn-inner{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:5px;
      font-size:11px;
      font-weight:800;
      line-height:1.15;
    }

    .nav-btn svg{
      width:22px;
      height:22px;
      display:block;
    }

    @media (max-width:380px){
      .summary-grid,
      .row,
      .result-grid,
      .toolbar-row,
      .assistant-meta{
        grid-template-columns:1fr;
      }

      .form-actions{
        flex-direction:column;
      }

      .ghost-btn,
      .primary-btn{
        width:100%;
      }
    }
  </style>
</head>
<body>
  <div class="glow"></div>

  <div class="shell">
    <div class="content">
      <div class="topbar">
        <div class="brand">
          <div class="brand-logo">
            <img
              src="asset/logo walpaper.jpeg"
              alt="Colspot"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<span style=&quot;font-weight:900;color:#2563eb;font-size:18px;&quot;>C</span>';"
            />
          </div>

          <div>
            <div class="brand-title">Colspot</div>
            <div class="brand-sub" id="schoolNameText">Assistant agents</div>
          </div>
        </div>

        <div class="top-actions">
          <button class="avatar-btn" id="avatarBtn" type="button">R</button>

          <div class="account-menu" id="accountMenu">
            <div class="menu-head">
              <div class="menu-name" id="menuAgentName">Report Agent</div>
              <div class="menu-sub" id="menuSchoolName">School</div>
            </div>

            <button class="menu-btn" type="button" onclick="goToAccountPage()">Account</button>
            <button class="menu-btn" type="button" onclick="window.location.href='agent_cases.html'">Open cases</button>
            <button class="menu-btn danger" type="button" onclick="logout()">Log out</button>
          </div>
        </div>
      </div>

      <section class="hero">
        <div class="hero-title">Manage <span>assistant agents</span></div>
        <div class="hero-sub">
          Create assistant accounts, view their login IDs, track assigned reports, and manage your support team from one place.
        </div>
        <div class="hero-pills">
          <div class="hero-pill">Create assistant</div>
          <div class="hero-pill">Copy login</div>
          <div class="hero-pill">Track workload</div>
        </div>
      </section>

      <div class="message" id="assistantMessage"></div>

      <section class="section">
        <div class="section-head">
          <h2 class="section-title">Assistant overview</h2>
          <button class="section-btn" id="refreshAssistantsTopBtn" type="button">Refresh</button>
        </div>

        <div class="summary-grid">
          <article class="summary-card">
            <h4>Total</h4>
            <div id="totalAssistantsCount">0</div>
          </article>
          <article class="summary-card">
            <h4>Active</h4>
            <div id="activeAssistantsCount">0</div>
          </article>
          <article class="summary-card">
            <h4>Assigned</h4>
            <div id="assignedWorkCount">0</div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2 class="section-title">Create assistant</h2>
        </div>

        <div class="section-note">
          Create a new assistant agent account linked to this report agent.
        </div>

        <div class="field">
          <label for="assistantFullName">Assistant full name</label>
          <input
            id="assistantFullName"
            class="input"
            type="text"
            placeholder="Enter assistant full name"
          />
        </div>

        <div class="field">
          <label for="assistantEmail">Linked email (optional)</label>
          <input
            id="assistantEmail"
            class="input"
            type="email"
            placeholder="assistant@email.com"
          />
        </div>

        <div class="form-actions">
          <button class="primary-btn" id="createAssistantBtn" type="button">Create assistant</button>
          <button class="ghost-btn" id="clearAssistantBtn" type="button">Clear</button>
        </div>

        <div class="result-card" id="assistantResultCard">
          <div class="result-title">Assistant created successfully</div>

          <div class="result-grid">
            <div class="result-box">
              <div class="result-label">Full name</div>
              <div class="result-value" id="assistantResultName">-</div>
            </div>
            <div class="result-box">
              <div class="result-label">Login ID</div>
              <div class="result-value" id="assistantResultLoginId">-</div>
            </div>
          </div>

          <div class="result-box" style="margin-bottom:10px;">
            <div class="result-label">Temporary password</div>
            <div class="result-value" id="assistantResultPassword">-</div>
          </div>

          <div class="assistant-actions">
            <button class="copy-btn" type="button" id="copyLoginBtn">Copy login ID</button>
            <button class="copy-btn" type="button" id="copyPasswordBtn">Copy password</button>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2 class="section-title">Find assistants</h2>
        </div>

        <div class="toolbar">
          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none">
              <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 0 0-14.4 7.2 7.2 0 0 0 0 14.4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <input
              id="assistantSearchInput"
              class="search-input"
              type="text"
              placeholder="Search by name, login ID, email"
            />
          </div>

          <div class="toolbar-row">
            <select id="assistantStatusFilter" class="select">
              <option value="all">All assistants</option>
              <option value="active">Active only</option>
              <option value="disabled">Disabled only</option>
            </select>

            <select id="assistantSortFilter" class="select">
              <option value="name">Sort by name</option>
              <option value="assigned_desc">Most assigned first</option>
              <option value="assigned_asc">Least assigned first</option>
            </select>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2 class="section-title">All assistants</h2>
          <button class="section-btn" id="refreshAssistantsBtn" type="button">Refresh</button>
        </div>

        <div class="assistant-list" id="assistantList">
          <div class="empty">Loading assistant agents...</div>
        </div>
      </section>
    </div>
  </div>

