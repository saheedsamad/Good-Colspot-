  <script>
    const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY_HERE";

    const ASSISTANTS_EDGE_FN = "get-report-agent-assistants";
    const CREATE_ASSISTANT_EDGE_FN = "create-assistant-report-agent";

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let reportAgentSession = null;
    let currentAssistants = [];
    let currentSearch = "";
    let currentStatusFilter = "all";
    let currentSort = "name";
    let lastGeneratedLoginId = "";
    let lastGeneratedPassword = "";

    function $(id) {
      return document.getElementById(id);
    }

    function showMessage(id, text = "", type = "error") {
      const box = $(id);
      if (!text) {
        box.className = "message";
        box.textContent = "";
        return;
      }
      box.className = `message show ${type}`;
      box.textContent = text;
    }

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function getAdminSession() {
      try {
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      } catch {
        return null;
      }
    }

    function requireReportAgentSession() {
      reportAgentSession = getAdminSession();

      if (!reportAgentSession || String(reportAgentSession.role || "").toLowerCase() !== "report_agent") {
        window.location.href = "index.html";
        return false;
      }

      const fullName = reportAgentSession.full_name || "Report Agent";
      const schoolName = reportAgentSession.school_name || "School";

      $("schoolNameText").textContent = schoolName;
      $("menuSchoolName").textContent = schoolName;
      $("menuAgentName").textContent = fullName;
      $("avatarBtn").textContent = (fullName.trim()[0] || "R").toUpperCase();

      return true;
    }

    async function invokeEdge(name, body = {}) {
      const { data, error } = await sb.functions.invoke(name, { body });

      if (error) {
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      if (!data?.ok) {
        throw new Error(data?.error || "Request failed.");
      }

      return data;
    }

    function copyText(text, successMessage) {
      if (!text) return;

      navigator.clipboard.writeText(text)
        .then(() => showMessage("assistantMessage", successMessage, "success"))
        .catch(() => showMessage("assistantMessage", "Could not copy text automatically."));
    }

    function clearAssistantForm() {
      $("assistantFullName").value = "";
      $("assistantEmail").value = "";
      $("assistantResultCard").classList.remove("show");
      $("assistantResultName").textContent = "-";
      $("assistantResultLoginId").textContent = "-";
      $("assistantResultPassword").textContent = "-";
      lastGeneratedLoginId = "";
      lastGeneratedPassword = "";
      showMessage("assistantMessage", "");
    }

    function updateCounts(assistants) {
      const total = assistants.length;
      const active = assistants.filter(a => !!a.is_active).length;
      const assigned = assistants.reduce((sum, a) => sum + Number(a.assigned_reports_count || 0), 0);

      $("totalAssistantsCount").textContent = String(total);
      $("activeAssistantsCount").textContent = String(active);
      $("assignedWorkCount").textContent = String(assigned);
    }

    function filteredAssistants() {
      let list = [...currentAssistants];

      if (currentSearch) {
        const q = currentSearch.toLowerCase();
        list = list.filter((assistant) => {
          const hay = [
            assistant.full_name,
            assistant.login_id,
            assistant.linked_email,
            assistant.school_name
          ].join(" ").toLowerCase();
          return hay.includes(q);
        });
      }

      if (currentStatusFilter === "active") {
        list = list.filter(a => !!a.is_active);
      } else if (currentStatusFilter === "disabled") {
        list = list.filter(a => !a.is_active);
      }

      if (currentSort === "assigned_desc") {
        list.sort((a, b) => Number(b.assigned_reports_count || 0) - Number(a.assigned_reports_count || 0));
      } else if (currentSort === "assigned_asc") {
        list.sort((a, b) => Number(a.assigned_reports_count || 0) - Number(b.assigned_reports_count || 0));
      } else {
        list.sort((a, b) => String(a.full_name || "").localeCompare(String(b.full_name || "")));
      }

      return list;
    }

    function renderAssistants() {
      const wrap = $("assistantList");
      const list = filteredAssistants();

      updateCounts(currentAssistants);

      if (!list.length) {
        wrap.innerHTML = '<div class="empty">No assistant agents found.</div>';
        return;
      }

      wrap.innerHTML = list.map((assistant) => `
        <article class="assistant-card">
          <div class="assistant-top">
            <div>
              <div class="assistant-name">${escapeHtml(assistant.full_name || "No name")}</div>
              <div class="assistant-sub">${escapeHtml(assistant.login_id || "-")}</div>
            </div>
            <div class="assistant-badge ${assistant.is_active ? "active" : "disabled"}">
              ${assistant.is_active ? "Active" : "Disabled"}
            </div>
          </div>

          <div class="assistant-sub">School: ${escapeHtml(assistant.school_name || "-")}</div>
          <div class="assistant-sub">Email: ${escapeHtml(assistant.linked_email || "Not linked")}</div>

          <div class="assistant-meta">
            <div class="meta-box">
              <div class="meta-label">Assigned reports</div>
              <div class="meta-value">${escapeHtml(assistant.assigned_reports_count || 0)}</div>
            </div>

            <div class="meta-box">
              <div class="meta-label">Login ID</div>
              <div class="meta-value">${escapeHtml(assistant.login_id || "-")}</div>
            </div>
          </div>

          <div class="assistant-actions">
            <button class="copy-btn" type="button" onclick="copyAssistantLogin('${escapeHtml(assistant.login_id || "")}')">
              Copy login ID
            </button>
            <button class="mini-btn" type="button" onclick="window.location.href='agent_cases.html'">
              View cases
            </button>
          </div>
        </article>
      `).join("");
    }

    async function loadAssistants() {
      showMessage("assistantMessage", "");
      try {
        const data = await invokeEdge(ASSISTANTS_EDGE_FN, {
          report_agent_id: reportAgentSession.id
        });

        currentAssistants = Array.isArray(data.assistants) ? data.assistants : [];
        renderAssistants();
      } catch (err) {
        console.error(err);
        currentAssistants = [];
        renderAssistants();
        showMessage("assistantMessage", err.message || "Could not load assistant agents.");
      }
    }

    async function createAssistant() {
      showMessage("assistantMessage", "");
      $("assistantResultCard").classList.remove("show");

      const fullName = $("assistantFullName").value.trim();
      const linkedEmail = $("assistantEmail").value.trim();

      if (!fullName) {
        showMessage("assistantMessage", "Please enter assistant full name.");
        return;
      }

      const btn = $("createAssistantBtn");
      btn.disabled = true;
      btn.textContent = "Creating...";

      try {
        const data = await invokeEdge(CREATE_ASSISTANT_EDGE_FN, {
          parent_report_agent_id: reportAgentSession.id,
          full_name: fullName,
          linked_email: linkedEmail
        });

        const assistant = data.assistant_report_agent || {};

        $("assistantResultName").textContent = assistant.full_name || fullName;
        $("assistantResultLoginId").textContent = assistant.login_id || "-";
        $("assistantResultPassword").textContent = data.temporary_password || "-";
        $("assistantResultCard").classList.add("show");

        lastGeneratedLoginId = assistant.login_id || "";
        lastGeneratedPassword = data.temporary_password || "";

        $("assistantFullName").value = "";
        $("assistantEmail").value = "";

        showMessage("assistantMessage", data.message || "Assistant agent created successfully.", "success");
        await loadAssistants();
      } catch (err) {
        console.error(err);
        showMessage("assistantMessage", err.message || "Could not create assistant agent.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Create assistant";
      }
    }

    function copyAssistantLogin(loginId) {
      copyText(loginId, "Assistant login ID copied.");
    }

    function goToAccountPage() {
      window.location.href = "account.html";
    }

    function logout() {
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    function toggleMenu() {
      $("accountMenu").classList.toggle("show");
    }

    document.addEventListener("click", (e) => {
      const menu = $("accountMenu");
      const btn = $("avatarBtn");
      if (!menu || !btn) return;

      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        menu.classList.remove("show");
      }
    });

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireReportAgentSession()) return;

      $("avatarBtn").addEventListener("click", toggleMenu);
      $("createAssistantBtn").addEventListener("click", createAssistant);
      $("clearAssistantBtn").addEventListener("click", clearAssistantForm);
      $("refreshAssistantsBtn").addEventListener("click", loadAssistants);
      $("refreshAssistantsTopBtn").addEventListener("click", loadAssistants);

      $("assistantSearchInput").addEventListener("input", (e) => {
        currentSearch = (e.target.value || "").trim();
        renderAssistants();
      });

      $("assistantStatusFilter").addEventListener("change", (e) => {
        currentStatusFilter = e.target.value || "all";
        renderAssistants();
      });

      $("assistantSortFilter").addEventListener("change", (e) => {
        currentSort = e.target.value || "name";
        renderAssistants();
      });

      $("copyLoginBtn").addEventListener("click", () => {
        copyText(lastGeneratedLoginId, "Generated login ID copied.");
      });

      $("copyPasswordBtn").addEventListener("click", () => {
        copyText(lastGeneratedPassword, "Generated password copied.");
      });

      await loadAssistants();
    });

    window.copyAssistantLogin = copyAssistantLogin;
    window.goToAccountPage = goToAccountPage;
    window.logout = logout;
  </script>
</body>
