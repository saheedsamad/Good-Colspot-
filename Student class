  <script>
    window.studentClassActivityState = window.studentClassActivityState || {
      activities: [],
      currentActivity: null,
      questions: [],
      answers: {},
      currentIndex: 0,
      currentAttemptId: null,
      currentAttemptExpiresAt: null,
      timerInterval: null
    };

    function studentActivityEscape(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function studentFmtDate(value) {
      if (!value) return "No due date";
      try {
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "No due date";
        return d.toLocaleString([], {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        });
      } catch {
        return "No due date";
      }
    }

    function studentFormatDuration(minutes) {
      const n = Number(minutes || 0);
      if (!n || n <= 0) return "No limit";
      if (n === 1) return "1 minute";
      return `${n} minutes`;
    }

    function studentFormatCountdown(ms) {
      const totalSeconds = Math.max(0, Math.floor(ms / 1000));
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }

    function studentStopTimer() {
      if (window.studentClassActivityState.timerInterval) {
        clearInterval(window.studentClassActivityState.timerInterval);
        window.studentClassActivityState.timerInterval = null;
      }
    }

    function studentSetTimerText(text, warning = false) {
      ["studentActivityTimerValue", "studentActivityReviewTimerValue"].forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = text;
        el.classList.toggle("warning", !!warning);
      });
    }

    async function studentAutoSubmitFromTimer() {
      studentStopTimer();
      alert("Time is up. Your activity will be submitted now.");
      await studentSubmitActivity(true);
    }

    function studentStartTimer(expiresAt) {
      studentStopTimer();

      if (!expiresAt) {
        studentSetTimerText("--:--", false);
        return;
      }

      window.studentClassActivityState.currentAttemptExpiresAt = expiresAt;

      const tick = () => {
        const endMs = new Date(expiresAt).getTime();
        const diff = endMs - Date.now();

        if (Number.isNaN(endMs)) {
          studentSetTimerText("--:--", false);
          studentStopTimer();
          return;
        }

        if (diff <= 0) {
          studentSetTimerText("00:00", true);
          studentAutoSubmitFromTimer();
          return;
        }

        const warning = diff <= 5 * 60 * 1000;
        studentSetTimerText(studentFormatCountdown(diff), warning);
      };

      tick();
      window.studentClassActivityState.timerInterval = setInterval(tick, 1000);
    }

    function studentShowActivityView(viewName) {
      const ids = [
        "studentActivitiesListView",
        "studentActivityIntroView",
        "studentActivityQuestionView",
        "studentActivityReviewView",
        "studentActivitySubmittedView"
      ];

      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.toggle("hidden", id !== viewName);
      });

      if (viewName === "studentActivitiesListView" || viewName === "studentActivityIntroView" || viewName === "studentActivitySubmittedView") {
        if (viewName !== "studentActivitySubmittedView") {
          studentStopTimer();
        }
      }
    }

    async function studentEnsureUser() {
      if (typeof ensureCurrentUser === "function") {
        return await ensureCurrentUser();
      }

      if (window.currentUser) return window.currentUser;
      if (typeof supabase === "undefined") return null;

      try {
        const { data, error } = await supabase.auth.getUser();
        if (error || !data?.user) return null;
        window.currentUser = data.user;
        return data.user;
      } catch {
        return null;
      }
    }

    function studentIsExpiredByDueDate(dueAt) {
      if (!dueAt) return false;
      const t = new Date(dueAt).getTime();
      if (Number.isNaN(t)) return false;
      return Date.now() > t;
    }

    async function studentLoadActivitiesScreen() {
      const wrap = document.getElementById("studentActivitiesList");
      if (!wrap) return;

      wrap.innerHTML = `<div class="activity-empty">Loading class activities...</div>`;

      if (typeof supabase === "undefined") {
        wrap.innerHTML = `<div class="activity-empty">Could not connect to the server.</div>`;
        return;
      }

      const user = await studentEnsureUser();
      if (!user) {
        wrap.innerHTML = `<div class="activity-empty">Please sign in again to load your activities.</div>`;
        return;
      }

      try {
        const { data: memberships, error: membershipError } = await supabase
          .from("course_memberships")
          .select("course_id")
          .eq("user_id", user.id);

        if (membershipError) throw membershipError;

        const classIds = (memberships || []).map(x => x.course_id).filter(Boolean);

        if (!classIds.length) {
          window.studentClassActivityState.activities = [];
          wrap.innerHTML = `<div class="activity-empty">You have not joined any class activity yet.</div>`;
          return;
        }

        const { data: courses, error: coursesError } = await supabase
          .from("courses")
          .select("id, course_code, course_title")
          .in("id", classIds);

        if (coursesError) throw coursesError;

        const courseMap = {};
        (courses || []).forEach((c) => {
          courseMap[c.id] = c;
        });

        const { data: activities, error: activitiesError } = await supabase
          .from("class_activities")
          .select("id, class_id, activity_type, title, due_at, time_limit_minutes, attempts_allowed, is_published, status, created_at")
          .in("class_id", classIds)
          .eq("is_published", true)
          .eq("status", "published")
          .order("created_at", { ascending: false });

        if (activitiesError) throw activitiesError;

        const activityIds = (activities || []).map(a => a.id).filter(Boolean);

        let attempts = [];
        if (activityIds.length) {
          const { data: attemptsData, error: attemptsError } = await supabase
            .from("class_activity_attempts")
            .select("id, activity_id, started_at, submitted_at, status, expires_at")
            .eq("user_id", user.id)
            .in("activity_id", activityIds);

          if (attemptsError) throw attemptsError;
          attempts = attemptsData || [];
        }

        let questionRows = [];
        if (activityIds.length) {
          const { data: qs, error: qsError } = await supabase
            .from("class_activity_questions")
            .select("id, activity_id")
            .in("activity_id", activityIds);

          if (qsError) throw qsError;
          questionRows = qs || [];
        }

        const countMap = {};
        questionRows.forEach((q) => {
          const key = q.activity_id;
          countMap[key] = (countMap[key] || 0) + 1;
        });

        const attemptMap = {};
        attempts.forEach((a) => {
          attemptMap[a.activity_id] = a;
        });

        const items = (activities || []).map((a) => {
          const attempt = attemptMap[a.id] || null;
          const expiredByDueDate = studentIsExpiredByDueDate(a.due_at);
          const expiredByTimer = !!(attempt?.expires_at && new Date(attempt.expires_at).getTime() < Date.now());

          let status = "not-started";
          if (attempt?.status === "submitted" || attempt?.submitted_at) {
            status = "submitted";
          } else if (attempt) {
            status = "in-progress";
          }

          if (expiredByDueDate || expiredByTimer) {
            if (status !== "submitted") status = "expired";
          }

          const course = courseMap[a.class_id] || {};

          return {
            id: a.id,
            class_id: a.class_id,
            class_code: course.course_code || "Class",
            class_title: course.course_title || "",
            type: a.activity_type || "revision",
            title: a.title || "Untitled activity",
            questions_count: countMap[a.id] || 0,
            time_limit: a.time_limit_minutes || null,
            due_at: a.due_at || null,
            due_text: studentFmtDate(a.due_at),
            status,
            attempt_id: attempt?.id || null,
            expires_at: attempt?.expires_at || null
          };
        });

        window.studentClassActivityState.activities = items;

        if (!items.length) {
          wrap.innerHTML = `<div class="activity-empty">No class activity available yet.</div>`;
          return;
        }

        wrap.innerHTML = items.map((item) => {
          const typeClass = item.status === "expired" ? "expired" : (item.type || "revision");
          const typeLabel =
            item.status === "expired" ? "Expired" :
            item.type === "assignment" ? "Assignment" :
            item.type === "test" ? "Test" : "Revision";

          const statusClass =
            item.status === "submitted" ? "submitted" :
            item.status === "in-progress" ? "in-progress" :
            item.status === "expired" ? "expired" : "not-started";

          const statusLabel =
            item.status === "submitted" ? "Submitted" :
            item.status === "in-progress" ? "In progress" :
            item.status === "expired" ? "Expired" : "Not started";

          const isBlocked = item.status === "submitted" || item.status === "expired";

          return `
            <article class="activity-item" onclick="${isBlocked ? "" : `studentOpenActivityIntro('${item.id}')`}">
              <div class="activity-item-top">
                <div>
                  <div class="activity-course">${studentActivityEscape(item.class_code)}</div>
                  <div class="activity-title">${studentActivityEscape(item.title)}</div>
                </div>
                <div class="activity-badge ${typeClass}">${typeLabel}</div>
              </div>

              <div class="activity-meta-row">
                <div class="activity-meta-pill">${studentActivityEscape(item.questions_count)} Questions</div>
                <div class="activity-meta-pill">${studentActivityEscape(item.due_text)}</div>
                <div class="activity-meta-pill">${item.time_limit ? studentActivityEscape(studentFormatDuration(item.time_limit)) : "No limit"}</div>
              </div>

              <div class="activity-status-row">
                <div class="activity-status ${statusClass}">${statusLabel}</div>
                <button class="activity-open-btn ${isBlocked ? "disabled" : ""}" type="button">
                  ${item.status === "in-progress" ? "Continue" : item.status === "submitted" ? "Submitted" : item.status === "expired" ? "Expired" : "Open"}
                </button>
              </div>
            </article>
          `;
        }).join("");
      } catch (err) {
        console.error("studentLoadActivitiesScreen failed:", err);
        wrap.innerHTML = `<div class="activity-empty">Could not load activities right now.</div>`;
      }
    }

    async function studentOpenActivityIntro(activityId) {
      const found = (window.studentClassActivityState.activities || []).find((x) => x.id === activityId);
      if (!found) return;

      document.getElementById("studentActivityIntroTitle").textContent = found.title;
      document.getElementById("studentActivityIntroCourse").textContent = `${found.class_code} - ${found.class_title}`;
      document.getElementById("studentActivityIntroQuestions").textContent = `${found.questions_count} Questions`;
      document.getElementById("studentActivityIntroTime").textContent = found.time_limit ? studentFormatDuration(found.time_limit) : "No limit";
      document.getElementById("studentActivityIntroDue").textContent = found.due_text || "No due date";

      const warningEl = document.getElementById("studentActivityStartWarning");
      if (warningEl) {
        warningEl.textContent = found.time_limit
          ? `Once you start, this activity will expire after ${studentFormatDuration(found.time_limit)}. A countdown will show at the top while you answer. You can only submit once, and your score will not show immediately.`
          : `You can only submit once. Your score will not show immediately. You will only see confirmation after submission.`;
      }

      window.studentClassActivityState.currentActivity = found;
      window.studentClassActivityState.questions = [];
      window.studentClassActivityState.answers = {};
      window.studentClassActivityState.currentIndex = 0;
      window.studentClassActivityState.currentAttemptId = found.attempt_id || null;
      window.studentClassActivityState.currentAttemptExpiresAt = found.expires_at || null;

      studentShowActivityView("studentActivityIntroView");
    }

    function studentBackToActivitiesList() {
      studentStopTimer();
      studentShowActivityView("studentActivitiesListView");
      studentLoadActivitiesScreen();
    }

    async function studentEnsureAttempt() {
      const activity = window.studentClassActivityState.currentActivity;
      if (!activity) return null;

      const user = await studentEnsureUser();
      if (!user) return null;

      if (window.studentClassActivityState.currentAttemptId) {
        return window.studentClassActivityState.currentAttemptId;
      }

      const { data: existing, error: existingError } = await supabase
        .from("class_activity_attempts")
        .select("id, status, submitted_at, expires_at")
        .eq("activity_id", activity.id)
        .eq("user_id", user.id)
        .maybeSingle();

      if (existingError) throw existingError;

      if (existing) {
        window.studentClassActivityState.currentAttemptId = existing.id;
        window.studentClassActivityState.currentAttemptExpiresAt = existing.expires_at || null;
        return existing.id;
      }

      const { data: created, error: createError } = await supabase
        .from("class_activity_attempts")
        .insert([{
          activity_id: activity.id,
          user_id: user.id,
          status: "in_progress",
          started_at: new Date().toISOString()
        }])
        .select("id, expires_at")
        .single();

      if (createError) throw createError;

      window.studentClassActivityState.currentAttemptId = created.id;
      window.studentClassActivityState.currentAttemptExpiresAt = created.expires_at || null;
      return created.id;
    }

    async function studentLoadAnswersForAttempt(attemptId) {
      if (!attemptId) return {};
      const { data, error } = await supabase
        .from("class_activity_answers")
        .select("question_id, selected_option")
        .eq("attempt_id", attemptId);

      if (error) throw error;

      const answers = {};
      (data || []).forEach((row) => {
        answers[row.question_id] = row.selected_option;
      });
      return answers;
    }

    async function studentStartActivity() {
      if (typeof supabase === "undefined") return;
      const activity = window.studentClassActivityState.currentActivity;
      if (!activity) return;

      if (studentIsExpiredByDueDate(activity.due_at)) {
        alert("This activity has expired.");
        studentBackToActivitiesList();
        return;
      }

      const btn = document.getElementById("studentStartActivityBtn");
      const oldText = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Starting...";

      try {
        const { data: questions, error: questionError } = await supabase
          .from("class_activity_questions")
          .select("id, question_text, option_a, option_b, option_c, option_d, position")
          .eq("activity_id", activity.id)
          .order("position", { ascending: true });

        if (questionError) throw questionError;

        window.studentClassActivityState.questions = (questions || []).map((q) => ({
          id: q.id,
          question: q.question_text,
          options: {
            A: q.option_a,
            B: q.option_b,
            C: q.option_c,
            D: q.option_d
          },
          position: q.position
        }));

        const attemptId = await studentEnsureAttempt();
        const savedAnswers = await studentLoadAnswersForAttempt(attemptId);

        window.studentClassActivityState.answers = savedAnswers || {};
        window.studentClassActivityState.currentIndex = 0;

        if (window.studentClassActivityState.currentAttemptExpiresAt) {
          const endMs = new Date(window.studentClassActivityState.currentAttemptExpiresAt).getTime();
          if (!Number.isNaN(endMs) && Date.now() >= endMs) {
            alert("This activity time has already expired.");
            studentBackToActivitiesList();
            return;
          }
        }

        studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
        studentRenderQuestion();
        studentShowActivityView("studentActivityQuestionView");
      } catch (err) {
        console.error("studentStartActivity failed:", err);
        alert("Could not open this activity right now.");
      } finally {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }

    function studentRenderQuestion() {
      const questions = window.studentClassActivityState.questions;
      const idx = window.studentClassActivityState.currentIndex;
      const q = questions[idx];
      if (!q) return;

      const total = questions.length;
      const progress = Math.round(((idx + 1) / total) * 100);

      document.getElementById("studentActivityProgressText").textContent = `Question ${idx + 1} of ${total}`;
      document.getElementById("studentActivityProgressPercent").textContent = `${progress}%`;
      document.getElementById("studentActivityProgressBar").style.width = `${progress}%`;
      document.getElementById("studentActivityQuestionTitle").textContent = q.question;

      const wrap = document.getElementById("studentActivityOptionList");
      const selected = window.studentClassActivityState.answers[q.id] || "";

      wrap.innerHTML = Object.entries(q.options).map(([key, value]) => `
        <div class="activity-option ${selected === key ? "active" : ""}" onclick="studentSelectOption('${q.id}','${key}')">
          <div class="activity-option-letter">${key}</div>
          <div class="activity-option-text">${studentActivityEscape(value)}</div>
        </div>
      `).join("");

      document.getElementById("studentActivityPrevBtn").style.visibility = idx === 0 ? "hidden" : "visible";
      document.getElementById("studentActivityNextBtn").textContent = idx === total - 1 ? "Review answers" : "Next";
    }

    async function studentSelectOption(questionId, optionKey) {
      window.studentClassActivityState.answers[questionId] = optionKey;
      studentRenderQuestion();

      try {
        const attemptId = await studentEnsureAttempt();
        if (!attemptId) return;

        const { data: existing, error: existingError } = await supabase
          .from("class_activity_answers")
          .select("id")
          .eq("attempt_id", attemptId)
          .eq("question_id", questionId)
          .maybeSingle();

        if (existingError) throw existingError;

        if (existing?.id) {
          const { error: updateError } = await supabase
            .from("class_activity_answers")
            .update({ selected_option: optionKey })
            .eq("id", existing.id);

          if (updateError) throw updateError;
        } else {
          const { error: insertError } = await supabase
            .from("class_activity_answers")
            .insert([{
              attempt_id: attemptId,
              question_id: questionId,
              selected_option: optionKey
            }]);

          if (insertError) throw insertError;
        }
      } catch (err) {
        console.error("studentSelectOption save failed:", err);
      }
    }

    function studentGoPrevQuestion() {
      if (window.studentClassActivityState.currentIndex > 0) {
        window.studentClassActivityState.currentIndex -= 1;
        studentRenderQuestion();
      }
    }

    function studentGoBackQuestion() {
      if (window.studentClassActivityState.currentIndex > 0) {
        studentGoPrevQuestion();
      } else {
        studentStopTimer();
        studentShowActivityView("studentActivityIntroView");
      }
    }

    function studentGoNextQuestion() {
      const questions = window.studentClassActivityState.questions;
      const idx = window.studentClassActivityState.currentIndex;
      const q = questions[idx];
      if (!q) return;

      if (!window.studentClassActivityState.answers[q.id]) {
        alert("Please choose an answer before continuing.");
        return;
      }

      if (idx === questions.length - 1) {
        studentOpenReviewAnswers();
        return;
      }

      window.studentClassActivityState.currentIndex += 1;
      studentRenderQuestion();
    }

    function studentBackToLastQuestion() {
      studentShowActivityView("studentActivityQuestionView");
      studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
      window.studentClassActivityState.currentIndex = window.studentClassActivityState.questions.length - 1;
      studentRenderQuestion();
    }

    function studentJumpToQuestion(index) {
      window.studentClassActivityState.currentIndex = index;
      studentShowActivityView("studentActivityQuestionView");
      studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
      studentRenderQuestion();
    }

    function studentOpenReviewAnswers() {
      const wrap = document.getElementById("studentActivityReviewList");
      wrap.innerHTML = window.studentClassActivityState.questions.map((q, index) => {
        const picked = window.studentClassActivityState.answers[q.id];
        const pickedText = picked ? `${picked}. ${q.options[picked]}` : "No answer selected";

        return `
          <div class="activity-review-item" onclick="studentJumpToQuestion(${index})">
            <div class="activity-review-q">Question ${index + 1}: ${studentActivityEscape(q.question)}</div>
            <div class="activity-review-a"><strong>Your answer:</strong> ${studentActivityEscape(pickedText)}</div>
          </div>
        `;
      }).join("");

      studentShowActivityView("studentActivityReviewView");
      studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
    }

    async function studentSubmitActivity(fromTimer = false) {
      const btn = document.getElementById("studentSubmitActivityBtn");
      const oldText = btn ? btn.textContent : "Submit activity";
      if (btn) {
        btn.disabled = true;
        btn.textContent = fromTimer ? "Submitting..." : "Submitting...";
      }

      try {
        const attemptId = await studentEnsureAttempt();
        if (!attemptId) throw new Error("Missing attempt");

        const { error } = await supabase
          .from("class_activity_attempts")
          .update({
            status: "submitted",
            submitted_at: new Date().toISOString()
          })
          .eq("id", attemptId);

        if (error) throw error;

        studentStopTimer();
        studentShowActivityView("studentActivitySubmittedView");
      } catch (err) {
        console.error("studentSubmitActivity failed:", err);
        alert("Could not submit activity right now.");
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      }
    }

    (function bindStudentActivityScreen() {
      const originalShowScreen = window.showScreen;

      if (!window.__studentActivityShowScreenWrapped && typeof originalShowScreen === "function") {
        window.showScreen = function(name) {
          originalShowScreen(name);
          if (name === "reports") {
            studentBackToActivitiesList();
          }
        };
        window.__studentActivityShowScreenWrapped = true;
      }

      document.addEventListener("DOMContentLoaded", () => {
        studentLoadActivitiesScreen();
      });
    })();
  </script>
</div>
<!-- 🔹 STUDENT CLASS ACTIVITY SCREEN END -->
