<!-- STUDENT REPORTS / HISTORY / FORMS / ACTIVITIES / ANNOUNCEMENTS -->
<section id="screen-reports" class="screen">
  <style>
    #screen-reports{
      --sr-bg:#f6f7fb;
      --sr-card:#ffffff;
      --sr-line:#e7ebf3;
      --sr-line-soft:#eff2f8;
      --sr-text:#15213c;
      --sr-muted:#7a8195;
      --sr-blue:#2f5fdb;
      --sr-blue-2:#3d6cf0;
      --sr-blue-soft:#edf3ff;
      --sr-green:#1c9a63;
      --sr-green-soft:#ecfbf4;
      --sr-red:#b74254;
      --sr-red-soft:#fff1f4;
      --sr-shadow:0 10px 28px rgba(19,33,61,.06);
      --sr-pill:999px;

      min-height:100%;
      background:var(--sr-bg);
      padding:0 0 110px;
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
      box-sizing:border-box;
    }

    #screen-reports *{
      box-sizing:border-box;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    #screen-reports .hidden{ display:none !important; }

    #screen-reports .reports-shell,
    #screen-reports .view-shell{
      min-height:100%;
      background:var(--sr-bg);
    }

    #screen-reports .reports-header,
    #screen-reports .panel-topbar{
      position:sticky;
      top:0;
      z-index:20;
      background:rgba(246,247,251,.96);
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--sr-line);
      padding:16px;
    }

    #screen-reports .reports-header-row{
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:46px;
    }

    #screen-reports .uh-back-btn,
    #screen-reports .panel-back-btn{
      border:none;
      background:transparent;
      color:var(--sr-blue);
      cursor:pointer;
      font-weight:900;
    }

    #screen-reports .uh-back-btn{
      position:absolute;
      left:0;
      top:50%;
      transform:translateY(-50%);
      width:42px;
      height:42px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:0;
    }

    #screen-reports .uh-back-btn svg{
      width:24px;
      height:24px;
      stroke:currentColor;
      stroke-width:2.2;
      fill:none;
    }

    #screen-reports .panel-back-btn{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:0;
      font-size:15px;
    }

    #screen-reports .panel-back-btn::before{
      content:"";
      width:9px;
      height:9px;
      border-left:2px solid currentColor;
      border-bottom:2px solid currentColor;
      transform:rotate(45deg);
      display:inline-block;
      margin-top:-1px;
    }

    #screen-reports .reports-page-title{
      margin:0;
      font-size:20px;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--sr-text);
      text-align:center;
    }

    #screen-reports .reports-hero{
      padding:18px 16px 10px;
    }

    #screen-reports .reports-hero-card,
    #screen-reports .panel-card{
      background:#fff;
      border:1px solid var(--sr-line);
      border-radius:28px;
      box-shadow:var(--sr-shadow);
    }

    #screen-reports .reports-hero-card{
      padding:18px;
    }

    #screen-reports .reports-hero-label{
      font-size:12px;
      font-weight:900;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--sr-blue);
      margin-bottom:8px;
    }

    #screen-reports .reports-hero-title{
      margin:0 0 8px;
      font-size:24px;
      line-height:1.12;
      font-weight:900;
      letter-spacing:-.04em;
      color:var(--sr-text);
    }

    #screen-reports .reports-hero-sub{
      margin:0;
      font-size:14px;
      line-height:1.6;
      color:var(--sr-muted);
    }

    #screen-reports .reports-stats-wrap{
      padding:4px 16px 10px;
    }

    #screen-reports .reports-stats{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
    }

    #screen-reports .reports-stat{
      background:#fff;
      border:1px solid var(--sr-line);
      border-radius:22px;
      padding:16px;
      box-shadow:0 6px 18px rgba(19,33,61,.03);
    }

    #screen-reports .reports-stat-label{
      font-size:13px;
      font-weight:800;
      color:var(--sr-muted);
      margin-bottom:8px;
    }

    #screen-reports .reports-stat-value{
      font-size:24px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--sr-text);
    }

    #screen-reports .reports-pending-card{
      padding:0 16px 8px;
    }

    #screen-reports .reports-pending-inner{
      background:#fff;
      border:1px solid var(--sr-line);
      border-radius:24px;
      padding:14px 16px;
      box-shadow:0 6px 18px rgba(19,33,61,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    #screen-reports .reports-pending-title{
      font-size:14px;
      font-weight:900;
      color:var(--sr-text);
      margin-bottom:4px;
    }

    #screen-reports .reports-pending-sub{
      font-size:13px;
      color:var(--sr-muted);
      line-height:1.5;
    }

    #screen-reports .reports-pending-badge{
      flex-shrink:0;
      min-height:38px;
      padding:0 14px;
      border-radius:var(--sr-pill);
      background:var(--sr-blue-soft);
      color:var(--sr-blue);
      border:1px solid #d8e3ff;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size:13px;
      font-weight:900;
      white-space:nowrap;
    }

    #screen-reports .reports-controls{
      padding:8px 16px 10px;
      border-bottom:1px solid var(--sr-line);
    }

    #screen-reports .reports-top-row{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:12px;
      flex-wrap:wrap;
    }

    #screen-reports .reports-tabs{
      display:inline-flex;
      align-items:center;
      gap:4px;
      padding:4px;
      background:#fff;
      border:1px solid var(--sr-line);
      border-radius:var(--sr-pill);
      box-shadow:0 4px 14px rgba(19,33,61,.03);
      overflow-x:auto;
      max-width:100%;
    }

    #screen-reports .reports-tab{
      border:none;
      background:transparent;
      color:var(--sr-muted);
      min-height:42px;
      padding:0 16px;
      border-radius:var(--sr-pill);
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:7px;
      cursor:pointer;
      white-space:nowrap;
      flex-shrink:0;
    }

    #screen-reports .reports-tab.active{
      background:#edf1fb;
      color:var(--sr-text);
      box-shadow:inset 0 0 0 1px #e3e8f4;
    }

    #screen-reports .reports-tab-count{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:22px;
      height:22px;
      padding:0 6px;
      border-radius:999px;
      background:#f1f3f8;
      color:#5e6578;
      font-size:11px;
      font-weight:900;
      line-height:1;
    }

    #screen-reports .reports-tab.active .reports-tab-count{
      background:#dfe7fb;
      color:var(--sr-blue);
    }

    #screen-reports .reports-filter-wrap{
      margin-left:auto;
      position:relative;
    }

    #screen-reports .reports-filter-btn{
      min-height:42px;
      border:1px solid var(--sr-line);
      background:#fff;
      color:var(--sr-text);
      border-radius:var(--sr-pill);
      padding:0 14px;
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:8px;
      cursor:pointer;
      box-shadow:0 4px 14px rgba(19,33,61,.03);
    }

    #screen-reports .reports-filter-btn svg{
      width:16px;
      height:16px;
      stroke:currentColor;
      stroke-width:2;
      fill:none;
    }

    #screen-reports .reports-filter-select{
      appearance:none;
      -webkit-appearance:none;
      position:absolute;
      inset:0;
      opacity:0;
      cursor:pointer;
    }

    #screen-reports .reports-search{
      position:relative;
    }

    #screen-reports .reports-search svg{
      position:absolute;
      left:16px;
      top:50%;
      transform:translateY(-50%);
      width:20px;
      height:20px;
      color:#8b92a7;
      pointer-events:none;
    }

    #screen-reports .reports-search input{
      width:100%;
      height:54px;
      border-radius:var(--sr-pill);
      border:1px solid var(--sr-line);
      background:#fff;
      outline:none;
      padding:0 18px 0 48px;
      font-size:16px;
      color:var(--sr-text);
      box-shadow:0 4px 14px rgba(19,33,61,.03);
    }

    #screen-reports .reports-search input::placeholder{
      color:#8b92a7;
    }

    #screen-reports .reports-search input:focus{
      border-color:#d8deef;
      box-shadow:0 0 0 4px rgba(47,95,219,.07);
    }

    #screen-reports .feed-list{
      padding:14px 16px 0;
      display:flex;
      flex-direction:column;
      gap:16px;
    }

    #screen-reports .feed-empty{
      border-radius:24px;
      background:#fff;
      border:1px solid var(--sr-line);
      padding:28px 18px;
      text-align:center;
      color:var(--sr-muted);
      font-size:14px;
      box-shadow:var(--sr-shadow);
    }

    #screen-reports .feed-card{
      background:#fff;
      border:1px solid var(--sr-line);
      border-radius:30px;
      overflow:hidden;
      box-shadow:var(--sr-shadow);
      cursor:pointer;
    }

    #screen-reports .feed-card-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:14px;
      padding:18px 18px 14px;
    }

    #screen-reports .feed-card-head{
      min-width:0;
      flex:1;
    }

    #screen-reports .feed-source{
      font-size:13px;
      font-weight:900;
      color:#7d8599;
      text-transform:uppercase;
      margin-bottom:4px;
    }

    #screen-reports .feed-title{
      font-size:18px;
      line-height:1.15;
      font-weight:900;
      color:var(--sr-text);
      margin:0 0 6px;
      word-break:break-word;
    }

    #screen-reports .feed-subtitle{
      font-size:13px;
      line-height:1.45;
      color:var(--sr-muted);
      margin:0;
      word-break:break-word;
    }

    #screen-reports .feed-kind-badge{
      flex-shrink:0;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:40px;
      padding:0 16px;
      border-radius:var(--sr-pill);
      font-size:13px;
      font-weight:900;
      white-space:nowrap;
    }

    #screen-reports .feed-kind-badge.revision,
    #screen-reports .feed-kind-badge.assignment,
    #screen-reports .feed-kind-badge.test,
    #screen-reports .feed-kind-badge.form,
    #screen-reports .feed-kind-badge.submitted{
      color:var(--sr-blue);
      background:var(--sr-blue-soft);
      border:1px solid #e4ebff;
    }

    #screen-reports .feed-kind-badge.closed,
    #screen-reports .feed-kind-badge.expired{
      color:var(--sr-red);
      background:var(--sr-red-soft);
      border:1px solid #f6dbe2;
    }

    #screen-reports .feed-meta{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      padding:0 18px 16px;
    }

    #screen-reports .feed-pill{
      min-height:36px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:0 14px;
      border-radius:var(--sr-pill);
      font-size:13px;
      font-weight:800;
      color:#61687d;
      background:#f7f8fc;
      border:1px solid #e7eaf2;
      white-space:nowrap;
    }

    #screen-reports .feed-pill:first-child{
      color:var(--sr-blue);
      background:var(--sr-blue-soft);
      border-color:#d9e5ff;
    }

    #screen-reports .feed-status-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 18px;
      border-top:1px solid var(--sr-line-soft);
      background:#fff;
    }

    #screen-reports .feed-status{
      font-size:15px;
      font-weight:900;
      letter-spacing:-.01em;
    }

    #screen-reports .feed-status.submitted{ color:var(--sr-text); }
    #screen-reports .feed-status.not-started,
    #screen-reports .feed-status.in-progress{ color:var(--sr-blue); }
    #screen-reports .feed-status.expired,
    #screen-reports .feed-status.closed{ color:var(--sr-red); }

    #screen-reports .feed-open-btn,
    #screen-reports .primary-btn{
      border:none;
      min-height:46px;
      padding:0 16px;
      border-radius:var(--sr-pill);
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }

    #screen-reports .feed-open-btn{
      background:var(--sr-blue-soft);
      color:var(--sr-blue);
      white-space:nowrap;
    }

    #screen-reports .feed-open-btn.disabled{
      background:var(--sr-red-soft);
      color:var(--sr-red);
      cursor:default;
    }

    #screen-reports .panel-wrap{
      padding:16px;
    }

    #screen-reports .panel-card{
      padding:20px 18px;
    }

    #screen-reports .panel-title{
      font-size:22px;
      font-weight:900;
      color:var(--sr-text);
      letter-spacing:-.03em;
      margin-bottom:6px;
      line-height:1.15;
    }

    #screen-reports .panel-course{
      font-size:14px;
      font-weight:700;
      color:var(--sr-muted);
      margin-bottom:18px;
      line-height:1.45;
    }

    #screen-reports .panel-meta{
      display:flex;
      flex-direction:column;
      gap:10px;
      margin-bottom:16px;
    }

    #screen-reports .panel-meta-item{
      font-size:14px;
      color:var(--sr-text);
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:12px;
      padding:13px 0;
      border-bottom:1px solid var(--sr-line-soft);
    }

    #screen-reports .panel-meta-item:last-child{
      border-bottom:none;
      padding-bottom:0;
    }

    #screen-reports .panel-meta-item span{
      color:var(--sr-muted);
      font-weight:700;
    }

    #screen-reports .panel-meta-item strong{
      text-align:right;
      font-weight:900;
      color:var(--sr-text);
      line-height:1.4;
    }

    #screen-reports .info-box{
      border-radius:18px;
      padding:14px;
      font-size:13px;
      line-height:1.55;
      margin-bottom:16px;
      border:1px solid;
      font-weight:600;
    }

    #screen-reports .info-box.blue{
      background:var(--sr-blue-soft);
      border-color:#d8e3ff;
      color:#2446a5;
    }

    #screen-reports .timer-box{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      border-radius:18px;
      background:var(--sr-blue-soft);
      border:1px solid #d8e3ff;
      color:#2446a5;
      padding:12px 14px;
      margin-bottom:16px;
    }

    #screen-reports .timer-label{
      font-size:13px;
      font-weight:900;
    }

    #screen-reports .timer-value{
      font-size:20px;
      font-weight:900;
      letter-spacing:.03em;
      color:var(--sr-blue);
      font-variant-numeric:tabular-nums;
    }

    #screen-reports .timer-value.warning{
      color:var(--sr-red);
    }

    #screen-reports .progress-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:8px;
      font-size:13px;
      color:var(--sr-text);
      font-weight:800;
    }

    #screen-reports .progress-track{
      width:100%;
      height:8px;
      border-radius:999px;
      background:#e9edf5;
      overflow:hidden;
      margin-bottom:18px;
    }

    #screen-reports .progress-bar{
      height:100%;
      width:0%;
      border-radius:999px;
      background:linear-gradient(135deg,var(--sr-blue),var(--sr-blue-2));
    }

    #screen-reports .question-title{
      font-size:20px;
      font-weight:900;
      line-height:1.4;
      color:var(--sr-text);
      margin-bottom:14px;
      letter-spacing:-.02em;
    }

    #screen-reports .question-help{
      margin:-4px 0 14px;
      font-size:13px;
      color:var(--sr-muted);
      line-height:1.55;
    }

    #screen-reports .choice-list,
    #screen-reports .review-list{
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-bottom:18px;
    }

    #screen-reports .choice-option,
    #screen-reports .review-item{
      border-radius:18px;
      border:1px solid #e8ebf3;
      background:#fff;
      padding:14px;
    }

    #screen-reports .choice-option{
      display:flex;
      align-items:flex-start;
      gap:12px;
      cursor:pointer;
    }

    #screen-reports .choice-option.active{
      border-color:#cfdcff;
      background:var(--sr-blue-soft);
      box-shadow:0 0 0 1px rgba(47,95,219,.12);
    }

    #screen-reports .choice-mark{
      width:30px;
      height:30px;
      border-radius:10px;
      background:#f4f6fb;
      color:var(--sr-text);
      font-size:13px;
      font-weight:900;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      border:1px solid #e5e9f2;
    }

    #screen-reports .choice-option.active .choice-mark{
      background:#dfe8ff;
      color:var(--sr-blue);
      border-color:#cfdcff;
    }

    #screen-reports .choice-text{
      font-size:15px;
      line-height:1.55;
      color:var(--sr-text);
      flex:1;
      word-break:break-word;
    }

    #screen-reports .review-q{
      font-size:14px;
      font-weight:900;
      color:var(--sr-text);
      margin-bottom:8px;
      line-height:1.5;
    }

    #screen-reports .review-a{
      font-size:14px;
      color:var(--sr-muted);
      line-height:1.55;
      word-break:break-word;
    }

    #screen-reports .review-a strong{
      color:var(--sr-text);
    }

    #screen-reports .input-shell,
    #screen-reports .textarea-shell,
    #screen-reports .select-shell,
    #screen-reports .date-shell,
    #screen-reports .file-shell{
      border-radius:20px;
      background:#fff;
      border:1px solid #e8ebf3;
      padding:14px;
      margin-bottom:14px;
      box-shadow:0 6px 18px rgba(19,33,61,.03);
    }

    #screen-reports .text-input,
    #screen-reports .text-area,
    #screen-reports .select-input,
    #screen-reports .date-input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      color:var(--sr-text);
      font-size:15px;
      padding:0;
    }

    #screen-reports .text-area{
      min-height:140px;
      line-height:1.6;
      resize:none;
    }

    #screen-reports .file-shell{
      border-style:dashed;
      border-color:#cbd9ff;
      background:linear-gradient(180deg,#f8fbff 0%, #ffffff 100%);
    }

    #screen-reports .file-drop{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      gap:10px;
      min-height:150px;
    }

    #screen-reports .file-drop-icon{
      width:56px;
      height:56px;
      border-radius:18px;
      background:#dfe8ff;
      color:var(--sr-blue);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    #screen-reports .file-drop-title{
      font-size:15px;
      font-weight:900;
      color:var(--sr-text);
    }

    #screen-reports .file-drop-sub{
      font-size:13px;
      color:var(--sr-muted);
      line-height:1.55;
      max-width:260px;
    }

    #screen-reports .file-drop-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:46px;
      padding:0 18px;
      border-radius:var(--sr-pill);
      border:none;
      background:linear-gradient(135deg,var(--sr-blue),var(--sr-blue-2));
      color:#fff;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      box-shadow:0 14px 30px rgba(47,95,219,.20);
    }

    #screen-reports .field-note{
      font-size:12px;
      color:var(--sr-muted);
      line-height:1.5;
      margin-top:2px;
      word-break:break-word;
    }

    #screen-reports .nav-row{
      display:flex;
      gap:10px;
    }

    #screen-reports .nav-row button{
      flex:1;
    }

    #screen-reports .ghost-btn{
      border-radius:var(--sr-pill);
      border:1px solid #d8deeb;
      min-height:46px;
      padding:0 16px;
      font-size:14px;
      font-weight:800;
      background:#fff;
      color:var(--sr-text);
      cursor:pointer;
    }

    #screen-reports .primary-btn{
      background:linear-gradient(135deg,var(--sr-blue),var(--sr-blue-2));
      color:#fff;
      box-shadow:0 14px 30px rgba(47,95,219,.20);
    }

    #screen-reports .submit-note{
      font-size:13px;
      color:var(--sr-muted);
      line-height:1.6;
      margin-bottom:14px;
    }

    #screen-reports .success-wrap{
      text-align:center;
    }

