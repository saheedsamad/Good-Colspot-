  async function studentStartActivity() {
    const activity = window.studentClassActivityState.currentActivity;
    if (!activity) return;

    if (studentIsExpiredByDate(activity.due_at)) {
      alert("This activity has expired.");
      studentBackToReportsHome();
      return;
    }

    const btn = document.getElementById("studentStartActivityBtn");
    const oldText = btn ? btn.textContent : "Start activity";

    if (btn) {
      btn.disabled = true;
      btn.textContent = "Starting...";
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again.");

      const result = await studentInvokeHistoryManager({
        action: "start_activity_attempt",
        user_id: user.id,
        activity_id: activity.id
      });

      const questions = studentEnsureArray(result.questions);
      const attempt = result.attempt || null;
      const answers = studentEnsureArray(result.answers);

      const state = window.studentClassActivityState;
      state.activityQuestions = questions.map((q) => ({
        id: q.id,
        question: q.question_text,
        options: {
          A: q.option_a,
          B: q.option_b,
          C: q.option_c,
          D: q.option_d
        },
        position: q.position
      }));

      state.activityAnswers = {};
      answers.forEach((row) => {
        state.activityAnswers[row.question_id] = row.selected_option;
      });

      state.currentActivityIndex = 0;
      state.currentAttemptId = attempt?.id || null;
      state.currentAttemptExpiresAt = attempt?.expires_at || null;

      if (state.currentAttemptExpiresAt) {
        const endMs = new Date(state.currentAttemptExpiresAt).getTime();
        if (!Number.isNaN(endMs) && Date.now() >= endMs) {
          alert("This activity time has already expired.");
          studentBackToReportsHome();
          return;
        }
      }

      studentStartTimer(state.currentAttemptExpiresAt);
      studentRenderActivityQuestion();
      studentShowReportsView("studentActivityQuestionView");
    } catch (err) {
      console.error("studentStartActivity failed:", err);
      alert(err?.message || "Could not open this activity right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  function studentRenderActivityQuestion() {
    const state = window.studentClassActivityState;
    const questions = state.activityQuestions || [];
    const index = Number(state.currentActivityIndex || 0);
    const q = questions[index];
    if (!q) return;

    const titleEl = document.getElementById("studentActivityQuestionTitle");
    const listEl = document.getElementById("studentActivityOptionList");
    const progressTextEl = document.getElementById("studentActivityProgressText");
    const progressPercentEl = document.getElementById("studentActivityProgressPercent");
    const progressBarEl = document.getElementById("studentActivityProgressBar");
    const nextBtn = document.getElementById("studentActivityNextBtn");

    if (titleEl) titleEl.textContent = q.question || "Question";

    const total = questions.length || 1;
    const percent = Math.round(((index + 1) / total) * 100);

    if (progressTextEl) progressTextEl.textContent = `Question ${index + 1} of ${total}`;
    if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
    if (progressBarEl) progressBarEl.style.width = `${percent}%`;
    if (nextBtn) nextBtn.textContent = index === total - 1 ? "Review" : "Next";

    const selected = state.activityAnswers[q.id] || "";

    if (listEl) {
      const keys = ["A", "B", "C", "D"].filter((key) => studentNormalizeText(q.options[key]));
      listEl.innerHTML = keys.map((key) => {
        const active = selected === key;
        return `
          <div class="choice-option ${active ? "active" : ""}" data-activity-option="${studentReportEscape(key)}">
            <div class="choice-mark">${studentReportEscape(key)}</div>
            <div class="choice-text">${studentReportEscape(q.options[key])}</div>
          </div>
        `;
      }).join("");
    }
  }

  async function studentSaveCurrentActivityAnswer() {
    const state = window.studentClassActivityState;
    const questions = state.activityQuestions || [];
    const q = questions[state.currentActivityIndex];
    if (!q) return;

    const selected = state.activityAnswers[q.id];
    if (!selected) {
      throw new Error("Please select one option before continuing.");
    }

    const user = await studentEnsureUser();
    if (!user) throw new Error("Please sign in again.");

    const result = await studentInvokeHistoryManager({
      action: "save_activity_answer",
      user_id: user.id,
      activity_id: state.currentActivity?.id,
      question_id: q.id,
      selected_option: selected
    });

    state.currentAttemptId = result?.attempt?.id || state.currentAttemptId;
    state.currentAttemptExpiresAt = result?.attempt?.expires_at || state.currentAttemptExpiresAt;

    const returnedAnswers = studentEnsureArray(result?.answers);
    if (returnedAnswers.length) {
      const mapped = {};
      returnedAnswers.forEach((row) => {
        mapped[row.question_id] = row.selected_option;
      });
      state.activityAnswers = {
        ...state.activityAnswers,
        ...mapped
      };
    }
  }

  function studentGoPrevQuestion() {
    const state = window.studentClassActivityState;
    if (state.currentActivityIndex > 0) {
      state.currentActivityIndex -= 1;
      studentRenderActivityQuestion();
    } else {
      studentShowReportsView("studentActivityIntroView");
      studentStartTimer(state.currentAttemptExpiresAt);
    }
  }

  async function studentGoNextQuestion() {
    try {
      await studentSaveCurrentActivityAnswer();

      const state = window.studentClassActivityState;
      const total = (state.activityQuestions || []).length;

      if (state.currentActivityIndex >= total - 1) {
        studentRenderActivityReview();
        studentShowReportsView("studentActivityReviewView");
        studentStartTimer(state.currentAttemptExpiresAt);
        return;
      }

      state.currentActivityIndex += 1;
      studentRenderActivityQuestion();
    } catch (err) {
      alert(err?.message || "Could not save answer right now.");
    }
  }

  function studentRenderActivityReview() {
    const state = window.studentClassActivityState;
    const wrap = document.getElementById("studentActivityReviewList");
    if (!wrap) return;

    wrap.innerHTML = (state.activityQuestions || []).map((q, index) => {
      const selected = state.activityAnswers[q.id];
      const selectedText = selected && q.options[selected] ? `${selected}. ${q.options[selected]}` : "No answer selected";
      return `
        <div class="review-item" data-review-activity-index="${index}">
          <div class="review-q">${studentReportEscape(`Question ${index + 1}: ${q.question}`)}</div>
          <div class="review-a"><strong>Your answer:</strong> ${studentReportEscape(selectedText)}</div>
        </div>
      `;
    }).join("");
  }

  async function studentSubmitActivity(fromTimer = false) {
    const btn = document.getElementById("studentSubmitActivityBtn");
    const oldText = btn ? btn.textContent : "Submit activity";

    try {
      const state = window.studentClassActivityState;
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again.");

      const questions = state.activityQuestions || [];

      if (!fromTimer) {
        for (const q of questions) {
          if (!state.activityAnswers[q.id]) {
            throw new Error("Please answer all questions before submitting.");
          }
        }
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Submitting...";
      }

      const answersPayload = questions
        .map((q) => ({
          question_id: q.id,
          selected_option: state.activityAnswers[q.id] || ""
        }))
        .filter((row) => row.question_id && row.selected_option);

      const result = await studentInvokeHistoryManager({
        action: "submit_activity_attempt",
        user_id: user.id,
        activity_id: state.currentActivity?.id,
        answers: answersPayload
      });

      state.currentAttemptId = result?.attempt?.id || state.currentAttemptId;
      state.currentAttemptExpiresAt = result?.attempt?.expires_at || state.currentAttemptExpiresAt;

      studentStopTimer();
      studentShowReportsView("studentActivitySubmittedView");
      await studentLoadReportsFeed();
    } catch (err) {
      console.error("studentSubmitActivity failed:", err);
      alert(err?.message || "Could not submit this activity right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

