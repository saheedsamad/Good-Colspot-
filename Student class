  function studentRenderFormQuestion() {
    const state = window.studentClassActivityState;
    const questions = state.formQuestions || [];
    const index = Number(state.currentFormIndex || 0);
    const q = questions[index];
    if (!q) return;

    const titleEl = document.getElementById("studentFormQuestionTitle");
    const helpEl = document.getElementById("studentFormQuestionHelp");
    const progressTextEl = document.getElementById("studentFormProgressText");
    const progressPercentEl = document.getElementById("studentFormProgressPercent");
    const progressBarEl = document.getElementById("studentFormProgressBar");
    const nextBtn = document.getElementById("studentFormNextBtn");

    if (titleEl) titleEl.textContent = q.question_text || q.question || "Question";

    if (helpEl) {
      const help = q.help_text || "";
      helpEl.textContent = help;
      helpEl.classList.toggle("hidden", !help);
    }

    const total = questions.length || 1;
    const percent = Math.round(((index + 1) / total) * 100);

    if (progressTextEl) progressTextEl.textContent = `Question ${index + 1} of ${total}`;
    if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
    if (progressBarEl) progressBarEl.style.width = `${percent}%`;
    if (nextBtn) nextBtn.textContent = index === total - 1 ? "Review" : "Next";

    studentHideFormQuestionBlocks();
    studentSetFieldNote("");

    const answer = state.formAnswers[q.id];
    const type = q.question_type;

    if (type === "short_answer") {
      const block = document.getElementById("studentFormShortAnswerBlock");
      const input = document.getElementById("studentFormShortAnswerInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.value = answer || "";
        input.placeholder = q.placeholder_text || "Type your answer";
      }
    } else if (type === "paragraph") {
      const block = document.getElementById("studentFormParagraphBlock");
      const input = document.getElementById("studentFormParagraphInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.value = answer || "";
        input.placeholder = q.placeholder_text || "Type your answer here";
      }
    } else if (type === "multiple_choice") {
      const block = document.getElementById("studentFormMultipleChoiceBlock");
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = studentEnsureArray(q.options_json).map((option) => `
          <div class="choice-option ${answer === option ? "active" : ""}" data-form-single-option="${studentReportEscape(option)}">
            <div class="choice-mark">•</div>
            <div class="choice-text">${studentReportEscape(option)}</div>
          </div>
        `).join("");
      }
    } else if (type === "checkboxes") {
      const block = document.getElementById("studentFormCheckboxBlock");
      const arr = Array.isArray(answer) ? answer : [];
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = studentEnsureArray(q.options_json).map((option) => `
          <div class="choice-option ${arr.includes(option) ? "active" : ""}" data-form-check-option="${studentReportEscape(option)}">
            <div class="choice-mark">✓</div>
            <div class="choice-text">${studentReportEscape(option)}</div>
          </div>
        `).join("");
      }
    } else if (type === "dropdown") {
      const block = document.getElementById("studentFormDropdownBlock");
      const input = document.getElementById("studentFormDropdownInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.innerHTML = `<option value="">Select an option</option>` +
          studentEnsureArray(q.options_json).map((option) => `
            <option value="${studentReportEscape(option)}" ${answer === option ? "selected" : ""}>${studentReportEscape(option)}</option>
          `).join("");
      }
    } else if (type === "yes_no") {
      const block = document.getElementById("studentFormYesNoBlock");
      const yesNoOptions = ["Yes", "No"];
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = yesNoOptions.map((option) => `
          <div class="choice-option ${answer === option ? "active" : ""}" data-form-single-option="${studentReportEscape(option)}">
            <div class="choice-mark">•</div>
            <div class="choice-text">${studentReportEscape(option)}</div>
          </div>
        `).join("");
      }
    } else if (type === "date") {
      const block = document.getElementById("studentFormDateBlock");
      const input = document.getElementById("studentFormDateInput");
      if (block) block.classList.remove("hidden");
      if (input) input.value = answer || "";
    } else if (type === "file_upload") {
      const block = document.getElementById("studentFormFileBlock");
      const rules = document.getElementById("studentFormFileRules");
      const fileInput = document.getElementById("studentFormFileInput");
      if (block) block.classList.remove("hidden");

      if (rules) {
        const types = studentEnsureArray(q.allowed_file_types).join(", ") || "Any allowed format";
        rules.textContent = `Allowed types: ${types}. Max files: ${q.max_files || 1}. Max size: ${q.max_file_size_mb || 5}MB each.`;
      }

      if (fileInput) {
        fileInput.value = "";
        fileInput.multiple = Number(q.max_files || 1) > 1;
      }

      if (Array.isArray(answer) && answer.length) {
        studentSetFieldNote(`${answer.length} file(s) selected.`);
      } else if (typeof answer === "string" && answer) {
        studentSetFieldNote("1 file selected.");
      }
    }

    if (q.is_required) {
      const note = document.getElementById("studentFormFieldNote");
      if (note) {
        note.textContent = `${note.textContent ? note.textContent + " " : ""}This question is required.`;
      }
    }
  }

  function studentValidateCurrentFormQuestion() {
    const q = studentGetCurrentFormQuestion();
    if (!q) return true;

    const answer = window.studentClassActivityState.formAnswers[q.id];

    if (!q.is_required) return true;

    if (q.question_type === "checkboxes") {
      return Array.isArray(answer) && answer.length > 0;
    }

    if (q.question_type === "file_upload") {
      if (Array.isArray(answer)) return answer.length > 0;
      return !!answer;
    }

    return !!studentNormalizeText(answer);
  }

  async function studentHandleFormFileSelection() {
    const q = studentGetCurrentFormQuestion();
    const input = document.getElementById("studentFormFileInput");
    if (!q || !input || !input.files) return;

    const files = Array.from(input.files || []);
    if (!files.length) return;

    const maxFiles = Number(q.max_files || 1);
    const maxMb = Number(q.max_file_size_mb || 5);
    const maxBytes = maxMb * 1024 * 1024;
    const allowed = studentEnsureArray(q.allowed_file_types);

    if (files.length > maxFiles) {
      alert(`You can only upload ${maxFiles} file(s) for this question.`);
      input.value = "";
      return;
    }

    for (const file of files) {
      if (file.size > maxBytes) {
        alert(`${file.name} is larger than ${maxMb}MB.`);
        input.value = "";
        return;
      }

      if (allowed.length) {
        const extension = "." + file.name.split(".").pop().toLowerCase();
        const mime = file.type || "";
        const matches = allowed.some((type) => {
          const t = String(type || "").toLowerCase();
          return t === mime.toLowerCase() || t === extension || t === file.name.toLowerCase();
        });

        if (!matches) {
          alert(`${file.name} is not an allowed file type.`);
          input.value = "";
          return;
        }
      }
    }

    const uploadedUrls = [];

    for (const file of files) {
      const fileExt = file.name.includes(".") ? file.name.split(".").pop() : "bin";
      const path = `student-form-uploads/${Date.now()}-${Math.random().toString(36).slice(2)}.${fileExt}`;

      const { error: uploadError } = await supabase.storage
        .from("form-uploads")
        .upload(path, file, { upsert: false });

      if (uploadError) {
        console.error("Form file upload failed:", uploadError);
        alert(uploadError.message || "Could not upload file.");
        return;
      }

      const { data: publicUrlData } = supabase.storage
        .from("form-uploads")
        .getPublicUrl(path);

      uploadedUrls.push(publicUrlData?.publicUrl || "");
    }

    studentSetCurrentFormValue(maxFiles > 1 ? uploadedUrls : uploadedUrls[0]);
    studentSetFieldNote(`${uploadedUrls.length} file(s) uploaded successfully.`);
  }

  function studentGoNextFormQuestion() {
    if (!studentValidateCurrentFormQuestion()) {
      alert("Please answer this required question before continuing.");
      return;
    }

    const state = window.studentClassActivityState;
    const total = (state.formQuestions || []).length;

    if (state.currentFormIndex >= total - 1) {
      studentRenderFormReview();
      studentShowReportsView("studentFormReviewView");
      return;
    }

    state.currentFormIndex += 1;
    studentRenderFormQuestion();
  }

  function studentGoPrevFormQuestion() {
    const state = window.studentClassActivityState;
    if (state.currentFormIndex > 0) {
      state.currentFormIndex -= 1;
      studentRenderFormQuestion();
    } else {
      studentShowReportsView("studentFormDetailsView");
    }
  }

  function studentFormatFormAnswerPreview(q, answer) {
    if (q.question_type === "checkboxes") {
      return Array.isArray(answer) && answer.length ? answer.join(", ") : "No answer";
    }

    if (q.question_type === "file_upload") {
      if (Array.isArray(answer) && answer.length) return `${answer.length} file(s) uploaded`;
      if (typeof answer === "string" && answer) return "1 file uploaded";
      return "No file uploaded";
    }

    return studentNormalizeText(answer) || "No answer";
  }

  function studentRenderFormReview() {
    const state = window.studentClassActivityState;
    const wrap = document.getElementById("studentFormReviewList");
    if (!wrap) return;

    wrap.innerHTML = (state.formQuestions || []).map((q, index) => {
      const answer = state.formAnswers[q.id];
      return `
        <div class="review-item" data-review-form-index="${index}">
          <div class="review-q">${studentReportEscape(q.question_text || "Question")}</div>
          <div class="review-a"><strong>Your answer:</strong> ${studentReportEscape(studentFormatFormAnswerPreview(q, answer))}</div>
        </div>
      `;
    }).join("");
  }

  async function studentStartForm() {
    const state = window.studentClassActivityState;
    if (!state.currentForm) return;

    state.currentFormIndex = 0;
    studentRenderFormQuestion();
    studentShowReportsView("studentFormQuestionView");
  }

  async function studentSubmitForm() {
    const state = window.studentClassActivityState;
    const btn = document.getElementById("studentSubmitFormBtn");
    const oldText = btn ? btn.textContent : "Submit form";

    try {
      const missingRequired = (state.formQuestions || []).filter((q) => {
        if (!q.is_required) return false;
        const answer = state.formAnswers[q.id];

        if (q.question_type === "checkboxes") {
          return !(Array.isArray(answer) && answer.length);
        }

        if (q.question_type === "file_upload") {
          if (Array.isArray(answer)) return !answer.length;
          return !answer;
        }

        return !studentNormalizeText(answer);
      });

      if (missingRequired.length) {
        alert("Please answer all required questions before submitting.");
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Submitting...";
      }

      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again.");

      const form = state.currentForm;
      if (!form?.id) throw new Error("Missing form.");

      const answerMap = {};
      (state.formQuestions || []).forEach((q) => {
        answerMap[q.id] = state.formAnswers[q.id];
      });

      const payload = {
        action: "submit_form",
        form_id: form.id,
        submitted_by: user.id,
        answers: answerMap
      };

      console.log("STUDENT FORM SUBMIT BODY:", payload);

      const { data, error } = await supabase.functions.invoke("form-submit-manager", {
        body: payload
      });

      console.log("STUDENT FORM SUBMIT RAW DATA:", data);
      console.log("STUDENT FORM SUBMIT RAW ERROR:", error);

      if (error) {
        throw new Error(error.message || "Edge Function returned a non-2xx status code");
      }

      if (!data?.ok) {
        throw new Error(data?.error || "Could not submit form.");
      }

      state.currentFormResponseId = data?.response?.id || null;

      studentShowReportsView("studentFormSubmittedView");
      await studentLoadReportsFeed();
    } catch (err) {
      console.error("studentSubmitForm failed:", err);
      alert(err?.message || "Could not submit this form right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  function studentHandleFeedOpen(itemId, itemType) {
    if (itemType === "form") {
      studentOpenFormDetails(itemId);
      return;
    }

    if (itemType === "announcement") {
      studentOpenAnnouncementDetails(itemId);
      return;
    }

    studentOpenActivityIntro(itemId);
  }

  function studentBackToReportsHome() {
    studentStopTimer();
    studentShowReportsView("studentReportsHomeView");
    studentLoadReportsFeed();
  }

  function studentBindReportsEvents() {
    const tabsWrap = document.getElementById("studentReportsTabs");
    if (tabsWrap && !tabsWrap.dataset.bound) {
      tabsWrap.dataset.bound = "1";
      tabsWrap.addEventListener("click", (e) => {
        const btn = e.target.closest(".reports-tab");
        if (!btn) return;

        tabsWrap.querySelectorAll(".reports-tab").forEach((el) => el.classList.remove("active"));
        btn.classList.add("active");

        window.studentClassActivityState.currentFilter = btn.getAttribute("data-feed-filter") || "all";
        studentRenderFeedList();
      });
    }

    const filterSelect = document.getElementById("studentReportsFilterSelect");
    if (filterSelect && !filterSelect.dataset.bound) {
      filterSelect.dataset.bound = "1";
      filterSelect.addEventListener("change", () => {
        window.studentClassActivityState.currentFilter = filterSelect.value || "all";

        const tabsWrapEl = document.getElementById("studentReportsTabs");
        if (tabsWrapEl) {
          tabsWrapEl.querySelectorAll(".reports-tab").forEach((el) => el.classList.remove("active"));
        }

        studentRenderFeedList();
      });
    }

    const searchInput = document.getElementById("studentReportsSearchInput");
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.dataset.bound = "1";
      searchInput.addEventListener("input", () => {
        window.studentClassActivityState.searchTerm = searchInput.value || "";
        studentRenderFeedList();
      });
    }

    const feedWrap = document.getElementById("studentReportsFeedList");
    if (feedWrap && !feedWrap.dataset.bound) {
      feedWrap.dataset.bound = "1";
      feedWrap.addEventListener("click", (e) => {
        const openBtn = e.target.closest("[data-item-open]");
        const card = e.target.closest(".feed-card");

        if (openBtn) {
          const itemId = openBtn.getAttribute("data-item-open");
          const itemType = openBtn.getAttribute("data-item-type");
          const item = (window.studentClassActivityState.feedItems || []).find((x) => x.id === itemId && x.item_type === itemType);

          if (!item) return;

          if (item.item_type === "announcement") {
            studentHandleFeedOpen(itemId, itemType);
            return;
          }

          if (!(item.status === "submitted" || item.status === "closed" || item.status === "expired")) {
            studentHandleFeedOpen(itemId, itemType);
          }
          return;
        }

        if (card) {
          const itemId = card.getAttribute("data-item-id");
          const itemType = card.getAttribute("data-item-type");
          const item = (window.studentClassActivityState.feedItems || []).find((x) => x.id === itemId && x.item_type === itemType);

          if (!item) return;

          if (item.item_type === "announcement") {
            studentHandleFeedOpen(itemId, itemType);
            return;
          }

          if (!(item.status === "submitted" || item.status === "closed" || item.status === "expired")) {
            studentHandleFeedOpen(itemId, itemType);
          }
        }
      });
    }

    document.querySelectorAll("#studentActivityIntroView .panel-back-btn").forEach((btn) => {
      if (!btn.dataset.bound) {
        btn.dataset.bound = "1";
        btn.addEventListener("click", studentBackToReportsHome);
      }
    });

    const homeBackBtn = document.querySelector("#studentReportsHomeView .uh-back-btn");
    if (homeBackBtn && !homeBackBtn.dataset.bound) {
      homeBackBtn.dataset.bound = "1";
      homeBackBtn.addEventListener("click", () => {
        if (typeof showScreen === "function") {
          showScreen("home");
        } else {
          window.history.back();
        }
      });
    }

    const formDetailsBack = document.querySelector("#studentFormDetailsView .panel-back-btn");
    if (formDetailsBack && !formDetailsBack.dataset.bound) {
      formDetailsBack.dataset.bound = "1";
      formDetailsBack.addEventListener("click", studentBackToReportsHome);
    }

    const activityQuestionBack = document.querySelector("#studentActivityQuestionView .panel-back-btn");
    if (activityQuestionBack && !activityQuestionBack.dataset.bound) {
      activityQuestionBack.dataset.bound = "1";
      activityQuestionBack.addEventListener("click", () => {
        if (window.studentClassActivityState.currentActivityIndex > 0) {
          window.studentClassActivityState.currentActivityIndex -= 1;
          studentRenderActivityQuestion();
        } else {
          studentShowReportsView("studentActivityIntroView");
          studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
        }
      });
    }

    const activityReviewBack = document.querySelector("#studentActivityReviewView .panel-back-btn");
    if (activityReviewBack && !activityReviewBack.dataset.bound) {
      activityReviewBack.dataset.bound = "1";
      activityReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentActivityQuestionView");
        studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
      });
    }

    const formQuestionBack = document.querySelector("#studentFormQuestionView .panel-back-btn");
    if (formQuestionBack && !formQuestionBack.dataset.bound) {
      formQuestionBack.dataset.bound = "1";
      formQuestionBack.addEventListener("click", () => {
        if (window.studentClassActivityState.currentFormIndex > 0) {
          window.studentClassActivityState.currentFormIndex -= 1;
          studentRenderFormQuestion();
        } else {
          studentShowReportsView("studentFormDetailsView");
        }
      });
    }

    const formReviewBack = document.querySelector("#studentFormReviewView .panel-back-btn");
    if (formReviewBack && !formReviewBack.dataset.bound) {
      formReviewBack.dataset.bound = "1";
      formReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentFormQuestionView");
      });
    }

    const startActivityBtn = document.getElementById("studentStartActivityBtn");
    if (startActivityBtn && !startActivityBtn.dataset.bound) {
      startActivityBtn.dataset.bound = "1";
      startActivityBtn.addEventListener("click", studentStartActivity);
    }

    const activityPrevBtn = document.getElementById("studentActivityPrevBtn");
    if (activityPrevBtn && !activityPrevBtn.dataset.bound) {
      activityPrevBtn.dataset.bound = "1";
      activityPrevBtn.addEventListener("click", studentGoPrevQuestion);
    }

    const activityNextBtn = document.getElementById("studentActivityNextBtn");
    if (activityNextBtn && !activityNextBtn.dataset.bound) {
      activityNextBtn.dataset.bound = "1";
      activityNextBtn.addEventListener("click", studentGoNextQuestion);
    }

    const activityOptionList = document.getElementById("studentActivityOptionList");
    if (activityOptionList && !activityOptionList.dataset.bound) {
      activityOptionList.dataset.bound = "1";
      activityOptionList.addEventListener("click", (e) => {
        const option = e.target.closest("[data-activity-option]");
        if (!option) return;

        const state = window.studentClassActivityState;
        const q = (state.activityQuestions || [])[state.currentActivityIndex];
        if (!q) return;

        state.activityAnswers[q.id] = option.getAttribute("data-activity-option");
        studentRenderActivityQuestion();
      });
    }

    const submitActivityBtn = document.getElementById("studentSubmitActivityBtn");
    if (submitActivityBtn && !submitActivityBtn.dataset.bound) {
      submitActivityBtn.dataset.bound = "1";
      submitActivityBtn.addEventListener("click", () => studentSubmitActivity(false));
    }

    const activitySubmittedBack = document.querySelector("#studentActivitySubmittedView .primary-btn");
    if (activitySubmittedBack && !activitySubmittedBack.dataset.bound) {
      activitySubmittedBack.dataset.bound = "1";
      activitySubmittedBack.addEventListener("click", studentBackToReportsHome);
    }

    const startFormBtn = document.getElementById("studentStartFormBtn");
    if (startFormBtn && !startFormBtn.dataset.bound) {
      startFormBtn.dataset.bound = "1";
      startFormBtn.addEventListener("click", studentStartForm);
    }

    const formPrevBtn = document.getElementById("studentFormPrevBtn");
    if (formPrevBtn && !formPrevBtn.dataset.bound) {
      formPrevBtn.dataset.bound = "1";
      formPrevBtn.addEventListener("click", studentGoPrevFormQuestion);
    }

    const formNextBtn = document.getElementById("studentFormNextBtn");
    if (formNextBtn && !formNextBtn.dataset.bound) {
      formNextBtn.dataset.bound = "1";
      formNextBtn.addEventListener("click", studentGoNextFormQuestion);
    }

    const formMulti = document.getElementById("studentFormMultipleChoiceBlock");
    if (formMulti && !formMulti.dataset.bound) {
      formMulti.dataset.bound = "1";
      formMulti.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-single-option]");
        if (!option) return;
        studentSetCurrentFormValue(option.getAttribute("data-form-single-option"));
        studentRenderFormQuestion();
      });
    }

    const formYesNo = document.getElementById("studentFormYesNoBlock");
    if (formYesNo && !formYesNo.dataset.bound) {
      formYesNo.dataset.bound = "1";
      formYesNo.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-single-option]");
        if (!option) return;
        studentSetCurrentFormValue(option.getAttribute("data-form-single-option"));
        studentRenderFormQuestion();
      });
    }

    const formChecks = document.getElementById("studentFormCheckboxBlock");
    if (formChecks && !formChecks.dataset.bound) {
      formChecks.dataset.bound = "1";
      formChecks.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-check-option]");
        if (!option) return;

        const q = studentGetCurrentFormQuestion();
        if (!q) return;

        const value = option.getAttribute("data-form-check-option");
        const current = Array.isArray(window.studentClassActivityState.formAnswers[q.id])
          ? [...window.studentClassActivityState.formAnswers[q.id]]
          : [];

        const idx = current.indexOf(value);
        if (idx >= 0) current.splice(idx, 1);
        else current.push(value);

        studentSetCurrentFormValue(current);
        studentRenderFormQuestion();
      });
    }

    const shortInput = document.getElementById("studentFormShortAnswerInput");
    if (shortInput && !shortInput.dataset.bound) {
      shortInput.dataset.bound = "1";
      shortInput.addEventListener("input", () => {
        studentSetCurrentFormValue(shortInput.value || "");
      });
    }

    const paragraphInput = document.getElementById("studentFormParagraphInput");
    if (paragraphInput && !paragraphInput.dataset.bound) {
      paragraphInput.dataset.bound = "1";
      paragraphInput.addEventListener("input", () => {
        studentSetCurrentFormValue(paragraphInput.value || "");
      });
    }

    const dropdownInput = document.getElementById("studentFormDropdownInput");
    if (dropdownInput && !dropdownInput.dataset.bound) {
      dropdownInput.dataset.bound = "1";
      dropdownInput.addEventListener("change", () => {
        studentSetCurrentFormValue(dropdownInput.value || "");
      });
    }

    const dateInput = document.getElementById("studentFormDateInput");
    if (dateInput && !dateInput.dataset.bound) {
      dateInput.dataset.bound = "1";
      dateInput.addEventListener("change", () => {
        studentSetCurrentFormValue(dateInput.value || "");
      });
    }

    const chooseFileBtn = document.getElementById("studentFormChooseFileBtn");
    const fileInput = document.getElementById("studentFormFileInput");

    if (chooseFileBtn && fileInput && !chooseFileBtn.dataset.bound) {
      chooseFileBtn.dataset.bound = "1";
      chooseFileBtn.addEventListener("click", () => fileInput.click());
    }

    if (fileInput && !fileInput.dataset.bound) {
      fileInput.dataset.bound = "1";
      fileInput.addEventListener("change", studentHandleFormFileSelection);
    }

    const formReviewList = document.getElementById("studentFormReviewList");
    if (formReviewList && !formReviewList.dataset.bound) {
      formReviewList.dataset.bound = "1";
      formReviewList.addEventListener("click", (e) => {
        const item = e.target.closest("[data-review-form-index]");
        if (!item) return;
        const idx = Number(item.getAttribute("data-review-form-index"));
        if (!Number.isFinite(idx)) return;
        window.studentClassActivityState.currentFormIndex = idx;
        studentRenderFormQuestion();
        studentShowReportsView("studentFormQuestionView");
      });
    }

    const submitFormBtn = document.getElementById("studentSubmitFormBtn");
    if (submitFormBtn && !submitFormBtn.dataset.bound) {
      submitFormBtn.dataset.bound = "1";
      submitFormBtn.addEventListener("click", studentSubmitForm);
    }

    const formSubmittedBack = document.querySelector("#studentFormSubmittedView .primary-btn");
    if (formSubmittedBack && !formSubmittedBack.dataset.bound) {
      formSubmittedBack.dataset.bound = "1";
      formSubmittedBack.addEventListener("click", studentBackToReportsHome);
    }
  }

  function studentInitReportsScreen() {
    studentBindReportsEvents();
    studentShowReportsView("studentReportsHomeView");
    studentLoadReportsFeed();
  }

  window.studentInitReportsScreen = studentInitReportsScreen;
  window.studentLoadReportsFeed = studentLoadReportsFeed;
  window.studentBackToReportsHome = studentBackToReportsHome;
  window.studentOpenActivityIntro = studentOpenActivityIntro;
  window.studentOpenFormDetails = studentOpenFormDetails;
  window.studentOpenAnnouncementDetails = studentOpenAnnouncementDetails;
</script>
