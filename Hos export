          <h1 class="page-title">Export Responses</h1>
          <p class="page-sub">Download the exact response data you want from this form.</p>
        </div>

        <div class="topbar-actions">
          <button class="ghost-btn" type="button" id="exportHistoryBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 8v5l3 2" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M20 12a8 8 0 1 1-2.34-5.66L20 8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Export History</span>
          </button>

          <button class="solid-btn" type="button" id="quickExportTopBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 4v10" stroke-width="2.2" stroke-linecap="round"></path>
              <path d="m8.5 10.5 3.5 3.5 3.5-3.5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 20h14" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            <span>Export</span>
          </button>
        </div>
      </div>

      <section class="export-screen" id="exportPlaceholder">
        <section class="hero-card">
          <div class="hero-label">Exporting this form</div>
          <h2 class="hero-title" id="exportFormTitle">hqsj</h2>
          <div class="hero-meta">
            <span id="exportAudienceMeta">Entrepreneurship 300</span>
            <span class="hero-dot" id="exportResponsesMeta">3 responses</span>
            <span class="hero-dot" id="exportIdentityMeta">Use login identity</span>
            <span class="hero-dot" id="exportLastSubmissionMeta">Last submission: Apr 3, 2026</span>
          </div>
        </section>

        <section class="section-card">
          <div class="section-head">
