  .format-badge.csv{background:#3385ff}
  .format-badge.pdf{background:#df6666}
  .format-badge.word{background:#4f74e2}

  .export-format-name{
    font-size:16px;
    font-weight:900;
    color:#16213d;
  }

  .export-filter-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:14px;
  }

  .export-field-label{
    display:block;
    margin:0 0 8px;
    font-size:14px;
    font-weight:900;
    color:#6d7895;
  }

  .export-input,
  .export-select{
    width:100%;
    min-height:58px;
    border-radius:18px;
    border:1.5px solid #dfe7fb;
    background:#fff;
    padding:0 18px;
    font-size:16px;
    font-weight:800;
    color:#16213d;
    outline:none;
  }

  .export-input:focus,
  .export-select:focus{
    border-color:#8db1ff;
    box-shadow:0 0 0 4px rgba(47,107,255,.08);
  }

  .export-preview-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:18px;
    margin-bottom:18px;
  }

  .export-preview-file{
    display:flex;
    align-items:flex-start;
    gap:14px;
  }

  .export-preview-icon{
    width:52px;
    height:52px;
    border-radius:16px;
    background:#edf8f1;
    border:1px solid #d5efde;
    display:grid;
    place-items:center;
    flex:0 0 auto;
  }

  .export-preview-icon svg{
    width:26px;
    height:26px;
    stroke:#1e9a59;
  }

  .export-preview-title{
    margin:0;
    font-size:22px;
    line-height:1.1;
    font-weight:950;
    color:#16213d;
  }

  .export-preview-sub{
    margin:6px 0 0;
    font-size:15px;
    color:#6d7895;
    font-weight:700;
    line-height:1.5;
  }

  .export-preview-stats{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:14px;
    margin-bottom:18px;
  }

  .export-stat{
    border:1px solid #ebf0fb;
    background:#f8faff;
    border-radius:22px;
    padding:18px;
  }

  .export-stat-label{
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:.04em;
    color:#6d7895;
    font-weight:950;
    margin-bottom:8px;
  }

  .export-stat-value{
    font-size:34px;
    line-height:1;
    font-weight:950;
    color:#16213d;
    letter-spacing:-.04em;
  }

  .export-chip-row{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:18px;
  }

  .export-chip{
    min-height:38px;
    border-radius:999px;
    border:1px solid #dfe7fb;
    background:#fff;
    padding:0 14px;
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:14px;
    font-weight:900;
    color:#16213d;
  }

  .export-chip svg{
    width:14px;
    height:14px;
    stroke:#5d7bdb;
  }

  .export-table-wrap{
    width:100%;
    overflow:auto;
    border:1px solid #dfe7fb;
    border-radius:22px;
    background:#fff;
  }

  .export-table{
    width:100%;
    min-width:980px;
    border-collapse:separate;
    border-spacing:0;
  }

  .export-table thead th{
    background:#f5f8ff;
    color:#627297;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:.04em;
    font-weight:950;
    padding:18px 16px;
    text-align:left;
    border-bottom:1px solid #dfe7fb;
    white-space:nowrap;
  }

  .export-table tbody td{
    padding:18px 16px;
    border-bottom:1px solid #edf2fb;
    font-size:15px;
    font-weight:800;
    color:#16213d;
    vertical-align:top;
  }

  .export-table tbody tr:last-child td{
    border-bottom:none;
  }

  .export-answer{
    color:#6d7895;
    font-weight:700;
    line-height:1.5;
  }

  .export-custom-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:18px;
  }

  .export-builder-box{
    border:1px solid #dfe7fb;
    border-radius:24px;
    background:#fff;
    padding:20px;
  }

  .export-builder-title{
    margin:0 0 8px;
    font-size:20px;
    line-height:1.1;
    font-weight:950;
    color:#16213d;
  }

  .export-builder-sub{
    margin:0 0 18px;
    font-size:15px;
    line-height:1.5;
    color:#6d7895;
    font-weight:700;
  }

  .export-builder-group{
    margin-bottom:18px;
  }

  .export-builder-group:last-child{
    margin-bottom:0;
  }

  .export-builder-label{
    margin-bottom:12px;
    font-size:14px;
    text-transform:uppercase;
    letter-spacing:.04em;
    color:#6d7895;
    font-weight:950;
  }

  .export-check-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
  }

  .export-check{
    min-height:56px;
    border:1px solid #dfe7fb;
    border-radius:18px;
    background:#fff;
    padding:0 14px;
    display:flex;
    align-items:center;
    gap:12px;
  }

  .export-check input{
    width:18px;
    height:18px;
    accent-color:#2f6bff;
    flex:0 0 auto;
  }

  .export-check span{
    font-size:15px;
    line-height:1.25;
    font-weight:850;
    color:#16213d;
  }

  .export-custom-preview{
    border:1px dashed #d7e2ff;
    background:#fbfcff;
    border-radius:22px;
    padding:20px;
  }

  .export-custom-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    margin-bottom:14px;
  }

  .export-custom-title{
    margin:0;
    font-size:19px;
    font-weight:950;
    color:#16213d;
  }

  .export-custom-note{
    margin:0;
    color:#6d7895;
    font-size:15px;
    font-weight:700;
  }

  .export-mini-chip{
    display:inline-flex;
    align-items:center;
    min-height:30px;
    padding:0 12px;
    border-radius:999px;
    background:#eef4ff;
    color:#4d73d9;
    font-size:13px;
    font-weight:900;
    margin:0 8px 8px 0;
  }

  .export-warm-note{
    margin-top:16px;
    min-height:52px;
    border-radius:18px;
    background:#fff8ea;
    border:1px solid #f6dfb6;
    color:#8b671a;
    display:flex;
    align-items:center;
    padding:0 16px;
    font-size:14px;
    font-weight:900;
  }

  @media (max-width:1320px){
    .export-choice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .export-format-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .export-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .export-custom-grid{grid-template-columns:1fr}
  }

  @media (max-width:760px){
    .export-card,
    .export-hero{padding:20px}
    .export-choice-grid,
    .export-format-grid,
    .export-filter-grid,
    .export-preview-stats,
    .export-check-grid{grid-template-columns:1fr}
    .export-preview-top,
    .export-custom-top,
    .export-card-head{flex-direction:column;align-items:flex-start}
    .export-title{font-size:24px}
  }
</style>

