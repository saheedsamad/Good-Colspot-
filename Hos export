  }

  .export-choice.active{
    border-color:#7ca6ff;
    background:#eef4ff;
    box-shadow:inset 0 0 0 1px rgba(47,107,255,.08);
  }

  .export-choice-top{
    display:flex;
    align-items:center;
    gap:12px;
  }

  .export-choice-icon{
    width:42px;
    height:42px;
    border-radius:14px;
    background:#eef4ff;
    display:grid;
    place-items:center;
    flex:0 0 auto;
  }

  .export-choice.active .export-choice-icon{
    background:#dce8ff;
  }

  .export-choice-icon svg{
    width:22px;
    height:22px;
    stroke:#5577db;
  }

  .export-choice-name{
    font-size:17px;
    line-height:1.15;
    font-weight:950;
    color:#16213d;
  }

  .export-choice-desc{
    font-size:15px;
    line-height:1.55;
    color:#6d7895;
    font-weight:700;
  }

  .export-format-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:14px;
  }

  .export-format{
    min-height:66px;
    border-radius:20px;
    border:1.5px solid #dfe7fb;
    background:#fff;
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 18px;
    cursor:pointer;
    transition:.18s ease;
  }

  .export-format:hover{
    border-color:#bcd0ff;
    box-shadow:0 8px 18px rgba(47,107,255,.06);
  }

  .export-format.active{
    border-color:#7ca6ff;
    background:#eef4ff;
  }

  .format-badge{
