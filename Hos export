      <div class="export-head" style="margin-bottom:14px;">
        <div>
          <h3 class="export-title" style="font-size:22px;">Build a custom table export</h3>
          <p class="export-sub">Choose the exact columns you want inside your exported file.</p>
        </div>
      </div>

      <div class="export-custom-layout">
