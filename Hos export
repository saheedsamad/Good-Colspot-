  .export-card-head{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:18px;
    margin-bottom:18px;
  }

  .export-card-title{
    margin:0;
    font-size:24px;
    line-height:1.1;
    font-weight:950;
    color:#16213d;
    letter-spacing:-.02em;
  }

  .export-card-sub{
    margin:8px 0 0;
    font-size:15px;
    line-height:1.5;
    color:#6d7895;
    font-weight:700;
  }

  .export-actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }

  .export-btn,
  .export-btn-outline{
