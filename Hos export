<section class="placeholder-card export-section-card" id="exportPlaceholder">
  <style>
    #exportPlaceholder{
      display:block;
      padding:0;
      background:transparent;
      border:none;
      box-shadow:none;
    }

    .export-module{
      display:flex;
      flex-direction:column;
      gap:18px;
      color:#16213d;
    }

    .export-box{
      background:#fff;
      border:1px solid #e2e9fb;
      border-radius:22px;
      box-shadow:0 10px 28px rgba(37,60,120,.06);
      padding:18px;
    }

    .export-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:14px;
      flex-wrap:wrap;
    }

    .export-title{
      margin:0;
      font-size:24px;
      line-height:1.1;
      font-weight:950;
      letter-spacing:-.02em;
      color:#16213d;
    }

    .export-sub{
      margin:8px 0 0;
      color:#6d7895;
      font-size:14px;
      line-height:1.5;
      font-weight:700;
    }

    .export-mini-meta{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:10px;
      color:#6d7895;
      font-size:13px;
      font-weight:800;
    }

    .export-mini-meta span:not(:first-child)::before{
      content:"•";
      margin-right:8px;
    }

    .export-top-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .export-btn,
    .export-btn-light{
      min-height:44px;
      border-radius:14px;
      padding:0 14px;
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      transition:.18s ease;
    }

    .export-btn{
      border:none;
      color:#fff;
      background:linear-gradient(90deg,#2f6bff 0%,#5d94ff 100%);
      box-shadow:0 10px 20px rgba(47,107,255,.18);
    }

    .export-btn:hover{
      transform:translateY(-1px);
    }

    .export-btn-light{
      border:1px solid #e2e9fb;
      background:#fff;
      color:#16213d;
    }

    .export-btn-light:hover{
      background:#f8faff;
    }

    .export-btn:disabled,
    .export-btn-light:disabled{
      opacity:.65;
      cursor:not-allowed;
      transform:none;
    }

    .export-btn svg,
    .export-btn-light svg{
      width:16px;
      height:16px;
      stroke:currentColor;
      flex:0 0 auto;
    }

    .export-choice-grid{
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:12px;
    }

    .export-choice{
      border:1.5px solid #e2e9fb;
      background:#fff;
      border-radius:18px;
      padding:14px;
      display:flex;
      flex-direction:column;
      gap:10px;
      cursor:pointer;
      transition:.18s ease;
      min-height:128px;
    }

    .export-choice:hover{
      border-color:#bdd0ff;
      box-shadow:0 8px 18px rgba(47,107,255,.07);
      transform:translateY(-1px);
    }

    .export-choice.active{
      background:#eef4ff;
      border-color:#7ea8ff;
      box-shadow:inset 0 0 0 1px rgba(47,107,255,.08);
    }

    .export-choice-top{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .export-choice-icon{
      width:38px;
      height:38px;
      border-radius:12px;
      background:#edf3ff;
      display:grid;
      place-items:center;
      flex:0 0 auto;
    }

    .export-choice.active .export-choice-icon{
      background:#dfeaff;
    }

    .export-choice-icon svg{
      width:20px;
      height:20px;
      stroke:#5577db;
    }

    .export-choice-name{
      font-size:16px;
      line-height:1.15;
      font-weight:950;
      color:#16213d;
    }

    .export-choice-desc{
      font-size:13px;
      line-height:1.45;
      color:#6d7895;
      font-weight:700;
    }

    .export-format-row{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    .export-format{
      min-height:42px;
      border-radius:14px;
      border:1.5px solid #e2e9fb;
      background:#fff;
      padding:0 14px;
      display:flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
      transition:.18s ease;
    }

    .export-format:hover{
      border-color:#bdd0ff;
      background:#f8fbff;
    }

    .export-format.active{
      background:#eef4ff;
      border-color:#7ea8ff;
    }

    .export-format-badge{
      min-width:34px;
      height:26px;
      border-radius:9px;
      display:grid;
      place-items:center;
      color:#fff;
      font-size:10px;
      font-weight:1000;
      letter-spacing:.03em;
      padding:0 6px;
    }

    .export-format-badge.excel{background:#1f9b59;}
    .export-format-badge.csv{background:#3385ff;}
    .export-format-badge.pdf{background:#e06969;}
    .export-format-badge.word{background:#4c74e2;}

    .export-format span:last-child{
      font-size:14px;
      font-weight:900;
      color:#16213d;
    }

    .export-filters{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
    }

    .export-field label{
      display:block;
      margin:0 0 7px;
      color:#6d7895;
      font-size:13px;
      font-weight:900;
    }

    .export-input,
    .export-select{
      width:100%;
      min-height:46px;
      border-radius:14px;
      border:1.5px solid #e2e9fb;
      background:#fff;
      padding:0 14px;
      font-size:14px;
      font-weight:800;
      color:#16213d;
      outline:none;
    }

    .export-input:focus,
    .export-select:focus{
      border-color:#8fb2ff;
      box-shadow:0 0 0 4px rgba(47,107,255,.08);
    }

    .export-preview-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:14px;
      flex-wrap:wrap;
    }

    .export-preview-title{
      margin:0;
      font-size:20px;
      line-height:1.1;
      font-weight:950;
      color:#16213d;
    }

    .export-preview-sub{
      margin:6px 0 0;
      color:#6d7895;
      font-size:14px;
      line-height:1.5;
      font-weight:700;
    }

    .export-stats{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:12px;
      margin:14px 0;
    }

    .export-stat{
      border:1px solid #edf1fb;
      background:#f8faff;
      border-radius:18px;
      padding:14px;
    }

    .export-stat-label{
      color:#6d7895;
      font-size:12px;
      font-weight:950;
      text-transform:uppercase;
      letter-spacing:.04em;
      margin-bottom:8px;
    }

    .export-stat-value{
      font-size:28px;
      line-height:1;
      font-weight:950;
      color:#16213d;
      letter-spacing:-.03em;
    }

    .export-chip-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-bottom:14px;
    }

    .export-chip{
      min-height:34px;
      border-radius:999px;
      border:1px solid #e2e9fb;
      background:#fff;
      padding:0 12px;
      display:inline-flex;
      align-items:center;
      gap:7px;
      color:#16213d;
      font-size:13px;
      font-weight:900;
    }

    .export-chip svg{
      width:13px;
      height:13px;
      stroke:#5b7cdc;
      flex:0 0 auto;
    }

    .export-table-wrap{
      width:100%;
      overflow:auto;
      border:1px solid #e2e9fb;
      border-radius:18px;
      background:#fff;
    }

    .export-table{
      width:100%;
      min-width:860px;
      border-collapse:separate;
      border-spacing:0;
    }

    .export-table thead th{
      background:#f5f8ff;
      color:#647497;
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:950;
      padding:15px 14px;
      text-align:left;
      border-bottom:1px solid #e2e9fb;
      white-space:nowrap;
    }

    .export-table tbody td{
      padding:15px 14px;
      border-bottom:1px solid #eef2fb;
      font-size:14px;
      font-weight:800;
      color:#16213d;
      vertical-align:top;
    }

    .export-table tbody tr:last-child td{
      border-bottom:none;
    }

    .export-answer{
      color:#6d7895;
      font-weight:700;
      line-height:1.45;
    }

    .export-empty{
      text-align:center;
      color:#6d7895;
      font-weight:800;
      padding:18px;
    }

    .export-custom-layout{
      display:grid;
      grid-template-columns:1.15fr .85fr;
      gap:14px;
    }

    .export-custom-box{
      border:1px solid #e2e9fb;
      border-radius:18px;
      background:#fff;
      padding:16px;
    }

    .export-custom-title{
      margin:0 0 8px;
      font-size:18px;
      line-height:1.1;
      font-weight:950;
      color:#16213d;
    }

    .export-custom-sub{
      margin:0 0 14px;
      color:#6d7895;
      font-size:14px;
      line-height:1.5;
      font-weight:700;
    }

    .export-custom-group{
      margin-bottom:14px;
    }

    .export-custom-group:last-child{
      margin-bottom:0;
    }

    .export-custom-group-label{
      margin-bottom:10px;
      color:#6d7895;
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:950;
    }

    .export-check-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .export-check{
      min-height:50px;
      border:1px solid #e2e9fb;
      border-radius:14px;
      background:#fff;
      padding:0 12px;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .export-check input{
      width:17px;
      height:17px;
      accent-color:#2f6bff;
      flex:0 0 auto;
    }

    .export-check span{
      color:#16213d;
      font-size:14px;
      line-height:1.25;
      font-weight:850;
    }

    .export-custom-preview{
      border:1px dashed #d7e2ff;
      background:#fbfcff;
      border-radius:16px;
      padding:16px;
    }

    .export-selected-wrap{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:12px 0 14px;
    }

    .export-mini-chip{
      display:inline-flex;
      align-items:center;
      min-height:28px;
      padding:0 10px;
      border-radius:999px;
      background:#eef4ff;
      color:#4d73d9;
      font-size:12px;
      font-weight:900;
    }

    .export-note{
      min-height:44px;
      border-radius:14px;
      background:#fff8ea;
      border:1px solid #f3dfb7;
      color:#8b671a;
      display:flex;
      align-items:center;
      padding:0 14px;
      font-size:13px;
      font-weight:900;
    }

    @media (max-width:1200px){
      .export-choice-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
      .export-custom-layout{grid-template-columns:1fr;}
    }

    @media (max-width:900px){
      .export-choice-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
      .export-filters{grid-template-columns:repeat(2,minmax(0,1fr));}
      .export-stats{grid-template-columns:1fr;}
    }

    @media (max-width:640px){
      .export-choice-grid,
      .export-filters,
      .export-check-grid{
        grid-template-columns:1fr;
      }

      .export-preview-top,
      .export-head{
        flex-direction:column;
        align-items:flex-start;
      }

      .export-title{
        font-size:22px;
      }
    }
  </style>

  <div class="export-module">
    <div class="export-box">
      <div class="export-head">
        <div>
          <h2 class="export-title">Export Responses</h2>
          <p class="export-sub" id="exportFormTitle">Form</p>
          <div class="export-mini-meta">
            <span id="exportAudienceMeta">—</span>
            <span id="exportResponsesMeta">0 responses</span>
            <span id="exportIdentityMeta">Use login identity</span>
            <span id="exportLastSubmissionMeta">Last submission: —</span>
          </div>
        </div>

        <div class="export-top-actions">
          <button class="export-btn-light" type="button" id="exportHistoryBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 8v5l3 2" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M20 12a8 8 0 1 1-2.34-5.66L20 8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Export History</span>
          </button>

          <button class="export-btn" type="button" id="topExportBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 4v10" stroke-width="2.2" stroke-linecap="round"></path>
              <path d="m8.5 10.5 3.5 3.5 3.5-3.5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 20h14" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            <span>Export</span>
          </button>
        </div>
      </div>
    </div>

    <div class="export-box">
      <div class="export-head" style="margin-bottom:14px;">
        <div>
          <h3 class="export-title" style="font-size:22px;">What do you want to export?</h3>
          <p class="export-sub">Choose the exact response view you want to export.</p>
        </div>
      </div>

      <div class="export-choice-grid">
        <article class="export-choice active" data-export-choice="all">
          <div class="export-choice-top">
            <div class="export-choice-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M8 7h8M8 11h8M8 15h5" stroke-width="2.2" stroke-linecap="round"></path>
                <path d="M6 3.5h8l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 5 20V5a1.5 1.5 0 0 1 1.5-1.5Z" stroke-width="2"></path>
              </svg>
            </div>
            <div class="export-choice-name">All responses</div>
          </div>
          <div class="export-choice-desc">Export every submitted response for this form in one table.</div>
        </article>

        <article class="export-choice" data-export-choice="filtered">
          <div class="export-choice-top">
            <div class="export-choice-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 6h16l-6 7v5l-4 2v-7L4 6Z" stroke-width="2.2" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="export-choice-name">Filtered responses</div>
          </div>
          <div class="export-choice-desc">Export only matching responses by programme, level or search.</div>
        </article>

        <article class="export-choice" data-export-choice="single">
          <div class="export-choice-top">
            <div class="export-choice-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke-width="2.2"></path>
                <path d="M4 20a8 8 0 0 1 16 0" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
            </div>
            <div class="export-choice-name">Single respondent</div>
          </div>
          <div class="export-choice-desc">Export one selected person’s response details.</div>
        </article>

        <article class="export-choice" data-export-choice="summary">
          <div class="export-choice-top">
            <div class="export-choice-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 12V3a9 9 0 1 1-6.36 2.64L12 12Z" stroke-width="2.2" stroke-linejoin="round"></path>
                <path d="M12 12h9" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
            </div>
            <div class="export-choice-name">Question summary</div>
          </div>
          <div class="export-choice-desc">Export grouped answer breakdowns and summary counts.</div>
        </article>

        <article class="export-choice" data-export-choice="custom">
          <div class="export-choice-top">
            <div class="export-choice-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M5 12h14M12 5v14" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
            </div>
            <div class="export-choice-name">Custom table</div>
          </div>
          <div class="export-choice-desc">Choose your own columns and build the exact export table you want.</div>
        </article>
      </div>
    </div>

    <div class="export-box">
      <div class="export-head" style="margin-bottom:14px;">
        <div>
          <h3 class="export-title" style="font-size:22px;">Select file format</h3>
          <p class="export-sub">Choose the file type for the selected export option.</p>
        </div>
      </div>

      <div class="export-format-row">
        <article class="export-format active" data-format="excel">
          <div class="export-format-badge excel">XLSX</div>
          <span>Excel (.xlsx)</span>
        </article>

        <article class="export-format" data-format="csv">
          <div class="export-format-badge csv">CSV</div>
          <span>CSV (.csv)</span>
        </article>

        <article class="export-format" data-format="pdf">
          <div class="export-format-badge pdf">PDF</div>
          <span>PDF (.pdf)</span>
        </article>

        <article class="export-format" data-format="word">
          <div class="export-format-badge word">DOCX</div>
          <span>Word (.docx)</span>
        </article>
      </div>
    </div>

    <div class="export-box" id="exportFiltersCard">
      <div class="export-head" style="margin-bottom:14px;">
        <div>
          <h3 class="export-title" style="font-size:22px;">Filters</h3>
          <p class="export-sub">Use filters for filtered responses or single respondent export.</p>
        </div>
      </div>

      <div class="export-filters">
        <div class="export-field">
          <label for="exportSearchInput">Search</label>
          <input class="export-input" id="exportSearchInput" type="text" placeholder="Search by name, matric number, programme or level">
        </div>

        <div class="export-field">
          <label for="exportProgrammeSelect">Programme</label>
          <select class="export-select" id="exportProgrammeSelect">
            <option value="">All programmes</option>
          </select>
        </div>

        <div class="export-field">
          <label for="exportLevelSelect">Level</label>
          <select class="export-select" id="exportLevelSelect">
            <option value="">All levels</option>
          </select>
        </div>

        <div class="export-field">
          <label for="exportIdentitySelect">Identity</label>
          <select class="export-select" id="exportIdentitySelect">
            <option value="">All responses</option>
            <option value="identified">Identified only</option>
            <option value="anonymous">Anonymous only</option>
          </select>
        </div>
      </div>
    </div>

    <div class="export-box" id="exportPreviewCard">
      <div class="export-preview-top">
        <div>
          <h3 class="export-preview-title" id="exportPreviewTitle">Export preview</h3>
          <p class="export-preview-sub" id="exportPreviewSubtitle">This preview shows exactly what will be exported.</p>
        </div>

        <div class="export-top-actions">
          <button class="export-btn-light" type="button" id="refreshExportPreviewBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M20 12a8 8 0 1 1-2.34-5.66L20 8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M20 4v4h-4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Refresh</span>
          </button>

          <button class="export-btn" type="button" id="downloadExportBtn">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 4v10" stroke-width="2.2" stroke-linecap="round"></path>
              <path d="m8.5 10.5 3.5 3.5 3.5-3.5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 20h14" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            <span>Export Excel</span>
          </button>
        </div>
      </div>

      <div class="export-stats">
        <div class="export-stat">
          <div class="export-stat-label">Rows to export</div>
          <div class="export-stat-value" id="exportRowsCount">0</div>
        </div>

        <div class="export-stat">
          <div class="export-stat-label">Columns selected</div>
          <div class="export-stat-value" id="exportColumnsCount">0</div>
        </div>

        <div class="export-stat">
          <div class="export-stat-label">Export type</div>
          <div class="export-stat-value" id="exportTypeLabel">All</div>
        </div>
      </div>

      <div class="export-chip-row" id="exportColumnsChips"></div>

      <div class="export-table-wrap">
        <table class="export-table">
          <thead>
            <tr id="exportTableHeadRow"></tr>
          </thead>
          <tbody id="exportPreviewTableBody">
            <tr>
              <td class="export-answer">Preview will load here.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

