import { serve } from "https://deno.land/std@0.224.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { GoogleAuth } from "npm:google-auth-library@9";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

function json(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json",
    },
  });
}

function mustEnv(name: string) {
  const value = Deno.env.get(name);
  if (!value) throw new Error(`Missing env: ${name}`);
  return value;
}

function cleanText(value: unknown) {
  return String(value ?? "").trim();
}

function normalizeText(value: unknown) {
  return cleanText(value).replace(/\s+/g, " ");
}

function normalizeUpper(value: unknown) {
  return normalizeText(value).toUpperCase();
}

function normalizeLevelValue(value: unknown) {
  return normalizeUpper(value)
    .replace(/\bLEVEL\b/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function isUuid(value: string) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    value,
  );
}

function shortBody(message: string) {
  const clean = String(message || "").trim();
  if (clean.length <= 120) return clean;
  return clean.slice(0, 117) + "...";
}

function parseDateOrNull(value: unknown) {
  const v = cleanText(value);
  return v || null;
}

function ensureStringArray(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  return value.map((v) => normalizeText(v)).filter(Boolean);
}

function tokenStart(value: string) {
  return String(value || "").slice(0, 20);
}

function isUnregisteredResponse(responseText: string) {
  const t = String(responseText || "").toUpperCase();
  return t.includes("UNREGISTERED") || t.includes("REGISTRATION_TOKEN_NOT_REGISTERED");
}

type ProgrammeTarget = {
  programme_name?: string;
  levels?: unknown;
};

type MatchedStudent = {
  user_id: string;
  full_name?: string | null;
  school_name?: string | null;
  programme?: string | null;
  level?: string | null;
};

type PushTokenRow = {
  user_id: string;
  token: string;
  platform?: string | null;
};

const ALLOWED_AUDIENCE_MODES = new Set(["all_students", "programme_filter"]);
const ALLOWED_STATUSES = new Set(["draft", "published", "scheduled", "archived"]);

const SUPABASE_URL = mustEnv("SUPABASE_URL");
const SERVICE_ROLE_KEY = mustEnv("SUPABASE_SERVICE_ROLE_KEY");
const FIREBASE_SERVICE_ACCOUNT_JSON = mustEnv("FIREBASE_SERVICE_ACCOUNT_JSON");

const firebaseServiceAccount = JSON.parse(FIREBASE_SERVICE_ACCOUNT_JSON);

const auth = new GoogleAuth({
  credentials: firebaseServiceAccount,
  scopes: ["https://www.googleapis.com/auth/firebase.messaging"],
});

async function getAccessToken(): Promise<string> {
  const client = await auth.getClient();
  const tokenResponse = await client.getAccessToken();
  if (!tokenResponse.token) throw new Error("No access token from Google");
  return tokenResponse.token;
}

function normalizeProgrammeTargets(value: unknown) {
  if (!Array.isArray(value)) return [];

  return value
    .map((item: ProgrammeTarget) => {
      const programmeName = normalizeUpper(item?.programme_name);
      const levels = ensureStringArray(item?.levels).map((v) => normalizeLevelValue(v));

      return {
        programme_name: programmeName,
        levels,
      };
    })
    .filter((item) => item.programme_name);
}

async function getActor(
  sb: ReturnType<typeof createClient>,
  body: Record<string, unknown>,
) {
  const hosAdminId = cleanText(body.hos_admin_id);
  const formAgentId = cleanText(body.form_agent_id);

  if (!hosAdminId && !formAgentId) {
    throw new Error("hos_admin_id or form_agent_id is required.");
  }

  if (hosAdminId) {
    if (!isUuid(hosAdminId)) throw new Error("Invalid hos_admin_id.");

    const { data, error } = await sb
      .from("hos_accounts")
      .select("id, full_name, school_name, is_active")
      .eq("id", hosAdminId)
      .maybeSingle();

    if (error) throw new Error(error.message);
    if (!data) throw new Error("HOS account not found.");
    if (!data.is_active) throw new Error("This HOS account is disabled.");

    return {
      actor_type: "hos",
      actor_id: data.id,
      actor_name: data.full_name || "",
      school_name: data.school_name || "",
      hos_admin_id: data.id,
    };
  }

  if (!isUuid(formAgentId)) throw new Error("Invalid form_agent_id.");

  const { data, error } = await sb
    .from("form_agent_accounts")
    .select("id, hos_admin_id, full_name, school_name, is_active")
    .eq("id", formAgentId)
    .maybeSingle();

  if (error) throw new Error(error.message);
  if (!data) throw new Error("Form agent account not found.");
  if (!data.is_active) throw new Error("This form agent account is disabled.");

  return {
    actor_type: "form_agent",
    actor_id: data.id,
    actor_name: data.full_name || "",
    school_name: data.school_name || "",
    hos_admin_id: data.hos_admin_id || null,
  };
}

async function getManagedAnnouncement(
  sb: ReturnType<typeof createClient>,
  announcementId: string,
  actor: { school_name: string },
) {
  if (!isUuid(announcementId)) {
    throw new Error("Invalid announcement_id.");
  }

  const { data, error } = await sb
    .from("school_announcements")
    .select("*")
    .eq("id", announcementId)
    .eq("school_name", actor.school_name)
    .maybeSingle();

  if (error) throw new Error(error.message);
  if (!data) throw new Error("Announcement not found.");

  return data;
}

async function writeHosHistory(
  sb: ReturnType<typeof createClient>,
  actor: {
    actor_type: string;
    actor_id: string;
    actor_name: string;
    school_name: string;
  },
  activityType: string,
  title: string,
  description: string,
  entityType: string,
  entityId: string | null,
  metaJson: Record<string, unknown> = {},
) {
  try {
    const { error } = await sb.from("hos_history").insert({
      school_name: actor.school_name,
      activity_type: activityType,
      title,
      description,
      entity_type: entityType,
      entity_id: entityId || null,
      actor_user_id: actor.actor_id || null,
      actor_name: actor.actor_name || null,
      actor_role: actor.actor_type || null,
      meta_json: metaJson,
    });

    if (error) {
      console.error("hos_history insert error:", error);
    }
  } catch (err) {
    console.error("hos_history fatal insert error:", err);
  }
}

async function getMatchedStudents(
  sb: ReturnType<typeof createClient>,
  schoolName: string,
  audienceMode: string,
  programmeTargets: unknown,
): Promise<MatchedStudent[]> {
  const normalizedSchool = normalizeUpper(schoolName);
  const normalizedTargets = normalizeProgrammeTargets(programmeTargets);

  const { data: students, error } = await sb
    .from("student_accounts")
    .select("user_id, full_name, school_name, programme, level");

  if (error) throw new Error(`student_accounts select failed: ${error.message}`);

  const schoolStudents = (students || []).filter((row: any) => {
    return !!row.user_id && normalizeUpper(row.school_name) === normalizedSchool;
  });

  if (audienceMode !== "programme_filter") {
    return schoolStudents;
  }

  return schoolStudents.filter((row: any) => {
    const studentProgramme = normalizeUpper(row.programme);
    const studentLevel = normalizeLevelValue(row.level);

    return normalizedTargets.some((target) => {
      if (target.programme_name !== studentProgramme) return false;
      if (!Array.isArray(target.levels) || !target.levels.length) return false;
      return target.levels.includes(studentLevel);
    });
  });
}

async function createAnnouncementNotifications(
  sb: ReturnType<typeof createClient>,
  users: MatchedStudent[],
  announcement: any,
) {
  const uniqueUsers = new Map<string, MatchedStudent>();

  for (const row of users) {
    const uid = cleanText(row.user_id);
    if (!uid) continue;
    if (!uniqueUsers.has(uid)) uniqueUsers.set(uid, row);
  }

  const usersToNotify = [...uniqueUsers.values()];
  if (!usersToNotify.length) return 0;

  const notifTitle =
    normalizeText(announcement.notification_title) || normalizeText(announcement.title);
  const notifBody =
    normalizeText(announcement.notification_body) || normalizeText(announcement.body);

  const rows = usersToNotify.map((row) => ({
    announcement_id: announcement.id,
    user_id: row.user_id,
    title: notifTitle,
    message: notifBody,
    school_name: row.school_name || announcement.school_name || null,
    programme: row.programme || null,
    level: row.level || null,
  }));

  const { error } = await sb.from("announcement_notifications").insert(rows);
  if (error) {
    throw new Error(`announcement_notifications insert failed: ${error.message}`);
  }

  return rows.length;
}

async function createPushBatch(
  sb: ReturnType<typeof createClient>,
  relatedId: string | null,
) {
  const { data, error } = await sb
    .from("push_delivery_batches")
    .insert({
      source: "announcement-manager",
      event_type: "announcement",
      related_id: relatedId,
      recipient_users: 0,
      active_tokens: 0,
      ios_tokens: 0,
      android_tokens: 0,
      other_tokens: 0,
      success_count: 0,
      fail_count: 0,
    })
    .select("id")
    .single();

  if (error) {
    console.error("push_delivery_batches insert error:", error);
    return null;
  }

  return data?.id || null;
}

async function updatePushBatch(
  sb: ReturnType<typeof createClient>,
  batchId: string | null,
  values: Record<string, unknown>,
) {
  if (!batchId) return;

  const { error } = await sb
    .from("push_delivery_batches")
    .update(values)
    .eq("id", batchId);

  if (error) {
    console.error("push_delivery_batches update error:", error);
  }
}

async function insertPushLog(
  sb: ReturnType<typeof createClient>,
  row: Record<string, unknown>,
) {
  const { error } = await sb.from("push_delivery_logs").insert(row);
  if (error) {
    console.error("push_delivery_logs insert error:", error);
  }
}

async function deactivateDeadToken(
  sb: ReturnType<typeof createClient>,
  token: string,
) {
  const { error } = await sb
    .from("user_push_tokens")
    .update({
      is_active: false,
      last_seen_at: new Date().toISOString(),
    })
    .eq("token", token);

  if (error) {
    console.error("Failed to deactivate dead token:", error);
  }
}

async function sendPushForAnnouncement(
  sb: ReturnType<typeof createClient>,
  users: MatchedStudent[],
  announcement: any,
) {
  const recipientUserIds = [...new Set(users.map((row) => row.user_id).filter(Boolean))];

  let tokens: PushTokenRow[] = [];
  let successCount = 0;
  let failCount = 0;

  const debug: Record<string, unknown> = {
    recipient_user_ids: recipientUserIds,
    token_rows: [],
    token_counts: {},
    send_attempts: [],
  };

  const batchId = await createPushBatch(sb, announcement?.id ?? null);

  if (recipientUserIds.length > 0) {
    const { data: tokenRows, error: tokenError } = await sb
      .from("user_push_tokens")
      .select("user_id, token, platform")
      .in("user_id", recipientUserIds)
      .eq("is_active", true);

    if (tokenError) throw new Error(`user_push_tokens select failed: ${tokenError.message}`);

    tokens = (tokenRows || []).filter((row: any) => !!row.token);

    debug.token_rows = tokens.map((t) => ({
      user_id: t.user_id,
      platform: t.platform,
      token_start: tokenStart(t.token),
    }));

    const iosCount = tokens.filter((t) => String(t.platform || "").toLowerCase() === "ios").length;
    const androidCount = tokens.filter((t) => String(t.platform || "").toLowerCase() === "android").length;
    const otherCount = tokens.length - iosCount - androidCount;

    debug.token_counts = {
      total: tokens.length,
      ios: iosCount,
      android: androidCount,
      other: otherCount,
    };

    await updatePushBatch(sb, batchId, {
      recipient_users: recipientUserIds.length,
      active_tokens: tokens.length,
      ios_tokens: iosCount,
      android_tokens: androidCount,
      other_tokens: otherCount,
    });

    console.log("Raw push token rows:", debug.token_rows);
    console.log("Announcement push token counts:", debug.token_counts);

    if (tokens.length > 0) {
      const accessToken = await getAccessToken();
      const url =
        `https://fcm.googleapis.com/v1/projects/${firebaseServiceAccount.project_id}/messages:send`;

      const tokenMap = new Map<string, Array<{ token: string; platform?: string | null }>>();
      for (const row of tokens) {
        const uid = String(row.user_id || "");
        if (!uid) continue;
        if (!tokenMap.has(uid)) tokenMap.set(uid, []);
        tokenMap.get(uid)!.push({
          token: String(row.token || "").trim(),
          platform: row.platform ?? null,
        });
      }

      const notifTitle =
        normalizeText(announcement.notification_title) || normalizeText(announcement.title);
      const notifBody =
        normalizeText(announcement.notification_body) || normalizeText(announcement.body);
      const bodyPreview = shortBody(notifBody);

      for (const user of users) {
        const uid = String(user.user_id || "").trim();
        if (!uid) continue;

        const userTokens = tokenMap.get(uid) || [];

        for (const row of userTokens) {
          if (!row.token) continue;

          const platform = String(row.platform || "").toLowerCase();

          const message: Record<string, unknown> = {
            token: row.token,
            notification: {
              title: notifTitle,
              body: bodyPreview,
            },
            data: {
              type: "announcement",
              announcement_id: String(announcement.id),
              screen: "announcements",
              title: notifTitle,
              message: notifBody,
              announcement_title: normalizeText(announcement.title),
              announcement_body: normalizeText(announcement.body),
              link_url: cleanText(announcement.link_url),
              image_url: cleanText(announcement.image_url),
            },
          };

          if (platform === "android") {
            message.android = {
              priority: "high",
              notification: {
                sound: "default",
              },
            };
          }

          if (platform === "ios") {
            message.apns = {
              headers: {
                "apns-priority": "10",
                "apns-push-type": "alert",
              },
              payload: {
                aps: {
                  alert: {
                    title: notifTitle,
                    body: bodyPreview,
                  },
                  sound: "default",
                  badge: 1,
                },
              },
            };
          }

          const attemptInfo: Record<string, unknown> = {
            user_id: uid,
            platform,
            token_start: tokenStart(row.token),
            has_apns: !!message.apns,
            has_android: !!message.android,
          };

          console.log("Sending announcement push:", attemptInfo);

          const res = await fetch(url, {
            method: "POST",
            headers: {
              Authorization: `Bearer ${accessToken}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ message }),
          });

          const responseText = await res.text();
          attemptInfo.http_ok = res.ok;
          attemptInfo.response = responseText;

          if (res.ok) {
            successCount++;
            attemptInfo.status = "success";
            console.log("FCM announcement push success:", attemptInfo);

            await insertPushLog(sb, {
              source: "announcement-manager",
              event_type: "announcement",
              related_id: announcement?.id ?? null,
              user_id: uid,
              platform: platform || null,
              token_start: tokenStart(row.token),
              status: "success",
              http_ok: true,
              firebase_response: responseText,
              error_message: null,
              title: notifTitle,
              body_preview: bodyPreview,
            });
          } else {
            failCount++;
            attemptInfo.status = "error";
            console.error("FCM announcement push error:", attemptInfo);

            await insertPushLog(sb, {
              source: "announcement-manager",
              event_type: "announcement",
              related_id: announcement?.id ?? null,
              user_id: uid,
              platform: platform || null,
              token_start: tokenStart(row.token),
              status: "error",
              http_ok: false,
              firebase_response: responseText,
              error_message: responseText,
              title: notifTitle,
              body_preview: bodyPreview,
            });

            if (isUnregisteredResponse(responseText)) {
              await deactivateDeadToken(sb, row.token);
            }
          }

          (debug.send_attempts as any[]).push(attemptInfo);
        }
      }
    }
  }

  await updatePushBatch(sb, batchId, {
    success_count: successCount,
    fail_count: failCount,
  });

  return {
    batch_id: batchId,
    recipient_users: recipientUserIds.length,
    active_tokens: tokens.length,
    success_count: successCount,
    fail_count: failCount,
    debug,
  };
}

serve(async (req) => {
  try {
    if (req.method === "OPTIONS") return json({ ok: true });
    if (req.method !== "POST") return json({ ok: false, error: "POST only" }, 405);

    const sb = createClient(SUPABASE_URL, SERVICE_ROLE_KEY, {
      auth: { persistSession: false },
    });

    const body = await req.json().catch(() => ({}));
    const action = cleanText(body.action).toLowerCase();

    if (!action) {
      return json({ ok: false, error: "action is required" }, 400);
    }

    const actor = await getActor(sb, body);

    if (!actor.school_name) {
      return json({ ok: false, error: "Actor school_name is missing." }, 400);
    }

    if (action === "preview_matched_students") {
      const audienceMode = cleanText(body.audience_mode || "all_students");
      const programmeTargets = normalizeProgrammeTargets(body.programme_targets);

      if (!ALLOWED_AUDIENCE_MODES.has(audienceMode)) {
        return json({ ok: false, error: "Invalid audience_mode" }, 400);
      }

      const matchedStudents = await getMatchedStudents(
        sb,
        actor.school_name,
        audienceMode,
        programmeTargets,
      );

      return json({
        ok: true,
        matched_students_count: matchedStudents.length,
        matched_students: matchedStudents,
        audience_mode: audienceMode,
        programme_targets: programmeTargets,
      });
    }

    if (action === "create_announcement") {
      const title = normalizeText(body.title);
      const messageBody = normalizeText(body.body);
      const notificationTitle = normalizeText(body.notification_title);
      const notificationBody = normalizeText(body.notification_body);
      const linkUrl = cleanText(body.link_url);
      const linkLabel = normalizeText(body.link_label);
      const imageUrl = cleanText(body.image_url);
      const fileUrl = cleanText(body.file_url);
      const audienceMode = cleanText(body.audience_mode || "all_students");
      const programmeTargets = normalizeProgrammeTargets(body.programme_targets);
      const status = cleanText(body.status || "draft");
      const scheduledAt = parseDateOrNull(body.scheduled_at);

      if (!title) return json({ ok: false, error: "title is required" }, 400);
      if (!messageBody) return json({ ok: false, error: "body is required" }, 400);
      if (!ALLOWED_AUDIENCE_MODES.has(audienceMode)) {
        return json({ ok: false, error: "Invalid audience_mode" }, 400);
      }
      if (!ALLOWED_STATUSES.has(status)) {
        return json({ ok: false, error: "Invalid status" }, 400);
      }

      const insertPayload: Record<string, unknown> = {
        school_name: actor.school_name,
        title,
        body: messageBody,
        notification_title: notificationTitle || null,
        notification_body: notificationBody || null,
        link_url: linkUrl || null,
        link_label: linkLabel || null,
        image_url: imageUrl || null,
        file_url: fileUrl || null,
        audience_mode: audienceMode,
        programme_targets: programmeTargets,
        status,
        scheduled_at: scheduledAt,
        created_by_admin_id: actor.actor_id,
        created_by_admin_name: actor.actor_name,
        created_by_role: actor.actor_type,
        is_active: true,
      };

      if (status === "published") {
        insertPayload.published_at = new Date().toISOString();
      }

      const { data: inserted, error } = await sb
        .from("school_announcements")
        .insert(insertPayload)
        .select("*")
        .single();

      if (error) return json({ ok: false, error: error.message }, 500);

      await writeHosHistory(
        sb,
        actor,
        status === "published" ? "ANNOUNCEMENT_PUBLISHED" : "ANNOUNCEMENT_CREATED",
        `${title}`,
        status === "published" ? "Announcement published." : "Announcement draft created.",
        "announcement",
        inserted.id,
        {
          announcement_id: inserted.id,
          audience_mode: audienceMode,
          programme_targets: programmeTargets,
          status,
          notification_title: notificationTitle || null,
        },
      );

      let matchedStudents: MatchedStudent[] = [];
      let inAppCount = 0;
      let push: any = {
        batch_id: null,
        recipient_users: 0,
        active_tokens: 0,
        success_count: 0,
        fail_count: 0,
        debug: {
          recipient_user_ids: [],
          token_rows: [],
          token_counts: {},
          send_attempts: [],
        },
      };

      let insertedWithCount = inserted;

      if (status === "published") {
        matchedStudents = await getMatchedStudents(
          sb,
          actor.school_name,
          audienceMode,
          programmeTargets,
        );
        inAppCount = await createAnnouncementNotifications(sb, matchedStudents, inserted);
        push = await sendPushForAnnouncement(sb, matchedStudents, inserted);
        insertedWithCount = {
          ...inserted,
          matched_students_count: matchedStudents.length,
        };
      } else {
        insertedWithCount = {
          ...inserted,
          matched_students_count: 0,
        };
      }

      return json({
        ok: true,
        message: status === "published"
          ? "Announcement published successfully."
          : "Announcement created successfully.",
        announcement: insertedWithCount,
        notifications: {
          announcement_notifications_count: inAppCount,
        },
        push,
      });
    }

    if (action === "update_announcement") {
      const announcementId = cleanText(body.announcement_id);
      if (!announcementId) {
        return json({ ok: false, error: "announcement_id is required" }, 400);
      }

      const existing = await getManagedAnnouncement(sb, announcementId, actor);

      const title = normalizeText(body.title ?? existing.title);
      const messageBody = normalizeText(body.body ?? existing.body);
      const notificationTitle = normalizeText(
        body.notification_title ?? existing.notification_title,
      );
      const notificationBody = normalizeText(
        body.notification_body ?? existing.notification_body,
      );
      const linkUrl = cleanText(body.link_url ?? existing.link_url);
      const linkLabel = normalizeText(body.link_label ?? existing.link_label);
      const imageUrl = cleanText(body.image_url ?? existing.image_url);
      const fileUrl = cleanText(body.file_url ?? existing.file_url);
      const audienceMode = cleanText(body.audience_mode || existing.audience_mode || "all_students");
      const programmeTargets = normalizeProgrammeTargets(
        body.programme_targets ?? existing.programme_targets ?? [],
      );
      const status = cleanText(body.status || existing.status);
      const scheduledAt = parseDateOrNull(body.scheduled_at ?? existing.scheduled_at);

      if (!title) return json({ ok: false, error: "title is required" }, 400);
      if (!messageBody) return json({ ok: false, error: "body is required" }, 400);
      if (!ALLOWED_AUDIENCE_MODES.has(audienceMode)) {
        return json({ ok: false, error: "Invalid audience_mode" }, 400);
      }
      if (!ALLOWED_STATUSES.has(status)) {
        return json({ ok: false, error: "Invalid status" }, 400);
      }

      const updatePayload: Record<string, unknown> = {
        title,
        body: messageBody,
        notification_title: notificationTitle || null,
        notification_body: notificationBody || null,
        link_url: linkUrl || null,
        link_label: linkLabel || null,
        image_url: imageUrl || null,
        file_url: fileUrl || null,
        audience_mode: audienceMode,
        programme_targets: programmeTargets,
        status,
        scheduled_at: scheduledAt,
        updated_at: new Date().toISOString(),
      };

      const { data: updated, error } = await sb
        .from("school_announcements")
        .update(updatePayload)
        .eq("id", announcementId)
        .select("*")
        .single();

      if (error) return json({ ok: false, error: error.message }, 500);

      await writeHosHistory(
        sb,
        actor,
        "ANNOUNCEMENT_UPDATED",
        `${title}`,
        "Announcement updated.",
        "announcement",
        announcementId,
        {
          announcement_id: announcementId,
          audience_mode: audienceMode,
          programme_targets: programmeTargets,
          status,
          notification_title: notificationTitle || null,
        },
      );

      const matchedStudents = await getMatchedStudents(
        sb,
        actor.school_name,
        audienceMode,
        programmeTargets,
      );

      return json({
        ok: true,
        message: "Announcement updated successfully.",
        announcement: {
          ...updated,
          matched_students_count: matchedStudents.length,
        },
      });
    }

    if (action === "list_announcements") {
      const statusFilter = cleanText(body.status);

      let query = sb
        .from("school_announcements")
        .select("*")
        .eq("school_name", actor.school_name)
        .order("updated_at", { ascending: false });

      if (statusFilter) {
        query = query.eq("status", statusFilter);
      }

      const { data, error } = await query;
      if (error) return json({ ok: false, error: error.message }, 500);

      const announcements = await Promise.all(
        (data || []).map(async (row: any) => {
          const matchedStudents = await getMatchedStudents(
            sb,
            row.school_name || actor.school_name,
            cleanText(row.audience_mode || "all_students"),
            row.programme_targets || [],
          );

          return {
            ...row,
            matched_students_count: matchedStudents.length,
          };
        }),
      );

      return json({
        ok: true,
        announcements,
      });
    }

    if (action === "get_announcement") {
      const announcementId = cleanText(body.announcement_id);
      if (!announcementId) {
        return json({ ok: false, error: "announcement_id is required" }, 400);
      }

      const announcement = await getManagedAnnouncement(sb, announcementId, actor);
      const matchedStudents = await getMatchedStudents(
        sb,
        announcement.school_name || actor.school_name,
        cleanText(announcement.audience_mode || "all_students"),
        announcement.programme_targets || [],
      );

      return json({
        ok: true,
        announcement: {
          ...announcement,
          matched_students_count: matchedStudents.length,
        },
      });
    }

    if (action === "publish_announcement") {
      const announcementId = cleanText(body.announcement_id);
      if (!announcementId) {
        return json({ ok: false, error: "announcement_id is required" }, 400);
      }

      const existing = await getManagedAnnouncement(sb, announcementId, actor);

      const notificationTitle = normalizeText(
        body.notification_title ?? existing.notification_title,
      );
      const notificationBody = normalizeText(
        body.notification_body ?? existing.notification_body,
      );

      const { data: updated, error } = await sb
        .from("school_announcements")
        .update({
          status: "published",
          notification_title: notificationTitle || existing.notification_title || null,
          notification_body: notificationBody || existing.notification_body || null,
          published_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        })
        .eq("id", announcementId)
        .select("*")
        .single();

      if (error) return json({ ok: false, error: error.message }, 500);

      const matchedStudents = await getMatchedStudents(
        sb,
        actor.school_name,
        cleanText(updated.audience_mode || "all_students"),
        updated.programme_targets,
      );

      const inAppCount = await createAnnouncementNotifications(sb, matchedStudents, updated);
      const push = await sendPushForAnnouncement(sb, matchedStudents, updated);

      await writeHosHistory(
        sb,
        actor,
        "ANNOUNCEMENT_PUBLISHED",
        `${existing.title}`,
        "Announcement published.",
        "announcement",
        announcementId,
        {
          announcement_id: announcementId,
          matched_students_count: matchedStudents.length,
          notification_title: updated.notification_title || null,
        },
      );

      return json({
        ok: true,
        message: "Announcement published successfully.",
        announcement: {
          ...updated,
          matched_students_count: matchedStudents.length,
        },
        notifications: {
          announcement_notifications_count: inAppCount,
        },
        push,
      });
    }

    if (action === "archive_announcement") {
      const announcementId = cleanText(body.announcement_id);
      if (!announcementId) {
        return json({ ok: false, error: "announcement_id is required" }, 400);
      }

      const existing = await getManagedAnnouncement(sb, announcementId, actor);

      const { data: updated, error } = await sb
        .from("school_announcements")
        .update({
          status: "archived",
          archived_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        })
        .eq("id", announcementId)
        .select("*")
        .single();

      if (error) return json({ ok: false, error: error.message }, 500);

      const matchedStudents = await getMatchedStudents(
        sb,
        actor.school_name,
        cleanText(updated.audience_mode || "all_students"),
        updated.programme_targets,
      );

      await writeHosHistory(
        sb,
        actor,
        "ANNOUNCEMENT_ARCHIVED",
        `${existing.title}`,
        "Announcement archived.",
        "announcement",
        announcementId,
        { announcement_id: announcementId },
      );

      return json({
        ok: true,
        message: "Announcement archived successfully.",
        announcement: {
          ...updated,
          matched_students_count: matchedStudents.length,
        },
      });
    }

    if (action === "delete_announcement") {
      const announcementId = cleanText(body.announcement_id);
      if (!announcementId) {
        return json({ ok: false, error: "announcement_id is required" }, 400);
      }

      const existing = await getManagedAnnouncement(sb, announcementId, actor);

      const { error } = await sb
        .from("school_announcements")
        .delete()
        .eq("id", announcementId);

      if (error) return json({ ok: false, error: error.message }, 500);

      await writeHosHistory(
        sb,
        actor,
        "ANNOUNCEMENT_DELETED",
        `${existing.title}`,
        "Announcement deleted.",
        "announcement",
        announcementId,
        { announcement_id: announcementId },
      );

      return json({
        ok: true,
        message: "Announcement deleted successfully.",
      });
    }

    return json({ ok: false, error: `Unsupported action: ${action}` }, 400);
  } catch (e) {
    console.error("announcement-manager fatal error:", e);
    return json({ ok: false, error: String(e) }, 500);
  }
});




