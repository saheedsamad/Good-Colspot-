<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Report Agent Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#dbeafe;
      --blue-soft-2:#eff6ff;
      --purple:#5b5ce6;
      --purple-soft:#f3f0ff;
      --green:#16a34a;
      --green-soft:#ecfdf5;
      --orange:#ea580c;
      --orange-soft:#fff7ed;
      --red:#dc2626;
      --red-soft:#fef2f2;

      --bg:#f6f9ff;
      --card:#ffffff;
      --line:#e7edf7;
      --text:#0f172a;
      --muted:#667085;

      --shadow:0 18px 45px rgba(15,23,42,.08);
      --shadow-soft:0 10px 30px rgba(37,99,235,.10);

      --radius-xl:30px;
      --radius-lg:24px;
      --radius-md:18px;
      --radius-sm:14px;
      --nav-h:88px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:
        radial-gradient(860px 520px at 50% -8%, rgba(59,130,246,.20) 0%, rgba(59,130,246,0) 62%),
        radial-gradient(700px 420px at 0% 32%, rgba(191,219,254,.42) 0%, rgba(191,219,254,0) 68%),
        radial-gradient(700px 420px at 100% 34%, rgba(191,219,254,.34) 0%, rgba(191,219,254,0) 68%),
        linear-gradient(180deg,#f3f7ff 0%, #f8fbff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:
        calc(env(safe-area-inset-top) + 18px)
        16px
        calc(env(safe-area-inset-bottom) + var(--nav-h) + 20px);
      position:relative;
    }

    .glow{
      position:fixed;
      inset:auto -15% -10% -15%;
      height:36vh;
      pointer-events:none;
      z-index:0;
      background:
        radial-gradient(60% 100% at 50% 100%, rgba(255,255,255,.84) 0%, rgba(255,255,255,.32) 42%, rgba(255,255,255,0) 76%);
      filter:blur(8px);
    }

    .content{
      position:relative;
      z-index:1;
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:16px;
    }

    .brand{
      display:flex;
      align-items:flex-start;
      gap:12px;
      min-width:0;
    }

    .brand-logo{
      width:52px;
      height:52px;
      border-radius:18px;
      background:rgba(255,255,255,.88);
      border:1px solid rgba(255,255,255,.72);
      box-shadow:var(--shadow-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex-shrink:0;
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
    }

    .brand-logo img{
      width:42px;
      height:42px;
      object-fit:contain;
      display:block;
    }

    .brand-title{
      font-size:18px;
      font-weight:950;
      letter-spacing:-.03em;
      margin-top:2px;
      margin-bottom:2px;
      color:#10224a;
    }

    .brand-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .top-actions{
      position:relative;
      flex-shrink:0;
    }

    .avatar-btn{
      width:46px;
      height:46px;
      border:none;
      border-radius:999px;
      background:linear-gradient(135deg,#2563eb 0%, #10b981 100%);
      color:#fff;
      font-size:17px;
      font-weight:900;
      cursor:pointer;
      box-shadow:0 16px 34px rgba(37,99,235,.22);
    }

    .account-menu{
      position:absolute;
      top:54px;
      right:0;
      width:210px;
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.92);
      border-radius:20px;
      box-shadow:0 25px 50px rgba(15,23,42,.14);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      overflow:hidden;
      display:none;
      z-index:20;
    }

    .account-menu.show{
      display:block;
    }

    .menu-head{
      padding:14px 14px 12px;
      border-bottom:1px solid var(--line);
    }

    .menu-name{
      font-size:14px;
      font-weight:900;
      color:#111827;
      line-height:1.3;
    }

    .menu-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:4px;
      line-height:1.4;
    }

    .menu-btn{
      width:100%;
      border:none;
      background:#fff;
      text-align:left;
      padding:14px;
      font-size:13px;
      font-weight:800;
      color:#1f2937;
      cursor:pointer;
      border-bottom:1px solid var(--line);
    }

    .menu-btn:last-child{
      border-bottom:none;
    }

    .menu-btn.danger{
      color:#b91c1c;
      background:#fff;
    }

    .hero{
      background:
        linear-gradient(180deg, rgba(255,255,255,.94) 0%, rgba(255,255,255,.82) 100%);
      border:1px solid rgba(255,255,255,.78);
      border-radius:var(--radius-xl);
      padding:18px 16px 16px;
      box-shadow:0 24px 55px rgba(37,99,235,.10);
      margin-bottom:14px;
      position:relative;
      overflow:hidden;
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }

    .hero::before{
      content:"";
      position:absolute;
      width:170px;
      height:170px;
      border-radius:50%;
      right:-48px;
      top:-52px;
      background:radial-gradient(circle, rgba(37,99,235,.16) 0%, rgba(37,99,235,0) 70%);
      pointer-events:none;
    }

    .hero-title{
      font-size:18px;
      font-weight:950;
      line-height:1.18;
      letter-spacing:-.03em;
      margin:0 0 5px;
      color:#111827;
    }

    .hero-title span{
      color:var(--blue);
    }

    .hero-sub{
      font-size:13px;
      line-height:1.55;
      color:var(--muted);
      margin-bottom:12px;
      max-width:290px;
    }

    .pill-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:8px 12px;
      border-radius:999px;
      background:#eef4ff;
      color:var(--blue);
      font-size:11px;
      font-weight:800;
      line-height:1;
    }

    .message{
      display:none;
      padding:13px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.5;
      font-weight:800;
      margin-bottom:14px;
      box-shadow:var(--shadow);
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--red-soft);
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      background:var(--green-soft);
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin-bottom:14px;
    }

    .stat-card{
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.9);
      border-radius:22px;
      padding:15px 14px;
      box-shadow:var(--shadow);
    }

    .stat-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-bottom:12px;
    }

    .stat-label{
      font-size:12px;
      font-weight:800;
      color:#6b7280;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .stat-dot{
      width:10px;
      height:10px;
      border-radius:999px;
    }

    .dot-blue{ background:#3b82f6; }
    .dot-purple{ background:#8b5cf6; }
    .dot-orange{ background:#f59e0b; }
    .dot-green{ background:#22c55e; }

    .stat-value{
      font-size:29px;
      font-weight:950;
      line-height:1;
      letter-spacing:-.05em;
      color:#0f172a;
    }

    .quick-card{
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.9);
      border-radius:24px;
      padding:14px;
      box-shadow:var(--shadow);
      margin-bottom:14px;
    }

    .quick-btn{
      width:100%;
      border:none;
      border-radius:999px;
      min-height:56px;
      padding:14px 16px;
      background:linear-gradient(90deg,#2563eb 0%, #3b82f6 100%);
      color:#fff;
      font-size:15px;
      font-weight:900;
      letter-spacing:-.02em;
      cursor:pointer;
      box-shadow:0 18px 32px rgba(37,99,235,.22);
    }

    .quick-note{
      font-size:12px;
      line-height:1.45;
      text-align:center;
      color:#667085;
      margin-top:10px;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin:18px 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:17px;
      font-weight:950;
      letter-spacing:-.02em;
      color:#111827;
    }

    .section-action{
      border:none;
      background:#eef4ff;
      color:#2563eb;
      padding:10px 13px;
      border-radius:14px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .section-action.purple{
      background:#f3f0ff;
      color:#5b5ce6;
    }

    .list-card{
      background:rgba(255,255,255,.95);
      border:1px solid rgba(226,232,240,.9);
      border-radius:26px;
      padding:14px;
      box-shadow:var(--shadow);
      margin-bottom:14px;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .empty{
      text-align:center;
      font-size:13px;
      color:var(--muted);
      padding:20px 8px;
    }

    .report-item{
      border:1px solid var(--line);
      background:#fff;
      border-radius:20px;
      padding:14px;
    }

    .report-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:12px;
      margin-bottom:10px;
    }

    .report-title{
      font-size:15px;
      font-weight:900;
      line-height:1.25;
      color:#111827;
      margin-bottom:4px;
    }

    .report-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .status-pill{
      border-radius:999px;
      padding:7px 10px;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      white-space:nowrap;
      flex-shrink:0;
    }

    .status-new{
      background:#dbeafe;
      color:#1d4ed8;
    }

    .status-under_review{
      background:#f5f3ff;
      color:#7c3aed;
    }

    .status-waiting_reply{
      background:#fff7ed;
      color:#ea580c;
    }

    .status-resolved{
      background:#ecfdf5;
      color:#15803d;
    }

    .status-escalated{
      background:#fef2f2;
      color:#dc2626;
    }

    .meta-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:0 0 10px;
    }

    .meta-pill{
      padding:7px 10px;
      border-radius:999px;
      background:#f3f4f6;
      color:#374151;
      font-size:11px;
      font-weight:800;
      line-height:1;
    }

    .report-actions{
      display:flex;
      gap:8px;
      margin-top:10px;
      flex-wrap:wrap;
    }

    .mini-btn{
      border:none;
      border-radius:13px;
      padding:10px 12px;
      font-size:12px;
      font-weight:900;
      cursor:pointer;
    }

    .mini-btn.open{
      background:#dbeafe;
      color:#1d4ed8;
    }

    .mini-btn.case{
      background:#eef2ff;
      color:#5b5ce6;
    }

    .assistant-item{
      border:1px solid var(--line);
      background:#fff;
      border-radius:20px;
      padding:14px;
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
    }

    .assistant-name{
      font-size:14px;
      font-weight:900;
      line-height:1.3;
      margin-bottom:4px;
      color:#111827;
    }

    .assistant-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .assistant-badge{
      padding:7px 10px;
      border-radius:999px;
      background:#eef4ff;
      color:#2563eb;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      white-space:nowrap;
      flex-shrink:0;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:calc(env(safe-area-inset-bottom) + 10px);
      width:min(430px, calc(100vw - 18px));
      background:rgba(255,255,255,.92);
      border:1px solid rgba(226,232,240,.9);
      border-radius:30px;
      box-shadow:0 24px 48px rgba(15,23,42,.12);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      padding:10px 8px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:4px;
      z-index:40;
    }

    .nav-btn{
      border:none;
      background:transparent;
      border-radius:18px;
      min-height:62px;
      color:#9aa3b2;
      cursor:pointer;
      padding:6px 4px;
    }

    .nav-btn.active{
      color:#2563eb;
    }

    .nav-btn-inner{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:5px;
      font-size:11px;
      font-weight:800;
      line-height:1.15;
    }

    .nav-btn svg{
      width:22px;
      height:22px;
      display:block;
    }

    @media (max-width:360px){
      .stats-grid{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>
<body>
  <div class="glow"></div>

  <div class="shell">
    <div class="content">
      <div class="topbar">
        <div class="brand">
          <div class="brand-logo">
            <img
              src="asset/logo walpaper.jpeg"
              alt="Colspot"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<span style=&quot;font-weight:900;color:#2563eb;font-size:18px;&quot;>C</span>';"
            />
          </div>

          <div>
            <div class="brand-title">Colspot</div>
            <div class="brand-sub" id="schoolNameText">Report agent dashboard</div>
          </div>
        </div>

        <div class="top-actions">
          <button class="avatar-btn" id="avatarBtn" type="button">R</button>

          <div class="account-menu" id="accountMenu">
            <div class="menu-head">
              <div class="menu-name" id="menuAgentName">Report Agent</div>
              <div class="menu-sub" id="menuSchoolName">School</div>
            </div>

            <button class="menu-btn" type="button" onclick="goToAccountPage()">
              Account
            </button>
            <button class="menu-btn" type="button" onclick="window.location.href='agent_assistant.html'">
              Open assistants
            </button>
            <button class="menu-btn danger" type="button" onclick="logout()">
              Log out
            </button>
          </div>
        </div>
      </div>

      <section class="hero">
        <div class="hero-title">
          Welcome back, <span id="heroAgentName">Agent</span>
        </div>
        <div class="hero-sub">
          Manage reports and assistants effectively from one clean dashboard.
        </div>

        <div class="pill-row">
          <div class="pill">Anonymous</div>
          <div class="pill">Tracking code</div>
          <div class="pill">Inbox replies</div>
        </div>
      </section>

      <div class="message" id="pageMessage"></div>

      <section class="stats-grid">
        <article class="stat-card">
          <div class="stat-top">
            <div class="stat-label">New</div>
            <div class="stat-dot dot-blue"></div>
          </div>
          <div class="stat-value" id="statNew">0</div>
        </article>

        <article class="stat-card">
          <div class="stat-top">
            <div class="stat-label">Under review</div>
            <div class="stat-dot dot-purple"></div>
          </div>
          <div class="stat-value" id="statReview">0</div>
        </article>

        <article class="stat-card">
          <div class="stat-top">
            <div class="stat-label">Waiting reply</div>
            <div class="stat-dot dot-orange"></div>
          </div>
          <div class="stat-value" id="statWaiting">0</div>
        </article>

        <article class="stat-card">
          <div class="stat-top">
            <div class="stat-label">Resolved</div>
            <div class="stat-dot dot-green"></div>
          </div>
          <div class="stat-value" id="statResolved">0</div>
        </article>
      </section>

      <section class="quick-card">
        <button class="quick-btn" type="button" onclick="window.location.href='agent_cases.html'">
          Open all cases
        </button>
        <div class="quick-note">
          View all reports, filter by status, and open any case in full.
        </div>
      </section>

      <div class="section-head">
        <h2 class="section-title">Latest reports</h2>
        <button class="section-action" id="refreshDashboardBtn" type="button">Refresh</button>
      </div>

      <section class="list-card">
        <div class="list" id="reportList">
          <div class="empty">Loading reports...</div>
        </div>
      </section>

      <div class="section-head">
        <h2 class="section-title">Latest assistants</h2>
        <button class="section-action purple" type="button" onclick="window.location.href='agent_assistant.html'">
          View all
        </button>
      </div>

      <section class="list-card">
        <div class="list" id="assistantList">
          <div class="empty">Loading assistants...</div>
        </div>
      </section>
    </div>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button" onclick="window.location.href='report_agent.html'">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 0 1-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 0 1 4.5 19v-8.25Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"
          />
        </svg>
        <span>Dashboard</span>
      </div>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='agent_cases.html'">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M4 7.5A1.5 1.5 0 0 1 5.5 6h3l1.2 1.5h8.8A1.5 1.5 0 0 1 20 9v8.5A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-10Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"
          />
        </svg>
        <span>Cases</span>
      </div>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='agent_history.html'">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M12 7v5l3 2"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M20 12a8 8 0 1 1-2.35-5.66"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>History</span>
      </div>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='agent_assistant.html'">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="9.5" cy="7" r="3.5" stroke="currentColor" stroke-width="1.7"/>
          <path
            d="M19 8v6M16 11h6"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
        <span>Assistants</span>
      </div>
    </button>
  </nav>

  <script>
    const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY_HERE";

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let reportAgentSession = null;

    function $(id) {
      return document.getElementById(id);
    }

    function showMessage(id, text = "", type = "error") {
      const box = $(id);
      if (!text) {
        box.className = "message";
        box.textContent = "";
        return;
      }
      box.className = `message show ${type}`;
      box.textContent = text;
    }

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function formatDateTime(value) {
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function getAdminSession() {
      try {
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      } catch {
        return null;
      }
    }

    function requireReportAgentSession() {
      reportAgentSession = getAdminSession();

      if (!reportAgentSession || String(reportAgentSession.role || "").toLowerCase() !== "report_agent") {
        window.location.href = "index.html";
        return false;
      }

      const fullName = reportAgentSession.full_name || "Report Agent";
      const schoolName = reportAgentSession.school_name || "School";

      $("schoolNameText").textContent = schoolName;
      $("menuSchoolName").textContent = schoolName;
      $("menuAgentName").textContent = fullName;
      $("heroAgentName").textContent = fullName.split(" ")[0] || fullName;
      $("avatarBtn").textContent = (fullName.trim()[0] || "R").toUpperCase();

      return true;
    }

    async function invokeEdge(name, body = {}) {
      const { data, error } = await sb.functions.invoke(name, { body });

      if (error) {
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      if (!data?.ok) {
        throw new Error(data?.error || "Request failed.");
      }

      return data;
    }

    function statusClass(status) {
      return `status-${String(status || "").toLowerCase()}`;
    }

    function renderDashboardTotals(totals = {}) {
      $("statNew").textContent = String(totals.new || 0);
      $("statReview").textContent = String(totals.under_review || 0);
      $("statWaiting").textContent = String(totals.waiting_reply || 0);
      $("statResolved").textContent = String(totals.resolved || 0);
    }

    function renderReports(reports = []) {
      const wrap = $("reportList");

      if (!reports.length) {
        wrap.innerHTML = '<div class="empty">No reports found.</div>';
        return;
      }

      const latestReport = reports[0];

      wrap.innerHTML = `
        <article class="report-item">
          <div class="report-top">
            <div>
              <div class="report-title">${escapeHtml(latestReport.title || latestReport.category || "Untitled report")}</div>
              <div class="report-sub">${escapeHtml(latestReport.tracking_code || "")}</div>
            </div>
            <div class="status-pill ${statusClass(latestReport.status)}">${escapeHtml(latestReport.status || "new")}</div>
          </div>

          <div class="meta-row">
            <div class="meta-pill">${escapeHtml(latestReport.category || "other")}</div>
            <div class="meta-pill">${escapeHtml(latestReport.urgency || "normal")}</div>
            <div class="meta-pill">${latestReport.is_anonymous ? "Anonymous" : "Named"}</div>
          </div>

          <div class="report-sub">
            ${escapeHtml((latestReport.message || "").slice(0, 110))}
          </div>

          <div class="report-sub" style="margin-top:8px;">
            ${escapeHtml(formatDateTime(latestReport.created_at))}
          </div>

          <div class="report-actions">
            <button class="mini-btn open" onclick="openReportCase('${latestReport.id}')">Open case</button>
            <button class="mini-btn case" onclick="window.location.href='agent_cases.html'">All cases</button>
          </div>
        </article>
      `;
    }

    function renderAssistants(assistants = []) {
      const wrap = $("assistantList");

      if (!assistants.length) {
        wrap.innerHTML = '<div class="empty">No assistant agents created yet.</div>';
        return;
      }

      const latestAssistant = assistants[0];

      wrap.innerHTML = `
        <article class="assistant-item">
          <div>
            <div class="assistant-name">${escapeHtml(latestAssistant.full_name || "No name")}</div>
            <div class="assistant-sub">${escapeHtml(latestAssistant.school_name || "-")}</div>
            <div class="assistant-sub">Assigned reports: ${escapeHtml(latestAssistant.assigned_reports_count || 0)}</div>
          </div>
          <div class="assistant-badge">${latestAssistant.is_active ? "Active" : "Disabled"}</div>
        </article>
      `;
    }

    async function loadDashboard() {
      showMessage("pageMessage", "");

      try {
        const data = await invokeEdge("get-report-agent-dashboard", {
          report_agent_id: reportAgentSession.id,
          status: ""
        });

        const reports = Array.isArray(data.reports) ? data.reports : [];
        renderDashboardTotals(data.totals || {});
        renderReports(reports);
      } catch (err) {
        console.error(err);
        renderReports([]);
        showMessage("pageMessage", err.message || "Could not load dashboard.");
      }
    }

    async function loadAssistants() {
      try {
        const data = await invokeEdge("get-report-agent-assistants", {
          report_agent_id: reportAgentSession.id
        });

        const assistants = Array.isArray(data.assistants) ? data.assistants : [];
        renderAssistants(assistants);
      } catch (err) {
        console.error(err);
        renderAssistants([]);
      }
    }

    function openReportCase(reportId) {
      localStorage.setItem("colspot_selected_report_id", reportId);
      window.location.href = "report_agent_case.html";
    }

    function goToAccountPage() {
      window.location.href = "account.html";
    }

    function logout() {
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    function toggleMenu() {
      $("accountMenu").classList.toggle("show");
    }

    document.addEventListener("click", (e) => {
      const menu = $("accountMenu");
      const btn = $("avatarBtn");
      if (!menu || !btn) return;

      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        menu.classList.remove("show");
      }
    });

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireReportAgentSession()) return;

      $("avatarBtn").addEventListener("click", toggleMenu);
      $("refreshDashboardBtn").addEventListener("click", async () => {
        await loadDashboard();
        await loadAssistants();
      });

      await loadDashboard();
      await loadAssistants();
    });

    window.openReportCase = openReportCase;
    window.logout = logout;
    window.goToAccountPage = goToAccountPage;
  </script>
</body>
</html>
