<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Report Agent</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#f4f7ff;
      --card:#ffffff;
      --line:#e6ebf5;
      --text:#111827;
      --muted:#6b7280;
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --purple:#7c3aed;
      --purple-soft:#f5f0ff;
      --green:#16a34a;
      --green-soft:#ecfdf5;
      --orange:#ea580c;
      --orange-soft:#fff7ed;
      --red:#dc2626;
      --red-soft:#fef2f2;
      --shadow:0 16px 35px rgba(15,23,42,.08);
      --radius:22px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:linear-gradient(180deg,#edf3ff 0%, #f8fbff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    .shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:
        calc(env(safe-area-inset-top) + 14px)
        16px
        calc(env(safe-area-inset-bottom) + 28px);
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:14px;
    }

    .brand{
      display:flex;
      gap:12px;
      align-items:flex-start;
      min-width:0;
    }

    .brand-icon{
      width:48px;
      height:48px;
      border-radius:16px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow:var(--shadow);
      flex-shrink:0;
    }

    .brand-icon svg{
      width:24px;
      height:24px;
    }

    .brand-title{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.03em;
      margin-bottom:2px;
    }

    .brand-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
    }

    .profile-btn{
      width:44px;
      height:44px;
      border:none;
      border-radius:999px;
      background:linear-gradient(135deg,#2563eb,#7c3aed);
      color:#fff;
      font-size:18px;
      font-weight:900;
      cursor:pointer;
      box-shadow:var(--shadow);
      flex-shrink:0;
    }

    .hero-card,
    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    .hero-card{
      padding:18px 16px;
      margin-bottom:14px;
    }

    .hero-title{
      font-size:22px;
      line-height:1.15;
      font-weight:900;
      letter-spacing:-.04em;
      margin-bottom:8px;
    }

    .hero-title span{
      color:var(--blue);
    }

    .hero-sub{
      font-size:13px;
      line-height:1.5;
      color:var(--muted);
      margin-bottom:12px;
    }

    .hero-tags{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .tag{
      padding:8px 12px;
      border-radius:999px;
      background:#eff6ff;
      color:var(--blue);
      font-size:11px;
      font-weight:800;
    }

    .message{
      display:none;
      padding:13px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:700;
      margin-bottom:14px;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--red-soft);
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      background:var(--green-soft);
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin-bottom:14px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:20px;
      padding:16px 14px;
      box-shadow:var(--shadow);
    }

    .stat-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-bottom:12px;
    }

    .stat-label{
      font-size:12px;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .stat-dot{
      width:10px;
      height:10px;
      border-radius:999px;
      flex-shrink:0;
    }

    .dot-blue{ background:#3b82f6; }
    .dot-purple{ background:#8b5cf6; }
    .dot-orange{ background:#f59e0b; }
    .dot-green{ background:#22c55e; }

    .stat-value{
      font-size:28px;
      font-weight:900;
      line-height:1;
      letter-spacing:-.04em;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin:18px 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:16px;
      font-weight:900;
      letter-spacing:-.02em;
    }

    .section-action{
      border:none;
      background:#eef2ff;
      color:#4f46e5;
      padding:10px 13px;
      border-radius:14px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .card{
      padding:16px;
      margin-bottom:14px;
    }

    .filter-row{
      display:flex;
      gap:8px;
      overflow:auto;
      padding-bottom:2px;
    }

    .filter-chip{
      border:none;
      background:#f3f4f6;
      color:#374151;
      border-radius:999px;
      padding:10px 13px;
      font-size:12px;
      font-weight:800;
      white-space:nowrap;
      cursor:pointer;
    }

    .filter-chip.active{
      background:#dbeafe;
      color:#1d4ed8;
    }

    .field{
      margin-bottom:12px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:800;
      color:#374151;
      margin-bottom:6px;
    }

    .input,
    .select{
      width:100%;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      padding:13px 14px;
      font-size:14px;
      color:#111827;
      outline:none;
    }

    .btn-row{
      display:flex;
      gap:10px;
      margin-top:12px;
    }

    .btn{
      flex:1;
      border:none;
      border-radius:999px;
      padding:13px 14px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
    }

    .btn.primary{
      color:#fff;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      box-shadow:var(--shadow);
    }

    .btn.secondary{
      color:#111827;
      background:#f3f4f6;
    }

    .btn.purple{
      color:#fff;
      background:linear-gradient(135deg,#7c3aed,#6d28d9);
      box-shadow:var(--shadow);
    }

    .btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .result-card{
      display:none;
      margin-top:12px;
      padding:13px;
      border-radius:18px;
      background:#ecfdf5;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .result-card.show{
      display:block;
    }

    .result-row{
      font-size:13px;
      line-height:1.5;
      margin-bottom:4px;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .empty{
      text-align:center;
      font-size:13px;
      color:var(--muted);
      padding:20px 8px;
    }

    .report-card{
      border:1px solid var(--line);
      border-radius:20px;
      padding:14px;
      background:#fff;
    }

    .report-top{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
      margin-bottom:10px;
    }

    .report-title{
      font-size:15px;
      font-weight:900;
      line-height:1.25;
      margin-bottom:4px;
    }

    .report-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
    }

    .status-pill{
      border-radius:999px;
      padding:7px 10px;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      white-space:nowrap;
    }

    .status-new{
      background:#dbeafe;
      color:#1d4ed8;
    }

    .status-under_review{
      background:#f5f3ff;
      color:#7c3aed;
    }

    .status-waiting_reply{
      background:#fff7ed;
      color:#ea580c;
    }

    .status-resolved{
      background:#ecfdf5;
      color:#15803d;
    }

    .status-escalated{
      background:#fef2f2;
      color:#dc2626;
    }

    .meta-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-bottom:10px;
    }

    .meta-pill{
      padding:7px 10px;
      border-radius:999px;
      background:#f3f4f6;
      color:#374151;
      font-size:11px;
      font-weight:800;
    }

    .report-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-top:10px;
    }

    .mini-btn{
      border:none;
      border-radius:12px;
      padding:10px 12px;
      font-size:12px;
      font-weight:900;
      cursor:pointer;
    }

    .mini-btn.open{
      background:#dbeafe;
      color:#1d4ed8;
    }

    .mini-btn.assign{
      background:#ede9fe;
      color:#6d28d9;
    }

    .assistant-card{
      border:1px solid var(--line);
      border-radius:18px;
      padding:13px;
      background:#fff;
    }

    .assistant-top{
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:flex-start;
      margin-bottom:8px;
    }

    .assistant-name{
      font-size:14px;
      font-weight:900;
      margin-bottom:3px;
    }

    .assistant-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
    }

    .assistant-badge{
      padding:7px 10px;
      border-radius:999px;
      background:#eff6ff;
      color:#2563eb;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      white-space:nowrap;
    }

    @media (max-width:360px){
      .stats-grid{
        grid-template-columns:1fr;
      }
      .btn-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <div class="brand">
        <div class="brand-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3l7 3v5c0 4.7-2.9 8.6-7 10-4.1-1.4-7-5.3-7-10V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M9.5 12.3l1.7 1.7 3.6-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div>
          <div class="brand-title">Report Agent</div>
          <div class="brand-sub" id="schoolNameText">School</div>
        </div>
      </div>

      <button class="profile-btn" id="logoutBtn" type="button">R</button>
    </div>

    <section class="hero-card">
      <div class="hero-title">
        Manage school <span>report cases</span>
      </div>
      <div class="hero-sub">
        View incoming reports, assign them to assistant agents, and manage case flow for your school.
      </div>

      <div class="hero-tags">
        <div class="tag" id="agentNameTag">Agent</div>
        <div class="tag">Private reports</div>
        <div class="tag">School authority</div>
      </div>
    </section>

    <div class="message" id="pageMessage"></div>
    <div class="message" id="assistantMessage"></div>
    <div class="message" id="assignMessage"></div>

    <section class="stats-grid">
      <article class="stat-card">
        <div class="stat-top">
          <div class="stat-label">New</div>
          <div class="stat-dot dot-blue"></div>
        </div>
        <div class="stat-value" id="statNew">0</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="stat-label">Under review</div>
          <div class="stat-dot dot-purple"></div>
        </div>
        <div class="stat-value" id="statReview">0</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="stat-label">Waiting reply</div>
          <div class="stat-dot dot-orange"></div>
        </div>
        <div class="stat-value" id="statWaiting">0</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="stat-label">Resolved</div>
          <div class="stat-dot dot-green"></div>
        </div>
        <div class="stat-value" id="statResolved">0</div>
      </article>
    </section>

    <div class="section-head">
      <h2 class="section-title">Report filters</h2>
      <button class="section-action" id="refreshDashboardBtn" type="button">Refresh</button>
    </div>

    <section class="card">
      <div class="filter-row" id="statusFilters">
        <button class="filter-chip active" data-status="">All</button>
        <button class="filter-chip" data-status="new">New</button>
        <button class="filter-chip" data-status="under_review">Under review</button>
        <button class="filter-chip" data-status="waiting_reply">Waiting reply</button>
        <button class="filter-chip" data-status="resolved">Resolved</button>
        <button class="filter-chip" data-status="escalated">Escalated</button>
      </div>
    </section>

    <div class="section-head">
      <h2 class="section-title">Create assistant agent</h2>
    </div>

    <section class="card">
      <div class="field">
        <label for="assistantFullName">Full name</label>
        <input id="assistantFullName" class="input" placeholder="Enter assistant agent full name">
      </div>

      <div class="field">
        <label for="assistantEmail">Linked email (optional)</label>
        <input id="assistantEmail" class="input" type="email" placeholder="Enter linked email">
      </div>

      <div class="btn-row">
        <button class="btn purple" id="createAssistantBtn" type="button">Create assistant</button>
        <button class="btn secondary" id="clearAssistantBtn" type="button">Clear</button>
      </div>

      <div class="result-card" id="assistantResultCard">
        <div class="result-row"><strong>Full name:</strong> <span id="assistantResultName">-</span></div>
        <div class="result-row"><strong>Login ID:</strong> <span id="assistantResultLoginId">-</span></div>
        <div class="result-row"><strong>Temporary password:</strong> <span id="assistantResultPassword">-</span></div>
      </div>
    </section>

    <div class="section-head">
      <h2 class="section-title">Assign report to assistant</h2>
    </div>

    <section class="card">
      <div class="field">
        <label for="assignReportSelect">Select report</label>
        <select id="assignReportSelect" class="select">
          <option value="">Select a report</option>
        </select>
      </div>

      <div class="field">
        <label for="assignAssistantSelect">Select assistant agent</label>
        <select id="assignAssistantSelect" class="select">
          <option value="">Select an assistant agent</option>
        </select>
      </div>

      <div class="btn-row">
        <button class="btn primary" id="assignReportBtn" type="button">Assign report</button>
        <button class="btn secondary" id="refreshAssistantsBtn" type="button">Reload assistants</button>
      </div>
    </section>

    <div class="section-head">
      <h2 class="section-title">Assistant agents</h2>
      <button class="section-action" id="reloadAssistantsBtn" type="button">Refresh</button>
    </div>

    <section class="card">
      <div class="list" id="assistantList">
        <div class="empty">Loading assistant agents...</div>
      </div>
    </section>

    <div class="section-head">
      <h2 class="section-title">Incoming reports</h2>
    </div>

    <section class="card">
      <div class="list" id="reportList">
        <div class="empty">Loading reports...</div>
      </div>
    </section>
  </div>

  <script>
    const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY_HERE";

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let reportAgentSession = null;
    let currentReports = [];
    let currentAssistants = [];
    let currentStatusFilter = "";

    function $(id) {
      return document.getElementById(id);
    }

    function showMessage(id, text = "", type = "error") {
      const box = $(id);
      if (!text) {
        box.className = "message";
        box.textContent = "";
        return;
      }
      box.className = `message show ${type}`;
      box.textContent = text;
    }

    function getAdminSession() {
      try {
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      } catch {
        return null;
      }
    }

    function requireReportAgentSession() {
      reportAgentSession = getAdminSession();

      if (!reportAgentSession || String(reportAgentSession.role || "").toLowerCase() !== "report_agent") {
        window.location.href = "index.html";
        return false;
      }

      $("schoolNameText").textContent = reportAgentSession.school_name || "School";
      $("agentNameTag").textContent = reportAgentSession.full_name || "Agent";
      $("logoutBtn").textContent = (reportAgentSession.full_name || "R").trim().charAt(0).toUpperCase() || "R";
      return true;
    }

    async function invokeEdge(name, body = {}) {
      const { data, error } = await sb.functions.invoke(name, { body });

      if (error) {
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      if (!data?.ok) {
        throw new Error(data?.error || "Request failed.");
      }

      return data;
    }

    function statusClass(status) {
      return `status-${String(status || "").toLowerCase()}`;
    }

    function formatDateTime(value) {
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function renderDashboardTotals(totals = {}) {
      $("statNew").textContent = String(totals.new || 0);
      $("statReview").textContent = String(totals.under_review || 0);
      $("statWaiting").textContent = String(totals.waiting_reply || 0);
      $("statResolved").textContent = String(totals.resolved || 0);
    }

    function renderReports(reports = []) {
      const wrap = $("reportList");

      if (!reports.length) {
        wrap.innerHTML = '<div class="empty">No reports found.</div>';
        return;
      }

      wrap.innerHTML = reports.map((report) => `
        <article class="report-card">
          <div class="report-top">
            <div>
              <div class="report-title">${escapeHtml(report.title || report.category || "Untitled report")}</div>
              <div class="report-sub">${escapeHtml(report.tracking_code || "")} • ${escapeHtml(report.school_name || "")}</div>
            </div>
            <div class="status-pill ${statusClass(report.status)}">${escapeHtml(report.status || "new")}</div>
          </div>

          <div class="meta-row">
            <div class="meta-pill">${escapeHtml(report.category || "other")}</div>
            <div class="meta-pill">${escapeHtml(report.urgency || "normal")}</div>
            <div class="meta-pill">${report.is_anonymous ? "Anonymous" : "Named"}</div>
            <div class="meta-pill">${escapeHtml(report.department || "No department")}</div>
          </div>

          <div class="report-sub">
            ${escapeHtml((report.message || "").slice(0, 160))}
          </div>

          <div class="report-sub" style="margin-top:8px;">
            Created: ${escapeHtml(formatDateTime(report.created_at))}
          </div>

          <div class="report-actions">
            <button class="mini-btn open" onclick="openReportCase('${report.id}')">Open case</button>
          </div>
        </article>
      `).join("");

      const reportSelect = $("assignReportSelect");
      reportSelect.innerHTML = `<option value="">Select a report</option>` +
        reports.map((report) => `
          <option value="${report.id}">
            ${escapeHtml(report.tracking_code || report.id)} - ${escapeHtml(report.category || "report")}
          </option>
        `).join("");
    }

    function renderAssistants(assistants = []) {
      const wrap = $("assistantList");

      if (!assistants.length) {
        wrap.innerHTML = '<div class="empty">No assistant agents created yet.</div>';
      } else {
        wrap.innerHTML = assistants.map((assistant) => `
          <article class="assistant-card">
            <div class="assistant-top">
              <div>
                <div class="assistant-name">${escapeHtml(assistant.full_name || "No name")}</div>
                <div class="assistant-sub">${escapeHtml(assistant.login_id || "-")}</div>
              </div>
              <div class="assistant-badge">${assistant.is_active ? "Active" : "Disabled"}</div>
            </div>

            <div class="assistant-sub">School: ${escapeHtml(assistant.school_name || "-")}</div>
            <div class="assistant-sub">Assigned reports: ${escapeHtml(assistant.assigned_reports_count || 0)}</div>
            <div class="assistant-sub">Email: ${escapeHtml(assistant.linked_email || "Not linked")}</div>
          </article>
        `).join("");
      }

      const assistantSelect = $("assignAssistantSelect");
      assistantSelect.innerHTML = `<option value="">Select an assistant agent</option>` +
        assistants.map((assistant) => `
          <option value="${assistant.id}">
            ${escapeHtml(assistant.full_name || "")} - ${escapeHtml(assistant.login_id || "")}
          </option>
        `).join("");
    }

    async function loadDashboard() {
      showMessage("pageMessage", "");
      try {
        const data = await invokeEdge("get-report-agent-dashboard", {
          report_agent_id: reportAgentSession.id,
          status: currentStatusFilter
        });

        currentReports = Array.isArray(data.reports) ? data.reports : [];
        renderDashboardTotals(data.totals || {});
        renderReports(currentReports);
      } catch (err) {
        console.error(err);
        currentReports = [];
        renderReports([]);
        showMessage("pageMessage", err.message || "Could not load dashboard.");
      }
    }

    async function loadAssistants() {
      showMessage("assistantMessage", "");
      try {
        const data = await invokeEdge("get-report-agent-assistants", {
          report_agent_id: reportAgentSession.id
        });

        currentAssistants = Array.isArray(data.assistants) ? data.assistants : [];
        renderAssistants(currentAssistants);
      } catch (err) {
        console.error(err);
        currentAssistants = [];
        renderAssistants([]);
        showMessage("assistantMessage", err.message || "Could not load assistant agents.");
      }
    }

    async function createAssistant() {
      showMessage("assistantMessage", "");
      $("assistantResultCard").classList.remove("show");

      const fullName = $("assistantFullName").value.trim();
      const linkedEmail = $("assistantEmail").value.trim();

      if (!fullName) {
        showMessage("assistantMessage", "Please enter assistant full name.");
        return;
      }

      const btn = $("createAssistantBtn");
      btn.disabled = true;
      btn.textContent = "Creating...";

      try {
        const data = await invokeEdge("create-assistant-report-agent", {
          parent_report_agent_id: reportAgentSession.id,
          full_name: fullName,
          linked_email: linkedEmail
        });

        const assistant = data.assistant_report_agent || {};

        $("assistantResultName").textContent = assistant.full_name || fullName;
        $("assistantResultLoginId").textContent = assistant.login_id || "-";
        $("assistantResultPassword").textContent = data.temporary_password || "-";
        $("assistantResultCard").classList.add("show");

        $("assistantFullName").value = "";
        $("assistantEmail").value = "";

        showMessage("assistantMessage", data.message || "Assistant agent created successfully.", "success");
        await loadAssistants();
      } catch (err) {
        console.error(err);
        showMessage("assistantMessage", err.message || "Could not create assistant agent.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Create assistant";
      }
    }

    async function assignReport() {
      showMessage("assignMessage", "");

      const reportId = $("assignReportSelect").value;
      const assistantId = $("assignAssistantSelect").value;

      if (!reportId) {
        showMessage("assignMessage", "Please select a report.");
        return;
      }

      if (!assistantId) {
        showMessage("assignMessage", "Please select an assistant agent.");
        return;
      }

      const btn = $("assignReportBtn");
      btn.disabled = true;
      btn.textContent = "Assigning...";

      try {
        const data = await invokeEdge("assign-report-to-assistant-agent", {
          report_agent_id: reportAgentSession.id,
          assistant_agent_id: assistantId,
          report_id: reportId
        });

        showMessage("assignMessage", data.message || "Report assigned successfully.", "success");
        await loadDashboard();
        await loadAssistants();
      } catch (err) {
        console.error(err);
        showMessage("assignMessage", err.message || "Could not assign report.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Assign report";
      }
    }

    function clearAssistantForm() {
      $("assistantFullName").value = "";
      $("assistantEmail").value = "";
      $("assistantResultCard").classList.remove("show");
      showMessage("assistantMessage", "");
    }

    function logout() {
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    function openReportCase(reportId) {
      localStorage.setItem("colspot_selected_report_id", reportId);
      window.location.href = "report_agent_case.html";
    }

    window.openReportCase = openReportCase;

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireReportAgentSession()) return;

      document.querySelectorAll("#statusFilters .filter-chip").forEach((btn) => {
        btn.addEventListener("click", async () => {
          document.querySelectorAll("#statusFilters .filter-chip").forEach((x) => x.classList.remove("active"));
          btn.classList.add("active");
          currentStatusFilter = btn.dataset.status || "";
          await loadDashboard();
        });
      });

      $("refreshDashboardBtn").addEventListener("click", loadDashboard);
      $("reloadAssistantsBtn").addEventListener("click", loadAssistants);
      $("refreshAssistantsBtn").addEventListener("click", loadAssistants);
      $("createAssistantBtn").addEventListener("click", createAssistant);
      $("clearAssistantBtn").addEventListener("click", clearAssistantForm);
      $("assignReportBtn").addEventListener("click", assignReport);
      $("logoutBtn").addEventListener("click", logout);

      await loadDashboard();
      await loadAssistants();
    });
  </script>
</body>
</html>
