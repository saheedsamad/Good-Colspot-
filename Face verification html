<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Face Verification</title>

  <style>
    :root{
      --bg:#edf3ff;
      --panel:#f4f7ff;
      --card:#ffffff;
      --text:#182033;
      --muted:#7a8499;
      --line:#dfe7f6;
      --blue:#4c83f6;
      --blue-dark:#316df0;
      --blue-soft:#dbeafe;
      --blue-soft-2:#eef5ff;
      --green:#22c55e;
      --green-soft:#dcfce7;
      --red:#ef4444;
      --red-soft:#fee2e2;
      --shadow:0 18px 40px rgba(76,131,246,.12);
      --shadow-soft:0 10px 24px rgba(15,23,42,.08);
      --radius-xl:30px;
      --radius-lg:24px;
      --radius-md:18px;
      --radius-pill:999px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:#e9eef7;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }

    .hidden{
      display:none !important;
    }

    .phone-shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      background:var(--bg);
      padding:
        calc(env(safe-area-inset-top) + 10px)
        14px
        calc(env(safe-area-inset-bottom) + 18px);
    }

    .page{
      width:100%;
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:14px;
    }

    .icon-back-btn{
      width:42px;
      height:42px;
      border:none;
      border-radius:14px;
      background:#f1f4fb;
      box-shadow:inset 0 0 0 1px rgba(24,32,51,.04);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      cursor:pointer;
    }

    .icon-back-btn svg{
      width:20px;
      height:20px;
      stroke:#3b455c;
      stroke-width:2;
      fill:none;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .page-title{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.02em;
      color:#20283a;
    }

    .main-card{
      background:var(--panel);
      border-radius:34px;
      padding:18px 16px 16px;
      box-shadow:var(--shadow);
      border:1px solid rgba(255,255,255,.55);
    }

    .camera-stage{
      position:relative;
      width:100%;
      aspect-ratio:1/1.08;
      min-height:320px;
      border-radius:28px;
      overflow:hidden;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,.65), rgba(255,255,255,0) 24%),
        linear-gradient(180deg,#dcecff 0%, #c8dcf9 100%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.65);
    }

    .camera-video,
    .camera-canvas,
    .face-preview-wrap{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
    }

    .camera-video{
      object-fit:cover;
      background:transparent;
    }

    .camera-canvas{
      pointer-events:none;
    }

    .face-preview-wrap{
      overflow:hidden;
      border-radius:28px;
    }

    .face-preview-image{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .face-guide-overlay{
      position:absolute;
      inset:0;
      display:flex;
      align-items:center;
      justify-content:center;
      pointer-events:none;
    }

    .face-frame{
      width:78%;
      height:78%;
      border-radius:30px;
      border:2px dashed rgba(123,170,239,.55);
      position:relative;
      box-shadow:inset 0 0 0 999px rgba(255,255,255,.04);
    }

    .frame-corner{
      position:absolute;
      width:42px;
      height:42px;
      border:5px solid rgba(255,255,255,.92);
      border-radius:14px;
    }

    .frame-corner.tl{
      top:-2px;
      left:-2px;
      border-right:none;
      border-bottom:none;
    }

    .frame-corner.tr{
      top:-2px;
      right:-2px;
      border-left:none;
      border-bottom:none;
    }

    .frame-corner.bl{
      bottom:-2px;
      left:-2px;
      border-right:none;
      border-top:none;
    }

    .frame-corner.br{
      right:-2px;
      bottom:-2px;
      border-left:none;
      border-top:none;
    }

    .face-guide-bottom{
      position:absolute;
      left:50%;
      bottom:18px;
      transform:translateX(-50%);
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:8px;
      width:100%;
      padding:0 14px;
    }

    .face-guide-text{
      display:none;
    }

    .instruction-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:48px;
      padding:0 18px;
      border-radius:999px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      font-size:13px;
      font-weight:700;
      box-shadow:0 10px 26px rgba(76,131,246,.28);
      text-align:center;
      max-width:92%;
    }

    .instruction-pill svg{
      width:16px;
      height:16px;
      stroke:#fff;
      stroke-width:2;
      fill:none;
      stroke-linecap:round;
      stroke-linejoin:round;
      flex-shrink:0;
    }

    .step-track-wrap{
      margin:14px 2px 12px;
    }

    .step-track{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:0;
      margin-bottom:12px;
    }

    .step-line{
      flex:1;
      max-width:58px;
      height:4px;
      border-radius:999px;
      background:#d7dfef;
      margin:0 6px;
    }

    .step-line.done{
      background:#a9dcff;
    }

    .step-circle{
      width:24px;
      height:24px;
      border-radius:999px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:11px;
      font-weight:800;
      background:#d9e0ee;
      color:#8b96aa;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.55);
    }

    .step-circle.active{
      background:var(--blue);
      color:#fff;
    }

    .step-circle.done{
      background:#59c5dd;
      color:#fff;
    }

    .mini-instruction{
      width:max-content;
      max-width:100%;
      margin:0 auto;
      padding:10px 16px;
      border-radius:999px;
      background:#ffffff;
      box-shadow:var(--shadow-soft);
      color:#1f2a3d;
      font-weight:700;
      font-size:13px;
      text-align:center;
      border:1px solid rgba(76,131,246,.08);
    }

    .action-grid{
      display:grid;
      grid-template-columns:1fr 1.2fr;
      gap:12px;
      margin-top:12px;
    }

    .action-btn,
    .primary-action-btn,
    .ghost-btn{
      border:none;
      cursor:pointer;
      transition:transform .08s ease, opacity .15s ease, box-shadow .15s ease;
    }

    .action-btn:active,
    .primary-action-btn:active,
    .ghost-btn:active{
      transform:scale(.985);
    }

    .action-btn{
      min-height:60px;
      border-radius:18px;
      background:#fff;
      color:#2b3447;
      font-size:16px;
      font-weight:700;
      box-shadow:var(--shadow-soft);
    }

    .primary-action-btn{
      min-height:60px;
      border-radius:18px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      font-size:16px;
      font-weight:700;
      box-shadow:0 12px 28px rgba(76,131,246,.28);
    }

    .start-camera-btn{
      width:100%;
      min-height:76px;
      border-radius:26px;
      margin-top:14px;
      background:#ffffff;
      color:#20283a;
      font-size:17px;
      font-weight:800;
      box-shadow:var(--shadow-soft);
    }

    .primary-action-btn:disabled,
    .action-btn:disabled,
    .start-camera-btn:disabled,
    .ghost-btn:disabled{
      opacity:.55;
      cursor:not-allowed;
      box-shadow:none;
    }

    .bottom-dots{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      margin:14px 0 8px;
    }

    .bottom-dots span{
      width:7px;
      height:7px;
      border-radius:999px;
      background:#d8dfef;
    }

    .bottom-dots span.active{
      width:26px;
      background:var(--blue);
    }

    .help-link{
      display:block;
      text-align:center;
      color:#7c8cab;
      font-size:14px;
      text-decoration:none;
      margin-top:6px;
    }

    .result-box{
      margin-top:14px;
      padding:12px 14px;
      border-radius:18px;
      background:#fff;
      box-shadow:var(--shadow-soft);
      border:1px solid rgba(76,131,246,.08);
    }

    .verify-result-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:8px;
    }

    .verify-result-title{
      font-size:14px;
      font-weight:800;
      color:#1f2937;
    }

    .verify-result-pill{
      border-radius:999px;
      padding:6px 10px;
      font-size:11px;
      font-weight:800;
      white-space:nowrap;
    }

    .verify-result-pill.neutral{
      background:#eef2f7;
      color:#64748b;
    }

    .verify-result-pill.success{
      background:#dcfce7;
      color:#15803d;
    }

    .verify-result-pill.error{
      background:#fee2e2;
      color:#b91c1c;
    }

    .message-box{
      margin-top:10px;
      padding:11px 12px;
      border-radius:16px;
      font-size:13px;
      font-weight:600;
      line-height:1.45;
    }

    .message-box.error{
      background:#fee2e2;
      color:#b91c1c;
      border:1px solid #fecaca;
    }

    .message-box.success{
      background:#dcfce7;
      color:#15803d;
      border:1px solid #bbf7d0;
    }

    .verify-result-text{
      margin:0;
      font-size:13px;
      line-height:1.5;
      color:#6b7280;
    }

    .extra-actions{
      display:flex;
      flex-direction:column;
      gap:10px;
      margin-top:12px;
    }

    .ghost-btn{
      width:100%;
      min-height:48px;
      border-radius:999px;
      background:#fff;
      border:1px solid var(--line);
      color:#556074;
      font-size:14px;
      font-weight:700;
      box-shadow:var(--shadow-soft);
    }

    .face-join-overlay{
      position:fixed;
      inset:0;
      z-index:99999;
      background:rgba(15,23,42,.50);
      backdrop-filter:blur(5px);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:
        calc(env(safe-area-inset-top) + 18px)
        20px
        calc(env(safe-area-inset-bottom) + 18px);
    }

    .face-join-card{
      width:100%;
      max-width:360px;
      background:#ffffff;
      border-radius:30px;
      padding:26px 22px 22px;
      box-shadow:0 28px 70px rgba(15,23,42,.25);
      border:1px solid rgba(37,99,235,.10);
      position:relative;
      overflow:hidden;
      text-align:center;
    }

    .face-join-card::before{
      content:"";
      position:absolute;
      inset:0 0 auto 0;
      height:8px;
      background:linear-gradient(90deg,#2563eb 0%,#60a5fa 100%);
    }

    .face-join-icon-wrap{
      width:118px;
      height:118px;
      margin:8px auto 18px;
      border-radius:999px;
      background:radial-gradient(circle at center, rgba(37,99,235,.12) 0%, rgba(37,99,235,.07) 58%, rgba(37,99,235,.03) 100%);
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
    }

    .face-join-icon{
      width:82px;
      height:82px;
      border-radius:999px;
      background:#2563eb;
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow:0 14px 30px rgba(37,99,235,.32);
    }

    .face-join-icon svg{
      width:40px;
      height:40px;
      stroke:#ffffff;
      stroke-width:2.8;
      fill:none;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .face-join-spinner{
      width:44px;
      height:44px;
      border-radius:999px;
      border:4px solid rgba(255,255,255,.35);
      border-top-color:#ffffff;
      animation:faceJoinSpin .8s linear infinite;
    }

    @keyframes faceJoinSpin{
      to{ transform:rotate(360deg); }
    }

    .face-join-title{
      margin:0 0 10px;
      font-size:25px;
      line-height:1.12;
      font-weight:850;
      color:#1d4ed8;
      letter-spacing:-.03em;
    }

    .face-join-message{
      margin:0;
      color:#4b5563;
      font-size:15px;
      line-height:1.65;
    }

    .face-join-message strong{
      color:#111827;
      font-weight:800;
    }

    .face-join-divider{
      width:100%;
      height:1px;
      background:#e5e7eb;
      margin:18px 0;
    }

    .face-join-btn{
      width:100%;
      border:none;
      border-radius:16px;
      padding:14px 16px;
      font-size:17px;
      font-weight:800;
      cursor:pointer;
      background:#2563eb;
      color:#ffffff;
      box-shadow:0 12px 26px rgba(37,99,235,.28);
      transition:transform .12s ease, opacity .12s ease, box-shadow .12s ease;
    }

    .face-join-btn:active{
      transform:translateY(1px) scale(.99);
    }

    .face-join-btn:disabled{
      cursor:not-allowed;
      opacity:.65;
      box-shadow:none;
    }

    .face-join-card.success .face-join-icon{
      background:#2563eb;
    }

    .face-join-card.error .face-join-icon{
      background:#ef4444;
      box-shadow:0 14px 30px rgba(239,68,68,.25);
    }

    .face-join-card.error .face-join-title{
      color:#b91c1c;
    }

    .face-join-card.error::before{
      background:linear-gradient(90deg,#ef4444 0%,#f87171 100%);
    }

    .top-message-card,
    .challenge-card,
    .tips-card,
    .warning-card{
      display:none;
    }

    @media (max-width:380px){
      .camera-stage{
        min-height:290px;
      }

      .page-title{
        font-size:16px;
      }

      .action-grid{
        grid-template-columns:1fr;
      }

      .face-join-card{
        border-radius:26px;
        padding:24px 18px 20px;
      }

      .face-join-title{
        font-size:23px;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <main class="page">
      <div class="topbar">
        <button type="button" class="icon-back-btn" id="faceBackBtn" aria-label="Back">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 6l-6 6 6 6"></path>
          </svg>
        </button>
        <div class="page-title">Face verification</div>
      </div>

      <section class="main-card">
        <section class="camera-card" style="display:block; margin:0; padding:0; background:transparent; border:none; box-shadow:none;">
          <div class="camera-stage" id="cameraStage">
            <video
              id="faceVideo"
              class="camera-video"
              autoplay
              muted
              playsinline
            ></video>

            <canvas id="faceCanvas" class="camera-canvas"></canvas>

            <div id="faceGuideOverlay" class="face-guide-overlay">
              <div class="face-frame">
                <div class="frame-corner tl"></div>
                <div class="frame-corner tr"></div>
                <div class="frame-corner bl"></div>
                <div class="frame-corner br"></div>
              </div>

              <div class="face-guide-bottom">
                <div class="instruction-pill">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v4"></path>
                    <path d="M8.5 8.5A5 5 0 1 0 17 12"></path>
                    <path d="M6 13l2.5-1.5L10 14"></path>
                  </svg>
                  <span id="faceLiveChip">Look straight, turn left, turn right</span>
                </div>

                <div id="faceGuideText" class="face-guide-text">
                  Place your face inside the frame
                </div>
              </div>
            </div>

            <div id="facePreviewWrap" class="face-preview-wrap hidden">
              <img id="facePreviewImage" class="face-preview-image" alt="Captured face preview" />
            </div>
          </div>

          <div class="step-track-wrap">
            <div class="step-track">
              <div id="stepCircle1" class="step-circle done">✓</div>
              <div id="stepLine1" class="step-line done"></div>
              <div id="stepCircle2" class="step-circle active">2</div>
              <div id="stepLine2" class="step-line"></div>
              <div id="stepCircle3" class="step-circle">3</div>
            </div>

            <div id="faceChallengeText" class="mini-instruction">Turn left</div>
          </div>

          <button type="button" class="action-btn start-camera-btn" id="startCameraBtn">
            Start camera
          </button>

          <div class="action-grid">
            <button type="button" class="action-btn" id="retakeFaceBtn" disabled>
              Retake
            </button>

            <button type="button" class="primary-action-btn" id="verifyFaceBtn" disabled>
              Verify and continue
            </button>
          </div>

          <button type="button" class="primary-action-btn hidden" id="captureFaceBtn" disabled>
            Capture face
          </button>

          <div class="bottom-dots">
            <span></span>
            <span></span>
            <span></span>
            <span class="active"></span>
            <span></span>
            <span></span>
            <span></span>
          </div>

          <a href="javascript:void(0)" class="help-link" id="cancelFaceBtn">Why am I doing this?</a>
        </section>

        <section class="verify-result-card result-box" style="display:block;">
          <div class="verify-result-head">
            <div class="verify-result-title">Verification result</div>
            <div id="faceResultPill" class="verify-result-pill neutral">Waiting</div>
          </div>

          <p id="faceResultText" class="verify-result-text">
            Start the camera and complete the movement challenge.
          </p>

          <div id="faceErrorBox" class="message-box error hidden"></div>
          <div id="faceSuccessBox" class="message-box success hidden"></div>
        </section>
      </section>
    </main>
  </div>

  <div id="faceJoinOverlay" class="face-join-overlay hidden">
    <div id="faceJoinCard" class="face-join-card">
      <div class="face-join-icon-wrap">
        <div id="faceJoinIcon" class="face-join-icon">
          <div class="face-join-spinner" id="faceJoinSpinner"></div>
          <svg id="faceJoinSuccessIcon" class="hidden" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 13l4 4L19 7"></path>
          </svg>
          <svg id="faceJoinErrorIcon" class="hidden" viewBox="0 0 24 24" aria-hidden="true">
            <line x1="7" y1="7" x2="17" y2="17"></line>
            <line x1="17" y1="7" x2="7" y2="17"></line>
          </svg>
        </div>
      </div>

      <h3 id="faceJoinTitle" class="face-join-title">Joining attendance</h3>

      <p id="faceJoinMessage" class="face-join-message">
        Face verified. Colspot is submitting your attendance now.
      </p>

      <div class="face-join-divider"></div>

      <button type="button" id="faceJoinDoneBtn" class="face-join-btn hidden">
        Great!
      </button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="face_verification.js"></script>
</body>
</html>
