  <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Face Verification</title>

  <style>
    :root {
      --bg: #eef4ff;
      --card: #ffffff;
      --line: #e5e7eb;
      --text-main: #111827;
      --text-muted: #6b7280;
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --blue-soft: #dbeafe;
      --green: #16a34a;
      --green-soft: #dcfce7;
      --red: #dc2626;
      --red-soft: #fee2e2;
      --shadow-soft: 0 12px 30px rgba(148, 163, 184, 0.22);
      --shadow-card: 0 16px 38px rgba(15, 23, 42, 0.12);
      --radius-xl: 24px;
      --radius-lg: 20px;
      --radius-md: 16px;
      --radius-pill: 999px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(180deg, #f5f8ff 0%, #edf4ff 100%);
      font-family: Inter, Arial, sans-serif;
      color: var(--text-main);
      min-height: 100%;
    }

    body {
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    button,
    input,
    video,
    canvas {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    .phone-shell {
      width: 100%;
      min-height: 100vh;
      padding:
        calc(env(safe-area-inset-top) + 14px)
        14px
        calc(env(safe-area-inset-bottom) + 18px);
    }

    .page {
      max-width: 460px;
      margin: 0 auto;
    }

    .hero {
      margin-bottom: 14px;
    }

    .hero-top {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .icon-back-btn {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
    }

    .icon-back-btn svg {
      width: 18px;
      height: 18px;
      stroke: #4b5563;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hero-copy {
      flex: 1;
      min-width: 0;
    }

    .hero-line-1 {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--blue-dark);
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .hero-title {
      margin: 0;
      font-size: 29px;
      line-height: 1.08;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--text-main);
    }

    .hero-title span {
      color: var(--blue-dark);
    }

    .hero-subtitle {
      margin: 10px 2px 0;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-muted);
    }

    .top-message-card {
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid var(--line);
      padding: 10px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: var(--shadow-soft);
      margin-bottom: 14px;
    }

    .top-message-icon {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: #e0e7ff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .top-message-icon svg {
      width: 15px;
      height: 15px;
      stroke: #4338ca;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .top-message-text {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.35;
    }

    .verify-step-card {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .verify-step-pill {
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid var(--line);
      min-height: 74px;
      padding: 10px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      box-shadow: var(--shadow-soft);
    }

    .verify-step-pill.active {
      background: linear-gradient(180deg, #eef5ff 0%, #e4efff 100%);
      border-color: #bfdbfe;
    }

    .verify-step-number {
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: #e5e7eb;
      color: #4b5563;
      font-size: 12px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .verify-step-pill.active .verify-step-number {
      background: var(--blue);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.35);
    }

    .verify-step-text {
      font-size: 12px;
      font-weight: 700;
      color: #4b5563;
      text-align: center;
      line-height: 1.2;
    }

    .verify-step-pill.active .verify-step-text {
      color: var(--blue-dark);
    }

    .camera-card,
    .tips-card,
    .verify-result-card {
      border-radius: var(--radius-lg);
      background: var(--card);
      border: 1px solid var(--line);
      box-shadow: var(--shadow-card);
      padding: 14px;
      margin-bottom: 14px;
    }

    .camera-card-head,
    .verify-result-head,
    .tips-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .camera-card-title,
    .verify-result-title,
    .tips-title {
      font-size: 15px;
      font-weight: 800;
      color: var(--text-main);
    }

    .camera-card-subtitle,
    .tips-subtitle {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.4;
      color: var(--text-muted);
    }

    .camera-badge {
      border-radius: 999px;
      border: 1px solid #dbeafe;
      background: #eff6ff;
      color: var(--blue-dark);
      font-size: 11px;
      font-weight: 700;
      padding: 6px 10px;
      white-space: nowrap;
    }

    .camera-stage {
      position: relative;
      margin-top: 14px;
      border-radius: 24px;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,0.25), rgba(255,255,255,0) 30%),
        linear-gradient(180deg, #dbe7ff 0%, #b8cbfb 100%);
      min-height: 360px;
      aspect-ratio: 3 / 4;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.35);
    }

    .camera-video,
    .camera-canvas,
    .face-preview-wrap {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .camera-video,
    .face-preview-image {
      object-fit: cover;
    }

    .camera-canvas {
      pointer-events: none;
    }

    .face-preview-wrap.hidden,
    .hidden {
      display: none !important;
    }

    .face-preview-image {
      width: 100%;
      height: 100%;
      display: block;
    }

    .face-guide-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .face-frame {
      width: 66%;
      aspect-ratio: 0.8 / 1;
      border-radius: 38px;
      border: 3px solid rgba(219, 234, 254, 0.95);
      box-shadow:
        0 0 0 999px rgba(15, 23, 42, 0.18),
        inset 0 0 0 1px rgba(255,255,255,0.55),
        0 0 30px rgba(191, 219, 254, 0.55);
      position: relative;
    }

    .face-frame::before,
    .face-frame::after {
      content: "";
      position: absolute;
      width: 34px;
      height: 34px;
      border: 5px solid #bfdbfe;
      border-radius: 12px;
    }

    .face-frame::before {
      top: -3px;
      left: -3px;
      border-right: none;
      border-bottom: none;
    }

    .face-frame::after {
      right: -3px;
      bottom: -3px;
      border-left: none;
      border-top: none;
    }

    .face-guide-text {
      position: absolute;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.66);
      color: #ffffff;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
      backdrop-filter: blur(8px);
    }

    .camera-action-row {
      display: flex;
      gap: 10px;
      margin-top: 14px;
    }

    .action-btn,
    .primary-action-btn,
    .ghost-btn {
      border: none;
      cursor: pointer;
      transition: transform 0.08s ease, box-shadow 0.08s ease, opacity 0.08s ease;
    }

    .action-btn:active,
    .primary-action-btn:active,
    .ghost-btn:active {
      transform: translateY(1px) scale(0.985);
    }

    .action-btn {
      flex: 1;
      border-radius: var(--radius-pill);
      border: 1px solid var(--line);
      background: #f9fafb;
      color: #374151;
      min-height: 44px;
      font-size: 13px;
      font-weight: 700;
      box-shadow: 0 10px 24px rgba(148, 163, 184, 0.22);
    }

    .primary-action-btn {
      width: 100%;
      border-radius: var(--radius-pill);
      min-height: 48px;
      background: var(--blue);
      color: #ffffff;
      font-size: 14px;
      font-weight: 800;
      box-shadow: 0 14px 32px rgba(37, 99, 235, 0.35);
      margin-top: 12px;
    }

    .primary-action-btn:disabled,
    .action-btn:disabled {
      cursor: not-allowed;
      opacity: 0.58;
      box-shadow: none;
    }

    .tips-icon {
      width: 34px;
      height: 34px;
      border-radius: 999px;
      background: #fff7ed;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .tips-icon svg {
      width: 18px;
      height: 18px;
      stroke: #f59e0b;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .tips-list {
      margin: 14px 0 0;
      padding-left: 18px;
      color: var(--text-muted);
    }

    .tips-list li {
      margin-bottom: 10px;
      font-size: 13px;
      line-height: 1.5;
    }

    .verify-result-pill {
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      padding: 6px 10px;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .verify-result-pill.neutral {
      background: #f3f4f6;
      color: #4b5563;
      border-color: #e5e7eb;
    }

    .verify-result-pill.success {
      background: var(--green-soft);
      color: var(--green);
      border-color: #bbf7d0;
    }

    .verify-result-pill.error {
      background: var(--red-soft);
      color: var(--red);
      border-color: #fecaca;
    }

    .verify-result-text {
      margin: 12px 0 0;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-muted);
    }

    .message-box {
      margin-top: 12px;
      border-radius: 16px;
      padding: 12px 13px;
      font-size: 13px;
      line-height: 1.45;
      font-weight: 600;
    }

    .message-box.error {
      background: var(--red-soft);
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .message-box.success {
      background: var(--green-soft);
      color: #15803d;
      border: 1px solid #bbf7d0;
    }

    .bottom-action-stack {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-bottom: 8px;
    }

    .verify-btn {
      margin-top: 0;
    }

    .ghost-btn {
      width: 100%;
      min-height: 46px;
      border-radius: var(--radius-pill);
      background: #ffffff;
      border: 1px solid var(--line);
      color: #4b5563;
      font-size: 14px;
      font-weight: 700;
      box-shadow: var(--shadow-soft);
    }

    @media (max-width: 420px) {
      .hero-title {
        font-size: 26px;
      }

      .camera-stage {
        min-height: 320px;
      }

      .verify-step-pill {
        min-height: 70px;
      }

      .verify-step-text {
        font-size: 11px;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <main class="page">
      <section class="hero">
        <div class="hero-top">
          <button type="button" class="icon-back-btn" id="faceBackBtn" aria-label="Back">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
          </button>

          <div class="hero-copy">
            <div class="hero-line-1">Face verification</div>
            <h1 class="hero-title">
              Verify your<span> attendance</span>
            </h1>
            <p class="hero-subtitle">
              Take a clear live face photo so Colspot can confirm it is really you before joining attendance.
            </p>
          </div>
        </div>
      </section>

      <div class="top-message-card">
        <div class="top-message-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s-6-5.1-6-10a6 6 0 1 1 12 0c0 4.9-6 10-6 10z"></path>
            <circle cx="12" cy="11" r="2.5"></circle>
          </svg>
        </div>
        <div id="faceTopMessageText" class="top-message-text">
          Colspot will capture and verify your face before attendance is submitted.
        </div>
      </div>

      <div class="verify-step-card">
        <div class="verify-step-pill active">
          <span class="verify-step-number">1</span>
          <span class="verify-step-text">Open camera</span>
        </div>
        <div class="verify-step-pill">
          <span class="verify-step-number">2</span>
          <span class="verify-step-text">Capture face</span>
        </div>
        <div class="verify-step-pill">
          <span class="verify-step-number">3</span>
          <span class="verify-step-text">Verify</span>
        </div>
      </div>

      <section class="camera-card">
        <div class="camera-card-head">
          <div>
            <div class="camera-card-title">Live camera</div>
            <div id="faceStatusText" class="camera-card-subtitle">
              Camera is not started yet.
            </div>
          </div>

          <div class="camera-badge" id="faceCameraBadge">Ready</div>
        </div>

        <div class="camera-stage" id="cameraStage">
          <video
            id="faceVideo"
            class="camera-video"
            autoplay
            muted
            playsinline
          ></video>

          <canvas id="faceCanvas" class="camera-canvas"></canvas>

          <div id="faceGuideOverlay" class="face-guide-overlay">
            <div class="face-frame"></div>
            <div class="face-guide-text">
              Keep your face inside the frame
            </div>
          </div>

          <div id="facePreviewWrap" class="face-preview-wrap hidden">
            <img id="facePreviewImage" class="face-preview-image" alt="Captured face preview" />
          </div>
        </div>

        <div class="camera-action-row">
          <button type="button" class="action-btn secondary" id="startCameraBtn">
            Start camera
          </button>
          <button type="button" class="action-btn secondary" id="retakeFaceBtn" disabled>
            Retake
          </button>
        </div>

        <button type="button" class="primary-action-btn" id="captureFaceBtn" disabled>
          Capture face
        </button>
      </section>

      <section class="tips-card">
        <div class="tips-card-head">
          <div class="tips-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 18h6"></path>
              <path d="M10 22h4"></path>
              <path d="M12 2a7 7 0 0 0-4 12.8c.7.5 1.1 1.1 1.3 1.7h5.4c.2-.6.6-1.2 1.3-1.7A7 7 0 0 0 12 2z"></path>
            </svg>
          </div>
          <div>
            <div class="tips-title">Before you continue</div>
            <div class="tips-subtitle">
              Follow these simple tips for better face verification.
            </div>
          </div>
        </div>

        <ul class="tips-list">
          <li>Use your live front camera only. Do not use another phone or screen.</li>
          <li>Stay in good light and keep only your face inside the frame.</li>
          <li>Remove cap or anything blocking your face if possible.</li>
          <li>Hold your phone steady and look straight into the camera.</li>
        </ul>
      </section>

      <section class="verify-result-card">
        <div class="verify-result-head">
          <div class="verify-result-title">Verification result</div>
          <div id="faceResultPill" class="verify-result-pill neutral">Waiting</div>
        </div>

        <p id="faceResultText" class="verify-result-text">
          Capture your face to continue.
        </p>

        <div id="faceErrorBox" class="message-box error hidden"></div>
        <div id="faceSuccessBox" class="message-box success hidden"></div>
      </section>

      <div class="bottom-action-stack">
        <button type="button" class="primary-action-btn verify-btn" id="verifyFaceBtn" disabled>
          Verify and continue
        </button>

        <button type="button" class="ghost-btn" id="cancelFaceBtn">
          Cancel
        </button>
      </div>
    </main>
  </div>

  <script>
    window.SUPABASE_URL = "YOUR_SUPABASE_URL";
    window.SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
  </script>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="face_verification.js"></script>
</body>
</html>
