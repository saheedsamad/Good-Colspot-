<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
  />
  <title>View Message</title>

  <style>
    :root{
      --bg:#f5f7fb;
      --card:#ffffff;
      --line:#e6ecf5;
      --text:#182334;
      --muted:#73819a;
      --blue:#2f6cf6;
      --blue-soft:#edf4ff;
      --shadow:0 14px 35px rgba(15,23,42,.08);
      --safe-top:env(safe-area-inset-top, 0px);
      --safe-bottom:env(safe-area-inset-bottom, 0px);
    }

    *{ box-sizing:border-box; }

    html,body{
      margin:0;
      padding:0;
      background:var(--bg);
      color:var(--text);
      font-family:Inter, Arial, sans-serif;
      -webkit-text-size-adjust:100%;
    }

    body{
      min-height:100vh;
      display:flex;
      justify-content:center;
    }

    .page-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      background:
        radial-gradient(circle at top right, rgba(47,108,246,.07), transparent 34%),
        linear-gradient(180deg, #f8fbff 0%, #f4f7fb 100%);
      padding-bottom:calc(24px + var(--safe-bottom));
    }

    .page-head{
      padding:calc(var(--safe-top) + 14px) 16px 8px;
    }

    .head-row{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .back-btn{
      width:42px;
      height:42px;
      border:none;
      border-radius:14px;
      background:#fff;
      box-shadow:var(--shadow);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      color:#1c2940;
      flex-shrink:0;
    }

    .back-btn svg{
      width:22px;
      height:22px;
      stroke:currentColor;
      fill:none;
      stroke-width:2.2;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .head-copy{
      min-width:0;
    }

    .eyebrow{
      font-size:12px;
      font-weight:800;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.08em;
      margin-bottom:2px;
    }

    .page-title{
      font-size:22px;
      font-weight:900;
      color:#122033;
      line-height:1.1;
    }

    .page-body{
      padding:10px 16px 0;
    }

    .state-box{
      border:1px solid var(--line);
      background:#fff;
      border-radius:24px;
      box-shadow:var(--shadow);
      padding:24px 18px;
      text-align:center;
      color:var(--muted);
      font-size:15px;
    }

    .error-box{
      background:#fff5f5;
      border-color:#f3d1d1;
      color:#b42318;
    }

    .announcement-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:28px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .announcement-top{
      padding:18px 18px 14px;
      background:
        radial-gradient(circle at top right, rgba(47,108,246,.11), transparent 32%),
        linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
      border-bottom:1px solid var(--line);
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:34px;
      padding:0 14px;
      border-radius:999px;
      background:var(--blue-soft);
      color:var(--blue);
      font-size:12px;
      font-weight:800;
      margin-bottom:14px;
      max-width:100%;
    }

    .badge-dot{
      width:8px;
      height:8px;
      border-radius:50%;
      background:var(--blue);
      flex-shrink:0;
    }

    .announcement-title{
      font-size:30px;
      line-height:1.14;
      font-weight:900;
      letter-spacing:-.03em;
      margin:0 0 14px;
      color:#132034;
      word-break:break-word;
    }

    .meta{
      display:grid;
      gap:4px;
    }

    .meta-author{
      font-size:16px;
      font-weight:800;
      color:#1b2940;
    }

    .meta-time{
      font-size:13px;
      color:var(--muted);
    }

    .announcement-content{
      padding:16px 18px 18px;
    }

    .hero-wrap{
      width:100%;
      border-radius:22px;
      overflow:hidden;
      border:1px solid var(--line);
      background:#eef3fb;
      margin-bottom:16px;
    }

    .hero-wrap img{
      display:block;
      width:100%;
      aspect-ratio:16/9;
      object-fit:cover;
      background:#eef3fb;
    }

    .announcement-body{
      font-size:18px;
      line-height:1.75;
      color:#1f2b3d;
      white-space:pre-wrap;
      word-break:break-word;
    }

    .announcement-body p{
      margin:0 0 16px;
    }

    .announcement-body p:last-child{
      margin-bottom:0;
    }

    .resource-stack{
      display:grid;
      gap:12px;
      margin-top:18px;
    }

    .resource-card{
      border:1px solid var(--line);
      border-radius:20px;
      background:#fff;
      padding:14px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
    }

    .resource-left{
      display:flex;
      align-items:center;
      gap:12px;
      flex:1;
      min-width:0;
    }

    .resource-icon{
      width:46px;
      height:46px;
      border-radius:15px;
      background:var(--blue-soft);
      color:var(--blue);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .resource-icon svg{
      width:24px;
      height:24px;
      stroke:currentColor;
      fill:none;
      stroke-width:2;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .resource-copy{
      min-width:0;
    }

    .resource-title{
      font-size:16px;
      font-weight:800;
      color:#16233d;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      margin-bottom:4px;
    }

    .resource-sub{
      font-size:13px;
      color:var(--muted);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .resource-btn{
      border:none;
      border-radius:14px;
      background:linear-gradient(135deg, #2f6cf6, #5b8cff);
      color:#fff;
      min-height:42px;
      padding:0 16px;
      font-size:13px;
      font-weight:800;
      cursor:pointer;
      flex-shrink:0;
    }

    .footer-box{
      margin-top:18px;
      padding-top:16px;
      border-top:1px solid var(--line);
      display:grid;
      gap:10px;
    }

    .footer-row{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
      font-size:14px;
    }

    .footer-label{
      min-width:84px;
      color:var(--muted);
      font-weight:700;
    }

    .footer-value{
      flex:1;
      text-align:right;
      color:#16233d;
      font-weight:800;
      word-break:break-word;
    }

    .hidden{
      display:none !important;
    }

    @media (max-width:380px){
      .announcement-title{ font-size:27px; }
      .announcement-body{ font-size:16px; }
    }
  </style>
</head>
<body>
  <div class="page-shell">
    <div class="page-head">
      <div class="head-row">
        <button class="back-btn" id="backBtn" type="button" aria-label="Back">
          <svg viewBox="0 0 24 24">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <div class="head-copy">
          <div class="eyebrow">School Update</div>
          <div class="page-title">Announcement</div>
        </div>
      </div>
    </div>

    <div class="page-body">
      <div id="loadingState" class="state-box">Loading announcement...</div>
      <div id="errorState" class="state-box error-box hidden"></div>
      <div id="emptyState" class="state-box hidden">Announcement not found.</div>

      <section id="announcementCard" class="announcement-card hidden">
        <div class="announcement-top">
          <div class="badge">
            <span class="badge-dot"></span>
            <span id="announcementBadge">School Update</span>
          </div>

          <h1 id="announcementTitle" class="announcement-title">Announcement title</h1>

          <div class="meta">
            <div id="announcementAuthor" class="meta-author">School Admin</div>
            <div id="announcementDate" class="meta-time">Posted recently</div>
          </div>
        </div>

        <div class="announcement-content">
          <div id="imageWrap" class="hero-wrap hidden">
            <img id="announcementImage" alt="Announcement image" />
          </div>

          <div id="announcementBody" class="announcement-body"></div>

          <div class="resource-stack">
            <div id="linkCard" class="resource-card hidden">
              <div class="resource-left">
                <div class="resource-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M10 13a5 5 0 0 1 0-7l1.5-1.5a5 5 0 0 1 7 7L17 13"></path>
                    <path d="M14 11a5 5 0 0 1 0 7L12.5 19.5a5 5 0 0 1-7-7L7 11"></path>
                  </svg>
                </div>
                <div class="resource-copy">
                  <div id="linkTitle" class="resource-title">Open link</div>
                  <div class="resource-sub">Visit attached resource</div>
                </div>
              </div>
              <button id="viewLinkBtn" type="button" class="resource-btn">View Link</button>
            </div>

            <div id="fileCard" class="resource-card hidden">
              <div class="resource-left">
                <div class="resource-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
                    <path d="M14 2v5h5"></path>
                  </svg>
                </div>
                <div class="resource-copy">
                  <div id="fileTitle" class="resource-title">Attachment</div>
                  <div id="fileSub" class="resource-sub">Download attached file</div>
                </div>
              </div>
              <button id="downloadFileBtn" type="button" class="resource-btn">Download</button>
            </div>
          </div>

          <div class="footer-box">
            <div class="footer-row">
              <div class="footer-label">Sent to</div>
              <div id="announcementAudience" class="footer-value">All students</div>
            </div>

            <div class="footer-row">
              <div class="footer-label">By</div>
              <div id="announcementBy" class="footer-value">School Admin</div>
            </div>

            <div class="footer-row">
              <div class="footer-label">Time</div>
              <div id="announcementTimeFooter" class="footer-value">—</div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    function getSupabaseClient() {
      try {
        if (window.sb && typeof window.sb.from === "function") return window.sb;
        if (window.supabase && typeof window.supabase.from === "function") return window.supabase;
      } catch (e) {}
      return null;
    }

    function getQueryParam(name) {
      const params = new URLSearchParams(window.location.search);
      return params.get(name) || "";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatDateTime(value) {
      if (!value) return "Posted recently";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "Posted recently";
      return d.toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    }

    function bodyToHtml(text) {
      const safe = escapeHtml(text || "");
      if (!safe.trim()) return "<p>No message available.</p>";
      return safe
        .split(/\n{2,}/)
        .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
        .join("");
    }

    function setText(id, value, fallback = "") {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value || fallback);
    }

    function showLoading(show) {
      document.getElementById("loadingState").classList.toggle("hidden", !show);
    }

    function showError(message) {
      const el = document.getElementById("errorState");
      el.textContent = message || "Could not load announcement.";
      el.classList.remove("hidden");
    }

    function hideError() {
      const el = document.getElementById("errorState");
      el.classList.add("hidden");
      el.textContent = "";
    }

    function showEmpty(show) {
      document.getElementById("emptyState").classList.toggle("hidden", !show);
    }

    function showCard(show) {
      document.getElementById("announcementCard").classList.toggle("hidden", !show);
    }

    function getAudienceText(data) {
      const mode = String(data?.audience_mode || "").trim().toLowerCase();
      if (mode === "programme_filter") return "Selected students";
      return "All students";
    }

    function guessFileName(url) {
      try {
        if (!url) return "Attached file";
        const clean = url.split("?")[0];
        const name = decodeURIComponent(clean.substring(clean.lastIndexOf("/") + 1));
        return name || "Attached file";
      } catch (e) {
        return "Attached file";
      }
    }

    async function fetchAnnouncementById(announcementId) {
      const sb = getSupabaseClient();
      if (!sb) {
        throw new Error("Supabase client not found on this page.");
      }

      const { data, error } = await sb
        .from("school_announcements")
        .select("id, school_name, title, body, notification_title, notification_body, link_label, link_url, image_url, file_url, created_by_admin_name, audience_mode, created_at, published_at, status")
        .eq("id", announcementId)
        .maybeSingle();

      if (error) throw error;
      return data || null;
    }

    function renderAnnouncement(data) {
      const title =
        data.notification_title ||
        data.title ||
        "School Announcement";

      const body =
        data.body ||
        data.notification_body ||
        "";

      const createdAt =
        data.created_at ||
        data.published_at ||
        "";

      const author =
        data.created_by_admin_name ||
        "School Admin";

      const imageUrl = data.image_url || "";
      const linkUrl = data.link_url || "";
      const fileUrl = data.file_url || "";
      const linkLabel = data.link_label || "Open attached link";

      setText("announcementBadge", data.school_name || "School Update");
      setText("announcementTitle", title);
      setText("announcementAuthor", author);
      setText("announcementDate", `Posted on ${formatDateTime(createdAt)}`);
      setText("announcementAudience", getAudienceText(data));
      setText("announcementBy", author);
      setText("announcementTimeFooter", formatDateTime(createdAt));

      document.getElementById("announcementBody").innerHTML = bodyToHtml(body);

      const imageWrap = document.getElementById("imageWrap");
      const imageEl = document.getElementById("announcementImage");

      if (imageUrl) {
        imageEl.src = imageUrl;
        imageEl.alt = title;
        imageWrap.classList.remove("hidden");
        imageEl.onerror = () => {
          imageWrap.classList.add("hidden");
        };
      } else {
        imageEl.removeAttribute("src");
        imageWrap.classList.add("hidden");
      }

      const linkCard = document.getElementById("linkCard");
      const viewLinkBtn = document.getElementById("viewLinkBtn");

      if (linkUrl) {
        setText("linkTitle", linkLabel);
        linkCard.classList.remove("hidden");
        viewLinkBtn.onclick = () => window.open(linkUrl, "_blank", "noopener");
      } else {
        linkCard.classList.add("hidden");
        viewLinkBtn.onclick = null;
      }

      const fileCard = document.getElementById("fileCard");
      const downloadFileBtn = document.getElementById("downloadFileBtn");

      if (fileUrl) {
        setText("fileTitle", guessFileName(fileUrl));
        setText("fileSub", "Download attached file");
        fileCard.classList.remove("hidden");
        downloadFileBtn.onclick = () => window.open(fileUrl, "_blank", "noopener");
      } else {
        fileCard.classList.add("hidden");
        downloadFileBtn.onclick = null;
      }
    }

    async function initPage() {
      showLoading(true);
      hideError();
      showEmpty(false);
      showCard(false);

      try {
        const announcementId = getQueryParam("announcement_id");
        if (!announcementId) {
          showLoading(false);
          showEmpty(true);
          return;
        }

        const data = await fetchAnnouncementById(announcementId);
        showLoading(false);

        if (!data) {
          showEmpty(true);
          return;
        }

        renderAnnouncement(data);
        showCard(true);
      } catch (err) {
        console.error("view_message load error:", err);
        showLoading(false);
        showError(err?.message || "Could not load announcement.");
      }
    }

    document.getElementById("backBtn").addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "main.html";
      }
    });

    initPage();
  </script>
</body>
</html>
