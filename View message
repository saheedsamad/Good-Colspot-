      padding: calc(env(safe-area-inset-top) + 8px) 6px calc(env(safe-area-inset-bottom) + 90px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      min-height: 100%;
    }

    #screen-view-message .vm-shell {
      width: 100%;
    }

    #screen-view-message .topbar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
      position: sticky;
      top: 0;
      z-index: 4;
      padding-top: 2px;
      background: linear-gradient(180deg, rgba(248,251,255,.96) 0%, rgba(248,251,255,.88) 72%, rgba(248,251,255,0) 100%);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    #screen-view-message .back-btn {
      width: 42px;
      height: 42px;
      border: none;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 14px 35px rgba(15,23,42,.08);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #1c2940;
      flex-shrink: 0;
    }

    #screen-view-message .back-btn svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #screen-view-message .head-copy {
      min-width: 0;
    }

    #screen-view-message .eyebrow {
      font-size: 12px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 2px;
    }

    #screen-view-message .page-title {
      font-size: 22px;
      font-weight: 900;
      color: #122033;
      line-height: 1.1;
    }

    #screen-view-message .state-box {
      border: 1px solid #e6ecf5;
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 14px 35px rgba(15,23,42,.08);
      padding: 24px 18px;
      text-align: center;
      color: #73819a;
      font-size: 15px;
      margin-bottom: 14px;
    }

    #screen-view-message .error-box {
      background: #fff5f5;
      border-color: #f3d1d1;
      color: #b42318;
    }

    #screen-view-message .announcement-card {
      background: #ffffff;
      border: 1px solid #e6ecf5;
      border-radius: 28px;
      box-shadow: 0 14px 35px rgba(15,23,42,.08);
      overflow: hidden;
      padding: 18px;
    }

    #screen-view-message .vm-school-name {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 0 14px;
      border-radius: 999px;
      background: #edf4ff;
      color: #2f6cf6;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 16px;
      max-width: 100%;
    }

    #screen-view-message .vm-school-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #2f6cf6;
      flex-shrink: 0;
    }

    #screen-view-message .announcement-title {
      font-size: 30px;
      line-height: 1.14;
      font-weight: 900;
      letter-spacing: -.03em;
      margin: 0 0 14px;
      color: #132034;
      word-break: break-word;
    }

    #screen-view-message .announcement-body {
      font-size: 18px;
      line-height: 1.75;
      color: #1f2b3d;
      white-space: pre-wrap;
      word-break: break-word;
      margin-bottom: 18px;
    }

    #screen-view-message .announcement-body p {
      margin: 0 0 16px;
    }

    #screen-view-message .announcement-body p:last-child {
      margin-bottom: 0;
    }

    #screen-view-message .hero-wrap {
      width: 100%;
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid #e6ecf5;
      background: #eef3fb;
      margin-bottom: 18px;
    }

    #screen-view-message .hero-wrap img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: #eef3fb;
    }

    #screen-view-message .link-card {
      border: 1px solid #e6ecf5;
      border-radius: 20px;
      background: #fff;
      padding: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      box-shadow: 0 8px 24px rgba(15,23,42,.04);
      margin-bottom: 18px;
    }

    #screen-view-message .link-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
    }

    #screen-view-message .link-icon {
      width: 46px;
      height: 46px;
      border-radius: 15px;
      background: #edf4ff;
      color: #2f6cf6;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    #screen-view-message .link-icon svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #screen-view-message .link-copy {
      min-width: 0;
    }

    #screen-view-message .link-title {
      font-size: 16px;
      font-weight: 800;
      color: #16233d;
      word-break: break-word;
      margin-bottom: 4px;
    }

    #screen-view-message .link-sub {
      font-size: 13px;
      color: #73819a;
      word-break: break-word;
      line-height: 1.5;
    }

    #screen-view-message .link-btn {
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #2f6cf6, #5b8cff);
      color: #fff;
      min-height: 42px;
      padding: 0 16px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      flex-shrink: 0;
    }

    #screen-view-message .footer-box {
      margin-top: 2px;
      padding-top: 16px;
      border-top: 1px solid #e6ecf5;
      display: grid;
      gap: 10px;
    }

    #screen-view-message .footer-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      font-size: 14px;
    }

    #screen-view-message .footer-label {
      min-width: 84px;
      color: #73819a;
      font-weight: 700;
    }

    #screen-view-message .footer-value {
      flex: 1;
      text-align: right;
      color: #16233d;
      font-weight: 800;
      word-break: break-word;
    }

    #screen-view-message .hidden {
      display: none !important;
    }

    @media (max-width: 380px) {
      #screen-view-message .announcement-title {
        font-size: 27px;
      }

      #screen-view-message .announcement-body {
        font-size: 16px;
      }

      #screen-view-message .link-card {
        flex-direction: column;
        align-items: stretch;
      }

      #screen-view-message .link-btn {
        width: 100%;
      }
    }
  </style>

  <div class="vm-shell">
    <div class="topbar">
      <button class="back-btn" id="viewMessageBackBtn" type="button" aria-label="Back">
        <svg viewBox="0 0 24 24">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <div class="head-copy">
        <div class="eyebrow">School Update</div>
        <div class="page-title">Announcement</div>
      </div>
    </div>

    <div id="viewMessageLoadingState" class="state-box">Loading announcement...</div>
    <div id="viewMessageErrorState" class="state-box error-box hidden"></div>
    <div id="viewMessageEmptyState" class="state-box hidden">Announcement not found.</div>

    <section id="viewMessageCard" class="announcement-card hidden">
      <div id="viewMessageSchoolName" class="vm-school-name">
        <span class="vm-school-dot"></span>
        <span id="viewMessageSchoolText">School Name</span>
      </div>

      <h1 id="viewMessageTitle" class="announcement-title">Announcement title</h1>

      <div id="viewMessageBody" class="announcement-body"></div>

      <div id="viewMessageImageWrap" class="hero-wrap hidden">
        <img id="viewMessageImage" alt="Announcement image" />
      </div>

      <div id="viewMessageLinkCard" class="link-card hidden">
        <div class="link-left">
          <div class="link-icon">
            <svg viewBox="0 0 24 24">
              <path d="M10 13a5 5 0 0 1 0-7l1.5-1.5a5 5 0 0 1 7 7L17 13"></path>
              <path d="M14 11a5 5 0 0 1 0 7L12.5 19.5a5 5 0 0 1-7-7L7 11"></path>
            </svg>
          </div>

          <div class="link-copy">
            <div id="viewMessageLinkTitle" class="link-title">Open link</div>
            <div id="viewMessageLinkSub" class="link-sub">Visit attached resource</div>
          </div>
        </div>

        <button id="viewMessageViewLinkBtn" type="button" class="link-btn">Open</button>
      </div>

      <div class="footer-box">
        <div class="footer-row">
          <div class="footer-label">Posted by</div>
          <div id="viewMessageBy" class="footer-value">School Admin</div>
        </div>

        <div class="footer-row">
          <div class="footer-label">Time</div>
          <div id="viewMessageTimeFooter" class="footer-value">—</div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  window.viewMessageScreenState = window.viewMessageScreenState || {
    loadedAnnouncementId: "",
    currentAnnouncement: null
  };

  function vmEl(id) {
    return document.getElementById(id);
  }

  function vmEscapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function vmFormatDateTime(value) {
    if (!value) return "Posted recently";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "Posted recently";
    return d.toLocaleString([], {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit"
    });
  }

  function vmBodyToHtml(text) {
    const safe = vmEscapeHtml(text || "");
    if (!safe.trim()) return "<p>No message available.</p>";
    return safe
      .split(/\n{2,}/)
      .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  function vmSetText(id, value, fallback = "") {
    const el = vmEl(id);
    if (el) el.textContent = String(value || fallback);
  }

  function vmShowLoading(show) {
    vmEl("viewMessageLoadingState").classList.toggle("hidden", !show);
  }

  function vmShowError(message) {
    const el = vmEl("viewMessageErrorState");
    el.textContent = message || "Could not load announcement.";
    el.classList.remove("hidden");
  }

  function vmHideError() {
    const el = vmEl("viewMessageErrorState");
    el.classList.add("hidden");
    el.textContent = "";
  }

  function vmShowEmpty(show) {
    vmEl("viewMessageEmptyState").classList.toggle("hidden", !show);
  }

  function vmShowCard(show) {
    vmEl("viewMessageCard").classList.toggle("hidden", !show);
  }

  async function vmFetchAnnouncementById(announcementId) {
    const { data, error } = await supabase
      .from("school_announcements")
      .select("id, school_name, title, body, notification_title, notification_body, link_label, link_url, image_url, file_url, created_by_admin_name, created_at, published_at, status")
      .eq("id", announcementId)
      .maybeSingle();

    if (error) throw error;
    return data || null;
  }

  function vmRenderAnnouncement(data) {
    const schoolName = data.school_name || "School Update";
    const title =
      data.notification_title ||
      data.title ||
      "School Announcement";

    const body =
      data.body ||
      data.notification_body ||
      data.message ||
      "";

    const createdAt =
      data.created_at ||
      data.published_at ||
      "";

    const author =
      data.created_by_admin_name ||
      "School Admin";

    const imageUrl = data.image_url || "";
    const linkUrl = data.link_url || "";
    const linkLabel = data.link_label || "Open attached link";

    vmSetText("viewMessageSchoolText", schoolName);
    vmSetText("viewMessageTitle", title);
    vmSetText("viewMessageBy", author);
    vmSetText("viewMessageTimeFooter", vmFormatDateTime(createdAt));

    vmEl("viewMessageBody").innerHTML = vmBodyToHtml(body);

    const imageWrap = vmEl("viewMessageImageWrap");
    const imageEl = vmEl("viewMessageImage");

    if (imageUrl) {
      imageEl.onload = () => {
        imageWrap.classList.remove("hidden");
      };
      imageEl.onerror = () => {
        imageWrap.classList.add("hidden");
      };
      imageEl.src = imageUrl;
      imageEl.alt = title;
    } else {
      imageEl.removeAttribute("src");
      imageWrap.classList.add("hidden");
    }

    const linkCard = vmEl("viewMessageLinkCard");
    const viewLinkBtn = vmEl("viewMessageViewLinkBtn");

    if (linkUrl) {
      vmSetText("viewMessageLinkTitle", linkLabel);
      vmSetText("viewMessageLinkSub", linkUrl);
      linkCard.classList.remove("hidden");
      viewLinkBtn.onclick = () => window.open(linkUrl, "_blank", "noopener");
    } else {
      linkCard.classList.add("hidden");
      viewLinkBtn.onclick = null;
    }
  }

  async function openViewMessageScreen(force = false) {
    vmShowLoading(true);
    vmHideError();
    vmShowEmpty(false);
    vmShowCard(false);

    try {
      const selected = window.historyScreenState?.selectedAnnouncement || null;
      if (!selected) {
        vmShowLoading(false);
        vmShowEmpty(true);
        return;
      }

      const selectedId = selected.id || "";
      const state = window.viewMessageScreenState || {};

      if (!force && state.loadedAnnouncementId && selectedId && state.loadedAnnouncementId === selectedId && state.currentAnnouncement) {
        vmShowLoading(false);
        vmRenderAnnouncement(state.currentAnnouncement);
        vmShowCard(true);
        return;
      }

      let data = selected;

      if (selectedId && typeof supabase !== "undefined") {
        const fetched = await vmFetchAnnouncementById(selectedId);
        if (fetched) data = fetched;
      }

      window.viewMessageScreenState.loadedAnnouncementId = selectedId || "";
      window.viewMessageScreenState.currentAnnouncement = data;

      vmShowLoading(false);

      if (!data) {
        vmShowEmpty(true);
        return;
      }

      vmRenderAnnouncement(data);
      vmShowCard(true);
    } catch (err) {
      console.error("view message load error:", err);
      vmShowLoading(false);
      vmShowError(err?.message || "Could not load announcement.");
    }
  }

  function closeViewMessageBack() {
    if (typeof showScreen === "function") {
      showScreen("history");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    vmEl("viewMessageBackBtn")?.addEventListener("click", closeViewMessageBack);
  });

  window.openViewMessageScreen = openViewMessageScreen;
</script>
<!-- 🔹 VIEW MESSAGE SCREEN END -->
