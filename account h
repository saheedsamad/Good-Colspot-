            style="font-size:11px; color:var(--text-muted); display:block;"
          ></span>
        </div>
        <input id="editMatricNumber" class="text-input" type="text" />
      </div>

      <div class="form-group" id="editLevelGroup">
        <div class="form-label">
          Level
          <span
            id="levelHint"
            style="font-size:11px; color:var(--text-muted); display:block;"
          ></span>
        </div>
        <input id="editLevel" class="text-input" type="text" />
      </div>

      <div class="form-group" id="editSemesterGroup">
        <div class="form-label">
          Semester
          <span
            id="semesterHint"
            style="font-size:11px; color:var(--text-muted); display:block;"
          ></span>
        </div>
        <input id="editSemester" class="text-input" type="text" />
