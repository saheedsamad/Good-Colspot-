<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#eaf2ff;
      --bg:#f5f9ff;
      --card:#ffffff;
      --line:#e5e7eb;
      --muted:#6b7280;
      --text:#111827;
      --shadow:0 14px 32px rgba(15,23,42,.08);
      --shadow-soft:0 8px 20px rgba(37,99,235,.08);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:18px;
      --radius-sm:14px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      min-height:100%;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at top, #dfecff 0%, #f7fbff 52%, #ffffff 100%);
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .app{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:
        calc(env(safe-area-inset-top) + 12px)
        14px
        calc(env(safe-area-inset-bottom) + 102px);
      position:relative;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:12px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }

    .brand-logo img{
      width:34px;
      height:34px;
      object-fit:contain;
      display:block;
    }

    .brand-name{
      font-size:19px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#10224a;
    }

    .avatar-chip{
      width:42px;
      height:42px;
      border:none;
      border-radius:999px;
      background:linear-gradient(135deg,#2563eb 0%, #22c55e 100%);
      color:#fff;
      font-weight:900;
      font-size:15px;
      box-shadow:var(--shadow);
      cursor:pointer;
    }

    .hero{
      margin:8px 2px 16px;
      padding:20px 16px;
      border-radius:26px;
      background:linear-gradient(135deg,var(--blue),#3b82f6);
      color:#fff;
      position:relative;
      overflow:hidden;
      box-shadow:0 18px 34px rgba(37,99,235,.22);
    }

    .hero::before{
      content:"";
      position:absolute;
      right:-28px;
      top:-30px;
      width:140px;
      height:140px;
      border-radius:50%;
      background:rgba(255,255,255,.10);
    }

    .hero::after{
      content:"";
      position:absolute;
      right:18px;
      bottom:-50px;
      width:160px;
      height:90px;
      border-radius:50%;
      background:rgba(255,255,255,.08);
      transform:rotate(-16deg);
    }

    .hero-school{
      font-size:14px;
      font-weight:800;
      opacity:.96;
      margin-bottom:6px;
      position:relative;
      z-index:1;
    }

    .hero-title{
      margin:0 0 8px;
      font-size:34px;
      line-height:1.02;
      font-weight:900;
      letter-spacing:-.05em;
      position:relative;
      z-index:1;
    }

    .hero-sub{
      font-size:13px;
      line-height:1.5;
      opacity:.96;
      max-width:260px;
      position:relative;
      z-index:1;
    }

    .message{
      display:none;
      margin:0 2px 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin:0 2px 14px;
    }

    .stat-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      padding:18px 14px;
      box-shadow:var(--shadow-soft);
      text-align:center;
    }

    .stat-label{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
      margin-bottom:10px;
    }

    .stat-value{
      font-size:31px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.05em;
      color:#0f172a;
    }

    .action-card{
      margin:0 2px 18px;
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      padding:14px;
      box-shadow:var(--shadow-soft);
    }

    .action-btn{
      width:100%;
      border:none;
      border-radius:999px;
      padding:15px 16px;
      font-size:15px;
      font-weight:900;
      color:#fff;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      box-shadow:0 14px 28px rgba(37,99,235,.20);
      cursor:pointer;
    }

    .action-note{
      margin-top:10px;
      text-align:center;
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:0 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:17px;
      font-weight:900;
      letter-spacing:-.02em;
    }

    .view-btn{
      border:none;
      background:var(--blue-soft);
      color:var(--blue);
      padding:10px 12px;
      border-radius:12px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .history-wrap{
      margin:0 2px;
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      padding:14px;
      box-shadow:var(--shadow-soft);
    }

    .history-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .history-item{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .history-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
      margin-bottom:6px;
    }

    .history-title{
      font-size:14px;
      line-height:1.3;
      font-weight:800;
      color:#111827;
    }

    .history-sub{
      font-size:12px;
      line-height:1.45;
      color:var(--muted);
      margin-top:3px;
    }

    .history-type{
      flex-shrink:0;
      border-radius:999px;
      padding:6px 10px;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:#eff6ff;
      color:var(--blue);
    }

    .empty{
      font-size:13px;
      color:var(--muted);
      text-align:center;
      padding:18px 8px;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 28px);
      max-width:392px;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
      border:1px solid rgba(229,231,235,.9);
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      border-radius:26px;
      padding:8px 8px 10px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:4px;
      z-index:30;
    }

    .nav-btn{
      border:none;
      background:transparent;
      color:#94a3b8;
      text-align:center;
      font-size:11px;
      cursor:pointer;
      padding-top:2px;
    }

    .nav-btn.active{
      color:var(--blue);
      font-weight:800;
    }

    .nav-inner{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:4px;
    }

    .nav-inner svg{
      width:20px;
      height:20px;
      display:block;
    }
  </style>
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="avatar-chip" id="avatarChip">H</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-school" id="schoolNameText">School</div>
        <h1 class="hero-title">HOS Dashboard</h1>
        <div class="hero-sub">
          Manage your school overview and recent activities.
        </div>
      </section>

      <div class="message" id="pageErrorBox"></div>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Total students</div>
          <div class="stat-value" id="totalStudentCount">0</div>
        </div>

        <div class="stat-card">
          <div class="stat-label">Total HODs</div>
          <div class="stat-value" id="totalHodCount">0</div>
        </div>
      </section>

      <section class="action-card">
        <button class="action-btn" id="createAccountBtn" type="button">
          Create account for HOD / Agent
        </button>
        <div class="action-note">
          Create HOD and report agent accounts from one place.
        </div>
      </section>

      <div class="section-head">
        <h2 class="section-title">Latest history</h2>
        <button class="view-btn" id="viewHistoryBtn" type="button">View all</button>
      </div>

      <section class="history-wrap">
        <div class="history-list" id="historyList">
          <div class="empty">Loading history...</div>
        </div>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button" onclick="window.location.href='hos.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 0 1-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 0 1 4.5 19v-8.25Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Dashboard</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_create_account.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="7" r="3.5" stroke="currentColor" stroke-width="1.7"/>
          <path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>Accounts</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_announcement.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 11.5V7.8A1.8 1.8 0 0 1 5.8 6h12.4A1.8 1.8 0 0 1 20 7.8v8.4A1.8 1.8 0 0 1 18.2 18H9l-5 3v-9.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Announcement</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_history.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 12a8 8 0 1 1-2.35-5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>History</span>
      </span>
    </button>
  </nav>

  <script>
    (() => {
      const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
      const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY_HERE";

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const HISTORY_KEY = "hos_activity_history";

      let adminSession = null;
      let currentSchoolName = "";

      function $(id){
        return document.getElementById(id);
      }

      function escapeHtml(value){
        return String(value || "")
          .replaceAll("&","&amp;")
          .replaceAll("<","&lt;")
          .replaceAll(">","&gt;")
          .replaceAll('"',"&quot;")
          .replaceAll("'","&#39;");
      }

      function formatDate(value){
        if (!value) return "-";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "-";
        return d.toLocaleString();
      }

      function getAdminSession(){
        try{
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        }catch{
          return null;
        }
      }

      function getHosHistory(){
        try{
          const raw = localStorage.getItem(HISTORY_KEY);
          const arr = JSON.parse(raw || "[]");
          return Array.isArray(arr) ? arr : [];
        }catch{
          return [];
        }
      }

      function showMessage(id, text){
        const box = $(id);
        if (!text){
          box.textContent = "";
          box.className = "message";
          return;
        }
        box.textContent = text;
        box.className = "message error";
      }

      function requireHosSession(){
        adminSession = getAdminSession();

        if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
          window.location.href = "index.html";
          return false;
        }

        currentSchoolName =
          adminSession.school_name ||
          adminSession.school ||
          adminSession.schoolName ||
          "";

        $("schoolNameText").textContent = currentSchoolName || "School";

        const initial = (adminSession.full_name || "H").trim().charAt(0).toUpperCase() || "H";
        $("avatarChip").textContent = initial;

        return true;
      }

      async function loadDashboard(){
        showMessage("pageErrorBox", "");

        try{
          const schoolName = currentSchoolName;

          const [studentsRes, hodsRes] = await Promise.all([
            sb
              .from("student_profiles")
              .select("id", { count: "exact", head: true })
              .eq("school_name", schoolName),

            sb
              .from("hod_accounts")
              .select("id", { count: "exact", head: true })
              .eq("school_name", schoolName)
          ]);

          if (studentsRes.error) throw studentsRes.error;
          if (hodsRes.error) throw hodsRes.error;

          $("totalStudentCount").textContent = String(studentsRes.count || 0);
          $("totalHodCount").textContent = String(hodsRes.count || 0);

          const history = getHosHistory()
            .sort((a,b) => new Date(b.created_at || 0) - new Date(a.created_at || 0))
            .slice(0,2);

          renderHistory(history);
        } catch(err){
          console.error(err);
          $("totalStudentCount").textContent = "0";
          $("totalHodCount").textContent = "0";
          renderHistory([]);
          showMessage("pageErrorBox", err.message || "Could not load dashboard.");
        }
      }

      function renderHistory(items){
        const wrap = $("historyList");

        if (!items.length){
          wrap.innerHTML = '<div class="empty">No recent history yet.</div>';
          return;
        }

        wrap.innerHTML = items.map((item) => `
          <div class="history-item">
            <div class="history-top">
              <div>
                <div class="history-title">${escapeHtml(item.title || "-")}</div>
                <div class="history-sub">${escapeHtml(item.description || "-")}</div>
              </div>
              <div class="history-type">${escapeHtml(item.type || "Item")}</div>
            </div>
            <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
          </div>
        `).join("");
      }

      document.addEventListener("DOMContentLoaded", async () => {
        if (!requireHosSession()) return;

        $("avatarChip").addEventListener("click", () => {
          window.location.href = "hos_account.html";
        });

        $("createAccountBtn").addEventListener("click", () => {
          window.location.href = "hos_create_account.html";
        });

        $("viewHistoryBtn").addEventListener("click", () => {
          window.location.href = "hos_history.html";
        });

        await loadDashboard();
      });
    })();
  </script>
</body>
</html>
