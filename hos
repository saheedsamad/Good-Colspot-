<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#eef4ff;
      --blue-soft-2:#f7faff;
      --card:#ffffff;
      --line:#e5e7eb;
      --muted:#6b7280;
      --text:#111827;
      --success:#16a34a;
      --shadow:0 18px 40px rgba(15,23,42,.08);
      --shadow-soft:0 10px 26px rgba(37,99,235,.10);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:18px;
      --radius-sm:14px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:
        radial-gradient(circle at top, #dfeeff 0%, #f6faff 48%, #ffffff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:calc(env(safe-area-inset-top) + 12px) 14px 108px;
      position:relative;
    }

    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:14px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:14px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      box-shadow:var(--shadow-soft);
      flex-shrink:0;
    }

    .brand-logo svg{
      width:20px;
      height:20px;
    }

    .brand-name{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#10224a;
      white-space:nowrap;
    }

    .avatar-chip{
      width:42px;
      height:42px;
      border-radius:999px;
      border:none;
      background:linear-gradient(135deg,#1d4ed8,#22c55e);
      color:#fff;
      font-weight:900;
      box-shadow:var(--shadow);
      cursor:pointer;
      flex-shrink:0;
    }

    .hero{
      margin:4px 2px 18px;
      padding:22px 18px;
      border-radius:var(--radius-xl);
      background:linear-gradient(135deg,var(--blue),#3b82f6);
      color:#fff;
      position:relative;
      overflow:hidden;
      box-shadow:0 24px 44px rgba(37,99,235,.22);
    }

    .hero::before{
      content:"";
      position:absolute;
      right:-34px;
      top:-26px;
      width:150px;
      height:150px;
      border-radius:50%;
      background:rgba(255,255,255,.10);
    }

    .hero::after{
      content:"";
      position:absolute;
      right:-18px;
      bottom:-34px;
      width:190px;
      height:96px;
      border-radius:50%;
      background:rgba(255,255,255,.08);
      transform:rotate(-18deg);
    }

    .hero-line{
      font-size:13px;
      font-weight:800;
      opacity:.95;
      margin-bottom:6px;
      position:relative;
      z-index:1;
    }

    .hero-title{
      font-size:30px;
      line-height:1.05;
      font-weight:900;
      letter-spacing:-.04em;
      margin:0 0 8px;
      position:relative;
      z-index:1;
      max-width:240px;
    }

    .hero-sub{
      font-size:13px;
      line-height:1.5;
      opacity:.96;
      position:relative;
      z-index:1;
      max-width:255px;
    }

    .message{
      display:none;
      margin:0 2px 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin:0 2px 14px;
    }

    .stat-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:20px;
      padding:18px 14px;
      box-shadow:var(--shadow-soft);
      position:relative;
      overflow:hidden;
    }

    .stat-card::after{
      content:"";
      position:absolute;
      right:-16px;
      bottom:-18px;
      width:72px;
      height:72px;
      border-radius:50%;
      background:var(--blue-soft);
    }

    .stat-label{
      position:relative;
      z-index:1;
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      font-weight:800;
      letter-spacing:.08em;
      margin-bottom:10px;
    }

    .stat-value{
      position:relative;
      z-index:1;
      font-size:30px;
      font-weight:900;
      line-height:1;
      letter-spacing:-.05em;
      margin-bottom:6px;
    }

    .stat-note{
      position:relative;
      z-index:1;
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
    }

    .quick-links{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:10px;
      margin:0 2px 18px;
    }

    .quick-link{
      border:none;
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px 10px;
      box-shadow:var(--shadow-soft);
      cursor:pointer;
      text-align:left;
      min-height:96px;
    }

    .quick-link-icon{
      width:38px;
      height:38px;
      border-radius:12px;
      background:var(--blue-soft);
      display:flex;
      align-items:center;
      justify-content:center;
      color:var(--blue);
      margin-bottom:10px;
    }

    .quick-link-icon svg{
      width:18px;
      height:18px;
    }

    .quick-link-title{
      font-size:13px;
      font-weight:800;
      line-height:1.25;
      margin-bottom:4px;
      color:#0f172a;
    }

    .quick-link-sub{
      font-size:11px;
      line-height:1.35;
      color:var(--muted);
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin:0 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:16px;
      font-weight:900;
      letter-spacing:-.02em;
    }

    .view-btn{
      border:none;
      background:var(--blue-soft);
      color:var(--blue);
      padding:10px 12px;
      border-radius:12px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      padding:14px;
      box-shadow:var(--shadow-soft);
      margin:0 2px 14px;
    }

    .history-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .history-card{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .history-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      margin-bottom:8px;
    }

    .history-title{
      font-size:14px;
      font-weight:800;
      line-height:1.25;
      color:#111827;
    }

    .history-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
      margin-top:3px;
    }

    .pill{
      flex-shrink:0;
      border-radius:999px;
      padding:5px 10px;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:#eff6ff;
      color:var(--blue);
    }

    .empty{
      font-size:13px;
      color:var(--muted);
      text-align:center;
      padding:18px 8px;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 28px);
      max-width:392px;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
      border:1px solid rgba(229,231,235,.9);
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      border-radius:26px;
      padding:8px 8px 10px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:4px;
      z-index:30;
    }

    .nav-btn{
      border:none;
      background:transparent;
      color:#94a3b8;
      text-align:center;
      font-size:11px;
      cursor:pointer;
      padding-top:2px;
    }

    .nav-btn.active{
      color:var(--blue);
      font-weight:800;
    }

    .nav-inner{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:3px;
    }

    .nav-inner svg{
      width:20px;
      height:20px;
      display:block;
    }

    @media (max-width:360px){
      .quick-links{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 5h12v14H6z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="avatar-chip" id="avatarChip">H</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-line" id="schoolNameText">School</div>
        <h1 class="hero-title">HOS Dashboard</h1>
        <div class="hero-sub">
          Manage students, announcements, and key admin sections from one clean dashboard.
        </div>
      </section>

      <div class="message" id="pageErrorBox"></div>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Students</div>
          <div class="stat-value" id="totalStudentCount">--</div>
          <div class="stat-note">Total student records</div>
        </div>

        <div class="stat-card">
          <div class="stat-label">Announcements</div>
          <div class="stat-value" id="totalAnnouncementCount">--</div>
          <div class="stat-note">School announcements sent</div>
        </div>
      </section>

      <section class="quick-links">
        <button class="quick-link" id="goAccountsBtn" type="button">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="9.5" cy="7" r="3.5" stroke="currentColor" stroke-width="1.7"/>
              <path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="quick-link-title">Create accounts</div>
          <div class="quick-link-sub">HOD and agent accounts</div>
        </button>

        <button class="quick-link" id="goAnnouncementBtn" type="button">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 11.5V7.8A1.8 1.8 0 0 1 5.8 6h12.4A1.8 1.8 0 0 1 20 7.8v8.4A1.8 1.8 0 0 1 18.2 18H9l-5 3v-9.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="quick-link-title">Announcement</div>
          <div class="quick-link-sub">Send school updates</div>
        </button>

        <button class="quick-link" id="goHistoryBtn" type="button">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 12a8 8 0 1 1-2.35-5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="quick-link-title">History</div>
          <div class="quick-link-sub">Recent admin activity</div>
        </button>
      </section>

      <div class="section-head">
        <h2 class="section-title">Latest history</h2>
        <button class="view-btn" id="viewHistoryBtn" type="button">View all</button>
      </div>

      <section class="card">
        <div class="history-list" id="historyList">
          <div class="empty">Loading recent history...</div>
        </div>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button" onclick="window.location.href='hos.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 01-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 014.5 19v-8.25z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Dashboard</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_create_account.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="7" r="3.5" stroke="currentColor" stroke-width="1.7"/>
          <path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>Accounts</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_announcement.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 11.5V7.8A1.8 1.8 0 0 1 5.8 6h12.4A1.8 1.8 0 0 1 20 7.8v8.4A1.8 1.8 0 0 1 18.2 18H9l-5 3v-9.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Announcement</span>
      </span>
    </button>

    <button class="nav-btn" type="button" onclick="window.location.href='hos_history.html'">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 12a8 8 0 1 1-2.35-5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>History</span>
      </span>
    </button>
  </nav>

<script>
  (() => {
    const SUPABASE_URL = "YOUR_SUPABASE_URL";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";

    const EDGE = {
      studentSummary: "hos-student-summary",
      sendAnnouncement: "hos-send-announcement",
      createHod: "create-hod-account"
    };

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let adminSession = null;
    let currentSchoolName = "";

    function $(id){
      return document.getElementById(id);
    }

    function escapeHtml(value){
      return String(value || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#39;");
    }

    function formatDate(value){
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function getAdminSession(){
      try{
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      }catch{
        return null;
      }
    }

    function showMessage(id, text, type){
      const box = $(id);
      if (!box) return;

      if (!text){
        box.textContent = "";
        box.className = "message";
        return;
      }

      box.textContent = text;
      box.className = `message ${type === "success" ? "success" : "error"}`;
    }

    function requireHosSession(){
      adminSession = getAdminSession();

      if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
        window.location.href = "index.html";
        return false;
      }

      currentSchoolName =
        adminSession.school_name ||
        adminSession.school ||
        adminSession.schoolName ||
        "";

      if ($("schoolNameText")) {
        $("schoolNameText").textContent = currentSchoolName || "School not found";
      }

      const initial = (adminSession.full_name || "H")
        .trim()
        .charAt(0)
        .toUpperCase() || "H";

      if ($("avatarChip")) {
        $("avatarChip").textContent = initial;
      }

      return true;
    }

    async function invokeEdge(functionName, body){
      const { data, error } = await sb.functions.invoke(functionName, {
        body: body || {}
      });

      if (error){
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      return data || {};
    }

    function renderStudentList(rows){
      const wrap = $("studentList");
      if (!wrap) return;

      if (!rows || !rows.length){
        wrap.innerHTML = '<div class="empty">No students found for this school.</div>';
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.full_name || "No name")}</div>
              <div class="history-sub">${escapeHtml(item.matric_number || "No matric number")}</div>
            </div>
            <div class="pill">Student</div>
          </div>
          <div class="history-sub">Faculty: ${escapeHtml(item.faculty || "-")}</div>
          <div class="history-sub">Department: ${escapeHtml(item.department || "-")}</div>
          <div class="history-sub">Programme: ${escapeHtml(item.programme || "-")}</div>
          <div class="history-sub">Level: ${escapeHtml(item.level || "-")}</div>
          <div class="history-sub">School: ${escapeHtml(item.school_name || "-")}</div>
        </div>
      `).join("");
    }

    function renderAnnouncementList(rows){
      const wrap = $("announcementList");
      if (!wrap) return;

      if (!rows || !rows.length){
        wrap.innerHTML = '<div class="empty">No announcements yet for this school.</div>';
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.title || "Untitled announcement")}</div>
              <div class="history-sub">${escapeHtml((item.message || "").slice(0, 160) || "-")}</div>
            </div>
            <div class="pill">School</div>
          </div>
          <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
        </div>
      `).join("");
    }

    async function loadStudentData(){
      if ($("totalStudentCount")) $("totalStudentCount").textContent = "--";
      if ($("totalStudentShown")) $("totalStudentShown").textContent = "--";
      showMessage("pageErrorBox", "", "error");

      try{
        const result = await invokeEdge(EDGE.studentSummary, {
          hos_admin_id: adminSession.id
        });

        if (!result.ok){
          throw new Error(result.error || "Could not load dashboard summary.");
        }

        const totals = result.totals || {};
        const students = Array.isArray(result.students) ? result.students : [];
        const recentAnnouncements = Array.isArray(result.recent_announcements)
          ? result.recent_announcements
          : [];

        if ($("totalStudentCount")) $("totalStudentCount").textContent = String(totals.students || 0);
        if ($("totalStudentShown")) $("totalStudentShown").textContent = String(students.length || 0);
        if ($("totalAnnouncementCount")) $("totalAnnouncementCount").textContent = String(totals.announcements || 0);
        if ($("totalAnnouncementShown")) $("totalAnnouncementShown").textContent = String(recentAnnouncements.length || 0);

        renderStudentList(students);
        renderAnnouncementList(recentAnnouncements);
      }catch(err){
        console.error(err);
        if ($("totalStudentCount")) $("totalStudentCount").textContent = "0";
        if ($("totalStudentShown")) $("totalStudentShown").textContent = "0";
        if ($("totalAnnouncementCount")) $("totalAnnouncementCount").textContent = "0";
        if ($("totalAnnouncementShown")) $("totalAnnouncementShown").textContent = "0";
        renderStudentList([]);
        renderAnnouncementList([]);
        showMessage("pageErrorBox", err.message || "Could not load dashboard data.", "error");
      }
    }

    async function createHodAccount(){
      showMessage("hodMessageBox", "", "error");
      if ($("hodResultCard")) $("hodResultCard").classList.remove("show");

      const fullName = ($("hodFullName")?.value || "").trim();
      const departmentName = ($("hodDepartment")?.value || "").trim();

      if (!fullName){
        showMessage("hodMessageBox", "Please enter the full name.", "error");
        return;
      }

      if (!departmentName){
        showMessage("hodMessageBox", "Please enter the department.", "error");
        return;
      }

      const btn = $("createHodBtn");
      if (btn) btn.disabled = true;

      try{
        const result = await invokeEdge(EDGE.createHod, {
          hos_admin_id: adminSession.id,
          full_name: fullName,
          department_name: departmentName
        });

        if (!result.ok){
          throw new Error(result.error || "Could not create HOD account.");
        }

        const account = result.hod_account || {};

        if ($("resultHodName")) $("resultHodName").textContent = account.full_name || fullName;
        if ($("resultHodDepartment")) $("resultHodDepartment").textContent = account.department_name || departmentName;
        if ($("resultHodLoginId")) $("resultHodLoginId").textContent = account.login_id || "-";
        if ($("resultHodPassword")) $("resultHodPassword").textContent = result.temporary_password || "-";

        if ($("hodResultCard")) $("hodResultCard").classList.add("show");
        if ($("hodFullName")) $("hodFullName").value = "";
        if ($("hodDepartment")) $("hodDepartment").value = "";

        showMessage("hodMessageBox", result.message || "HOD account created successfully.", "success");
      }catch(err){
        console.error(err);
        showMessage("hodMessageBox", err.message || "Could not create HOD account.", "error");
      }finally{
        if (btn) btn.disabled = false;
      }
    }

    function clearHodForm(){
      if ($("hodFullName")) $("hodFullName").value = "";
      if ($("hodDepartment")) $("hodDepartment").value = "";
      if ($("hodResultCard")) $("hodResultCard").classList.remove("show");
      showMessage("hodMessageBox", "", "error");
    }

    async function sendAnnouncement(){
      showMessage("announcementMessageBox", "", "error");

      const title = ($("announcementTitle")?.value || "").trim();
      const message = ($("announcementBody")?.value || "").trim();

      if (!title){
        showMessage("announcementMessageBox", "Please enter the title.", "error");
        return;
      }

      if (!message){
        showMessage("announcementMessageBox", "Please enter the message.", "error");
        return;
      }

      const btn = $("sendAnnouncementBtn");
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Sending...";
      }

      try{
        const result = await invokeEdge(EDGE.sendAnnouncement, {
          hos_admin_id: adminSession.id,
          title,
          message
        });

        if (!result.ok){
          throw new Error(result.error || "Could not send announcement.");
        }

        if ($("announcementTitle")) $("announcementTitle").value = "";
        if ($("announcementBody")) $("announcementBody").value = "";

        const totals = result.totals || {};
        const recentAnnouncements = Array.isArray(result.recent_announcements)
          ? result.recent_announcements
          : [];

        if ($("totalAnnouncementCount")) {
          $("totalAnnouncementCount").textContent = String(totals.announcements || 0);
        }
        if ($("totalAnnouncementShown")) {
          $("totalAnnouncementShown").textContent = String(recentAnnouncements.length || 0);
        }

        renderAnnouncementList(recentAnnouncements);

        const push = result.push || {};
        const successCount = Number(push.success_count || 0);
        const activeTokens = Number(push.active_tokens || 0);

        let successText = result.message || "Announcement sent successfully.";
        if (activeTokens > 0) {
          successText += ` Push sent to ${successCount} device${successCount === 1 ? "" : "s"}.`;
        } else {
          successText += " No active phone tokens were found.";
        }

        showMessage("announcementMessageBox", successText, "success");
      }catch(err){
        console.error(err);
        showMessage("announcementMessageBox", err.message || "Could not send announcement.", "error");
      }finally{
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Send announcement";
        }
      }
    }

    function clearAnnouncementForm(){
      if ($("announcementTitle")) $("announcementTitle").value = "";
      if ($("announcementBody")) $("announcementBody").value = "";
      showMessage("announcementMessageBox", "", "error");
    }

    async function refreshAnnouncementHistoryOnly(){
      showMessage("announcementMessageBox", "", "error");
      await loadStudentData();
    }

    function logoutAdmin(){
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireHosSession()) return;

      $("refreshStudentsBtn")?.addEventListener("click", loadStudentData);
      $("refreshAnnouncementsBtn")?.addEventListener("click", refreshAnnouncementHistoryOnly);
      $("createHodBtn")?.addEventListener("click", createHodAccount);
      $("clearHodBtn")?.addEventListener("click", clearHodForm);
      $("sendAnnouncementBtn")?.addEventListener("click", sendAnnouncement);
      $("clearAnnouncementBtn")?.addEventListener("click", clearAnnouncementForm);
      $("logoutBtn")?.addEventListener("click", logoutAdmin);

      await loadStudentData();
    });
  })();
</script>
</body>
</html>
