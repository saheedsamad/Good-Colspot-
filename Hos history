<section id="screen-history" class="screen">
  <div class="section-shell">
    <article class="panel history-panel">
      <div class="panel-head history-head">
        <div>
          <div class="panel-title">Activity History</div>
          <div class="panel-sub">Recent form activities.</div>
        </div>
      </div>

      <div class="panel-body history-body">
        <div class="history-toolbar">
          <div class="history-search-wrap">
            <svg viewBox="0 0 24 24" fill="none" class="history-search-icon" aria-hidden="true">
              <path d="M21 21L16.65 16.65M10.8 18.6A7.8 7.8 0 1 0 10.8 3a7.8 7.8 0 0 0 0 15.6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <input
              type="text"
              id="historySearchInput"
              class="history-search-input"
              placeholder="Search history"
            />
          </div>

          <div class="history-filter-group">
            <label class="history-filter-label" for="historyFilterSelect">Filter by:</label>
            <select id="historyFilterSelect" class="history-select">
              <option value="all">All Activities</option>
              <option value="published">Published Forms</option>
              <option value="created">Created Forms</option>
              <option value="updated">Updated Forms</option>
              <option value="closed">Closed Forms</option>
              <option value="archived">Archived Forms</option>
              <option value="deleted">Deleted Forms</option>
            </select>
          </div>

          <div class="history-filter-group">
            <label class="history-filter-label" for="historySortSelect">Sort by:</label>
            <select id="historySortSelect" class="history-select">
              <option value="recent">Most Recent</option>
              <option value="oldest">Oldest First</option>
            </select>
          </div>
        </div>

        <div class="history-list" id="historyLiveBox">
          <div class="history-empty">
            Live history will show here when connected.
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .history-panel{
    overflow:hidden;
  }

  .history-head{
    padding-bottom:18px;
  }

  .history-body{
    display:flex;
    flex-direction:column;
    gap:18px;
  }

  .history-toolbar{
    display:grid;
    grid-template-columns:minmax(240px,1fr) auto auto;
    gap:14px;
    align-items:center;
  }

  .history-search-wrap{
    position:relative;
  }

  .history-search-icon{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    width:18px;
    height:18px;
    color:#94a3b8;
    pointer-events:none;
  }

  .history-search-input,
  .history-select{
    width:100%;
    min-height:52px;
    border:1px solid #dbe5f2;
    border-radius:14px;
    background:#fff;
    color:#0f172a;
    padding:0 14px;
    outline:none;
    font-size:15px;
  }

  .history-search-input{
    padding-left:42px;
  }

  .history-search-input:focus,
  .history-select:focus{
    border-color:#3b82f6;
    box-shadow:0 0 0 4px rgba(59,130,246,.12);
  }

  .history-filter-group{
    display:flex;
    align-items:center;
    gap:10px;
    white-space:nowrap;
  }

  .history-filter-label{
    font-size:14px;
    font-weight:700;
    color:#334155;
  }

  .history-select{
    min-width:190px;
    padding-right:38px;
  }

  .history-list{
    border:1px solid #e5eaf3;
    border-radius:18px;
    background:#fff;
    overflow:hidden;
  }

  .history-item{
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto auto;
    gap:16px;
    align-items:center;
    padding:20px 22px;
    border-bottom:1px solid #edf2f7;
    cursor:pointer;
    transition:background .18s ease, transform .18s ease;
  }

  .history-item:last-child{
    border-bottom:none;
  }

  .history-item:hover{
    background:#f8fbff;
  }

  .history-status{
    width:42px;
    height:42px;
    border-radius:999px;
    background:#22c55e;
    display:grid;
    place-items:center;
    color:#fff;
    flex-shrink:0;
  }

  .history-status svg{
    width:22px;
    height:22px;
  }

  .history-main{
    min-width:0;
  }

  .history-title{
    margin:0 0 4px;
    font-size:17px;
    font-weight:800;
    color:#1e293b;
    line-height:1.25;
  }

  .history-sub{
    margin:0;
    font-size:14px;
    color:#64748b;
    line-height:1.45;
  }

  .history-time{
    font-size:15px;
    color:#475569;
    white-space:nowrap;
  }

  .history-btn{
    border:none;
    border-radius:12px;
    min-height:42px;
    padding:0 16px;
    background:linear-gradient(135deg,#635bff 0%, #4f46e5 100%);
    color:#fff;
    font-weight:800;
    cursor:pointer;
    box-shadow:0 8px 20px rgba(79,70,229,.24);
    transition:transform .18s ease, opacity .18s ease;
  }

  .history-btn:hover{
    transform:translateY(-1px);
  }

  .history-btn:active{
    transform:translateY(0);
  }

  .history-empty{
    padding:34px 18px;
    text-align:center;
    color:#64748b;
    font-size:15px;
  }

  .history-loading{
    padding:30px 18px;
    text-align:center;
    color:#475569;
    font-size:15px;
  }

  .history-error{
    padding:24px 18px;
    text-align:center;
    color:#b91c1c;
    font-size:15px;
  }

  @media (max-width: 980px){
    .history-toolbar{
      grid-template-columns:1fr;
    }

    .history-filter-group{
      width:100%;
      justify-content:space-between;
    }

    .history-select{
      min-width:0;
      width:100%;
    }
  }

  @media (max-width: 720px){
    .history-item{
      grid-template-columns:auto 1fr;
      gap:14px;
    }

    .history-time{
      grid-column:2;
      margin-top:-4px;
      font-size:13px;
    }

    .history-btn{
      grid-column:2;
      justify-self:start;
      margin-top:4px;
    }
  }
</style>

<script>
(function () {
  if (window.__hosHistoryInitialized) return;
  window.__hosHistoryInitialized = true;

  const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
  const SUPABASE_ANON_KEY = "YOUR_ANON_KEY_HERE";

  const state = {
    sb: null,
    allItems: [],
    filteredItems: [],
    search: "",
    filter: "all",
    sort: "recent",
  };

  function historyEl(id) {
    return document.getElementById(id);
  }

  function escapeHtml(value) {
    return String(value || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function normalizeText(value) {
    return String(value || "").trim().replace(/\s+/g, " ");
  }

  function getAdminSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function getHosAdminId() {
    const session = getAdminSession();
    if (!session) return "";

    if (session?.account?.id) return session.account.id;
    if (session?.id) return session.id;

    return "";
  }

  function formatHistoryTime(value) {
    if (!value) return "";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);

    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();

    const yesterday = new Date();
    yesterday.setDate(now.getDate() - 1);
    const isYesterday = date.toDateString() === yesterday.toDateString();

    const timeText = date.toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    if (isToday) return `Today, ${timeText}`;
    if (isYesterday) return `Yesterday, ${timeText}`;

    return `${date.toLocaleDateString([], {
      month: "long",
      day: "numeric",
      year: "numeric",
    })}, ${timeText}`;
  }

  function getHistoryType(item) {
    const actionType = String(item.action_type || "").toUpperCase();

    if (actionType === "FORM_PUBLISHED") return "published";
    if (actionType === "FORM_CREATED") return "created";
    if (actionType === "FORM_UPDATED") return "updated";
    if (actionType === "FORM_CLOSED") return "closed";
    if (actionType === "FORM_ARCHIVED") return "archived";
    if (actionType === "FORM_DELETED") return "deleted";

    return "other";
  }

  function getHistorySubtitle(item) {
    const type = getHistoryType(item);

    if (type === "published") return "Form published successfully.";
    if (type === "created") return "Form created successfully.";
    if (type === "updated") return "Form updated successfully.";
    if (type === "closed") return "Form closed successfully.";
    if (type === "archived") return "Form archived successfully.";
    if (type === "deleted") return "Form deleted successfully.";

    return item.description || "Recent form activity.";
  }

  function getResponseUrl(item) {
    const formId =
      item?.entity_id ||
      item?.payload?.form_id ||
      item?.payload?.entity_id ||
      "";

    if (!formId) return "";
    return `form_response.html?form_id=${encodeURIComponent(formId)}`;
  }

  function canViewResponses(item) {
    return getHistoryType(item) === "published" && !!getResponseUrl(item);
  }

  function renderHistoryList() {
    const box = historyEl("historyLiveBox");
    if (!box) return;

    if (!state.filteredItems.length) {
      box.innerHTML = `
        <div class="history-empty">
          No history found for this filter.
        </div>
      `;
      return;
    }

    box.innerHTML = state.filteredItems.map((item) => {
      const buttonHtml = canViewResponses(item)
        ? `<button type="button" class="history-btn" data-view-history-response="${escapeHtml(getResponseUrl(item))}">View Responses</button>`
        : `<button type="button" class="history-btn" style="opacity:.45;pointer-events:none;">No Response Page</button>`;

      return `
        <div class="history-item" data-history-response-url="${escapeHtml(getResponseUrl(item))}">
          <div class="history-status" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="history-main">
            <h3 class="history-title">${escapeHtml(item.title || "Form Activity")}</h3>
            <p class="history-sub">${escapeHtml(getHistorySubtitle(item))}</p>
          </div>

          <div class="history-time">${escapeHtml(formatHistoryTime(item.created_at))}</div>

          ${buttonHtml}
        </div>
      `;
    }).join("");
  }

  function applyHistoryFilters() {
    const search = state.search.toLowerCase();

    let items = [...state.allItems];

    if (state.filter !== "all") {
      items = items.filter((item) => getHistoryType(item) === state.filter);
    }

    if (search) {
      items = items.filter((item) => {
        const title = String(item.title || "").toLowerCase();
        const description = String(item.description || "").toLowerCase();
        const actionType = String(item.action_type || "").toLowerCase();
        return (
          title.includes(search) ||
          description.includes(search) ||
          actionType.includes(search)
        );
      });
    }

    items.sort((a, b) => {
      const aTime = new Date(a.created_at || 0).getTime();
      const bTime = new Date(b.created_at || 0).getTime();
      return state.sort === "oldest" ? aTime - bTime : bTime - aTime;
    });

    state.filteredItems = items;
    renderHistoryList();
  }

  async function loadHistory() {
    const box = historyEl("historyLiveBox");
    if (!box) return;

    const hosAdminId = getHosAdminId();
    if (!hosAdminId) {
      box.innerHTML = `
        <div class="history-error">
          HOS session not found. Please sign in again.
        </div>
      `;
      return;
    }

    box.innerHTML = `<div class="history-loading">Loading history...</div>`;

    try {
      state.sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const { data, error } = await state.sb
        .from("hos_activity_history")
        .select("id, title, description, action_type, entity_type, entity_id, payload, created_at")
        .eq("hos_admin_id", hosAdminId)
        .eq("entity_type", "form")
        .order("created_at", { ascending: false });

      if (error) throw error;

      state.allItems = Array.isArray(data) ? data : [];
      applyHistoryFilters();
    } catch (err) {
      console.error("History load error:", err);
      box.innerHTML = `
        <div class="history-error">
          Could not load history.
        </div>
      `;
    }
  }

  function bindHistoryEvents() {
    const searchInput = historyEl("historySearchInput");
    const filterSelect = historyEl("historyFilterSelect");
    const sortSelect = historyEl("historySortSelect");
    const listBox = historyEl("historyLiveBox");

    searchInput?.addEventListener("input", function () {
      state.search = this.value || "";
      applyHistoryFilters();
    });

    filterSelect?.addEventListener("change", function () {
      state.filter = this.value || "all";
      applyHistoryFilters();
    });

    sortSelect?.addEventListener("change", function () {
      state.sort = this.value || "recent";
      applyHistoryFilters();
    });

    listBox?.addEventListener("click", function (event) {
      const button = event.target.closest("[data-view-history-response]");
      if (button) {
        const url = button.getAttribute("data-view-history-response");
        if (url) window.location.href = url;
        return;
      }

      const card = event.target.closest(".history-item");
      if (!card) return;

      const url = card.getAttribute("data-history-response-url");
      if (url) window.location.href = url;
    });
  }

  bindHistoryEvents();
  loadHistory();
})();
</script>
