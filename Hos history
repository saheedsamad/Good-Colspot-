<section id="screen-history" class="screen">
  <div class="section-shell">
    <article class="panel history-panel">
      <div class="panel-head history-panel-head">
        <div>
          <div class="panel-title">Activity History</div>
          <div class="panel-sub">Recent form and school activities.</div>
        </div>
      </div>

      <div class="panel-body history-panel-body">
        <div class="history-toolbar">
          <div class="history-search-wrap">
            <svg class="history-search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 21L16.65 16.65M10.8 18.6A7.8 7.8 0 1 0 10.8 3a7.8 7.8 0 0 0 0 15.6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <input
              id="historySearchInput"
              class="history-search-input"
              type="text"
              placeholder="Search history"
              autocomplete="off"
            />
          </div>

          <div class="history-select-group">
            <span class="history-select-label">Filter by:</span>
            <select id="historyFilterSelect" class="history-select">
              <option value="all">All Activities</option>
              <option value="FORM_CREATED">Form Created</option>
              <option value="FORM_UPDATED">Form Updated</option>
              <option value="FORM_PUBLISHED">Form Published</option>
              <option value="FORM_CLOSED">Form Closed</option>
              <option value="FORM_ARCHIVED">Form Archived</option>
              <option value="FORM_DELETED">Form Deleted</option>
              <option value="FORM_SUBMITTED">Form Submitted</option>
            </select>
          </div>

          <div class="history-select-group">
            <span class="history-select-label">Sort by:</span>
            <select id="historySortSelect" class="history-select">
              <option value="recent">Most Recent</option>
              <option value="oldest">Oldest First</option>
            </select>
          </div>
        </div>

        <div class="history-list-wrap">
          <div class="history-list" id="historyLiveBox">
            <div class="history-empty">
              Live history will show here when connected.
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .history-panel{
    overflow:hidden;
  }

  .history-panel-head{
    padding-bottom:18px;
  }

  .history-panel-body{
    display:flex;
    flex-direction:column;
    gap:18px;
  }

  .history-toolbar{
    display:grid;
    grid-template-columns:minmax(260px,1fr) auto auto;
    gap:14px;
    align-items:center;
  }

  .history-search-wrap{
    position:relative;
  }

  .history-search-icon{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    width:18px;
    height:18px;
    color:#94a3b8;
    pointer-events:none;
  }

  .history-search-input,
  .history-select{
    width:100%;
    min-height:50px;
    border:1px solid #dbe4f0;
    border-radius:14px;
    background:#fff;
    color:#0f172a;
    font-size:15px;
    outline:none;
    transition:border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }

  .history-search-input{
    padding:0 14px 0 42px;
  }

  .history-select{
    padding:0 42px 0 14px;
    min-width:190px;
    cursor:pointer;
  }

  .history-search-input:focus,
  .history-select:focus{
    border-color:#3b82f6;
    box-shadow:0 0 0 4px rgba(59,130,246,.10);
  }

  .history-select-group{
    display:flex;
    align-items:center;
    gap:10px;
    white-space:nowrap;
  }

  .history-select-label{
    font-size:14px;
    font-weight:700;
    color:#475569;
  }

  .history-list-wrap{
    border:1px solid #e5ebf5;
    border-radius:18px;
    overflow:hidden;
    background:#fff;
  }

  .history-list{
    display:flex;
    flex-direction:column;
  }

  .history-item{
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto auto;
    gap:16px;
    align-items:center;
    padding:20px 22px;
    border-bottom:1px solid #edf2f7;
    transition:background .18s ease;
  }

  .history-item:last-child{
    border-bottom:none;
  }

  .history-item:hover{
    background:#f8fbff;
  }

  .history-status{
    width:44px;
    height:44px;
    border-radius:999px;
    display:grid;
    place-items:center;
    flex-shrink:0;
    color:#fff;
  }

  .history-status.success{
    background:linear-gradient(135deg,#22c55e 0%, #16a34a 100%);
  }

  .history-status.info{
    background:linear-gradient(135deg,#3b82f6 0%, #2563eb 100%);
  }

  .history-status.warn{
    background:linear-gradient(135deg,#f59e0b 0%, #d97706 100%);
  }

  .history-status.danger{
    background:linear-gradient(135deg,#ef4444 0%, #dc2626 100%);
  }

  .history-status svg{
    width:22px;
    height:22px;
  }

  .history-main{
    min-width:0;
  }

  .history-title-text{
    font-size:17px;
    font-weight:800;
    color:#1e293b;
    line-height:1.28;
    margin:0 0 4px;
  }

  .history-sub-text{
    font-size:14px;
    color:#64748b;
    line-height:1.45;
    margin:0;
  }

  .history-time{
    font-size:14px;
    color:#475569;
    white-space:nowrap;
  }

  .history-action-btn{
    min-height:42px;
    border:none;
    border-radius:12px;
    padding:0 16px;
    background:linear-gradient(135deg,#635bff 0%, #4f46e5 100%);
    color:#fff;
    font-weight:800;
    cursor:pointer;
    box-shadow:0 8px 20px rgba(79,70,229,.20);
    transition:transform .18s ease, opacity .18s ease;
  }

  .history-action-btn:hover{
    transform:translateY(-1px);
  }

  .history-action-btn.is-disabled{
    opacity:.45;
    cursor:not-allowed;
    box-shadow:none;
  }

  .history-empty,
  .history-loading,
  .history-error{
    padding:34px 18px;
    text-align:center;
    font-size:15px;
  }

  .history-empty,
  .history-loading{
    color:#64748b;
  }

  .history-error{
    color:#b91c1c;
  }

  @media (max-width: 960px){
    .history-toolbar{
      grid-template-columns:1fr;
    }

    .history-select-group{
      justify-content:space-between;
      width:100%;
    }

    .history-select{
      min-width:0;
      width:100%;
    }
  }

  @media (max-width: 720px){
    .history-item{
      grid-template-columns:auto minmax(0,1fr);
      gap:12px;
    }

    .history-time{
      grid-column:2;
      margin-top:-2px;
    }

    .history-action-btn{
      grid-column:2;
      justify-self:start;
      margin-top:2px;
    }
  }
</style>

<script>
(function () {
  if (window.__hosHistoryScreenReady) return;
  window.__hosHistoryScreenReady = true;

  const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
  const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";

  let historySb = null;
  let historyRows = [];
  let filteredHistoryRows = [];

  const historyBox = document.getElementById("historyLiveBox");
  const historySearchInput = document.getElementById("historySearchInput");
  const historyFilterSelect = document.getElementById("historyFilterSelect");
  const historySortSelect = document.getElementById("historySortSelect");

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function normalizeText(value) {
    return String(value || "").trim().replace(/\s+/g, " ");
  }

  function normalizeUpper(value) {
    return normalizeText(value).toUpperCase();
  }

  function getAdminSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function getSchoolNameFromSession(session) {
    if (!session) return "";

    const account = session.account || {};

    return normalizeUpper(
      account.school_name ||
      session.school_name ||
      session.school ||
      session.schoolName ||
      ""
    );
  }

  function formatHistoryDate(value) {
    if (!value) return "";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);

    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();

    const yesterday = new Date();
    yesterday.setDate(now.getDate() - 1);
    const isYesterday = date.toDateString() === yesterday.toDateString();

    const timeText = date.toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    if (isToday) return `Today, ${timeText}`;
    if (isYesterday) return `Yesterday, ${timeText}`;

    return `${date.toLocaleDateString([], {
      month: "long",
      day: "numeric",
      year: "numeric",
    })}, ${timeText}`;
  }

  function getStatusClass(activityType) {
    const type = normalizeUpper(activityType);

    if (type === "FORM_DELETED") return "danger";
    if (type === "FORM_ARCHIVED" || type === "FORM_CLOSED") return "warn";
    if (type === "FORM_UPDATED" || type === "FORM_CREATED") return "info";
    return "success";
  }

  function getHistoryIcon(activityType) {
    const type = normalizeUpper(activityType);

    if (type === "FORM_DELETED") {
      return `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      `;
    }

    if (type === "FORM_UPDATED" || type === "FORM_CREATED") {
      return `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 20h9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
          <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      `;
    }

    if (type === "FORM_ARCHIVED" || type === "FORM_CLOSED") {
      return `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 8v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M23 3H1v5h22V3Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10 12h4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      `;
    }

    return `
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  function getHistoryUrl(row) {
    const entityType = normalizeText(row.entity_type).toLowerCase();
    const entityId = row.entity_id || row?.meta_json?.form_id || "";

    if (!entityId) return "";

    if (entityType === "form") {
      return `form_response.html?form_id=${encodeURIComponent(entityId)}`;
    }

    if (entityType === "form_submission") {
      const formId = row?.meta_json?.form_id || "";
      if (formId) {
        return `form_response.html?form_id=${encodeURIComponent(formId)}`;
      }
    }

    return "";
  }

  function getButtonLabel(row) {
    const type = normalizeUpper(row.activity_type);

    if (type === "FORM_PUBLISHED" || type === "FORM_SUBMITTED") {
      return "View Responses";
    }

    if (type === "FORM_CREATED" || type === "FORM_UPDATED") {
      return "Open Form";
    }

    return "Open";
  }

  function renderHistoryRows() {
    if (!historyBox) return;

    if (!filteredHistoryRows.length) {
      historyBox.innerHTML = `
        <div class="history-empty">
          No history found for this school yet.
        </div>
      `;
      return;
    }

    historyBox.innerHTML = filteredHistoryRows.map((row) => {
      const buttonUrl = getHistoryUrl(row);
      const buttonLabel = getButtonLabel(row);
      const buttonDisabled = !buttonUrl;

      return `
        <div class="history-item" data-history-url="${escapeHtml(buttonUrl)}">
          <div class="history-status ${escapeHtml(getStatusClass(row.activity_type))}">
            ${getHistoryIcon(row.activity_type)}
          </div>

          <div class="history-main">
            <h3 class="history-title-text">${escapeHtml(row.title || "Activity")}</h3>
            <p class="history-sub-text">${escapeHtml(row.description || "Recent school activity.")}</p>
          </div>

          <div class="history-time">${escapeHtml(formatHistoryDate(row.created_at))}</div>

          <button
            type="button"
            class="history-action-btn ${buttonDisabled ? "is-disabled" : ""}"
            data-history-btn-url="${escapeHtml(buttonUrl)}"
            ${buttonDisabled ? "disabled" : ""}
          >
            ${escapeHtml(buttonLabel)}
          </button>
        </div>
      `;
    }).join("");
  }

  function applyHistoryFilters() {
    const searchValue = normalizeText(historySearchInput?.value || "").toLowerCase();
    const filterValue = normalizeUpper(historyFilterSelect?.value || "all");
    const sortValue = normalizeText(historySortSelect?.value || "recent");

    let rows = [...historyRows];

    if (filterValue !== "ALL") {
      rows = rows.filter((row) => normalizeUpper(row.activity_type) === filterValue);
    }

    if (searchValue) {
      rows = rows.filter((row) => {
        const haystack = [
          row.title,
          row.description,
          row.activity_type,
          row.entity_type,
          row.actor_name,
          row.target_name,
          row?.meta_json?.form_title,
          row?.meta_json?.programme,
          row?.meta_json?.level
        ]
          .map((v) => normalizeText(v).toLowerCase())
          .join(" ");

        return haystack.includes(searchValue);
      });
    }

    rows.sort((a, b) => {
      const aTime = new Date(a.created_at || 0).getTime();
      const bTime = new Date(b.created_at || 0).getTime();
      return sortValue === "oldest" ? aTime - bTime : bTime - aTime;
    });

    filteredHistoryRows = rows;
    renderHistoryRows();
  }

  async function loadHosHistory() {
    if (!historyBox) return;

    const adminSession = getAdminSession();
    const schoolName = getSchoolNameFromSession(adminSession);

    console.log("History admin session:", adminSession);
    console.log("History school name normalized:", schoolName);

    if (!schoolName) {
      historyBox.innerHTML = `
        <div class="history-error">
          School session not found. Please sign in again.
        </div>
      `;
      return;
    }

    historyBox.innerHTML = `<div class="history-loading">Loading history...</div>`;

    try {
      if (!window.supabase || typeof window.supabase.createClient !== "function") {
        throw new Error("Supabase browser library is not loaded.");
      }

      historySb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const { data, error } = await historySb
        .from("hos_history")
        .select("id, school_name, activity_type, title, description, entity_type, entity_id, actor_name, actor_role, target_name, meta_json, created_at")
        .ilike("school_name", schoolName)
        .order("created_at", { ascending: false });

      if (error) throw error;

      console.log("History rows loaded:", data);

      historyRows = Array.isArray(data) ? data : [];
      applyHistoryFilters();
    } catch (error) {
      console.error("History load error:", error);
      historyBox.innerHTML = `
        <div class="history-error">
          Could not load history right now.
        </div>
      `;
    }
  }

  function bindHistoryEvents() {
    historySearchInput?.addEventListener("input", applyHistoryFilters);
    historyFilterSelect?.addEventListener("change", applyHistoryFilters);
    historySortSelect?.addEventListener("change", applyHistoryFilters);

    historyBox?.addEventListener("click", function (event) {
      const button = event.target.closest("[data-history-btn-url]");
      if (button) {
        const url = button.getAttribute("data-history-btn-url");
        if (url) {
          window.location.href = url;
        }
        return;
      }

      const row = event.target.closest(".history-item");
      if (!row) return;

      const url = row.getAttribute("data-history-url");
      if (url) {
        window.location.href = url;
      }
    });
  }

  bindHistoryEvents();
  loadHosHistory();
})();
</script>
