<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Lecturer Home</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #e5f0ff;
      --bg2: #f8fbff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --shadow-strong: 0 20px 55px rgba(15, 23, 42, 0.18);
      --shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.12);
      --card-border: #e7edf8;
    }

    * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Inter, sans-serif;
    }

    html, body {
      height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: #ffffff;
      border-radius: 0;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px 0;
      position: relative;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 4px 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-logo {
      height: 32px;
      width: 32px;
      border-radius: 8px;
      overflow: hidden;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-logo img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      display: block;
    }

    .brand-name {
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.02em;
      color: var(--text-main);
    }

    .avatar-chip {
      height: 34px;
      min-width: 34px;
      border-radius: 999px;
      background: linear-gradient(135deg, #1d4ed8, #22c55e);
      color: #f9fafb;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
    }

    main {
      flex: 1;
      overflow-y: auto;
      padding: 0 2px 90px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    main::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    .hero {
      margin: 4px 2px 12px;
    }

    .hero-line-1 {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .hero-title {
      font-size: 22px;
      line-height: 1.25;
      margin: 0 0 14px;
      color: var(--text-main);
      font-weight: 700;
    }

    .hero-title span {
      color: var(--blue);
    }

    .primary-cta {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 12px 16px;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .primary-cta svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .primary-cta:active {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      filter: brightness(0.97);
    }

    .sub-cta-wrap {
      display: flex;
      justify-content: center;
      margin-top: 12px;
    }

    .sub-cta {
      min-width: 170px;
      border-radius: 999px;
      border: none;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
      color: var(--blue);
      background: #ffffff;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
    }

    .sub-cta:active {
      transform: scale(0.97);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 20px 4px 8px;
    }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    .section-action {
      font-size: 12px;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }

    .section-action svg {
      width: 12px;
      height: 12px;
    }

    .card {
      border-radius: 18px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 12px 12px 11px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .announcement-card {
      margin: 0 2px 6px;
      padding: 10px 12px;
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .announcement-icon {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #1d4ed8;
      margin-top: 2px;
    }

    .announcement-body {
      flex: 1;
    }

    .announcement-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .announcement-text {
      font-size: 11px;
      color: var(--text-main);
    }

    .announcement-close {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 14px;
      cursor: pointer;
      padding: 0;
      margin-left: 4px;
      flex-shrink: 0;
    }

    .update-soft-btn {
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      border: none;
      font-size: 11px;
      font-weight: 600;
      background: #ffffff;
      color: var(--blue);
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
    }

    .update-soft-btn:active {
      transform: scale(0.97);
    }

    .update-hard-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .update-hard-card {
      width: 90%;
      max-width: 380px;
      border-radius: 22px;
      background: #ffffff;
      padding: 18px 16px 16px;
      text-align: center;
      box-shadow: var(--shadow-strong);
    }

    .update-hard-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text-main);
    }

    .update-hard-text {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .update-hard-btn {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      cursor: pointer;
    }

    .update-hard-note {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 6px;
    }

    .dashboard-card {
      background: #f8fbff;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 82px;
    }

    .dashboard-icon {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .dashboard-icon.blue {
      background: #eff6ff;
      color: #2563eb;
    }

    .dashboard-icon.green {
      background: #ecfdf5;
      color: #16a34a;
    }

    .dashboard-icon svg {
      width: 20px;
      height: 20px;
    }

    .dashboard-meta {
      min-width: 0;
    }

    .dashboard-title {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .dashboard-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
    }

    .scan-card {
      margin-top: 14px;
      background: #ffffff;
    }

    .scan-card-header,
    .ai-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }

    .scan-card-icon,
    .ai-card-icon {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .scan-card-icon {
      background: #eff6ff;
      color: #2563eb;
    }

    .ai-card-icon {
      background: #f5f3ff;
      color: #4f46e5;
    }

    .scan-card-icon svg,
    .ai-card-icon svg {
      width: 18px;
      height: 18px;
    }

    .scan-card-title,
    .ai-card-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .scan-card-subtitle,
    .ai-card-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .scan-card-button,
    .ai-card-button {
      width: 100%;
      margin-top: 6px;
      border-radius: 999px;
      border: none;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .scan-card-button {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .ai-card-button {
      background: linear-gradient(135deg, #4f46e5, #2563eb);
    }

    .scan-card-button:active,
    .ai-card-button:active {
      transform: scale(0.97);
    }

    .history-card {
      margin-top: 6px;
      cursor: pointer;
      transition: box-shadow 0.15s, transform 0.05s;
    }

    .history-card:active {
      transform: scale(0.99);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .history-empty {
      font-size: 12px;
      color: var(--text-muted);
    }

    .history-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 12px;
      color: var(--text-main);
    }

    .history-item-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 6px;
    }

    .history-course {
      font-weight: 600;
    }

    .history-time {
      font-size: 11px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .history-progress-track {
      margin-top: 4px;
      width: 100%;
      height: 4px;
      border-radius: 999px;
      background: #e5e7eb;
      overflow: hidden;
    }

    .history-progress-bar {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      width: 100%;
    }

    .history-meta {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(env(safe-area-inset-bottom) + 8px);
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 420px;
      border-top: 1px solid #e5e7eb;
      padding: 6px 8px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: #ffffff;
      border-radius: 26px;
      box-shadow: 0 10px 30px rgba(15,23,42,0.18);
      z-index: 50;
      will-change: transform;
    }

    .nav-btn {
      flex: 1;
      text-align: center;
      font-size: 11px;
      color: #9ca3af;
      cursor: pointer;
      padding-top: 2px;
    }

    .nav-btn-inner {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .nav-btn svg {
      width: 20px;
      height: 20px;
      display: block;
    }

    .nav-btn.active {
      color: var(--blue);
      font-weight: 600;
    }

    .placeholder-note {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.45;
      margin: 4px 2px 14px;
    }

    body.keyboard-open .bottom-nav {
      display: none;
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo" />
        </div>
        <div class="brand-name">Colspot</div>
      </div>
      <button class="avatar-chip" id="avatarInitial" onclick="showScreen('account')">C</button>
    </header>

    <main>
      <div id="screen-home" class="screen active">
        <section class="hero">
          <div class="hero-line-1" id="greetingLine">Welcome back</div>
          <h1 class="hero-title">
            What do you want to<br />
            <span>do today?</span>
          </h1>

          <button class="primary-cta" onclick="showScreen('attendance')">
            <svg viewBox="0 0 20 20" fill="none">
              <path
                d="M10 4v12M4 10h12"
                stroke="white"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <span>Create new attendance</span>
          </button>

          <div class="sub-cta-wrap">
            <button class="sub-cta" id="createClassBtn" type="button">Create class</button>
          </div>
        </section>

        <section id="updateSoftSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="announcement-body">
              <div id="updateSoftTitle" class="announcement-title">New version available</div>
              <div id="updateSoftMessage" class="announcement-text"></div>
              <button
                type="button"
                class="update-soft-btn"
                onclick="openUpdateUrlFromRule()"
              >
                Update now
              </button>
            </div>
          </article>
        </section>

        <section id="announcementSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="announcement-body">
              <div id="announcementTitle" class="announcement-title">Update</div>
              <div id="announcementMessage" class="announcement-text"></div>
            </div>
            <button type="button" class="announcement-close" onclick="dismissAnnouncement()">✕</button>
          </article>
        </section>

        <section>
          <div class="section-header">
            <div class="section-title">Dashboard</div>
            <div class="section-action" onclick="showScreen('classes')">
              <span>Open</span>
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M7 4l6 6-6 6"
                  stroke="#2563eb"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <div class="dashboard-grid">
            <article class="dashboard-card">
              <div class="dashboard-icon blue">
                <svg viewBox="0 0 20 20" fill="none">
                  <rect x="4.5" y="3.5" width="11" height="13" rx="1.4" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="dashboard-meta">
                <div class="dashboard-title">Total class</div>
                <div class="dashboard-value" id="totalClassesValue">0</div>
              </div>
            </article>

            <article class="dashboard-card">
              <div class="dashboard-icon green">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M13.5 16v-1.2a2.8 2.8 0 00-2.8-2.8H6.8A2.8 2.8 0 004 14.8V16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  <circle cx="8.8" cy="7" r="2.7" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M15.2 7.2v4.2M17.3 9.3h-4.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="dashboard-meta">
                <div class="dashboard-title">Total student</div>
                <div class="dashboard-value" id="totalStudentsValue">0</div>
              </div>
            </article>
          </div>
        </section>

        <section>
          <article class="card ai-card">
            <div class="ai-card-header">
              <div class="ai-card-icon">
                <svg viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="10" r="7" stroke="#4f46e5" stroke-width="1.4"/>
                  <path d="M7.5 9.5c.4-1.4 1.5-2.3 2.7-2.3 1.3 0 2.5.9 2.8 2.3" stroke="#4f46e5" stroke-width="1.3" stroke-linecap="round"/>
                  <path d="M8.2 12.2h3.6" stroke="#4f46e5" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <div class="ai-card-title">Chat with Colspot AI</div>
                <div class="ai-card-subtitle">
                  Ask quick questions about using Colspot or summarise attendance information in simple language.
                </div>
              </div>
            </div>
            <button class="ai-card-button" onclick="showScreen('ai')">
              Open Colspot AI
            </button>
          </article>
        </section>

        <section>
          <article class="card scan-card">
            <div class="scan-card-header">
              <div class="scan-card-icon">
                <svg viewBox="0 0 20 20" fill="none">
                  <rect x="4" y="3.5" width="9" height="13" rx="1.2" stroke="#2563eb" stroke-width="1.4"/>
                  <path d="M7 6.5h7a1.5 1.5 0 011.5 1.5v7.5a1 1 0 01-1 1h-7" stroke="#2563eb" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M6.5 9.5h4" stroke="#2563eb" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <div class="scan-card-title">Scan paper sheet</div>
                <div class="scan-card-subtitle">
                  Take a photo of any list and turn it into Excel or Word. Use it for attendance or anything else.
                </div>
              </div>
            </div>
            <button class="scan-card-button" onclick="showScreen('scan')">
              Scan paper sheet
            </button>
          </article>
        </section>

        <section>
          <div class="section-header">
            <div class="section-title">Recent history</div>
            <div class="section-action" onclick="showScreen('history')">
              <span>View all</span>
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M7 4l6 6-6 6"
                  stroke="#2563eb"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <article class="card history-card" onclick="showScreen('history')">
            <div class="history-list" id="historyList">
              <div class="history-empty">
                Loading your recent sessions...
              </div>
            </div>
          </article>
        </section>
      </div>

      <div id="screen-ai" class="screen">
        <section class="hero">
          <div class="hero-line-1">Colspot AI</div>
          <h1 class="hero-title">
            Chat with<span> Colspot AI</span>
          </h1>
          <p class="placeholder-note">
            This is the AI page placeholder. You will paste the real AI chat UI here later.
          </p>
        </section>
      </div>

      <div id="screen-attendance" class="screen">
        <section class="hero">
          <div class="hero-line-1">Attendance</div>
          <h1 class="hero-title">
            Create <span>attendance</span>
          </h1>
        </section>
      </div>

      <div id="screen-classes" class="screen">
        <section class="hero">
          <div class="hero-line-1">Class</div>
          <h1 class="hero-title">
            Manage your <span>classes</span>
          </h1>
        </section>
      </div>

      <div id="screen-history" class="screen">
        <section class="hero">
          <div class="hero-line-1">History</div>
          <h1 class="hero-title">
            View class <span>history</span>
          </h1>
        </section>

        <section>
          <article class="card">
            <div class="history-list" id="historyListAlt">
              <div class="history-empty">Your session history will appear here.</div>
            </div>
          </article>
        </section>
      </div>

      <div id="screen-reports" class="screen">
        <section class="hero">
          <div class="hero-line-1">Reports</div>
