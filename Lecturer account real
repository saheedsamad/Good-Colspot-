  <script>
    const LECTURER_DEVICE_STORAGE_KEY = "colspot_device_id";

    let lecturerAccountCurrentUser = null;
    let lecturerAccountLoadedOnce = false;

    function lecturerAccountGetSb() {
      if (typeof window.supabase !== "undefined" && window.supabase) return window.supabase;
      if (typeof supabase !== "undefined" && supabase) return supabase;
      return null;
    }

    function lecturerAccountText(id, value) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = value && String(value).trim() ? String(value).trim() : "—";
    }

    function lecturerAccountInitialFromName(name) {
      const clean = String(name || "").trim();
      return clean ? clean.charAt(0).toUpperCase() : "L";
    }

    function lecturerAccountSetAvatar(name, avatarUrl) {
      const img = document.getElementById("lecturerAccountAvatarImg");
      const initial = document.getElementById("lecturerAccountInitial");
      const letter = lecturerAccountInitialFromName(name);

      if (avatarUrl && img && initial) {
        img.src = avatarUrl;
        img.style.display = "block";
        initial.style.display = "none";
        initial.textContent = "";
      } else {
        if (img) {
          img.removeAttribute("src");
          img.style.display = "none";
        }
        if (initial) {
          initial.style.display = "block";
          initial.textContent = letter;
        }
      }

      const chipImg = document.getElementById("avatarChipImg");
      const chipText = document.getElementById("avatarChipText");

      if (chipImg && chipText) {
        if (avatarUrl) {
          chipImg.src = avatarUrl;
          chipImg.style.display = "block";
          chipText.textContent = "";
          chipText.style.display = "none";
        } else {
          chipImg.removeAttribute("src");
          chipImg.style.display = "none";
          chipText.textContent = letter;
          chipText.style.display = "flex";
        }
      }
    }

    async function lecturerAccountGetUser() {
      const sb = lecturerAccountGetSb();
      if (!sb) return null;

      const { data, error } = await sb.auth.getUser();

      if (error || !data || !data.user) {
        return null;
      }

      lecturerAccountCurrentUser = data.user;
      return data.user;
    }

    async function loadLecturerAccountScreen() {
      const sb = lecturerAccountGetSb();
      const status = document.getElementById("lecturerDevicesStatus");

      if (!sb) {
        if (status) {
          status.textContent = "Backend not available. Please reload.";
          status.className = "status-text error";
        }
        return;
      }

      const user = await lecturerAccountGetUser();

      if (!user) {
        window.location.href = "index.html";
        return;
      }

      let profile = null;

      try {
        const { data, error } = await sb
          .from("lecturer_accounts")
          .select("*")
          .eq("user_id", user.id)
          .limit(1)
          .maybeSingle();

        if (!error && data) {
          profile = data;
        }
      } catch (e) {
        console.warn("lecturer_accounts load failed:", e);
      }

      if (!profile) {
        try {
          const { data, error } = await sb
            .from("lecturers")
            .select("*")
            .eq("id", user.id)
            .limit(1)
            .maybeSingle();

          if (!error && data) {
            profile = data;
          }
        } catch (e) {
          console.warn("lecturers fallback load failed:", e);
        }
      }

      const fullName =
        profile?.full_name ||
        profile?.name ||
        user.user_metadata?.full_name ||
        user.email ||
        "";

      const school =
        profile?.school_name ||
        profile?.school ||
        profile?.institution ||
        "";

      const staffId =
        profile?.staff_id ||
        profile?.staff_number ||
        profile?.lecturer_id ||
        profile?.login_id ||
        "";

      const email =
        profile?.email ||
        user.email ||
        "";

      const avatarUrl =
        profile?.avatar_url ||
        profile?.photo_url ||
        user.user_metadata?.avatar_url ||
        "";

      lecturerAccountText("lecturerAccountNameTop", fullName);
      lecturerAccountText("lecturerAccountFullName", fullName);
      lecturerAccountText("lecturerAccountSchool", school);
      lecturerAccountText("lecturerAccountStaffId", staffId);
      lecturerAccountText("lecturerAccountEmail", email);
      lecturerAccountSetAvatar(fullName, avatarUrl);

      lecturerAccountLoadedOnce = true;

      await loadLecturerAccountDevices();
    }

    function lecturerAccountGetDeviceId() {
      try {
        let raw = localStorage.getItem(LECTURER_DEVICE_STORAGE_KEY) || "";
        raw = String(raw || "").trim();

        if (!raw) return "";

        if (/^[ABI]-/i.test(raw)) return raw;

        const ua = navigator.userAgent || "";
        let prefix = "B";

        if (/android/i.test(ua)) prefix = "A";
        else if (/iphone|ipad|ipod/i.test(ua)) prefix = "I";

        const finalId = `${prefix}-${raw}`;
        localStorage.setItem(LECTURER_DEVICE_STORAGE_KEY, finalId);

        return finalId;
      } catch {
        return "";
      }
    }

    async function loadLecturerAccountDevices() {
      const sb = lecturerAccountGetSb();
      const list = document.getElementById("lecturerDevicesList");
      const status = document.getElementById("lecturerDevicesStatus");
      const badge = document.getElementById("lecturerDevicesCountBadge");

      if (!sb || !list || !status || !badge || !lecturerAccountCurrentUser) return;

      list.innerHTML = "";
      status.textContent = "Loading devices...";
      status.className = "status-text";

      const currentDeviceId = lecturerAccountGetDeviceId();

      try {
        const { data, error } = await sb
          .from("user_devices")
          .select("id, device_id, created_at")
          .eq("user_id", lecturerAccountCurrentUser.id)
          .order("created_at", { ascending: true });

        if (error) throw error;

        const devices = data || [];
        badge.textContent = `${devices.length} / 2`;

        if (!devices.length) {
          status.textContent = "No devices linked yet.";
          return;
        }

        status.textContent = "";

        devices.forEach((row) => {
          const rowDeviceId = String(row.device_id || "").trim();
          const isThisPhone = !!currentDeviceId && rowDeviceId === currentDeviceId;

          const deviceRow = document.createElement("div");
          deviceRow.className = "device-row";

          const main = document.createElement("div");
          main.className = "device-main";

          const icon = document.createElement("div");
          icon.className = "device-icon";
          icon.innerHTML = `
            <svg viewBox="0 0 24 24">
              <rect x="7" y="3" width="10" height="18" rx="2"></rect>
              <circle cx="12" cy="17" r="1"></circle>
            </svg>
          `;

          const text = document.createElement("div");
          text.className = "device-text";

          const nameEl = document.createElement("div");
          nameEl.className = "device-name";
          nameEl.textContent = isThisPhone ? "This phone" : "Other phone";

          const metaEl = document.createElement("div");
          metaEl.className = "device-meta";

          const created = row.created_at
            ? new Date(row.created_at).toLocaleString()
            : "";

          metaEl.textContent = created ? `Linked on ${created}` : "Linked device";

          text.appendChild(nameEl);
          text.appendChild(metaEl);

          main.appendChild(icon);
          main.appendChild(text);

          deviceRow.appendChild(main);

          if (!isThisPhone) {
            const removeBtn = document.createElement("button");
            removeBtn.className = "device-remove-btn";
            removeBtn.type = "button";
            removeBtn.textContent = "Remove";
            removeBtn.onclick = () => removeLecturerAccountDevice(row.id);
            deviceRow.appendChild(removeBtn);
          }

          list.appendChild(deviceRow);
        });
      } catch (e) {
        console.error("loadLecturerAccountDevices error:", e);
        status.textContent = "Could not load devices.";
        status.className = "status-text error";
      }
    }

    async function removeLecturerAccountDevice(id) {
      if (!id) return;

      const yes = window.confirm("Remove this phone from your account?");
      if (!yes) return;

      const sb = lecturerAccountGetSb();
      if (!sb) return;

      try {
        const { error } = await sb
          .from("user_devices")
          .delete()
          .eq("id", id);

        if (error) throw error;

        await loadLecturerAccountDevices();
      } catch (e) {
        console.error("removeLecturerAccountDevice error:", e);
        alert("Could not remove this phone. Please try again.");
      }
    }

    function clearAllColspotCache() {
      try {
        const keysToRemove = [];

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key) continue;

          if (
            key.startsWith("colspot_") ||
            key === "supabase.auth.token" ||
            key.includes("supabase")
          ) {
            keysToRemove.push(key);
          }
        }

        keysToRemove.forEach((key) => localStorage.removeItem(key));

        sessionStorage.clear();
      } catch (e) {
        console.warn("clearAllColspotCache failed:", e);
      }
    }

    async function lecturerAccountLogout() {
      const yes = window.confirm("Log out of this lecturer account?");
      if (!yes) return;

      try {
        const sb = lecturerAccountGetSb();

        if (sb && sb.auth) {
          await sb.auth.signOut();
        }
      } catch (e) {
        console.warn("lecturerAccountLogout signOut failed:", e);
      } finally {
        clearAllColspotCache();
        window.location.href = "index.html";
      }
    }

    function lecturerAccountContactUs() {
      window.location.href = "contact.html";
    }

    async function lecturerAccountDeleteAccount() {
      const user = lecturerAccountCurrentUser || (await lecturerAccountGetUser());

      if (!user) {
        alert("Please sign in again.");
        return;
      }

      const yes = window.confirm(
        "This will request/delete this lecturer account data. This action cannot be undone. Continue?"
      );

      if (!yes) return;

      const typed = window.prompt("Type DELETE to confirm.");

      if (!typed || typed.trim().toUpperCase() !== "DELETE") {
        alert("Account deletion cancelled.");
        return;
      }

      const sb = lecturerAccountGetSb();

      try {
        if (sb) {
          await Promise.allSettled([
            sb.from("user_devices").delete().eq("user_id", user.id),
            sb.from("attendance_warmup_main").delete().eq("lecturer_id", user.id),
            sb.from("attendance_warmup_attendance").delete().eq("lecturer_id", user.id),
            sb.from("attendance_records").delete().eq("user_id", user.id),
            sb.from("scan_sheets").delete().eq("user_id", user.id),
            sb.from("lecturer_accounts").delete().eq("user_id", user.id),
            sb.from("lecturers").delete().eq("id", user.id)
          ]);

          try {
            if (sb.functions && sb.functions.invoke) {
              await sb.functions.invoke("delete_my_account", { body: {} });
            }
          } catch (e) {
            console.warn("delete_my_account function failed:", e);
          }

          try {
            await sb.auth.signOut();
          } catch (e) {
            console.warn("signOut after delete failed:", e);
          }
        }

        clearAllColspotCache();
        alert("Account deleted.");
        window.location.href = "index.html";
      } catch (e) {
        console.error("lecturerAccountDeleteAccount error:", e);
        alert("Could not delete account. Please try again.");
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
