<script>
  window.reportScreenState = {
    selectedCategory: "bullying",
    isAnonymous: true,
    lastTrackingCode: "",
    lastReplyPin: ""
  };

  function showReportError(msg) {
    const e = document.getElementById("reportErrorBox");
    const s = document.getElementById("reportSuccessBox");
    if (s) {
      s.textContent = "";
      s.classList.remove("show");
    }
    if (e) {
      e.textContent = msg || "";
      e.classList.toggle("show", !!msg);
    }
  }

  function showReportSuccess(msg) {
    const e = document.getElementById("reportErrorBox");
    const s = document.getElementById("reportSuccessBox");
    if (e) {
      e.textContent = "";
      e.classList.remove("show");
    }
    if (s) {
      s.textContent = msg || "";
      s.classList.toggle("show", !!msg);
    }
  }

  function clearReportMessages() {
    showReportError("");
    showReportSuccess("");
  }

  function getCurrentReportUserId() {
    try {
      if (typeof supabase !== "undefined" && supabase.auth && supabase.auth.getUser) {
        return supabase.auth.getUser().then(({ data }) => data?.user?.id || "");
      }
    } catch {}

    try {
      const raw = localStorage.getItem("colspot_last_user");
      if (!raw) return Promise.resolve("");
      const parsed = JSON.parse(raw);
      return Promise.resolve(parsed?.id || "");
    } catch {
      return Promise.resolve("");
    }
  }

  function setReportCategory(category) {
    const state = window.reportScreenState;
    state.selectedCategory = category;

    document.querySelectorAll("#reportCategoryChips .chip").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.category === category);
    });
  }

  function setReportPrivacyMode(anonymousMode) {
    const state = window.reportScreenState;
    state.isAnonymous = anonymousMode;

    document.getElementById("reportAnonymousBtn")?.classList.toggle("active", anonymousMode);
    document.getElementById("reportNamedBtn")?.classList.toggle("active", !anonymousMode);

    const note = document.getElementById("reportPrivacyNote");
    if (note) {
      note.textContent = anonymousMode
        ? "You are currently reporting anonymously."
        : "You are currently reporting with your name.";
    }
  }

  function updateReportUrgencyNote() {
    const urgent = document.getElementById("reportUrgencySelect")?.value === "urgent";
    const note = document.getElementById("reportUrgencyNote");
    if (note) {
      note.style.display = urgent ? "block" : "none";
    }
  }

  async function copyReportScreenDetails() {
    const state = window.reportScreenState;
    if (!state.lastTrackingCode || !state.lastReplyPin) return;

    const text = `Tracking Code: ${state.lastTrackingCode}\nReply PIN: ${state.lastReplyPin}`;

    try {
      await navigator.clipboard.writeText(text);
      showReportSuccess("Tracking code and PIN copied.");
    } catch {
      showReportError("Could not copy automatically. Please save the code and PIN.");
    }
  }

  async function submitReportScreen() {
    clearReportMessages();

    const userId = await getCurrentReportUserId();
    const title = (document.getElementById("reportTitleInput")?.value || "").trim();
    const message = (document.getElementById("reportMessageInputMain")?.value || "").trim();
    const locationText = (document.getElementById("reportLocationInput")?.value || "").trim();
    const personInvolved = (document.getElementById("reportPersonInput")?.value || "").trim();
    const urgency = document.getElementById("reportUrgencySelect")?.value || "normal";
    const contactPhone = (document.getElementById("reportContactPhone")?.value || "").trim();
    const contactEmail = (document.getElementById("reportContactEmail")?.value || "").trim();

    if (!userId) {
      showReportError("We could not find your user session. Please sign in again.");
      return;
    }

    if (!message) {
      showReportError("Please tell us what happened before submitting.");
      return;
    }

    const btn = document.getElementById("reportSubmitBtn");
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Sending...";
    }

    try {
      if (typeof supabase === "undefined" || !supabase.functions?.invoke) {
        throw new Error("Could not connect to backend.");
      }

      const state = window.reportScreenState;

      const { data, error } = await supabase.functions.invoke("submit-school-report", {
        body: {
          submitted_by_user_id: userId,
          is_anonymous: state.isAnonymous,
          category: state.selectedCategory,
          title,
          message,
          location_text: locationText,
          person_involved: personInvolved,
          urgency,
          allow_anonymous_reply: true,
          contact_phone: contactPhone,
          contact_email: contactEmail
        }
      });

      if (error) {
        throw new Error((data && data.error) || error.message || "Could not submit report.");
      }

      if (!data?.ok) {
        if (data?.code === "COURSE_FORM_NOT_VERIFIED" || data?.code === "PROFILE_NOT_VERIFIED") {
          throw new Error("Please go to your profile and complete your course form first before submitting a report.");
        }
        throw new Error(data?.error || "Could not submit report.");
      }

      const report = data.report || {};

      state.lastTrackingCode = report.tracking_code || "";
      state.lastReplyPin = report.reply_pin || "";

      document.getElementById("reportResultTrackingCode").textContent = report.tracking_code || "-";
      document.getElementById("reportResultReplyPin").textContent = report.reply_pin || "-";
      document.getElementById("reportResultStatus").textContent = report.status || "-";
      document.getElementById("reportResultPrivacy").textContent = report.is_anonymous ? "Anonymous" : "Named";
      document.getElementById("reportResultSchool").textContent = report.school_name || "-";
      document.getElementById("reportResultCard").classList.add("show");

      document.getElementById("reportTitleInput").value = "";
      document.getElementById("reportMessageInputMain").value = "";
      document.getElementById("reportLocationInput").value = "";
      document.getElementById("reportPersonInput").value = "";
      document.getElementById("reportUrgencySelect").value = "normal";
      document.getElementById("reportContactPhone").value = "";
      document.getElementById("reportContactEmail").value = "";

      setReportCategory("bullying");
      setReportPrivacyMode(true);
      updateReportUrgencyNote();

      showReportSuccess(data.message || "Report submitted successfully.");

      setTimeout(() => {
        document.getElementById("reportResultCard")?.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }, 150);
    } catch (err) {
      console.error(err);
      showReportError(err?.message || "Could not submit report.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = "Send report to school authority";
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("#reportCategoryChips .chip").forEach((btn) => {
      btn.addEventListener("click", () => setReportCategory(btn.dataset.category));
    });

    document.getElementById("reportAnonymousBtn")?.addEventListener("click", () => setReportPrivacyMode(true));
    document.getElementById("reportNamedBtn")?.addEventListener("click", () => setReportPrivacyMode(false));
    document.getElementById("reportUrgencySelect")?.addEventListener("change", updateReportUrgencyNote);
    document.getElementById("reportSubmitBtn")?.addEventListener("click", submitReportScreen);
    document.getElementById("reportCopyBtn")?.addEventListener("click", copyReportScreenDetails);

    updateReportUrgencyNote();
  });
</script>
<!-- 🔹 REPORT SCREEN END -->
