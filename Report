<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Report to School Authority</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#f6f8ff;
      --card:#ffffff;
      --line:#e7eaf3;
      --text:#111827;
      --muted:#6b7280;
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --purple:#6d4cff;
      --purple-soft:#f3edff;
      --green:#16a34a;
      --green-soft:#ecfdf5;
      --red:#dc2626;
      --red-soft:#fef2f2;
      --shadow:0 16px 34px rgba(15,23,42,.08);
      --radius:22px;
    }

    *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

    html,body{
      margin:0;
      padding:0;
      background:linear-gradient(180deg,#eef4ff 0%, #f9fbff 100%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
      min-height:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:calc(env(safe-area-inset-top) + 14px) 16px calc(env(safe-area-inset-bottom) + 28px);
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:14px;
    }

    .back-btn{
      width:42px;
      height:42px;
      border:none;
      border-radius:14px;
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      color:#1f2937;
      flex-shrink:0;
    }

    .back-btn svg{
      width:22px;
      height:22px;
    }

    .top-title{
      min-width:0;
    }

    .page-title{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.03em;
      margin-bottom:2px;
    }

    .page-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
    }

    .hero-card,
    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    .hero-card{
      padding:18px 16px;
      margin-bottom:14px;
    }

    .hero-row{
      display:flex;
      gap:12px;
      align-items:flex-start;
    }

    .hero-icon{
      width:46px;
      height:46px;
      border-radius:16px;
      background:var(--purple-soft);
      color:var(--purple);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .hero-icon svg{
      width:24px;
      height:24px;
    }

    .hero-heading{
      font-size:17px;
      font-weight:900;
      line-height:1.25;
      margin-bottom:6px;
    }

    .hero-text{
      font-size:13px;
      color:var(--muted);
      line-height:1.5;
    }

    .badge-row{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-top:12px;
    }

    .badge{
      font-size:11px;
      font-weight:800;
      color:var(--purple);
      background:var(--purple-soft);
      border-radius:999px;
      padding:8px 12px;
    }

    .card{
      padding:16px;
      margin-bottom:14px;
    }

    .section-title{
      font-size:15px;
      font-weight:900;
      margin-bottom:10px;
      letter-spacing:-.02em;
    }

    .section-note{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
      margin-bottom:12px;
    }

    .chip-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .chip{
      border:1px solid var(--line);
      border-radius:16px;
      padding:12px 12px;
      background:#fff;
      cursor:pointer;
      text-align:left;
      font-size:13px;
      font-weight:700;
      color:#334155;
      transition:.15s ease;
    }

    .chip.active{
      background:var(--purple-soft);
      border-color:#d8ccff;
      color:var(--purple);
      box-shadow:0 10px 22px rgba(109,76,255,.12);
    }

    .switch-box{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .choice-btn{
      flex:1;
      min-width:130px;
      border:1px solid var(--line);
      border-radius:16px;
      padding:13px 12px;
      background:#fff;
      cursor:pointer;
      text-align:left;
    }

    .choice-btn.active{
      border-color:#d8ccff;
      background:var(--purple-soft);
    }

    .choice-title{
      font-size:13px;
      font-weight:800;
      margin-bottom:4px;
    }

    .choice-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.4;
    }

    .field{
      margin-bottom:12px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:800;
      color:#374151;
      margin-bottom:6px;
    }

    .input,
    .textarea,
    .select{
      width:100%;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      padding:13px 14px;
      font-size:14px;
      color:#111827;
      outline:none;
    }

    .textarea{
      min-height:150px;
      resize:vertical;
      line-height:1.5;
    }

    .row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    .helper-note{
      margin-top:4px;
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
    }

    .inline-note{
      padding:12px 13px;
      border-radius:16px;
      font-size:12px;
      line-height:1.45;
      font-weight:700;
      margin-top:10px;
    }

    .inline-note.safe{
      background:#f5f3ff;
      color:#5b21b6;
      border:1px solid #ddd6fe;
    }

    .inline-note.urgent{
      background:#fff7ed;
      color:#c2410c;
      border:1px solid #fed7aa;
    }

    .message{
      display:none;
      padding:13px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:700;
      margin-bottom:14px;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--red-soft);
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      background:var(--green-soft);
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .submit-btn{
      width:100%;
      border:none;
      border-radius:999px;
      padding:15px 18px;
      background:linear-gradient(135deg,var(--purple),#5b3df5);
      color:#fff;
      font-size:15px;
      font-weight:900;
      cursor:pointer;
      box-shadow:0 16px 28px rgba(91,61,245,.24);
    }

    .submit-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .result-card{
      display:none;
      background:#fff;
      border:1px solid #bbf7d0;
      border-radius:20px;
      box-shadow:var(--shadow);
      padding:16px;
      margin-top:14px;
    }

    .result-card.show{
      display:block;
    }

    .result-title{
      font-size:15px;
      font-weight:900;
      color:#166534;
      margin-bottom:10px;
    }

    .result-row{
      font-size:13px;
      line-height:1.5;
      margin-bottom:6px;
      color:#14532d;
    }

    .result-row strong{
      color:#166534;
    }

    .copy-btn{
      width:100%;
      margin-top:10px;
      border:none;
      border-radius:999px;
      padding:12px 14px;
      font-size:13px;
      font-weight:800;
      background:#f3f4f6;
      color:#111827;
      cursor:pointer;
    }

    @media (max-width:360px){
      .chip-grid,.row{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <button class="back-btn" type="button" onclick="goBack()">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="top-title">
        <div class="page-title">Report an Issue to School Authority</div>
        <div class="page-sub">Share bullying, harassment, safety, welfare, or academic concerns privately.</div>
      </div>
    </div>

    <section class="hero-card">
      <div class="hero-row">
        <div class="hero-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3l7 3v5c0 4.7-2.9 8.6-7 10-4.1-1.4-7-5.3-7-10V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M9.5 12.3l1.7 1.7 3.6-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div>
          <div class="hero-heading">Your report will be handled privately</div>
          <div class="hero-text">
            You can submit anonymously or with your name. If you report anonymously,
            school authority can still reply through your tracking code and PIN.
          </div>
        </div>
      </div>

      <div class="badge-row">
        <div class="badge">Private</div>
        <div class="badge">Anonymous option</div>
        <div class="badge">Handled by school authority</div>
      </div>
    </section>

    <div class="message" id="reportMessage"></div>

    <section class="card">
      <div class="section-title">Issue type</div>
      <div class="section-note">Choose the category that best matches your concern.</div>

      <div class="chip-grid" id="categoryChips">
        <button class="chip active" type="button" data-category="bullying">Bullying</button>
        <button class="chip" type="button" data-category="harassment">Harassment</button>
        <button class="chip" type="button" data-category="safety">Safety concern</button>
        <button class="chip" type="button" data-category="welfare">Welfare issue</button>
        <button class="chip" type="button" data-category="academic_pressure">Academic pressure</button>
        <button class="chip" type="button" data-category="other">Other</button>
      </div>
    </section>

    <section class="card">
      <div class="section-title">Privacy choice</div>
      <div class="section-note">Choose how you want to submit this report.</div>

      <div class="switch-box">
        <button class="choice-btn active" type="button" id="anonymousBtn">
          <div class="choice-title">Submit anonymously</div>
          <div class="choice-sub">Your identity will not be shown to school authority.</div>
        </button>

        <button class="choice-btn" type="button" id="namedBtn">
          <div class="choice-title">Submit with my name</div>
          <div class="choice-sub">Your report will still be handled privately.</div>
        </button>
      </div>

      <div class="inline-note safe" id="privacyNote">
        You are currently reporting anonymously.
      </div>
    </section>

    <section class="card">
      <div class="section-title">Tell us what happened</div>

      <div class="field">
        <label for="reportTitle">Short title (optional)</label>
        <input id="reportTitle" class="input" type="text" placeholder="Short summary of the issue">
      </div>

      <div class="field">
        <label for="reportMessageInput">Report details</label>
        <textarea
          id="reportMessageInput"
          class="textarea"
          placeholder="Write as much as you want. Explain what happened, where it happened, and anything else the school authority should know."
        ></textarea>
        <div class="helper-note">
          Share only what you are comfortable sharing.
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="reportLocation">Location (optional)</label>
          <input id="reportLocation" class="input" type="text" placeholder="Where did it happen?">
        </div>

        <div class="field">
          <label for="reportPerson">Person involved (optional)</label>
          <input id="reportPerson" class="input" type="text" placeholder="Name or description">
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="reportDate">Date / time (optional)</label>
          <input id="reportDate" class="input" type="datetime-local">
        </div>

        <div class="field">
          <label for="reportUrgency">Urgency</label>
          <select id="reportUrgency" class="select">
            <option value="normal">Normal</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="allowReplySelect">Allow school authority to reply through this report</label>
        <select id="allowReplySelect" class="select">
          <option value="true">Yes, allow anonymous/private replies</option>
          <option value="false">No, just review the report</option>
        </select>
      </div>

      <div class="inline-note urgent" id="urgencyNote" style="display:none;">
        This report will be marked as urgent.
      </div>
    </section>

    <button class="submit-btn" id="submitReportBtn" type="button">
      Send report to school authority
    </button>

    <section class="result-card" id="resultCard">
      <div class="result-title">Report submitted successfully</div>
      <div class="result-row"><strong>Tracking code:</strong> <span id="resultTrackingCode">-</span></div>
      <div class="result-row"><strong>Reply PIN:</strong> <span id="resultReplyPin">-</span></div>
      <div class="result-row"><strong>Status:</strong> <span id="resultStatus">-</span></div>
      <div class="result-row"><strong>Privacy:</strong> <span id="resultPrivacy">-</span></div>
      <div class="result-row"><strong>School:</strong> <span id="resultSchool">-</span></div>
      <button class="copy-btn" type="button" id="copyReportDetailsBtn">Copy tracking code and PIN</button>
    </section>
  </div>

  <script>
    const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0bHJmdWpmaW14Y21zbnFybmlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njg1MzUzMTIsImV4cCI6MjA4NDExMTMxMn0.TksqfAitZ5Lbx9pa8fU76Qcl4iMsPGcfom-rC8rTf3Y";

    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let selectedCategory = "bullying";
    let isAnonymous = true;
    let lastTrackingCode = "";
    let lastReplyPin = "";

    function $(id) {
      return document.getElementById(id);
    }

    function goBack() {
      window.history.back();
    }

    function showMessage(text, type = "error") {
      const box = $("reportMessage");
      if (!text) {
        box.className = "message";
        box.textContent = "";
        return;
      }
      box.className = `message show ${type}`;
      box.textContent = text;
    }

    function setCategory(category) {
      selectedCategory = category;
      document.querySelectorAll("#categoryChips .chip").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.category === category);
      });
    }

    function setPrivacyMode(anonymousMode) {
      isAnonymous = anonymousMode;

      $("anonymousBtn").classList.toggle("active", anonymousMode);
      $("namedBtn").classList.toggle("active", !anonymousMode);

      $("privacyNote").textContent = anonymousMode
        ? "You are currently reporting anonymously."
        : "You are currently reporting with your name.";
    }

    function updateUrgencyNote() {
      const urgent = $("reportUrgency").value === "urgent";
      $("urgencyNote").style.display = urgent ? "block" : "none";
    }

    function getCurrentUserId() {
      try {
        const raw = localStorage.getItem("colspot_last_user");
        if (!raw) return "";
        const parsed = JSON.parse(raw);
        return parsed?.id || "";
      } catch {
        return "";
      }
    }

    function formatIncidentDate(value) {
      if (!value) return null;
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return null;
      return d.toISOString();
    }

    async function copyReportDetails() {
      if (!lastTrackingCode || !lastReplyPin) return;

      const text = `Tracking Code: ${lastTrackingCode}\nReply PIN: ${lastReplyPin}`;

      try {
        await navigator.clipboard.writeText(text);
        showMessage("Tracking code and PIN copied.", "success");
      } catch {
        showMessage("Could not copy automatically. Please save the code and PIN.", "error");
      }
    }

    async function submitReport() {
      showMessage("");

      const userId = getCurrentUserId();
      const title = $("reportTitle").value.trim();
      const message = $("reportMessageInput").value.trim();
      const locationText = $("reportLocation").value.trim();
      const personInvolved = $("reportPerson").value.trim();
      const incidentDate = formatIncidentDate($("reportDate").value);
      const urgency = $("reportUrgency").value;
      const allowAnonymousReply = $("allowReplySelect").value === "true";

      if (!userId) {
        showMessage("We could not find your user session. Please sign in again.");
        return;
      }

      if (!message) {
        showMessage("Please tell us what happened before submitting.");
        return;
      }

      const submitBtn = $("submitReportBtn");
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";

      try {
        const { data, error } = await supabase.functions.invoke("submit-school-report", {
          body: {
            submitted_by_user_id: userId,
            is_anonymous: isAnonymous,
            category: selectedCategory,
            title,
            message,
            location_text: locationText,
            incident_date: incidentDate,
            person_involved: personInvolved,
            urgency,
            allow_anonymous_reply: allowAnonymousReply
          }
        });

        if (error) {
          throw new Error((data && data.error) || error.message || "Could not submit report.");
        }

        if (!data?.ok) {
          if (data?.code === "COURSE_FORM_NOT_VERIFIED" || data?.code === "PROFILE_NOT_VERIFIED") {
            throw new Error("Please go to your profile and complete your course form first before submitting a report.");
          }
          throw new Error(data?.error || "Could not submit report.");
        }

        const report = data.report || {};

        lastTrackingCode = report.tracking_code || "";
        lastReplyPin = report.reply_pin || "";

        $("resultTrackingCode").textContent = report.tracking_code || "-";
        $("resultReplyPin").textContent = report.reply_pin || "-";
        $("resultStatus").textContent = report.status || "-";
        $("resultPrivacy").textContent = report.is_anonymous ? "Anonymous" : "Named";
        $("resultSchool").textContent = report.school_name || "-";

        $("resultCard").classList.add("show");

        $("reportTitle").value = "";
        $("reportMessageInput").value = "";
        $("reportLocation").value = "";
        $("reportPerson").value = "";
        $("reportDate").value = "";
        $("reportUrgency").value = "normal";
        $("allowReplySelect").value = "true";
        updateUrgencyNote();

        showMessage(data.message || "Report submitted successfully.", "success");
        window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
      } catch (err) {
        console.error(err);
        showMessage(err.message || "Could not submit report.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send report to school authority";
      }
    }

    document.querySelectorAll("#categoryChips .chip").forEach((btn) => {
      btn.addEventListener("click", () => setCategory(btn.dataset.category));
    });

    $("anonymousBtn").addEventListener("click", () => setPrivacyMode(true));
    $("namedBtn").addEventListener("click", () => setPrivacyMode(false));
    $("reportUrgency").addEventListener("change", updateUrgencyNote);
    $("submitReportBtn").addEventListener("click", submitReport);
    $("copyReportDetailsBtn").addEventListener("click", copyReportDetails);

    updateUrgencyNote();
  </script>
</body>
</html>
