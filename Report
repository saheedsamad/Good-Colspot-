<!-- 🔹 REPORTS SCREEN START -->
<div id="screen-reports" class="screen">
  <style>
    #screen-reports .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      margin: 10px 4px 2px;
    }

    #screen-reports .section-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin: 0 4px 8px;
    }

    #screen-reports .field-label {
      font-size: 11px;
      color: var(--text-muted);
      margin: 4px 4px 2px;
      font-weight: 500;
    }

    #screen-reports .top-card {
      border-radius: 24px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      padding: 12px 14px 14px;
      margin-bottom: 12px;
    }

    #screen-reports .pill-select-wrap {
      margin-top: 4px;
      margin-bottom: 4px;
    }

    #screen-reports .select-input {
      width: 100%;
      padding: 9px 12px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      font-size: 16px;
      background: #f9fafb;
      appearance: none;
      background-image:
        linear-gradient(45deg, transparent 50%, #9ca3af 50%),
        linear-gradient(135deg, #9ca3af 50%, transparent 50%);
      background-position:
        calc(100% - 14px) 50%,
        calc(100% - 10px) 50%;
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
    }

    #screen-reports .select-input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
      background-color: #ffffff;
