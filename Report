    </div>

    <div class="result-list">
      <div class="result-row">
        <span>Status</span>
        <strong id="reportResultStatus">-</strong>
      </div>
      <div class="result-row">
        <span>Privacy</span>
        <strong id="reportResultPrivacy">-</strong>
