  <section>
    <div class="section-title">3. Report details</div>
    <div class="section-sub">Give only the details you are comfortable sharing.</div>

    <div class="card">
      <div class="field">
        <label for="reportTitleInput">Short title (optional)</label>
        <input id="reportTitleInput" class="input" type="text" placeholder="Short summary of the issue">
      </div>

