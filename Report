    #screen-reports .course-meta {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    #screen-reports .inner-card {
      margin-top: 10px;
      border-radius: 18px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 10px 10px 12px;
    }

    #screen-reports .field-row {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 4px;
    }

    #screen-reports .text-input,
    #screen-reports .number-input {
      width: 100%;
      padding: 8px 11px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      font-size: 16px;
      background: #ffffff;
    }

    #screen-reports .text-input:focus,
    #screen-reports .number-input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
    }

    #screen-reports .rule-row {
      display: grid;
      grid-template-columns: 1.1fr 1.1fr 1.1fr;
      gap: 8px;
      margin-top: 12px;
      align-items: flex-start;
    }

    #screen-reports .rule-row > div {
      display: flex;
      flex-direction: column;
