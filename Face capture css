:root{
  --blue:#2563eb;
  --blue-2:#3b82f6;
  --blue-3:#dbeafe;
  --green:#16a34a;
  --green-soft:#dcfce7;
  --red:#dc2626;
  --red-soft:#fee2e2;
  --text:#0f172a;
  --muted:#64748b;
  --line:#dbe5f3;
  --card:#ffffff;
  --bg-1:#f5f9ff;
  --bg-2:#edf4ff;
  --shadow:0 14px 40px rgba(37, 99, 235, .10);
  --radius-xl:28px;
  --radius-lg:22px;
  --radius-md:18px;
  --radius-sm:14px;
  --safe-top:env(safe-area-inset-top, 0px);
  --safe-bottom:env(safe-area-inset-bottom, 0px);
}

*{
  box-sizing:border-box;
}

html, body{
  margin:0;
  padding:0;
  min-height:100%;
  background:
    radial-gradient(circle at top left, rgba(59,130,246,.10), transparent 28%),
    linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
  color:var(--text);
  font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body{
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}

button,
input,
select,
textarea{
  font:inherit;
}

.face-page{
  width:100%;
  max-width:460px;
  margin:0 auto;
  padding:
    calc(16px + var(--safe-top))
    14px
    calc(22px + var(--safe-bottom));
  display:flex;
  flex-direction:column;
  gap:14px;
}

.fc-header{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:2px 2px 0;
}

.fc-back-btn{
  width:44px;
  height:44px;
  flex:0 0 auto;
  border:none;
  border-radius:16px;
  background:#fff;
  color:var(--text);
  box-shadow:var(--shadow);
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
}

.fc-back-btn svg{
  width:22px;
  height:22px;
}

.fc-header-text{
  min-width:0;
}

.fc-header-text h1{
  margin:2px 0 4px;
  font-size:1.35rem;
  line-height:1.1;
  font-weight:800;
  letter-spacing:-0.02em;
}

.fc-header-text p{
  margin:0;
  color:var(--muted);
  font-size:.95rem;
  line-height:1.45;
}

.fc-card{
  background:var(--card);
  border:1px solid rgba(37,99,235,.10);
  border-radius:var(--radius-xl);
  box-shadow:var(--shadow);
}

.fc-steps-card{
  padding:16px;
}

.fc-steps-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:14px;
}

.fc-step-kicker{
  font-size:.93rem;
  font-weight:800;
  color:var(--text);
}

.fc-step-note{
  font-size:.82rem;
  font-weight:700;
  color:var(--muted);
}

.fc-steps-track{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:8px;
}

.fc-step-pill{
  min-width:0;
  padding:10px 8px;
  border-radius:16px;
  border:1px solid var(--line);
  background:#f8fbff;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5px;
  text-align:center;
}

.fc-step-number{
  width:24px;
  height:24px;
  border-radius:999px;
  border:1px solid rgba(100,116,139,.18);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:.76rem;
  font-weight:800;
  color:var(--muted);
  background:#fff;
}

.fc-step-label{
  font-size:.80rem;
  line-height:1.2;
  font-weight:800;
  color:var(--muted);
}

.fc-step-pill.fc-step-active{
  background:rgba(37,99,235,.09);
  border-color:rgba(37,99,235,.22);
}

.fc-step-pill.fc-step-active .fc-step-number{
  background:var(--blue);
  color:#fff;
  border-color:transparent;
}

.fc-step-pill.fc-step-active .fc-step-label{
  color:var(--blue);
}

.fc-step-pill.fc-step-done{
  background:rgba(22,163,74,.08);
  border-color:rgba(22,163,74,.18);
}

.fc-step-pill.fc-step-done .fc-step-number{
  background:var(--green);
  color:#fff;
  border-color:transparent;
}

.fc-step-pill.fc-step-done .fc-step-label{
  color:var(--green);
}

.fc-camera-card{
  padding:14px;
}

.fc-camera-shell{
  position:relative;
  width:100%;
  min-height:380px;
  aspect-ratio:3/4;
  border-radius:26px;
  overflow:hidden;
  background:
    linear-gradient(180deg, rgba(15,23,42,.88) 0%, rgba(30,41,59,.95) 100%);
  border:1px solid rgba(255,255,255,.08);
}

.fc-camera-video,
.fc-overlay-canvas,
.fc-capture-canvas,
.fc-capture-preview{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.fc-camera-video{
  display:block;
  background:#0f172a;
  transform:scaleX(-1);
  z-index:1;
}

.fc-overlay-canvas{
  z-index:3;
  pointer-events:none;
}

.fc-capture-canvas{
  display:none;
}

.fc-capture-preview{
  z-index:4;
  display:none;
  background:#0f172a;
}

.fc-camera-mask{
  position:absolute;
  inset:0;
  z-index:2;
  background:
    linear-gradient(180deg, rgba(15,23,42,.15) 0%, rgba(15,23,42,.22) 100%);
  pointer-events:none;
}

.fc-face-oval{
  position:absolute;
  left:50%;
  top:50%;
  width:68%;
  height:58%;
  transform:translate(-50%, -50%);
  border-radius:999px;
  border:3px solid rgba(255,255,255,.88);
  box-shadow:
    0 0 0 9999px rgba(15,23,42,.18),
    0 0 24px rgba(255,255,255,.16);
  z-index:5;
  pointer-events:none;
}

.fc-camera-badge{
  position:absolute;
  top:14px;
  left:14px;
  z-index:6;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(15,23,42,.56);
  color:#fff;
  font-size:.82rem;
  font-weight:800;
  backdrop-filter:blur(8px);
}

.fc-camera-placeholder{
  position:absolute;
  inset:0;
  z-index:2;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:28px 24px;
  color:#fff;
}

.fc-camera-placeholder-icon{
  width:72px;
  height:72px;
  border-radius:22px;
  background:rgba(255,255,255,.10);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:14px;
  backdrop-filter:blur(8px);
}

.fc-camera-placeholder-icon svg{
  width:30px;
  height:30px;
}

.fc-camera-placeholder h2{
  margin:0 0 8px;
  font-size:1.2rem;
  font-weight:800;
  letter-spacing:-0.02em;
}

.fc-camera-placeholder p{
  margin:0;
  max-width:260px;
  font-size:.95rem;
  line-height:1.5;
  color:rgba(255,255,255,.84);
}

.fc-status-wrap{
  padding:16px 4px 2px;
}

.fc-status-title{
  margin:0;
  text-align:center;
  font-size:1.06rem;
  line-height:1.2;
  font-weight:800;
  letter-spacing:-0.01em;
}

.fc-status-sub{
  margin:8px auto 0;
  max-width:310px;
  text-align:center;
  color:var(--muted);
  font-size:.93rem;
  line-height:1.48;
}

.fc-status-message{
  margin:12px 0 0;
  padding:12px 14px;
  border-radius:16px;
  font-size:.90rem;
  line-height:1.45;
  font-weight:700;
}

.fc-status-message-error{
  background:var(--red-soft);
  color:var(--red);
  border:1px solid rgba(220,38,38,.12);
}

.fc-status-message-success{
  background:var(--green-soft);
  color:var(--green);
  border:1px solid rgba(22,163,74,.12);
}

.fc-sequence-row{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:10px;
  margin-top:15px;
}

.fc-sequence-item{
  border:1px solid var(--line);
  background:#f8fbff;
  border-radius:18px;
  padding:12px 10px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  text-align:center;
  color:var(--muted);
}

.fc-sequence-item.active{
  background:rgba(37,99,235,.08);
  border-color:rgba(37,99,235,.20);
  color:var(--blue);
}

.fc-sequence-item.done{
  background:rgba(22,163,74,.09);
  border-color:rgba(22,163,74,.20);
  color:var(--green);
}

.fc-sequence-icon{
  width:28px;
  height:28px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.fc-sequence-icon svg{
  width:22px;
  height:22px;
}

.fc-sequence-text{
  font-size:.84rem;
  font-weight:800;
}

.fc-guidance-card{
  padding:16px;
}

.fc-guidance-head{
  display:flex;
  align-items:flex-start;
  gap:12px;
  margin-bottom:14px;
}

.fc-guidance-icon{
  width:42px;
  height:42px;
  border-radius:14px;
  background:#fff7d6;
  color:#d97706;
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
}

.fc-guidance-icon svg{
  width:22px;
  height:22px;
}

.fc-guidance-head h3{
  margin:0 0 4px;
  font-size:1rem;
  line-height:1.2;
  font-weight:800;
  letter-spacing:-0.01em;
}

.fc-guidance-head p{
  margin:0;
  color:var(--muted);
  font-size:.90rem;
  line-height:1.45;
}

.fc-tips-list{
  display:grid;
  gap:11px;
}

.fc-tip-item{
  display:flex;
  gap:10px;
  align-items:flex-start;
  color:var(--muted);
  font-size:.93rem;
  line-height:1.5;
}

.fc-tip-dot{
  width:9px;
  height:9px;
  border-radius:50%;
  background:var(--blue-2);
  margin-top:6px;
  flex:0 0 auto;
}

.fc-actions-card{
  padding:14px;
}

.fc-action-stack{
  display:grid;
  gap:10px;
}

.fc-action-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.fc-btn{
  min-height:54px;
  width:100%;
  border:none;
  border-radius:18px;
  font-size:1rem;
  font-weight:800;
  letter-spacing:-0.01em;
  cursor:pointer;
  transition:.18s ease;
}

.fc-btn:disabled{
  opacity:.56;
  cursor:not-allowed;
}

.fc-btn-primary{
  background:linear-gradient(135deg, var(--blue) 0%, var(--blue-2) 100%);
  color:#fff;
  box-shadow:0 14px 28px rgba(37,99,235,.22);
}

.fc-btn-secondary{
  background:#f8fbff;
  color:var(--text);
  border:1px solid var(--line);
}

.fc-bottom-note{
  margin:12px 4px 0;
  text-align:center;
  color:var(--muted);
  font-size:.84rem;
  line-height:1.45;
}

.hidden{
  display:none !important;
}

@media (max-width:390px){
  .face-page{
    padding-left:12px;
    padding-right:12px;
  }

  .fc-camera-shell{
    min-height:340px;
  }

  .fc-action-row{
    grid-template-columns:1fr;
  }

  .fc-steps-track{
    gap:7px;
  }

  .fc-step-label{
    font-size:.76rem;
  }
}
