:root{
  --bg:#edf3ff;
  --panel:#f4f7ff;
  --card:#ffffff;
  --text:#182033;
  --muted:#7a8499;
  --line:#dfe7f6;
  --blue:#4c83f6;
  --blue-dark:#316df0;
  --blue-soft:#dbeafe;
  --blue-soft-2:#eef5ff;
  --green:#22c55e;
  --green-soft:#dcfce7;
  --red:#dc2626;
  --red-soft:#fee2e2;
  --shadow:0 18px 40px rgba(76,131,246,.12);
  --shadow-soft:0 10px 24px rgba(15,23,42,.08);
  --radius-xl:30px;
  --radius-lg:24px;
  --radius-md:18px;
  --radius-pill:999px;
  --safe-top:env(safe-area-inset-top, 0px);
  --safe-bottom:env(safe-area-inset-bottom, 0px);
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html, body{
  margin:0;
  padding:0;
  min-height:100%;
  background:#e9eef7;
  color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

body{
  display:flex;
  justify-content:center;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}

button,
input,
select,
textarea{
  font:inherit;
}

.face-page{
  width:100%;
  max-width:430px;
  min-height:100vh;
  background:var(--bg);
  padding:
    calc(10px + var(--safe-top))
    14px
    calc(18px + var(--safe-bottom));
}

.fc-header{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:14px;
}

.fc-back-btn{
  width:42px;
  height:42px;
  border:none;
  border-radius:14px;
  background:#f1f4fb;
  box-shadow:inset 0 0 0 1px rgba(24,32,51,.04);
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  cursor:pointer;
}

.fc-back-btn svg{
  width:20px;
  height:20px;
  color:#3b455c;
}

.fc-header-title{
  font-size:17px;
  font-weight:800;
  letter-spacing:-.02em;
  color:#20283a;
}

.fc-main-card{
  background:var(--panel);
  border-radius:34px;
  padding:18px 16px 16px;
  box-shadow:var(--shadow);
  border:1px solid rgba(255,255,255,.55);
}

.fc-camera-card{
  margin:0;
  padding:0;
  background:transparent;
  border:none;
  box-shadow:none;
}

.fc-camera-shell{
  position:relative;
  width:100%;
  aspect-ratio:1/1.08;
  min-height:320px;
  border-radius:28px;
  overflow:hidden;
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.65), rgba(255,255,255,0) 24%),
    linear-gradient(180deg,#dcecff 0%, #c8dcf9 100%);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.65);
}

.fc-camera-video,
.fc-overlay-canvas,
.fc-capture-canvas,
.fc-capture-preview{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.fc-camera-video{
  display:block;
  background:transparent;
  z-index:1;
}

.fc-overlay-canvas{
  z-index:3;
  pointer-events:none;
}

.fc-capture-canvas{
  display:none;
}

.fc-capture-preview{
  z-index:4;
  display:block;
  background:transparent;
}

.fc-camera-preview.hidden,
.fc-capture-preview.hidden{
  display:none !important;
}

.fc-camera-overlay{
  position:absolute;
  inset:0;
  z-index:5;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events:none;
}

.fc-frame{
  width:78%;
  height:78%;
  border-radius:30px;
  border:2px dashed rgba(123,170,239,.55);
  position:relative;
  box-shadow:inset 0 0 0 999px rgba(255,255,255,.04);
}

.fc-corner{
  position:absolute;
  width:42px;
  height:42px;
  border:5px solid rgba(255,255,255,.92);
  border-radius:14px;
}

.fc-corner.tl{
  top:-2px;
  left:-2px;
  border-right:none;
  border-bottom:none;
}

.fc-corner.tr{
  top:-2px;
  right:-2px;
  border-left:none;
  border-bottom:none;
}

.fc-corner.bl{
  bottom:-2px;
  left:-2px;
  border-right:none;
  border-top:none;
}

.fc-corner.br{
  right:-2px;
  bottom:-2px;
  border-left:none;
  border-top:none;
}

.fc-camera-placeholder{
  position:absolute;
  inset:0;
  z-index:2;
  display:flex;
  align-items:center;
  justify-content:center;
}

.fc-camera-placeholder-icon{
  width:84px;
  height:84px;
  border-radius:22px;
  background:rgba(255,255,255,.20);
  display:flex;
  align-items:center;
  justify-content:center;
  color:#7da7dd;
  backdrop-filter:blur(8px);
}

.fc-camera-placeholder-icon svg{
  width:34px;
  height:34px;
}

.fc-live-pill{
  position:absolute;
  left:50%;
  bottom:18px;
  transform:translateX(-50%);
  z-index:6;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:48px;
  padding:0 18px;
  border-radius:999px;
  background:linear-gradient(135deg,var(--blue),var(--blue-dark));
  color:#fff;
  font-size:13px;
  font-weight:700;
  box-shadow:0 10px 26px rgba(76,131,246,.28);
  text-align:center;
  max-width:92%;
}

.fc-step-track-wrap{
  margin:14px 2px 12px;
}

.fc-step-track{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:0;
  margin-bottom:12px;
}

.fc-step-line{
  flex:1;
  max-width:58px;
  height:4px;
  border-radius:999px;
  background:#d7dfef;
  margin:0 6px;
}

.fc-step-line.done{
  background:#a9dcff;
}

.fc-step-circle{
  width:24px;
  height:24px;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:11px;
  font-weight:800;
  background:#d9e0ee;
  color:#8b96aa;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.55);
}

.fc-step-circle.active{
  background:var(--blue);
  color:#fff;
}

.fc-step-circle.done{
  background:#59c5dd;
  color:#fff;
}

.fc-step-chip{
  width:max-content;
  max-width:100%;
  margin:0 auto;
  padding:10px 16px;
  border-radius:999px;
  background:#ffffff;
  box-shadow:var(--shadow-soft);
  color:#1f2a3d;
  font-weight:700;
  font-size:13px;
  text-align:center;
  border:1px solid rgba(76,131,246,.08);
}

.fc-status-sub{
  margin:0 auto 12px;
  max-width:310px;
  text-align:center;
  color:var(--muted);
  font-size:.93rem;
  line-height:1.48;
}

.fc-status-message{
  margin:10px 0 0;
  padding:12px 14px;
  border-radius:16px;
  font-size:.90rem;
  line-height:1.45;
  font-weight:700;
}

.fc-status-message-error{
  background:var(--red-soft);
  color:var(--red);
  border:1px solid rgba(220,38,38,.12);
}

.fc-status-message-success{
  background:var(--green-soft);
  color:var(--green);
  border:1px solid rgba(22,163,74,.12);
}

.fc-actions-card{
  margin-top:10px;
}

.fc-btn{
  min-height:60px;
  width:100%;
  border:none;
  border-radius:18px;
  font-size:16px;
  font-weight:700;
  cursor:pointer;
  transition:.18s ease;
}

.fc-btn:disabled{
  opacity:.56;
  cursor:not-allowed;
}

.fc-btn-white{
  background:#ffffff;
  color:#20283a;
  box-shadow:var(--shadow-soft);
}

.fc-btn-primary{
  background:linear-gradient(135deg,var(--blue),var(--blue-dark));
  color:#fff;
  box-shadow:0 12px 28px rgba(76,131,246,.28);
}

.fc-btn-secondary{
  background:#fff;
  color:#2b3447;
  box-shadow:var(--shadow-soft);
}

.fc-action-row{
  display:grid;
  grid-template-columns:1fr 1.2fr;
  gap:12px;
  margin-top:12px;
}

.fc-bottom-dots{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  margin:14px 0 8px;
}

.fc-bottom-dots span{
  width:7px;
  height:7px;
  border-radius:999px;
  background:#d8dfef;
}

.fc-bottom-dots span.active{
  width:26px;
  background:var(--blue);
}

.fc-help-link{
  display:block;
  width:100%;
  background:transparent;
  border:none;
  text-align:center;
  color:#7c8cab;
  font-size:14px;
  cursor:pointer;
  margin-top:6px;
}

.hidden{
  display:none !important;
}

@media (max-width:380px){
  .fc-camera-shell{
    min-height:290px;
  }

  .fc-action-row{
    grid-template-columns:1fr;
  }

  .fc-header-title{
    font-size:16px;
  }
}
