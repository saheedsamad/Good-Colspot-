<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Verification</title>

  <style>
    :root{
      --blue:#2563eb;
      --bg:#f3f6ff;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#6b7280;
      --line:#e5e7eb;
      --danger:#ef4444;
      --ok:#16a34a;
      --shadow:0 10px 26px rgba(15,23,42,.10);
      --radius:22px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background: var(--bg);
      color: var(--text);
    }

    .phone-shell{
      max-width: 460px;
      margin: 0 auto;
      min-height: 100vh;
      padding: 18px 14px 22px;
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:10px;
      padding: 8px 2px 14px;
    }
    .back-btn{
      width:42px;height:42px;border-radius:14px;
      border:1px solid var(--line);
      background:#fff;
      display:grid;place-items:center;
      cursor:pointer;
      box-shadow: 0 6px 16px rgba(15,23,42,.06);
    }
    .back-btn svg{width:18px;height:18px}

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      flex:1;
      min-width: 0;
    }
    .brand-logo{
      width:36px;height:36px;border-radius:12px;
      overflow:hidden;
      background:#fff;
      border:1px solid var(--line);
    }
    .brand-logo img{width:100%;height:100%;object-fit:cover}
    .brand-title{
      font-weight: 800;
      letter-spacing: .2px;
      font-size: 16px;
      white-space: nowrap;
      overflow:hidden;
      text-overflow: ellipsis;
    }
    .brand-sub{
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
      white-space: nowrap;
      overflow:hidden;
      text-overflow: ellipsis;
    }

    .hero{
      background: linear-gradient(180deg, rgba(37,99,235,.10), rgba(37,99,235,.03));
      border: 1px solid rgba(37,99,235,.14);
      border-radius: var(--radius);
      padding: 16px 16px;
      box-shadow: var(--shadow);
    }
    .hero h1{
      margin:0 0 6px;
      font-size: 18px;
      line-height: 1.2;
    }
    .hero p{
      margin:0;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.45;
    }

    .card{
      margin-top: 14px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }

    .card-head{
      padding: 14px 14px 10px;
      border-bottom: 1px solid var(--line);
    }
    .card-head .title{
      font-weight: 800;
      font-size: 14px;
      margin:0;
    }
    .card-head .sub{
      margin:6px 0 0;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
    }

    .card-body{padding: 14px}

    .upload-box{
      border: 1.6px dashed #cbd5e1;
      border-radius: 18px;
      padding: 14px;
      background: #fbfdff;
    }
    .upload-row{
      display:flex;
      gap: 10px;
      align-items:center;
      flex-wrap: wrap;
    }
    .file-btn{
      display:inline-flex;
      align-items:center;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 16px;
      border: 1px solid var(--line);
      background:#fff;
      cursor:pointer;
      font-weight: 700;
      font-size: 13px;
    }
    .file-btn svg{width:18px;height:18px;color: var(--blue)}
    #fileInput{display:none}

    .hint{
      margin-top:10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
    }

    .preview{
      margin-top: 12px;
      display:none;
      gap: 10px;
      align-items:center;
    }
    .thumb{
      width: 56px;
      height: 56px;
      border-radius: 16px;
      border: 1px solid var(--line);
      background:#fff;
      overflow:hidden;
      display:grid;
      place-items:center;
    }
    .thumb img{width:100%;height:100%;object-fit:cover}
    .thumb .pdf{
      font-weight: 900;
      color: var(--blue);
      font-size: 12px;
    }
    .file-meta{
      flex:1;
      min-width: 0;
    }
    .file-meta .name{
      font-weight: 800;
      font-size: 13px;
      white-space: nowrap;
      overflow:hidden;
      text-overflow: ellipsis;
    }
    .file-meta .size{
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .btn{
      width:100%;
      border:none;
      border-radius: 18px;
      padding: 14px 14px;
      cursor:pointer;
      font-weight: 900;
      font-size: 14px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap: 10px;
    }
    .btn-primary{
      background: var(--blue);
      color:#fff;
      margin-top: 12px;
    }
    .btn-primary:disabled{
      opacity:.55;
      cursor:not-allowed;
    }
    .btn-ghost{
      background:#fff;
      color: var(--text);
      border: 1px solid var(--line);
      margin-top: 10px;
    }

    .loading{
      display:none;
      margin-top: 12px;
      padding: 12px;
      border-radius: 18px;
      border: 1px solid rgba(37,99,235,.18);
      background: rgba(37,99,235,.06);
      color: #1e40af;
      font-size: 13px;
      line-height: 1.45;
    }
    .spinner{
      width:16px;height:16px;border-radius:999px;
      border:2px solid rgba(30,64,175,.25);
      border-top-color:#1e40af;
      display:inline-block;
      animation: spin .9s linear infinite;
      vertical-align: -3px;
      margin-right: 8px;
    }
    @keyframes spin{to{transform: rotate(360deg)}}

    .msg{
      display:none;
      margin-top: 12px;
      padding: 12px 12px;
      border-radius: 18px;
      font-size: 13px;
      line-height: 1.45;
      border: 1px solid var(--line);
      background:#fff;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .msg.err{
      border-color: rgba(239,68,68,.25);
      background: rgba(239,68,68,.08);
      color: #7f1d1d;
    }
    .msg.ok{
      border-color: rgba(22,163,74,.25);
      background: rgba(22,163,74,.08);
      color: #14532d;
    }

    .details{
      margin-top: 10px;
      display:none;
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }
    .grid{
      display:grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .field{
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 12px;
      background:#fff;
    }
    .label{
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .value{
      font-weight: 900;
      font-size: 14px;
      word-break: break-word;
    }

    .debug-box{
      display:none;
      margin-top:12px;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      padding:12px;
    }
    .debug-title{
      font-size:12px;
      font-weight:900;
      margin-bottom:8px;
      color:#334155;
    }
    .debug-pre{
      margin:0;
      font-size:11px;
      line-height:1.45;
      white-space:pre-wrap;
      word-break:break-word;
      color:#0f172a;
    }

    .footer-note{
      margin-top: 14px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      text-align:center;
      padding: 0 8px;
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <div class="topbar">
      <button class="back-btn" onclick="history.back()">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot" />
        </div>
        <div style="min-width:0">
          <div class="brand-title">Verification</div>
          <div class="brand-sub">Upload clearance form to verify your profile</div>
        </div>
      </div>
    </div>

    <section class="hero">
      <h1>Upload your clearance form</h1>
      <p>
        We will read the document, extract your details, save them to your account, and verify your record successfully.
      </p>
    </section>

    <section class="card">
      <div class="card-head">
        <p class="title">Step 1 • Clearance form</p>
        <p class="sub">Upload a clear photo or scan. Make sure the text is readable.</p>
      </div>

      <div class="card-body">
        <div class="upload-box">
          <div class="upload-row">
            <label class="file-btn" for="fileInput">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M7 9l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 20h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Choose file
            </label>
            <input id="fileInput" type="file" accept="image/*,application/pdf" />
          </div>

          <div class="hint">
            Accepted: JPG/PNG/PDF. If you upload a random photo, it will be rejected.
          </div>

          <div id="preview" class="preview">
            <div class="thumb" id="thumb"></div>
            <div class="file-meta">
              <div class="name" id="fileName">—</div>
              <div class="size" id="fileSize">—</div>
            </div>
          </div>

          <div id="loading" class="loading">
            <span class="spinner"></span>
            Processing your clearance… please wait.
          </div>

          <div id="msgErr" class="msg err"></div>
          <div id="msgOk" class="msg ok"></div>

          <button id="btnExtract" class="btn btn-primary" disabled>
            Extract details
          </button>

          <button id="btnReset" class="btn btn-ghost" style="display:none;">
            Upload another file
          </button>

          <div id="details" class="details">
            <div class="grid">
              <div class="field"><div class="label">Full name</div><div class="value" id="vFullName">—</div></div>
              <div class="field"><div class="label">Matric / Staff ID</div><div class="value" id="vMatric">—</div></div>
              <div class="field"><div class="label">School name</div><div class="value" id="vSchool">—</div></div>
              <div class="field"><div class="label">Department</div><div class="value" id="vDept">—</div></div>
              <div class="field"><div class="label">Programme</div><div class="value" id="vProgramme">—</div></div>
              <div class="field"><div class="label">Faculty</div><div class="value" id="vFaculty">—</div></div>
              <div class="field"><div class="label">Level</div><div class="value" id="vLevel">—</div></div>
              <div class="field"><div class="label">Session</div><div class="value" id="vSession">—</div></div>
              <div class="field"><div class="label">Semester</div><div class="value" id="vSemester">—</div></div>
            </div>

            <button id="btnContinue" class="btn btn-primary" style="margin-top:12px;">
              Continue
            </button>

            <div class="footer-note">
              If any detail is wrong, go back and upload a clearer file.
            </div>
          </div>

          <div id="debugBox" class="debug-box">
            <div class="debug-title">Debug</div>
            <pre id="debugPre" class="debug-pre"></pre>
          </div>
        </div>
      </div>
    </section>

    <div class="footer-note">
      Colspot will only use this for verification. You can delete your account anytime.
    </div>
  </div>

  <script type="module" src="./client_supabase.js"></script>
  <script src="./guard_session.js"></script>

  <script>
    const BUCKET = "verification_uploads";
    const EXTRACT_FN_URL = "https://wtlrfujfimxcmsnqrnig.functions.supabase.co/extract-clearance";
    const VERIFICATION_TABLE = "verification_clearance";
    const ACCOUNT_TABLE = "student_accounts";
    const DEBUG_MODE = true;

    const el = (id) => document.getElementById(id);

    function showErr(msg){
      el("msgOk").style.display = "none";
      el("msgErr").style.display = "block";
      el("msgErr").textContent = msg;
    }

    function showOk(msg){
      el("msgErr").style.display = "none";
      el("msgOk").style.display = "block";
      el("msgOk").textContent = msg;
    }

    function clearMsgs(){
      el("msgErr").style.display = "none";
      el("msgOk").style.display = "none";
      el("msgErr").textContent = "";
      el("msgOk").textContent = "";
    }

    function setLoading(on){
      el("loading").style.display = on ? "block" : "none";
      el("btnExtract").disabled = on || !pickedFile;
      if (el("btnContinue")) el("btnContinue").disabled = on;
    }

    function bytesToSize(bytes){
      const sizes = ["Bytes","KB","MB","GB"];
      if (!bytes && bytes !== 0) return "—";
      if (bytes === 0) return "0 Bytes";
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(1) + " " + sizes[i];
    }

    function setDebug(data){
      if (!DEBUG_MODE) return;
      el("debugBox").style.display = "block";
      el("debugPre").textContent = typeof data === "string" ? data : JSON.stringify(data, null, 2);
      console.log("VERIFY DEBUG:", data);
    }

    function clearDebug(){
      el("debugBox").style.display = DEBUG_MODE ? "block" : "none";
      el("debugPre").textContent = DEBUG_MODE ? "Waiting..." : "";
    }

    let pickedFile = null;
    let uploadedPath = null;
    let extracted = null;
    let currentUser = null;

    async function getUser(){
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not loaded. Check client_supabase.js");

      const { data, error } = await sb.auth.getUser();
      if (error) throw error;
      if (!data || !data.user) throw new Error("Not signed in.");
      return data.user;
    }

    function renderPreview(file){
      el("preview").style.display = "flex";
      el("fileName").textContent = file.name || "Selected file";
      el("fileSize").textContent = bytesToSize(file.size);

      const thumb = el("thumb");
      thumb.innerHTML = "";

      if ((file.type || "").includes("pdf")) {
        const div = document.createElement("div");
        div.className = "pdf";
        div.textContent = "PDF";
        thumb.appendChild(div);
      } else {
        const img = document.createElement("img");
        img.alt = "Preview";
        thumb.appendChild(img);

        const url = URL.createObjectURL(file);
        img.src = url;
        img.onload = () => URL.revokeObjectURL(url);
      }
    }

    function resetAll(){
      pickedFile = null;
      uploadedPath = null;
      extracted = null;

      el("fileInput").value = "";
      el("preview").style.display = "none";
      el("btnExtract").disabled = true;
      el("btnReset").style.display = "none";
      el("details").style.display = "none";
      clearMsgs();
      clearDebug();
      setLoading(false);
    }

    async function uploadToStorage(file){
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      const ext = (file.name || "file").split(".").pop() || "bin";
      const safeExt = ext.toLowerCase().slice(0, 8);
      const name = "clearance_" + Date.now() + "_" + Math.random().toString(16).slice(2) + "." + safeExt;
      const path = `${currentUser.id}/${name}`;

      setDebug({
        step: "upload_start",
        bucket: BUCKET,
        path,
        file_name: file.name,
        file_type: file.type,
        file_size: file.size
      });

      const { data, error } = await sb.storage
        .from(BUCKET)
        .upload(path, file, {
          cacheControl: "3600",
          upsert: false,
          contentType: file.type || "application/octet-stream",
        });

      if (error) {
        setDebug({ step: "upload_error", error });
        throw error;
      }

      setDebug({
        step: "upload_done",
        bucket: BUCKET,
        returned_data: data,
        saved_path: path
      });

      return path;
    }

    async function callExtractFunction(storagePath, file){
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      const { data: sessData, error: sessErr } = await sb.auth.getSession();
      if (sessErr) throw sessErr;

      const accessToken = sessData?.session?.access_token || "";
      if (!accessToken) throw new Error("Missing authorization header. Please sign in again.");

      const payload = {
        bucket: BUCKET,
        path: storagePath,
        mime_type: file.type || null,
        file_size: file.size || null
      };

      setDebug({
        step: "extract_request",
        url: EXTRACT_FN_URL,
        payload
      });

      const resp = await fetch(EXTRACT_FN_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${accessToken}`,
          "x-debug": "1"
        },
        body: JSON.stringify(payload),
      });

      let data = null;
      try {
        data = await resp.json();
      } catch {
        data = null;
      }

      setDebug({
        step: "extract_response",
        status: resp.status,
        ok: resp.ok,
        data
      });

      if (!resp.ok) {
        const msg =
          (data && (data.error || data.message || data.details)) ||
          `Extraction failed (${resp.status})`;
        throw new Error(msg);
      }

      return data;
    }

    function paintExtracted(details){
      el("vFullName").textContent = details?.full_name || "—";
      el("vMatric").textContent = details?.matric_no || details?.matric || "—";
      el("vSchool").textContent = details?.school_name || "—";
      el("vDept").textContent = details?.department || "—";
      el("vProgramme").textContent = details?.programme || "—";
      el("vFaculty").textContent = details?.faculty || "—";
      el("vLevel").textContent = details?.level || "—";
      el("vSession").textContent = details?.session || "—";
      el("vSemester").textContent = details?.semester || "—";
    }

    async function saveToVerificationTable(){
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      const payload = {
        user_id: currentUser.id,
        file_bucket: BUCKET,
        file_path: uploadedPath,
        full_name: extracted?.full_name || null,
        matric_no: extracted?.matric_no || extracted?.matric || null,
        school_name: extracted?.school_name || null,
        department: extracted?.department || null,
        programme: extracted?.programme || null,
        faculty: extracted?.faculty || null,
        level: extracted?.level || null,
        session: extracted?.session || null,
        semester: extracted?.semester || null,
        extracted_json: extracted || null,
        status: "successful"
      };

      setDebug({
        step: "save_verification",
        table: VERIFICATION_TABLE,
        payload
      });

      const { data: existing, error: checkError } = await sb
        .from(VERIFICATION_TABLE)
        .select("id, status")
        .eq("user_id", currentUser.id)
        .order("created_at", { ascending: false })
        .limit(1)
        .maybeSingle();

      if (checkError) {
        setDebug({ step: "save_verification_check_error", error: checkError });
        throw checkError;
      }

      if (existing?.id) {
        const { error: updateError } = await sb
          .from(VERIFICATION_TABLE)
          .update(payload)
          .eq("id", existing.id);

        if (updateError) {
          setDebug({ step: "save_verification_update_error", error: updateError });
          throw updateError;
        }

        setDebug({ step: "save_verification_updated", id: existing.id });
        return;
      }

      const { error: insertError } = await sb
        .from(VERIFICATION_TABLE)
        .insert(payload);

      if (insertError) {
        setDebug({ step: "save_verification_insert_error", error: insertError });
        throw insertError;
      }

      setDebug({ step: "save_verification_inserted" });
    }

    async function saveToStudentAccount(){
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      const payload = {
        user_id: currentUser.id,
        full_name: extracted?.full_name || null,
        school_name: extracted?.school_name || null,
        department: extracted?.department || null,
        programme: extracted?.programme || null,
        matric_number: extracted?.matric_no || extracted?.matric || null
      };

      setDebug({
        step: "save_student_account",
        table: ACCOUNT_TABLE,
        payload
      });

      const { error } = await sb
        .from(ACCOUNT_TABLE)
        .upsert(payload, { onConflict: "user_id" });

      if (error) {
        setDebug({ step: "save_student_account_error", error });
        throw error;
      }

      setDebug({ step: "save_student_account_done" });
    }

    window.addEventListener("load", async () => {
      try {
        resetAll();
        currentUser = await getUser();
        setDebug({
          step: "user_loaded",
          user_id: currentUser.id,
          bucket: BUCKET,
          extract_url: EXTRACT_FN_URL
        });
      } catch (e) {
        showErr("You need to be signed in to continue.");
        setDebug({
          step: "user_error",
          error: e?.message || String(e)
        });
      }
    });

    el("fileInput").addEventListener("change", (e) => {
      clearMsgs();
      clearDebug();

      const file = e.target.files && e.target.files[0] ? e.target.files[0] : null;
      if (!file) return;

      const isPdf = (file.type || "").includes("pdf");
      const isImg = (file.type || "").startsWith("image/");
      if (!isPdf && !isImg) {
        resetAll();
        showErr("Please upload an image (JPG/PNG) or PDF only.");
        return;
      }

      const maxMb = 8;
      if (file.size > maxMb * 1024 * 1024) {
        resetAll();
        showErr(`File too large. Max is ${maxMb}MB.`);
        return;
      }

      pickedFile = file;
      renderPreview(file);
      el("btnExtract").disabled = false;
      el("btnReset").style.display = "inline-flex";
      el("details").style.display = "none";
      extracted = null;
      uploadedPath = null;

      setDebug({
        step: "file_selected",
        file_name: file.name,
        file_type: file.type,
        file_size: file.size
      });
    });

    el("btnReset").addEventListener("click", () => {
      resetAll();
    });

    el("btnExtract").addEventListener("click", async () => {
      clearMsgs();

      if (!pickedFile) {
        showErr("Pick a file first.");
        return;
      }

      try {
        setLoading(true);

        uploadedPath = await uploadToStorage(pickedFile);
        const data = await callExtractFunction(uploadedPath, pickedFile);

        if (!data || data.ok !== true) {
          throw new Error("AI extraction failed. Please try again.");
        }

        const result = data.extracted_result || null;

        if (!result) {
          throw new Error("No details found. Upload a clearer file.");
        }

        if (result.is_clearance_form === false) {
          extracted = null;
          el("details").style.display = "none";
          showErr(result.reason || "This does not look like a clearance form. Please upload the correct document.");
          return;
        }

        extracted = result.extracted || null;

        if (!extracted) {
          throw new Error(result.reason || "No details found. Upload a clearer file.");
        }

        paintExtracted(extracted);
        el("details").style.display = "block";
        showOk("Details extracted. Please confirm and continue.");
      } catch (e) {
        showErr(e && e.message ? e.message : "Something went wrong.");
      } finally {
        setLoading(false);
      }
    });

    el("btnContinue").addEventListener("click", async () => {
      clearMsgs();

      if (!extracted || !uploadedPath) {
        showErr("Please extract details first.");
        return;
      }

      try {
        setLoading(true);

        await saveToVerificationTable();
        await saveToStudentAccount();

        showOk("Verification successful. Your details have been saved.");
        // window.location.href = "account.html";
      } catch (e) {
        showErr(e && e.message ? e.message : "Failed to save.");
      } finally {
        setLoading(false);
      }
    });
  </script>
</body>
</html>
