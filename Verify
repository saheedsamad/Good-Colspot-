      }

      if (continueBtn) {
        continueBtn.textContent =
          `Locked for ${academicUpdateBlockInfo.daysLeft} day${academicUpdateBlockInfo.daysLeft > 1 ? "s" : ""}`;
        continueBtn.disabled = true;
