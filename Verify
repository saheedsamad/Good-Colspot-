    function bytesToSize(bytes) {
      const sizes = ["Bytes", "KB", "MB", "GB"];
      if (!bytes && bytes !== 0) return "—";
      if (bytes === 0) return "0 Bytes";
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(1) + " " + sizes[i];
    }

    function normalizeText(value) {
      return String(value || "").replace(/\s+/g, " ").trim();
    }

    function normalizeUpper(value) {
      return String(value || "").replace(/\s+/g, " ").trim().toUpperCase();
    }

    function normalizeLevel(value) {
      const raw = normalizeText(value).toUpperCase();
      if (!raw) return "";
      const match = raw.match(/\d{3}/);
      if (match) return match[0] + " LEVEL";
      return raw;
    }

    function normalizeSemester(value) {
      const raw = normalizeText(value).toLowerCase();
      if (!raw) return "";
      if (raw.includes("1") || raw.includes("first")) return "1st semester";
      if (raw.includes("2") || raw.includes("second")) return "2nd semester";
      if (raw.includes("3") || raw.includes("third")) return "3rd semester";
      return raw;
    }

    function getAccountSessionValue(account) {
      return normalizeText(
        account?.academic_session ||
        account?.session ||
        account?.school_session ||
        ""
      );
    }

    async function getUser() {
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not loaded.");

      const { data, error } = await sb.auth.getUser();
      if (error) throw error;

      if (data && data.user) {
        saveLocalUser(data.user);
        return data.user;
      }

      try {
        const cached = JSON.parse(localStorage.getItem("colspot_local_user") || "null");
        if (cached && (cached.user_id || cached.id)) {
          return {
            id: cached.user_id || cached.id,
            email: cached.email || null
          };
        }
      } catch {}

      throw new Error("Not signed in.");
    }

    async function ensureCurrentUser() {
      if (!currentUser || !currentUser.id) {
        currentUser = await getUser();
      }

      if (!currentUser || !currentUser.id) {
        throw new Error("Could not find your account. Please sign in again.");
      }

      saveLocalUser(currentUser);
      return currentUser;
