    const session = getAccountSessionValue(data);
    const semester = normalizeSemester(data.semester);

    if (safeEl("aFullName")) safeEl("aFullName").textContent = fullName || "—";
    if (safeEl("aMatric")) safeEl("aMatric").textContent = matric || "—";
    if (safeEl("aSchool")) safeEl("aSchool").textContent = school || "—";
    if (safeEl("aDepartment")) safeEl("aDepartment").textContent = department || "—";
    if (safeEl("aProgramme")) safeEl("aProgramme").textContent = programme || "—";

    setSelectValue("aLevel", level || "");
    setSelectValue("aSession", session || "");
    setSelectValue("aSemester", semester || "");

    const blockInfo = getAcademicUpdateBlockInfo(data.academic_details_last_updated_at);
    applyAcademicUpdateBlock(blockInfo);

    if (blockInfo.blocked) return;

    if (!fullName || !matric || !school) {
      showAcademicWarn("Some locked profile details are missing. Please complete normal verification first if this page does not work.");
    }
  }

  async function createPendingAcademicUpdate() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    if (!currentStudentAccount) {
      throw new Error("Student account not loaded. Please refresh and try again.");
    }

    const freshBlockInfo = getAcademicUpdateBlockInfo(currentStudentAccount.academic_details_last_updated_at);

    if (freshBlockInfo.blocked) {
      applyAcademicUpdateBlock(freshBlockInfo);
      throw new Error(
        `You can update your academic details again in ${freshBlockInfo.daysLeft} day${freshBlockInfo.daysLeft > 1 ? "s" : ""}.`
      );
    }

    const newLevel = normalizeLevel(safeEl("aLevel")?.value);
    const newSession = normalizeText(safeEl("aSession")?.value);
    const newSemester = normalizeSemester(safeEl("aSemester")?.value);

    if (!newLevel) throw new Error("Please select your new level.");
    if (!newSession) throw new Error("Please select your new academic session.");
    if (!newSemester) throw new Error("Please select your new semester.");

    const oldLevel = normalizeLevel(currentStudentAccount.level);
    const oldSession = getAccountSessionValue(currentStudentAccount);
    const oldSemester = normalizeSemester(currentStudentAccount.semester);

    const noChange =
      oldLevel === newLevel &&
      oldSession === newSession &&
      oldSemester === newSemester;

    if (noChange) {
      throw new Error("You selected the same academic details already on your profile.");
    }

    await sb
      .from(ACADEMIC_UPDATE_TABLE)
      .update({
        status: "cancelled",
        cancelled_at: new Date().toISOString()
      })
      .eq("user_id", currentUser.id)
      .eq("status", "pending_face");

    const insertPayload = {
      user_id: currentUser.id,
      old_level: oldLevel || null,
      old_session: oldSession || null,
      old_semester: oldSemester || null,
      new_level: newLevel,
      new_session: newSession,
      new_semester: newSemester,
      status: "pending_face"
    };

    const { data, error } = await sb
      .from(ACADEMIC_UPDATE_TABLE)
      .insert(insertPayload)
      .select("id, user_id, new_level, new_session, new_semester, status")
      .single();

    if (error) throw error;

    const pending = {
      request_id: data.id,
      user_id: currentUser.id,
      mode: "academic_update",
      new_level: newLevel,
      new_session: newSession,
      new_semester: newSemester,
      created_at: new Date().toISOString()
    };

    localStorage.setItem(ACADEMIC_UPDATE_PENDING_KEY, JSON.stringify(pending));
    localStorage.setItem("colspot_face_step_ready", "true");
    localStorage.removeItem("colspot_face_enrolled");

    return pending;
  }

  async function handleAcademicContinue() {
    clearAcademicMsgs();

    if (academicUpdateBlocked) {
      const info = academicUpdateBlockInfo || { daysLeft: 60 };

      showAcademicErr(
        `You can update your academic details again in ${info.daysLeft || 60} day${Number(info.daysLeft || 60) > 1 ? "s" : ""}.`
      );

      return;
    }

    setAcademicLoading(true);

    try {
      const pending = await createPendingAcademicUpdate();

      showAcademicOk("Academic update saved as pending. Continue to face capture to complete it.");

      setTimeout(() => {
        window.location.href =
          FACE_CAPTURE_URL +
          "?mode=academic_update" +
          "&requestId=" +
          encodeURIComponent(pending.request_id);
      }, 700);
    } catch (e) {
      console.error(e);

      if (isSessionMissingError(e)) {
        redirectToIndex("Your session has expired. Redirecting to sign in...");
        return;
      }

      showAcademicErr(e?.message || "Could not start academic update. Please try again.");
    } finally {
      setAcademicLoading(false);
    }
  }

  function setupAcademicUpdateModeUi() {
    if (!IS_ACADEMIC_UPDATE) return;

    if (safeEl("brandTitle")) safeEl("brandTitle").textContent = "Academic update";
    if (safeEl("brandSub")) safeEl("brandSub").textContent = "Update level, session and semester";
    if (safeEl("heroTitle")) safeEl("heroTitle").textContent = "Update academic details";

    if (safeEl("heroSub")) {
      safeEl("heroSub").textContent =
        "Your identity details remain locked. Select only your new level, academic session and semester, then retake face capture.";
    }

    if (safeEl("modePill")) safeEl("modePill").classList.remove("hidden");

    if (safeEl("normalVerifyCard")) safeEl("normalVerifyCard").classList.add("hidden");
    if (safeEl("academicUpdateCard")) safeEl("academicUpdateCard").classList.remove("hidden");
  }

  async function initAcademicUpdatePage() {
    setupAcademicUpdateModeUi();
    clearAcademicMsgs();
    setAcademicLoading(true);

    try {
      currentUser = await getUser();
      saveLocalUser(currentUser);

      if (!currentUser || !currentUser.id) {
        throw new Error("Auth session missing!");
      }

      await loadStudentAccountForAcademicUpdate();
    } catch (e) {
      console.error("academic update init failed:", e);

      if (isSessionMissingError(e)) {
        showAcademicErr("Your session has expired. Redirecting to sign in...");
        redirectToIndex("Your session has expired. Redirecting to sign in...");
        return;
      }

      showAcademicErr(e?.message || "Could not load academic update page.");
    } finally {
      setAcademicLoading(false);
    }
  }

  async function initVerificationPage() {
    try {
      if (window.ColspotGuard && typeof window.ColspotGuard.guardRolePageAccess === "function") {
        try {
          await window.ColspotGuard.guardRolePageAccess({
            requiredRole: "student",
            redirectTo: INDEX_URL,
            studentHome: MAIN_URL,
            lecturerHome: "main_lecturer.html"
          });
        } catch (e) {
          console.warn("Guard warning:", e);
        }
      }

      resetAll();
      await loadDropdownOptions();

      currentUser = await getUser();

      if (!currentUser || !currentUser.id) {
        throw new Error("Auth session missing!");
      }

      saveLocalUser(currentUser);

      if (IS_ACADEMIC_UPDATE) {
        await initAcademicUpdatePage();
        return;
      }

      await checkExistingSuccessfulVerification();
    } catch (e) {
      console.error("verify_class init failed:", e);

      if (safeEl("btnExtract")) safeEl("btnExtract").disabled = true;

      if (isSessionMissingError(e)) {
        redirectToIndex("You need to be signed in to continue. Redirecting...");
        return;
      }

      showErr(e?.message || "Something went wrong. Redirecting...");
      setTimeout(() => {
        window.location.href = INDEX_URL;
      }, 1000);
    }
  }

  window.addEventListener("load", initVerificationPage);

  if (safeEl("backBtn")) {
    safeEl("backBtn").addEventListener("click", (event) => {
      event.preventDefault();

      if (IS_ACADEMIC_UPDATE) {
        window.location.href = MAIN_URL;
        return;
      }

      window.history.back();
    });
  }

  if (safeEl("btnAcademicContinue")) {
    safeEl("btnAcademicContinue").addEventListener("click", handleAcademicContinue);
  }

  if (safeEl("btnAcademicCancel")) {
    safeEl("btnAcademicCancel").addEventListener("click", () => {
      window.location.href = MAIN_URL;
    });
  }

  if (safeEl("fileInput")) {
    safeEl("fileInput").addEventListener("change", (e) => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      const file = e.target.files && e.target.files[0] ? e.target.files[0] : null;
      if (!file) return;

      const isPdf = (file.type || "") === "application/pdf";
      if (!isPdf) {
        resetAll();
        showErr("Please upload PDF only.");
        return;
      }

      const maxMb = 8;
      if (file.size > maxMb * 1024 * 1024) {
        resetAll();
        showErr(`File too large. Max is ${maxMb}MB.`);
        return;
      }

      pickedFile = file;
      renderPreview(file);

      if (safeEl("btnExtract")) safeEl("btnExtract").disabled = false;
      if (safeEl("btnReset")) safeEl("btnReset").style.display = "inline-flex";

      clearExtractedDetails();
    });
  }

  if (safeEl("btnReset")) {
    safeEl("btnReset").addEventListener("click", () => {
      if (verificationLocked) return;
      resetAll();
    });
  }

  if (safeEl("btnCancel")) {
    safeEl("btnCancel").addEventListener("click", () => {
      if (verificationLocked) return;

      clearMsgs();
      clearExtractedDetails();
      showErr("Verification cancelled. Upload another course form PDF if you want to try again.");
    });
  }

  if (safeEl("btnExtract")) {
    safeEl("btnExtract").addEventListener("click", async () => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      if (!pickedFile) {
        showErr("Pick a file first.");
        return;
      }

      try {
        setLoading(true);

        await ensureCurrentUser();

        uploadedPath = await uploadToStorage(pickedFile);
        const data = await callExtractFunction(uploadedPath, pickedFile);

        extracted = extractDetailsLikeVerify32(data);

        if (extracted.school_name) {
          extracted.school_name = normalizeUpper(extracted.school_name);
        }

        if (extracted.matric || extracted.matric_no) {
          extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
        }

        if (extracted.level) {
          extracted.level = normalizeLevel(extracted.level);
        }

        if (extracted.semester) {
          extracted.semester = normalizeSemester(extracted.semester);
        }

        paintExtracted(extracted);

        if (safeEl("details")) safeEl("details").style.display = "block";

        showOk("Verification details are ready. Please review them and continue.");
      } catch (e) {
        console.error(e);

        if (isSessionMissingError(e)) {
          redirectToIndex("Your session has expired. Redirecting to sign in...");
          return;
        }

        showErr(e?.message || "Something went wrong.");
      } finally {
        setLoading(false);
      }
    });
  }

  if (safeEl("btnContinue")) {
    safeEl("btnContinue").addEventListener("click", async () => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      if (!extracted || !uploadedPath) {
        showErr("Please verify the course form first.");
        return;
      }

      if (!validateSelections()) {
        return;
      }

      try {
        setLoading(true);

        await ensureCurrentUser();

        const duplicate = await checkDuplicateMatricInVerificationCourseForms();
        if (duplicate) {
          throw new Error("This matric number is already linked to another Colspot account in this school.");
        }

        await saveToVerificationTable();
        await saveToStudentAccount();

        lockVerificationUi();

        try {
          localStorage.setItem("colspot_face_step_ready", "true");
          localStorage.setItem("colspot_verification_done", "true");
          saveLocalUser(currentUser);
        } catch {}

        showOk("Verification successful. Redirecting to face capture...");

        setTimeout(() => {
          window.location.href = FACE_CAPTURE_URL;
        }, 700);
      } catch (e) {
        console.error(e);

        if (isSessionMissingError(e)) {
          redirectToIndex("Your session has expired. Redirecting to sign in...");
          return;
        }

        showErr(e?.message || "Failed to save.");
      } finally {
        setLoading(false);
      }
    });
  }
</script>
