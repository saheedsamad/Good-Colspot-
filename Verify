  function getAcademicUpdateBlockInfo(lastUpdatedAt) {
    if (!lastUpdatedAt) {
      return {
        blocked: false,
        daysLeft: 0,
        nextDateText: ""
      };
    }

    const lastDate = new Date(lastUpdatedAt);

    if (Number.isNaN(lastDate.getTime())) {
      return {
        blocked: false,
        daysLeft: 0,
        nextDateText: ""
      };
    }

    const now = new Date();
    const blockMs = ACADEMIC_UPDATE_BLOCK_DAYS * 24 * 60 * 60 * 1000;
    const diffMs = now.getTime() - lastDate.getTime();

    if (diffMs >= blockMs) {
      return {
        blocked: false,
        daysLeft: 0,
        nextDateText: ""
      };
    }

    const daysLeft = Math.max(1, Math.ceil((blockMs - diffMs) / (24 * 60 * 60 * 1000)));
    const nextDate = new Date(lastDate.getTime() + blockMs);

    const nextDateText = nextDate.toLocaleDateString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric"
    });

    return {
      blocked: true,
      daysLeft,
      nextDateText
    };
  }

