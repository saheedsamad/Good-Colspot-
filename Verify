<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Verification</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --blue-soft:#eef4ff;
      --bg:#f4f7ff;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#6b7280;
      --line:#e5e7eb;
      --danger:#ef4444;
      --ok:#16a34a;
      --warn:#d97706;
      --shadow:0 14px 32px rgba(15,23,42,.10);
      --shadow-soft:0 10px 24px rgba(37,99,235,.10);
      --radius:24px;
      --radius-sm:18px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      background:
        radial-gradient(circle at top, #dfeeff 0%, #f7faff 42%, #ffffff 100%);
      color:var(--text);
      min-height:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    .phone-shell{
      width:100%;
      max-width:460px;
      min-height:100vh;
      padding:18px 14px 28px;
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 2px 14px;
    }

    .back-btn{
      width:44px;
      height:44px;
      border-radius:16px;
      border:1px solid var(--line);
      background:#fff;
      display:grid;
      place-items:center;
      cursor:pointer;
      box-shadow:0 8px 20px rgba(15,23,42,.06);
      flex-shrink:0;
    }

    .back-btn svg{
      width:18px;
      height:18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      flex:1;
      min-width:0;
    }

    .brand-logo{
      width:38px;
      height:38px;
      border-radius:14px;
      overflow:hidden;
      background:#fff;
      border:1px solid var(--line);
      flex-shrink:0;
      box-shadow:var(--shadow-soft);
    }

    .brand-logo img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .brand-title{
      font-weight:900;
      letter-spacing:-.02em;
      font-size:17px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      color:#10224a;
    }

    .brand-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:2px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .hero{
      background:
        linear-gradient(180deg, rgba(37,99,235,.11), rgba(37,99,235,.04));
      border:1px solid rgba(37,99,235,.12);
      border-radius:var(--radius);
      padding:18px 16px;
      box-shadow:var(--shadow);
      position:relative;
      overflow:hidden;
    }

    .hero::after{
      content:"";
      position:absolute;
      right:-20px;
      top:-18px;
      width:110px;
      height:110px;
      border-radius:50%;
      background:rgba(37,99,235,.08);
    }

    .hero h1{
      margin:0 0 7px;
      font-size:22px;
      line-height:1.15;
      letter-spacing:-.03em;
      position:relative;
      z-index:1;
    }

    .hero p{
      margin:0;
      font-size:13px;
      color:var(--muted);
      line-height:1.55;
      position:relative;
      z-index:1;
      max-width:320px;
    }

    .card{
      margin-top:14px;
      background:var(--card);
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .card-head{
      padding:16px 16px 12px;
      border-bottom:1px solid var(--line);
    }

    .card-head .title{
      font-weight:900;
      font-size:15px;
      margin:0;
      letter-spacing:-.02em;
    }

    .card-head .sub{
      margin:6px 0 0;
      font-size:12px;
      color:var(--muted);
      line-height:1.5;
    }

    .card-body{
      padding:14px;
    }

    .upload-box{
      border:1.6px dashed #cbd5e1;
      border-radius:20px;
      padding:14px;
      background:#fbfdff;
    }

    .upload-row{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }

    .file-btn{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:12px 15px;
      border-radius:16px;
      border:1px solid var(--line);
      background:#fff;
      cursor:pointer;
      font-weight:800;
      font-size:13px;
      box-shadow:0 8px 18px rgba(15,23,42,.04);
    }

    .file-btn svg{
      width:18px;
      height:18px;
      color:var(--blue);
    }

    #fileInput{
      display:none;
    }

    .hint{
      margin-top:10px;
      font-size:12px;
      color:var(--muted);
      line-height:1.5;
    }

    .preview{
      margin-top:14px;
      display:none;
      gap:12px;
      align-items:center;
      padding:12px;
      border-radius:18px;
      border:1px solid var(--line);
      background:#fff;
    }

    .thumb{
      width:58px;
      height:58px;
      border-radius:16px;
      border:1px solid var(--line);
      background:#f8fbff;
      overflow:hidden;
      display:grid;
      place-items:center;
      flex-shrink:0;
    }

    .thumb .pdf{
      font-weight:900;
      color:var(--blue);
      font-size:12px;
      letter-spacing:.08em;
    }

    .file-meta{
      flex:1;
      min-width:0;
    }

    .file-meta .name{
      font-weight:900;
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      color:#0f172a;
    }

    .file-meta .size{
      font-size:12px;
      color:var(--muted);
      margin-top:3px;
    }

    .btn{
      width:100%;
      border:none;
      border-radius:18px;
      padding:14px 14px;
      cursor:pointer;
      font-weight:900;
      font-size:15px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      transition:.18s ease;
    }

    .btn-primary{
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      margin-top:12px;
      box-shadow:0 14px 26px rgba(37,99,235,.18);
    }

    .btn-primary:disabled{
      opacity:.55;
      cursor:not-allowed;
      box-shadow:none;
    }

    .btn-ghost{
      background:#fff;
      color:var(--text);
      border:1px solid var(--line);
      margin-top:10px;
    }

    .btn-row{
      display:flex;
      gap:10px;
      margin-top:14px;
      flex-wrap:wrap;
    }

    .btn-half{
      flex:1;
      min-width:140px;
    }

    .loading{
      display:none;
      margin-top:12px;
      padding:13px 14px;
      border-radius:18px;
      border:1px solid rgba(37,99,235,.18);
      background:rgba(37,99,235,.06);
      color:#1e40af;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .spinner{
      width:16px;
      height:16px;
      border-radius:999px;
      border:2px solid rgba(30,64,175,.25);
      border-top-color:#1e40af;
      display:inline-block;
      animation:spin .9s linear infinite;
      vertical-align:-3px;
      margin-right:8px;
    }

    @keyframes spin{
      to{ transform:rotate(360deg) }
    }

    .msg{
      display:none;
      margin-top:12px;
      padding:12px 12px;
      border-radius:18px;
      font-size:13px;
      line-height:1.5;
      border:1px solid var(--line);
      background:#fff;
      white-space:pre-wrap;
      word-break:break-word;
    }

    .msg.err{
      border-color:rgba(239,68,68,.22);
      background:rgba(239,68,68,.08);
      color:#7f1d1d;
    }

    .msg.ok{
      border-color:rgba(22,163,74,.22);
      background:rgba(22,163,74,.08);
      color:#14532d;
    }

    .msg.warn{
      display:block;
      border-color:rgba(217,119,6,.22);
      background:rgba(217,119,6,.08);
      color:#92400e;
    }

    .details{
      margin-top:14px;
      display:none;
      border-top:1px solid var(--line);
      padding-top:14px;
    }

    .status-card{
      margin-bottom:12px;
      border:1px solid rgba(22,163,74,.18);
      background:rgba(22,163,74,.07);
      color:#166534;
      border-radius:18px;
      padding:12px 13px;
      font-size:13px;
      line-height:1.5;
      font-weight:700;
    }

    .grid{
      display:grid;
      grid-template-columns:1fr;
      gap:10px;
    }

    .field{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px 13px;
      background:#fff;
      box-shadow:0 6px 18px rgba(15,23,42,.03);
    }

    .label{
      font-size:11px;
      color:var(--muted);
      margin-bottom:5px;
      text-transform:uppercase;
      letter-spacing:.06em;
      font-weight:800;
    }

    .value{
      font-weight:900;
      font-size:14px;
      word-break:break-word;
      color:#0f172a;
      line-height:1.35;
    }

    .footer-note{
      margin-top:14px;
      font-size:12px;
      color:var(--muted);
      line-height:1.5;
      text-align:center;
      padding:0 8px;
    }

    @media (max-width:360px){
      .btn-row{
        flex-direction:column;
      }
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <div class="topbar">
      <button class="back-btn" onclick="history.back()">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot" />
        </div>
        <div style="min-width:0">
          <div class="brand-title">Verification</div>
          <div class="brand-sub">Upload course form PDF to verify your profile</div>
        </div>
      </div>
    </div>

    <section class="hero">
      <h1>Verify your student profile</h1>
      <p>
        Upload your course form PDF for verification. We will review the file, show your details to you, then you can continue or cancel.
      </p>
    </section>

    <section class="card">
      <div class="card-head">
        <p class="title">Step 1 • Upload course form PDF</p>
        <p class="sub">Upload a clear course form PDF only. Make sure the text is readable before you continue.</p>
      </div>

      <div class="card-body">
        <div class="upload-box">
          <div class="upload-row">
            <label class="file-btn" for="fileInput" id="fileBtn">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M7 9l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 20h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Choose file
            </label>
            <input id="fileInput" type="file" accept="application/pdf" />
          </div>

          <div class="hint">
            Accepted: PDF only. Upload your official course form so we can verify your profile details.
          </div>

          <div id="preview" class="preview">
            <div class="thumb" id="thumb"></div>
            <div class="file-meta">
              <div class="name" id="fileName">—</div>
              <div class="size" id="fileSize">—</div>
            </div>
          </div>

          <div id="loading" class="loading">
            <span class="spinner"></span>
            Verifying your course form… please wait.
          </div>

          <div id="msgErr" class="msg err"></div>
          <div id="msgOk" class="msg ok"></div>
          <div id="msgWarn" class="msg"></div>

          <button id="btnExtract" class="btn btn-primary" disabled>
            Verify details
          </button>

          <button id="btnReset" class="btn btn-ghost" style="display:none;">
            Upload another file
          </button>

          <div id="details" class="details">
            <div class="status-card">
              Your course form has been checked. Please review the verified details carefully before you continue.
            </div>

            <div class="grid">
              <div class="field"><div class="label">Full name</div><div class="value" id="vFullName">—</div></div>
              <div class="field"><div class="label">Matric / Staff ID</div><div class="value" id="vMatric">—</div></div>
              <div class="field"><div class="label">School name</div><div class="value" id="vSchool">—</div></div>
              <div class="field"><div class="label">Department</div><div class="value" id="vDept">—</div></div>
              <div class="field"><div class="label">Programme</div><div class="value" id="vProgramme">—</div></div>
              <div class="field"><div class="label">Faculty</div><div class="value" id="vFaculty">—</div></div>
              <div class="field"><div class="label">Level</div><div class="value" id="vLevel">—</div></div>
              <div class="field"><div class="label">Session</div><div class="value" id="vSession">—</div></div>
              <div class="field"><div class="label">Semester</div><div class="value" id="vSemester">—</div></div>
            </div>

            <div class="btn-row">
              <button id="btnContinue" class="btn btn-primary btn-half" type="button">
                Continue
              </button>

              <button id="btnCancel" class="btn btn-ghost btn-half" type="button">
                Cancel
              </button>
            </div>

            <div class="footer-note">
              Review the verified details carefully before you continue.
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="footer-note">
      Colspot will only use this file for verification. You can delete your account anytime.
    </div>
  </div>

  <script type="module" src="./client_supabase.js"></script>
  <script src="./guard_session.js"></script>

<script>
  const BUCKET = "verification_uploads";
  const EXTRACT_FN_URL = "https://wtlrfujfimxcmsnqrnig.functions.supabase.co/extract-clearance";
  const VERIFICATION_TABLE = "verification_clearance";
  const DUPLICATE_CHECK_TABLE = "verification_course_forms";
  const ACCOUNT_TABLE = "student_accounts";
  const FACE_TABLE = "face_profiles";
  const FACE_CAPTURE_URL = "face-capture.html";
  const MAIN_URL = "main.html";
  const DEBUG_MODE = false;

  const el = (id) => document.getElementById(id);

  function showErr(msg){
    el("msgWarn").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgErr").style.display = "block";
    el("msgErr").textContent = msg;
  }

  function showOk(msg){
    el("msgWarn").style.display = "none";
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "block";
    el("msgOk").textContent = msg;
  }

  function showWarn(msg){
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgWarn").style.display = "block";
    el("msgWarn").className = "msg warn";
    el("msgWarn").textContent = msg;
  }

  function clearMsgs(){
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgWarn").style.display = "none";
    el("msgErr").textContent = "";
    el("msgOk").textContent = "";
    el("msgWarn").textContent = "";
    el("msgWarn").className = "msg";
  }

  function setLoading(on){
    el("loading").style.display = on ? "block" : "none";
    el("btnExtract").disabled = on || !pickedFile || verificationLocked;
    if (el("btnContinue")) el("btnContinue").disabled = on || verificationLocked;
    if (el("btnCancel")) el("btnCancel").disabled = on || verificationLocked;
    el("btnReset").disabled = on || verificationLocked;
    el("fileInput").disabled = on || verificationLocked;
  }

  function bytesToSize(bytes){
    const sizes = ["Bytes","KB","MB","GB"];
    if (!bytes && bytes !== 0) return "—";
    if (bytes === 0) return "0 Bytes";
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(1) + " " + sizes[i];
  }

  function setDebug(){}
  function clearDebug(){}

  function normalizeText(value){
    return String(value || "").trim();
  }

  function normalizeUpper(value){
    return String(value || "").trim().toUpperCase();
  }

  let pickedFile = null;
  let uploadedPath = null;
  let extracted = null;
  let currentUser = null;
  let verificationLocked = false;

  async function getUser(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not loaded. Check client_supabase.js");

    const { data, error } = await sb.auth.getUser();
    if (error) throw error;
    if (data && data.user) return data.user;

    try {
      const cached = JSON.parse(localStorage.getItem("colspot_local_user") || "null");
      if (cached && (cached.user_id || cached.id)) {
        return {
          id: cached.user_id || cached.id,
          email: cached.email || null
        };
      }
    } catch {}

    throw new Error("Not signed in.");
  }

  async function ensureCurrentUser(){
    if (!currentUser || !currentUser.id) {
      currentUser = await getUser();
    }

    if (!currentUser || !currentUser.id) {
      throw new Error("Could not find your account. Please sign in again.");
    }

    return currentUser;
  }

  function renderPreview(file){
    el("preview").style.display = "flex";
    el("fileName").textContent = file.name || "Selected file";
    el("fileSize").textContent = bytesToSize(file.size);

    const thumb = el("thumb");
    thumb.innerHTML = "";

    const div = document.createElement("div");
    div.className = "pdf";
    div.textContent = "PDF";
    thumb.appendChild(div);
  }

  function paintExtracted(details){
    el("vFullName").textContent = details?.full_name || "—";
    el("vMatric").textContent = details?.matric_no || details?.matric || "—";
    el("vSchool").textContent = normalizeUpper(details?.school_name) || "—";
    el("vDept").textContent = details?.department || "—";
    el("vProgramme").textContent = details?.programme || "—";
    el("vFaculty").textContent = details?.faculty || "—";
    el("vLevel").textContent = details?.level || "—";
    el("vSession").textContent = details?.session || "—";
    el("vSemester").textContent = details?.semester || "—";
  }

  function clearExtractedDetails(){
    extracted = null;
    uploadedPath = null;
    el("details").style.display = "none";
    el("vFullName").textContent = "—";
    el("vMatric").textContent = "—";
    el("vSchool").textContent = "—";
    el("vDept").textContent = "—";
    el("vProgramme").textContent = "—";
    el("vFaculty").textContent = "—";
    el("vLevel").textContent = "—";
    el("vSession").textContent = "—";
    el("vSemester").textContent = "—";
  }

  function lockVerificationUi(){
    verificationLocked = true;
    el("fileInput").disabled = true;
    el("btnExtract").disabled = true;
    el("btnReset").disabled = true;
    el("btnContinue").disabled = true;
    el("btnCancel").disabled = true;
    const fileBtn = el("fileBtn");
    fileBtn.style.pointerEvents = "none";
    fileBtn.style.opacity = ".55";
  }

  function resetAll(){
    pickedFile = null;
    uploadedPath = null;
    extracted = null;
    verificationLocked = false;

    el("fileInput").value = "";
    el("fileInput").disabled = false;
    el("preview").style.display = "none";
    el("btnExtract").disabled = true;
    el("btnReset").style.display = "inline-flex";
    el("btnReset").disabled = false;
    if (el("btnContinue")) el("btnContinue").disabled = false;
    if (el("btnCancel")) el("btnCancel").disabled = false;
    el("details").style.display = "none";
    clearMsgs();
    clearDebug();
    setLoading(false);

    const fileBtn = el("fileBtn");
    fileBtn.style.pointerEvents = "auto";
    fileBtn.style.opacity = "1";

    clearExtractedDetails();
  }

  async function uploadToStorage(file){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const name = "course_form_" + Date.now() + "_" + Math.random().toString(16).slice(2) + ".pdf";
    const path = `${currentUser.id}/${name}`;

    const { error } = await sb.storage
      .from(BUCKET)
      .upload(path, file, {
        cacheControl: "3600",
        upsert: false,
        contentType: "application/pdf",
      });

    if (error) throw error;
    return path;
  }

  async function callExtractFunction(storagePath, file){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    const { data: sessData, error: sessErr } = await sb.auth.getSession();
    if (sessErr) throw sessErr;

    const accessToken = sessData?.session?.access_token || "";
    if (!accessToken) throw new Error("Missing authorization header. Please sign in again.");

    const payload = {
      bucket: BUCKET,
      path: storagePath,
      mime_type: "application/pdf",
      file_size: file.size || null
    };

    const resp = await fetch(EXTRACT_FN_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${accessToken}`,
        "x-debug": "1"
      },
      body: JSON.stringify(payload),
    });

    let data = null;
    try {
      data = await resp.json();
    } catch {
      data = null;
    }

    if (!resp.ok) {
      const msg =
        (data && (data.error || data.message || data.details)) ||
        `Verification failed (${resp.status})`;
      throw new Error(msg);
    }

    return data;
  }

  function buildNormalizedExtracted(){
    return {
      full_name: normalizeText(extracted?.full_name),
      matric_no: normalizeText(extracted?.matric_no || extracted?.matric),
      school_name: normalizeUpper(extracted?.school_name),
      department: normalizeText(extracted?.department),
      programme: normalizeText(extracted?.programme),
      faculty: normalizeText(extracted?.faculty),
      level: normalizeText(extracted?.level),
      session: normalizeText(extracted?.session),
      semester: normalizeText(extracted?.semester)
    };
  }

  async function saveToVerificationTable(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    const payload = {
      user_id: currentUser.id,
      file_bucket: BUCKET,
      file_path: uploadedPath,
      full_name: normalized.full_name || null,
      matric_no: normalized.matric_no || null,
      school_name: normalized.school_name || null,
      department: normalized.department || null,
      programme: normalized.programme || null,
      faculty: normalized.faculty || null,
      level: normalized.level || null,
      session: normalized.session || null,
      semester: normalized.semester || null,
      extracted_json: {
        ...(extracted || {}),
        school_name: normalized.school_name || null,
        matric_no: normalized.matric_no || null
      },
      status: "successful"
    };

    const { data: existing, error: checkError } = await sb
      .from(VERIFICATION_TABLE)
      .select("id, status")
      .eq("user_id", currentUser.id)
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (checkError) throw checkError;

    if (existing?.id) {
      const { error: updateError } = await sb
        .from(VERIFICATION_TABLE)
        .update(payload)
        .eq("id", existing.id);

      if (updateError) throw updateError;
      return;
    }

    const { error: insertError } = await sb
      .from(VERIFICATION_TABLE)
      .insert(payload);

    if (insertError) throw insertError;
  }

  async function saveToStudentAccount(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    const payload = {
      user_id: currentUser.id,
      full_name: normalized.full_name || null,
      school_name: normalized.school_name || null,
      department: normalized.department || null,
      programme: normalized.programme || null,
      matric_number: normalized.matric_no || null,
      level: normalized.level || null
    };

    const { error } = await sb
      .from(ACCOUNT_TABLE)
      .upsert(payload, { onConflict: "user_id" });

    if (error) throw error;
  }

  async function checkDuplicateMatricInVerificationCourseForms(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    if (!normalized.school_name) {
      throw new Error("School name is missing from the verified course form.");
    }

    if (!normalized.matric_no) {
      throw new Error("Matric number is missing from the verified course form.");
    }

    const { data, error } = await sb
      .from(DUPLICATE_CHECK_TABLE)
      .select("user_id, school_name, matric_no")
      .eq("school_name", normalized.school_name)
      .eq("matric_no", normalized.matric_no)
      .neq("user_id", currentUser.id)
      .limit(1)
      .maybeSingle();

    if (error) throw error;
    return !!data;
  }

  async function hasVerifiedFaceAlready(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const { data, error } = await sb
      .from(FACE_TABLE)
      .select("user_id, face_verified, capture_status")
      .eq("user_id", currentUser.id)
      .limit(1)
      .maybeSingle();

    if (error) throw error;
    if (!data) return false;

    const status = String(data.capture_status || "").toLowerCase().trim();
    return data.face_verified === true || status === "approved" || status === "verified";
  }

  async function routeAfterVerification(){
    const alreadyHasFace = await hasVerifiedFaceAlready();

    try {
      localStorage.setItem("colspot_face_step_ready", "true");
      localStorage.setItem("colspot_verification_done", "true");
    } catch {}

    if (alreadyHasFace) {
      showOk("Verification successful. Face already captured before. Redirecting to main...");
      setTimeout(() => {
        window.location.href = MAIN_URL;
      }, 700);
      return;
    }

    showOk("Verification successful. Redirecting to face capture...");
    setTimeout(() => {
      window.location.href = FACE_CAPTURE_URL;
    }, 700);
  }

  async function checkExistingSuccessfulVerification(){
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const { data, error } = await sb
      .from(VERIFICATION_TABLE)
      .select("id, status, full_name, matric_no, school_name, department, programme, faculty, level, session, semester, extracted_json")
      .eq("user_id", currentUser.id)
      .eq("status", "successful")
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (error) return;
    if (!data) return;

    extracted = data.extracted_json || {
      full_name: data.full_name,
      matric_no: data.matric_no,
      school_name: data.school_name,
      department: data.department,
      programme: data.programme,
      faculty: data.faculty,
      level: data.level,
      session: data.session,
      semester: data.semester
    };

    if (extracted) {
      extracted.school_name = normalizeUpper(extracted.school_name);
      extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
    }

    await routeAfterVerification();
  }

  window.addEventListener("load", async () => {
    try {
      resetAll();
      currentUser = await getUser();

      if (!currentUser || !currentUser.id) {
        throw new Error("Not signed in.");
      }

      await checkExistingSuccessfulVerification();
    } catch (e) {
      showErr("You need to be signed in to continue.");
      el("btnExtract").disabled = true;
    }
  });

  el("fileInput").addEventListener("change", (e) => {
    clearMsgs();

    if (verificationLocked) {
      showErr("Verification already completed successfully.");
      return;
    }

    const file = e.target.files && e.target.files[0] ? e.target.files[0] : null;
    if (!file) return;

    const isPdf = (file.type || "") === "application/pdf";
    if (!isPdf) {
      resetAll();
      showErr("Please upload PDF only.");
      return;
    }

    const maxMb = 8;
    if (file.size > maxMb * 1024 * 1024) {
      resetAll();
      showErr(`File too large. Max is ${maxMb}MB.`);
      return;
    }

    pickedFile = file;
    renderPreview(file);
    el("btnExtract").disabled = false;
    el("btnReset").style.display = "inline-flex";
    clearExtractedDetails();
  });

  el("btnReset").addEventListener("click", () => {
    if (verificationLocked) return;
    resetAll();
  });

  el("btnCancel").addEventListener("click", () => {
    if (verificationLocked) return;
    clearMsgs();
    clearExtractedDetails();
    showWarn("Verification cancelled. Upload another course form PDF if you want to try again.");
  });

  el("btnExtract").addEventListener("click", async () => {
    clearMsgs();

    if (verificationLocked) {
      showErr("Verification already completed successfully.");
      return;
    }

    if (!pickedFile) {
      showErr("Pick a file first.");
      return;
    }

    try {
      setLoading(true);

      await ensureCurrentUser();

      uploadedPath = await uploadToStorage(pickedFile);
      const data = await callExtractFunction(uploadedPath, pickedFile);

      if (!data || data.ok !== true) {
        throw new Error("Verification failed. Please try again.");
      }

      const result = data.extracted_result || null;

      if (!result) {
        throw new Error("No details found. Upload a clearer file.");
      }

      extracted = result.extracted || null;

      if (extracted) {
        extracted.school_name = normalizeUpper(extracted.school_name);
        extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
      }

      const hasUsefulDetails =
        extracted &&
        (
          extracted.full_name ||
          extracted.matric_no ||
          extracted.school_name ||
          extracted.department ||
          extracted.programme ||
          extracted.level ||
          extracted.session ||
          extracted.semester
        );

      if (!hasUsefulDetails) {
        clearExtractedDetails();
        showErr(result.reason || "No details found. Upload a clearer PDF.");
        return;
      }

      paintExtracted(extracted);
      el("details").style.display = "block";

      if (result.is_clearance_form === false) {
        showWarn(result.reason || "We found details, but the document type is uncertain. Please review before continuing.");
      } else {
        showOk("Verification details are ready. Please review them and continue.");
      }
    } catch (e) {
      showErr(e && e.message ? e.message : "Something went wrong.");
    } finally {
      setLoading(false);
    }
  });

  el("btnContinue").addEventListener("click", async () => {
    clearMsgs();

    if (verificationLocked) {
      showErr("Verification already completed successfully.");
      return;
    }

    if (!extracted || !uploadedPath) {
      showErr("Please verify the course form first.");
      return;
    }

    try {
      setLoading(true);

      await ensureCurrentUser();

      const duplicateExists = await checkDuplicateMatricInVerificationCourseForms();
      if (duplicateExists) {
        showErr("This matric number is already linked to another account in this school.");
        return;
      }

      await saveToVerificationTable();
      await saveToStudentAccount();
      lockVerificationUi();
      await routeAfterVerification();
    } catch (e) {
      showErr(e && e.message ? e.message : "Failed to save.");
    } finally {
      setLoading(false);
    }
  });
</script>
</body>
</html>
