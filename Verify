      el("btnReset").addEventListener("click", () => {
        if (verificationLocked) {
          showErr("Verification already completed successfully.");
          return;
        }
        resetAll();
      });
    }

    if (el("btnCancel")) {
      el("btnCancel").addEventListener("click", () => {
        window.location.href = INDEX_URL;
      });
    }

    if (el("btnExtract")) {
      el("btnExtract").addEventListener("click", async () => {
        clearMsgs();

        if (verificationLocked) {
          showErr("Verification already completed successfully.");
          return;
        }

        if (!pickedFile) {
          showErr("Please choose a PDF first.");
          return;
        }

        setLoading(true);

        try {
          await ensureCurrentUser();

          uploadedPath = await uploadToStorage(pickedFile);
          const result = await callExtractFunction(uploadedPath, pickedFile);

          extracted =
            result?.details ||
            result?.data ||
            result?.extracted ||
            result?.result ||
            result;

          if (!extracted || typeof extracted !== "object") {
            throw new Error("We could not read the details from this course form.");
          }

          if (extracted.school_name) {
            extracted.school_name = normalizeUpper(extracted.school_name);
          }

          if (extracted.matric || extracted.matric_no) {
            extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
          }

          if (extracted.level) {
            extracted.level = normalizeLevel(extracted.level);
          }

          if (extracted.semester) {
            extracted.semester = normalizeSemester(extracted.semester);
          }

          paintExtracted(extracted);
          if (el("details")) el("details").style.display = "block";

          showOk("Course form checked. Review your details and continue.");
        } catch (e) {
          console.error(e);
          showErr(e?.message || "Verification failed. Please try again.");
        } finally {
          setLoading(false);
        }
      });
    }

    if (el("btnContinue")) {
      el("btnContinue").addEventListener("click", async () => {
        clearMsgs();

        if (verificationLocked) {
          showErr("Verification already completed successfully.");
          return;
        }

        if (!extracted || !uploadedPath) {
          showErr("Please verify your course form first.");
          return;
        }

        setLoading(true);

        try {
          await ensureCurrentUser();

          const duplicate = await checkDuplicateMatricInVerificationCourseForms();
          if (duplicate) {
            throw new Error("This matric number is already linked to another Colspot account in this school.");
          }

          await saveToVerificationTable();
          await saveToStudentAccount();

          lockVerificationUi();
          await routeAfterFreshVerification();
        } catch (e) {
          console.error(e);
          showErr(e?.message || "Could not save verification details. Please try again.");
          unlockVerificationUi();
        } finally {
          setLoading(false);
        }
      });
    }
  </script>
</body>
</html>
