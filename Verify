  function setSelectValue(id, value) {
    const select = safeEl(id);
    if (!select) return;

    const target = String(value || "").trim();

    if (!target) {
      select.value = "";
      return;
    }

    const exactExists = Array.from(select.options).some((opt) => opt.value === target);
    if (exactExists) {
      select.value = target;
      return;
    }

    const normalizedTarget = normalizeText(target).toLowerCase();
    const matched = Array.from(select.options).find((opt) => {
      return normalizeText(opt.value).toLowerCase() === normalizedTarget;
    });

    select.value = matched ? matched.value : "";
  }

