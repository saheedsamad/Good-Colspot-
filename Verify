  async function callExtractFunction(storagePath, file) {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    const { data: sessData, error: sessErr } = await sb.auth.getSession();

    if (sessErr) {
      redirectToIndex("Your session has expired. Redirecting to sign in...");
      throw new Error("Auth session missing!");
    }

    const accessToken = sessData?.session?.access_token || "";

    if (!accessToken) {
      redirectToIndex("Your session has expired. Redirecting to sign in...");
      throw new Error("Auth session missing!");
    }

    const payload = {
      bucket: BUCKET,
      path: storagePath,
      mime_type: "application/pdf",
      file_size: file.size || null
    };

    const resp = await fetch(EXTRACT_FN_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${accessToken}`,
        "x-debug": "1"
      },
      body: JSON.stringify(payload)
    });

    let data = null;

    try {
      data = await resp.json();
    } catch {
      data = null;
    }

    if (!resp.ok) {
      const msg =
        (data && (data.error || data.message || data.details)) ||
        `Verification failed (${resp.status})`;

      throw new Error(msg);
    }

    return data;
  }

  function extractDetailsLikeVerify32(data) {
    if (!data || data.ok !== true) {
      throw new Error("AI extraction failed. Please try again.");
    }

    const result = data.extracted_result || null;

    if (!result) {
      throw new Error("No details found. Upload a clearer file.");
    }

    const details = result.extracted || null;

    const hasUsefulDetails =
      details &&
      (
        details.full_name ||
        details.matric_no ||
        details.matric ||
        details.school_name ||
        details.department ||
        details.programme ||
        details.faculty ||
        details.level ||
        details.session ||
        details.semester
      );

    if (!hasUsefulDetails) {
      clearExtractedDetails();
      throw new Error(result.reason || "No details found. Upload a clearer PDF.");
    }

    return details;
  }

