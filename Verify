  <script src="./guard_session.js"></script>

<script>
  const BUCKET = "verification_uploads";
  const EXTRACT_FN_URL = "https://wtlrfujfimxcmsnqrnig.functions.supabase.co/extract-clearance";
  const VERIFICATION_TABLE = "verification_course_forms";
  const DUPLICATE_CHECK_TABLE = "verification_course_forms";
  const ACCOUNT_TABLE = "student_accounts";
  const DROPDOWN_TABLE = "verification_dropdown_options";
  const FACE_TABLE = "face_profiles";
  const ACADEMIC_UPDATE_TABLE = "student_academic_update_requests";

  const FACE_CAPTURE_URL = "face-capture.html";
  const MAIN_URL = "main.html";
  const INDEX_URL = "index.html";

  const ACADEMIC_UPDATE_PENDING_KEY = "colspot_pending_academic_update";
  const ACADEMIC_UPDATE_BLOCK_DAYS = 60;

  const el = (id) => document.getElementById(id);

  const params = new URLSearchParams(window.location.search);
  const PAGE_MODE = String(params.get("mode") || "").trim().toLowerCase();
  const IS_ACADEMIC_UPDATE = PAGE_MODE === "academic_update";

  let pickedFile = null;
  let uploadedPath = null;
  let extracted = null;
  let currentUser = null;
  let verificationLocked = false;
  let currentStudentAccount = null;
  let academicUpdateBlocked = false;
  let academicUpdateBlockInfo = null;
  let redirectingToIndex = false;

  let dropdownOptions = {
    level: [],
    session: [],
    semester: []
  };

  function safeEl(id) {
    return document.getElementById(id);
  }

  function redirectToIndex(message, delay = 800) {
    if (redirectingToIndex) return;
    redirectingToIndex = true;

    if (message) {
      showErr(message);
    }

    try {
      localStorage.removeItem("colspot_face_step_ready");
      localStorage.removeItem("colspot_verification_done");
    } catch (e) {}

    setTimeout(() => {
      window.location.href = INDEX_URL;
    }, delay);
  }

  function isSessionMissingError(e) {
    const msg = String(e?.message || e || "").toLowerCase();

    return (
      msg.includes("not signed in") ||
      msg.includes("auth session missing") ||
      msg.includes("missing authorization") ||
      msg.includes("please sign in") ||
      msg.includes("no active session") ||
      msg.includes("session expired") ||
      msg.includes("jwt") ||
      msg.includes("invalid session")
    );
  }

  function saveLocalUser(user) {
    if (!user || !user.id) return;

    try {
      localStorage.setItem("colspot_local_user", JSON.stringify({
        id: user.id,
        user_id: user.id,
        email: user.email || "",
        last_seen: new Date().toISOString()
      }));
      localStorage.setItem("colspot_auth_role", "student");
    } catch (e) {
      console.error("Could not save local user cache:", e);
    }
  }

  function clearMsgs() {
    const err = safeEl("msgErr");
    const ok = safeEl("msgOk");

    if (err) {
      err.style.display = "none";
      err.textContent = "";
    }

    if (ok) {
      ok.style.display = "none";
      ok.textContent = "";
    }
  }

  function showErr(msg) {
    const err = safeEl("msgErr");
    const ok = safeEl("msgOk");

    if (ok) {
      ok.style.display = "none";
      ok.textContent = "";
    }

    if (err) {
      err.style.display = "block";
      err.textContent = msg || "";
    }
  }

  function showOk(msg) {
    const err = safeEl("msgErr");
    const ok = safeEl("msgOk");

    if (err) {
      err.style.display = "none";
      err.textContent = "";
