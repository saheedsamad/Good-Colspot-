    async function routeBasedOnVerificationState(options = {}) {
      if (IS_ACADEMIC_UPDATE) return false;

      const { silent = false } = options;

      const existingVerification = await hasVerifiedCourseFormAlready();
      const alreadyHasFace = await hasVerifiedFaceAlready();

      if (existingVerification) {
        extracted = existingVerification.extracted_json || {
          full_name: existingVerification.full_name,
          matric_no: existingVerification.matric_no,
          school_name: existingVerification.school_name,
          department: existingVerification.department,
          programme: existingVerification.programme,
          faculty: existingVerification.faculty,
          level: existingVerification.level,
          session: existingVerification.session,
          semester: existingVerification.semester
        };

        if (extracted) {
          extracted.school_name = normalizeUpper(extracted.school_name);
          extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
        }

        paintExtracted(extracted);
        if (el("details")) el("details").style.display = "block";
        lockVerificationUi();

        try {
          localStorage.setItem("colspot_verification_done", "true");
          saveLocalUser(currentUser);
        } catch {}

        if (alreadyHasFace) {
          try {
            localStorage.setItem("colspot_face_enrolled", "true");
            localStorage.removeItem("colspot_face_step_ready");
          } catch {}

          if (!silent) {
            showOk("Your course form and face are already verified. Redirecting to main...");
          }

          setTimeout(() => {
            saveLocalUser(currentUser);
            window.location.href = MAIN_URL;
          }, silent ? 250 : 700);

          return true;
        }

        try {
          localStorage.setItem("colspot_face_step_ready", "true");
        } catch {}

        if (!silent) {
          showOk("Your course form is already verified. Redirecting to face capture...");
        }

        setTimeout(() => {
          saveLocalUser(currentUser);
          window.location.href = FACE_CAPTURE_URL;
        }, silent ? 250 : 700);

        return true;
      }

      unlockVerificationUi();

      if (alreadyHasFace) {
        try {
          localStorage.removeItem("colspot_face_step_ready");
          localStorage.setItem("colspot_face_enrolled", "true");
        } catch {}

        if (!silent) {
          showWarn("Your face is already verified. Upload your course form to finish account verification.");
        }
      } else {
        try {
          localStorage.removeItem("colspot_face_enrolled");
          localStorage.removeItem("colspot_face_step_ready");
        } catch {}
      }

      return false;
    }

    async function routeAfterFreshVerification() {
      const alreadyHasFace = await hasVerifiedFaceAlready();

      try {
        localStorage.setItem("colspot_verification_done", "true");
        saveLocalUser(currentUser);
      } catch {}

      if (alreadyHasFace) {
        try {
          localStorage.setItem("colspot_face_enrolled", "true");
          localStorage.removeItem("colspot_face_step_ready");
        } catch {}

        showOk("Verification successful. Face already captured before. Redirecting to main...");
        setTimeout(() => {
          saveLocalUser(currentUser);
          window.location.href = MAIN_URL;
        }, 700);
        return;
      }

      try {
        localStorage.setItem("colspot_face_step_ready", "true");
        localStorage.removeItem("colspot_face_enrolled");
      } catch {}

      showOk("Verification successful. Redirecting to face capture...");
      setTimeout(() => {
        saveLocalUser(currentUser);
        window.location.href = FACE_CAPTURE_URL;
      }, 700);
    }

    async function loadStudentAccountForAcademicUpdate() {
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      await ensureCurrentUser();

      const { data, error } = await sb
        .from(ACCOUNT_TABLE)
        .select("*")
        .eq("user_id", currentUser.id)
        .order("updated_at", { ascending: false })
        .limit(1)
        .maybeSingle();

      if (error) throw error;
      if (!data) {
        throw new Error("We could not find your student account. Please complete student verification first.");
      }

      currentStudentAccount = data;

      const fullName = normalizeText(data.full_name);
      const matric = normalizeText(data.matric_number);
      const school = normalizeUpper(data.school_name);
      const department = normalizeText(data.department);
      const programme = normalizeText(data.programme);
      const level = normalizeLevel(data.level);
      const session = getAccountSessionValue(data);
      const semester = normalizeSemester(data.semester);

      if (el("aFullName")) el("aFullName").textContent = fullName || "—";
      if (el("aMatric")) el("aMatric").textContent = matric || "—";
      if (el("aSchool")) el("aSchool").textContent = school || "—";
      if (el("aDepartment")) el("aDepartment").textContent = department || "—";
      if (el("aProgramme")) el("aProgramme").textContent = programme || "—";

      if (el("aLevel")) el("aLevel").value = level || "";
      if (el("aSession")) el("aSession").value = session || "";
      if (el("aSemester")) el("aSemester").value = semester || "";

      if (!fullName || !matric || !school) {
        showAcademicWarn("Some locked profile details are missing. Please complete normal verification first if this page does not work.");
      }
    }

    async function createPendingAcademicUpdate() {
      const sb = window.supabase;
      if (!sb) throw new Error("Supabase not ready.");

      await ensureCurrentUser();

      if (!currentStudentAccount) {
        throw new Error("Student account not loaded. Please refresh and try again.");
      }

      const newLevel = normalizeLevel(el("aLevel")?.value);
      const newSession = normalizeText(el("aSession")?.value);
      const newSemester = normalizeSemester(el("aSemester")?.value);

      if (!newLevel) throw new Error("Please select your new level.");
      if (!newSession) throw new Error("Please select your new academic session.");
      if (!newSemester) throw new Error("Please select your new semester.");

      const oldLevel = normalizeLevel(currentStudentAccount.level);
      const oldSession = getAccountSessionValue(currentStudentAccount);
      const oldSemester = normalizeSemester(currentStudentAccount.semester);

      const noChange =
        oldLevel === newLevel &&
        oldSession === newSession &&
        oldSemester === newSemester;

      if (noChange) {
        throw new Error("You selected the same academic details already on your profile.");
      }

      await sb
        .from(ACADEMIC_UPDATE_TABLE)
        .update({
          status: "cancelled",
          cancelled_at: new Date().toISOString()
        })
        .eq("user_id", currentUser.id)
        .eq("status", "pending_face");

      const insertPayload = {
        user_id: currentUser.id,
        old_level: oldLevel || null,
        old_session: oldSession || null,
        old_semester: oldSemester || null,
        new_level: newLevel,
        new_session: newSession,
        new_semester: newSemester,
        status: "pending_face"
      };

      const { data, error } = await sb
        .from(ACADEMIC_UPDATE_TABLE)
        .insert(insertPayload)
        .select("id, user_id, new_level, new_session, new_semester, status")
        .single();

      if (error) throw error;

      const pending = {
        request_id: data.id,
        user_id: currentUser.id,
        mode: "academic_update",
        new_level: newLevel,
        new_session: newSession,
        new_semester: newSemester,
        created_at: new Date().toISOString()
      };

      localStorage.setItem(ACADEMIC_UPDATE_PENDING_KEY, JSON.stringify(pending));
      localStorage.setItem("colspot_face_step_ready", "true");
      localStorage.removeItem("colspot_face_enrolled");

      return pending;
    }

