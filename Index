<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Authentication</title>

  <style>
    :root{
      --blue:#2f64e3;
      --blue-dark:#1f4fc8;
      --blue-soft:#dfe9ff;
      --bg:#f3f6fb;
      --card:#ffffff;
      --text:#101828;
      --muted:#667085;
      --line:#d9e2f1;
      --field:#f8fafc;
      --shadow:0 18px 42px rgba(15,23,42,.08);
      --radius:26px;
      --success:#16a34a;
      --error:#dc2626;
    }

    *{
      box-sizing:border-box;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    }

    html,body{
      margin:0;
      min-height:100%;
      background:radial-gradient(circle at top,#eaf1ff 0%,#f6f8fd 48%,#ffffff 100%);
      -webkit-text-size-adjust:100%;
    }

    body{
      display:flex;
      justify-content:center;
      align-items:stretch;
      touch-action:manipulation;
      overscroll-behavior:none;
    }

    .phone-shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:calc(env(safe-area-inset-top) + 12px) 14px calc(env(safe-area-inset-bottom) + 18px);
    }

    .hidden{display:none !important;}

    .screen-card{
      width:100%;
      background:var(--card);
      border-radius:28px;
      box-shadow:var(--shadow);
      padding:22px 18px 20px;
      animation:fadeIn .22s ease;
    }

    @keyframes fadeIn{
      from{opacity:0;transform:translateY(8px)}
      to{opacity:1;transform:translateY(0)}
    }

    .logo{
      text-align:center;
      margin-bottom:10px;
    }

    .logo img{
      width:auto;
      height:62px;
      object-fit:contain;
      border-radius:14px;
    }

    .title{
      margin:4px 0 6px;
      text-align:center;
      color:#0f172a;
      font-size:30px;
      font-weight:800;
      line-height:1.08;
    }

    .subtitle{
      margin:0 0 18px;
      text-align:center;
      color:#5871a8;
      font-size:15px;
      line-height:1.4;
    }

    .role-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
    }

    .role-card{
      background:#fff;
      border:1px solid #edf2fa;
      border-radius:24px;
      box-shadow:0 16px 34px rgba(15,23,42,.06);
      padding:14px 12px 16px;
      text-align:center;
      cursor:pointer;
      transition:transform .15s ease;
    }

    .role-card:active{transform:scale(.985);}

    .role-illustration{
      height:124px;
      border-radius:20px;
      background:linear-gradient(180deg,#f6f9ff 0%,#eef3ff 100%);
      display:flex;
      align-items:center;
      justify-content:center;
      margin-bottom:14px;
      overflow:hidden;
    }

    .role-svg{
      width:108px;
      height:108px;
    }

    .role-btn{
      width:100%;
      border-radius:18px;
      padding:13px 8px;
      border:2px solid var(--blue);
      background:#fff;
      color:var(--blue);
      font-size:16px;
      font-weight:700;
      cursor:pointer;
    }

    .role-card.admin .role-btn{
      background:var(--blue);
      color:#fff;
    }

    .back-btn{
      border:none;
      background:transparent;
      color:var(--blue);
      font-size:14px;
      font-weight:600;
      padding:0;
      margin:2px 0 14px;
      cursor:pointer;
      text-align:left;
    }

    .auth-heading{
      text-align:center;
      margin-bottom:14px;
    }

    .auth-heading h1{
      margin:0 0 6px;
      font-size:24px;
      color:var(--text);
    }

    .auth-heading p{
      margin:0;
      color:var(--muted);
      font-size:14px;
    }

    .segmented{
      display:flex;
      background:#dfe8fb;
      border-radius:999px;
      padding:4px;
      margin-bottom:18px;
    }

    .segmented button{
      flex:1;
      border:none;
      background:transparent;
      border-radius:999px;
      padding:10px 0;
      font-size:14px;
      font-weight:600;
      color:#64748b;
      cursor:pointer;
    }

    .segmented button.active{
      background:#fff;
      color:var(--blue);
      box-shadow:0 5px 12px rgba(37,99,235,.16);
    }

    label{
      display:block;
      font-size:13px;
      color:#667085;
      margin-bottom:6px;
    }

    input,select{
      width:100%;
      border:1px solid var(--line);
      background:var(--field);
      border-radius:16px;
      padding:14px 14px;
      font-size:16px;
      color:var(--text);
      outline:none;
      margin-bottom:14px;
    }

    input:focus,select:focus{
      border-color:var(--blue);
      box-shadow:0 0 0 3px rgba(47,100,227,.12);
      background:#fff;
    }

    .password-row{
      display:flex;
      align-items:center;
      gap:8px;
      margin-bottom:14px;
    }

    .password-row input{
      flex:1;
      margin-bottom:0;
    }

    .password-toggle{
      min-width:86px;
      border:1px solid var(--line);
      background:#fff;
      color:#7b8294;
      border-radius:999px;
      padding:11px 10px;
      font-size:13px;
      cursor:pointer;
    }

    .primary-btn{
      width:100%;
      border:none;
      border-radius:16px;
      padding:15px 14px;
      font-size:17px;
      font-weight:700;
      color:#fff;
      background:linear-gradient(180deg,var(--blue) 0%, var(--blue-dark) 100%);
      box-shadow:0 14px 28px rgba(47,100,227,.22);
      cursor:pointer;
    }

    .form-links{
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
      margin-top:14px;
    }

    .text-link{
      border:none;
      background:transparent;
      padding:0;
      color:var(--blue);
      font-size:13px;
      font-weight:500;
      cursor:pointer;
      text-decoration:none;
    }

    .form-message{
      text-align:center;
      min-height:18px;
      margin-top:10px;
      font-size:13px;
    }

    .success{color:var(--success);}
    .error{color:var(--error);}

    .hint{
      font-size:12px;
      color:var(--muted);
      margin-top:-6px;
      margin-bottom:10px;
      line-height:1.4;
    }

    .small-note{
      margin-top:14px;
      text-align:center;
      color:var(--muted);
      font-size:12px;
      line-height:1.45;
    }

    /* ADMIN EXACT LOOK */
    .admin-shell{
      background:#fff;
      border-radius:28px;
      box-shadow:var(--shadow);
      overflow:hidden;
      animation:fadeIn .22s ease;
    }

    .admin-top{
      padding:16px 16px 0;
    }

    .admin-header-title{
      margin:6px 0 0;
      text-align:center;
      font-size:31px;
      font-weight:800;
      color:#0f172a;
      line-height:1.1;
    }

    .admin-tabs-wrap{
      padding:0 16px 0;
    }

    .admin-tabs{
      display:flex;
      align-items:center;
      gap:0;
      background:#fff;
      border-radius:26px 26px 0 0;
      overflow:hidden;
      margin-top:6px;
    }

    .admin-tab{
      flex:1;
      text-align:center;
      padding:16px 6px;
      color:#3f4a5d;
      font-size:17px;
      position:relative;
      background:#fff;
    }

    .admin-tab + .admin-tab{
      border-left:1px solid #edf2fa;
    }

    .admin-tab.active{
      margin:8px 0 8px 8px;
      border-radius:20px;
      background:var(--blue);
      color:#fff;
      font-weight:700;
      border-left:none;
    }

    .admin-tab.placeholder{
      pointer-events:none;
    }

    .admin-body{
      padding:20px 16px 18px;
      background:#fff;
    }

    .admin-title{
      margin:0 0 6px;
      font-size:25px;
      font-weight:800;
      color:#101828;
    }

    .admin-sub{
      margin:0 0 18px;
      color:#6b7280;
      font-size:14px;
      line-height:1.4;
    }

    .admin-input-label{
      display:flex;
      align-items:center;
      gap:10px;
      color:#344054;
      font-size:15px;
      font-weight:500;
      margin-bottom:8px;
    }

    .icon{
      width:22px;
      height:22px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      color:#667085;
      flex-shrink:0;
    }

    .icon svg{
      width:22px;
      height:22px;
      stroke:currentColor;
    }

    .admin-links{
      display:flex;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
      margin-top:16px;
    }

    .admin-links .text-link{
      font-size:14px;
    }

    @media (max-width:390px){
      .role-grid{gap:10px;}
      .role-illustration{height:104px;}
      .role-svg{width:90px;height:90px;}
      .role-btn{font-size:15px;padding:12px 8px;}
      .title{font-size:26px;}
      .admin-header-title{font-size:28px;}
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <!-- ROLE CHOICE -->
    <section id="role-choice-screen" class="screen-card">
      <div class="logo">
        <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
      </div>

      <div class="title">Welcome!</div>
      <div class="subtitle">How would you like to proceed?</div>

      <div class="role-grid">
        <div class="role-card" onclick="openRoleScreen('student')">
          <div class="role-illustration">
            <svg class="role-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="60" cy="60" r="46" fill="#DDE5F7"/>
              <path d="M41 80V60C41 49.5 49.5 41 60 41C70.5 41 79 49.5 79 60V80" fill="#1D6FE8"/>
              <circle cx="60" cy="42" r="13" fill="#F3B285"/>
              <path d="M48 39C48 29 55 24 63 24C73 24 79 31 79 39V43H48V39Z" fill="#1D2D6A"/>
              <path d="M55 57L89 64L82 88L48 81L55 57Z" fill="#2380F0"/>
              <path d="M58 60L84 65" stroke="#BFE0FF" stroke-width="2.6" stroke-linecap="round"/>
              <path d="M57 66L83 71" stroke="#BFE0FF" stroke-width="2.6" stroke-linecap="round"/>
              <path d="M56 72L77 76" stroke="#BFE0FF" stroke-width="2.6" stroke-linecap="round"/>
            </svg>
          </div>
          <button class="role-btn" type="button">Student</button>
        </div>

        <div class="role-card" onclick="openRoleScreen('lecturer')">
          <div class="role-illustration">
            <svg class="role-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="60" cy="60" r="46" fill="#DDE5F7"/>
              <circle cx="58" cy="41" r="13" fill="#F3B285"/>
              <path d="M47 39C47 29 54 24 62 24C72 24 78 31 78 39V43H47V39Z" fill="#1D2D6A"/>
              <path d="M36 85V64C36 52 45 45 57 45H59C71 45 80 52 80 64V85" fill="#A9C7F5"/>
              <path d="M59 50L66 57L59 64L52 57L59 50Z" fill="#245FE2"/>
              <path d="M57 64H61L64 85H54L57 64Z" fill="#1D4FC8"/>
              <path d="M68 58L90 64V92L68 87V58Z" fill="#2380F0"/>
              <path d="M89 64L94 66V94L89 92V64Z" fill="#1B66D1"/>
              <path d="M84 56C92 57 96 63 96 70" stroke="#7A8FBF" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <button class="role-btn" type="button">Lecturer</button>
        </div>

        <div class="role-card admin" onclick="openRoleScreen('admin')">
          <div class="role-illustration">
            <svg class="role-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="60" cy="60" r="46" fill="#DDE5F7"/>
              <circle cx="60" cy="41" r="13" fill="#F3B285"/>
              <path d="M49 39C49 29 56 24 64 24C74 24 80 31 80 39V43H49V39Z" fill="#1D2D6A"/>
              <path d="M39 85V64C39 52 48 45 60 45C72 45 81 52 81 64V85" fill="#F7FAFF"/>
              <path d="M58 50L66 58L60 64L53 58L58 50Z" fill="#1E56D8"/>
              <path d="M58 64H63L66 85H54L58 64Z" fill="#1D4FC8"/>
              <path d="M32 63L57 60V92L32 95V63Z" fill="#2D6BE9"/>
              <path d="M36 67L53 65" stroke="#BFE0FF" stroke-width="2.6" stroke-linecap="round"/>
              <path d="M36 73L52 71" stroke="#BFE0FF" stroke-width="2.6" stroke-linecap="round"/>
            </svg>
          </div>
          <button class="role-btn" type="button">Admin</button>
        </div>
      </div>
    </section>

    <!-- STUDENT / LECTURER -->
    <section id="account-screen" class="screen-card hidden">
      <button class="back-btn" type="button" onclick="goBackToRoleChoice()">← Back</button>

      <div class="logo">
        <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
      </div>

      <div class="auth-heading">
        <h1 id="accountTitle">Welcome back</h1>
        <p id="accountSubtitle">Sign in to your Colspot account</p>
      </div>

      <div class="segmented">
        <button id="account-signin-tab" class="active" type="button" onclick="switchAccountMode('signin')">Sign in</button>
        <button id="account-signup-tab" type="button" onclick="switchAccountMode('signup')">Sign up</button>
      </div>

      <form id="account-signin-form">
        <label for="signin-school">School name</label>
        <input id="signin-school" type="text" list="school-list" placeholder="Search and select school" required />

        <label for="signin-email">Email</label>
        <input id="signin-email" type="email" placeholder="you@example.com" required />

        <label for="signin-password">Password</label>
        <div class="password-row">
          <input id="signin-password" type="password" placeholder="••••••••" required />
          <button type="button" class="password-toggle" onclick="togglePassword('signin-password', this)">Show</button>
        </div>

        <button class="primary-btn" type="submit" id="signin-btn-text">Sign in</button>

        <div class="form-links">
          <a href="contact.html" class="text-link">Contact us</a>
          <button type="button" class="text-link">Forgot password?</button>
        </div>

        <div id="signin-message" class="form-message"></div>
      </form>

      <form id="account-signup-form" class="hidden">
        <label for="signup-fullname">Full name</label>
        <input id="signup-fullname" type="text" placeholder="Saheed Samad" required />

        <label for="signup-school">School name</label>
        <input id="signup-school" type="text" list="school-list" placeholder="Search and select school" required />

        <label for="signup-department">Department</label>
        <input id="signup-department" type="text" placeholder="Computer Science" required />

        <div id="student-fields">
          <label for="signup-matric">Matric number</label>
          <input id="signup-matric" type="text" placeholder="e.g. CSC/21/1234" />
        </div>

        <label for="signup-email">Email</label>
        <input id="signup-email" type="email" placeholder="you@example.com" required />

        <div id="lecturer-email-note" class="small-note hidden" style="margin-top:-4px; margin-bottom:12px;">
          Lecturers should use their official school email.
        </div>

        <label for="signup-password">Password</label>
        <div class="password-row">
          <input id="signup-password" type="password" placeholder="At least 6 characters" required />
          <button type="button" class="password-toggle" onclick="togglePassword('signup-password', this)">Show</button>
        </div>

        <label for="signup-password2">Confirm password</label>
        <div class="password-row">
          <input id="signup-password2" type="password" placeholder="Repeat password" required />
          <button type="button" class="password-toggle" onclick="togglePassword('signup-password2', this)">Show</button>
        </div>

        <button class="primary-btn" type="submit" id="signup-btn-text">Create account</button>

        <div id="signup-message" class="form-message"></div>
      </form>

      <div class="small-note">
        Colspot uses your location to work properly. Please allow location when asked.
      </div>
    </section>

    <!-- ADMIN -->
    <section id="admin-screen" class="admin-shell hidden">
      <div class="admin-top">
        <button class="back-btn" type="button" onclick="goBackToRoleChoice()">← Back</button>

        <div class="logo" style="margin-top:2px;">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>

        <div class="admin-header-title">Sign in to your Colspot account</div>
      </div>

      <div class="admin-tabs-wrap">
        <div class="admin-tabs">
          <div class="admin-tab placeholder">Student</div>
          <div class="admin-tab placeholder">Lecturer</div>
          <div class="admin-tab active">Admin</div>
        </div>
      </div>

      <div class="admin-body">
        <h2 class="admin-title">Admin Access</h2>
        <p class="admin-sub">For administrative and super admin roles</p>

        <form id="admin-form">
          <div class="admin-input-label">
            <span class="icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 6.5L11.1 11.23C11.64 11.59 12.36 11.59 12.9 11.23L20 6.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="3" y="5" width="18" height="14" rx="3" stroke-width="2"/>
              </svg>
            </span>
            <span>Email</span>
          </div>
          <input id="admin-email" type="email" placeholder="admin@school.edu" required />

          <div class="admin-input-label">
            <span class="icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" stroke-width="2"/>
                <path d="M4 21C4 17.6863 7.58172 15 12 15C16.4183 15 20 17.6863 20 21" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
            <span>Login ID</span>
          </div>
          <input id="admin-login-id" type="text" placeholder="" required />

          <div class="admin-input-label">
            <span class="icon">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="5" y="11" width="14" height="10" rx="2" stroke-width="2"/>
                <path d="M8 11V8C8 5.79086 9.79086 4 12 4C14.2091 4 16 5.79086 16 8V11" stroke-width="2" stroke-linecap="round"/>
                <circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none"/>
              </svg>
            </span>
            <span>Password</span>
          </div>
          <div class="password-row">
            <input id="admin-password" type="password" placeholder="••••••••" required />
            <button type="button" class="password-toggle" onclick="togglePassword('admin-password', this)">Show</button>
          </div>

          <button class="primary-btn" type="submit">Sign in as Admin</button>

          <div class="admin-links">
            <button type="button" class="text-link">Forgot password?</button>
            <a href="contact.html" class="text-link">Contact support</a>
          </div>

          <div id="admin-message" class="form-message"></div>
        </form>
      </div>
    </section>

    <datalist id="school-list">
      <option value="Ekiti State University"></option>
      <option value="University of Lagos"></option>
      <option value="University of Ibadan"></option>
      <option value="Obafemi Awolowo University"></option>
      <option value="Ahmadu Bello University"></option>
      <option value="Federal University Oye-Ekiti"></option>
      <option value="University of Benin"></option>
      <option value="University of Ilorin"></option>
      <option value="Lagos State University"></option>
      <option value="University of Nigeria Nsukka"></option>
      <option value="Nnamdi Azikiwe University"></option>
      <option value="Rivers State University"></option>
      <option value="Bayero University Kano"></option>
      <option value="Federal University of Technology Akure"></option>
      <option value="University of Port Harcourt"></option>
    </datalist>
  </div>

  <script>
    let selectedRole = "";

    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isPassword = input.type === "password";
      input.type = isPassword ? "text" : "password";
      btn.textContent = isPassword ? "Hide" : "Show";
    }

    function openRoleScreen(role) {
      selectedRole = role;

      document.getElementById("role-choice-screen").classList.add("hidden");
      document.getElementById("account-screen").classList.add("hidden");
      document.getElementById("admin-screen").classList.add("hidden");

      if (role === "admin") {
        document.getElementById("admin-screen").classList.remove("hidden");
        return;
      }

      document.getElementById("account-screen").classList.remove("hidden");

      const title = document.getElementById("accountTitle");
      const subtitle = document.getElementById("accountSubtitle");
      const signinBtn = document.getElementById("signin-btn-text");
      const signupBtn = document.getElementById("signup-btn-text");
      const studentFields = document.getElementById("student-fields");
      const lecturerNote = document.getElementById("lecturer-email-note");

      if (role === "student") {
        title.textContent = "Student access";
        subtitle.textContent = "Sign in or create your student account";
        signinBtn.textContent = "Sign in as Student";
        signupBtn.textContent = "Create Student Account";
        studentFields.classList.remove("hidden");
        lecturerNote.classList.add("hidden");
      } else {
        title.textContent = "Lecturer access";
        subtitle.textContent = "Sign in or create your lecturer account";
        signinBtn.textContent = "Sign in as Lecturer";
        signupBtn.textContent = "Create Lecturer Account";
        studentFields.classList.add("hidden");
        lecturerNote.classList.remove("hidden");
      }

      switchAccountMode("signin");
    }

    function goBackToRoleChoice() {
      selectedRole = "";
      document.getElementById("role-choice-screen").classList.remove("hidden");
      document.getElementById("account-screen").classList.add("hidden");
      document.getElementById("admin-screen").classList.add("hidden");
    }

    function switchAccountMode(mode) {
      const signinTab = document.getElementById("account-signin-tab");
      const signupTab = document.getElementById("account-signup-tab");
      const signinForm = document.getElementById("account-signin-form");
      const signupForm = document.getElementById("account-signup-form");

      if (mode === "signin") {
        signinTab.classList.add("active");
        signupTab.classList.remove("active");
        signinForm.classList.remove("hidden");
        signupForm.classList.add("hidden");
      } else {
        signupTab.classList.add("active");
        signinTab.classList.remove("active");
        signupForm.classList.remove("hidden");
        signinForm.classList.add("hidden");
      }
    }

    document.getElementById("account-signin-form").addEventListener("submit", function(e) {
      e.preventDefault();
