<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Authentication</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1e40af;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --error: #dc2626;
      --success: #16a34a;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    }

    html, body {
      height: 100%;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
      touch-action: manipulation;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px calc(env(safe-area-inset-bottom) + 16px);
      position: relative;
    }

    .splash {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, #e5f0ff, #f8fbff);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    .splash-card {
      background: var(--card);
      border-radius: 24px;
      padding: 32px 32px 28px;
      box-shadow: 0 18px 45px rgba(15,23,42,0.20);
      text-align: center;
    }

    .splash-logo {
      height: 72px;
      width: auto;
      border-radius: 16px;
      object-fit: cover;
      margin-bottom: 16px;
    }

    .splash-text {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .splash-spinner {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 3px solid rgba(37,99,235,0.25);
      border-top-color: var(--blue);
      animation: spin 0.8s linear infinite;
      margin: 0 auto;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .container {
      width: 100%;
      max-width: 420px;
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 12px 6px 0;
      margin: 0 auto;
    }

    .card {
      width: 100%;
      background: var(--card);
      border-radius: 24px;
      padding: 24px 20px 20px;
      box-shadow: 0 12px 35px rgba(0,0,0,0.08);
      animation: fadeIn 0.35s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .logo {
      text-align: center;
      margin-bottom: 12px;
    }

    .logo img {
      height: 52px;
      width: auto;
      display: inline-block;
      border-radius: 12px;
      object-fit: cover;
    }

    h1 {
      text-align: center;
      font-size: 22px;
      margin: 4px 0 4px;
      color: var(--text);
    }

    .subtitle {
      text-align: center;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 18px;
    }

    .mode-toggle {
      display: flex;
      background: #e5edff;
      border-radius: 999px;
      padding: 4px;
      margin-bottom: 20px;
      gap: 4px;
    }

    .mode-btn {
      flex: 1;
      border-radius: 999px;
      border: none;
      background: transparent;
      font-size: 14px;
      padding: 8px 0;
      cursor: pointer;
      color: var(--muted);
      font-weight: 500;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .mode-btn.active {
      background: #ffffff;
      color: var(--blue);
      box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }

    label {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 6px;
      display: block;
    }

    input, select {
      width: 100%;
      padding: 12px 13px;
      font-size: 17px; /* prevent iOS zoom */
      border-radius: 12px;
      border: 1px solid var(--border);
      margin-bottom: 14px;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
      background: #f9fafb;
    }

    input:focus, select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
      background: #ffffff;
    }

    button.primary {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      font-size: 16px;
      font-weight: 600;
      color: white;
      background: var(--blue);
      cursor: pointer;
      transition: background 0.2s, transform 0.05s;
      margin-top: 4px;
    }

    button.primary:hover { background: var(--blue-dark); }
    button.primary:active { transform: scale(0.98); }
    button.primary:disabled { background: #93c5fd; cursor: not-allowed; }

    .spinner {
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: auto;
    }

    .message {
      margin-top: 10px;
      text-align: center;
      font-size: 13px;
      min-height: 18px;
    }

    .error { color: var(--error); }
    .success { color: var(--success); }

    .bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      font-size: 13px;
      gap: 10px;
    }

    .bottom-row.small {
      margin-top: 6px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .text-link {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      font-weight: 500;
      padding: 0;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link:hover { text-decoration: underline; }

    .link-inline {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 13px;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
    }

    .hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: -6px;
      margin-bottom: 10px;
    }

    .hidden { display: none; }

    .password-row {
      display: flex;
      align-items: center;
      margin-bottom: 14px;
      gap: 8px;
    }

    .password-row input { margin-bottom: 0; flex: 1; }

    .password-toggle {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #f9fafb;
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
      color: var(--muted);
    }

    .password-toggle:hover { background: #e5e7eb; }

    .location-note {
      margin-top: 14px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.4;
    }

    .admin-note {
      margin-top: -6px;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      line-height: 1.35;
    }
  </style>
</head>

<body>
  <div id="splash-screen" class="splash">
    <div class="splash-card">
      <img src="asset/logo walpaper.jpeg" alt="Colspot logo" class="splash-logo" />
      <div class="splash-text">Getting things ready…</div>
      <div class="splash-spinner"></div>
    </div>
  </div>

  <div class="phone-shell">
    <div id="auth-shell" class="container hidden">
      <div class="card">
        <div class="logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo">
        </div>

        <h1 id="card-title">Welcome back</h1>
        <p class="subtitle" id="card-subtitle">Sign in to your Colspot account</p>

        <!-- Tabs -->
        <div id="mode-toggle" class="mode-toggle">
          <button id="tab-signin" class="mode-btn active" type="button" onclick="switchMode('signin')">Sign in</button>
          <button id="tab-signup" class="mode-btn" type="button" onclick="switchMode('signup')">Sign up</button>
          <button id="tab-admin" class="mode-btn" type="button" onclick="switchMode('admin')">Admin</button>
        </div>

        <!-- SIGN IN -->
        <form id="signin-form">
          <label for="signin-email">Email</label>
          <input id="signin-email" type="email" placeholder="you@example.com" autocomplete="email" required />

          <label for="signin-password">Password</label>
          <div class="password-row">
            <input id="signin-password" type="password" placeholder="••••••••" autocomplete="current-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signin-password', this)">Show</button>
          </div>

          <button id="signin-btn" type="submit" class="primary">
            <span id="signin-text">Sign in</span>
            <span id="signin-loader" class="spinner hidden"></span>
          </button>

          <div class="bottom-row">
            <a href="contact.html" class="text-link">Contact us</a>
            <button type="button" class="text-link" onclick="openForgotPasswordPage()">Forgot password?</button>
          </div>

          <div id="signin-message" class="message"></div>
        </form>

        <!-- SIGN UP -->
        <form id="signup-form" class="hidden">
          <label for="signup-fullname">Full name</label>
          <input id="signup-fullname" type="text" placeholder="Saheed Samad" autocomplete="name" required />

          <label for="signup-role">Role</label>
          <select id="signup-role" required>
            <option value="">Select role</option>
            <option value="student">Student</option>
            <option value="lecturer">Lecturer</option>
          </select>

          <div id="student-extra" class="hidden">
            <label for="signup-matric">Matric number</label>
            <input id="signup-matric" type="text" placeholder="e.g. CSC/21/1234" autocomplete="off" />
            <div class="hint">
              Make sure this matric number is correct. <strong>You won’t be able to change it later.</strong>
            </div>
          </div>

          <label for="signup-dept">Department</label>
          <input id="signup-dept" type="text" placeholder="Computer Science" autocomplete="organization" required />

          <label for="signup-email">Email</label>
          <input id="signup-email" type="email" placeholder="you@example.com" autocomplete="email" required />

          <div id="lecturer-email-hint" class="hint hidden">
            Lecturers: please use your official <strong>school email</strong>
            (for example <em>name@university.edu</em>). Personal emails like Gmail/Yahoo/Outlook are not allowed.
          </div>

          <label for="signup-password">Password</label>
          <div class="password-row">
            <input id="signup-password" type="password" placeholder="At least 6 characters" autocomplete="new-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signup-password', this)">Show</button>
          </div>

          <label for="signup-password2">Confirm password</label>
          <div class="password-row">
            <input id="signup-password2" type="password" placeholder="Repeat password" autocomplete="new-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('signup-password2', this)">Show</button>
          </div>

          <button id="signup-btn" type="submit" class="primary">
            <span id="signup-text">Create account</span>
            <span id="signup-loader" class="spinner hidden"></span>
          </button>

          <div id="signup-message" class="message"></div>
        </form>

        <!-- ADMIN (THIS IS WHAT YOU WANT: Email + ID + Password) -->
        <form id="admin-form" class="hidden">
          <div class="admin-note">
            Admin accounts are created from above (Super Admin → HOS → HOD).<br />
            Use the login details given to you.
          </div>

          <label for="admin-email">Email</label>
          <input id="admin-email" type="email" placeholder="admin@school.edu" autocomplete="email" required />

          <label for="admin-loginid">Login ID</label>
          <input id="admin-loginid" type="text" placeholder="e.g. HOD-CSC-001" autocomplete="off" required />

          <label for="admin-password">Password</label>
          <div class="password-row">
            <input id="admin-password" type="password" placeholder="••••••••" autocomplete="current-password" required />
            <button type="button" class="password-toggle" onclick="togglePassword('admin-password', this)">Show</button>
          </div>

          <button id="admin-btn" type="submit" class="primary">
            <span id="admin-text">Login</span>
            <span id="admin-loader" class="spinner hidden"></span>
          </button>

          <div id="admin-message" class="message"></div>
        </form>

        <div id="switch-row" class="bottom-row" style="margin-top:16px;">
          <span id="switch-text" style="font-size:13px; color:var(--muted);">Don’t have an account?</span>
          <button type="button" class="text-link" onclick="toggleAuthMode()">
            <span id="switch-link-label">Create one</span>
          </button>
        </div>

        <p class="location-note">
          <strong>Colspot uses your location to work properly.</strong><br>
          Please allow location when asked, and make sure Location is turned ON.
        </p>
      </div>
    </div>
  </div>

  <script>
    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const hidden = input.type === "password";
      input.type = hidden ? "text" : "password";
      if (btn) btn.textContent = hidden ? "Hide" : "Show";
    }
  </script>

  <!-- Supabase client -->
  <script type="module" src="./client_supabase.js"></script>
  <!-- Your Auth logic (this defines switchMode/signin/signup) -->
  <script src="./auth.js"></script>

  <!-- ✅ IMPORTANT: Admin wrapper MUST be AFTER auth.js -->
  <script>
    (function adminModeWrapper_AFTER_authjs() {
      const titleEl = document.getElementById('card-title');
      const subEl = document.getElementById('card-subtitle');

      const tabSignin = document.getElementById('tab-signin');
      const tabSignup = document.getElementById('tab-signup');
      const tabAdmin  = document.getElementById('tab-admin');

      const signInForm = document.getElementById('signin-form');
      const signUpForm = document.getElementById('signup-form');
      const adminForm  = document.getElementById('admin-form');

      const switchRow = document.getElementById('switch-row');

      function setActive(tab) {
        [tabSignin, tabSignup, tabAdmin].forEach(b => b && b.classList.remove('active'));
        if (tab) tab.classList.add('active');
      }

      function showAdmin() {
        if (titleEl) titleEl.textContent = 'Admin login';
        if (subEl) subEl.textContent = 'Sign in to your Colspot admin account';

        if (signInForm) signInForm.classList.add('hidden');
        if (signUpForm) signUpForm.classList.add('hidden');
        if (adminForm)  adminForm.classList.remove('hidden');

        if (switchRow) switchRow.classList.add('hidden');
        setActive(tabAdmin);
      }

      function exitAdminTo(mode) {
        if (adminForm) adminForm.classList.add('hidden');
        if (switchRow) switchRow.classList.remove('hidden');

        if (mode === 'signup') {
          if (titleEl) titleEl.textContent = 'Create account';
          if (subEl) subEl.textContent = 'Sign up for Colspot';
          if (signInForm) signInForm.classList.add('hidden');
          if (signUpForm) signUpForm.classList.remove('hidden');
          setActive(tabSignup);
        } else {
          if (titleEl) titleEl.textContent = 'Welcome back';
          if (subEl) subEl.textContent = 'Sign in to your Colspot account';
          if (signUpForm) signUpForm.classList.add('hidden');
          if (signInForm) signInForm.classList.remove('hidden');
          setActive(tabSignin);
        }
      }

      const originalSwitchMode = window.switchMode;

      window.switchMode = function(mode) {
        if (mode === 'admin') {
          showAdmin();
          return;
        }

        // leaving admin
        if (adminForm && !adminForm.classList.contains('hidden')) {
          exitAdminTo(mode);
        }

        // let your original auth.js handle signin/signup
        if (typeof originalSwitchMode === 'function') {
          return originalSwitchMode(mode);
        }

        // fallback
        exitAdminTo(mode);
      };
    })();
  </script>
</body>
</html>
