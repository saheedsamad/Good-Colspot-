      color:#0f172a;
      font-weight:900;
      text-align:right;
    }

    .empty-state{
      min-height:320px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:24px;
      text-align:center;
      color:var(--muted);
      font-size:15px;
      line-height:1.6;
    }

    .empty-state-box{
      max-width:420px;
    }

    .empty-state-icon{
      width:74px;
      height:74px;
      border-radius:24px;
      margin:0 auto 16px;
      background:#eff6ff;
      color:#2563eb;
      display:grid;
      place-items:center;
    }

    .empty-state-icon svg{
      width:34px;
      height:34px;
    }

    .empty-state-title{
      margin:0 0 8px;
      font-size:20px;
      font-weight:900;
      color:#0f172a;
    }

    .empty-state-text{
      margin:0;
      color:var(--muted);
      font-size:14px;
      line-height:1.6;
    }

    .mobile-anchor-bar{
      display:none;
    }

    .js-placeholder{
      display:none;
    }

    @media (max-width: 1400px){
      .summary-grid{
        grid-template-columns:repeat(2, minmax(0,1fr));
      }

      .respondent-summary{
        grid-template-columns:repeat(2, minmax(0,1fr));
      }

      .summary-panels{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 1180px){
      .content{
        grid-template-columns:1fr;
      }

      .sidebar{
        display:none;
      }

      .app-shell{
        grid-template-columns:1fr;
      }

      .main{
        padding:12px;
      }

      .main-card{
        min-height:calc(100vh - 24px);
        border-radius:24px;
      }

      .left-col{
        order:2;
      }

      .right-col{
        order:1;
      }

      .mobile-anchor-bar{
        display:flex;
        gap:10px;
        overflow:auto;
        padding:2px 2px 2px 0;
      }

      .mobile-anchor{
        min-height:42px;
        padding:0 14px;
        border-radius:999px;
        border:1px solid var(--line);
        background:#fff;
        color:#0f172a;
        font-size:13px;
        font-weight:800;
        white-space:nowrap;
      }
    }

    @media (max-width: 980px){
      .topbar{
        flex-direction:column;
        align-items:flex-start;
      }

      .topbar-right{
        width:100%;
        flex-wrap:wrap;
      }

      .filters-wrap{
        grid-template-columns:1fr 1fr;
      }

      .responses-layout{
        grid-template-columns:1fr;
      }

      .responses-list{
        border-right:none;
        border-bottom:1px solid var(--line);
      }
    }

    @media (max-width: 720px){
      .page-title{
        font-size:24px;
      }

      .summary-grid{
        grid-template-columns:1fr;
      }

      .respondent-summary{
        grid-template-columns:1fr;
      }

      .filters-wrap{
        grid-template-columns:1fr;
      }

      .response-detail-head{
        padding:18px;
      }

      .answers-wrap{
        padding:16px;
      }

      .card-body,
      .card-head{
        padding-left:16px;
        padding-right:16px;
      }

      .section-head{
        padding:16px;
      }

      .responses-list-head{
        padding:16px;
      }

      .response-item{
        padding:14px 16px;
      }
    }

    @media (max-width: 560px){
      .main{
        padding:0;
      }

      .main-card{
        min-height:100vh;
        border-radius:0;
        border:none;
      }

      .topbar{
        padding:16px;
      }

      .content{
        padding:12px;
      }

      .top-chip{
        width:100%;
        justify-content:flex-start;
      }

      .head-actions{
        width:100%;
      }

      .head-actions .btn{
        width:100%;
      }
    }
  </style>
</head>
