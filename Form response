<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  />
  <title>Colspot • Form Response Summary</title>

  <style>
    :root{
      --bg:#eef3ff;
      --panel:#ffffff;
      --panel-2:#f7f9ff;
      --line:#dfe7fb;
      --line-soft:#e9efff;
      --text:#16213d;
      --muted:#6d7895;
      --blue:#2962ff;
      --blue-2:#4d7dff;
      --blue-3:#e9f0ff;
      --nav:#0d1c4c;
      --nav-2:#132863;
      --shadow:0 18px 45px rgba(29, 53, 120, .12);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:16px;
      --radius-sm:12px;
    }

    *{ box-sizing:border-box; }

    html,body{
      margin:0;
      padding:0;
      background:
        radial-gradient(circle at top left, rgba(92,126,255,.20), transparent 28%),
        linear-gradient(180deg, #edf2ff 0%, #eef3ff 100%);
      color:var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body{
      min-height:100vh;
      padding:28px;
    }

    button,
    input,
    select{
      font:inherit;
    }

    .page-shell{
      width:min(1440px, 100%);
      margin:0 auto;
      display:grid;
      grid-template-columns: 290px minmax(0, 1fr);
      gap:22px;
      align-items:start;
    }

    .sidebar{
      background:
        linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02)),
        linear-gradient(180deg, var(--nav) 0%, var(--nav-2) 100%);
      color:#fff;
      border-radius:30px;
      overflow:hidden;
      box-shadow:var(--shadow);
      min-height:calc(100vh - 56px);
      display:flex;
      flex-direction:column;
      position:sticky;
      top:28px;
    }

    .sidebar-top{
      padding:24px 20px 20px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .brand-badge{
      width:42px;
      height:42px;
      border-radius:14px;
      display:grid;
      place-items:center;
      background:rgba(255,255,255,.10);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
      flex:0 0 auto;
    }

    .brand-badge svg{
      width:22px;
      height:22px;
      color:#fff;
    }

    .brand-copy{
      min-width:0;
    }

    .brand-copy h1{
      margin:0;
      font-size:18px;
      line-height:1;
      letter-spacing:.02em;
      font-weight:900;
    }

    .brand-copy p{
      margin:4px 0 0;
      color:rgba(255,255,255,.72);
      font-size:12px;
      font-weight:600;
    }

    .side-nav{
      padding:18px 14px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .side-link{
      width:100%;
      border:0;
      background:transparent;
      color:rgba(255,255,255,.84);
      display:flex;
      align-items:center;
      gap:12px;
      text-align:left;
      padding:14px 14px;
      border-radius:16px;
      cursor:default;
      font-weight:700;
      transition:.18s ease;
    }

    .side-link svg{
      width:20px;
      height:20px;
      flex:0 0 auto;
    }

    .side-link.active{
      background:linear-gradient(90deg, rgba(56,104,255,.95), rgba(73,145,255,.98));
      color:#fff;
      box-shadow:0 10px 25px rgba(41,98,255,.28);
    }

    .side-link.placeholder{
      opacity:.88;
    }

    .sidebar-bottom{
      margin-top:auto;
      padding:18px 14px 16px;
      border-top:1px solid rgba(255,255,255,.08);
    }

    .school-card{
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.06);
      border-radius:20px;
      padding:14px 14px 16px;
    }

    .school-card span{
      display:block;
      color:rgba(255,255,255,.64);
      font-size:11px;
      letter-spacing:.08em;
      font-weight:800;
      text-transform:uppercase;
      margin-bottom:6px;
    }

    .school-card strong{
      display:block;
      font-size:18px;
      line-height:1.25;
      color:#fff;
      font-weight:900;
      word-break:break-word;
    }

    .main{
      min-width:0;
      display:flex;
      flex-direction:column;
      gap:18px;
    }

    .topbar{
      background:rgba(255,255,255,.74);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      border:1px solid rgba(223,231,251,.95);
      border-radius:24px;
      padding:16px 18px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      box-shadow:var(--shadow);
    }

    .topbar-left{
      display:flex;
      align-items:center;
      gap:14px;
      min-width:0;
    }

    .back-btn{
      width:42px;
      height:42px;
      border-radius:14px;
      border:1px solid var(--line);
      background:#fff;
      display:grid;
      place-items:center;
      color:var(--text);
      flex:0 0 auto;
    }

    .back-btn svg{
      width:18px;
      height:18px;
    }

    .topbar-title{
      min-width:0;
    }

    .topbar-title h2{
      margin:0;
      font-size:19px;
      line-height:1.1;
      font-weight:900;
      color:var(--text);
    }

    .topbar-title p{
      margin:5px 0 0;
      font-size:13px;
      color:var(--muted);
      font-weight:600;
    }

    .topbar-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .action-btn{
      height:44px;
      padding:0 16px;
      border-radius:14px;
      border:1px solid var(--line);
      background:#fff;
      color:var(--text);
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:10px;
    }

    .action-btn svg{
      width:18px;
      height:18px;
    }

    .action-btn.danger{
      color:#c24b4b;
      border-color:#f1cccc;
      background:#fff;
    }

    .content-card{
      background:rgba(255,255,255,.80);
      border:1px solid rgba(223,231,251,.96);
      border-radius:30px;
      padding:18px;
      box-shadow:var(--shadow);
    }

    .hero-card{
      padding:22px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.90), rgba(246,249,255,.98));
    }

    .hero-top{
      display:flex;
      justify-content:space-between;
      gap:18px;
      align-items:flex-start;
      flex-wrap:wrap;
      margin-bottom:18px;
    }

    .hero-copy{
      min-width:0;
    }

    .hero-copy h3{
      margin:0;
      font-size:18px;
      color:var(--muted);
      font-weight:800;
    }

    .hero-copy h1{
      margin:8px 0 0;
      font-size:40px;
      line-height:1.05;
      letter-spacing:-.02em;
      font-weight:900;
      color:var(--text);
      word-break:break-word;
    }

    .hero-copy .sub{
      margin:10px 0 0;
      font-size:18px;
      color:var(--muted);
      font-weight:700;
    }

    .hero-copy .byline{
      margin:8px 0 0;
      font-size:16px;
      color:#7180a7;
      font-weight:700;
    }

    .hero-meta{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .meta-chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:40px;
      padding:0 14px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      color:#41506f;
      font-size:13px;
      font-weight:800;
    }

    .meta-chip svg{
      width:16px;
      height:16px;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:16px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px;
      min-height:154px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      box-shadow:0 10px 25px rgba(55, 84, 170, .05);
    }

    .stat-icon{
      width:44px;
      height:44px;
      border-radius:14px;
      background:var(--blue-3);
      color:var(--blue);
      display:grid;
      place-items:center;
    }

    .stat-icon svg{
      width:22px;
      height:22px;
    }

    .stat-value{
      font-size:44px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--text);
      margin-top:18px;
      word-break:break-word;
    }

    .stat-value.smaller{
      font-size:34px;
      line-height:1.05;
    }

    .stat-label{
      margin-top:10px;
      color:var(--muted);
      font-size:15px;
      font-weight:800;
    }

    .row-grid{
      display:grid;
      grid-template-columns:1.35fr 1fr 1fr;
      gap:18px;
    }

    .box-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      padding:20px;
      box-shadow:0 10px 25px rgba(55, 84, 170, .05);
      min-width:0;
    }

    .box-title{
      margin:0;
      font-size:28px;
      line-height:1.05;
      font-weight:900;
      color:var(--text);
    }

    .box-sub{
      margin:8px 0 0;
      color:var(--muted);
      font-size:14px;
      font-weight:700;
    }

    .donut-wrap{
      margin-top:22px;
      display:grid;
      grid-template-columns:220px minmax(0, 1fr);
      gap:20px;
      align-items:center;
    }

    .donut{
      width:220px;
      height:220px;
      border-radius:50%;
      position:relative;
      background:
        conic-gradient(
          #6f95ff 0 21%,
          #9dd7c4 21% 39%,
          #f0b07b 39% 51%,
          #e37784 51% 61%,
          #7eacf0 61% 69%,
          #b3c8f6 69% 100%
        );
      display:grid;
      place-items:center;
      margin:0 auto;
    }

    .donut::before{
      content:"";
      width:124px;
      height:124px;
      border-radius:50%;
      background:#fff;
      box-shadow:inset 0 0 0 1px var(--line-soft);
      position:absolute;
    }

    .donut-center{
      position:relative;
      z-index:1;
      text-align:center;
      padding:0 16px;
    }

    .donut-center strong{
      display:block;
      font-size:42px;
      line-height:1;
      font-weight:900;
      color:var(--text);
    }

    .donut-center span{
      display:block;
      margin-top:8px;
      font-size:13px;
      color:var(--muted);
      font-weight:800;
    }

    .legend{
      display:flex;
      flex-direction:column;
      gap:14px;
      min-width:0;
    }

    .legend-row{
      display:grid;
      grid-template-columns:auto minmax(0, 1fr) auto;
      align-items:center;
      gap:12px;
      font-size:15px;
      font-weight:800;
      color:#41506f;
    }

    .legend-dot{
      width:13px;
      height:13px;
      border-radius:50%;
      flex:0 0 auto;
    }

    .legend-dot.blue{ background:#6f95ff; }
    .legend-dot.mint{ background:#9dd7c4; }
    .legend-dot.orange{ background:#f0b07b; }
    .legend-dot.red{ background:#e37784; }
    .legend-dot.sky{ background:#7eacf0; }
    .legend-dot.soft{ background:#b3c8f6; }

    .legend-name{
      min-width:0;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .legend-count{
      color:var(--text);
      font-weight:900;
    }

    .breakdown-list{
      margin-top:18px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .breakdown-row{
      display:grid;
      grid-template-columns:minmax(0, 1fr) auto;
      gap:12px;
      align-items:center;
    }

    .breakdown-left{
      min-width:0;
    }

    .breakdown-name{
      font-size:15px;
      font-weight:800;
      color:#3f4e6d;
      margin-bottom:7px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .bar{
      height:10px;
      background:#edf2ff;
      border-radius:999px;
      overflow:hidden;
      position:relative;
    }

    .bar > span{
      display:block;
      height:100%;
      border-radius:999px;
      background:linear-gradient(90deg, #6b8fff, #8fb0ff);
      width:0;
    }

    .bar.w16 > span{ width:16%; }
    .bar.w28 > span{ width:28%; }
    .bar.w42 > span{ width:42%; }
    .bar.w61 > span{ width:61%; }
    .bar.w73 > span{ width:73%; }
    .bar.w88 > span{ width:88%; }
    .bar.w97 > span{ width:97%; }

    .breakdown-value{
      font-size:18px;
      font-weight:900;
      color:var(--text);
    }

    .info-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:18px;
    }

    .info-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:24px;
      padding:20px;
      box-shadow:0 10px 25px rgba(55, 84, 170, .05);
      min-width:0;
    }

    .info-title{
      margin:0 0 16px;
      font-size:26px;
      line-height:1.05;
      font-weight:900;
      color:var(--text);
    }

    .info-list{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .info-row{
      display:grid;
      grid-template-columns:minmax(0, 1fr) auto;
      gap:14px;
      align-items:center;
      padding:14px 0;
      border-top:1px solid var(--line-soft);
    }

    .info-row:first-child{
      border-top:0;
      padding-top:0;
    }

    .info-key{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
      color:#4a5878;
      font-size:15px;
      font-weight:800;
    }

    .info-key svg{
      width:18px;
      height:18px;
      color:#6f83ba;
      flex:0 0 auto;
    }

    .info-value{
      min-width:0;
      color:var(--text);
      font-size:16px;
      font-weight:900;
      text-align:right;
      word-break:break-word;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:34px;
      padding:0 12px;
      border-radius:999px;
      background:var(--blue-3);
      color:#4c67c6;
      font-size:13px;
      font-weight:900;
      border:1px solid #dce6ff;
    }

    .question-count-card{
      margin-top:18px;
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px 20px;
      box-shadow:0 10px 25px rgba(55, 84, 170, .05);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      min-width:0;
    }

    .question-count-card h4{
      margin:0;
      font-size:24px;
      line-height:1.05;
      font-weight:900;
      color:var(--text);
    }

    .question-badge{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:0 15px;
      min-height:44px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      font-weight:900;
      color:#42506f;
      white-space:nowrap;
    }

    .question-badge svg{
      width:18px;
      height:18px;
    }

    .placeholder-card{
      margin-top:18px;
      background:#fff;
      border:1px dashed #cad6f6;
      border-radius:24px;
      padding:24px;
      text-align:center;
      color:var(--muted);
      font-weight:800;
      display:none;
    }

    .mobile-note{
      display:none;
    }

    @media (max-width: 1260px){
      .stats-grid{
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }

      .row-grid{
        grid-template-columns:1fr;
      }

      .info-grid{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 960px){
      body{
        padding:16px;
      }

      .page-shell{
        grid-template-columns:1fr;
      }

      .sidebar{
        min-height:auto;
        position:relative;
        top:0;
      }

      .side-nav{
        flex-direction:row;
        overflow:auto;
        padding-top:14px;
      }

      .side-link{
        min-width:170px;
      }

      .sidebar-bottom{
        display:none;
      }

      .hero-copy h1{
        font-size:32px;
      }

      .donut-wrap{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 680px){
      .topbar{
        padding:14px;
        border-radius:18px;
      }

      .topbar-title h2{
        font-size:17px;
      }

      .topbar-actions{
        width:100%;
        justify-content:stretch;
      }

      .action-btn{
        flex:1 1 auto;
        justify-content:center;
      }

      .content-card{
        border-radius:22px;
        padding:14px;
      }

      .hero-card{
        padding:16px;
      }

      .hero-copy h1{
        font-size:27px;
      }

      .hero-copy .sub{
        font-size:16px;
      }

      .stats-grid{
        grid-template-columns:1fr;
      }

      .stat-card{
        min-height:132px;
      }

      .stat-value{
        font-size:38px;
      }

      .stat-value.smaller{
        font-size:28px;
      }

      .box-card,
      .info-card{
        border-radius:20px;
        padding:16px;
      }

      .box-title,
      .info-title,
      .question-count-card h4{
        font-size:22px;
      }

      .donut{
        width:190px;
        height:190px;
      }

      .donut::before{
        width:108px;
        height:108px;
      }

      .donut-center strong{
        font-size:34px;
      }

      .question-count-card{
        flex-direction:column;
        align-items:flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="page-shell">
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-badge">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M8 12.5 11 15.5 17 8.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.7"/>
            </svg>
          </div>
          <div class="brand-copy">
            <h1>COLSPOT</h1>
            <p>Form response panel</p>
          </div>
        </div>
      </div>

      <nav class="side-nav">
        <button class="side-link active" type="button">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 6.5h16M7 12h10M9 17.5h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>Summary</span>
        </button>

        <button class="side-link placeholder" type="button">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M8 8h8M8 12h8M8 16h5M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
          </svg>
          <span>Questions</span>
        </button>

        <button class="side-link placeholder" type="button">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 7a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
          </svg>
          <span>Individual</span>
        </button>

        <button class="side-link placeholder" type="button">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Export</span>
        </button>
      </nav>

      <div class="sidebar-bottom">
        <div class="school-card">
          <span>School</span>
          <strong id="summarySchoolName">School name here</strong>
        </div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="back-btn" type="button" aria-label="Back">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="topbar-title">
            <h2>Summary</h2>
            <p>Form response overview</p>
          </div>
        </div>

        <div class="topbar-actions">
          <button class="action-btn" id="previewFormBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.9"/>
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.9"/>
            </svg>
            <span>Preview Form</span>
          </button>

          <button class="action-btn danger" id="closeFormBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span>Close Form</span>
          </button>
        </div>
      </header>

      <section class="content-card hero-card">
        <div class="hero-top">
          <div class="hero-copy">
            <h3>Form Summary</h3>
            <h1 id="summaryFormTitle">Form title here</h1>
            <p class="sub" id="summaryFormAudience">Audience here</p>
            <p class="byline" id="summaryFormCreator">Created by lecturer / HOS here</p>
          </div>

          <div class="hero-meta">
            <div class="meta-chip" id="summaryStatusChip">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Status</span>
            </div>

            <div class="meta-chip" id="summaryIdentityChip">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 7a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
              </svg>
              <span>Identity mode</span>
            </div>
          </div>
        </div>

        <div class="stats-grid">
          <article class="stat-card">
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm11 14v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="stat-value" id="statTotalResponses">0</div>
            <div class="stat-label">Total Responses</div>
          </article>

          <article class="stat-card">
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 20V10M12 10l-4 4M12 10l4 4M5 4h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="stat-value" id="statResponseRate">0%</div>
            <div class="stat-label">Response Rate</div>
          </article>

          <article class="stat-card">
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.9"/>
                <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="stat-value smaller" id="statLatestSubmission">—</div>
            <div class="stat-label">Latest Submission</div>
          </article>

          <article class="stat-card">
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="stat-value" id="statCompletionRate">0%</div>
            <div class="stat-label">Completion Rate</div>
          </article>
        </div>
      </section>

      <section class="row-grid">
        <article class="box-card">
          <h3 class="box-title">Programme Breakdown</h3>
          <p class="box-sub">Submitted responses grouped by programme.</p>

          <div class="donut-wrap">
            <div class="donut">
              <div class="donut-center">
                <strong id="programmeBreakdownTotal">0</strong>
                <span>responses</span>
              </div>
            </div>

            <div class="legend" id="programmeLegendList">
              <div class="legend-row">
                <span class="legend-dot blue"></span>
                <span class="legend-name">No programme data yet</span>
                <span class="legend-count">0</span>
              </div>
            </div>
          </div>
        </article>

        <article class="box-card">
          <h3 class="box-title">Level Breakdown</h3>
          <p class="box-sub">Submitted responses grouped by level.</p>

          <div class="breakdown-list" id="levelBreakdownList">
            <div class="breakdown-row">
              <div class="breakdown-left">
                <div class="breakdown-name">No level data yet</div>
                <div class="bar w16"><span></span></div>
              </div>
              <div class="breakdown-value">0</div>
            </div>
          </div>
        </article>

        <article class="box-card">
          <h3 class="box-title">Identity Breakdown</h3>
          <p class="box-sub">How responses were submitted.</p>

          <div class="donut-wrap" style="grid-template-columns:1fr;">
            <div class="donut" style="background:conic-gradient(#5f86ff 0 50%, #c9d7ff 50% 100%);">
              <div class="donut-center">
                <strong id="identityBreakdownPercent">0%</strong>
                <span>identified</span>
              </div>
            </div>

            <div class="legend" id="identityLegendList">
              <div class="legend-row">
                <span class="legend-dot blue"></span>
                <span class="legend-name">Identified</span>
                <span class="legend-count" id="identityIdentifiedCount">0</span>
              </div>
              <div class="legend-row">
                <span class="legend-dot soft"></span>
                <span class="legend-name">Anonymous</span>
                <span class="legend-count" id="identityAnonymousCount">0</span>
              </div>
            </div>
          </div>
        </article>
      </section>

      <section class="info-grid">
        <article class="info-card">
          <h3 class="info-title">Form Information</h3>

          <div class="info-list">
            <div class="info-row">
              <div class="info-key">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 7h8M8 12h8M8 17h5M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                <span>Questions</span>
              </div>
              <div class="info-value" id="infoQuestionCount">0</div>
            </div>

            <div class="info-row">
              <div class="info-key">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 2v4M16 2v4M4 10h16M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
                <span>Open Date</span>
              </div>
              <div class="info-value" id="infoOpenDate">—</div>
            </div>

            <div class="info-row">
              <div class="info-key">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 2v4M16 2v4M4 10h16M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
                <span>Close Date</span>
              </div>
              <div class="info-value" id="infoCloseDate">—</div>
            </div>

            <div class="info-row">
              <div class="info-key">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 7a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                </svg>
                <span>Identity</span>
              </div>
              <div class="info-value">
                <span class="pill" id="infoIdentityMode">—</span>
              </div>
            </div>

            <div class="info-row">
              <div class="info-key">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 7.5 12 3l9 4.5-9 4.5L3 7.5Zm3 3.5v4.5L12 19l6-3.5V11" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Audience</span>
              </div>
              <div class="info-value" id="infoAudience">—</div>
            </div>
          </div>
        </article>

        <div>
          <article class="info-card">
            <h3 class="info-title">Audience Information</h3>

            <div class="info-list">
              <div class="info-row">
                <div class="info-key">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M16 3.13a4 4 0 0 1 0 7.75M22 21v-2a4 4 0 0 0-3-3.87M10 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>Expected Students</span>
                </div>
                <div class="info-value" id="audienceExpectedStudents">0</div>
              </div>

              <div class="info-row">
                <div class="info-key">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>Actual Submissions</span>
                </div>
                <div class="info-value" id="audienceActualSubmissions">0</div>
              </div>
            </div>
          </article>

          <article class="question-count-card">
            <h4>Question Count</h4>
            <div class="question-badge">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M8 7h8M8 12h8M8 17h5M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
              <span id="questionCountBadge">0 Questions</span>
            </div>
          </article>
        </div>
      </section>

