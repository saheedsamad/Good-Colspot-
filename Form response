<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Form Responses</title>

  <style>
    :root{
      --bg:#eef4ff;
      --panel:#ffffff;
      --panel-2:#f8fbff;
      --line:#e5edf8;
      --line-strong:#d9e6f7;
      --text:#0f172a;
      --muted:#64748b;
      --muted-2:#94a3b8;
      --navy:#0f2350;
      --navy-2:#122b63;
      --blue:#2563eb;
      --blue-2:#3b82f6;
      --blue-3:#eaf2ff;
      --green:#16a34a;
      --green-soft:#eafaf0;
      --amber:#d97706;
      --amber-soft:#fff7ed;
      --red:#dc2626;
      --red-soft:#fef2f2;
      --shadow:0 20px 50px rgba(15, 23, 42, 0.10);
      --shadow-soft:0 10px 30px rgba(15, 23, 42, 0.08);
      --radius-xl:28px;
      --radius-lg:22px;
      --radius-md:16px;
      --radius-sm:12px;
      --sidebar:320px;
      --topbar-h:86px;
    }

    *{
      box-sizing:border-box;
    }

    html,
    body{
      margin:0;
      padding:0;
      background:linear-gradient(180deg,#f4f8ff 0%, #edf4ff 100%);
      color:var(--text);
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height:100%;
    }

    button,
    input,
    textarea,
    select{
      font:inherit;
    }

    a{
      color:inherit;
      text-decoration:none;
    }

    .app-shell{
      min-height:100vh;
      display:grid;
      grid-template-columns:var(--sidebar) 1fr;
      background:var(--bg);
    }

    .sidebar{
      position:sticky;
      top:0;
      height:100vh;
      padding:16px;
      background:linear-gradient(180deg, #0d1e47 0%, #10285d 52%, #0b1c42 100%);
      color:#fff;
      overflow:auto;
      border-right:1px solid rgba(255,255,255,.08);
    }

    .sidebar-card{
      min-height:calc(100vh - 32px);
      display:flex;
      flex-direction:column;
      border-radius:30px;
      background:linear-gradient(180deg, rgba(255,255,255,.03) 0%, rgba(255,255,255,.01) 100%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);
      overflow:hidden;
    }

    .brand-block{
      display:flex;
      align-items:center;
      gap:14px;
      padding:18px 18px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .brand-badge{
      width:48px;
      height:48px;
      border-radius:16px;
      display:grid;
      place-items:center;
      background:rgba(255,255,255,.08);
      flex-shrink:0;
    }

    .brand-badge svg{
      width:24px;
      height:24px;
      color:#fff;
    }

    .brand-copy{
      min-width:0;
    }

    .brand-copy .small{
      display:block;
      font-size:11px;
      font-weight:800;
      letter-spacing:.12em;
      color:rgba(255,255,255,.72);
      text-transform:uppercase;
      margin-bottom:2px;
    }

    .brand-copy .big{
      display:block;
      font-size:17px;
      line-height:1.15;
      font-weight:900;
      color:#fff;
    }

    .brand-copy .sub{
      display:block;
      font-size:12px;
      color:rgba(255,255,255,.72);
      margin-top:4px;
    }

    .sidebar-nav{
      padding:12px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .nav-link{
      display:flex;
      align-items:center;
      gap:12px;
      min-height:56px;
      padding:0 16px;
      border-radius:18px;
      color:rgba(255,255,255,.90);
      transition:background .18s ease, transform .18s ease, color .18s ease;
    }

    .nav-link:hover{
      background:rgba(255,255,255,.06);
      transform:translateY(-1px);
    }

    .nav-link.active{
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 100%);
      box-shadow:0 16px 28px rgba(37,99,235,.28);
      color:#fff;
    }

    .nav-link svg{
      width:20px;
      height:20px;
      flex-shrink:0;
    }

    .nav-copy{
      min-width:0;
      display:flex;
      flex-direction:column;
      gap:2px;
    }

    .nav-title{
      font-size:15px;
      font-weight:800;
      line-height:1.15;
    }

    .nav-sub{
      font-size:12px;
      color:rgba(255,255,255,.62);
    }

    .nav-link.active .nav-sub{
      color:rgba(255,255,255,.82);
    }

    .sidebar-foot{
      margin-top:auto;
      padding:14px 14px 16px;
      border-top:1px solid rgba(255,255,255,.08);
    }

    .school-badge{
      border-radius:22px;
      padding:16px;
      background:rgba(255,255,255,.07);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);
    }

    .school-badge .label{
      display:block;
      font-size:11px;
      letter-spacing:.1em;
      font-weight:800;
      color:rgba(255,255,255,.62);
      text-transform:uppercase;
      margin-bottom:5px;
    }

    .school-badge .value{
      display:block;
      font-size:17px;
      font-weight:900;
      color:#fff;
      line-height:1.2;
      word-break:break-word;
    }

    .main{
      min-width:0;
      padding:18px;
    }

    .main-card{
      min-height:calc(100vh - 36px);
      background:rgba(255,255,255,.55);
      border:1px solid rgba(255,255,255,.6);
      border-radius:32px;
      box-shadow:var(--shadow);
      backdrop-filter:blur(10px);
      overflow:hidden;
      display:flex;
      flex-direction:column;
    }

    .topbar{
      min-height:var(--topbar-h);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      padding:18px 22px;
      border-bottom:1px solid var(--line);
      background:rgba(255,255,255,.72);
      backdrop-filter:blur(8px);
    }

    .topbar-left{
      min-width:0;
      display:flex;
      align-items:center;
      gap:14px;
    }

    .back-btn{
      width:50px;
      height:50px;
      border:none;
      border-radius:16px;
      background:#fff;
      box-shadow:var(--shadow-soft);
      display:grid;
      place-items:center;
      cursor:pointer;
      transition:transform .18s ease, box-shadow .18s ease;
      flex-shrink:0;
    }

    .back-btn:hover{
      transform:translateY(-1px);
    }

    .back-btn svg{
      width:22px;
      height:22px;
      color:#0f172a;
    }

    .page-head{
      min-width:0;
    }

    .page-title{
      font-size:28px;
      font-weight:900;
      line-height:1.08;
      margin:0;
      color:#0f172a;
    }

    .page-sub{
      margin:6px 0 0;
      font-size:14px;
      color:var(--muted);
      line-height:1.45;
    }

    .topbar-right{
      display:flex;
      align-items:center;
      gap:12px;
      flex-shrink:0;
    }

    .top-chip{
      min-height:42px;
      padding:0 14px;
      border-radius:999px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      background:#fff;
      border:1px solid var(--line);
      color:#0f172a;
      font-size:13px;
      font-weight:800;
      white-space:nowrap;
    }

    .top-chip svg{
      width:16px;
      height:16px;
    }

    .content{
      min-width:0;
      flex:1;
      display:grid;
      grid-template-columns:280px minmax(0, 1fr);
      gap:18px;
      padding:18px;
    }

    .left-col,
    .right-col{
      min-width:0;
    }

    .stack{
      display:flex;
      flex-direction:column;
      gap:16px;
    }

    .card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:var(--shadow-soft);
      overflow:hidden;
    }

    .card-head{
      padding:18px 18px 14px;
      border-bottom:1px solid var(--line);
    }

    .card-title{
      font-size:18px;
      font-weight:900;
      line-height:1.15;
      margin:0;
      color:#0f172a;
    }

    .card-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
    }

    .card-body{
      padding:18px;
    }

    .overview-list{
      display:flex;
      flex-direction:column;
      gap:12px;
    }

    .overview-item{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      padding:12px 0;
      border-bottom:1px dashed var(--line);
    }

    .overview-item:last-child{
      border-bottom:none;
      padding-bottom:0;
    }

    .overview-label{
      font-size:12px;
      color:var(--muted);
      font-weight:800;
      letter-spacing:.04em;
      text-transform:uppercase;
    }

    .overview-value{
      font-size:14px;
      color:#0f172a;
      font-weight:800;
      text-align:right;
      line-height:1.4;
      max-width:58%;
      word-break:break-word;
    }

    .status-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:34px;
      padding:0 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:900;
      white-space:nowrap;
    }

    .status-pill svg{
      width:14px;
      height:14px;
    }

    .status-pill.published{
      background:var(--green-soft);
      color:var(--green);
    }

    .status-pill.draft{
      background:var(--amber-soft);
      color:var(--amber);
    }

    .status-pill.closed{
      background:#eff6ff;
      color:#1d4ed8;
    }

    .status-pill.archived{
      background:#f1f5f9;
      color:#475569;
    }

    .side-nav{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .side-link{
      min-height:52px;
      padding:0 16px;
      border-radius:16px;
      border:1px solid var(--line);
      background:#fff;
      display:flex;
      align-items:center;
      gap:12px;
      color:#0f172a;
      font-weight:800;
      cursor:pointer;
      transition:transform .18s ease, border-color .18s ease, background .18s ease;
    }

    .side-link:hover{
      transform:translateY(-1px);
      border-color:#cfe0fb;
      background:#f9fbff;
    }

    .side-link.active{
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 100%);
      color:#fff;
      border-color:transparent;
      box-shadow:0 14px 28px rgba(37,99,235,.24);
    }

    .side-link svg{
      width:18px;
      height:18px;
      flex-shrink:0;
    }

    .summary-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:14px;
    }

    .stat-card{
      border:1px solid var(--line);
      background:linear-gradient(180deg,#ffffff 0%, #f9fbff 100%);
      border-radius:20px;
      padding:16px;
      min-height:120px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .stat-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }

    .stat-label{
      font-size:12px;
      color:var(--muted);
      font-weight:800;
      letter-spacing:.04em;
      text-transform:uppercase;
      line-height:1.35;
    }

    .stat-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      display:grid;
      place-items:center;
      background:var(--blue-3);
      color:var(--blue);
      flex-shrink:0;
    }

    .stat-icon svg{
      width:20px;
      height:20px;
    }

    .stat-value{
      font-size:28px;
      font-weight:900;
      line-height:1;
      color:#0f172a;
      margin-top:18px;
    }

    .stat-foot{
      margin-top:8px;
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
    }

    .section-block{
      border:1px solid var(--line);
      border-radius:24px;
      background:#fff;
      overflow:hidden;
    }

    .section-head{
      padding:18px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
    }

    .section-title{
      font-size:20px;
      font-weight:900;
      line-height:1.15;
      margin:0;
    }

    .section-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
    }

    .head-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      flex-shrink:0;
    }

    .btn{
      min-height:44px;
      border:none;
      border-radius:14px;
      padding:0 16px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      transition:transform .18s ease, opacity .18s ease, box-shadow .18s ease;
    }

    .btn:hover{
      transform:translateY(-1px);
    }

    .btn-primary{
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 100%);
      color:#fff;
      box-shadow:0 12px 24px rgba(37,99,235,.22);
    }

    .btn-soft{
      background:#f8fbff;
      color:#0f172a;
      border:1px solid var(--line);
    }

    .btn-danger{
      background:#fff5f5;
      color:#b91c1c;
      border:1px solid #fecaca;
    }

    .btn.is-disabled{
      opacity:.48;
      cursor:not-allowed;
      transform:none;
      box-shadow:none;
    }

    .filters-wrap{
      padding:18px;
      display:grid;
      grid-template-columns:1.3fr repeat(4, minmax(0,1fr));
      gap:12px;
      border-bottom:1px solid var(--line);
      background:#fbfdff;
    }

    .field{
      min-width:0;
    }

    .field-label{
      display:block;
      font-size:12px;
      color:var(--muted);
      font-weight:800;
      letter-spacing:.04em;
      text-transform:uppercase;
      margin:0 0 8px;
    }

    .field-input,
    .field-select{
      width:100%;
      min-height:48px;
      border:1px solid var(--line-strong);
      background:#fff;
      border-radius:14px;
      padding:0 14px;
      outline:none;
      color:#0f172a;
      transition:border-color .18s ease, box-shadow .18s ease;
    }

    .field-input:focus,
    .field-select:focus{
      border-color:#3b82f6;
      box-shadow:0 0 0 4px rgba(59,130,246,.10);
    }

    .responses-layout{
      display:grid;
      grid-template-columns:360px minmax(0,1fr);
      min-height:760px;
    }

    .responses-list{
      border-right:1px solid var(--line);
      background:#fcfdff;
      display:flex;
      flex-direction:column;
      min-width:0;
    }

    .responses-list-head{
      padding:18px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .responses-list-title{
      font-size:17px;
      font-weight:900;
      color:#0f172a;
      margin:0;
    }

    .responses-list-sub{
      margin:5px 0 0;
      font-size:13px;
      color:var(--muted);
    }

    .responses-count{
      min-width:42px;
      height:42px;
      border-radius:14px;
      background:var(--blue-3);
      color:var(--blue);
      font-size:14px;
      font-weight:900;
      display:grid;
      place-items:center;
      flex-shrink:0;
    }

    .response-items{
      display:flex;
      flex-direction:column;
      min-width:0;
    }

    .response-item{
      padding:16px 18px;
      border-bottom:1px solid var(--line);
      cursor:pointer;
      transition:background .18s ease, border-color .18s ease;
    }

    .response-item:hover{
      background:#f8fbff;
    }

    .response-item.active{
      background:#edf5ff;
      box-shadow:inset 3px 0 0 #2563eb;
    }

    .response-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:8px;
    }

    .response-name{
      font-size:15px;
      font-weight:900;
      color:#0f172a;
      line-height:1.25;
      margin:0;
      word-break:break-word;
    }

    .response-tag{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:26px;
      padding:0 10px;
      border-radius:999px;
      background:#eef2ff;
      color:#4338ca;
      font-size:11px;
      font-weight:900;
      white-space:nowrap;
      flex-shrink:0;
    }

    .response-meta{
      display:flex;
      flex-wrap:wrap;
      gap:8px 10px;
      margin-bottom:8px;
    }

    .meta-chip{
      min-height:26px;
      padding:0 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      color:#475569;
      font-size:11px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
    }

    .response-time{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
    }

    .response-detail{
      min-width:0;
      display:flex;
      flex-direction:column;
      background:#fff;
    }

    .response-detail-head{
      padding:22px 22px 18px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }

    .response-detail-title{
      font-size:22px;
      font-weight:900;
      line-height:1.12;
      margin:0;
      color:#0f172a;
    }

    .response-detail-sub{
      margin:8px 0 0;
      color:var(--muted);
      font-size:14px;
      line-height:1.5;
    }

    .response-detail-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .respondent-summary{
      padding:18px 22px;
      border-bottom:1px solid var(--line);
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:12px;
      background:#fbfdff;
    }

    .respondent-box{
      border:1px solid var(--line);
      background:#fff;
      border-radius:16px;
      padding:14px;
    }

    .respondent-label{
      font-size:11px;
      color:var(--muted);
      font-weight:800;
      letter-spacing:.04em;
      text-transform:uppercase;
      margin-bottom:7px;
    }

    .respondent-value{
      font-size:14px;
      color:#0f172a;
      font-weight:900;
      line-height:1.35;
      word-break:break-word;
    }

    .answers-wrap{
      padding:22px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .answer-card{
      border:1px solid var(--line);
      border-radius:20px;
      background:#fff;
      overflow:hidden;
    }

    .answer-head{
      padding:16px 18px 14px;
      border-bottom:1px solid var(--line);
      background:#fbfdff;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
    }

    .answer-title-wrap{
      min-width:0;
    }

    .answer-question{
      margin:0;
      font-size:16px;
      font-weight:900;
      line-height:1.3;
      color:#0f172a;
      word-break:break-word;
    }

    .answer-helper{
      margin:6px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
    }

    .answer-type{
      min-height:28px;
      padding:0 10px;
      border-radius:999px;
      background:#eef2ff;
      color:#4338ca;
      font-size:11px;
      font-weight:900;
      display:inline-flex;
      align-items:center;
      white-space:nowrap;
      flex-shrink:0;
    }

    .answer-body{
      padding:18px;
    }

    .answer-value{
      font-size:15px;
      color:#0f172a;
      line-height:1.65;
      word-break:break-word;
      white-space:pre-wrap;
    }

    .answer-empty{
      color:var(--muted-2);
      font-style:italic;
    }

    .choice-list{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    .choice-pill{
      min-height:34px;
      padding:0 14px;
      border-radius:999px;
      background:#eff6ff;
      color:#1d4ed8;
      border:1px solid #dbeafe;
      font-size:13px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      justify-content:center;
    }

    .file-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .file-row{
      min-height:52px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      padding:10px 14px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .file-name{
      min-width:0;
      font-size:14px;
      font-weight:800;
      color:#0f172a;
      word-break:break-word;
    }

    .file-action{
      min-height:34px;
      padding:0 12px;
      border-radius:10px;
      background:#eff6ff;
      color:#1d4ed8;
      font-size:12px;
      font-weight:900;
      border:none;
      white-space:nowrap;
