<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
/>
  <title>Colspot – Home</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #e5f0ff;
      --bg2: #f8fbff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --shadow-strong: 0 20px 55px rgba(15, 23, 42, 0.18);
      --shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.12);
    }

    * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Inter, sans-serif;
    }

    html, body {
      height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: #ffffff;
      border-radius: 0;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px 0;
      position: relative;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 4px 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-logo {
      height: 32px;
      width: 32px;
      border-radius: 8px;
      overflow: hidden;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-logo img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      display: block;
    }

    .brand-name {
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.02em;
      color: var(--text-main);
    }

    .avatar-chip {
      height: 34px;
      min-width: 34px;
      border-radius: 999px;
      background: linear-gradient(135deg, #1d4ed8, #22c55e);
      color: #f9fafb;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
    }

    main {
      flex: 1;
      overflow-y: auto;
      padding: 0 2px 90px;
    }

    .hero {
      margin: 4px 2px 12px;
    }

    .hero-line-1 {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .hero-title {
      font-size: 22px;
      line-height: 1.25;
      margin: 0 0 14px;
      color: var(--text-main);
      font-weight: 700;
    }

    .hero-title span {
      color: var(--blue);
    }

    .primary-cta {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 12px 16px;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .primary-cta svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .primary-cta:active {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      filter: brightness(0.97);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 20px 4px 8px;
    }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    .section-action {
      font-size: 12px;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }

    .section-action svg {
      width: 12px;
      height: 12px;
    }

    .location-toggle-row {
      display: flex;
      justify-content: flex-start;
      margin: 0 4px 10px;
    }

    .location-toggle {
      border: none;
      background: #f3f4f6;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 11px;
      color: var(--text-main);
      cursor: pointer;
      user-select: none;
    }

    .location-toggle-label {
      font-weight: 500;
    }

    .location-switch {
      width: 32px;
      height: 16px;
      border-radius: 999px;
      background: #d1d5db;
      position: relative;
      flex-shrink: 0;
      transition: background-color 0.18s ease;
    }

    .location-switch-knob {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.4);
      transition: transform 0.18s ease;
    }

    .location-toggle-state {
      font-size: 11px;
      color: var(--text-muted);
    }

    .location-toggle.on .location-switch {
      background: #22c55e;
    }

    .location-toggle.on .location-switch-knob {
      transform: translateX(14px);
    }

    .location-toggle.on .location-toggle-state {
      color: #16a34a;
    }

    .card {
      border-radius: 18px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 12px 12px 11px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .announcement-card {
      margin: 0 2px 6px;
      padding: 10px 12px;
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .announcement-icon {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #1d4ed8;
      margin-top: 2px;
    }

    .announcement-body {
      flex: 1;
    }

    .announcement-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .announcement-text {
      font-size: 11px;
      color: var(--text-main);
    }

    .announcement-close {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 14px;
      cursor: pointer;
      padding: 0;
      margin-left: 4px;
      flex-shrink: 0;
    }

    .update-soft-btn {
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      border: none;
      font-size: 11px;
      font-weight: 600;
      background: #ffffff;
      color: var(--blue);
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
    }

    .update-soft-btn:active {
      transform: scale(0.97);
    }

    .update-hard-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .update-hard-card {
      width: 90%;
      max-width: 380px;
      border-radius: 22px;
      background: #ffffff;
      padding: 18px 16px 16px;
      text-align: center;
      box-shadow: var(--shadow-strong);
    }

    .update-hard-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text-main);
    }

    .update-hard-text {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .update-hard-btn {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      cursor: pointer;
    }

    .update-hard-note {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .nearby-card {
      display: flex;
      gap: 10px;
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at left top, #e0ebff, #f9fafb);
    }

    .nearby-main {
      flex: 1;
      z-index: 1;
    }

    .nearby-title-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }

    .nearby-icon-circle {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1d4ed8;
      flex-shrink: 0;
    }

    .nearby-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .nearby-status {
      font-size: 12px;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .nearby-note {
      font-size: 11px;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(6px);
    }

    .nearby-map {
      width: 90px;
      height: 90px;
      border-radius: 14px;
      background: transparent;
      border: none;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
      margin-left: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: none;
    }

    .nearby-map img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 14px;
    }

    .scan-card {
      margin-top: 14px;
      background: #ffffff;
    }

    .scan-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }

    .scan-card-icon {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #2563eb;
    }

    .scan-card-icon svg {
      width: 18px;
      height: 18px;
    }

    .scan-card-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .scan-card-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .scan-card-button {
      width: 100%;
      margin-top: 6px;
      border-radius: 999px;
      border: none;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .scan-card-button:active {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      filter: brightness(0.97);
    }

    .ai-card {
      margin-top: 14px;
      background: #ffffff;
    }

    .ai-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }

    .ai-card-icon {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: #f5f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #4f46e5;
    }

    .ai-card-icon svg {
      width: 18px;
      height: 18px;
    }

    .ai-card-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .ai-card-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .ai-card-button {
      width: 100%;
      margin-top: 6px;
      border-radius: 999px;
      border: none;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #4f46e5, #2563eb);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .ai-card-button:active {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(55, 65, 194, 0.35);
      filter: brightness(0.97);
    }

    .scan-form {
      padding: 0 4px 40px;
    }

    .scan-field {
      margin-bottom: 14px;
    }

    .scan-label {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 4px;
      display: block;
    }

    .scan-input,
    .scan-select {
      width: 100%;
      border-radius: 12px;
      border: 1px solid var(--border-soft);
      padding: 9px 11px;
      font-size: 16px;
      outline: none;
      background: #f9fafb;
    }

    .scan-input:focus,
    .scan-select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.15);
      background: #ffffff;
    }

    .scan-upload-area {
      width: 100%;
      border-radius: 16px;
      border: 1.5px dashed #cbd5f5;
      background: #f9fbff;
      padding: 16px 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      cursor: pointer;
    }

    .scan-upload-area:hover {
      background: #f1f5ff;
    }

    .scan-upload-icon {
      width: 40px;
      height: 40px;
      border-radius: 999px;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 6px;
    }

    .scan-upload-icon svg {
      width: 22px;
      height: 22px;
      color: #2563eb;
    }

    .scan-upload-title {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .scan-upload-sub {
      font-size: 11px;
      color: var(--text-muted);
      max-width: 260px;
    }

    .scan-upload-chosen {
      margin-top: 6px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .scan-file-input {
      width: 0;
      height: 0;
      opacity: 0;
      position: absolute;
      pointer-events: none;
    }

    .scan-radio-row {
      display: flex;
      gap: 10px;
      margin-top: 4px;
    }

    .scan-radio-pill {
      flex: 1;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      padding: 7px 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      cursor: pointer;
      background: #f9fafb;
    }

    .scan-radio-pill input {
      margin: 0;
    }

    .scan-help {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .scan-quota {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 6px;
    }
    .scan-quota-low {
      color: #b45309;
    }
    .scan-quota-zero {
      color: #b91c1c;
      font-weight: 600;
    }

    .scan-submit-btn {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      margin-top: 6px;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .scan-submit-btn:disabled {
      opacity: 0.7;
      cursor: default;
      box-shadow: none;
    }

    .scan-submit-btn:active:not(:disabled) {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      filter: brightness(0.97);
    }

    .scan-status {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
      min-height: 14px;
    }

    .scan-status.ok {
      color: #16a34a;
    }

    .scan-status.error {
      color: #b91c1c;
    }

    .history-card {
      margin-top: 6px;
      cursor: pointer;
      transition: box-shadow 0.15s, transform 0.05s;
    }

    .history-card:active {
      transform: scale(0.99);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .history-empty {
      font-size: 12px;
      color: var(--text-muted);
    }

    .history-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 12px;
      color: var(--text-main);
    }

    .history-item-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 6px;
    }

    .history-course {
      font-weight: 600;
    }

    .history-time {
      font-size: 11px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .history-progress-track {
      margin-top: 4px;
      width: 100%;
      height: 4px;
      border-radius: 999px;
      background: #e5e7eb;
      overflow: hidden;
    }

    .history-progress-bar {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      width: 100%;
    }

    .history-meta {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(env(safe-area-inset-bottom) + 8px);
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 420px;
      border-top: 1px solid #e5e7eb;
      padding: 6px 8px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: #ffffff;
      border-radius: 26px;
      box-shadow: 0 10px 30px rgba(15,23,42,0.18);
      z-index: 50;
      will-change: transform;
    }

    .nav-btn {
      flex: 1;
      text-align: center;
      font-size: 11px;
      color: #9ca3af;
      cursor: pointer;
      padding-top: 2px;
    }

    .nav-btn-inner {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .nav-btn svg {
      width: 20px;
      height: 20px;
      display: block;
    }

    .nav-btn.active {
      color: var(--blue);
      font-weight: 600;
    }

    .screen {
      display: none;
    }
    .screen.active {
      display: block;
    }

    main {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    main::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    body.keyboard-open .bottom-nav {
      display: none;
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo" />
        </div>
        <div class="brand-name">Colspot</div>
      </div>
      <button class="avatar-chip" id="avatarInitial" onclick="showScreen('account')">C</button>
    </header>

    <main>
      <div id="screen-home" class="screen active">
        <section class="hero">
          <div class="hero-line-1" id="greetingLine">Welcome back</div>
          <h1 class="hero-title">
            What do you want to<br />
            <span>do today?</span>
          </h1>
          <button class="primary-cta" onclick="showScreen('attendance')">
            <svg viewBox="0 0 20 20" fill="none">
              <path
                d="M10 4v12M4 10h12"
                stroke="white"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <span>Create new attendance</span>
          </button>
        </section>

        <section id="updateSoftSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="announcement-body">
              <div id="updateSoftTitle" class="announcement-title">
                New version available
              </div>
              <div id="updateSoftMessage" class="announcement-text"></div>
              <button
                type="button"
                class="update-soft-btn"
                onclick="openUpdateUrlFromRule()"
              >
                Update now
              </button>
            </div>
          </article>
        </section>

        <section id="announcementSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
