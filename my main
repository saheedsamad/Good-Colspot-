  async function loadScanQuota() {
    if (typeof supabase === "undefined") return null;
    const user = await ensureCurrentUser();
    if (!user) return null;

    currentScanUserId = user.id;
    const monthKey = getCurrentMonthKey();

    try {
      let query = supabase
        .from("scan_sheets")
        .select("id", { count: "exact", head: false })
        .eq("user_id", user.id)
        .eq("month_key", monthKey);

      let { data, error } = await query;

      if (error && String(error.message || "").toLowerCase().includes("month_key")) {
        const fallback = await supabase
          .from("scan_sheets")
          .select("id", { count: "exact", head: false })
          .eq("user_id", user.id);

        data = fallback.data;
        error = fallback.error;

        if (!error) {
          console.warn("scan_sheets.month_key missing, using fallback count without monthly filter");
        }
      }

      if (error) throw error;

      const used = Array.isArray(data) ? data.length : 0;
      currentScanQuota = {
        used,
        remaining: Math.max(0, SCAN_MAX_PER_MONTH - used),
        monthKey
      };
      return currentScanQuota;
    } catch (e) {
      console.error("loadScanQuota failed:", e);
      return null;
    }
  }

