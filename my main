        () => {
          console.log("Location permission granted on main page");
        },
        (err) => {
          console.warn("Location permission denied or error:", err);
        },
        {
          enableHighAccuracy: false,
          maximumAge: 0,
          timeout: 10000,
        }
      );
    }

