      'input[name="scanOutputType"]:checked'
    );

    if (!fileInput || !fileInput.files || !fileInput.files[0]) {
      if (statusEl) {
        statusEl.textContent = "Please choose a file first.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    if (!currentScanQuota) {
      await initScanQuotaUI();
    }

    if (currentScanQuota && currentScanQuota.remaining <= 0) {
      if (statusEl) {
        statusEl.textContent = "You have reached your monthly scan limit.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (statusEl) {
        statusEl.textContent = "Please sign in again.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    try {
      if (btn) btn.disabled = true;
      if (statusEl) {
        statusEl.textContent = "Uploading and processing your scan...";
        statusEl.className = "scan-status";
      }

      const file = fileInput.files[0];
      const outputType = outputTypeEl ? outputTypeEl.value : "excel";
      const title = norm(titleInput?.value) || file.name || "Scan";

      const buffer = await file.arrayBuffer();
      const base64 = arrayBufferToBase64(buffer);

      const response = await fetch(SCAN_LAMBDA_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          user_id: user.id,
          title,
          output_type: outputType,
          filename: file.name,
          mime_type: file.type || "application/octet-stream",
          file_base64: base64
        })
      });

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error((result && result.error) || "Scan failed.");
      }

      try {
        if (typeof supabase !== "undefined") {
          const insertPayload = {
            user_id: user.id,
            title,
            output_type: outputType,
            source_name: file.name
          };

          const tryInsert = await supabase
            .from("scan_sheets")
            .insert({
              ...insertPayload,
              month_key: getCurrentMonthKey()
            });

          if (tryInsert.error && String(tryInsert.error.message || "").toLowerCase().includes("month_key")) {
            await supabase.from("scan_sheets").insert(insertPayload);
          }
        }
      } catch (logErr) {
        console.warn("scan_sheets insert failed:", logErr);
      }

      await initScanQuotaUI();

      if (statusEl) {
        statusEl.textContent =
          result?.message || "Scan completed successfully.";
        statusEl.className = "scan-status ok";
      }

      if (result?.download_url) {
        window.open(result.download_url, "_blank");
      }
    } catch (e) {
      console.error("submitScanSheet failed:", e);
      if (statusEl) {
        statusEl.textContent = e.message || "Could not process scan.";
        statusEl.className = "scan-status error";
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  async function loadAnnouncements() {
    const section = document.getElementById("announcementSection");
    const titleEl = document.getElementById("announcementTitle");
    const msgEl = document.getElementById("announcementMessage");
    if (!section || !titleEl || !msgEl) return;

    if (typeof supabase === "undefined") {
      section.style.display = "none";
      return;
    }

    try {
      const { data, error } = await supabase
        .from("app_announcements")
        .select("id,title,message,show_until,is_active,created_at")
        .eq("is_active", true)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;
      const ann = data && data[0];

      if (!ann) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      if (ann.show_until && new Date(ann.show_until) < new Date()) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      const dismissKey = "colspot_announcement_dismissed_" + ann.id;
      if (localStorage.getItem(dismissKey) === "1") {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      section.dataset.announcementId = ann.id;
      titleEl.textContent = ann.title || "Update";
      msgEl.textContent = ann.message || "";
      section.style.display = "block";

      stopOfflineRetry();
    } catch (e) {
      console.error("loadAnnouncements failed:", e);
      scheduleOfflineRetry();
    }
  }

  function dismissAnnouncement() {
    const section = document.getElementById("announcementSection");
    if (!section) return;

    const id = section.dataset.announcementId;
    if (id) {
      try {
        localStorage.setItem("colspot_announcement_dismissed_" + id, "1");
      } catch (e) {
        console.warn("Failed to persist announcement dismiss:", e);
      }
    }

    section.style.display = "none";
  }

  function hideSoftUpdateBanner() {
    const softSection = document.getElementById("updateSoftSection");
    if (softSection) softSection.style.display = "none";
  }

  function hideHardUpdateOverlay() {
    const hardOverlay = document.getElementById("updateHardOverlay");
    if (hardOverlay) hardOverlay.style.display = "none";
  }

  function showSoftUpdateBanner(rule) {
    const softSection = document.getElementById("updateSoftSection");
    const softTitle = document.getElementById("updateSoftTitle");
    const softMessage = document.getElementById("updateSoftMessage");

    if (!softSection || !softTitle || !softMessage) return;

    softTitle.textContent = rule.title || "New version available";
    softMessage.textContent = rule.message || "Please update Colspot.";
    softSection.style.display = "block";
  }

  function showHardUpdateOverlay(rule) {
    const hardOverlay = document.getElementById("updateHardOverlay");
    const hardTitle = document.getElementById("updateHardTitle");
    const hardMessage = document.getElementById("updateHardMessage");

    if (!hardOverlay || !hardTitle || !hardMessage) return;

    hardTitle.textContent = rule.title || "Please update Colspot";
    hardMessage.textContent =
      rule.message ||
      "A newer version of Colspot is required to continue. Please update to keep using the app.";

    hardOverlay.style.display = "flex";
  }

  function applyUpdateRuleFromLocal() {
    let raw;
    try {
      raw = localStorage.getItem(UPDATE_RULE_LOCAL_KEY);
    } catch {
      raw = null;
    }

    if (!raw) {
      currentUpdateRule = null;
      hideSoftUpdateBanner();
      hideHardUpdateOverlay();
      return;
    }

    let rule;
    try {
      rule = JSON.parse(raw);
    } catch {
      currentUpdateRule = null;
      hideSoftUpdateBanner();
      hideHardUpdateOverlay();
      return;
    }

    if (!rule || !rule.mode || rule.mode === "none") {
      currentUpdateRule = null;
      hideSoftUpdateBanner();
      hideHardUpdateOverlay();
      return;
    }

    currentUpdateRule = rule;

    if (rule.mode === "hard") {
      hideSoftUpdateBanner();
      showHardUpdateOverlay(rule);
      return;
    }

    if (rule.mode === "soft") {
      hideHardUpdateOverlay();
      showSoftUpdateBanner(rule);
      return;
    }

    hideSoftUpdateBanner();
    hideHardUpdateOverlay();
  }

  function openUpdateUrlFromRule() {
    if (!currentUpdateRule || !currentUpdateRule.url) return;
    window.open(currentUpdateRule.url, "_blank");
  }

  document.addEventListener("DOMContentLoaded", async () => {
    appendMainDebug("DOMContentLoaded fired");
    await new Promise((r) => setTimeout(r, 50));

    lockBottomNavToScreen();

    let localAuth = null;
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.guardPageAccess === "function"
      ) {
        const localUser = ColspotGuard.guardPageAccess();
        if (!localUser) return;

        localAuth = {
          user_id: localUser.id,
          email: localUser.email || "",
          full_name: localUser.email || ""
        };
      } else {
        localAuth = getCachedAuthFromLocalUser();
        if (!localAuth) {
          window.location.href = "index.html";
          return;
        }
      }
    } catch (e) {
      console.error("guardPageAccess failed on main:", e);
      window.location.href = "index.html";
      return;
    }

    if (localAuth) {
      const localName =
        (localAuth.full_name && localAuth.full_name.trim()) ||
        (localAuth.email && localAuth.email.trim()) ||
        "";
      if (localName) {
        setGreetingFromProfile(localName);
      }
    }

    const fileInput = document.getElementById("scanFileInput");
    const chosenText = document.getElementById("scanFileChosenText");
    if (fileInput && chosenText) {
      fileInput.addEventListener("change", () => {
        if (fileInput.files && fileInput.files[0]) {
          chosenText.textContent = "Selected: " + fileInput.files[0].name;
        } else {
          chosenText.textContent = "";
        }
      });
    }

    const scanSubmitBtn = document.getElementById("scanSubmitBtn");
    if (scanSubmitBtn) {
      scanSubmitBtn.addEventListener("click", submitScanSheet);
    }

    const createClassBtn = document.getElementById("createClassBtn");
    if (createClassBtn) {
      createClassBtn.addEventListener("click", openCreateClass);
    }

    if (
      window.ColspotGuard &&
      typeof ColspotGuard.verifySupabaseSessionInBackground === "function"
    ) {
      ColspotGuard.verifySupabaseSessionInBackground();
    } else if (typeof supabase !== "undefined") {
      try {
        const { data, error } = await supabase.auth.getUser();
        if (!error && data && data.user) {
          currentUser = data.user;
        const profileName =
  (currentUser.user_metadata && currentUser.user_metadata.full_name) ||
  currentUser.email ||
  currentUser.phone ||
  "";
saveLocalUserFromSupabaseUser(currentUser);
if (profileName) {
  setGreetingFromProfile(profileName);
}

syncTopRightAvatar(
  (currentUser.user_metadata && currentUser.user_metadata.avatar_url) || "",
  profileName ? profileName.trim().charAt(0).toUpperCase() : "L"
);
        }
      } catch (e) {
        console.error("Fallback getUser on main failed:", e);
      }
    }

    loadLecturerDashboard();
    loadMiniHistory();
    initScanQuotaUI();
    loadAnnouncements();
    applyUpdateRuleFromLocal();
    tryInitPush();
appendMainDebug("Initial delay complete");
    appendMainDebug("tryInitPush finished");
    runMainWarmupOnce();
  });

  window.showScreen = showScreen;
  window.dismissAnnouncement = dismissAnnouncement;
  window.openUpdateUrlFromRule = openUpdateUrlFromRule;
  window.submitScanSheet = submitScanSheet;
</script>
</body>
</html>
