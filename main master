    if (window.ColspotGuard && ColspotGuard.GuardState && ColspotGuard.GuardState.user) {
      return { user: ColspotGuard.GuardState.user, networkIssue: false };
    }

    if (typeof supabase === "undefined") {
      return { user: null, networkIssue: true };
