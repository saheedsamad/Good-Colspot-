      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M12 4v10m0 0l-4-4m4 4l4-4M6 18h12"
          stroke="#4b5563"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>Export CSV</span>
    </button>
  </div>

  <div id="fullHistoryError" class="error-box"></div>

  <div class="history-section-title">History</div>
  <div id="fullHistoryList" class="history-list"></div>
  <div id="fullHistoryEmpty" class="empty-state">
    No history yet. When you attend class, receive school announcements, get forms or revisions, they will appear here.
