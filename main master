<script>
  let selectedClass = null;
  let serverClassesCache = [];

  function showError(msg) {
    const e = document.getElementById("errorBox");
    const s = document.getElementById("successBox");
    if (s) s.style.display = "none";
    if (e) {
      e.textContent = msg;
      e.style.display = "block";
    }
  }

  function showSuccess(msg) {
    const e = document.getElementById("errorBox");
    const s = document.getElementById("successBox");
    if (e) e.style.display = "none";
    if (s) {
      s.textContent = msg;
      s.style.display = "block";
    }
  }

  function clearMessages() {
    const e = document.getElementById("errorBox");
    const s = document.getElementById("successBox");
    if (e) e.style.display = "none";
    if (s) s.style.display = "none";
  }

  function getDisplayName(user) {
    const meta = (user && user.user_metadata) || {};
    const full =
      meta.full_name ||
      meta.name ||
      [meta.first_name, meta.last_name].filter(Boolean).join(" ");
    return (full || user.email || "Unknown").trim();
  }

  function normalizeClassItem(row) {
    return {
      code: (row?.course_code || "").trim(),
      title: (row?.course_title || "").trim(),
      academicSession: (row?.academic_session || "").trim(),
      createdAt: row?.created_at || null,
      id: row?.id || null
    };
  }

  function getRecentClasses() {
    try {
      const raw = localStorage.getItem("colspot_recent_classes");
      if (!raw) return [];
      return JSON.parse(raw) || [];
    } catch {
      return [];
    }
  }

  function saveRecentClass(code, title, academicSession) {
    if (!code) return;

    const cleanCode = (code || "").trim();
    const cleanTitle = (title || "").trim();
    const cleanSession = (academicSession || "").trim();

    const list = getRecentClasses().filter(
      (c) =>
        !(
          (c.code || "").toLowerCase() === cleanCode.toLowerCase() &&
          (c.academicSession || "").toLowerCase() === cleanSession.toLowerCase()
        )
    );

    list.unshift({
      code: cleanCode,
      title: cleanTitle,
      academicSession: cleanSession
    });

    localStorage.setItem(
      "colspot_recent_classes",
      JSON.stringify(list.slice(0, 50))
    );
  }

  function mergeClassSources() {
    const map = new Map();

    serverClassesCache.forEach((row) => {
      const item = normalizeClassItem(row);
      if (!item.code) return;

      const key = `${item.code.toLowerCase()}__${(item.academicSession || "").toLowerCase()}`;
      map.set(key, item);
    });

    getRecentClasses().forEach((row) => {
      const item = {
        code: (row?.code || "").trim(),
        title: (row?.title || "").trim(),
        academicSession: (row?.academicSession || "").trim(),
        createdAt: null,
        id: null
      };
      if (!item.code) return;

      const key = `${item.code.toLowerCase()}__${(item.academicSession || "").toLowerCase()}`;
      if (!map.has(key)) {
        map.set(key, item);
      }
    });

    return Array.from(map.values()).sort((a, b) => {
      const ad = a.createdAt ? new Date(a.createdAt).getTime() : 0;
      const bd = b.createdAt ? new Date(b.createdAt).getTime() : 0;
      return bd - ad;
    });
  }

  function renderRecent(filterText = "") {
    const container = document.getElementById("recentList");
    if (!container) return;

    const list = mergeClassSources();
    container.innerHTML = "";

    const f = filterText.trim().toLowerCase();

    let filtered;
    if (f) {
      filtered = list.filter(
        (c) =>
          (c.code || "").toLowerCase().includes(f) ||
          (c.title || "").toLowerCase().includes(f) ||
          (c.academicSession || "").toLowerCase().includes(f)
      );
    } else {
      filtered = list.slice(0, 2);
    }

    if (!filtered.length) {
      const empty = document.createElement("div");
      empty.className = "section-sub";
      empty.style.margin = "0";
      empty.textContent = "No recent classes yet.";
      container.appendChild(empty);
      return;
    }

    filtered.forEach((c) => {
      const item = document.createElement("div");

      const isSelected =
        selectedClass &&
        (selectedClass.code || "").toLowerCase() === (c.code || "").toLowerCase() &&
        ((selectedClass.academicSession || "").toLowerCase() ===
          (c.academicSession || "").toLowerCase());

      item.className = "recent-item" + (isSelected ? " selected" : "");

      const subParts = [];
      if (c.academicSession) subParts.push(c.academicSession);
      if (c.title) subParts.push(c.title);

      item.innerHTML = `
        <div class="recent-item-title">${c.code || ""}</div>
        <div class="recent-item-sub">${subParts.join(" • ")}</div>
      `;

      item.addEventListener("click", () =>
        selectClass(c.code, c.title, c.academicSession)
      );

      container.appendChild(item);
    });
  }

  function selectClass(code, title, academicSession) {
    selectedClass = {
      code: (code || "").trim(),
      title: (title || "").trim(),
      academicSession: (academicSession || "").trim()
    };

    saveRecentClass(code, title, academicSession);

    const searchValue = document.getElementById("searchClass")?.value || "";
    renderRecent(searchValue);
    clearMessages();
  }

  async function syncClassesFromSupabase() {
    try {
      if (typeof supabase === "undefined") return;

      const { data: userData, error: userError } = await supabase.auth.getUser();
      if (userError || !userData?.user) return;

      const user = userData.user;

      const { data, error } = await supabase
        .from("courses")
        .select("id, course_code, course_title, academic_session, created_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(200);

      if (error) {
        console.warn("Unable to load classes from courses table", error);
        return;
      }

      serverClassesCache = Array.isArray(data) ? data : [];

      serverClassesCache.forEach((row) => {
        const item = normalizeClassItem(row);
        if (!item.code) return;
        saveRecentClass(item.code, item.title, item.academicSession);
      });

      const currentFilter = document.getElementById("searchClass")?.value || "";
      renderRecent(currentFilter);
    } catch (err) {
      console.warn("Unable to sync classes from server", err);
    }
  }

  function getDeviceIdForWarmup() {
    try {
      if (
        window.ColspotGuard &&
        typeof window.ColspotGuard.getOrCreateDeviceId === "function"
      ) {
        return window.ColspotGuard.getOrCreateDeviceId();
      }

      if (
        window.ColspotNative &&
        typeof window.ColspotNative.getDeviceId === "function"
      ) {
        const nativeId = window.ColspotNative.getDeviceId();
        if (nativeId && typeof nativeId === "string") return nativeId.trim();
      }

      let id = localStorage.getItem("colspot_device_id");
      if (!id) {
        id = "dev_" + Date.now() + "_" + Math.random().toString(36).slice(2, 8);
        localStorage.setItem("colspot_device_id", id);
      }
      return id;
    } catch (e) {
      console.warn("[attendance] getDeviceIdForWarmup failed:", e);
      return null;
    }
  }

  function getPlatformForLocation() {
    try {
      if (window.Capacitor && typeof window.Capacitor.getPlatform === "function") {
        return window.Capacitor.getPlatform();
      }
      const ua = navigator.userAgent || navigator.vendor || "";
      if (/android/i.test(ua)) return "android";
      if (/iphone|ipad|ipod/i.test(ua)) return "ios";
      return "web";
    } catch {
      return "web";
    }
  }

  function getCurrentPositionOnce() {
    return new Promise(async (resolve) => {
      try {
        const hasCapacitor =
          typeof window !== "undefined" &&
          window.Capacitor &&
          window.Capacitor.Plugins &&
          window.Capacitor.Plugins.Geolocation;

        if (hasCapacitor) {
          const Geolocation = window.Capacitor.Plugins.Geolocation;
          const perm = await Geolocation.requestPermissions();
          if (perm && perm.location === "denied") return resolve(null);

          const pos = await Geolocation.getCurrentPosition({
            enableHighAccuracy: true,
            timeout: 20000,
            maximumAge: 0,
          });
          return resolve(pos);
        } else if ("geolocation" in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => resolve(pos),
            () => resolve(null),
            { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 }
          );
        } else {
          resolve(null);
        }
      } catch {
        resolve(null);
      }
    });
  }

  async function getSmartLocation(maxReads = 7, desiredAccuracy = 100) {
    const readings = [];
    for (let i = 0; i < maxReads; i++) {
      const pos = await getCurrentPositionOnce();
      if (pos && pos.coords) {
        const acc =
          typeof pos.coords.accuracy === "number" && !Number.isNaN(pos.coords.accuracy)
            ? pos.coords.accuracy
            : null;
        readings.push({ pos, accuracy: acc });
        if (acc !== null && acc <= desiredAccuracy) break;
      }
      await new Promise((r) => setTimeout(r, 1500));
    }
    if (!readings.length) return null;

    let best = readings[0];
    for (const r of readings) {
      if (r.accuracy == null) continue;
      if (best.accuracy == null || r.accuracy < best.accuracy) best = r;
    }

    return {
      pos: best.pos,
      accuracyMeters: best.accuracy != null && !Number.isNaN(best.accuracy) ? best.accuracy : null,
    };
  }

  async function getLocationForSession() {
    const best = await getSmartLocation(7, 100);
    if (best && best.pos && best.pos.coords) {
      return {
        lat: best.pos.coords.latitude,
        lng: best.pos.coords.longitude,
        accuracyMeters:
          best.accuracyMeters != null ? best.accuracyMeters : best.pos.coords.accuracy,
      };
    }
    return null;
  }

  async function runAttendanceWarmupOnce() {
    try {
      if (typeof supabase === "undefined") return;

      const { data: userData, error: userError } = await supabase.auth.getUser();
      if (userError || !userData?.user) return;

      const user = userData.user;
      const deviceId = getDeviceIdForWarmup();

      const warm = await getSmartLocation(10, 120);
      if (!warm || !warm.pos || !warm.pos.coords) return;

      const { latitude, longitude } = warm.pos.coords;
      const accuracyMeters =
        warm.accuracyMeters != null ? warm.accuracyMeters : warm.pos.coords.accuracy;

      if (accuracyMeters == null) return;

      await supabase.from("attendance_warmup_attendance").insert([
        {
          lecturer_id: user.id,
          device_id: deviceId,
          lat: latitude,
          lng: longitude,
          accuracy_m: accuracyMeters,
        },
      ]);
    } catch (e) {
      console.warn("[attendance] warmup insert failed:", e);
    }
  }

  async function fetchBestWarmupLocation(userId, deviceId) {
    if (typeof supabase === "undefined" || !userId) return null;

    const threeMinutesAgo = new Date(Date.now() - 3 * 60 * 1000).toISOString();
    const candidates = [];

    try {
      const queryMain = supabase
        .from("attendance_warmup_main")
        .select("lat, lng, accuracy_m, created_at")
        .eq("lecturer_id", userId)
        .gte("created_at", threeMinutesAgo)
        .order("accuracy_m", { ascending: true })
        .limit(1);

      const queryAtt = supabase
        .from("attendance_warmup_attendance")
        .select("lat, lng, accuracy_m, created_at")
        .eq("lecturer_id", userId)
        .gte("created_at", threeMinutesAgo)
        .order("accuracy_m", { ascending: true })
        .limit(1);

      const [mainRes, attRes] = await Promise.all([queryMain, queryAtt]);

      if (mainRes?.data?.[0]) candidates.push(mainRes.data[0]);
      if (attRes?.data?.[0]) candidates.push(attRes.data[0]);
    } catch (e) {
      console.warn("[attendance] fetchBestWarmupLocation failed:", e);
    }

    if (!candidates.length) return null;

    let bestRow = null;
    for (const row of candidates) {
      const acc = typeof row.accuracy_m === "number" ? row.accuracy_m : null;
      if (acc == null) continue;
      if (!bestRow || acc < bestRow.accuracy_m) bestRow = row;
    }

    if (!bestRow) return null;

    return {
      lat: bestRow.lat,
      lng: bestRow.lng,
      accuracyMeters: bestRow.accuracy_m,
    };
  }

  function pickBestLocationCandidate(candidates, maxAllowedAccMeters) {
    const maxAcc = typeof maxAllowedAccMeters === "number" ? maxAllowedAccMeters : 300;

    const valid = (candidates || []).filter(
      (c) =>
        c &&
        typeof c.lat === "number" &&
        typeof c.lng === "number" &&
        typeof c.accuracyMeters === "number" &&
        !Number.isNaN(c.accuracyMeters) &&
        c.accuracyMeters <= maxAcc
    );

    if (!valid.length) return null;

    let best = valid[0];
    for (const c of valid) {
      if (c.accuracyMeters < best.accuracyMeters) best = c;
    }
    return best;
  }

  function updateAttendanceLocationUI() {
    const toggle = document.getElementById("useLocationToggle");
    const text = document.getElementById("locationToggleText");
    const note = document.getElementById("attendanceLocationNote");
    const useLocation = !!toggle?.checked;

    if (text) {
      text.textContent = useLocation
        ? "ON: only nearby students can see and join this session."
        : "OFF: everyone can see this session on Nearby attendance and join with PIN.";
    }

    if (note) {
      note.innerHTML = useLocation
        ? "<strong>Colspot uses your location to know who is in class.</strong><br />Please allow location when asked, turn Location ON, and check your internet connection is working before you start attendance."
        : "<strong>Location is off for this session.</strong><br />This session will be shown to everyone on Nearby attendance and students will join with PIN.";
    }
  }

  async function startSession() {
    clearMessages();

    if (!selectedClass) {
      showError("Please select a class first.");
      return;
    }

    const pinInput = document.getElementById("pinInput");
    const timerRange = document.getElementById("timerRange");
    const btn = document.getElementById("btnStartSession");
    const useLocation = !!document.getElementById("useLocationToggle")?.checked;

    const pin = (pinInput.value || "").trim();
    if (!pin || pin.length < 4) {
      showError("Please enter a valid PIN (at least 4 digits).");
      return;
    }

    if (typeof isBrowserOffline === "function" && isBrowserOffline()) {
      showError("No internet connection. Please check your network and try again.");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Starting…";

    try {
      if (typeof supabase === "undefined") {
        showError("We couldn’t connect to the server. Please close and reopen Colspot.");
        return;
      }

      const { data: userData, error: userError } = await supabase.auth.getUser();
      if (userError || !userData?.user) {
        showError("Your session has expired. Please sign in again.");
        return;
      }

      const user = userData.user;
      const lecturerName = getDisplayName(user);
      const courseTitle = (selectedClass.title || "").trim() || null;
      const academicSession = (selectedClass.academicSession || "").trim() || null;
      const deviceId = getDeviceIdForWarmup();

      const minutes = parseInt(timerRange.value || "10", 10);
      const now = new Date();
      const expiresAt = new Date(now.getTime() + minutes * 60000);

      let lat = null;
      let lng = null;
      let creatorAccuracy = null;

      if (useLocation) {
        const [warmupBest, liveLoc] = await Promise.all([
          fetchBestWarmupLocation(user.id, deviceId),
          getLocationForSession(),
        ]);

        const candidates = [];
        if (warmupBest) candidates.push(warmupBest);
        if (liveLoc) candidates.push(liveLoc);

        const platform = getPlatformForLocation();
        const maxAccMeters = platform === "ios" ? 1000 : 300;
        const humanThreshold = platform === "ios" ? "1 km" : "300 m";

        const finalLoc = pickBestLocationCandidate(candidates, maxAccMeters);

        if (!finalLoc) {
          showError(
            `We couldn’t get a good location (we need accuracy under ${humanThreshold}). Move closer to a window or outside, check your internet and location settings, then try again.`
          );
          return;
        }

        lat = finalLoc.lat;
        lng = finalLoc.lng;
        creatorAccuracy = finalLoc.accuracyMeters;
      }

      const insertRow = {
        created_by: user.id,
        course_code: selectedClass.code,
        course_title: courseTitle,
        academic_session: academicSession,
        lecturer_name: lecturerName,
        pin_code: pin,
        starts_at: now.toISOString(),
        expires_at: expiresAt.toISOString(),
        is_active: true,
        use_location: useLocation,
      };

      if (useLocation) {
        insertRow.latitude = lat;
        insertRow.longitude = lng;
        insertRow.radius_meters = 400;
        insertRow.creator_accuracy_meters = creatorAccuracy;
      } else {
        insertRow.latitude = null;
        insertRow.longitude = null;
        insertRow.radius_meters = null;
        insertRow.creator_accuracy_meters = null;
      }

      const { data, error } = await supabase
        .from("attendance_sessions")
        .insert([insertRow])
        .select()
        .single();

      if (error) {
        if (
          error.code === "23505" ||
          (error.message || "").includes("attendance_sessions_unique_active_per_creator")
        ) {
          showError(
            "You already have a live attendance for this course code. End it first before starting another one."
          );
        } else {
          showError("We couldn’t start this session. Please check your network and try again.");
        }
        return;
      }

      if (data && data.id) {
        localStorage.setItem("colspot_last_session_id", data.id);
        window.location.href = "session-live.html?session_id=" + data.id;
        return;
      }

      showSuccess("Attendance session started.");
    } catch (e) {
      console.error(e);
      showError("Something went wrong. Please check your internet and try again.");
    } finally {
      btn.disabled = false;
      btn.textContent = "Start session";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderRecent();
    syncClassesFromSupabase();
    runAttendanceWarmupOnce();

    const btnShowNewClass = document.getElementById("btnShowNewClass");
    if (btnShowNewClass) {
      btnShowNewClass.addEventListener("click", () => {
        window.location.href = "create_class.html";
      });
    }

    const searchClass = document.getElementById("searchClass");
    if (searchClass) {
      searchClass.addEventListener("input", (e) => {
        renderRecent(e.target.value);
      });
    }

    const timerRange = document.getElementById("timerRange");
    if (timerRange) {
      timerRange.addEventListener("input", (e) => {
        const minutes = e.target.value;
        const label = document.getElementById("timerLabel");
        if (label) {
          label.textContent = `Expires in ${minutes} minute${minutes === "1" ? "" : "s"}`;
        }
      });
    }

    const useLocationToggle = document.getElementById("useLocationToggle");
    if (useLocationToggle) {
      useLocationToggle.addEventListener("change", updateAttendanceLocationUI);
      updateAttendanceLocationUI();
    }

    const btnStartSession = document.getElementById("btnStartSession");
    if (btnStartSession) {
      btnStartSession.addEventListener("click", startSession);
    }
  });
</script>
