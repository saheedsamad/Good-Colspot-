<script>
  if (typeof STUDENT_HISTORY_KEY === "undefined") {
    var STUDENT_HISTORY_KEY = "colspot_student_history";
  }

  const PENDING_NEARBY_JOIN_KEY = "colspot_pending_nearby_join";
  const FACE_VERIFY_PAGE_URL = "face_verification.html";

  // detection action pages
  const COURSE_FORM_PAGE_URL = "verification_clearance.html";
  const BIOMETRIC_PAGE_URL = "face_capture.html";

  let pendingNearbyJoinContext = null;
  let nearbyFinalizingJoin = false;

  // verification state
  let nearbyVerificationState = {
    loading: true,
    hasUser: false,
    courseFormOk: false,
    biometricOk: false,
    missingItems: [],
  };

  function addToStudentHistory(entry) {
    try {
      const raw = localStorage.getItem(STUDENT_HISTORY_KEY);
      let list = [];
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) list = parsed;
        } catch (_) {}
      }

      list = list.filter(
        (item) =>
          !(
            item.session_id === entry.session_id &&
            item.student_matric === entry.student_matric
          )
      );

      list.unshift(entry);
      list = list.slice(0, 50);

      localStorage.setItem(STUDENT_HISTORY_KEY, JSON.stringify(list));
    } catch (e) {
      console.warn("Could not update student history:", e);
    }
  }

  function savePendingNearbyJoinContext(payload) {
    try {
      localStorage.setItem(PENDING_NEARBY_JOIN_KEY, JSON.stringify(payload));
      pendingNearbyJoinContext = payload;
    } catch (e) {
      console.warn("Could not save pending nearby join context:", e);
    }
  }

  function readPendingNearbyJoinContext() {
    try {
      if (pendingNearbyJoinContext) return pendingNearbyJoinContext;
      const raw = localStorage.getItem(PENDING_NEARBY_JOIN_KEY);
      if (!raw) return null;
      pendingNearbyJoinContext = JSON.parse(raw);
      return pendingNearbyJoinContext;
    } catch (e) {
      console.warn("Could not read pending nearby join context:", e);
      return null;
    }
  }

  function clearPendingNearbyJoinContext() {
    try {
      pendingNearbyJoinContext = null;
      localStorage.removeItem(PENDING_NEARBY_JOIN_KEY);
    } catch (e) {
      console.warn("Could not clear pending nearby join context:", e);
    }
  }

  function getNearbyReturnPage() {
    try {
      const path = window.location.pathname || "";
      const file = path.split("/").pop();
      return file && file.trim() ? file : "near_attendance.html";
    } catch {
      return "near_attendance.html";
    }
  }

  function cleanNearbyReturnQueryFlags() {
    try {
      const url = new URL(window.location.href);
      url.searchParams.delete("faceVerified");
      url.searchParams.delete("verifiedSessionId");
      url.searchParams.delete("verifiedCourseCode");
      url.searchParams.delete("similarity");
      url.searchParams.delete("threshold");
      window.history.replaceState({}, "", url.toString());
    } catch (e) {
      console.warn("Could not clean nearby query flags:", e);
    }
  }

  function showNearSubscreen(name) {
    const listSection = document.getElementById("nearListSection");
    const joinSection = document.getElementById("nearJoinSection");
    const confirmSection = document.getElementById("nearConfirmSection");
    if (!listSection || !joinSection || !confirmSection) return;

    [listSection, joinSection, confirmSection].forEach((el) =>
      el.classList.remove("active")
    );

    if (name === "list") listSection.classList.add("active");
    else if (name === "join") joinSection.classList.add("active");
    else if (name === "confirm") confirmSection.classList.add("active");
  }

  function setNearbyStatus(text) {
    const el = document.getElementById("nearStatusText");
    if (el) el.textContent = text;
  }

  function showNearbyEmpty(show) {
    const el = document.getElementById("nearEmptyState");
    if (!el) return;

    if (nearCurrentMode === "location") {
      el.textContent = "No active attendance sessions near your location.";
    } else {
      el.textContent =
        "No non-location attendance sessions found. Ask your lecturer if the session is live.";
    }

    if (show) el.classList.remove("near-hidden");
    else el.classList.add("near-hidden");
  }

  function clearNearbySessions() {
    const list = document.getElementById("nearSessionList");
    if (list) list.innerHTML = "";
  }

  function showNearbyJoinError(msg) {
    const err = document.getElementById("nearJoinError");
    const ok = document.getElementById("nearJoinSuccess");
    if (ok) {
      ok.textContent = "";
      ok.classList.add("near-hidden");
    }
    if (err) {
      err.textContent = msg;
      err.classList.remove("near-hidden");
    }
  }

  function showNearbyJoinSuccess(msg) {
    const err = document.getElementById("nearJoinError");
    const ok = document.getElementById("nearJoinSuccess");
    if (err) {
      err.textContent = "";
      err.classList.add("near-hidden");
    }
    if (ok) {
      ok.textContent = msg;
      ok.classList.remove("near-hidden");
    }
  }

  function clearNearbyJoinMessages() {
    const err = document.getElementById("nearJoinError");
    const ok = document.getElementById("nearJoinSuccess");
    if (err) {
      err.textContent = "";
      err.classList.add("near-hidden");
    }
    if (ok) {
      ok.textContent = "";
      ok.classList.add("near-hidden");
    }
  }

  function showNearbyGlobalBanner(msg) {
    const el = document.getElementById("nearGlobalSuccess");
    if (!el) return;
    if (msg && msg.trim() !== "") {
      el.textContent = msg;
      el.classList.remove("near-hidden");
    } else {
      el.textContent = "";
      el.classList.add("near-hidden");
    }
  }

  function showStudentDetailsForm(show) {
    const block = document.getElementById("nearStudentDetailsBlock");
    if (!block) return;
    if (show) block.classList.remove("near-hidden");
    else block.classList.add("near-hidden");
  }

  function isColspotOffline() {
    try {
      if (window.ColspotGuard && typeof ColspotGuard.isBrowserOffline === "function") {
        return ColspotGuard.isBrowserOffline();
      }
    } catch (_) {}
    try {
      return typeof navigator !== "undefined" && navigator.onLine === false;
    } catch {
      return false;
    }
  }

  function markSessionSeen(sessionId) {
    if (!sessionId) return;
    if (!seenNearbySessionIds.includes(sessionId)) {
      seenNearbySessionIds.push(sessionId);
    }
  }

  function mapGeoErrorCode(err) {
    try {
      if (!err) return "UNKNOWN";
      if (typeof err.code === "number") {
        if (err.code === 1) return "PERMISSION_DENIED";
        if (err.code === 2) return "POSITION_UNAVAILABLE";
        if (err.code === 3) return "TIMEOUT";
      }
      const msg = String(err.message || "").toLowerCase();
      if (msg.includes("permission") && msg.includes("denied")) {
        return "PERMISSION_DENIED";
      }
      if (msg.includes("location services disabled")) {
        return "POSITION_UNAVAILABLE";
      }
    } catch (_) {}
    return "UNKNOWN";
  }

  function getMissingVerificationMessage(missingItems) {
    const items = Array.isArray(missingItems) ? missingItems : [];
    if (!items.length) return "";

    if (items.length === 1) {
      if (items[0] === "course_form") {
        return "You need to submit your course form before joining attendance.";
      }
      if (items[0] === "biometric") {
        return "You need to verify your biometric before joining attendance.";
      }
    }

    return "You need to submit your course form and verify your biometric before joining attendance.";
  }

  function updateNearbyVerificationUi() {
    const wrap = document.getElementById("nearVerifyWrap");
    if (!wrap) return;

    const badge = document.getElementById("nearVerifyBadge");
    const title = document.getElementById("nearVerifyTitle");
    const sub = document.getElementById("nearVerifySub");
    const formStatus = document.getElementById("nearVerifyCourseFormStatus");
    const bioStatus = document.getElementById("nearVerifyBiometricStatus");
    const formBtn = document.getElementById("nearVerifyCourseFormBtn");
    const bioBtn = document.getElementById("nearVerifyBiometricBtn");

    // keep hidden while checking
    if (nearbyVerificationState.loading) {
      wrap.classList.add("near-hidden");
      return;
    }

    if (!nearbyVerificationState.hasUser) {
      wrap.classList.add("near-hidden");
      return;
    }

    const courseFormOk = !!nearbyVerificationState.courseFormOk;
    const biometricOk = !!nearbyVerificationState.biometricOk;

    if (formStatus) {
      formStatus.textContent = courseFormOk ? "Submitted" : "Not submitted";
    }

    if (bioStatus) {
      bioStatus.textContent = biometricOk ? "Verified" : "Not verified";
    }

    // hide completely if all good
    if (courseFormOk && biometricOk) {
      wrap.classList.add("near-hidden");
      return;
    }

    // only show when something is missing
    wrap.classList.remove("near-hidden");

    if (badge) badge.textContent = "Action needed";
    if (title) title.textContent = "Complete verification before attendance";
    if (sub) {
      sub.textContent = getMissingVerificationMessage(
        nearbyVerificationState.missingItems
      );
    }

    if (formBtn) {
      if (courseFormOk) formBtn.classList.add("near-hidden");
      else formBtn.classList.remove("near-hidden");
    }

    if (bioBtn) {
      if (biometricOk) bioBtn.classList.add("near-hidden");
      else bioBtn.classList.remove("near-hidden");
    }
  }

  function openCourseFormPage() {
    window.location.href = COURSE_FORM_PAGE_URL;
  }

  function openBiometricPage() {
    window.location.href = BIOMETRIC_PAGE_URL;
