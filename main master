  <div id="studentHistoryModal" class="student-history-modal">
    <div class="student-history-backdrop"></div>
    <div class="student-history-sheet">
      <div class="student-history-title" id="shCourseHeading">
        Attendance details
      </div>
      <div class="student-history-sub">
        Overview of one submission.
      </div>

      <div class="student-history-summary">
        <div class="sh-row">
          <div class="sh-label">Course</div>
          <div id="shCourseLine" class="sh-value"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">Lecturer</div>
          <div id="shLecturerLine" class="sh-value"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">Status</div>
          <div id="shStatusLine" class="sh-value status"></div>
