<script>
  window.viewMessageScreenState = window.viewMessageScreenState || {
    loadedAnnouncementId: "",
    currentAnnouncement: null
  };

  function vmEl(id) {
    return document.getElementById(id);
  }

  function vmEscapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function vmFormatDateTime(value) {
    if (!value) return "Posted recently";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "Posted recently";
    return d.toLocaleString([], {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit"
    });
  }

  function vmBodyToHtml(text) {
    const safe = vmEscapeHtml(text || "");
    if (!safe.trim()) return "<p>No message available.</p>";
    return safe
      .split(/\n{2,}/)
      .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  function vmSetText(id, value, fallback = "") {
    const el = vmEl(id);
    if (el) el.textContent = String(value || fallback);
  }

  function vmShowLoading(show) {
    vmEl("viewMessageLoadingState").classList.toggle("hidden", !show);
  }

  function vmShowError(message) {
    const el = vmEl("viewMessageErrorState");
    el.textContent = message || "Could not load announcement.";
    el.classList.remove("hidden");
  }

  function vmHideError() {
    const el = vmEl("viewMessageErrorState");
    el.classList.add("hidden");
    el.textContent = "";
  }

  function vmShowEmpty(show) {
    vmEl("viewMessageEmptyState").classList.toggle("hidden", !show);
  }

  function vmShowCard(show) {
    vmEl("viewMessageCard").classList.toggle("hidden", !show);
  }

  function vmGetAudienceText(data) {
    const mode = String(data?.audience_mode || "").trim().toLowerCase();
    if (mode === "programme_filter") return "Selected students";
    return "All students";
  }

  function vmGuessFileName(url) {
    try {
      if (!url) return "Attached file";
      const clean = url.split("?")[0];
      const name = decodeURIComponent(clean.substring(clean.lastIndexOf("/") + 1));
      return name || "Attached file";
    } catch (e) {
      return "Attached file";
    }
  }

  async function vmFetchAnnouncementById(announcementId) {
    const { data, error } = await supabase
      .from("school_announcements")
      .select("id, school_name, title, body, notification_title, notification_body, link_label, link_url, image_url, file_url, created_by_admin_name, audience_mode, created_at, published_at, status")
      .eq("id", announcementId)
      .maybeSingle();

    if (error) throw error;
    return data || null;
  }

  function vmRenderAnnouncement(data) {
    const title =
      data.notification_title ||
      data.title ||
      "School Announcement";

    const body =
      data.body ||
      data.notification_body ||
      data.message ||
      "";

    const createdAt =
      data.created_at ||
      data.published_at ||
      "";

    const author =
      data.created_by_admin_name ||
      "School Admin";

    const imageUrl = data.image_url || "";
    const linkUrl = data.link_url || "";
    const fileUrl = data.file_url || "";
    const linkLabel = data.link_label || "Open attached link";

    vmSetText("viewMessageBadge", data.school_name || "School Update");
    vmSetText("viewMessageTitle", title);
    vmSetText("viewMessageAudience", vmGetAudienceText(data));
    vmSetText("viewMessageBy", author);
    vmSetText("viewMessageTimeFooter", vmFormatDateTime(createdAt));

    vmEl("viewMessageBody").innerHTML = vmBodyToHtml(body);

    const imageWrap = vmEl("viewMessageImageWrap");
    const imageEl = vmEl("viewMessageImage");

    if (imageUrl) {
      imageEl.onload = () => {
        imageWrap.classList.remove("hidden");
      };
      imageEl.onerror = () => {
        imageWrap.classList.add("hidden");
      };
      imageEl.src = imageUrl;
      imageEl.alt = title;
    } else {
      imageEl.removeAttribute("src");
      imageWrap.classList.add("hidden");
    }

    const linkCard = vmEl("viewMessageLinkCard");
    const viewLinkBtn = vmEl("viewMessageViewLinkBtn");

    if (linkUrl) {
      vmSetText("viewMessageLinkTitle", linkLabel);
      vmSetText("viewMessageLinkSub", "Visit attached resource");
      linkCard.classList.remove("hidden");
      viewLinkBtn.onclick = () => window.open(linkUrl, "_blank", "noopener");
    } else {
      linkCard.classList.add("hidden");
      viewLinkBtn.onclick = null;
    }

    const fileCard = vmEl("viewMessageFileCard");
    const downloadFileBtn = vmEl("viewMessageDownloadFileBtn");

    if (fileUrl) {
      vmSetText("viewMessageFileTitle", vmGuessFileName(fileUrl));
      vmSetText("viewMessageFileSub", "Download attached file");
      fileCard.classList.remove("hidden");
      downloadFileBtn.onclick = () => window.open(fileUrl, "_blank", "noopener");
    } else {
      fileCard.classList.add("hidden");
      downloadFileBtn.onclick = null;
    }
  }

async function openViewMessageScreen(force = false) {
  vmShowLoading(true);
  vmHideError();
  vmShowEmpty(false);
  vmShowCard(false);

  try {
    const selected = window.historyScreenState?.selectedAnnouncement || null;
    if (!selected) {
      vmShowLoading(false);
      vmShowEmpty(true);
      return;
    }

    if (!window.viewMessageScreenState) {
      window.viewMessageScreenState = {};
    }

    const selectedId = String(selected.id || "").trim();
    const state = window.viewMessageScreenState;

    if (
      !force &&
      state.loadedAnnouncementId &&
      selectedId &&
      state.loadedAnnouncementId === selectedId &&
      state.currentAnnouncement
    ) {
      vmShowLoading(false);
      vmRenderAnnouncement(state.currentAnnouncement);
      vmShowCard(true);
      return;
    }

    // render immediately from selected history item first
    let data = selected;

    state.loadedAnnouncementId = selectedId;
    state.currentAnnouncement = data;

    vmShowLoading(false);
    vmRenderAnnouncement(data);
    vmShowCard(true);

    // optional background refresh from Supabase
    if (selectedId && typeof supabase !== "undefined") {
      try {
        const fetched = await vmFetchAnnouncementById(selectedId);
        if (fetched) {
          state.loadedAnnouncementId = selectedId;
          state.currentAnnouncement = fetched;
          vmRenderAnnouncement(fetched);
          vmShowCard(true);
        }
      } catch (fetchErr) {
        console.warn("view message background refresh failed:", fetchErr);
      }
    }
  } catch (err) {
    console.error("view message load error:", err);
    vmShowLoading(false);
    vmShowError(err?.message || "Could not load announcement.");
  }
}

  function closeViewMessageBack() {
    if (typeof showScreen === "function") {
      showScreen("history");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    vmEl("viewMessageBackBtn")?.addEventListener("click", closeViewMessageBack);
  });

  window.openViewMessageScreen = openViewMessageScreen;
</script>
