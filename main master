    try {
      const { data, error } = await supabase.auth.getUser();

      if (error || !data || !data.user) {
        const isNet =
          window.ColspotGuard &&
          typeof ColspotGuard.isLikelyOfflineError === "function" &&
          ColspotGuard.isLikelyOfflineError(error);
        return { user: null, networkIssue: !!isNet };
      }

      const user = data.user;
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.saveLocalUserFromSupabaseUser === "function"
      ) {
        ColspotGuard.saveLocalUserFromSupabaseUser(user);
      }
      return { user, networkIssue: false };
    } catch (e) {
      const isNet =
        window.ColspotGuard &&
        typeof ColspotGuard.isLikelyOfflineError === "function" &&
        ColspotGuard.isLikelyOfflineError(e);
      return { user: null, networkIssue: !!isNet };
    }
  }

