  async function loadNearbyVerificationState(force = false) {
    if (typeof supabase === "undefined") {
      nearbyVerificationState = {
        loading: false,
        hasUser: false,
        courseFormOk: false,
        biometricOk: false,
        missingItems: [],
      };
      updateNearbyVerificationUi();
      return nearbyVerificationState;
    }

    const { user, networkIssue } = await getNearbyCurrentUser();

    if (networkIssue || !user) {
      nearbyVerificationState = {
        loading: false,
        hasUser: false,
        courseFormOk: false,
        biometricOk: false,
        missingItems: [],
      };
      updateNearbyVerificationUi();
      return nearbyVerificationState;
    }

    if (!force && !nearbyVerificationState.loading && nearbyVerificationState.hasUser) {
      return nearbyVerificationState;
    }

    // do not show card during checking
    nearbyVerificationState = {
      loading: true,
      hasUser: true,
      courseFormOk: false,
      biometricOk: false,
      missingItems: [],
    };

    let courseFormOk = false;
    let biometricOk = false;

    try {
      const [courseFormRes, faceRes] = await Promise.all([
        supabase
          .from("verification_course_forms")
          .select("id, user_id, created_at")
          .eq("user_id", user.id)
          .limit(1)
          .maybeSingle(),

        supabase
          .from("face_profiles")
          .select("id, face_verified")
          .eq("user_id", user.id)
          .limit(1)
          .maybeSingle(),
      ]);

      if (!courseFormRes.error && courseFormRes.data) {
        courseFormOk = true;
      }

      if (!faceRes.error && faceRes.data && faceRes.data.face_verified === true) {
        biometricOk = true;
      }
    } catch (err) {
      console.warn("loadNearbyVerificationState failed:", err);
    }

    const missingItems = [];
    if (!courseFormOk) missingItems.push("course_form");
    if (!biometricOk) missingItems.push("biometric");

    nearbyVerificationState = {
      loading: false,
      hasUser: true,
      courseFormOk,
      biometricOk,
      missingItems,
    };

    updateNearbyVerificationUi();
    return nearbyVerificationState;
  }

  async function ensureTopVerificationBeforeJoin() {
    const state = await loadNearbyVerificationState(true);

    if (!state.hasUser) {
      return {
        ok: false,
        message: "Session expired. Please sign in again.",
      };
    }

    if (!state.courseFormOk || !state.biometricOk) {
      return {
        ok: false,
        message: getMissingVerificationMessage(state.missingItems),
      };
    }

    return { ok: true };
  }

  async function getCurrentPositionOnce() {
    return new Promise(async (resolve) => {
      lastNearbyLocationError = null;

      try {
        const hasCapacitor =
          typeof window !== "undefined" &&
          window.Capacitor &&
          window.Capacitor.Plugins &&
          window.Capacitor.Plugins.Geolocation;

        if (hasCapacitor) {
          const Geolocation = window.Capacitor.Plugins.Geolocation;

          const perm = await Geolocation.requestPermissions();
          if (perm && perm.location === "denied") {
            lastNearbyLocationError = "PERMISSION_DENIED";
            return resolve(null);
          }

          try {
            const pos = await Geolocation.getCurrentPosition({
              enableHighAccuracy: true,
              timeout: 20000,
              maximumAge: 0,
            });
            lastNearbyLocationError = null;
            return resolve(pos);
          } catch (err) {
            lastNearbyLocationError = mapGeoErrorCode(err);
            return resolve(null);
          }
        } else if ("geolocation" in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              lastNearbyLocationError = null;
              resolve(pos);
            },
            (err) => {
              lastNearbyLocationError = mapGeoErrorCode(err);
              resolve(null);
            },
            {
              enableHighAccuracy: true,
              maximumAge: 0,
              timeout: 20000,
            }
          );
        } else {
          lastNearbyLocationError = "POSITION_UNAVAILABLE";
          resolve(null);
        }
      } catch (err) {
        lastNearbyLocationError = mapGeoErrorCode(err);
        resolve(null);
      }
    });
  }

  async function getSmartLocation(maxReads = 5, desiredAccuracy = 100) {
    const readings = [];

    for (let i = 0; i < maxReads; i++) {
      const pos = await getCurrentPositionOnce();
      if (pos && pos.coords) {
        const acc =
          typeof pos.coords.accuracy === "number" && !Number.isNaN(pos.coords.accuracy)
            ? pos.coords.accuracy
            : null;

        readings.push({ pos, accuracy: acc });

        if (acc !== null && acc <= desiredAccuracy) break;
      }

      await new Promise((r) => setTimeout(r, 1500));
    }

    if (!readings.length) return null;

    let best = readings[0];
    for (const r of readings) {
      if (r.accuracy == null) continue;
      if (best.accuracy == null || r.accuracy < best.accuracy) best = r;
    }

    return best.pos;
  }

