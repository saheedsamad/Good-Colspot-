<script>
  window.classLiveScreenState = window.classLiveScreenState || {
    supabaseReady: false,
    currentUser: null,
    currentCourseId: null,
    currentCourse: null,
    currentMembers: [],
    membersInterval: null
  };

  function classLiveShowError(msg) {
    const box = document.getElementById("errorBox");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function classLiveShowActionSuccess(msg) {
    const box = document.getElementById("actionSuccess");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function classLiveFormatPrograms(programs) {
    if (!Array.isArray(programs) || programs.length === 0) return "All departments";
    return programs.join(", ");
  }

  function classLiveFormatLevels(levels) {
    if (!Array.isArray(levels) || levels.length === 0) return "All levels";
    return levels.map(v => `${v} level`).join(", ");
  }

  function classLiveFormatDepartmentLevels(course) {
    if (Array.isArray(course.allowed_department_levels) && course.allowed_department_levels.length > 0) {
      const departments = course.allowed_department_levels
        .map(x => String(x?.department || "").trim())
        .filter(Boolean);

      const levels = [];
      course.allowed_department_levels.forEach(item => {
        (Array.isArray(item?.levels) ? item.levels : []).forEach(lvl => {
          if (!levels.includes(lvl)) levels.push(lvl);
        });
      });

      return {
        departmentsText: departments.length ? departments.join(", ") : "All departments",
        levelsText: levels.length ? levels.map(v => `${v} level`).join(", ") : "All levels"
      };
    }

    return {
      departmentsText: classLiveFormatPrograms(course.allowed_departments),
      levelsText: classLiveFormatLevels(course.allowed_levels)
    };
  }

  function classLiveSetStatus(course) {
    const pill = document.getElementById("statusPill");
    const text = document.getElementById("statusPillText");
    if (!pill || !text) return;

    const isEnded =
      course?.is_active === false ||
      String(course?.status || "").toLowerCase() === "ended" ||
      !!course?.ended_at;

    if (isEnded) {
      pill.classList.add("ended");
      text.textContent = "Ended";
    } else {
      pill.classList.remove("ended");
      text.textContent = "Class";
    }
  }

  function classLiveSetClassHeader(course, memberCount) {
    const classEl = document.getElementById("sessionClass");
    const classSubEl = document.getElementById("sessionClassSub");
    const pinEl = document.getElementById("pinValue");
    const timerEl = document.getElementById("timerValue");
    const createdAtEl = document.getElementById("createdAtText");
    const deptEl = document.getElementById("allowedDepartmentsText");
    const levelEl = document.getElementById("allowedLevelsText");

    if (classEl) {
      classEl.textContent = course.course_code || course.course_title || "Class";
    }

    if (classSubEl) {
      const title = course.course_title || "";
      const session = course.academic_session || "";
      const subtitle = [title, session].filter(Boolean).join("\n");
      classSubEl.textContent = subtitle || "Created class code";
    }

    if (pinEl) {
      pinEl.textContent = course.invite_code || "------";
    }

    if (timerEl) {
      timerEl.textContent = String(memberCount || 0);
    }

    if (createdAtEl) {
      if (course.created_at) {
        const d = new Date(course.created_at);
        createdAtEl.textContent = d.toLocaleString([], {
          year: "numeric",
          month: "short",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit"
        });
      } else {
        createdAtEl.textContent = "";
      }
    }

    const details = classLiveFormatDepartmentLevels(course);
    if (deptEl) deptEl.textContent = details.departmentsText;
    if (levelEl) levelEl.textContent = details.levelsText;

    classLiveSetJoinedCount(memberCount || 0);
    classLiveSetStatus(course);
  }

  function classLiveSetJoinedCount(count) {
    const el = document.getElementById("joinedCount");
    if (!el) return;
    el.innerHTML = `<strong>${count}</strong> joined`;
  }

  async function classLiveLoadCourseAndMembers() {
    const state = window.classLiveScreenState;
    if (!state.supabaseReady || !state.currentCourseId) return;

    classLiveShowError("");
    classLiveShowActionSuccess("");

    const attendeeList = document.getElementById("attendeeList");
    const emptyState = document.getElementById("emptyState");
    if (attendeeList) attendeeList.innerHTML = "";
    if (emptyState) emptyState.style.display = "none";

    const { data: course, error: courseError } = await supabase
      .from("courses")
      .select(`
        id,
        created_by,
        course_code,
        course_title,
        creator_name,
        invite_code,
        academic_session,
        created_at,
        allowed_departments,
        allowed_levels,
        allowed_department_levels,
        is_active,
        status,
        ended_at
      `)
      .eq("id", state.currentCourseId)
      .single();

    if (courseError || !course) {
      console.error(courseError || "Class not found");
      classLiveShowError("Could not load this class. It may have been removed.");
      return;
    }

    state.currentCourse = course;

    if (course.created_by !== state.currentUser.id) {
      classLiveShowError("You are not allowed to view this class.");
      return;
    }

    const { data: memberships, error: memError } = await supabase
      .from("course_memberships")
      .select(`
        id,
        joined_at,
        user_id
      `)
      .eq("course_id", state.currentCourseId)
      .order("joined_at", { ascending: true });

    if (memError) {
      console.error(memError);
      classLiveShowError("Could not load joined students. Please try again.");
      return;
    }

    const rows = memberships || [];
    let profileMap = {};

    const userIds = rows
      .map((r) => r.user_id)
      .filter(Boolean);

    if (userIds.length) {
      const { data: profiles, error: profileError } = await supabase
        .from("student_profiles")
        .select("user_id, full_name, matric_number, department")
        .in("user_id", userIds);

      if (profileError) {
        console.error(profileError);
      } else {
        (profiles || []).forEach((p) => {
          profileMap[p.user_id] = p;
        });
      }
    }

    state.currentMembers = rows.map((row) => {
      const profile = profileMap[row.user_id] || {};
      return {
        id: row.id,
        joined_at: row.joined_at,
        student_name: profile.full_name || "Student",
        student_matric: profile.matric_number || "",
        student_department: profile.department || ""
      };
    });

    classLiveSetClassHeader(course, state.currentMembers.length);

    const filterEl = document.getElementById("attendeeFilter");
    const hasFilter =
      filterEl && filterEl.value && filterEl.value.trim().length > 0;

    if (hasFilter) {
      classLiveApplyMemberFilter();
    } else {
      classLiveRenderMembers(state.currentMembers);
    }
  }

  function classLiveRenderMembers(list) {
    const attendeeList = document.getElementById("attendeeList");
    const emptyState = document.getElementById("emptyState");
    if (!attendeeList || !emptyState) return;

    attendeeList.innerHTML = "";

    if (!list.length) {
      emptyState.style.display = "block";
      return;
    }

    emptyState.style.display = "none";

    list.forEach((rec) => {
      const card = document.createElement("div");
      card.className = "attendee-card";

      const nameCell = document.createElement("div");
      nameCell.className = "attendee-cell";
      nameCell.textContent = rec.student_name || "Student";

      const matricCell = document.createElement("div");
      matricCell.className = "attendee-cell";
      matricCell.textContent = rec.student_matric || "—";

      const deptCell = document.createElement("div");
      deptCell.className = "attendee-cell";
      deptCell.textContent = rec.student_department || "—";

      const timeCell = document.createElement("div");
      timeCell.className = "attendee-cell attendee-cell-small";
      const t = rec.joined_at ? new Date(rec.joined_at) : null;
      timeCell.textContent = t
        ? t.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "—";

      card.appendChild(nameCell);
      card.appendChild(matricCell);
      card.appendChild(deptCell);
      card.appendChild(timeCell);

      attendeeList.appendChild(card);
    });
  }

  function classLiveApplyMemberFilter() {
    const filterEl = document.getElementById("attendeeFilter");
    const state = window.classLiveScreenState;
    if (!filterEl) return;

    const q = filterEl.value.toLowerCase().trim();
    if (!q) {
      classLiveRenderMembers(state.currentMembers);
      return;
    }

    const filtered = state.currentMembers.filter((rec) => {
      const name = (rec.student_name || "").toLowerCase();
      const matric = (rec.student_matric || "").toLowerCase();
      const dept = (rec.student_department || "").toLowerCase();
      return name.includes(q) || matric.includes(q) || dept.includes(q);
    });

    classLiveRenderMembers(filtered);
  }

  function classLiveDownloadMembersCsv() {
    const state = window.classLiveScreenState;
    if (!state.currentMembers.length) {
      alert("No joined students to download yet.");
      return;
    }

    const header = ["Name", "Matric number", "Department", "Joined at"];
    const esc = (v) => `"${String(v).replace(/"/g, '""')}"`;

    const rows = state.currentMembers.map((rec) => {
      const joined = rec.joined_at ? new Date(rec.joined_at).toISOString() : "";
      return [
        rec.student_name || "Student",
        rec.student_matric || "",
        rec.student_department || "",
        joined
      ].map(esc).join(",");
    });

    const csv = [header.join(","), ...rows].join("\n");
    const courseTitle = state.currentCourse
      ? state.currentCourse.course_code || state.currentCourse.course_title || "class"
      : "class";
    const filename = `${courseTitle}_joined_students.csv`;

    try {
      if (navigator.share && window.File) {
        const file = new File([csv], filename, { type: "text/csv" });
        navigator.share({
          files: [file],
          title: "Colspot Class Members CSV",
          text: "Joined students export"
        }).catch(() => {});
        return;
      }
    } catch (e) {}

    try {
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      a.style.display = "none";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      return;
    } catch (e) {
      console.warn("CSV download failed:", e);
    }

    const dataUrl = "data:text/csv;charset=utf-8," + encodeURIComponent(csv);
    window.open(dataUrl, "_blank");
  }

  function classLiveReloadMembers() {
    classLiveLoadCourseAndMembers();
  }

  function classLiveEditClass() {
    const state = window.classLiveScreenState;
    if (!state.currentCourseId) return;
    window.location.href = "create_class.html?edit=" + encodeURIComponent(state.currentCourseId);
  }

  async function classLiveEndSession() {
    const state = window.classLiveScreenState;
    if (!state.currentCourseId || !state.currentCourse) return;

    const yes = confirm("End this class session now?");
    if (!yes) return;

    classLiveShowError("");
    classLiveShowActionSuccess("");

    const nowIso = new Date().toISOString();

    const attempts = [
      { is_active: false, ended_at: nowIso, status: "ended" },
      { status: "ended", ended_at: nowIso },
      { is_active: false, ended_at: nowIso },
      { status: "ended" },
      { ended_at: nowIso }
    ];

    let lastError = null;

    for (const payload of attempts) {
      const { error } = await supabase
        .from("courses")
        .update(payload)
        .eq("id", state.currentCourseId)
        .eq("created_by", state.currentUser.id);

      if (!error) {
        classLiveShowActionSuccess("Class session ended successfully.");
        await classLiveLoadCourseAndMembers();
        return;
      }

      lastError = error;
    }

    console.warn("endSession failed:", lastError);
    classLiveShowError("Could not end this session. Your courses table may still need an end-session column like status, is_active, or ended_at.");
  }

  function classLiveGetCourseIdFromState() {
    const selected =
      window.historyScreenState?.selectedCourse ||
      window.historyScreenState?.selectedClass ||
      null;
    if (selected?.id) return selected.id;
    if (selected?.course_id) return selected.course_id;
    return null;
  }

  async function openLiveClassScreen() {
    const state = window.classLiveScreenState;

    if (state.membersInterval) {
      clearInterval(state.membersInterval);
      state.membersInterval = null;
    }

    await new Promise((r) => setTimeout(r, 50));

    if (typeof supabase === "undefined") {
      console.error("Supabase client missing on class live screen");
      return;
    }

    state.supabaseReady = true;

    const { data, error } = await supabase.auth.getUser();
    if (error || !data || !data.user) {
      if (typeof showScreen === "function") showScreen("home");
      return;
    }

    state.currentUser = data.user;
    state.currentCourseId = classLiveGetCourseIdFromState();

    if (!state.currentCourseId) {
      classLiveShowError("No class found. Open a class from history first.");
      return;
    }

    await classLiveLoadCourseAndMembers();
    state.membersInterval = setInterval(classLiveLoadCourseAndMembers, 5000);
  }

  window.openLiveClassScreen = openLiveClassScreen;
</script>
