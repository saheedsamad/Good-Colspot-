      cleanNearbyReturnQueryFlags();
      finalizeNearbyJoinAfterFaceVerify({
        ok: true,
        faceMatch: true,
        similarity: Number(similarity || 0),
        threshold: Number(threshold || 0.7),
      });
      return true;
    }

    return false;
  }

  function filterNonLocationSessions() {
    const term = (nearNonLocationSearchTerm || "").trim().toLowerCase();
    if (!term) return lastNonLocationSessions.slice();

    return lastNonLocationSessions.filter((s) => {
      const code = (s.course_code || "").toLowerCase();
      const title = (s.course_title || "").toLowerCase();
      const lect = (s.lecturer_name || "").toLowerCase();
      return code.includes(term) || title.includes(term) || lect.includes(term);
    });
  }

  async function loadNearbySessions() {
    const listEl = document.getElementById("nearSessionList");
    if (!listEl) return;

    const outerScreen = document.getElementById("screen-nearby");
    if (outerScreen && !outerScreen.classList.contains("active")) return;

    if (typeof supabase === "undefined") {
      setNearbyStatus(
        "We couldn't connect to the server yet. Please check your internet connection."
      );
      if (nearCurrentMode === "location" && !lastNearbySessions.length) {
        showNearbyEmpty(true);
      }
      if (nearCurrentMode === "nonlocation" && !lastNonLocationSessions.length) {
        showNearbyEmpty(true);
      }
      return;
    }

    if (isColspotOffline()) {
      setNearbyStatus("No internet connection. We'll keep showing the last sessions we found.");
      return;
    }

    const loadId = ++nearbyLoadSeq;

    const topMsg = document.getElementById("nearTopMessageText");
    const locationNote = document.getElementById("nearLocationNote");

    if (nearCurrentMode === "location") {
      if (lastNearbySessions.length) setNearbyStatus("Updating nearby sessions…");
      else setNearbyStatus("Getting your location...");

      if (topMsg) {
        topMsg.textContent = "Colspot is looking for nearby attendance sessions around you…";
      }
      if (locationNote) {
        locationNote.innerHTML =
          "<strong>Colspot uses your location to find the right classes.</strong><br />Please allow location when asked, turn Location ON, and check that your internet connection is working.";
      }
    } else {
      setNearbyStatus("Loading non-location attendance sessions…");
      if (topMsg) {
        topMsg.textContent =
          "Showing non-location attendance sessions. Use search to find your class.";
      }
      if (locationNote) {
        locationNote.innerHTML =
          "<strong>Location is not required for these sessions.</strong><br />Your lecturer may ask you to join with a PIN only.";
      }
    }

    if (nearCurrentMode === "nonlocation") {
      try {
        const nowIso = new Date().toISOString();
        const { data, error } = await supabase
          .from("attendance_sessions")
          .select("id, course_code, course_title, lecturer_name, expires_at, pin_code, use_location")
          .gte("expires_at", nowIso)
          .eq("use_location", false)
          .order("expires_at", { ascending: true });

        if (loadId !== nearbyLoadSeq) return;

        if (error) {
          setNearbyStatus(
            "We couldn't load non-location attendance right now. Please check your internet connection."
          );
          return;
        }

        lastNonLocationSessions = (data || []).slice();

        const filtered = filterNonLocationSessions();
        if (!filtered.length) {
          setNearbyStatus("No non-location attendance sessions found right now.");
        } else {
          setNearbyStatus(
            "Showing " +
              filtered.length +
              " non-location attendance session" +
              (filtered.length > 1 ? "s." : ".")
          );
        }

        renderNearbySessionList(filtered);
      } catch (e) {
        setNearbyStatus(
          "We couldn't load non-location attendance right now. Please check your internet connection."
        );
      }
      return;
    }

    let loc = null;
    lastNearbyLocationError = null;
    const startedAt = Date.now();

    try {
      const locPromise = (async () => {
        if (typeof getSmartLocation === "function") {
          const pos = await getSmartLocation(5, 100);
          if (pos && pos.coords) {
            return { lat: pos.coords.latitude, lng: pos.coords.longitude };
          }
        } else if (typeof getCurrentPositionOnce === "function") {
          const pos = await getCurrentPositionOnce();
          if (pos && pos.coords) {
            return { lat: pos.coords.latitude, lng: pos.coords.longitude };
          }
        }
        return null;
      })();

      loc = await Promise.race([
        locPromise,
        new Promise((resolve) => setTimeout(() => resolve(null), NEARBY_LOCATION_TIMEOUT_MS)),
      ]);
    } catch (e) {
      loc = null;
    }

    const elapsed = Date.now() - startedAt;
    const errCode = lastNearbyLocationError;

    if (!loc) {
      if (errCode === "PERMISSION_DENIED") {
        setNearbyStatus(
          "Location permission is blocked. Please allow Location for Colspot in your phone Settings, then come back and tap Refresh."
        );
      } else if (errCode === "POSITION_UNAVAILABLE" || errCode === "TIMEOUT") {
        setNearbyStatus(
          "We couldn’t get your location yet. Make sure you turn on your location and have good network. Also check your internet connection and make sure Airplane mode is turned off."
        );
      } else if (elapsed >= NEARBY_LOCATION_TIMEOUT_MS) {
        setNearbyStatus(
          "We couldn’t get your location yet. Turn Location ON and try again. If it’s already ON, check your internet and try again."
        );
      } else {
        setNearbyStatus(
          "We couldn’t get your location yet. Turn Location ON and try again. If it’s already ON, check your internet and try again."
        );
      }

      if (!lastNearbySessions.length) showNearbyEmpty(true);
      return;
    }

    const { lat, lng } = loc;

    try {
      const nowIso = new Date().toISOString();
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("id, course_code, course_title, lecturer_name, expires_at, latitude, longitude, pin_code, use_location")
        .gte("expires_at", nowIso)
        .eq("use_location", true);

      if (loadId !== nearbyLoadSeq) return;

      if (error) {
        setNearbyStatus(
          "We couldn't refresh nearby sessions right now. Please check your internet connection. We'll keep showing the last ones we found."
        );
        return;
      }

      const sessions = (data || []).filter(
        (s) =>
          typeof s.latitude === "number" &&
          typeof s.longitude === "number" &&
          s.expires_at
      );

      if (!sessions.length) {
        lastNearbySessions = [];
        seenNearbySessionIds = [];
        setNearbyStatus("No active attendance sessions near your location.");
        renderNearbySessionList([]);
        return;
      }

      let withDistance = sessions.map((s) => {
        let distance = 0;
        if (typeof distanceInMeters === "function") {
          distance = distanceInMeters(lat, lng, s.latitude, s.longitude);
        }
        return { ...s, distance };
      });

      let nearbyNow = withDistance.filter(
        (s) => s.distance <= NEARBY_FULL_RADIUS_METERS
      );

      nearbyNow.forEach((s) => markSessionSeen(s.id));

      let combined = withDistance.filter((s) => seenNearbySessionIds.includes(s.id));

      if (!combined.length) {
        lastNearbySessions = [];
        setNearbyStatus("No active attendance sessions near your location.");
        renderNearbySessionList([]);
        return;
      }

      lastNearbySessions = combined.slice();

      setNearbyStatus(
        "Found " +
          combined.length +
          " active session" +
          (combined.length > 1 ? "s" : "") +
          " near you (based on your recent location)."
      );

      renderNearbySessionList(combined);
    } catch (e) {
      setNearbyStatus(
        "We couldn't load nearby attendance right now. Please check your internet connection. We'll keep showing the last sessions we found."
      );
    }
  }

  function switchNearbyMode(mode) {
    if (mode !== "location" && mode !== "nonlocation") return;
    if (nearCurrentMode === mode) return;

    nearCurrentMode = mode;
    showNearSubscreen("list");
    showNearbyGlobalBanner("");
    clearNearbyJoinMessages();
    showStudentDetailsForm(false);

    const btnLoc = document.getElementById("nearModeLocation");
    const btnNon = document.getElementById("nearModeNonLocation");
    const searchRow = document.getElementById("nearSearchRow");

    if (btnLoc && btnNon) {
      btnLoc.classList.toggle("active", mode === "location");
      btnNon.classList.toggle("active", mode === "nonlocation");
    }

    if (searchRow) {
      if (mode === "nonlocation") searchRow.classList.remove("near-hidden");
      else searchRow.classList.add("near-hidden");
    }

    clearNearbySessions();
    showNearbyEmpty(false);

    loadNearbySessions();
  }

  document.addEventListener("DOMContentLoaded", () => {
    const refreshBtn = document.getElementById("nearRefreshBtn");
    if (refreshBtn) refreshBtn.addEventListener("click", loadNearbySessions);

    const joinBtn = document.getElementById("nearJoinSubmit");
    if (joinBtn) joinBtn.addEventListener("click", prepareNearbyConfirm);

    const confirmOk = document.getElementById("nearConfirmOk");
    if (confirmOk) confirmOk.addEventListener("click", confirmNearbyJoin);

    const confirmCancel = document.getElementById("nearConfirmCancel");
    if (confirmCancel) {
      confirmCancel.addEventListener("click", () => showNearSubscreen("join"));
    }

    const confirmClose = document.getElementById("nearConfirmClose");
    if (confirmClose) {
      confirmClose.addEventListener("click", () => showNearSubscreen("join"));
    }

    const joinClose = document.getElementById("nearJoinClose");
    if (joinClose) {
      joinClose.addEventListener("click", () => {
        showNearSubscreen("list");
        clearNearbyJoinMessages();
        showStudentDetailsForm(false);
      });
    }

    const studentSave = document.getElementById("nearStudentSave");
    if (studentSave) {
      studentSave.addEventListener("click", saveStudentDetailsAndContinue);
    }

    const btnModeLoc = document.getElementById("nearModeLocation");
    const btnModeNon = document.getElementById("nearModeNonLocation");

    if (btnModeLoc) {
      btnModeLoc.addEventListener("click", () => switchNearbyMode("location"));
    }
    if (btnModeNon) {
      btnModeNon.addEventListener("click", () => switchNearbyMode("nonlocation"));
    }

    const searchInput = document.getElementById("nearSearchInput");
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        nearNonLocationSearchTerm = e.target.value || "";
        if (nearCurrentMode === "nonlocation") {
          const filtered = filterNonLocationSessions();
          renderNearbySessionList(filtered);
          if (filtered.length) {
            setNearbyStatus(
              "Showing " +
                filtered.length +
                " non-location attendance session" +
                (filtered.length > 1 ? "s." : ".")
            );
          } else {
            setNearbyStatus("No non-location attendance sessions match your search.");
          }
        }
      });
    }

    const navNearby = document.querySelector('.nav-btn[data-nav="nearby"]');
    if (navNearby) {
      navNearby.addEventListener("click", () => {
        setTimeout(() => {
          loadNearbySessions();
          loadNearbyVerificationState(true);
        }, 0);
      });
    }

    const homeOpenBtn = document.querySelector(".nearby-open-btn");
    if (homeOpenBtn) {
      homeOpenBtn.addEventListener("click", () => {
        setTimeout(() => {
          loadNearbySessions();
          loadNearbyVerificationState(true);
        }, 0);
      });
    }

    const courseFormBtn = document.getElementById("nearVerifyCourseFormBtn");
    if (courseFormBtn) {
      courseFormBtn.addEventListener("click", openCourseFormPage);
    }

    const biometricBtn = document.getElementById("nearVerifyBiometricBtn");
    if (biometricBtn) {
      biometricBtn.addEventListener("click", openBiometricPage);
    }

    handleFaceVerificationReturn();

    setInterval(() => {
      const outer = document.getElementById("screen-nearby");
      if (outer && outer.classList.contains("active")) {
        loadNearbySessions();
      }
    }, NEARBY_REFRESH_INTERVAL_MS);

    loadNearbySessions();
    loadNearbyVerificationState(true);
  });
</script>

