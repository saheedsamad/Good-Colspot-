  async function ensureCurrentUser() {
    if (currentUser) return currentUser;
    if (typeof supabase === "undefined") return null;

    try {
      const { data, error } = await supabase.auth.getUser();
      if (error || !data || !data.user) {
        scheduleOfflineRetry();
        return null;
      }
      currentUser = data.user;
      saveLocalUserFromSupabaseUser(currentUser);
      return currentUser;
    } catch (e) {
      console.error("ensureCurrentUser failed:", e);
      scheduleOfflineRetry();
      return null;
    }
  }

  async function loadMiniHistory() {
    const listEl = document.getElementById("historyList");
    if (!listEl) return;

    listEl.innerHTML =
      '<div class="history-empty">Loading your recent sessions...</div>';

    if (typeof supabase === "undefined") {
      listEl.innerHTML =
        '<div class="history-empty">We’re having trouble talking to the server. Please check your internet connection or close and reopen Colspot.</div>';
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (isBrowserOffline()) {
        listEl.innerHTML =
          '<div class="history-empty">No internet connection. We’ll try again automatically…</div>';
      } else {
        listEl.innerHTML =
          '<div class="history-empty">Trying to reconnect… we’ll update this automatically.</div>';
      }
      scheduleOfflineRetry();
      return;
    }

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("id, course_code, starts_at, created_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(20);

      if (error) throw error;

      const sessions = data || [];
      if (!sessions.length) {
        listEl.innerHTML =
          '<div class="history-empty">No previous sessions yet. Create one to get started.</div>';
        updateHistoryUnreadBadge(0);
        stopOfflineRetry();
        return;
      }

      const lastSeenRaw = getHistoryLastSeenAt();
      const lastSeenTime = lastSeenRaw ? new Date(lastSeenRaw).getTime() : 0;

      let unreadCount = 0;
      sessions.forEach((s) => {
        const createdTime = new Date(s.created_at || s.starts_at || 0).getTime();
        if (createdTime && createdTime > lastSeenTime) unreadCount += 1;
      });

      updateHistoryUnreadBadge(unreadCount);

      const s = sessions[0];
      const baseDateStr = s.starts_at || s.created_at;
      const d = baseDateStr ? new Date(baseDateStr) : null;
      const timeStr = d
        ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "--:--";

      const code = s.course_code || "Attendance session";

      listEl.innerHTML = "";
      const item = document.createElement("div");
      item.className = "history-item";

      const header = document.createElement("div");
      header.className = "history-item-header";

      const course = document.createElement("div");
      course.className = "history-course";
      course.textContent = code;

      const time = document.createElement("div");
      time.className = "history-time";
      time.textContent = timeStr;

      header.appendChild(course);
      header.appendChild(time);

      const meta = document.createElement("div");
      meta.className = "history-meta";
      meta.textContent =
        unreadCount > 0
          ? `${unreadCount} unread • Last session you created`
          : "Last session you created";

      const track = document.createElement("div");
      track.className = "history-progress-track";

      const bar = document.createElement("div");
      bar.className = "history-progress-bar";
      track.appendChild(bar);

      item.appendChild(header);
      item.appendChild(meta);
      item.appendChild(track);

      listEl.appendChild(item);

      stopOfflineRetry();
    } catch (e) {
      console.error(e);
      listEl.innerHTML =
        '<div class="history-empty">Could not load history yet. We’ll keep trying in the background.</div>';
      scheduleOfflineRetry();
    }
  }

  function initNearbyAttendance() {
    const statusEl = document.getElementById("nearbyStatus");
    if (!statusEl) return;

    if (!locationEnabled) {
      statusEl.textContent =
        "Location is off. Turn it on to see nearby sessions, or use a PIN from your lecturer.";
      return;
    }

    if (isBrowserOffline()) {
      statusEl.textContent =
        "No internet connection. We’ll refresh nearby sessions when you’re back online.";
      scheduleOfflineRetry();
      return;
    }

    if (!("geolocation" in navigator)) {
      showLastSessionFallback(statusEl);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        if (typeof supabase === "undefined") {
          statusEl.textContent =
            "Location is OK but we can’t reach Colspot servers right now. Please check your internet or close and reopen the app.";
          return;
        }

        try {
          const nowIso = new Date().toISOString();

          const { data, error } = await supabase
            .from("attendance_sessions")
            .select(
              "id, course_code, expires_at, latitude, longitude, created_at"
            )
            .gte("expires_at", nowIso);

          if (error) throw error;

          const sessions = (data || []).filter(
            (s) =>
              typeof s.latitude === "number" &&
              typeof s.longitude === "number"
          );

          let nearby = sessions.filter((s) => {
            const d = distanceInMeters(lat, lng, s.latitude, s.longitude);
            return d <= NEARBY_RADIUS_METERS;
          });

          if (!nearby.length && sessions.length > 0) {
            sessions.sort((a, b) => {
              const da = distanceInMeters(lat, lng, a.latitude, a.longitude);
              const db = distanceInMeters(lat, lng, b.latitude, b.longitude);
              return da - db;
            });
            nearby = [sessions[0]];
          }

          if (!nearby.length) {
            await showLastSessionFallback(statusEl);
            return;
          }

          const s0 = nearby[0];
          const end = s0.expires_at ? new Date(s0.expires_at) : null;
          const timeStr = end
            ? end.toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit"
              })
            : "--:--";

          const code = s0.course_code || "Attendance session";
          statusEl.textContent = `Active near you: ${code} (until ${timeStr})`;

          stopOfflineRetry();
        } catch (e) {
          console.error(e);
          statusEl.textContent =
            "Error loading nearby attendance. We’ll keep trying in the background. You can still create a session.";
          scheduleOfflineRetry();
        }
      },
      async () => {
        await showLastSessionFallback(statusEl);
      },
      {
        enableHighAccuracy: false,
        maximumAge: 60000,
        timeout: 10000
      }
    );
  }

  async function showLastSessionFallback(statusEl) {
    if (typeof supabase === "undefined") {
      statusEl.textContent =
        "We couldn’t reach the server yet. Please check your internet connection or try again in a moment.";
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (isBrowserOffline()) {
        statusEl.textContent =
          "No internet connection. We’ll try again automatically…";
      } else {
        statusEl.textContent =
          "Trying to reconnect… we’ll update this automatically.";
      }
      scheduleOfflineRetry();
      return;
    }

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("course_code, starts_at, created_at, expires_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;

      const s = (data || [])[0];
      if (!s) {
        statusEl.textContent =
          "No attendance sessions yet. Create one to get started.";
        stopOfflineRetry();
        return;
      }

      const baseDateStr = s.starts_at || s.expires_at || s.created_at;
      const d = baseDateStr ? new Date(baseDateStr) : null;
      const timeStr = d
        ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "--:--";

      const code = s.course_code || "Attendance session";
      statusEl.textContent = `Last session you created: ${code} (at ${timeStr})`;

      stopOfflineRetry();
    } catch (e) {
      console.error(e);
      statusEl.textContent =
        "We couldn't load your recent sessions yet. We’ll keep trying. You can still create a new one.";
      scheduleOfflineRetry();
    }
  }

  async function loadAnnouncements() {
    const section = document.getElementById("announcementSection");
    const titleEl = document.getElementById("announcementTitle");
    const msgEl = document.getElementById("announcementMessage");
    if (!section || !titleEl || !msgEl) return;

    if (typeof supabase === "undefined") {
      section.style.display = "none";
      return;
    }

    try {
      const { data, error } = await supabase
        .from("app_announcements")
        .select("id,title,message,show_until,is_active,created_at")
        .eq("is_active", true)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;
      const ann = data && data[0];

      if (!ann) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      if (ann.show_until && new Date(ann.show_until) < new Date()) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      const dismissKey = "colspot_announcement_dismissed_" + ann.id;
      if (localStorage.getItem(dismissKey) === "1") {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      section.dataset.announcementId = ann.id;
      titleEl.textContent = ann.title || "Update";
      msgEl.textContent = ann.message || "";
      section.style.display = "block";

      stopOfflineRetry();
    } catch (e) {
      console.error("loadAnnouncements failed:", e);
      scheduleOfflineRetry();
    }
  }

