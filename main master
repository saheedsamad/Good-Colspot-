            <span id="joinedCount"><strong>0</strong> joined</span>
          </div>
        </div>

        <div class="pill-row">
          <button class="pill-btn primary" type="button" onclick="reloadAttendees()">
            <svg viewBox="0 0 24 24">
              <path d="M4 4v6h6" />
              <path d="M20 20v-6h-6" />
              <path d="M5 19a9 9 0 0 0 14-3" />
              <path d="M19 5a9 9 0 0 0-14 3" />
            </svg>
            <span>Refresh</span>
          </button>

          <button class="pill-btn" type="button" onclick="downloadAttendeesCsv()">
            <svg viewBox="0 0 24 24">
              <path d="M12 3v9" />
              <path d="M8.5 9.5L12 13l3.5-3.5" />
              <path d="M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
            </svg>
            <span>Download CSV</span>
          </button>
        </div>

        <div class="end-session-row">
          <button
            id="endSessionBtn"
            class="end-session-btn"
            type="button"
            onclick="endSession()"
          >
            <svg viewBox="0 0 24 24">
              <rect x="5" y="5" width="14" height="14" rx="3" />
              <path d="M9 9h6v6H9z" />
            </svg>
            <span class="end-session-label">End session</span>
          </button>
        </div>
      </section>

      <section>
        <div class="attendee-header-bar">
          <div class="section-title">Attendees</div>
          <button class="add-student-btn" onclick="openAddStudentModal()">Add student</button>
        </div>
        <p class="section-sub">
          Students who have successfully joined this session.
        </p>

        <div class="filter-wrapper">
          <input
            id="attendeeFilter"
            class="attendee-filter"
            type="text"
            placeholder="Filter by name, matric or department"
            oninput="applyAttendeeFilter()"
          />
          <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6" />
            <path d="M16 16l4 4" />
          </svg>
        </div>

        <div class="attendee-header-row">
          <div>Name</div>
          <div>Matric no</div>
          <div>Department</div>
          <div>Joined at</div>
        </div>

        <div id="errorBox" class="error-text" style="display:none;"></div>

        <div id="attendeeList" class="attendee-list"></div>
        <div id="emptyState" class="empty-state" style="display:none;">
          No one has joined yet. Ask your class to enter the PIN in Colspot.
        </div>
      </section>
    </main>

    <div id="addStudentModal" class="modal-backdrop" style="display:none;">
      <div class="modal-sheet">
        <div class="modal-grip"></div>
        <div class="modal-title">Add student</div>
        <div class="modal-sub">
          Manually add a student who is in the class but cannot join from their device.
        </div>

        <div class="modal-field">
          <div class="modal-label">
            Full name <span style="color:var(--error);">*</span>
          </div>
          <input
            id="modalStudentName"
            type="text"
            class="modal-input"
            placeholder="e.g. John Doe"
          />
        </div>

        <div class="modal-field">
          <div class="modal-label">Matric number (optional)</div>
          <input
            id="modalStudentMatric"
            type="text"
            class="modal-input"
            placeholder="e.g. CSC/22/001"
          />
        </div>

        <div class="modal-field">
          <div class="modal-label">Department (optional)</div>
          <input
            id="modalStudentDept"
            type="text"
            class="modal-input"
            placeholder="e.g. Computer Science"
          />
        </div>

        <div id="modalStudentError" class="error-text" style="display:none;"></div>

        <div class="modal-actions">
          <button type="button" class="modal-btn" onclick="closeAddStudentModal()">
            Cancel
          </button>
          <button
            type="button"
            id="modalAddBtn"
            class="modal-btn modal-btn-primary"
            onclick="submitAddStudentModal()"
          >
            Add student
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.liveSessionScreenState = window.liveSessionScreenState || {
    supabaseReady: false,
    currentUser: null,
    currentSessionId: null,
    currentSession: null,
    countdownInterval: null,
    attendeesInterval: null,
    currentAttendees: []
  };

  function showError(msg) {
    const box = document.getElementById("errorBox");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function updateEndButtonState(isEnded) {
    const endBtn = document.getElementById("endSessionBtn");
    if (!endBtn) return;
    const labelSpan = endBtn.querySelector(".end-session-label");

    if (isEnded) {
      endBtn.disabled = true;
      endBtn.classList.add("ended");
      if (labelSpan) labelSpan.textContent = "Session ended";
    } else {
      endBtn.disabled = false;
      endBtn.classList.remove("ended");
      if (labelSpan) labelSpan.textContent = "End session";
    }
  }

  function setSessionHeader(session) {
    const classEl = document.getElementById("sessionClass");
    const classSubEl = document.getElementById("sessionClassSub");
    const pinEl = document.getElementById("pinValue");
    const statusPill = document.getElementById("statusPill");
    const state = window.liveSessionScreenState;

    const title = session.course_code || "Attendance session";
    if (classEl) classEl.textContent = title;

    if (classSubEl) {
      const started = session.starts_at
        ? new Date(session.starts_at)
        : session.created_at
        ? new Date(session.created_at)
        : null;

      if (started) {
        const timeStr = started.toLocaleTimeString([], {
          hour: "2-digit",
          minute: "2-digit",
        });
        classSubEl.textContent = `Started at ${timeStr}.`;
      } else {
        classSubEl.textContent = "Live attendance session.";
      }
    }

    if (pinEl) pinEl.textContent = session.pin_code || "------";

    let isEnded = false;
    if (statusPill) {
      const now = new Date();
      const end = session.expires_at ? new Date(session.expires_at) : null;
      isEnded = !session.is_active || (end && now > end);

      if (isEnded) {
        statusPill.classList.add("expired");
        statusPill.querySelector("span:last-child").textContent = "Ended";
      } else {
        statusPill.classList.remove("expired");
        statusPill.querySelector("span:last-child").textContent = "Active";
      }
    }

    updateEndButtonState(isEnded);
    startOrUpdateTimer(session);
  }

  function startOrUpdateTimer(session) {
    const timerEl = document.getElementById("timerValue");
    const statusPill = document.getElementById("statusPill");
    const state = window.liveSessionScreenState;
    if (!timerEl) return;

    if (state.countdownInterval) {
      clearInterval(state.countdownInterval);
      state.countdownInterval = null;
    }

    const endTime = session.expires_at ? new Date(session.expires_at) : null;
    if (!endTime) {
      timerEl.textContent = "--:--";
      return;
    }

    function update() {
      const now = new Date();
      const diffMs = endTime - now;

      if (diffMs <= 0 || session.is_active === false) {
        timerEl.textContent = "00:00";
        if (statusPill) {
          statusPill.classList.add("expired");
          statusPill.querySelector("span:last-child").textContent = "Ended";
        }
        updateEndButtonState(true);
        clearInterval(state.countdownInterval);
        state.countdownInterval = null;
        return;
      }

      const totalSeconds = Math.floor(diffMs / 1000);
      const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, "0");
      const seconds = String(totalSeconds % 60).padStart(2, "0");

      timerEl.textContent = `${minutes}:${seconds}`;
      if (statusPill) {
        statusPill.classList.remove("expired");
        statusPill.querySelector("span:last-child").textContent = "Active";
      }
      updateEndButtonState(false);
    }

    update();
    state.countdownInterval = setInterval(update, 1000);
  }

  function setJoinedCount(count) {
    const el = document.getElementById("joinedCount");
    if (!el) return;
    el.innerHTML = `<strong>${count}</strong> joined`;
  }

  async function loadSessionAndAttendees() {
    const state = window.liveSessionScreenState;
    if (!state.supabaseReady || !state.currentSessionId) return;

    showError("");

    const attendeeList = document.getElementById("attendeeList");
    const emptyState = document.getElementById("emptyState");
    if (attendeeList) attendeeList.innerHTML = "";
    if (emptyState) emptyState.style.display = "none";

    const { data: session, error: sessionError } = await supabase
      .from("attendance_sessions")
      .select(
        "id, course_code, pin_code, starts_at, expires_at, created_at, is_active"
      )
      .eq("id", state.currentSessionId)
      .single();

    if (sessionError || !session) {
      console.error(sessionError || "Session not found");
      showError("Could not load this session. It may have been removed.");
      return;
    }

    state.currentSession = session;
    setSessionHeader(session);

    const now = new Date();
    const end = session.expires_at ? new Date(session.expires_at) : null;
    const isEnded = !session.is_active || (end && now > end);
    if (isEnded && state.attendeesInterval) {
      clearInterval(state.attendeesInterval);
      state.attendeesInterval = null;
    }

    const { data: records, error: recError } = await supabase
      .from("attendance_records")
      .select(
        "id, student_name, student_matric, student_department, checked_in_at"
      )
      .eq("session_id", state.currentSessionId)
      .order("checked_in_at", { ascending: true });

    if (recError) {
      console.error(recError);
      showError("Could not load attendees. Please try again.");
      return;
    }

    state.currentAttendees = records || [];
    setJoinedCount(state.currentAttendees.length);

    const filterEl = document.getElementById("attendeeFilter");
    const hasFilter =
      filterEl && filterEl.value && filterEl.value.trim().length > 0;

    if (hasFilter) {
      applyAttendeeFilter();
    } else {
      renderAttendees(state.currentAttendees);
    }
  }

  function renderAttendees(list) {
    const attendeeList = document.getElementById("attendeeList");
    const emptyState = document.getElementById("emptyState");
    if (!attendeeList || !emptyState) return;

    attendeeList.innerHTML = "";

    if (!list.length) {
      emptyState.style.display = "block";
      return;
    }

    emptyState.style.display = "none";

    list.forEach((rec) => {
      const card = document.createElement("div");
      card.className = "attendee-card";

      card.addEventListener("click", () => handleAttendeeClick(rec));

      const nameCell = document.createElement("div");
      nameCell.className = "attendee-cell";
      const label =
        rec.student_name && rec.student_name.trim().length > 0
          ? rec.student_name.trim()
          : rec.student_matric && rec.student_matric.trim().length > 0
          ? rec.student_matric.trim()
          : "Student";
      nameCell.textContent = label;

      const matricCell = document.createElement("div");
      matricCell.className = "attendee-cell";
      matricCell.textContent =
        (rec.student_matric && rec.student_matric.trim()) || "—";

      const deptCell = document.createElement("div");
      deptCell.className = "attendee-cell";
      deptCell.textContent =
        (rec.student_department && rec.student_department.trim()) || "—";

      const timeCell = document.createElement("div");
      timeCell.className = "attendee-cell attendee-cell-small";
      const t = rec.checked_in_at ? new Date(rec.checked_in_at) : null;
      timeCell.textContent = t
        ? t.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "—";

      card.appendChild(nameCell);
      card.appendChild(matricCell);
      card.appendChild(deptCell);
      card.appendChild(timeCell);

      attendeeList.appendChild(card);
    });
  }

  function applyAttendeeFilter() {
    const filterEl = document.getElementById("attendeeFilter");
    const state = window.liveSessionScreenState;
    if (!filterEl) return;

    const q = filterEl.value.toLowerCase().trim();
    if (!q) {
      renderAttendees(state.currentAttendees);
      return;
    }

    const filtered = state.currentAttendees.filter((rec) => {
      const name = (rec.student_name || "").toLowerCase();
      const matric = (rec.student_matric || "").toLowerCase();
      const dept = (rec.student_department || "").toLowerCase();
      return name.includes(q) || matric.includes(q) || dept.includes(q);
    });

    renderAttendees(filtered);
  }

  async function handleAttendeeClick(rec) {
    const label =
      (rec.student_name && rec.student_name.trim()) ||
      (rec.student_matric && rec.student_matric.trim()) ||
      "this student";

    const ok = window.confirm(`Remove ${label} from this session?`);
    if (!ok) return;

    try {
      const { error } = await supabase
        .from("attendance_records")
        .delete()
        .eq("id", rec.id);

      if (error) {
        console.error(error);
        showError("Could not remove student. Please try again.");
        return;
      }

      await loadSessionAndAttendees();
    } catch (e) {
      console.error(e);
      showError("Could not remove student. Please try again.");
    }
  }

  function openAddStudentModal() {
    const state = window.liveSessionScreenState;
    if (!state.supabaseReady || !state.currentSessionId) {
      showError("Session not ready. Try reloading.");
      return;
    }
    const modal = document.getElementById("addStudentModal");
    const nameInput = document.getElementById("modalStudentName");
    const matricInput = document.getElementById("modalStudentMatric");
    const deptInput = document.getElementById("modalStudentDept");
    const err = document.getElementById("modalStudentError");

    if (nameInput) nameInput.value = "";
    if (matricInput) matricInput.value = "";
    if (deptInput) deptInput.value = "";
    if (err) {
      err.textContent = "";
      err.style.display = "none";
    }

    if (modal) modal.style.display = "flex";

    setTimeout(() => {
      if (nameInput) nameInput.focus();
    }, 50);
  }

  function closeAddStudentModal() {
    const modal = document.getElementById("addStudentModal");
    if (modal) modal.style.display = "none";
  }

  async function submitAddStudentModal() {
    const state = window.liveSessionScreenState;
    const nameInput = document.getElementById("modalStudentName");
    const matricInput = document.getElementById("modalStudentMatric");
    const deptInput = document.getElementById("modalStudentDept");
    const err = document.getElementById("modalStudentError");
    const btn = document.getElementById("modalAddBtn");

    if (!nameInput || !btn) return;

    const name = (nameInput.value || "").trim();
    const matric = (matricInput?.value || "").trim();
    const dept = (deptInput?.value || "").trim();

    if (!name) {
      if (err) {
        err.textContent = "Student name is required.";
        err.style.display = "block";
      }
      nameInput.focus();
      return;
    }

    if (!state.supabaseReady || !state.currentSessionId) {
      if (err) {
        err.textContent = "Session not ready. Try reloading.";
        err.style.display = "block";
      }
      return;
    }

    btn.disabled = true;
    btn.textContent = "Adding…";
    if (err) {
      err.textContent = "";
      err.style.display = "none";
    }

    try {
      const { error } = await supabase.from("attendance_records").insert([
        {
          session_id: state.currentSessionId,
          user_id: null,
          student_name: name,
          student_matric: matric || null,
          student_department: dept || null,
          checked_in_at: new Date().toISOString(),
        },
      ]);

      if (error) {
        console.error(error);
        if (err) {
          err.textContent = "Could not add student. Please try again.";
          err.style.display = "block";
        }
        btn.disabled = false;
        btn.textContent = "Add student";
        return;
      }

      closeAddStudentModal();
      await loadSessionAndAttendees();
    } catch (e) {
      console.error(e);
      if (err) {
        err.textContent = "Could not add student. Please try again.";
        err.style.display = "block";
      }
    } finally {
      btn.disabled = false;
      btn.textContent = "Add student";
    }
  }

  function downloadAttendeesCsv() {
    const state = window.liveSessionScreenState;
    if (!state.currentAttendees.length) {
      alert("No attendees to download yet.");
      return;
    }

    const header = ["Name", "Matric number", "Department", "Joined at"];
    const esc = (v) => `"${String(v).replace(/"/g, '""')}"`;

    const rows = state.currentAttendees.map((rec) => {
      const name =
        (rec.student_name && rec.student_name.trim()) ||
        (rec.student_matric && rec.student_matric.trim()) ||
        "Student";
      const matric = (rec.student_matric || "").trim();
      const dept = (rec.student_department || "").trim();
      const t = rec.checked_in_at ? new Date(rec.checked_in_at) : null;
      const joined = t ? t.toISOString() : "";

      return [name, matric, dept, joined].map(esc).join(",");
    });

    const csv = [header.join(","), ...rows].join("\n");

    const sessionTitle = state.currentSession
      ? state.currentSession.course_code || "attendance_session"
      : "attendance_session";
    const filename = `${sessionTitle}_attendees.csv`;

    try {
      if (navigator.share && window.File) {
        const file = new File([csv], filename, { type: "text/csv" });
        navigator
          .share({
            files: [file],
            title: "Attendance export",
            text: "Colspot attendance CSV",
          })
          .catch((err) => {
            console.warn("Share cancelled or failed:", err);
          });
        return;
      }
    } catch (e) {
      console.warn("navigator.share path failed:", e);
    }

    try {
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      a.style.display = "none";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      return;
    } catch (e) {
      console.warn("Blob download failed, trying data URL:", e);
    }

    const dataUrl =
      "data:text/csv;charset=utf-8," + encodeURIComponent(csv);
    window.open(dataUrl, "_blank");
  }

  function reloadAttendees() {
    loadSessionAndAttendees();
  }

  async function endSession() {
    const state = window.liveSessionScreenState;
    if (!state.supabaseReady || !state.currentSessionId || !state.currentUser) return;

    const confirmed = window.confirm(
      "End this attendance session now? Students will no longer be able to join."
    );
    if (!confirmed) return;

    try {
      const nowIso = new Date().toISOString();

      const { error } = await supabase
        .from("attendance_sessions")
        .update({
          is_active: false,
          expires_at: nowIso,
        })
        .eq("id", state.currentSessionId)
        .eq("created_by", state.currentUser.id);

      if (error) {
        console.error(error);
        showError("Could not end session. Please try again.");
        return;
      }

      if (state.attendeesInterval) {
        clearInterval(state.attendeesInterval);
        state.attendeesInterval = null;
      }

      if (state.currentSession) {
        state.currentSession.is_active = false;
        state.currentSession.expires_at = nowIso;
        setSessionHeader(state.currentSession);
      } else {
        updateEndButtonState(true);
      }

      alert("Session ended. Students can no longer join.");
    } catch (e) {
      console.error(e);
      showError("Could not end session. Please try again.");
    }
  }

  function getSessionIdFromState() {
    const selected = window.historyScreenState?.selectedAttendanceSession || null;
    if (selected?.id) return selected.id;
    return null;
  }

  async function openLiveSessionScreen() {
    const state = window.liveSessionScreenState;
    await new Promise((r) => setTimeout(r, 50));

    if (typeof supabase === "undefined") {
      console.error("Supabase client missing on live session screen");
      return;
    }

    state.supabaseReady = true;

    const { data, error } = await supabase.auth.getUser();
    if (error || !data || !data.user) {
      if (typeof showScreen === "function") showScreen("home");
      return;
    }

    state.currentUser = data.user;
    state.currentSessionId = getSessionIdFromState();

    if (!state.currentSessionId) {
      showError("No active session found. Start an attendance session first.");
      return;
    }

    if (state.countdownInterval) clearInterval(state.countdownInterval);
    if (state.attendeesInterval) clearInterval(state.attendeesInterval);

    await loadSessionAndAttendees();
    state.attendeesInterval = setInterval(loadSessionAndAttendees, 3000);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("addStudentModal");
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeAddStudentModal();
      });
    }
  });

  window.openLiveSessionScreen = openLiveSessionScreen;
</script>
