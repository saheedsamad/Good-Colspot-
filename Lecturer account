<!-- 🔹 ACCOUNT SCREEN START -->
<div id="screen-account" class="screen">
  <style>
    #screen-account {
      padding: 4px 2px 16px;
    }

    #screen-account .account-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin: 4px 2px 8px;
    }

    #screen-account .account-header-left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    #screen-account .account-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
    }

    #screen-account .account-sub {
      font-size: 12px;
      color: var(--text-muted);
    }

    #screen-account .profile-card {
      background: #f9fafb;
      border-radius: 24px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
      padding: 18px 16px 18px;
      margin-bottom: 14px;
    }

    #screen-account .profile-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    #screen-account .avatar-wrap {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    #screen-account .avatar-circle {
      width: 96px;
      height: 96px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 40px;
      font-weight: 700;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    #screen-account .avatar-circle img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: none;
      z-index: 2;
    }

    #screen-account .avatar-circle span {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
    }

    #screen-account .change-avatar-btn {
      padding: 7px 18px;
      border-radius: 999px;
      border: 1px solid #d1ddff;
      background: #e0ecff;
      font-size: 12px;
      font-weight: 600;
      color: #1d4ed8;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    #screen-account .role-pill {
      margin-top: 2px;
      padding: 4px 14px;
      border-radius: 999px;
      background: #e5edff;
      color: #1e40af;
      font-size: 11px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    #screen-account .profile-detail-card {
      margin-top: 12px;
      border-radius: 20px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      padding: 4px 0;
    }

    #screen-account .detail-row {
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #screen-account .detail-row + .detail-row {
      border-top: 1px solid #e5e7eb;
    }

    #screen-account .detail-icon {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: #eef2ff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #screen-account .detail-icon svg {
      width: 16px;
      height: 16px;
      stroke-width: 1.7;
      stroke: #4f46e5;
      fill: none;
    }

    #screen-account .detail-text {
      flex: 1;
      min-width: 0;
    }

    #screen-account .detail-label {
      font-size: 12px;
      color: var(--text-muted);
    }

    #screen-account .detail-value {
      font-size: 14px;
      color: var(--text-main);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #screen-account .actions-row {
      display: flex;
      gap: 8px;
      margin-bottom: 4px;
    }

    #screen-account .delete-row {
      margin: 4px 0 10px;
    }

    #screen-account .action-btn {
      flex: 1;
      padding: 9px 10px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
    }

    #screen-account .delete-row .action-btn {
      width: 100%;
      justify-content: center;
    }

    #screen-account .action-btn.logout,
    #screen-account .action-btn.danger {
      border-color: #fecaca;
      background: #fef2f2;
      color: #b91c1c;
    }

    #screen-account .action-btn svg {
      width: 16px;
      height: 16px;
      stroke-width: 1.7;
      stroke: currentColor;
      fill: none;
    }

    #screen-account .status-text {
      font-size: 12px;
      margin: 0 4px 4px;
      min-height: 16px;
      line-height: 1.45;
    }

    #screen-account .status-text.success {
      color: #16a34a;
    }

    #screen-account .status-text.error {
      color: #dc2626;
    }
  </style>

  <div class="account-header">
    <div class="account-header-left">
      <div>
        <div class="account-title">Account</div>
        <div class="account-sub">View your lecturer profile.</div>
      </div>
    </div>
  </div>

  <section id="accountViewScreen">
    <div class="profile-card">
      <div class="profile-top">
        <div class="avatar-wrap">
          <div class="avatar-circle" id="viewAvatarCircle">
            <img id="viewAvatarImg" src="" alt="Profile picture" />
            <span id="avatarInitial">L</span>
          </div>

          <input
            id="avatarFileInput"
            type="file"
            accept="image/*"
            style="display:none;"
          />

          <button class="change-avatar-btn" type="button" id="changeAvatarBtn">
            Change
          </button>
        </div>

        <div class="role-pill" id="rolePill">Lecturer account</div>
      </div>

      <div class="profile-detail-card">
        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 18c1-3 3-4.5 7-4.5s6 1.5 7 4.5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Full name</div>
            <div class="detail-value" id="viewNameValue">Lecturer</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M3 9l9-5 9 5"></path>
              <path d="M5 10v6"></path>
              <path d="M9 12v4"></path>
              <path d="M15 12v4"></path>
              <path d="M19 10v6"></path>
              <path d="M4 18h16"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">School</div>
            <div class="detail-value" id="viewSchoolValue">School</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="14" rx="2"></rect>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Staff ID</div>
            <div class="detail-value" id="viewStaffIdValue">—</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Email</div>
            <div class="detail-value" id="viewEmailValue">you@example.com</div>
          </div>
        </div>
      </div>
    </div>

    <div class="actions-row">
      <button class="action-btn" onclick="accountContactUs()">
        <svg viewBox="0 0 24 24">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Contact support
      </button>

      <button class="action-btn logout" onclick="accountSignOut()">
        <svg viewBox="0 0 24 24">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <path d="M16 17l5-5-5-5"></path>
          <path d="M21 12H9"></path>
        </svg>
        Sign out
      </button>
    </div>

    <div class="delete-row">
      <button class="action-btn danger" onclick="accountDeleteAccount()">
        <svg viewBox="0 0 24 24">
          <path d="M3 6h18"></path>
          <path d="M8 6V4h8v2"></path>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
          <path d="M10 11v6"></path>
          <path d="M14 11v6"></path>
        </svg>
        Delete account
      </button>
    </div>

    <div id="accountStatusText" class="status-text"></div>
  </section>
</div>

<script>
  let accountCurrentUser = null;
  const ACCOUNT_DEVICE_STORAGE_KEY = "colspot_device_id_v2";

  function setAccountStatus(message, type = "") {
    const el = document.getElementById("accountStatusText");
    if (!el) return;
    el.textContent = message || "";
    el.className = "status-text";
    if (type) el.classList.add(type);
  }

  function applyAvatarToUI(avatarUrl, initial) {
    const img = document.getElementById("viewAvatarImg");
    const txt = document.getElementById("avatarInitial");
    const safeInitial = initial || "L";

    if (avatarUrl) {
      if (img) {
        img.src = avatarUrl;
        img.style.display = "block";
      }
      if (txt) {
        txt.textContent = "";
        txt.style.display = "none";
      }
    } else {
      if (img) {
        img.removeAttribute("src");
        img.style.display = "none";
      }
      if (txt) {
        txt.textContent = safeInitial;
        txt.style.display = "flex";
      }
    }
  }

  function applyLecturerAccountDataToView({ name, school, staffId, email, avatarUrl }) {
    const safeName =
      name ||
      accountCurrentUser?.user_metadata?.full_name ||
      "Lecturer";

    const safeSchool =
      school ||
      accountCurrentUser?.user_metadata?.school_name ||
      "School";

    const safeStaffId =
      staffId ||
      accountCurrentUser?.user_metadata?.staff_id ||
      "—";

    const safeEmail =
      email ||
      accountCurrentUser?.email ||
      "";

    const initial = safeName.trim()[0]
      ? safeName.trim()[0].toUpperCase()
      : "L";

    applyAvatarToUI(avatarUrl || "", initial);

    const vNameValue = document.getElementById("viewNameValue");
    const vSchoolValue = document.getElementById("viewSchoolValue");
    const vStaffIdValue = document.getElementById("viewStaffIdValue");
    const vEmailValue = document.getElementById("viewEmailValue");
    const rolePill = document.getElementById("rolePill");

    if (vNameValue) vNameValue.textContent = safeName;
    if (vSchoolValue) vSchoolValue.textContent = safeSchool;
    if (vStaffIdValue) vStaffIdValue.textContent = safeStaffId;
    if (vEmailValue) vEmailValue.textContent = safeEmail;
    if (rolePill) rolePill.textContent = "Lecturer account";
  }

  async function loadLecturerAccountProfile() {
    if (!accountCurrentUser || typeof supabase === "undefined") return;

    try {
      const { data, error } = await supabase
        .from("lecturer_accounts")
        .select("full_name, school_name, staff_id, email, avatar_url, avatar_path")
        .eq("user_id", accountCurrentUser.id)
        .maybeSingle();

      if (error) {
        console.error("loadLecturerAccountProfile error:", error);
        applyLecturerAccountDataToView({
          name: accountCurrentUser?.user_metadata?.full_name || "",
          school: accountCurrentUser?.user_metadata?.school_name || "",
          staffId: accountCurrentUser?.user_metadata?.staff_id || "",
          email: accountCurrentUser?.email || "",
          avatarUrl: ""
        });
        return;
      }

      applyLecturerAccountDataToView({
        name: data?.full_name || "",
        school: data?.school_name || "",
        staffId: data?.staff_id || "",
        email: data?.email || accountCurrentUser?.email || "",
        avatarUrl: data?.avatar_url || ""
      });
    } catch (e) {
      console.error("loadLecturerAccountProfile failed:", e);
      applyLecturerAccountDataToView({
        name: accountCurrentUser?.user_metadata?.full_name || "",
        school: accountCurrentUser?.user_metadata?.school_name || "",
        staffId: accountCurrentUser?.user_metadata?.staff_id || "",
        email: accountCurrentUser?.email || "",
        avatarUrl: ""
      });
    }
  }

  async function uploadLecturerAvatar(file) {
    if (!accountCurrentUser || !file || typeof supabase === "undefined") return;

    const ext = (file.name.split(".").pop() || "jpg").toLowerCase();
    const filePath = `lecturer-avatars/${accountCurrentUser.id}/${Date.now()}.${ext}`;

    const { error: uploadError } = await supabase.storage
      .from("avatars")
      .upload(filePath, file, {
        cacheControl: "3600",
        upsert: true
      });

    if (uploadError) throw uploadError;

    const { data: publicData } = supabase.storage
      .from("avatars")
      .getPublicUrl(filePath);

    const avatarUrl = publicData?.publicUrl || "";

    const payload = {
      user_id: accountCurrentUser.id,
      full_name:
        document.getElementById("viewNameValue")?.textContent ||
        accountCurrentUser.user_metadata?.full_name ||
        "Lecturer",
      school_name:
        document.getElementById("viewSchoolValue")?.textContent ||
        accountCurrentUser.user_metadata?.school_name ||
        "",
      staff_id:
        document.getElementById("viewStaffIdValue")?.textContent ||
        accountCurrentUser.user_metadata?.staff_id ||
        "",
      email:
        document.getElementById("viewEmailValue")?.textContent ||
        accountCurrentUser.email ||
        "",
      avatar_path: filePath,
      avatar_url: avatarUrl
    };

    const { error: upsertError } = await supabase
      .from("lecturer_accounts")
      .upsert(payload, { onConflict: "user_id" });

    if (upsertError) throw upsertError;

    applyLecturerAccountDataToView({
      name: payload.full_name,
      school: payload.school_name,
      staffId: payload.staff_id,
      email: payload.email,
      avatarUrl
    });
  }

  async function accountSignOut() {
    try {
      if (typeof supabase !== "undefined") {
        await supabase.auth.signOut();
      }
    } catch (e) {
      console.warn("signOut failed:", e);
    }

    try {
      localStorage.removeItem("colspot_local_user");
    } catch (e) {
      console.warn("Could not clear local cache:", e);
    }

    window.location.href = "index.html";
  }

  function accountContactUs() {
    window.location.href = "mailto:saheedsamad823@gmail.com";
  }

  async function accountDeleteAccount() {
    if (!accountCurrentUser || typeof supabase === "undefined") return;

    const yes = confirm("Are you sure you want to delete this account?");
    if (!yes) return;

    try {
      const userId = accountCurrentUser.id;
      const deletions = [];

      deletions.push(
        supabase.from("lecturer_accounts").delete().eq("user_id", userId)
      );

      deletions.push(
        supabase.from("user_devices").delete().eq("user_id", userId)
      );

      await Promise.allSettled(deletions);

      try {
        if (supabase.functions && supabase.functions.invoke) {
          await supabase.functions.invoke("delete_my_account", { body: {} });
        }
      } catch (e) {
        console.warn("delete_my_account function failed:", e);
      }

      try {
        await supabase.auth.signOut();
      } catch (e) {
        console.warn("signOut after delete failed:", e);
      }

      try {
        localStorage.removeItem("colspot_local_user");
        localStorage.removeItem("colspot_history_cache");
        localStorage.removeItem("colspot_scan_cache");
        localStorage.removeItem(ACCOUNT_DEVICE_STORAGE_KEY);
      } catch (e) {
        console.warn("Failed to clear local cache on delete:", e);
      }

      alert("Your Colspot lecturer account has been deleted.");
      window.location.href = "index.html";
    } catch (e) {
      console.error("accountDeleteAccount error:", e);
      alert("We could not delete your data. Please try again.");
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await new Promise((r) => setTimeout(r, 50));

    if (typeof supabase === "undefined") {
      console.error("Supabase not available on account screen");
      setAccountStatus("Backend not available. Please reload.", "error");
      return;
    }

    const { data, error } = await supabase.auth.getUser();
    if (error || !data || !data.user) {
      return;
    }

    accountCurrentUser = data.user;

    applyLecturerAccountDataToView({
      name: accountCurrentUser.user_metadata?.full_name || "",
      school: accountCurrentUser.user_metadata?.school_name || "",
      staffId: accountCurrentUser.user_metadata?.staff_id || "",
      email: accountCurrentUser.email || "",
      avatarUrl: ""
    });

    const changeAvatarBtn = document.getElementById("changeAvatarBtn");
    const avatarFileInput = document.getElementById("avatarFileInput");

    if (changeAvatarBtn && avatarFileInput) {
      changeAvatarBtn.addEventListener("click", () => {
        avatarFileInput.click();
      });

      avatarFileInput.addEventListener("change", async () => {
        const file = avatarFileInput.files && avatarFileInput.files[0];
        if (!file) return;

        try {
          setAccountStatus("Uploading profile picture...", "success");
          await uploadLecturerAvatar(file);
          setAccountStatus("Profile picture updated.", "success");
        } catch (err) {
          console.error("avatar upload error:", err);
          setAccountStatus("Could not upload profile picture.", "error");
        } finally {
          avatarFileInput.value = "";
        }
      });
    }

    await loadLecturerAccountProfile();
  });

  window.accountSignOut = accountSignOut;
  window.accountContactUs = accountContactUs;
  window.accountDeleteAccount = accountDeleteAccount;
</script>
<!-- 🔹 ACCOUNT SCREEN END -->
