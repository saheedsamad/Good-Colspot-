<!-- 🔹 REPORT DETAILS SCREEN START -->
<div id="screen-report-details" class="screen">
  <style>
    #screen-report-details {
      padding: 8px 6px calc(env(safe-area-inset-bottom) + 90px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      min-height: 100%;
      background: #ffffff;
    }

    #screen-report-details * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    #screen-report-details .rd-shell {
      width: 100%;
      max-width: 430px;
      margin: 0 auto;
    }

    #screen-report-details .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
      padding-top: 0;
      padding-bottom: 4px;
      background: #ffffff;
    }

    #screen-report-details .top-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      flex: 1;
    }

    #screen-report-details .back-btn {
      display: none !important;
    }

    #screen-report-details .back-btn svg {
      width: 22px;
      height: 22px;
    }

    #screen-report-details .title-wrap {
      min-width: 0;
      flex: 1;
    }

    #screen-report-details .page-title {
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -.03em;
      margin-bottom: 2px;
      color: #111827;
      line-height: 1.1;
    }

    #screen-report-details .page-sub {
      font-size: 12px;
      color: #6b7280;
      line-height: 1.4;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 220px;
    }

    #screen-report-details .status-pill {
      border-radius: 999px;
      padding: 8px 11px;
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .06em;
      white-space: nowrap;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.3);
    }

    #screen-report-details .status-new {
      background: #dbeafe;
      color: #1d4ed8;
    }

    #screen-report-details .status-under_review {
      background: #f5f3ff;
      color: #7c3aed;
    }

    #screen-report-details .status-waiting_reply {
      background: #fff7ed;
      color: #ea580c;
    }

    #screen-report-details .status-resolved {
      background: #ecfdf5;
      color: #16a34a;
    }

    #screen-report-details .status-escalated {
      background: #fef2f2;
      color: #dc2626;
    }

    #screen-report-details .message {
      display: none;
      padding: 13px 14px;
      border-radius: 16px;
      font-size: 13px;
      line-height: 1.45;
      font-weight: 700;
      margin-bottom: 14px;
    }

    #screen-report-details .message.show {
      display: block;
    }

    #screen-report-details .message.error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
    }

    #screen-report-details .message.success {
      background: #ecfdf5;
      border: 1px solid #bbf7d0;
      color: #166534;
    }

    #screen-report-details .card {
      background: #ffffff;
      border: 1px solid #e6ebf5;
      border-radius: 22px;
      box-shadow: 0 14px 30px rgba(15,23,42,.07);
      padding: 16px;
      margin-bottom: 14px;
    }

    #screen-report-details .hero-card {
      padding: 18px 16px;
      background:
        linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,251,255,1) 100%);
    }

    #screen-report-details .hero-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    #screen-report-details .hero-copy {
      min-width: 0;
      flex: 1;
    }

    #screen-report-details .hero-title {
      font-size: 22px;
      line-height: 1.12;
      font-weight: 900;
      letter-spacing: -.04em;
      margin-bottom: 6px;
      color: #111827;
      word-break: break-word;
    }

    #screen-report-details .hero-sub {
      font-size: 13px;
      line-height: 1.5;
      color: #6b7280;
      word-break: break-word;
    }

    #screen-report-details .hero-status {
      padding: 8px 11px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .06em;
      white-space: nowrap;
      flex-shrink: 0;
    }

    #screen-report-details .section-title {
      font-size: 15px;
      font-weight: 900;
      margin: 0 0 12px;
      letter-spacing: -.02em;
      color: #111827;
    }

    #screen-report-details .meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    #screen-report-details .meta-box {
      border: 1px solid #e6ebf5;
      border-radius: 16px;
      padding: 12px;
      background: #fff;
      min-width: 0;
    }

    #screen-report-details .meta-label {
      font-size: 11px;
      color: #6b7280;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
      margin-bottom: 5px;
    }

    #screen-report-details .meta-value {
      font-size: 13px;
      font-weight: 800;
      line-height: 1.45;
      word-break: break-word;
      color: #111827;
    }

    #screen-report-details .highlight-card {
      background: linear-gradient(180deg,#f8fbff 0%, #ffffff 100%);
      border-color: #dbeafe;
    }

    #screen-report-details .complaint-box {
      border: 1px solid #dbeafe;
      border-radius: 18px;
      background: linear-gradient(180deg,#f8fbff 0%, #ffffff 100%);
      padding: 15px;
      font-size: 14px;
      line-height: 1.7;
      color: #1f2937;
      white-space: pre-wrap;
      word-break: break-word;
    }

    #screen-report-details .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 2px;
    }

    #screen-report-details .tag {
      padding: 8px 12px;
      border-radius: 999px;
      background: #eff6ff;
      color: #2563eb;
      font-size: 11px;
      font-weight: 800;
    }

    #screen-report-details .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    #screen-report-details .contact-box {
      border: 1px solid #e6ebf5;
      border-radius: 16px;
      padding: 12px;
      background: #fbfdff;
      min-width: 0;
    }

    #screen-report-details .contact-label {
      font-size: 11px;
      color: #6b7280;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
      margin-bottom: 5px;
    }

    #screen-report-details .contact-value {
      font-size: 13px;
      font-weight: 800;
      line-height: 1.5;
      word-break: break-word;
      color: #111827;
    }

    #screen-report-details .loading-box {
      padding: 18px 14px;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid #e6ebf5;
      font-size: 13px;
      color: #6b7280;
      text-align: center;
      box-shadow: 0 14px 30px rgba(15,23,42,.07);
    }

    @media (max-width: 360px) {
      #screen-report-details .meta-grid,
      #screen-report-details .contact-grid {
        grid-template-columns: 1fr;
      }

      #screen-report-details .page-sub {
        max-width: 170px;
      }

      #screen-report-details .hero-top {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <div class="rd-shell">
    <div class="topbar">
      <div class="top-left">
        <div class="title-wrap">
          <div class="page-title">Report Details</div>
          <div class="page-sub" id="reportDetailsPageSub">Loading report...</div>
        </div>
      </div>

      <div class="status-pill status-new" id="reportDetailsStatusPill">new</div>
    </div>

    <div class="message" id="reportDetailsMessage"></div>

    <div id="reportDetailsLoading" class="loading-box">Loading report details...</div>

    <section class="card hero-card" id="reportDetailsHeroCard" style="display:none;">
      <div class="hero-top">
        <div class="hero-copy">
          <div class="hero-title" id="reportDetailsTitle">Report</div>
          <div class="hero-sub" id="reportDetailsSub">Tracking code</div>
        </div>

        <div class="hero-status status-new" id="reportDetailsHeroStatus">new</div>
      </div>

      <div class="tag-row">
        <div class="tag" id="reportDetailsTagPrivacy">Anonymous</div>
        <div class="tag" id="reportDetailsTagCategory">Category</div>
        <div class="tag" id="reportDetailsTagUrgency">Normal</div>
      </div>
    </section>

    <section class="card" id="reportDetailsInfoCard" style="display:none;">
      <h2 class="section-title">Report information</h2>

      <div class="meta-grid">
        <div class="meta-box highlight-card">
          <div class="meta-label">Tracking code</div>
          <div class="meta-value" id="reportDetailsTrackingCode">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Status</div>
          <div class="meta-value" id="reportDetailsStatus">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">School</div>
          <div class="meta-value" id="reportDetailsSchool">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Department</div>
          <div class="meta-value" id="reportDetailsDepartment">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Location</div>
          <div class="meta-value" id="reportDetailsLocation">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Person involved</div>
          <div class="meta-value" id="reportDetailsPerson">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Created at</div>
          <div class="meta-value" id="reportDetailsCreatedAt">-</div>
        </div>

        <div class="meta-box">
          <div class="meta-label">Replies allowed</div>
          <div class="meta-value" id="reportDetailsReplyAllowed">-</div>
        </div>
      </div>
    </section>

    <section class="card" id="reportDetailsBodyCard" style="display:none;">
      <h2 class="section-title">Your report</h2>
      <div class="complaint-box" id="reportDetailsBody">-</div>
    </section>

    <section class="card" id="reportDetailsContactCard" style="display:none;">
      <h2 class="section-title">Contact section</h2>

      <div class="contact-grid">
        <div class="contact-box">
          <div class="contact-label">Phone number</div>
          <div class="contact-value" id="reportDetailsContactPhone">-</div>
        </div>

        <div class="contact-box">
          <div class="contact-label">Email address</div>
          <div class="contact-value" id="reportDetailsContactEmail">-</div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  window.reportDetailsScreenState = window.reportDetailsScreenState || {
    loadedReportId: "",
    currentReport: null
  };

  function reportDetailsEl(id) {
    return document.getElementById(id);
  }

  function reportDetailsShowMessage(text = "", type = "error") {
    const box = reportDetailsEl("reportDetailsMessage");
    if (!box) return;

    if (!text) {
      box.className = "message";
      box.textContent = "";
      return;
    }

    box.className = `message show ${type}`;
    box.textContent = text;
  }

  function reportDetailsFormatDateTime(value) {
    if (!value) return "-";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "-";
    return d.toLocaleString();
  }

  function reportDetailsStatusClass(status) {
    return `status-${String(status || "").toLowerCase()}`;
  }

  async function reportDetailsGetCurrentUserId() {
    try {
      if (typeof supabase !== "undefined" && supabase.auth?.getUser) {
        const { data } = await supabase.auth.getUser();
        if (data?.user?.id) return data.user.id;
      }
    } catch {}

    try {
      const raw = localStorage.getItem("colspot_last_user");
      if (!raw) return "";
      const parsed = JSON.parse(raw);
      return parsed?.id || "";
    } catch {
      return "";
    }
  }

  async function reportDetailsInvokeEdge(name, body = {}) {
    if (typeof supabase === "undefined" || !supabase.functions?.invoke) {
      throw new Error("Could not connect to backend.");
    }

    const { data, error } = await supabase.functions.invoke(name, { body });

    if (error) {
      throw new Error((data && data.error) || error.message || "Request failed.");
    }

    if (!data?.ok) {
      throw new Error(data?.error || "Request failed.");
    }

    return data;
  }

  function reportDetailsFill(report) {
    reportDetailsEl("reportDetailsTitle").textContent = report.title || report.category || "Report";
    reportDetailsEl("reportDetailsSub").textContent = report.tracking_code || "Tracking code";

    reportDetailsEl("reportDetailsTagPrivacy").textContent = report.is_anonymous ? "Anonymous" : "Named";
    reportDetailsEl("reportDetailsTagCategory").textContent = report.category || "Category";
    reportDetailsEl("reportDetailsTagUrgency").textContent = report.urgency || "normal";

    const pill = reportDetailsEl("reportDetailsStatusPill");
    pill.textContent = report.status || "new";
    pill.className = `status-pill ${reportDetailsStatusClass(report.status)}`;

    reportDetailsEl("reportDetailsTrackingCode").textContent = report.tracking_code || "-";
    reportDetailsEl("reportDetailsStatus").textContent = report.status || "-";
    reportDetailsEl("reportDetailsSchool").textContent = report.school_name || "-";
    reportDetailsEl("reportDetailsDepartment").textContent = report.department || "-";
    reportDetailsEl("reportDetailsLocation").textContent = report.location_text || "-";
    reportDetailsEl("reportDetailsPerson").textContent = report.person_involved || "-";
    reportDetailsEl("reportDetailsCreatedAt").textContent = reportDetailsFormatDateTime(report.created_at);
    reportDetailsEl("reportDetailsReplyAllowed").textContent = report.allow_anonymous_reply ? "Yes" : "No";
    reportDetailsEl("reportDetailsBody").textContent = report.message || "-";
    reportDetailsEl("reportDetailsPageSub").textContent = report.tracking_code || "Report";
    reportDetailsEl("reportDetailsContactPhone").textContent = report.contact_phone || "-";
    reportDetailsEl("reportDetailsContactEmail").textContent = report.contact_email || "-";

    reportDetailsEl("reportDetailsLoading").style.display = "none";
    reportDetailsEl("reportDetailsHeroCard").style.display = "";
    reportDetailsEl("reportDetailsInfoCard").style.display = "";
    reportDetailsEl("reportDetailsBodyCard").style.display = "";
    reportDetailsEl("reportDetailsContactCard").style.display = "";
  }

  async function loadReportDetailsScreen(force = false) {
    reportDetailsShowMessage("");

    const selected = window.historyScreenState?.selectedReport || null;
    if (!selected) {
      reportDetailsEl("reportDetailsLoading").style.display = "none";
      reportDetailsShowMessage("No report selected. Please return to History and choose a report.");
      return;
    }

    const selectedId = selected.id || selected.report_id || "";
    const state = window.reportDetailsScreenState || {};

    if (!force && state.loadedReportId && selectedId && state.loadedReportId === selectedId && state.currentReport) {
      reportDetailsFill(state.currentReport);
      return;
    }

    reportDetailsEl("reportDetailsLoading").style.display = "";
    reportDetailsEl("reportDetailsHeroCard").style.display = "none";
    reportDetailsEl("reportDetailsInfoCard").style.display = "none";
    reportDetailsEl("reportDetailsBodyCard").style.display = "none";
    reportDetailsEl("reportDetailsContactCard").style.display = "none";

    try {
      const userId = await reportDetailsGetCurrentUserId();
      if (!userId) {
        throw new Error("We could not find your user session. Please sign in again.");
      }

      let report = selected;

      if (selectedId) {
        const data = await reportDetailsInvokeEdge("get-my-report-details", {
          submitted_by_user_id: userId,
          report_id: selectedId
        });
        report = data.report || selected;
      }

      window.reportDetailsScreenState.loadedReportId = selectedId || "";
      window.reportDetailsScreenState.currentReport = report;

      reportDetailsFill(report);
    } catch (err) {
      console.error(err);
      reportDetailsEl("reportDetailsLoading").style.display = "none";
      reportDetailsShowMessage(err.message || "Could not load report details.");
    }
  }

  function openReportDetailsScreen() {
    loadReportDetailsScreen(true);
  }

  function closeReportDetailsScreenBack() {
    if (typeof showScreen === "function") {
      showScreen("history");
      return;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    reportDetailsEl("reportDetailsBackBtn")?.addEventListener("click", closeReportDetailsScreenBack);
  });

  window.openReportDetailsScreen = openReportDetailsScreen;
</script>
<!-- 🔹 REPORT DETAILS SCREEN END -->
