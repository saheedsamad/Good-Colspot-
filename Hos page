                      </svg>
                      <span>Duplicate Question</span>
                    </button>
                  </div>

                  <div class="question-footer-right">
                    <button type="button" class="forms-danger-btn" data-action="delete-question" data-question-id="${question.id}">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                      <span>Delete</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join("");
      }

      function renderStudentPreview(){
        const form = getActiveForm();
        const titleEl = $("studentPreviewTitle");
        const descEl = $("studentPreviewDescription");
        const bodyEl = $("studentPreviewBody");
        const successEl = $("studentPreviewSuccess");

        successEl.style.display = "none";

        if (!form){
          titleEl.textContent = "Untitled Form";
          descEl.textContent = "No active form selected.";
          bodyEl.innerHTML = `<div class="empty-card">No form selected for preview.</div>`;
          return;
        }

        titleEl.textContent = form.title || "Untitled Form";
        descEl.textContent = form.description || "No description added yet.";

        if (!form.questions.length){
          bodyEl.innerHTML = `<div class="empty-card">No questions yet. Add question blocks in Builder mode first.</div>`;
          return;
        }

        bodyEl.innerHTML = form.questions.map((question, index) => {
          const requiredMark = question.required ? '<span class="student-required">*</span>' : '';
          let controlHtml = "";

          if (question.type === "short_answer"){
            controlHtml = `<input class="forms-input" type="text" placeholder="${escapeHtml(question.placeholder || "Short answer")}" />`;
          } else if (question.type === "paragraph"){
            controlHtml = `<textarea class="forms-textarea" placeholder="${escapeHtml(question.placeholder || "Write your answer here")}"></textarea>`;
          } else if (question.type === "multiple_choice"){
            controlHtml = `
              <div class="student-option-list">
                ${(question.options || []).map((opt, optIndex) => `
                  <label class="student-option">
                    <input type="radio" name="preview_q_${index}" ${optIndex === 0 ? "" : ""} />
                    <span>${escapeHtml(opt)}</span>
                  </label>
                `).join("")}
              </div>
            `;
          } else if (question.type === "checkboxes"){
            controlHtml = `
              <div class="student-option-list">
                ${(question.options || []).map((opt) => `
                  <label class="student-option">
                    <input type="checkbox" />
                    <span>${escapeHtml(opt)}</span>
                  </label>
                `).join("")}
              </div>
            `;
          } else if (question.type === "dropdown"){
            controlHtml = `
              <select class="forms-select">
                <option value="">Select an option</option>
                ${(question.options || []).map((opt) => `<option>${escapeHtml(opt)}</option>`).join("")}
              </select>
            `;
          } else if (question.type === "date"){
            controlHtml = `<input class="forms-input" type="date" />`;
          } else if (question.type === "file_upload"){
            controlHtml = `
              <div class="forms-note">
                Upload area: Allowed types ${escapeHtml(question.fileTypes || "pdf,image")} • Max size ${escapeHtml(question.maxFileSize || "5MB")} • Max files ${escapeHtml(String(question.maxFiles || 1))}
              </div>
            `;
          } else if (question.type === "yes_no"){
            controlHtml = `
              <div class="student-option-list">
                <label class="student-option">
                  <input type="radio" name="preview_q_${index}" />
                  <span>Yes</span>
                </label>
                <label class="student-option">
                  <input type="radio" name="preview_q_${index}" />
                  <span>No</span>
                </label>
              </div>
            `;
          }

          return `
            <div class="student-q">
              <h4 class="student-q-title">${index + 1}. ${escapeHtml(question.title || "Untitled Question")}${requiredMark}</h4>
              <div class="student-q-help">${escapeHtml(question.helpText || "Answer this question below.")}</div>
              ${controlHtml}
            </div>
          `;
        }).join("");
      }

      function renderResponsesTable(){
        const body = $("formsResponsesTableBody");

        if (!state.responses.length){
          body.innerHTML = `
            <tr>
              <td colspan="6">
                <div class="empty-card" style="min-height:120px; margin:12px 0;">No responses yet. Add a mock response or use preview submit.</div>
              </td>
            </tr>
          `;
          return;
        }

        const formsMap = new Map(state.forms.map(form => [form.id, form]));

        body.innerHTML = [...state.responses]
          .sort((a, b) => new Date(b.submittedAt) - new Date(a.submittedAt))
          .map(response => {
            const form = formsMap.get(response.formId);
            return `
              <tr>
                <td>${escapeHtml(form?.title || "Deleted Form")}</td>
                <td>${escapeHtml(response.respondentName || "Anonymous")}</td>
                <td>${escapeHtml(getAudienceLabel(form?.targetAudience || ""))}</td>
                <td>${escapeHtml(response.status || "Submitted")}</td>
                <td>${escapeHtml(formatDateTime(response.submittedAt))}</td>
                <td>${escapeHtml(response.summary || "Response captured.")}</td>
              </tr>
            `;
          }).join("");
      }

      function updateWorkspaceTabs(){
        document.querySelectorAll("#formsWorkspaceTabs .forms-tab").forEach(btn => {
          btn.classList.toggle("active", btn.dataset.workspace === state.workspaceMode);
        });

        $("formsBuilderWorkspace").classList.toggle("section-hidden", state.workspaceMode !== "builder");
        $("formsPreviewWorkspace").classList.toggle("section-hidden", state.workspaceMode !== "preview");
        $("formsResponsesWorkspace").classList.toggle("section-hidden", state.workspaceMode !== "responses");

        const titleMap = {
          builder: ["Form Builder", "Create or edit forms with question blocks and settings."],
          preview: ["Student Preview", "See the form exactly the way students or staff will see it."],
          responses: ["Responses", "Review submissions, summaries, and export response data."]
        };

        $("formsWorkspaceTitle").textContent = titleMap[state.workspaceMode][0];
        $("formsWorkspaceSub").textContent = titleMap[state.workspaceMode][1];
      }

      function updateListTabs(){
        document.querySelectorAll("#formsStatusTabs .forms-tab").forEach(btn => {
          btn.classList.toggle("active", btn.dataset.filter === state.listFilter);
        });
      }

      function renderAll(){
        ensureActiveForm();
        renderOverviewStats();
        renderFormsList();
        renderBuilderFormFields();
        renderQuestionList();
        renderStudentPreview();
        renderResponsesTable();
        updateWorkspaceTabs();
        updateListTabs();
      }

      function createNewForm(){
        const form = createEmptyForm();
        form.title = "Untitled Form";
        form.description = "Add your form description here.";
        state.forms.unshift(form);
        state.activeFormId = form.id;
        saveWorkspace();
        renderAll();
      }

      function duplicateFormById(formId){
        const form = state.forms.find(f => f.id === formId);
        if (!form) return;

        const copy = deepClone(form);
        copy.id = uid("form");
        copy.title = `${form.title || "Untitled Form"} Copy`;
        copy.status = "draft";
        copy.createdAt = new Date().toISOString();
        copy.updatedAt = new Date().toISOString();
        copy.questions = copy.questions.map(q => ({ ...q, id: uid("q") }));

        state.forms.unshift(copy);
        state.activeFormId = copy.id;
        saveWorkspace();
        renderAll();
      }

      function deleteFormById(formId){
        const form = state.forms.find(f => f.id === formId);
        if (!form) return;

        const confirmed = confirm(`Delete "${form.title || "Untitled Form"}"? This will remove it from this page.`);
        if (!confirmed) return;

        state.forms = state.forms.filter(f => f.id !== formId);
        state.responses = state.responses.filter(r => r.formId !== formId);

        if (state.activeFormId === formId){
          state.activeFormId = state.forms[0]?.id || null;
        }

        saveWorkspace();
        saveResponses();
        renderAll();
      }

      function setFormStatus(formId, status){
        const form = state.forms.find(f => f.id === formId);
        if (!form) return;
        form.status = status;
        form.updatedAt = new Date().toISOString();
        saveWorkspace();
        renderAll();
      }

      function addQuestion(type){
        const form = getActiveForm();
        if (!form) return;
        form.questions.push(createQuestion(type));
        markUpdated(form);
        renderQuestionList();
        renderStudentPreview();
      }

      function findQuestion(questionId){
        const form = getActiveForm();
        if (!form) return null;
        return form.questions.find(q => q.id === questionId) || null;
      }

      function moveItem(array, fromIndex, toIndex){
        if (toIndex < 0 || toIndex >= array.length) return array;
        const item = array.splice(fromIndex, 1)[0];
        array.splice(toIndex, 0, item);
        return array;
      }

      function attachFormsListActions(){
        const wrap = $("formsListWrap");
        wrap.addEventListener("click", (e) => {
          const btn = e.target.closest("[data-action]");
          if (!btn) return;

          const action = btn.dataset.action;
          const formId = btn.dataset.id;
          if (!action || !formId) return;

          if (action === "open-form"){
            setActiveForm(formId);
            state.workspaceMode = "builder";
            updateWorkspaceTabs();
            return;
          }

          if (action === "duplicate-form"){
            duplicateFormById(formId);
            return;
          }

          if (action === "publish-form"){
            setFormStatus(formId, "published");
            return;
          }

          if (action === "close-form"){
            setFormStatus(formId, "closed");
            return;
          }

          if (action === "reopen-form"){
            setFormStatus(formId, "published");
            return;
          }

          if (action === "archive-form"){
            setFormStatus(formId, "archived");
            return;
          }

          if (action === "delete-form"){
            deleteFormById(formId);
          }
        });
      }

      function bindTopControls(){
        $("formsCreateNewBtn").addEventListener("click", createNewForm);

        $("formsSearchInput").addEventListener("input", (e) => {
          state.searchTerm = e.target.value || "";
          renderFormsList();
        });

        document.querySelectorAll("#formsStatusTabs .forms-tab").forEach(btn => {
          btn.addEventListener("click", () => {
            state.listFilter = btn.dataset.filter || "all";
            updateListTabs();
            renderFormsList();
          });
        });

        document.querySelectorAll("#formsWorkspaceTabs .forms-tab").forEach(btn => {
          btn.addEventListener("click", () => {
            state.workspaceMode = btn.dataset.workspace || "builder";
            updateWorkspaceTabs();
            if (state.workspaceMode === "preview") renderStudentPreview();
            if (state.workspaceMode === "responses") renderResponsesTable();
          });
        });
      }

      function bindFormSetupFields(){
        const bindMap = [
          ["formsTitleInput", "title"],
          ["formsDescriptionInput", "description"],
          ["formsAudienceSelect", "targetAudience"],
          ["formsStatusSelect", "status"],
          ["formsOpenDateInput", "openDate"],
          ["formsCloseDateInput", "closeDate"],
          ["formsResponseRuleSelect", "responseRule"],
          ["formsIdentitySelect", "identityMode"]
        ];

        bindMap.forEach(([id, key]) => {
          const el = $(id);
          el.addEventListener("input", () => {
            const form = getActiveForm();
            if (!form) return;
            form[key] = el.value;
            markUpdated(form);
            renderFormsList();
            renderStudentPreview();
            renderOverviewStats();
          });
          el.addEventListener("change", () => {
            const form = getActiveForm();
            if (!form) return;
            form[key] = el.value;
            markUpdated(form);
            renderFormsList();
            renderStudentPreview();
            renderOverviewStats();
          });
        });

        $("formsSaveDraftBtn").addEventListener("click", () => {
          const form = getActiveForm();
          if (!form) return;
          form.status = "draft";
          markUpdated(form);
          renderAll();
        });

        $("formsPublishBtn").addEventListener("click", () => {
          const form = getActiveForm();
          if (!form) return;
          form.status = "published";
          markUpdated(form);
          renderAll();
        });

        $("formsDuplicateBtn").addEventListener("click", () => {
          const form = getActiveForm();
          if (!form) return;
          duplicateFormById(form.id);
        });
      }

      function bindQuickAddButtons(){
        document.querySelectorAll("#screen-forms [data-add-type]").forEach(btn => {
          btn.addEventListener("click", () => {
            addQuestion(btn.dataset.addType);
          });
        });
      }

      function attachQuestionActions(){
        const list = $("formsQuestionList");

        list.addEventListener("input", (e) => {
          const target = e.target;
          const action = target.dataset.action;
          const questionId = target.dataset.questionId;
          if (!action || !questionId) return;

          const form = getActiveForm();
          const question = findQuestion(questionId);
          if (!form || !question) return;

          if (action === "edit-question-title"){
            question.title = target.value;
          } else if (action === "edit-question-help"){
            question.helpText = target.value;
          } else if (action === "edit-question-placeholder"){
            question.placeholder = target.value;
          } else if (action === "edit-option"){
            const optionIndex = Number(target.dataset.optionIndex);
            question.options[optionIndex] = target.value;
          } else if (action === "edit-file-types"){
            question.fileTypes = target.value;
          } else if (action === "edit-file-size"){
            question.maxFileSize = target.value;
          } else if (action === "edit-file-count"){
            question.maxFiles = Math.max(1, Number(target.value || 1));
          } else {
            return;
          }

          markUpdated(form);
          renderFormsList();
          renderStudentPreview();
        });

        list.addEventListener("change", (e) => {
          const target = e.target;
          const action = target.dataset.action;
          const questionId = target.dataset.questionId;
          if (!action || !questionId) return;

          const form = getActiveForm();
          const question = findQuestion(questionId);
          if (!form || !question) return;

          if (action === "change-question-type"){
            const newType = target.value;
            const fresh = createQuestion(newType);
            question.type = fresh.type;
            question.options = fresh.options;
            question.fileTypes = fresh.fileTypes;
            question.maxFileSize = fresh.maxFileSize;
            question.maxFiles = fresh.maxFiles;
          } else if (action === "toggle-required"){
            question.required = !!target.checked;
          } else {
            return;
          }

          markUpdated(form);
          renderQuestionList();
          renderStudentPreview();
        });

        list.addEventListener("click", (e) => {
          const btn = e.target.closest("[data-action]");
          if (!btn) return;

          const action = btn.dataset.action;
          const questionId = btn.dataset.questionId;
          const form = getActiveForm();
          if (!action || !questionId || !form) return;

          const questionIndex = form.questions.findIndex(q => q.id === questionId);
          if (questionIndex === -1) return;

          const question = form.questions[questionIndex];

          if (action === "delete-question"){
            form.questions.splice(questionIndex, 1);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "duplicate-question"){
            const copy = deepClone(question);
            copy.id = uid("q");
            form.questions.splice(questionIndex + 1, 0, copy);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "move-question-up"){
            moveItem(form.questions, questionIndex, questionIndex - 1);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "move-question-down"){
            moveItem(form.questions, questionIndex, questionIndex + 1);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "add-option"){
            if (!Array.isArray(question.options)) question.options = [];
            question.options.push(`Option ${question.options.length + 1}`);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "delete-option"){
            const optionIndex = Number(btn.dataset.optionIndex);
            question.options.splice(optionIndex, 1);
            if (!question.options.length && ["multiple_choice","checkboxes","dropdown"].includes(question.type)){
              question.options = ["Option 1"];
            }
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "move-option-up"){
            const optionIndex = Number(btn.dataset.optionIndex);
            moveItem(question.options, optionIndex, optionIndex - 1);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
            return;
          }

          if (action === "move-option-down"){
            const optionIndex = Number(btn.dataset.optionIndex);
            moveItem(question.options, optionIndex, optionIndex + 1);
            markUpdated(form);
            renderQuestionList();
            renderStudentPreview();
          }
        });
      }

      function bindPreviewActions(){
        $("studentPreviewSubmitBtn").addEventListener("click", () => {
          const form = getActiveForm();
          if (!form) return;

          const summary = form.questions.length
            ? `${form.questions.length} questions answered in preview mode`
            : "Preview response";

          state.responses.push({
            id: uid("resp"),
            formId: form.id,
            respondentName: form.identityMode === "anonymous" ? "Anonymous User" : "Preview User",
            status: "Submitted",
            submittedAt: new Date().toISOString(),
            summary
          });

          saveResponses();
          renderOverviewStats();
          renderResponsesTable();

          const success = $("studentPreviewSuccess");
          success.style.display = "block";
          success.scrollIntoView({ behavior: "smooth", block: "nearest" });
        });

        $("studentPreviewResetBtn").addEventListener("click", () => {
          $("studentPreviewSuccess").style.display = "none";
          renderStudentPreview();
        });
      }

      function bindResponseTools(){
        $("formsAddMockResponseBtn").addEventListener("click", () => {
          const form = getActiveForm();
          if (!form) return;

          state.responses.push({
            id: uid("resp"),
            formId: form.id,
            respondentName: "Mock Student",
            status: "Submitted",
            submittedAt: new Date().toISOString(),
            summary: "Mock response generated for testing"
          });

          saveResponses();
          renderOverviewStats();
          renderResponsesTable();
          renderFormsList();
        });

        $("formsExportResponsesBtn").addEventListener("click", () => {
          const rows = [
            ["Form", "Respondent", "Status", "Submitted At", "Summary"]
          ];

          const formsMap = new Map(state.forms.map(form => [form.id, form.title || "Untitled Form"]));

          state.responses.forEach(response => {
            rows.push([
              formsMap.get(response.formId) || "Deleted Form",
              response.respondentName || "Anonymous",
              response.status || "Submitted",
              response.submittedAt || "",
              response.summary || ""
            ]);
          });

          const csv = rows.map(row => row.map(cell => {
            const safe = String(cell || "").replaceAll('"', '""');
            return `"${safe}"`;
          }).join(",")).join("\\n");

          const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = "forms-responses.csv";
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
        });
      }

      function init(){
        loadWorkspace();
        bindTopControls();
        bindFormSetupFields();
        bindQuickAddButtons();
        bindPreviewActions();
        bindResponseTools();
        attachFormsListActions();
        attachQuestionActions();
        renderAll();
      }

      if (document.readyState === "loading"){
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</section>
