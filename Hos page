<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #eef4ff;
      --bg2: #ffffff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --card: #ffffff;
      --soft-blue: #eff6ff;
      --soft: #f8fafc;
      --green: #16a34a;
      --red: #dc2626;
      --amber: #d97706;
      --shadow-soft: 0 14px 35px rgba(15, 23, 42, 0.08);
      --shadow-strong: 0 18px 45px rgba(15, 23, 42, 0.12);
    }

    * {
      box-sizing: border-box;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      color: var(--text-main);
      min-height: 100%;
    }

    body {
      display: flex;
      justify-content: center;
    }

    .app-shell {
      width: 100%;
      max-width: 430px;
      min-height: 100vh;
      background: #fff;
      position: relative;
      padding: calc(env(safe-area-inset-top) + 8px) 14px 100px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 2px 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-badge {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 15px;
      box-shadow: var(--shadow-soft);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .brand-text strong {
      font-size: 17px;
      font-weight: 800;
    }

    .brand-text span {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 600;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1d4ed8, #22c55e);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 14px;
      box-shadow: var(--shadow-soft);
    }

    .hero {
      margin: 4px 2px 14px;
    }

    .hero-small {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .hero-title {
      font-size: 24px;
      line-height: 1.18;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin: 0 0 8px;
    }

    .hero-title span {
      color: var(--blue);
    }

    .hero-sub {
      font-size: 13px;
      line-height: 1.45;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .main-action,
    .secondary-action {
      width: 100%;
      border: none;
      border-radius: 999px;
      padding: 13px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      transition: transform .06s ease;
    }

    .main-action:active,
    .secondary-action:active,
    .quick-card:active,
    .chip-btn:active,
    .mini-btn:active {
      transform: scale(0.98);
    }

    .main-action {
      color: #fff;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      box-shadow: var(--shadow-soft);
    }

    .secondary-action {
      margin-top: 10px;
      color: var(--blue);
      background: #f8fbff;
      border: 1px solid #dbeafe;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 16px 2px 4px;
    }

    .stat-card {
      background: #fff;
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 14px 13px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .stat-value {
      font-size: 22px;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 6px;
    }

    .stat-label {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.06em;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 20px 4px 10px;
    }

    .section-head h3 {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .section-head button,
    .section-head span {
      border: none;
      background: transparent;
      color: var(--blue);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      padding: 0;
    }

    .card {
      background: #fff;
      border: 1px solid var(--border-soft);
      border-radius: 20px;
      padding: 14px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
      margin: 0 2px 14px;
    }

    .quick-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    .quick-card {
      background: #fff;
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 12px 8px;
      text-align: center;
      cursor: pointer;
    }

    .quick-icon {
      width: 38px;
      height: 38px;
      margin: 0 auto 8px;
      border-radius: 12px;
      background: var(--soft-blue);
      color: var(--blue);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 800;
    }

    .quick-card p {
      margin: 0;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.25;
    }

    .field {
      margin-bottom: 12px;
    }

    .field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #334155;
      margin-bottom: 6px;
    }

    .input,
    .select,
    .textarea {
      width: 100%;
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 12px 13px;
      background: #fff;
      font-size: 14px;
      color: var(--text-main);
      outline: none;
    }

    .input:focus,
    .select:focus,
    .textarea:focus {
      border-color: #93c5fd;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .textarea {
      min-height: 96px;
      resize: vertical;
    }

    .locked-box {
      width: 100%;
      border-radius: 14px;
      padding: 12px 13px;
      border: 1px dashed #bfdbfe;
      background: #f8fbff;
      color: var(--blue-dark);
      font-size: 14px;
      font-weight: 700;
    }

    .generated-box {
      display: none;
      margin-top: 12px;
      border-radius: 16px;
      border: 1px dashed #bfdbfe;
      background: #f8fbff;
      padding: 12px;
    }

    .generated-item + .generated-item {
      margin-top: 10px;
    }

    .generated-label {
      font-size: 10px;
      color: var(--text-muted);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 5px;
    }

    .generated-value {
      background: #fff;
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 13px;
      font-weight: 700;
      word-break: break-word;
    }

    .btn-row {
      display: flex;
      gap: 10px;
      margin-top: 12px;
    }

    .mini-btn {
      flex: 1;
      border: none;
      border-radius: 999px;
      padding: 12px 14px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
    }

    .mini-btn.primary {
      color: #fff;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      box-shadow: var(--shadow-soft);
    }

    .mini-btn.secondary {
      color: var(--text-main);
      background: #fff;
      border: 1px solid var(--border-soft);
    }

    .message {
      display: none;
      margin-top: 12px;
      padding: 11px 12px;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.45;
    }

    .message.success {
      display: block;
      background: #ecfdf5;
      border: 1px solid #bbf7d0;
      color: #166534;
    }

    .message.error {
      display: block;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
    }

    .toolbar {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
    }

    .toolbar .input {
      flex: 1;
    }

    .chip-btn {
      border: 1px solid var(--border-soft);
      background: #fff;
      border-radius: 999px;
      padding: 0 14px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .list-wrap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hod-card,
    .announcement-card,
    .search-card {
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 12px;
      background: #fff;
    }

    .hod-top,
    .announcement-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .hod-name,
    .announcement-title,
    .search-name {
      font-size: 15px;
      font-weight: 800;
      line-height: 1.2;
    }

    .hod-sub,
    .announcement-meta,
    .search-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 3px;
      line-height: 1.35;
    }

    .status-pill,
    .tag {
      flex-shrink: 0;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .status-pill.active {
      background: #ecfdf5;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    .status-pill.disabled {
      background: #fff7ed;
      color: #9a3412;
      border: 1px solid #fed7aa;
    }

    .tag {
      background: #eff6ff;
      color: var(--blue);
    }

    .mini-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin: 10px 0;
    }

    .mini-info {
      background: var(--soft);
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 9px 10px;
    }

    .mini-info-label {
      font-size: 10px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      margin-bottom: 4px;
    }

    .mini-info-value {
      font-size: 12px;
      color: var(--text-main);
      font-weight: 700;
      word-break: break-word;
    }

    .action-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .action-chip {
      border: none;
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .action-chip.blue {
      background: #eff6ff;
      color: var(--blue);
    }

    .action-chip.amber {
      background: #fff7ed;
      color: var(--amber);
    }

    .action-chip.red {
      background: #fef2f2;
      color: var(--red);
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: max(12px, env(safe-area-inset-bottom));
      width: calc(100% - 28px);
      max-width: 402px;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(229,231,235,0.9);
      box-shadow: var(--shadow-strong);
      border-radius: 26px;
      padding: 8px 8px 10px;
      display: flex;
      justify-content: space-between;
      z-index: 30;
    }

    .nav-btn {
      flex: 1;
      border: none;
      background: transparent;
      color: #94a3b8;
      text-align: center;
      font-size: 11px;
      cursor: pointer;
      padding-top: 2px;
    }

    .nav-btn.active {
      color: var(--blue);
      font-weight: 800;
    }

    .nav-inner {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }

    .nav-icon {
      width: 20px;
      height: 20px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }

    @media (max-width: 360px) {
      .quick-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .stats-grid,
      .mini-grid,
      .btn-row {
        grid-template-columns: 1fr;
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="brand">
        <div class="brand-badge">C</div>
        <div class="brand-text">
          <strong>Colspot</strong>
          <span>HOS dashboard</span>
        </div>
      </div>
      <div class="avatar" id="hosAvatar">H</div>
    </div>

    <section class="hero">
      <div class="hero-small" id="heroSchoolName">Hello, Ekiti State University</div>
      <h1 class="hero-title">
        What do you want to<br />
        <span>do today?</span>
      </h1>
      <div class="hero-sub">
        Manage your school, create HOD accounts, and send announcements to all departments.
      </div>

      <button class="main-action" id="topCreateHodBtn">
        <span>＋</span>
        <span>Create new HOD account</span>
      </button>

      <button class="secondary-action" id="topAnnouncementBtn">
        <span>📢</span>
        <span>Send announcement</span>
      </button>
    </section>

    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-value" id="statHods">12</div>
        <div class="stat-label">HODs</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="statDepartments">18</div>
        <div class="stat-label">Departments</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="statLecturers">165</div>
        <div class="stat-label">Lecturers</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="statStudents">8420</div>
        <div class="stat-label">Students</div>
      </div>
    </section>

    <div class="section-head">
      <h3>Quick actions</h3>
    </div>

    <section class="card">
      <div class="quick-grid">
        <button class="quick-card" id="qaCreateHod">
          <div class="quick-icon">＋</div>
          <p>Create HOD</p>
        </button>

        <button class="quick-card" id="qaSendAnnouncement">
          <div class="quick-icon">📢</div>
          <p>Send announcement</p>
        </button>

        <button class="quick-card" id="qaSearchSchool">
          <div class="quick-icon">⌕</div>
          <p>Search school</p>
        </button>

        <button class="quick-card" id="qaViewHods">
          <div class="quick-icon">☰</div>
          <p>View HODs</p>
        </button>
      </div>
    </section>

    <div class="section-head">
      <h3>Create HOD account</h3>
    </div>

    <section class="card" id="createHodSection">
      <div class="field">
        <label for="hodFullName">Full name</label>
        <input id="hodFullName" class="input" placeholder="Enter HOD full name" />
      </div>

      <div class="field">
        <label for="hodDepartment">Department</label>
        <select id="hodDepartment" class="select">
          <option value="">Select department</option>
          <option>Computer Science</option>
          <option>Accounting</option>
          <option>Business Administration</option>
          <option>Economics</option>
          <option>Entrepreneurship</option>
          <option>Mass Communication</option>
          <option>Biochemistry</option>
          <option>Physics</option>
        </select>
      </div>

      <div class="field">
        <label for="hodEmail">Email</label>
        <input id="hodEmail" class="input" type="email" placeholder="Enter email address" />
      </div>

      <div class="field">
        <label>School</label>
        <div class="locked-box" id="lockedSchoolName">Ekiti State University</div>
      </div>

      <div class="generated-box" id="generatedBox">
        <div class="generated-item">
          <div class="generated-label">Generated login ID</div>
          <div class="generated-value" id="generatedLoginId">-</div>
        </div>
        <div class="generated-item">
          <div class="generated-label">Temporary password</div>
          <div class="generated-value" id="generatedPassword">-</div>
        </div>
      </div>

      <div class="btn-row">
        <button class="mini-btn primary" id="createHodBtn">Create HOD</button>
        <button class="mini-btn secondary" id="clearHodBtn">Clear</button>
      </div>

      <div class="message" id="createHodMessage"></div>
    </section>

    <div class="section-head">
      <h3>School announcements</h3>
      <span id="jumpToAnnouncements">View all</span>
    </div>

    <section class="card" id="announcementSection">
      <div class="field">
        <label for="announcementTitle">Title</label>
        <input id="announcementTitle" class="input" placeholder="Announcement title" />
      </div>

      <div class="field">
        <label for="announcementAudience">Audience</label>
        <select id="announcementAudience" class="select">
          <option value="All Departments">All Departments</option>
          <option value="All HODs">All HODs</option>
          <option value="All Lecturers">All Lecturers</option>
          <option value="All Students">All Students</option>
        </select>
      </div>

      <div class="field">
        <label for="announcementBody">Message</label>
        <textarea
          id="announcementBody"
          class="textarea"
          placeholder="Write your school-wide announcement here..."
        ></textarea>
      </div>

      <div class="btn-row">
        <button class="mini-btn primary" id="sendAnnouncementBtn">Send now</button>
        <button class="mini-btn secondary" id="clearAnnouncementBtn">Clear</button>
      </div>

      <div class="message" id="announcementMessage"></div>
    </section>

    <div class="section-head">
      <h3>HOD list</h3>
      <span>Manage</span>
    </div>

    <section class="card" id="hodListSection">
      <div class="toolbar">
        <input
          id="hodSearchInput"
          class="input"
          placeholder="Search HOD by name, email or department"
        />
        <button class="chip-btn" id="refreshHodBtn">Refresh</button>
      </div>

      <div class="list-wrap" id="hodList"></div>
    </section>

    <div class="section-head">
      <h3>Recent announcements</h3>
      <span>View all</span>
    </div>

    <section class="card">
      <div class="list-wrap" id="announcementList"></div>
    </section>

    <div class="section-head">
      <h3>School search</h3>
    </div>

    <section class="card" id="searchSection">
      <div class="toolbar">
        <input
          id="schoolSearchInput"
          class="input"
          placeholder="Search student, lecturer, matric no or staff ID"
        />
        <button class="chip-btn" id="runSchoolSearchBtn">Search</button>
      </div>

      <div class="list-wrap" id="schoolSearchResults"></div>
    </section>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active">
      <span class="nav-inner">
        <span class="nav-icon">⌂</span>
        <span>Home</span>
      </span>
    </button>

    <button class="nav-btn">
      <span class="nav-inner">
        <span class="nav-icon">👤</span>
        <span>HODs</span>
      </span>
    </button>

    <button class="nav-btn">
      <span class="nav-inner">
        <span class="nav-icon">📢</span>
        <span>Announcements</span>
      </span>
    </button>

    <button class="nav-btn">
      <span class="nav-inner">
        <span class="nav-icon">⌕</span>
        <span>Search</span>
      </span>
    </button>

    <button class="nav-btn">
      <span class="nav-inner">
        <span class="nav-icon">☰</span>
        <span>More</span>
      </span>
    </button>
  </nav>

  <script>
