  function renderPreview() {
    ensureCurrentForm();
    patchPreviewMeta();

    const body = $("studentPreviewBody");
    if (!body) return;

    const questions = getFormQuestions();
    if (!questions.length) {
      body.innerHTML = `<div class="forms-empty">No questions added yet.</div>`;
      return;
    }

    body.innerHTML = questions
      .map((q) => {
        const required = q.is_required ? `<span class="student-required">*</span>` : "";

        let answerHtml = `<input class="forms-input" type="text" placeholder="${escapeHtml(q.placeholder_text || "Your answer")}">`;

        if (q.question_type === "paragraph") {
          answerHtml = `<textarea class="forms-textarea" placeholder="${escapeHtml(q.placeholder_text || "Write your answer")}"></textarea>`;
        } else if (["multiple_choice", "checkboxes", "dropdown", "yes_no"].includes(q.question_type)) {
          const options = q.question_type === "yes_no" ? ["Yes", "No"] : (q.options_json || []);
          answerHtml = `
            <div class="student-option-list">
              ${options
                .map(
                  (opt) => `
                <label class="student-option">
                  <input type="${q.question_type === "checkboxes" ? "checkbox" : "radio"}" name="${escapeHtml(q.local_id)}">
                  <span>${escapeHtml(opt || "Option")}</span>
                </label>
              `
                )
                .join("")}
            </div>
          `;
        } else if (q.question_type === "date") {
          answerHtml = `<input class="forms-input" type="date">`;
        } else if (q.question_type === "file_upload") {
          answerHtml = `<input class="forms-input" type="file">`;
        }

        return `
          <div class="student-q">
            <h4>${escapeHtml(q.question_text || "Untitled Question")}${required}</h4>
            <p>${escapeHtml(q.help_text || "")}</p>
            ${answerHtml}
          </div>
        `;
      })
      .join("");
  }

  function syncFormFromSetupInputs() {
    ensureCurrentForm();
    state.currentForm.title = $("formTitleInput")?.value || "";
    state.currentForm.description = $("formDescriptionInput")?.value || "";
    state.currentForm.open_at = $("formOpenDateInput")?.value || "";
    state.currentForm.close_at = $("formCloseDateInput")?.value || "";
    state.currentForm.response_rule = $("formResponseRule")?.value || "one";

    const mode = $("formIdentityMode")?.value || "auto";
    state.currentForm.identity_mode = mode === "anonymous" ? "anonymous" : "auto";

    if ($("audienceProgrammeFilter")?.checked) {
      state.currentForm.audience_mode = "programme_filter";
    } else {
      state.currentForm.audience_mode = "all_students";
      state.currentForm.programme_targets = [];
    }

    state.currentForm.target_audience = "all_students";
  }

  function buildPayload(statusOverride) {
    syncFormFromSetupInputs();

    const form = state.currentForm || blankForm();
    const questions = getFormQuestions().map((q, index) => ({
      id: q.id || null,
      question_text: normalizeText(q.question_text),
      question_type: q.question_type,
      help_text: normalizeText(q.help_text),
      placeholder_text: normalizeText(q.placeholder_text),
      is_required: !!q.is_required,
      options_json: Array.isArray(q.options_json)
        ? q.options_json.map((v) => normalizeText(v)).filter(Boolean)
        : [],
      allowed_file_types: Array.isArray(q.allowed_file_types)
        ? q.allowed_file_types.map((v) => normalizeText(v)).filter(Boolean)
        : [],
      max_file_size_mb: Number(q.max_file_size_mb || 5),
      max_files: Number(q.max_files || 1),
      section_name: normalizeText(q.section_name),
      sort_order: index + 1,
    }));

    return {
      ...getActorPayload(),
      form_id: form.id || undefined,
      title: normalizeText(form.title),
      description: normalizeText(form.description),
      target_audience: "all_students",
      audience_mode: form.audience_mode || "all_students",
      programme_targets: Array.isArray(form.programme_targets) ? form.programme_targets : [],
      response_rule: form.response_rule || "one",
      identity_mode: form.identity_mode === "anonymous" ? "anonymous" : "auto",
      open_date: form.open_at || null,
      close_date: form.close_at || null,
      status: statusOverride || form.status || "draft",
      questions,
    };
  }

  async function loadForms() {
    state.loadingList = true;
    renderFormsList();

    try {
      const data = await invokeFormsManager({
        action: "list_forms",
        status: state.statusFilter,
        ...getActorPayload(),
      });

      state.forms = Array.isArray(data.forms) ? data.forms : [];
      renderFormsList();
    } catch (err) {
      console.error("Load forms error:", err);
      $("formsListBox").innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load forms.")}</div>`;
    } finally {
      state.loadingList = false;
      renderFormsList();
    }
  }

  async function openForm(formId) {
    try {
      const data = await invokeFormsManager({
        action: "get_form",
        form_id: formId,
        ...getActorPayload(),
      });

      loadFormIntoEditor(data.form, data.questions || []);
      showBuilder();
      setStep("setup");
      setSavePill("Loaded", "");
    } catch (err) {
      alert(err.message || "Could not open form.");
    }
  }

  async function saveSetupOnly() {
    syncFormFromSetupInputs();
    if (!normalizeText(state.currentForm.title)) {
      alert("Enter form title first.");
      return false;
    }

    const btn = $("formsSaveDraftBtn");
    setButtonLoading(btn, "Saving...", true);

    try {
      const payload = buildPayload("draft");

      let data;
      if (state.currentForm.id) {
        data = await invokeFormsManager({ action: "update_form", ...payload });
      } else {
        data = await invokeFormsManager({ action: "create_form", ...payload });
      }

      state.currentForm.id = data.form?.id || state.currentForm.id;
      state.currentForm.status = data.form?.status || "draft";
      setSavePill("Draft saved", "");
      await loadForms();
      return true;
    } catch (err) {
      console.error(err);
      setSavePill("Save failed", "error");
      alert(err.message || "Could not save draft.");
      return false;
    } finally {
      setButtonLoading(btn, "Saving...", false);
    }
  }

  async function publishForm(buttonEl) {
    syncFormFromSetupInputs();

    if (!state.currentForm?.id) {
      const ok = await saveSetupOnly();
      if (!ok) return;
    }

    const btn = buttonEl || $("formsPublishBtn");
    setButtonLoading(btn, "Publishing...", true);

    try {
      const data = await invokeFormsManager({
        action: "publish_form",
        form_id: state.currentForm.id,
        ...getActorPayload(),
      });

      state.currentForm.status = data.form?.status || "published";
      setSavePill("Published", "");
      await loadForms();
      alert("Form published successfully.");
      showHome();
    } catch (err) {
      console.error(err);
      setSavePill("Publish failed", "error");
      alert(err.message || "Could not publish form.");
    } finally {
      setButtonLoading(btn, "Publishing...", false);
    }
  }

  function addQuestion(type) {
    const list = getFormQuestions();
    list.push(blankQuestion(type));
    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function deleteQuestion(questionId) {
    state.currentForm.questions = getFormQuestions().filter((q) => q.local_id !== questionId);
    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function duplicateQuestion(questionId) {
    const list = getFormQuestions();
    const index = list.findIndex((q) => q.local_id === questionId);
    if (index < 0) return;

    const clone = JSON.parse(JSON.stringify(list[index]));
    clone.local_id = uid("q");
    clone.id = null;
    list.splice(index + 1, 0, clone);

    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function moveQuestion(questionId, dir) {
    const list = getFormQuestions();
    const index = list.findIndex((q) => q.local_id === questionId);
    if (index < 0) return;

    const nextIndex = index + dir;
    if (nextIndex < 0 || nextIndex >= list.length) return;

    const temp = list[index];
    list[index] = list[nextIndex];
    list[nextIndex] = temp;

    renderQuestionList();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function getQuestionById(questionId) {
    return getFormQuestions().find((q) => q.local_id === questionId) || null;
  }

  function handleQuestionInput(el) {
    const questionId = el.dataset.questionId;
    const field = el.dataset.questionInput;
    const q = getQuestionById(questionId);
    if (!q || !field) return;

    if (field === "question_text") {
      q.question_text = el.value;
      patchQuestionHeader(questionId);
      renderPreview();
    } else if (field === "help_text") {
      q.help_text = el.value;
      renderPreview();
    } else if (field === "placeholder_text") {
      q.placeholder_text = el.value;
      renderPreview();
    } else if (field === "question_type") {
      q.question_type = el.value;

      if (["multiple_choice", "checkboxes", "dropdown"].includes(q.question_type) && !Array.isArray(q.options_json)) {
        q.options_json = ["", ""];
      }

      if (["multiple_choice", "checkboxes", "dropdown"].includes(q.question_type) && q.options_json.length === 0) {
        q.options_json = ["", ""];
      }

      if (q.question_type === "yes_no") {
        q.options_json = ["Yes", "No"];
        q.placeholder_text = "";
      }

      if (q.question_type === "file_upload") {
        q.allowed_file_types = q.allowed_file_types || [];
        q.max_files = q.max_files || 1;
      }

      renderQuestionList();
      renderPreview();
    } else if (field === "option") {
      const optIndex = Number(el.dataset.optionIndex);
      if (!Array.isArray(q.options_json)) q.options_json = [];
      q.options_json[optIndex] = el.value;
      renderPreview();
    } else if (field === "allowed_file_types") {
      q.allowed_file_types = String(el.value || "")
        .split(",")
        .map((v) => normalizeText(v))
        .filter(Boolean);
    } else if (field === "max_files") {
      q.max_files = Math.max(1, Number(el.value || 1));
    }

    setSavePill("Unsaved changes", "warn");
  }

  function handleQuestionAction(el) {
    const action = el.dataset.questionAction;
    const questionId = el.dataset.questionId;
    const q = getQuestionById(questionId);
    if (!action || !questionId) return;

    if (action === "toggle-required" && q) {
      q.is_required = !!el.checked;
      renderPreview();
      setSavePill("Unsaved changes", "warn");
      return;
    }

    if (action === "move-up") {
      moveQuestion(questionId, -1);
      return;
    }

    if (action === "move-down") {
      moveQuestion(questionId, 1);
      return;
    }

    if (action === "duplicate") {
      duplicateQuestion(questionId);
      return;
    }

    if (action === "delete") {
      deleteQuestion(questionId);
      return;
    }

    if (action === "add-option" && q) {
      if (!Array.isArray(q.options_json)) q.options_json = [];
      q.options_json.push("");
      renderQuestionList();
      setSavePill("Unsaved changes", "warn");
      return;
    }

    if (action === "remove-option" && q) {
      const optIndex = Number(el.dataset.optionIndex);
      if (!Array.isArray(q.options_json)) q.options_json = [];
      q.options_json.splice(optIndex, 1);
      if (q.options_json.length === 0) q.options_json = [""];
      renderQuestionList();
      renderPreview();
      setSavePill("Unsaved changes", "warn");
    }
  }

  function bindEvents() {
    $("formsCreateBtn")?.addEventListener("click", () => {
      state.currentForm = blankForm();
      showBuilder();
      setStep("setup");
      renderEditor();
      setSavePill("Ready", "");
    });

    $("formsBackBtn")?.addEventListener("click", showHome);

    $("formsSaveDraftBtn")?.addEventListener("click", saveSetupOnly);

    $("formsPublishBtn")?.addEventListener("click", function () {
      publishForm(this);
    });

    $("formsPublishBottomBtn")?.addEventListener("click", function () {
      publishForm(this);
    });

    $("formsContinueToQuestionsBtn")?.addEventListener("click", async function () {
      syncFormFromSetupInputs();
      if (!normalizeText(state.currentForm.title)) {
        alert("Enter form title first.");
        return;
      }
      const ok = await saveSetupOnly();
      if (ok) setStep("questions");
    });

    $("formsBackToSetupBtn")?.addEventListener("click", () => setStep("setup"));

    $("formsContinueToPreviewBtn")?.addEventListener("click", () => {
      renderPreview();
      setStep("preview");
    });

    $("formsBackToQuestionsBtn")?.addEventListener("click", () => setStep("questions"));

    document.querySelectorAll("#formsStatusTabs [data-status]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        state.statusFilter = btn.dataset.status;
        renderHomeTabs();
        await loadForms();
      });
    });

    $("formTitleInput")?.addEventListener("input", () => {
      ensureCurrentForm();
      state.currentForm.title = $("formTitleInput").value;
      patchPreviewMeta();
      setSavePill("Unsaved changes", "warn");
    });

    $("formDescriptionInput")?.addEventListener("input", () => {
      ensureCurrentForm();
      state.currentForm.description = $("formDescriptionInput").value;
      patchPreviewMeta();
      setSavePill("Unsaved changes", "warn");
    });

    $("formOpenDateInput")?.addEventListener("change", () => {
      ensureCurrentForm();
      state.currentForm.open_at = $("formOpenDateInput").value || "";
      setSavePill("Unsaved changes", "warn");
    });

    $("formCloseDateInput")?.addEventListener("change", () => {
      ensureCurrentForm();
      state.currentForm.close_at = $("formCloseDateInput").value || "";
      setSavePill("Unsaved changes", "warn");
    });

    $("formResponseRule")?.addEventListener("change", () => {
      ensureCurrentForm();
      state.currentForm.response_rule = $("formResponseRule").value || "one";
      setSavePill("Unsaved changes", "warn");
    });

    $("formIdentityMode")?.addEventListener("change", () => {
      ensureCurrentForm();
      const value = $("formIdentityMode").value || "auto";
      state.currentForm.identity_mode = value === "anonymous" ? "anonymous" : "auto";
      setSavePill("Unsaved changes", "warn");
    });

    $("audienceAllStudents")?.addEventListener("change", () => {
      if ($("audienceAllStudents").checked) {
        ensureCurrentForm();
        state.currentForm.audience_mode = "all_students";
        state.currentForm.programme_targets = [];
        renderProgrammeTargets();
        renderPreview();
        setSavePill("Unsaved changes", "warn");
      }
    });

    $("audienceProgrammeFilter")?.addEventListener("change", () => {
      if ($("audienceProgrammeFilter").checked) {
        ensureCurrentForm();
        state.currentForm.audience_mode = "programme_filter";
        renderProgrammeTargets();
        renderPreview();
        setSavePill("Unsaved changes", "warn");
      }
    });

    $("openProgrammePickerBtn")?.addEventListener("click", openProgrammePicker);
    $("closeProgrammePickerBtn")?.addEventListener("click", closeProgrammePicker);
    $("applyProgrammePickerBtn")?.addEventListener("click", applyProgrammePickerSelection);

    $("programmeSearchInput")?.addEventListener("input", (e) => {
      state.pickerSearch = e.target.value || "";
      renderProgrammePickerList();
    });

    $("programmeListBox")?.addEventListener("change", (e) => {
      const target = e.target;
      if (!target || !target.matches("[data-programme-pick]")) return;
      state.pickerSelectedMap[target.dataset.programmePick] = !!target.checked;
    });

    $("selectedProgrammesBox")?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-remove-programme]");
      if (!btn) return;
      removeProgramme(btn.dataset.removeProgramme);
    });

    $("programmeLevelStack")?.addEventListener("change", (e) => {
      const target = e.target;
      if (!target || !target.matches("[data-programme-level-programme]")) return;
      toggleProgrammeLevel(target.dataset.programmeLevelProgramme, target.dataset.programmeLevelValue);
    });

    document.querySelectorAll(".type-btn[data-question-type]").forEach((btn) => {
      btn.addEventListener("click", () => addQuestion(btn.dataset.questionType));
    });

    $("formsQuestionList")?.addEventListener("input", (e) => {
      const el = e.target.closest("[data-question-input]");
      if (!el) return;
      handleQuestionInput(el);
    });

    $("formsQuestionList")?.addEventListener("change", (e) => {
      const el = e.target.closest("[data-question-input], [data-question-action]");
      if (!el) return;

      if (el.hasAttribute("data-question-input")) {
        handleQuestionInput(el);
      } else {
        handleQuestionAction(el);
      }
    });

    $("formsQuestionList")?.addEventListener("click", (e) => {
      const el = e.target.closest("[data-question-action]");
      if (!el) return;
      handleQuestionAction(el);
    });

    $("formsListBox")?.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-form-action]");
      if (!btn) return;

      const action = btn.dataset.formAction;
      const formId = btn.dataset.formId;
      if (!formId) return;

      if (action === "open" || action === "edit") {
        await openForm(formId);
        return;
      }

      if (action === "delete") {
        const ok = confirm("Delete this form?");
        if (!ok) return;

        try {
          await invokeFormsManager({
            action: "delete_form",
            form_id: formId,
            ...getActorPayload(),
          });
          await loadForms();
        } catch (err) {
          alert(err.message || "Could not delete form.");
        }
      }
    });
  }

  async function init() {
    state.sb = createClientSafe();
    if (!state.sb) {
      console.error("Supabase client not found.");
      return;
    }

    state.session = getAdminSession();
    ensureIdentityModeOptions();
    bindEvents();
    renderHomeTabs();
    showHome();
    await loadProgrammes();
    await loadForms();
  }

  init();
})();
</script>
</section>
