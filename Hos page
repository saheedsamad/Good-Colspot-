    document.querySelectorAll("#formsStatusTabs [data-status]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.status === state.statusFilter);
    });
  }

  function getFormActionButtons(form) {
    const status = String(form.status || "draft").toLowerCase();
    const count = Number(form.response_count || 0);

    if (status === "draft") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
        <button type="button" class="forms-mini-btn" data-form-action="publish" data-form-id="${form.id}">Publish</button>
        <button type="button" class="forms-mini-btn red" data-form-action="delete" data-form-id="${form.id}" ${count > 0 ? "disabled" : ""}>Delete</button>
      `;
    }

    if (status === "published") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="close" data-form-id="${form.id}">Close</button>
        <button type="button" class="forms-mini-btn red" data-form-action="archive" data-form-id="${form.id}">Archive</button>
      `;
    }

    if (status === "closed") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
        <button type="button" class="forms-mini-btn gray" data-form-action="archive" data-form-id="${form.id}">Archive</button>
      `;
    }

    if (status === "archived") {
      return `
        <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
      `;
    }

    return `
      <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
    `;
  }

