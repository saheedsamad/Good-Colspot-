        }).join("");
      }

      function renderBuilderFormFields(){
        const form = getActiveForm();
        if (!form) return;

        $("formsTitleInput").value = form.title || "";
        $("formsDescriptionInput").value = form.description || "";
        $("formsAudienceSelect").value = form.targetAudience || "all_students";
        $("formsStatusSelect").value = form.status || "draft";
        $("formsOpenDateInput").value = form.openDate || "";
        $("formsCloseDateInput").value = form.closeDate || "";
        $("formsResponseRuleSelect").value = form.responseRule || "one";
        $("formsIdentitySelect").value = form.identityMode || "auto";
      }

      function renderQuestionList(){
