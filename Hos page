                    <rect x="5" y="5" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
                  </svg>
                  <span>Duplicate</span>
                </button>

                ${form.status !== "published" ? `
                  <button type="button" class="forms-mini-btn dark" data-action="publish-form" data-id="${form.id}">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="m13 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Publish</span>
                  </button>
                ` : ""}

                ${form.status === "published" ? `
                  <button type="button" class="forms-mini-btn orange" data-action="close-form" data-id="${form.id}">
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/>
                      <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <span>Close</span>
                  </button>
                ` : ""}

                ${form.status === "closed" ? `
                  <button type="button" class="forms-mini-btn green" data-action="reopen-form" data-id="${form.id}">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M20 12a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M20 4v6h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Reopen</span>
                  </button>
                ` : ""}

                ${form.status !== "archived" ? `
                  <button type="button" class="forms-mini-btn red" data-action="archive-form" data-id="${form.id}">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                      <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <span>Archive</span>
                  </button>
                ` : ""}

                <button type="button" class="forms-mini-btn red" data-action="delete-form" data-id="${form.id}">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </div>
