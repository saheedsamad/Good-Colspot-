<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --bg:#eef4ff;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#64748b;
      --line:#e2e8f0;
      --soft:#f8fbff;
      --green:#16a34a;
      --red:#dc2626;
      --amber:#d97706;
      --shadow:0 14px 36px rgba(15,23,42,.10);
      --radius:22px;
    }

    *{
      box-sizing:border-box;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:radial-gradient(circle at top,#dcecff 0%,#f6faff 45%,#ffffff 100%);
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
      align-items:stretch;
    }

    .shell{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:calc(env(safe-area-inset-top) + 12px) 14px calc(env(safe-area-inset-bottom) + 98px);
      position:relative;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:12px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-badge{
      width:42px;
      height:42px;
      border-radius:14px;
      background:linear-gradient(135deg,var(--blue),#60a5fa);
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow:0 12px 24px rgba(37,99,235,.28);
      flex-shrink:0;
    }

    .brand-badge svg{
      width:20px;
      height:20px;
    }

    .brand-title{
      font-size:18px;
      font-weight:800;
      line-height:1.1;
      letter-spacing:-.02em;
    }

    .brand-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:3px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      max-width:220px;
    }

    .ghost-btn{
      border:none;
      background:#fff;
      border:1px solid var(--line);
      border-radius:999px;
      padding:10px 14px;
      font-size:12px;
      font-weight:800;
      color:var(--text);
      cursor:pointer;
      box-shadow:0 6px 16px rgba(15,23,42,.05);
      display:inline-flex;
      align-items:center;
      gap:7px;
    }

    .ghost-btn svg{
      width:14px;
      height:14px;
    }

    .hero{
      background:linear-gradient(180deg,#fefefe 0%,#f4f9ff 100%);
      border:1px solid #dbeafe;
      border-radius:26px;
      padding:18px 16px;
      box-shadow:var(--shadow);
      margin-bottom:14px;
    }

    .hero-kicker{
      font-size:11px;
      font-weight:800;
      color:var(--blue);
      text-transform:uppercase;
      letter-spacing:.08em;
      margin-bottom:6px;
    }

    .hero h1{
      margin:0 0 8px;
      font-size:23px;
      line-height:1.16;
      letter-spacing:-.03em;
    }

    .hero p{
      margin:0;
      color:var(--muted);
      font-size:13px;
      line-height:1.45;
    }

    .section{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:24px;
      padding:14px;
      box-shadow:var(--shadow);
      margin-bottom:14px;
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:12px;
    }

    .section-title{
      font-size:15px;
      font-weight:800;
      letter-spacing:-.01em;
    }

    .section-note{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
      margin:-4px 0 12px;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
    }

    .stat{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      box-shadow:0 8px 22px rgba(15,23,42,.05);
      min-height:96px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .stat-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }

    .stat-icon{
      width:34px;
      height:34px;
      border-radius:12px;
      background:#eff6ff;
      color:var(--blue);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .stat-icon svg{
      width:18px;
      height:18px;
    }

    .stat-value{
      font-size:24px;
      font-weight:800;
      line-height:1;
      letter-spacing:-.03em;
      margin-top:10px;
    }

    .stat-label{
      font-size:11px;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      margin-top:4px;
    }

    .history-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .history-card{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .history-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
      margin-bottom:8px;
    }

    .history-title{
      font-size:14px;
      font-weight:800;
      line-height:1.2;
      letter-spacing:-.01em;
    }

    .history-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:3px;
      line-height:1.35;
    }

    .pill{
      flex-shrink:0;
      border-radius:999px;
      padding:5px 10px;
      font-size:11px;
      font-weight:800;
      line-height:1;
      border:1px solid var(--line);
      background:#f8fafc;
      color:#334155;
    }

    .empty{
      text-align:center;
      padding:18px 10px;
      color:var(--muted);
      font-size:13px;
    }

    .field{
      margin-bottom:12px;
    }

    .label{
      display:block;
      font-size:12px;
      font-weight:800;
      color:#334155;
      margin-bottom:6px;
    }

    .input,.textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      padding:13px 14px;
      font-size:15px;
      outline:none;
      color:var(--text);
    }

    .textarea{
      min-height:118px;
      resize:vertical;
    }

    .input:focus,.textarea:focus{
      border-color:#93c5fd;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    .action-row{
      display:flex;
      gap:10px;
      margin-top:12px;
    }

    .btn{
      flex:1;
      border:none;
      border-radius:999px;
      padding:13px 14px;
      cursor:pointer;
      font-size:14px;
      font-weight:800;
      letter-spacing:-.01em;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }

    .btn svg{
      width:16px;
      height:16px;
    }

    .btn.primary{
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      box-shadow:0 16px 28px rgba(37,99,235,.28);
    }

    .btn.secondary{
      background:#fff;
      color:var(--text);
      border:1px solid var(--line);
    }

    .btn:disabled{
      opacity:.65;
      cursor:not-allowed;
      box-shadow:none;
    }

    .message{
      display:none;
      margin-top:12px;
      padding:11px 12px;
      border-radius:16px;
      font-size:13px;
      line-height:1.4;
    }

    .message.success{
      display:block;
      background:#ecfdf5;
      color:#166534;
      border:1px solid #bbf7d0;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      color:#991b1b;
      border:1px solid #fecaca;
    }

    .created-box{
      background:#f8fbff;
      border:1px dashed #bfd6ff;
      border-radius:18px;
      padding:12px;
      margin-top:12px;
      display:none;
    }

    .created-row{
      margin-bottom:10px;
    }

    .created-row:last-child{
      margin-bottom:0;
    }

    .created-label{
      font-size:11px;
      font-weight:800;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.07em;
      margin-bottom:5px;
    }

    .created-value{
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
      font-size:14px;
      font-weight:800;
      color:var(--text);
      background:#fff;
      border:1px solid var(--line);
      border-radius:14px;
      padding:10px 12px;
      word-break:break-all;
    }

    .account-card{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .account-row{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .account-row .k{
      font-size:11px;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      margin-bottom:4px;
    }

    .account-row .v{
      font-size:14px;
      font-weight:800;
      color:var(--text);
      word-break:break-word;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      bottom:calc(env(safe-area-inset-bottom) + 8px);
      transform:translateX(-50%);
      width:calc(100% - 20px);
      max-width:420px;
      border-top:1px solid #e5e7eb;
      padding:7px 8px 10px;
      display:flex;
      justify-content:space-around;
      align-items:center;
      background:#ffffff;
      border-radius:26px;
      box-shadow:0 10px 30px rgba(15,23,42,.18);
      z-index:50;
    }

    .nav-btn{
      flex:1;
      text-align:center;
      font-size:11px;
      color:#94a3b8;
      cursor:pointer;
      padding-top:2px;
    }

    .nav-btn-inner{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:3px;
    }

    .nav-btn svg{
      width:20px;
      height:20px;
      display:block;
    }

    .nav-btn.active{
      color:var(--blue);
      font-weight:800;
    }

    .screen{
      display:none;
    }

    .screen.active{
      display:block;
    }

    .copy-row{
      display:flex;
      gap:8px;
      margin-top:10px;
      flex-wrap:wrap;
    }

    .mini-btn{
      border:none;
      background:#eff6ff;
      color:#1d4ed8;
      border-radius:999px;
      padding:9px 12px;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:7px;
    }

    .mini-btn svg{
      width:14px;
      height:14px;
    }

    @media (max-width:380px){
      .stats{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <div class="brand">
        <div class="brand-badge">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 4l7 4v8l-7 4-7-4V8l7-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M9 12h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="brand-title">HOS Dashboard</div>
          <div class="brand-sub" id="schoolNameText">Loading school…</div>
        </div>
      </div>

      <button class="ghost-btn" id="refreshBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 12a8 8 0 10-2.34 5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path d="M20 7v5h-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Refresh</span>
      </button>
    </div>

    <div id="screen-home" class="screen active">
      <section class="hero">
        <div class="hero-kicker">School Control</div>
        <h1 id="heroTitle">Manage your school</h1>
        <p>
          View live totals from your school, then use the shortcuts below to create HOD accounts or send announcements.
        </p>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">Live totals</div>
        </div>

        <div class="stats">
          <div class="stat">
            <div class="stat-top">
              <div class="stat-label">Total HOD</div>
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M16 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <circle cx="9.5" cy="7" r="4" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M20 8v6M17 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <div class="stat-value" id="totalHodCount">0</div>
          </div>

          <div class="stat">
            <div class="stat-top">
              <div class="stat-label">Students</div>
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 8l9-4 9 4-9 4-9-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M7 10v4c0 1.8 2.2 3 5 3s5-1.2 5-3v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <div class="stat-value" id="totalStudentCount">0</div>
          </div>

          <div class="stat">
            <div class="stat-top">
              <div class="stat-label">Lecturers</div>
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 14c2.76 0 5-2.24 5-5S14.76 4 12 4 7 6.24 7 9s2.24 5 5 5z" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M5 20a7 7 0 0114 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <div class="stat-value" id="totalLecturerCount">0</div>
          </div>

          <div class="stat">
            <div class="stat-top">
              <div class="stat-label">Announcements</div>
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 12h2l8 5V7l-8 5H4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M18 9a4 4 0 010 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <div class="stat-value" id="totalAnnouncementCount">0</div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">Latest HOD history</div>
        </div>
        <div class="history-list" id="hodHistoryList"></div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">Latest announcement history</div>
        </div>
        <div class="history-list" id="announcementHistoryList"></div>
      </section>
    </div>

    <div id="screen-hod" class="screen">
      <section class="hero">
        <div class="hero-kicker">Create HOD</div>
        <h1>Create new HOD account</h1>
        <p>Only real backend data is used here. New HOD login details are generated after successful creation.</p>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">New HOD account</div>
        </div>
        <div class="section-note">
          Enter the HOD full name and department. School will be pulled from this HOS account automatically.
        </div>

        <div class="field">
          <label class="label" for="hodFullName">Full name</label>
          <input id="hodFullName" class="input" type="text" placeholder="e.g. Saheed Samad" />
        </div>

        <div class="field">
          <label class="label" for="hodDepartment">Department</label>
          <input id="hodDepartment" class="input" type="text" placeholder="e.g. Computer Science" />
        </div>

        <div class="action-row">
          <button class="btn primary" id="createHodBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>Create HOD</span>
          </button>
          <button class="btn secondary" id="clearHodFormBtn" type="button">
            <span>Clear</span>
          </button>
        </div>

        <div class="created-box" id="createdHodBox">
          <div class="created-row">
            <div class="created-label">Generated Login ID</div>
            <div class="created-value" id="createdHodLoginId">-</div>
          </div>
          <div class="created-row">
            <div class="created-label">Temporary Password</div>
            <div class="created-value" id="createdHodPassword">-</div>
          </div>

          <div class="copy-row">
            <button class="mini-btn" id="copyHodLoginBtn" type="button">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="9" y="9" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/>
                <path d="M7 15H6a2 2 0 01-2-2V6a2 2 0 012-2h7a2 2 0 012 2v1" stroke="currentColor" stroke-width="1.7"/>
              </svg>
              <span>Copy Login ID</span>
            </button>

            <button class="mini-btn" id="copyHodPasswordBtn" type="button">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="9" y="9" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/>
                <path d="M7 15H6a2 2 0 01-2-2V6a2 2 0 012-2h7a2 2 0 012 2v1" stroke="currentColor" stroke-width="1.7"/>
              </svg>
              <span>Copy Password</span>
            </button>
          </div>
        </div>

        <div class="message" id="hodMessage"></div>
      </section>
    </div>

    <div id="screen-announcement" class="screen">
      <section class="hero">
        <div class="hero-kicker">School Announcement</div>
        <h1>Send announcement</h1>
        <p>Send a real school-wide announcement for your school only.</p>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">New announcement</div>
        </div>

        <div class="field">
          <label class="label" for="announcementTitle">Title</label>
          <input id="announcementTitle" class="input" type="text" placeholder="e.g. Examination Notice" />
        </div>

        <div class="field">
          <label class="label" for="announcementBody">Message</label>
          <textarea id="announcementBody" class="textarea" placeholder="Type your announcement here"></textarea>
        </div>

        <div class="action-row">
          <button class="btn primary" id="sendAnnouncementBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M22 2L11 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
            <span>Send</span>
          </button>
          <button class="btn secondary" id="clearAnnouncementBtn" type="button">
            <span>Clear</span>
          </button>
        </div>

        <div class="message" id="announcementMessageBox"></div>
      </section>
    </div>

    <div id="screen-account" class="screen">
      <section class="hero">
        <div class="hero-kicker">Account</div>
        <h1>Your HOS account</h1>
        <p>This shows the signed-in HOS account stored from admin login.</p>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-title">Account details</div>
        </div>

        <div class="account-card">
          <div class="account-row">
            <div class="k">Role</div>
            <div class="v" id="accountRole">-</div>
          </div>

          <div class="account-row">
            <div class="k">School name</div>
            <div class="v" id="accountSchool">-</div>
          </div>

          <div class="account-row">
            <div class="k">Login ID</div>
            <div class="v" id="accountLoginId">-</div>
          </div>

          <div class="account-row">
            <div class="k">Linked email</div>
            <div class="v" id="accountEmail">-</div>
          </div>
        </div>

        <div class="action-row">
          <button class="btn secondary" id="logoutBtn" type="button">Logout</button>
        </div>
      </section>
    </div>
  </div>

  <nav class="bottom-nav">
    <div class="nav-btn active" data-screen="home" onclick="showScreen('home')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 01-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 014.5 19v-8.25z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Home</span>
      </div>
    </div>

    <div class="nav-btn" data-screen="hod" onclick="showScreen('hod')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M16 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <circle cx="9.5" cy="7" r="4" stroke="currentColor" stroke-width="1.7"/>
          <path d="M20 8v6M17 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>HOD</span>
      </div>
    </div>

    <div class="nav-btn" data-screen="announcement" onclick="showScreen('announcement')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 12h2l8 5V7l-8 5H4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M18 9a4 4 0 010 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>Announcement</span>
      </div>
    </div>

    <div class="nav-btn" data-screen="account" onclick="showScreen('account')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/>
          <path d="M5 20a7 7 0 0114 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>Account</span>
      </div>
    </div>
  </nav>

  <script type="module" src="./client_supabase.js"></script>

  <script>
    const EDGE_BASE = "https://wtlrfujfimxcmsnqrnig.functions.supabase.co";

    const EDGE = {
      createHod: "hos-create-hod-account",
      sendAnnouncement: "hos-send-announcement"
    };

    const TABLES = {
      hod: ["hod_accounts", "department_admin_accounts"],
      students: ["student_accounts", "student_profiles"],
      lecturers: ["lecturer_accounts", "lecturer_profiles"],
      announcements: ["school_announcements", "app_announcements"]
    };

    let adminSession = null;
    let currentSchoolName = "";
    let lastCreatedHodLoginId = "";
    let lastCreatedHodPassword = "";

    function $(id){
      return document.getElementById(id);
    }

    function escapeHtml(value){
      return String(value ?? "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#39;");
    }

    function formatDate(iso){
      if (!iso) return "-";
      try{
        return new Date(iso).toLocaleString();
      }catch{
        return iso;
      }
    }

    function showScreen(name){
      ["home","hod","announcement","account"].forEach((screen) => {
        const el = $("screen-" + screen);
        if (el) el.classList.toggle("active", screen === name);
      });

      document.querySelectorAll(".nav-btn").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.screen === name);
      });
    }

    function showMessage(elId, text, type){
      const box = $(elId);
      if (!box) return;
      box.className = "message";
      if (!text){
        box.style.display = "none";
        box.textContent = "";
        return;
      }
      box.classList.add(type === "error" ? "error" : "success");
      box.textContent = text;
      box.style.display = "block";
    }

    function copyText(text, successText){
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        alert(successText || "Copied");
      }).catch(() => {
        alert("Could not copy. Please copy manually.");
      });
    }

    function getAdminSession(){
      try{
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      }catch{
        return null;
      }
    }

    function requireHosSession(){
      adminSession = getAdminSession();

      if (!adminSession || adminSession.role !== "hos"){
        window.location.href = "index.html";
        return false;
      }

      currentSchoolName =
        adminSession.school_name ||
        adminSession.school ||
        adminSession.schoolName ||
        "";

      $("schoolNameText").textContent = currentSchoolName || "School not found";
      $("heroTitle").textContent = currentSchoolName
        ? `Manage ${currentSchoolName}`
        : "Manage your school";

      $("accountRole").textContent = (adminSession.role || "-").toUpperCase();
      $("accountSchool").textContent = currentSchoolName || "-";
      $("accountLoginId").textContent = adminSession.login_id || "-";
      $("accountEmail").textContent = adminSession.linked_email || "Not linked";

      return true;
    }

    async function invokeEdge(functionName, body){
      const res = await fetch(`${EDGE_BASE}/${functionName}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body || {})
      });

      return await res.json().catch(() => ({}));
    }

    async function countFromTable(table, schoolName){
      const sb = window.supabase;
      if (!sb) return 0;

      let query = sb.from(table).select("*", { count: "exact", head: true });

      if (schoolName){
        query = query.eq("school_name", schoolName);
      }

      const { count, error } = await query;
      if (error) throw error;
      return count || 0;
    }

    async function firstWorkingCount(tables, schoolName){
      for (const table of tables){
        try{
          return await countFromTable(table, schoolName);
        }catch(err){
          console.warn("Count failed for", table, err);
        }
      }
      return 0;
    }

    async function fetchRows(table, schoolName, limit = 2){
      const sb = window.supabase;
      if (!sb) return [];

      let query = sb.from(table).select("*");

      if (schoolName){
        query = query.eq("school_name", schoolName);
      }

      const { data, error } = await query.order("created_at", { ascending:false }).limit(limit);
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    }

    async function firstWorkingRows(tables, schoolName, limit = 2){
      for (const table of tables){
        try{
          const rows = await fetchRows(table, schoolName, limit);
          return rows;
        }catch(err){
          console.warn("Rows failed for", table, err);
        }
      }
      return [];
    }

    function renderHodHistory(rows){
      const wrap = $("hodHistoryList");
      if (!wrap) return;

      if (!rows.length){
        wrap.innerHTML = `<div class="empty">No HOD history yet.</div>`;
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.full_name || item.name || "-")}</div>
              <div class="history-sub">${escapeHtml(item.department || "No department")}</div>
            </div>
            <div class="pill">HOD</div>
          </div>
          <div class="history-sub">Login ID: ${escapeHtml(item.login_id || "-")}</div>
          <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
        </div>
      `).join("");
    }

    function renderAnnouncementHistory(rows){
      const wrap = $("announcementHistoryList");
      if (!wrap) return;

      if (!rows.length){
        wrap.innerHTML = `<div class="empty">No announcement history yet.</div>`;
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.title || "Untitled announcement")}</div>
              <div class="history-sub">${escapeHtml((item.message || item.body || "").slice(0, 140) || "-")}</div>
            </div>
            <div class="pill">School</div>
          </div>
          <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
        </div>
      `).join("");
    }

    async function loadDashboardData(){
      if (!window.supabase){
        alert("Supabase is not ready.");
        return;
      }

      const school = currentSchoolName || "";

      $("totalHodCount").textContent = "0";
      $("totalStudentCount").textContent = "0";
      $("totalLecturerCount").textContent = "0";
      $("totalAnnouncementCount").textContent = "0";

      try{
        const [
          totalHod,
          totalStudents,
          totalLecturers,
          totalAnnouncements,
          hodHistory,
          announcementHistory
        ] = await Promise.all([
          firstWorkingCount(TABLES.hod, school),
          firstWorkingCount(TABLES.students, school),
          firstWorkingCount(TABLES.lecturers, school),
          firstWorkingCount(TABLES.announcements, school),
          firstWorkingRows(TABLES.hod, school, 2),
          firstWorkingRows(TABLES.announcements, school, 2)
        ]);

        $("totalHodCount").textContent = totalHod;
        $("totalStudentCount").textContent = totalStudents;
        $("totalLecturerCount").textContent = totalLecturers;
        $("totalAnnouncementCount").textContent = totalAnnouncements;

        renderHodHistory(hodHistory);
        renderAnnouncementHistory(announcementHistory);
      }catch(err){
        console.error(err);
        renderHodHistory([]);
        renderAnnouncementHistory([]);
      }
    }

    async function createHodAccount(){
      const fullName = ($("hodFullName").value || "").trim();
      const department = ($("hodDepartment").value || "").trim();

      showMessage("hodMessage", "", "");

      if (!fullName){
        showMessage("hodMessage", "Please enter the full name.", "error");
        return;
      }

      if (!department){
        showMessage("hodMessage", "Please enter the department.", "error");
        return;
      }

      const btn = $("createHodBtn");
      btn.disabled = true;

      try{
        const result = await invokeEdge(EDGE.createHod, {
          full_name: fullName,
          department,
          school_name: currentSchoolName,
          hos_admin_id: adminSession.id || null
        });

        if (!result.ok){
          throw new Error(result.error || "Could not create HOD account.");
        }

        const hod = result.hod_account || result.hod || {};
        lastCreatedHodLoginId = hod.login_id || result.login_id || "";
        lastCreatedHodPassword = result.temporary_password || result.password || "";

        $("createdHodLoginId").textContent = lastCreatedHodLoginId || "-";
        $("createdHodPassword").textContent = lastCreatedHodPassword || "-";
        $("createdHodBox").style.display = "block";

        showMessage("hodMessage", "HOD account created successfully.", "success");

        $("hodFullName").value = "";
        $("hodDepartment").value = "";

        await loadDashboardData();
      }catch(err){
        console.error(err);
        showMessage("hodMessage", err.message || "Could not create HOD account.", "error");
      }finally{
        btn.disabled = false;
      }
    }

    function clearHodForm(){
      $("hodFullName").value = "";
      $("hodDepartment").value = "";
      $("createdHodBox").style.display = "none";
      $("createdHodLoginId").textContent = "-";
      $("createdHodPassword").textContent = "-";
      lastCreatedHodLoginId = "";
      lastCreatedHodPassword = "";
      showMessage("hodMessage", "", "");
    }

    async function sendAnnouncement(){
      const title = ($("announcementTitle").value || "").trim();
      const message = ($("announcementBody").value || "").trim();

      showMessage("announcementMessageBox", "", "");

      if (!title){
        showMessage("announcementMessageBox", "Please enter the announcement title.", "error");
        return;
      }

      if (!message){
        showMessage("announcementMessageBox", "Please enter the announcement message.", "error");
        return;
      }

      const btn = $("sendAnnouncementBtn");
      btn.disabled = true;

      try{
        const result = await invokeEdge(EDGE.sendAnnouncement, {
          title,
          message,
          school_name: currentSchoolName,
          hos_admin_id: adminSession.id || null
        });

        if (!result.ok){
          throw new Error(result.error || "Could not send announcement.");
        }

        showMessage("announcementMessageBox", "Announcement sent successfully.", "success");
        $("announcementTitle").value = "";
        $("announcementBody").value = "";

        await loadDashboardData();
      }catch(err){
        console.error(err);
        showMessage("announcementMessageBox", err.message || "Could not send announcement.", "error");
      }finally{
        btn.disabled = false;
      }
    }

    function clearAnnouncementForm(){
      $("announcementTitle").value = "";
      $("announcementBody").value = "";
      showMessage("announcementMessageBox", "", "");
    }

    function logoutAdmin(){
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireHosSession()) return;

      $("refreshBtn").addEventListener("click", loadDashboardData);
      $("createHodBtn").addEventListener("click", createHodAccount);
      $("clearHodFormBtn").addEventListener("click", clearHodForm);
      $("sendAnnouncementBtn").addEventListener("click", sendAnnouncement);
      $("clearAnnouncementBtn").addEventListener("click", clearAnnouncementForm);
      $("logoutBtn").addEventListener("click", logoutAdmin);

      $("copyHodLoginBtn").addEventListener("click", () => {
        copyText(lastCreatedHodLoginId, "Login ID copied");
      });

      $("copyHodPasswordBtn").addEventListener("click", () => {
        copyText(lastCreatedHodPassword, "Password copied");
      });

      await loadDashboardData();
    });
  </script>
</body>
</html>
