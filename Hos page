                  </button>
                </div>
              </div>

              <div class="question-body">
                <div class="question-row two">
                  <div class="forms-field">
                    <label>Question Title</label>
                    <input class="forms-input" type="text" value="${escapeHtml(question.title)}" data-action="edit-question-title" data-question-id="${question.id}" placeholder="Enter question title" />
