        }
      ],
      searchResults: [
        { name: "Adebayo Joshua", sub: "Student • Computer Science • 230903174" },
        { name: "Archibong Mary Mfon", sub: "Student • Chemistry • 230902061" },
        { name: "Dr. Gabriel Timilehin", sub: "Lecturer • Computer Science • STF-1042" }
      ]
    };

    function $(id) {
      return document.getElementById(id);
    }

    function randomDigits(len = 5) {
      let out = "";
      for (let i = 0; i < len; i++) out += Math.floor(Math.random() * 10);
      return out;
    }

    function randomPassword(len = 8) {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      let out = "";
      for (let i = 0; i < len; i++) {
        out += chars[Math.floor(Math.random() * chars.length)];
      }
      return out;
    }

    function makeLoginId(department) {
      const clean = String(department || "")
        .replace(/[^a-zA-Z0-9]/g, "")
        .toUpperCase()
        .slice(0, 4) || "HOD";
      return `HOD-${clean}-${randomDigits(5)}`;
    }

    function showMessage(id, text, type) {
      const el = $(id);
      if (!el) return;
      el.textContent = text || "";
      el.className = "message";
      if (text) el.classList.add(type === "error" ? "error" : "success");
    }

    function clearMessage(id) {
      const el = $(id);
      if (!el) return;
      el.textContent = "";
      el.className = "message";
    }

    function scrollToSection(id) {
      const el = $(id);
      if (!el) return;
      el.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function updateHeader() {
      $("heroSchoolName").textContent = `Hello, ${schoolName}`;
      $("lockedSchoolName").textContent = schoolName;

      const initials = fullName
        .split(" ")
        .filter(Boolean)
        .map(part => part[0])
        .slice(0, 2)
        .join("")
        .toUpperCase() || "H";

      $("hosAvatar").textContent = initials;
    }

    function updateStats() {
      $("statHods").textContent = state.hods.length;
      $("statDepartments").textContent = new Set(state.hods.map(h => h.department)).size || 18;
      $("statLecturers").textContent = 165;
      $("statStudents").textContent = 8420;
    }

    function renderHods() {
      const q = ($("hodSearchInput").value || "").trim().toLowerCase();
      const wrap = $("hodList");
      wrap.innerHTML = "";

      const items = state.hods.filter(item => {
        return (
          item.full_name.toLowerCase().includes(q) ||
          item.department.toLowerCase().includes(q) ||
          item.email.toLowerCase().includes(q) ||
          item.login_id.toLowerCase().includes(q)
        );
      });

      if (!items.length) {
        wrap.innerHTML = `
          <div class="hod-card">
            <div class="hod-name">No HOD found</div>
            <div class="hod-sub">Try another search term.</div>
          </div>
        `;
        return;
      }

      wrap.innerHTML = items.map(item => `
        <div class="hod-card">
          <div class="hod-top">
            <div>
              <div class="hod-name">${item.full_name}</div>
              <div class="hod-sub">${item.department} • ${schoolName}</div>
            </div>
            <div class="status-pill ${item.is_active ? "active" : "disabled"}">
              ${item.is_active ? "active" : "disabled"}
            </div>
          </div>

          <div class="mini-grid">
            <div class="mini-info">
              <div class="mini-info-label">Email</div>
              <div class="mini-info-value">${item.email}</div>
            </div>
            <div class="mini-info">
              <div class="mini-info-label">Login ID</div>
              <div class="mini-info-value">${item.login_id}</div>
            </div>
          </div>

          <div class="action-row">
            <button class="action-chip blue" onclick="copyLoginId('${item.login_id}')">Copy login</button>
            <button class="action-chip amber" onclick="resetHodPassword('${item.id}')">Reset</button>
            <button class="action-chip red" onclick="toggleHodStatus('${item.id}')">
              ${item.is_active ? "Disable" : "Enable"}
            </button>
          </div>
        </div>
      `).join("");
    }

    function renderAnnouncements() {
      const wrap = $("announcementList");
      wrap.innerHTML = "";

      if (!state.announcements.length) {
        wrap.innerHTML = `
          <div class="announcement-card">
            <div class="announcement-title">No announcements yet</div>
            <div class="announcement-meta">Create one above.</div>
          </div>
        `;
        return;
      }

      wrap.innerHTML = state.announcements.map(item => `
        <div class="announcement-card">
          <div class="announcement-top">
            <div>
              <div class="announcement-title">${item.title}</div>
              <div class="announcement-meta">${item.time}</div>
            </div>
            <div class="tag">${item.audience}</div>
          </div>
          <div class="search-sub" style="color:#0f172a;">${item.message}</div>
        </div>
      `).join("");
    }

    function renderSearchResults(results = []) {
      const wrap = $("schoolSearchResults");
      wrap.innerHTML = "";

      if (!results.length) {
        wrap.innerHTML = `
          <div class="search-card">
            <div class="search-name">No result</div>
            <div class="search-sub">Try another name, matric number, or staff ID.</div>
          </div>
        `;
        return;
      }

      wrap.innerHTML = results.map(item => `
        <div class="search-card">
          <div class="search-name">${item.name}</div>
          <div class="search-sub">${item.sub}</div>
        </div>
      `).join("");
    }

    function createHodAccount() {
      clearMessage("createHodMessage");

      const full_name = ($("hodFullName").value || "").trim();
      const department = ($("hodDepartment").value || "").trim();
      const email = ($("hodEmail").value || "").trim().toLowerCase();

      if (!full_name) {
        showMessage("createHodMessage", "Please enter the full name.", "error");
        return;
      }

      if (!department) {
        showMessage("createHodMessage", "Please choose the department.", "error");
        return;
      }

      if (!email) {
        showMessage("createHodMessage", "Please enter the email address.", "error");
        return;
      }

      const login_id = makeLoginId(department);
      const temporary_password = randomPassword(8);

      state.hods.unshift({
        id: "hod_" + Date.now(),
        full_name,
        department,
        email,
        login_id,
        is_active: true
      });

      $("generatedLoginId").textContent = login_id;
      $("generatedPassword").textContent = temporary_password;
      $("generatedBox").style.display = "block";

      $("hodFullName").value = "";
      $("hodDepartment").value = "";
      $("hodEmail").value = "";

      showMessage("createHodMessage", "HOD account created successfully.", "success");
      updateStats();
      renderHods();
    }

    function clearHodForm() {
      $("hodFullName").value = "";
      $("hodDepartment").value = "";
      $("hodEmail").value = "";
      $("generatedBox").style.display = "none";
      $("generatedLoginId").textContent = "-";
      $("generatedPassword").textContent = "-";
      clearMessage("createHodMessage");
    }

    function sendAnnouncement() {
      clearMessage("announcementMessage");

      const title = ($("announcementTitle").value || "").trim();
      const audience = ($("announcementAudience").value || "").trim();
      const message = ($("announcementBody").value || "").trim();

      if (!title) {
        showMessage("announcementMessage", "Please enter the announcement title.", "error");
        return;
      }

      if (!message) {
        showMessage("announcementMessage", "Please enter the announcement message.", "error");
        return;
      }

      state.announcements.unshift({
        title,
        audience,
        message,
        time: "Just now"
      });

      $("announcementTitle").value = "";
      $("announcementAudience").value = "All Departments";
      $("announcementBody").value = "";

      showMessage("announcementMessage", "Announcement sent successfully.", "success");
      renderAnnouncements();
    }

    function clearAnnouncementForm() {
      $("announcementTitle").value = "";
      $("announcementAudience").value = "All Departments";
      $("announcementBody").value = "";
      clearMessage("announcementMessage");
    }

    function runSchoolSearch() {
      const q = ($("schoolSearchInput").value || "").trim().toLowerCase();

      if (!q) {
        renderSearchResults(state.searchResults);
        return;
      }

      const filtered = state.searchResults.filter(item => {
        return item.name.toLowerCase().includes(q) || item.sub.toLowerCase().includes(q);
      });

      renderSearchResults(filtered);
    }

    window.copyLoginId = function(loginId) {
      navigator.clipboard?.writeText(loginId);
      alert("Login ID copied");
    };

    window.resetHodPassword = function(hodId) {
      const hod = state.hods.find(item => item.id === hodId);
      if (!hod) return;

      const newPassword = randomPassword(8);
      alert(`${hod.full_name} login has been reset.\n\nTemporary password: ${newPassword}`);
    };

    window.toggleHodStatus = function(hodId) {
      const hod = state.hods.find(item => item.id === hodId);
      if (!hod) return;

      hod.is_active = !hod.is_active;
      renderHods();
    };

    document.addEventListener("DOMContentLoaded", () => {
      updateHeader();
      updateStats();
      renderHods();
      renderAnnouncements();
      renderSearchResults(state.searchResults);

      $("createHodBtn").addEventListener("click", createHodAccount);
      $("clearHodBtn").addEventListener("click", clearHodForm);

      $("sendAnnouncementBtn").addEventListener("click", sendAnnouncement);
      $("clearAnnouncementBtn").addEventListener("click", clearAnnouncementForm);

      $("runSchoolSearchBtn").addEventListener("click", runSchoolSearch);
      $("hodSearchInput").addEventListener("input", renderHods);
      $("refreshHodBtn").addEventListener("click", renderHods);

      $("topCreateHodBtn").addEventListener("click", () => scrollToSection("createHodSection"));
      $("topAnnouncementBtn").addEventListener("click", () => scrollToSection("announcementSection"));

      $("qaCreateHod").addEventListener("click", () => scrollToSection("createHodSection"));
      $("qaSendAnnouncement").addEventListener("click", () => scrollToSection("announcementSection"));
      $("qaSearchSchool").addEventListener("click", () => scrollToSection("searchSection"));
      $("qaViewHods").addEventListener("click", () => scrollToSection("hodListSection"));
      $("jumpToAnnouncements").addEventListener("click", () => scrollToSection("announcementSection"));
    });
  </script>
</body>
</html>
