<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue2:#3b82f6;
      --blue-soft:#eaf2ff;
      --bg:#f6f9ff;
      --card:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --line:#e5e7eb;
      --shadow:0 12px 30px rgba(37,99,235,.10);
      --radius:24px;
      --green:#16a34a;
      --green-soft:#dcfce7;
      --orange:#d97706;
      --orange-soft:#ffedd5;
      --purple:#7c3aed;
      --purple-soft:#ede9fe;
      --teal:#0f766e;
      --teal-soft:#ccfbf1;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    }

    html,body{
      margin:0;
      padding:0;
      background:linear-gradient(180deg,#e9f2ff 0%, #f8fbff 26%, #f7f9fc 100%);
      color:var(--text);
      min-height:100%;
      -webkit-text-size-adjust:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      position:relative;
      padding:
        calc(env(safe-area-inset-top) + 10px)
        14px
        calc(env(safe-area-inset-bottom) + 98px);
      overflow-x:hidden;
    }

    .top-glow{
      position:absolute;
      top:-110px;
      left:-20px;
      width:320px;
      height:220px;
      background:radial-gradient(circle, rgba(59,130,246,.22) 0%, rgba(59,130,246,.08) 45%, rgba(59,130,246,0) 72%);
      pointer-events:none;
      filter:blur(8px);
    }

    .appbar{
      position:relative;
      z-index:2;
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .brand-logo{
      width:54px;
      height:54px;
      border-radius:18px;
      background:linear-gradient(135deg,#60a5fa,#34d399);
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow:0 10px 22px rgba(37,99,235,.18);
      color:#fff;
      flex-shrink:0;
    }

    .brand-text h1{
      margin:0;
      font-size:17px;
      font-weight:800;
      line-height:1.05;
      letter-spacing:.1px;
    }

    .brand-text p{
      margin:3px 0 0;
      font-size:12px;
      color:var(--muted);
      font-weight:700;
      letter-spacing:.12em;
    }

    .profile-wrap{
      position:relative;
    }

    .profile-btn{
      width:54px;
      height:54px;
      border:none;
      border-radius:18px;
      background:linear-gradient(135deg,#60a5fa,#34d399);
      color:#fff;
      font-size:22px;
      font-weight:800;
      box-shadow:0 14px 28px rgba(37,99,235,.16);
      cursor:pointer;
    }

    .profile-menu{
      position:absolute;
      top:62px;
      right:0;
      width:205px;
      background:rgba(255,255,255,.98);
      border:1px solid rgba(226,232,240,.95);
      border-radius:20px;
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      overflow:hidden;
      display:none;
      z-index:30;
      backdrop-filter:blur(14px);
    }

    .profile-menu.show{
      display:block;
    }

    .profile-row{
      display:flex;
      align-items:center;
      gap:12px;
      padding:14px 16px;
      border-bottom:1px solid #eef2f7;
      font-size:15px;
      font-weight:700;
      color:#334155;
      background:#fff;
    }

    .profile-row:last-child{
      border-bottom:none;
    }

    .profile-school{
      display:block;
      padding:14px 16px;
      font-size:14px;
      color:#475569;
      background:#fff;
    }

    .hero-card,
    .section-card,
    .stat-card,
    .mini-card,
    .announcement-item,
    .activity-item,
    .hod-item{
      background:rgba(255,255,255,.92);
      backdrop-filter:blur(12px);
      border:1px solid rgba(226,232,240,.85);
      box-shadow:var(--shadow);
    }

    .hero-card{
      border-radius:30px;
      padding:22px 18px 20px;
      margin-bottom:16px;
    }

    .hero-card .eyebrow{
      margin:0 0 8px;
      color:#64748b;
      font-size:14px;
      font-weight:600;
    }

    .hero-card h2{
      margin:0;
      font-size:24px;
      line-height:1.14;
      font-weight:900;
      letter-spacing:-.03em;
    }

    .hero-card h2 .accent{
      color:var(--blue);
      display:block;
    }

    .hero-card .desc{
      margin:12px 0 0;
      color:#475569;
      font-size:15px;
      line-height:1.55;
      font-weight:500;
    }

    .actions{
      display:grid;
      grid-template-columns:1fr;
      gap:12px;
      margin-bottom:16px;
    }

    .primary-action,
    .secondary-action{
      border:none;
      width:100%;
      border-radius:999px;
      padding:17px 18px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      cursor:pointer;
      font-size:17px;
      font-weight:800;
    }

    .primary-action{
      color:#fff;
      background:linear-gradient(90deg,var(--blue2),#1d4ed8);
      box-shadow:0 16px 30px rgba(37,99,235,.24);
    }

    .secondary-action{
      color:var(--blue);
      background:#edf4ff;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:16px;
    }

    .stat-card{
      border-radius:24px;
      padding:16px 14px;
      min-height:118px;
    }

    .stat-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
    }

    .icon-badge{
      width:52px;
      height:52px;
      border-radius:18px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .icon-blue{ background:#e7f0ff; color:#3b82f6; }
    .icon-purple{ background:var(--purple-soft); color:var(--purple); }
    .icon-green{ background:var(--teal-soft); color:var(--teal); }
    .icon-orange{ background:var(--orange-soft); color:var(--orange); }

    .stat-number{
      font-size:22px;
      font-weight:900;
      line-height:1;
      margin-top:2px;
      color:#1e3a8a;
    }

    .stat-label{
      margin-top:12px;
      font-size:13px;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#64748b;
      font-weight:800;
    }

    .section-card{
      border-radius:28px;
      padding:18px 16px 16px;
      margin-bottom:16px;
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:14px;
    }

    .section-head h3{
      margin:0;
      font-size:18px;
      line-height:1.2;
      font-weight:900;
      color:#1e3a8a;
    }

    .section-link{
      text-decoration:none;
      color:var(--blue);
      font-size:14px;
      font-weight:800;
      display:flex;
      align-items:center;
      gap:5px;
    }

    .hod-list,
    .announcement-list,
    .activity-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .hod-item,
    .announcement-item,
    .activity-item{
      border-radius:20px;
      padding:14px 14px;
      display:flex;
      align-items:flex-start;
      gap:12px;
    }

    .item-icon{
      width:44px;
      height:44px;
      border-radius:16px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .item-main{
      flex:1;
      min-width:0;
    }

    .item-main h4{
      margin:0;
      font-size:15px;
      line-height:1.25;
      font-weight:900;
      color:#1e293b;
    }

    .item-main p{
      margin:4px 0 0;
      font-size:14px;
      color:#64748b;
      line-height:1.45;
    }

    .item-side{
      text-align:right;
      flex-shrink:0;
      display:flex;
      flex-direction:column;
      align-items:flex-end;
      gap:8px;
    }

    .item-time{
      font-size:13px;
      color:#64748b;
      font-weight:700;
      white-space:nowrap;
    }

    .pill{
      padding:6px 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:900;
      line-height:1;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
    }

    .pill.active{
      background:var(--green-soft);
      color:var(--green);
    }

    .pill.sent{
      background:#dcfce7;
      color:#15803d;
    }

    .pill.more{
      background:#eef4ff;
      color:#4263eb;
    }

    .quick-search{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:16px;
    }

    .mini-card{
      border-radius:22px;
      padding:16px 14px;
      display:flex;
      align-items:center;
      gap:12px;
      min-height:84px;
    }

    .mini-card h4{
      margin:0 0 3px;
      font-size:15px;
      font-weight:800;
      color:#1e293b;
    }

    .mini-card p{
      margin:0;
      font-size:13px;
      color:#64748b;
      line-height:1.35;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:10px;
      width:min(392px, calc(100vw - 18px));
      background:rgba(255,255,255,.88);
      backdrop-filter:blur(18px);
      border:1px solid rgba(226,232,240,.92);
      box-shadow:0 18px 44px rgba(15,23,42,.12);
      border-radius:28px;
      padding:10px 8px calc(10px + env(safe-area-inset-bottom));
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:4px;
      z-index:50;
    }

    .nav-btn{
      border:none;
      background:transparent;
      border-radius:18px;
      padding:8px 4px 6px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:5px;
      color:#64748b;
      cursor:pointer;
      min-height:64px;
    }

    .nav-btn svg{
      width:22px;
      height:22px;
    }

    .nav-btn span{
      font-size:12px;
      font-weight:800;
      letter-spacing:.01em;
    }

    .nav-btn.active{
      color:var(--blue);
    }

    .nav-btn.active .nav-icon-wrap{
      background:#e8f1ff;
    }

    .nav-icon-wrap{
      width:38px;
      height:38px;
      border-radius:14px;
      display:flex;
      align-items:center;
      justify-content:center;
      transition:.2s ease;
    }

    .sr-only{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="top-glow"></div>

    <header class="appbar">
      <div class="brand">
        <div class="brand-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none">
            <path d="M6.5 9.5C6.5 6.462 8.962 4 12 4c1.932 0 3.632.996 4.607 2.503" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M17.5 14.5A5.5 5.5 0 0 1 12 20a5.5 5.5 0 0 1-5.146-3.545" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M15 9h-4a3 3 0 0 0 0 6h3" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="brand-text">
          <h1>Colspot</h1>
          <p>HOS</p>
        </div>
      </div>

      <div class="profile-wrap">
        <button class="profile-btn" id="profileBtn" type="button">H</button>

        <div class="profile-menu" id="profileMenu">
          <div class="profile-row">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
            </svg>
            <span>Profile</span>
          </div>
          <div class="profile-row">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <path d="M16 17l5-5-5-5"></path>
              <path d="M21 12H9"></path>
            </svg>
            <span>Logout</span>
          </div>
          <span class="profile-school">Ekiti State University</span>
        </div>
      </div>
    </header>

    <section class="hero-card">
      <p class="eyebrow">Hello, Ekiti State University</p>
      <h2>
        What do you want to
        <span class="accent">do today?</span>
      </h2>
      <p class="desc">
        Manage your school, create HOD accounts, monitor departments, and send announcements to all departments.
      </p>
    </section>

    <section class="actions">
      <button class="primary-action" type="button">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
        </svg>
        <span>Create new HOD account</span>
      </button>

      <button class="secondary-action" type="button">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
          <path d="M4 11v2a2 2 0 0 0 2 2h1l4 4v-4h7a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2Z" stroke-linejoin="round"/>
        </svg>
        <span>Send announcement</span>
      </button>
    </section>

    <section class="stats-grid">
      <article class="stat-card">
        <div class="stat-top">
          <div class="icon-badge icon-blue">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
              <circle cx="9.5" cy="7" r="3"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="stat-number">3</div>
        </div>
        <div class="stat-label">HODs</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="icon-badge icon-purple">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l7-4 7 4v14"></path>
              <path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01"></path>
            </svg>
          </div>
          <div class="stat-number">18</div>
        </div>
        <div class="stat-label">Departments</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="icon-badge icon-green">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21a8 8 0 1 0-16 0"></path>
              <circle cx="12" cy="9" r="4"></circle>
            </svg>
          </div>
          <div class="stat-number">165</div>
        </div>
        <div class="stat-label">Lecturers</div>
      </article>

      <article class="stat-card">
        <div class="stat-top">
          <div class="icon-badge icon-orange">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5V5.5A1.5 1.5 0 0 1 5.5 4H20"></path>
              <path d="M8 7h12v13H8a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"></path>
              <path d="M12 11h4M12 15h4"></path>
            </svg>
          </div>
          <div class="stat-number">8420</div>
        </div>
        <div class="stat-label">Students</div>
      </article>
    </section>

    <section class="section-card">
      <div class="section-head">
        <h3>Manage HODs</h3>
        <a href="#" class="section-link">
          <span>View All</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="hod-list">
        <article class="hod-item">
          <div class="item-icon icon-blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
            </svg>
          </div>

          <div class="item-main">
            <h4>Dr. Sola Olatunji</h4>
            <p>Computer Science</p>
          </div>

          <div class="item-side">
            <span class="pill active">Active</span>
          </div>
        </article>

        <article class="hod-item">
          <div class="item-icon icon-green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
            </svg>
          </div>

          <div class="item-main">
            <h4>Dr. Fatima Bello</h4>
            <p>Microbiology</p>
          </div>

          <div class="item-side">
            <span class="item-time">View</span>
            <span class="pill more">More</span>
          </div>
        </article>
      </div>
    </section>

    <section class="section-card">
      <div class="section-head">
        <h3>Recent Announcements</h3>
        <a href="#" class="section-link">
          <span>View All</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="announcement-list">
        <article class="announcement-item">
          <div class="item-icon icon-blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path>
            </svg>
          </div>

          <div class="item-main">
            <h4>Semester Exams Schedule</h4>
            <p>The exam timetable is now posted for the upcoming semester exams.</p>
          </div>

          <div class="item-side">
            <span class="item-time">Apr 25, 2024</span>
            <span class="pill sent">Sent</span>
          </div>
        </article>

        <article class="announcement-item">
          <div class="item-icon icon-orange">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 10V7a5 5 0 1 1 10 0v3"></path>
              <rect x="5" y="10" width="14" height="10" rx="2"></rect>
            </svg>
          </div>

          <div class="item-main">
            <h4>HOD login details reset</h4>
            <p>Dr. Fatima Bello (Microbiology)</p>
          </div>

          <div class="item-side">
            <span class="item-time">Yesterday</span>
          </div>
        </article>
      </div>
    </section>

    <section class="section-card">
      <div class="section-head">
        <h3>Recent Activity</h3>
      </div>

      <div class="activity-list">
        <article class="activity-item">
          <div class="item-icon icon-purple">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
            </svg>
          </div>

          <div class="item-main">
            <h4>New HOD account created</h4>
            <p>Dr. Umoru Yusuf (Mathematics)</p>
          </div>

          <div class="item-side">
            <span class="item-time">Today, 11:05 AM</span>
          </div>
        </article>

        <article class="activity-item">
          <div class="item-icon icon-blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 6h13"></path>
              <path d="M8 12h13"></path>
              <path d="M8 18h13"></path>
              <path d="M3 6h.01"></path>
              <path d="M3 12h.01"></path>
              <path d="M3 18h.01"></path>
            </svg>
          </div>

          <div class="item-main">
            <h4>School records viewed</h4>
            <p>Department overview opened successfully</p>
          </div>

          <div class="item-side">
            <span class="item-time">Today, 9:18 AM</span>
          </div>
        </article>
      </div>
    </section>

    <section class="quick-search">
      <article class="mini-card">
