  function $(id) {
    return document.getElementById(id);
  }

  function escapeHtml(value) {
    return String(value || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function uid(prefix) {
    return `${prefix}_${Math.random().toString(36).slice(2, 10)}_${Date.now().toString(36)}`;
  }

  function normalizeText(value) {
    return String(value || "").trim().replace(/\s+/g, " ");
  }

  function normalizeUpper(value) {
    return normalizeText(value).toUpperCase();
  }

  function createClientSafe() {
    try {
      if (window.supabase && typeof window.supabase.createClient === "function") {
        return window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      }
    } catch (err) {
      console.error("Forms supabase init failed:", err);
    }
    return null;
  }

  function getAdminSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function getActorPayload() {
    const session = state.session || {};
    const account = session.account || {};
    const role = session.role || account.role || "";

    if (role === "hos") {
      return { hos_admin_id: account.id || session.id || "" };
    }
    if (role === "form_agent") {
      return { form_agent_id: account.id || session.id || "" };
    }
    return { hos_admin_id: account.id || session.id || "" };
  }

  function ensureIdentityModeOptions() {
    const select = $("formIdentityMode");
    if (!select) return;

    const current = (select.value || "auto").toLowerCase();
    select.innerHTML = `
      <option value="auto">Use logged-in identity</option>
      <option value="anonymous">Anonymous</option>
    `;
    select.value = current === "anonymous" ? "anonymous" : "auto";
  }

  function blankForm() {
