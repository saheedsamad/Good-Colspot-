                                <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                            <button type="button" class="icon-btn" data-action="delete-option" data-question-id="${question.id}" data-option-index="${optionIndex}" title="Delete option">
                              <svg viewBox="0 0 24 24" fill="none">
                                <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                                <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                              </svg>
                            </button>
                          </div>
                        </div>
                      `).join("")}
                    </div>
                  </div>
                ` : ""}

                ${isFile ? `
                  <div class="question-row three">
                    <div class="forms-field">
                      <label>Allowed File Types</label>
                      <input class="forms-input" type="text" value="${escapeHtml(question.fileTypes || "pdf,image")}" data-action="edit-file-types" data-question-id="${question.id}" placeholder="e.g. pdf,image,docx" />
                    </div>

                    <div class="forms-field">
                      <label>Max File Size</label>
                      <input class="forms-input" type="text" value="${escapeHtml(question.maxFileSize || "5MB")}" data-action="edit-file-size" data-question-id="${question.id}" placeholder="e.g. 5MB" />
                    </div>

                    <div class="forms-field">
                      <label>Max Files</label>
                      <input class="forms-input" type="number" min="1" value="${escapeHtml(String(question.maxFiles || 1))}" data-action="edit-file-count" data-question-id="${question.id}" />
                    </div>
                  </div>
                ` : ""}

                ${isYesNo ? `
                  <div class="forms-note">This question will show fixed options: Yes and No.</div>
                ` : ""}

                <div class="question-footer">
                  <div class="question-footer-left">
                    ${hasOptions ? `
                      <button type="button" class="forms-secondary-btn" data-action="add-option" data-question-id="${question.id}">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
