                  <div class="forms-field">
                    <label>Question Type</label>
                    <select class="forms-select" data-action="change-question-type" data-question-id="${question.id}">
                      <option value="short_answer" ${question.type === "short_answer" ? "selected" : ""}>Short Answer</option>
                      <option value="paragraph" ${question.type === "paragraph" ? "selected" : ""}>Paragraph</option>
                      <option value="multiple_choice" ${question.type === "multiple_choice" ? "selected" : ""}>Multiple Choice</option>
                      <option value="checkboxes" ${question.type === "checkboxes" ? "selected" : ""}>Checkboxes</option>
                      <option value="dropdown" ${question.type === "dropdown" ? "selected" : ""}>Dropdown</option>
                      <option value="date" ${question.type === "date" ? "selected" : ""}>Date</option>
                      <option value="file_upload" ${question.type === "file_upload" ? "selected" : ""}>File Upload</option>
                      <option value="yes_no" ${question.type === "yes_no" ? "selected" : ""}>Yes / No</option>
                    </select>
                  </div>
                </div>

                <div class="forms-field">
                  <label>Help Text</label>
                  <input class="forms-input" type="text" value="${escapeHtml(question.helpText || "")}" data-action="edit-question-help" data-question-id="${question.id}" placeholder="Optional help text for users" />
                </div>

                ${!isFile ? `
                  <div class="forms-field">
                    <label>Placeholder / Hint</label>
                    <input class="forms-input" type="text" value="${escapeHtml(question.placeholder || "")}" data-action="edit-question-placeholder" data-question-id="${question.id}" placeholder="Optional placeholder or hint" />
                  </div>
                ` : ""}

                ${hasOptions ? `
                  <div class="forms-field">
                    <label>Options</label>
                    <div class="option-list">
                      ${(question.options || []).map((option, optionIndex) => `
                        <div class="option-row">
                          <div class="option-bullet">${optionIndex + 1}</div>
                          <input class="forms-input" type="text" value="${escapeHtml(option)}" data-action="edit-option" data-question-id="${question.id}" data-option-index="${optionIndex}" placeholder="Enter option" />
                          <div class="option-actions">
                            <button type="button" class="icon-btn" data-action="move-option-up" data-question-id="${question.id}" data-option-index="${optionIndex}" title="Move option up">
                              <svg viewBox="0 0 24 24" fill="none">
                                <path d="m7 14 5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                            <button type="button" class="icon-btn" data-action="move-option-down" data-question-id="${question.id}" data-option-index="${optionIndex}" title="Move option down">
