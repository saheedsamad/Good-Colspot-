                    <label class="toggle-wrap">
                      <span>Required</span>
                      <span class="switch">
                        <input type="checkbox" data-question-action="toggle-required" data-question-id="${q.local_id}" ${q.is_required ? "checked" : ""}>
                        <span class="slider"></span>
                      </span>
                    </label>

                    <button type="button" class="icon-btn" data-question-action="move-up" data-question-id="${q.local_id}" title="Move Up">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="m7 14 5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>

                    <button type="button" class="icon-btn" data-question-action="move-down" data-question-id="${q.local_id}" title="Move Down">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>

                    <button type="button" class="icon-btn" data-question-action="duplicate" data-question-id="${q.local_id}" title="Duplicate">
                      <svg viewBox="0 0 24 24" fill="none">
                        <rect x="9" y="9" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
                        <rect x="5" y="5" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
                      </svg>
                    </button>

                    <button type="button" class="icon-btn" data-question-action="delete" data-question-id="${q.local_id}" title="Delete">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="question-card-body">
                  <div class="question-grid-2">
                    <div class="forms-field">
                      <label>Question Title</label>
                      <input class="forms-input" type="text" value="${escapeHtml(q.question_text || "")}" data-question-input="question_text" data-question-id="${q.local_id}" placeholder="Enter your question here.">
                    </div>

                    <div class="forms-field">
                      <label>Question Type</label>
                      <select class="forms-select" data-question-input="question_type" data-question-id="${q.local_id}">
                        <option value="short_answer" ${q.question_type === "short_answer" ? "selected" : ""}>Short Answer</option>
                        <option value="paragraph" ${q.question_type === "paragraph" ? "selected" : ""}>Paragraph</option>
                        <option value="multiple_choice" ${q.question_type === "multiple_choice" ? "selected" : ""}>Multiple Choice</option>
                        <option value="checkboxes" ${q.question_type === "checkboxes" ? "selected" : ""}>Checkboxes</option>
                        <option value="dropdown" ${q.question_type === "dropdown" ? "selected" : ""}>Dropdown</option>
                        <option value="date" ${q.question_type === "date" ? "selected" : ""}>Date</option>
                        <option value="file_upload" ${q.question_type === "file_upload" ? "selected" : ""}>File Upload</option>
                        <option value="yes_no" ${q.question_type === "yes_no" ? "selected" : ""}>Yes / No</option>
                      </select>
                    </div>
                  </div>

                  <div class="forms-field">
                    <label>Help Text</label>
                    <input class="forms-input" type="text" value="${escapeHtml(q.help_text || "")}" data-question-input="help_text" data-question-id="${q.local_id}" placeholder="Optional helper text.">
                  </div>

                  ${!isFile ? `
                    <div class="forms-field">
                      <label>Placeholder</label>
                      <input class="forms-input" type="text" value="${escapeHtml(q.placeholder_text || "")}" data-question-input="placeholder_text" data-question-id="${q.local_id}" placeholder="Optional placeholder.">
                    </div>
                  ` : ""}

                  ${supportsOptions ? `
                    <div class="forms-field">
                      <label>Options</label>
                      <div class="options-list">
                        ${(q.options_json || []).map((opt, optIndex) => `
                          <div class="option-row">
                            <div class="option-badge">${optIndex + 1}</div>
                            <input class="forms-input" type="text" value="${escapeHtml(opt || "")}" data-question-input="option" data-question-id="${q.local_id}" data-option-index="${optIndex}" placeholder="Option text">
                            <div class="option-actions">
                              <button type="button" class="icon-btn" data-question-action="option-up" data-question-id="${q.local_id}" data-option-index="${optIndex}">
                                <svg viewBox="0 0 24 24" fill="none">
                                  <path d="m7 14 5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </button>
                              <button type="button" class="icon-btn" data-question-action="option-down" data-question-id="${q.local_id}" data-option-index="${optIndex}">
                                <svg viewBox="0 0 24 24" fill="none">
                                  <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </button>
                              <button type="button" class="icon-btn" data-question-action="delete-option" data-question-id="${q.local_id}" data-option-index="${optIndex}">
                                <svg viewBox="0 0 24 24" fill="none">
                                  <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                                  <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                              </button>
                            </div>
                          </div>
                        `).join("")}
                      </div>
                    </div>
                  ` : ""}

                  ${isFile ? `
                    <div class="question-grid-3">
                      <div class="forms-field">
                        <label>Allowed File Types</label>
                        <input class="forms-input" type="text" value="${escapeHtml((q.allowed_file_types || []).join(","))}" data-question-input="allowed_file_types" data-question-id="${q.local_id}" placeholder="pdf,image">
                      </div>
                      <div class="forms-field">
                        <label>Max File Size (MB)</label>
                        <input class="forms-input" type="number" min="1" value="${escapeHtml(String(q.max_file_size_mb || 5))}" data-question-input="max_file_size_mb" data-question-id="${q.local_id}">
                      </div>
                      <div class="forms-field">
                        <label>Max Files</label>
                        <input class="forms-input" type="number" min="1" value="${escapeHtml(String(q.max_files || 1))}" data-question-input="max_files" data-question-id="${q.local_id}">
                      </div>
                    </div>
                  ` : ""}

                  ${isYesNo ? `
                    <div class="forms-note info">This question uses fixed options: Yes and No.</div>
                  ` : ""}

                  <div class="question-footer">
                    <div class="question-footer-left">
                      ${supportsOptions ? `
                        <button type="button" class="forms-btn-soft" data-question-action="add-option" data-question-id="${q.local_id}">
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                          <span>Add Option</span>
                        </button>
                      ` : ""}
                    </div>

                    <div class="question-footer-right">
                      <button type="button" class="forms-btn-danger" data-question-action="delete" data-question-id="${q.local_id}">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M5.75 7.75h12.5v10.5A1.75 1.75 0 0 1 16.5 20h-9A1.75 1.75 0 0 1 5.75 18.25V7.75Z" stroke="currentColor" stroke-width="1.8"/>
                          <path d="M4 7.75h16M9.5 11.5v4.5M14.5 11.5v4.5M8.5 5.25h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        <span>Delete Question</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join("");
        }

        function renderPreview(){
          const form = state.currentForm || blankForm();
          const titleEl = $("studentPreviewTitle");
          const descEl = $("studentPreviewDescription");
          const bodyEl = $("studentPreviewBody");

          titleEl.textContent = form.title || "Untitled Form";
          descEl.textContent = form.description || "Form description will appear here.";

          if (!(form.questions || []).length){
            bodyEl.innerHTML = `<div class="forms-empty">No questions yet. Add questions first.</div>`;
            return;
          }

          bodyEl.innerHTML = form.questions.map((q, index) => {
            const requiredMark = q.is_required ? `<span class="student-required">*</span>` : "";
            let inputHtml = "";

            if (q.question_type === "short_answer"){
              inputHtml = `<input class="forms-input" type="text" placeholder="${escapeHtml(q.placeholder_text || "Short answer")}">`;
            } else if (q.question_type === "paragraph"){
              inputHtml = `<textarea class="forms-textarea" placeholder="${escapeHtml(q.placeholder_text || "Write your answer here")}"></textarea>`;
            } else if (q.question_type === "multiple_choice"){
              inputHtml = `
                <div class="student-option-list">
                  ${(q.options_json || []).map(opt => `
                    <label class="student-option">
                      <input type="radio" name="preview_q_${index}">
                      <span>${escapeHtml(opt || "Option")}</span>
                    </label>
                  `).join("")}
                </div>
              `;
            } else if (q.question_type === "checkboxes"){
              inputHtml = `
                <div class="student-option-list">
                  ${(q.options_json || []).map(opt => `
                    <label class="student-option">
                      <input type="checkbox">
                      <span>${escapeHtml(opt || "Option")}</span>
                    </label>
                  `).join("")}
                </div>
              `;
            } else if (q.question_type === "dropdown"){
              inputHtml = `
                <select class="forms-select">
                  <option value="">Select an option</option>
                  ${(q.options_json || []).map(opt => `<option>${escapeHtml(opt || "Option")}</option>`).join("")}
                </select>
              `;
            } else if (q.question_type === "date"){
              inputHtml = `<input class="forms-input" type="date">`;
            } else if (q.question_type === "file_upload"){
              inputHtml = `
                <div class="forms-note info">
                  Allowed: ${escapeHtml((q.allowed_file_types || []).join(",") || "pdf,image")} • Max size: ${escapeHtml(String(q.max_file_size_mb || 5))}MB • Max files: ${escapeHtml(String(q.max_files || 1))}
                </div>
              `;
            } else if (q.question_type === "yes_no"){
              inputHtml = `
                <div class="student-option-list">
                  <label class="student-option">
                    <input type="radio" name="preview_q_${index}">
                    <span>Yes</span>
                  </label>
                  <label class="student-option">
                    <input type="radio" name="preview_q_${index}">
                    <span>No</span>
                  </label>
                </div>
              `;
            }

            return `
              <div class="student-q">
                <h4>${index + 1}. ${escapeHtml(q.question_text || "Untitled Question")}${requiredMark}</h4>
                <p>${escapeHtml(q.help_text || "Answer this question below.")}</p>
                ${inputHtml}
              </div>
            `;
          }).join("");
        }

        function setStep(step){
          state.currentStep = step;

          $("formsStageSetup").classList.toggle("forms-hidden", step !== "setup");
          $("formsStageQuestions").classList.toggle("forms-hidden", step !== "questions");
          $("formsStagePreview").classList.toggle("forms-hidden", step !== "preview");

          $("stepChipSetup").className = "forms-step" + (step === "setup" ? " active" : (step === "questions" || step === "preview" ? " done" : ""));
          $("stepChipQuestions").className = "forms-step" + (step === "questions" ? " active" : (step === "preview" ? " done" : ""));
          $("stepChipPreview").className = "forms-step" + (step === "preview" ? " active" : "");
        }

        async function invokeFormsManager(body){
          if (!state.sb) throw new Error("Supabase is not ready.");
          const { data, error } = await state.sb.functions.invoke(FORMS_FUNCTION, { body });
          if (error) throw new Error(error.message || "Request failed.");
          if (!data?.ok) throw new Error(data?.error || "Request failed.");
          return data;
        }

        function serializeQuestions(){
          const form = state.currentForm || blankForm();
          return (form.questions || []).map((q, index) => ({
            question_text: String(q.question_text || "").trim(),
            question_type: q.question_type || "short_answer",
            help_text: String(q.help_text || "").trim(),
            placeholder_text: String(q.placeholder_text || "").trim(),
            is_required: !!q.is_required,
            options_json: Array.isArray(q.options_json) ? q.options_json.map(v => String(v || "").trim()).filter(Boolean) : [],
            allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types.map(v => String(v || "").trim()).filter(Boolean) : [],
            max_file_size_mb: Number(q.max_file_size_mb || 5),
            max_files: Number(q.max_files || 1),
            section_name: String(q.section_name || "").trim(),
            sort_order: index + 1
          }));
        }

        function getSetupPayload(){
          const form = state.currentForm || blankForm();
          return {
            title: String(form.title || "").trim(),
            description: String(form.description || "").trim(),
            target_audience: form.target_audience || "all_students",
            response_rule: form.response_rule || "one",
            identity_mode: form.identity_mode || "auto",
            open_at: form.open_at || null,
            close_at: form.close_at || null,
            status: form.status || "draft"
          };
        }

        async function loadForms(){
          try{
            state.loadingList = true;
            renderFormsList();

            const data = await invokeFormsManager({
              action: "list_forms",
              status: state.statusFilter,
              ...getActorPayload()
            });

            state.forms = Array.isArray(data.forms) ? data.forms : [];
            renderFormsList();
          } catch (err) {
            console.error(err);
            $("formsListBox").innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load forms.")}</div>`;
          } finally {
            state.loadingList = false;
          }
        }

        async function openForm(formId){
          try{
            setSavePill("Loading form...", "warn");
            const data = await invokeFormsManager({
              action: "get_form",
              form_id: formId,
              ...getActorPayload()
            });

            loadFormIntoEditor(data.form, data.questions || []);
            showBuilder();
            setStep("setup");
            setSavePill("Loaded");
          } catch (err) {
            console.error(err);
            setSavePill(err.message || "Could not load form", "error");
            alert(err.message || "Could not load form.");
          }
        }

        async function saveSetupOnly(){
          const payload = getSetupPayload();

          if (!payload.title){
            throw new Error("Form title is required.");
          }

          if (!state.currentForm.id){
            const data = await invokeFormsManager({
              action: "create_form",
              ...getActorPayload(),
              ...payload,
              questions: []
            });

            state.currentForm.id = data.form.id;
            state.currentForm.status = data.form.status || "draft";
            return data.form;
          }

          const data = await invokeFormsManager({
            action: "update_form",
            form_id: state.currentForm.id,
            ...getActorPayload(),
            ...payload
          });

          state.currentForm.status = data.form.status || state.currentForm.status;
          return data.form;
        }

        async function saveFormWithQuestions(){
          const payload = getSetupPayload();

          if (!payload.title){
            throw new Error("Form title is required.");
          }

          const questions = serializeQuestions();

          if (!state.currentForm.id){
            const data = await invokeFormsManager({
              action: "create_form",
              ...getActorPayload(),
              ...payload,
              questions
            });

            state.currentForm.id = data.form.id;
            state.currentForm.status = data.form.status || "draft";
            return data.form;
          }

          const data = await invokeFormsManager({
            action: "update_form",
            form_id: state.currentForm.id,
            ...getActorPayload(),
            ...payload,
            questions
          });

          state.currentForm.status = data.form.status || state.currentForm.status;
          return data.form;
        }

        async function saveDraft(){
          try{
            setSavePill("Saving draft...", "warn");
            await saveFormWithQuestions();
            await loadForms();
            setSavePill("Draft saved");
          } catch (err) {
            console.error(err);
            setSavePill(err.message || "Save failed", "error");
            alert(err.message || "Could not save draft.");
          }
        }

        async function publishForm(){
          try{
            if (!state.currentForm?.id){
              await saveFormWithQuestions();
            }

            setSavePill("Publishing...", "warn");

            await invokeFormsManager({
              action: "publish_form",
              form_id: state.currentForm.id,
              ...getActorPayload()
            });

            state.currentForm.status = "published";
            state.statusFilter = "published";
            renderHomeTabs();
            await loadForms();
            setSavePill("Published");
            showHome();
          } catch (err) {
            console.error(err);
            setSavePill(err.message || "Publish failed", "error");
            alert(err.message || "Could not publish form.");
          }
        }

        function attachSetupInputs(){
          [
            ["formTitleInput", "title"],
            ["formDescriptionInput", "description"],
            ["formTargetAudience", "target_audience"],
            ["formOpenDateInput", "open_at"],
            ["formCloseDateInput", "close_at"],
            ["formResponseRule", "response_rule"],
            ["formIdentityMode", "identity_mode"]
          ].forEach(([id, key]) => {
            const el = $(id);
            const eventName = (el.tagName === "SELECT") ? "change" : "input";

            el.addEventListener(eventName, function(){
              if (!state.currentForm) state.currentForm = blankForm();
              state.currentForm[key] = el.value;
              renderPreview();
            });
          });
        }

        function moveItem(arr, from, to){
          if (to < 0 || to >= arr.length) return;
          const item = arr.splice(from, 1)[0];
          arr.splice(to, 0, item);
        }

        function bindQuestionInputs(){
          $("formsQuestionList").addEventListener("input", function(e){
            const target = e.target;
            const field = target.dataset.questionInput;
            const questionId = target.dataset.questionId;
            if (!field || !questionId || !state.currentForm) return;

            const q = state.currentForm.questions.find(item => item.local_id === questionId);
            if (!q) return;

            if (field === "question_text") q.question_text = target.value;
            if (field === "help_text") q.help_text = target.value;
            if (field === "placeholder_text") q.placeholder_text = target.value;
            if (field === "max_file_size_mb") q.max_file_size_mb = Math.max(1, Number(target.value || 1));
            if (field === "max_files") q.max_files = Math.max(1, Number(target.value || 1));

            if (field === "allowed_file_types"){
              q.allowed_file_types = String(target.value || "")
                .split(",")
                .map(v => v.trim())
                .filter(Boolean);
            }

            if (field === "option"){
              const optIndex = Number(target.dataset.optionIndex);
              q.options_json[optIndex] = target.value;
            }

            renderPreview();
          });

          $("formsQuestionList").addEventListener("change", function(e){
            const target = e.target;
            const field = target.dataset.questionInput;
            const questionId = target.dataset.questionId;
            if (!field || !questionId || !state.currentForm) return;

            const q = state.currentForm.questions.find(item => item.local_id === questionId);
            if (!q) return;

            if (field === "question_type"){
              const fresh = blankQuestion(target.value);
              q.question_type = fresh.question_type;
              q.options_json = fresh.options_json;
              q.allowed_file_types = fresh.allowed_file_types;
              q.max_file_size_mb = fresh.max_file_size_mb;
              q.max_files = fresh.max_files;
              renderQuestionList();
              renderPreview();
            }
          });

          $("formsQuestionList").addEventListener("click", function(e){
            const btn = e.target.closest("[data-question-action]");
            if (!btn || !state.currentForm) return;

            const action = btn.dataset.questionAction;
            const questionId = btn.dataset.questionId;
            const qIndex = state.currentForm.questions.findIndex(item => item.local_id === questionId);
            if (qIndex === -1) return;

            const q = state.currentForm.questions[qIndex];

            if (action === "toggle-required"){
              q.is_required = !q.is_required;
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "move-up"){
              moveItem(state.currentForm.questions, qIndex, qIndex - 1);
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "move-down"){
              moveItem(state.currentForm.questions, qIndex, qIndex + 1);
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "duplicate"){
              const copy = JSON.parse(JSON.stringify(q));
              copy.local_id = uid("q");
              delete copy.id;
              state.currentForm.questions.splice(qIndex + 1, 0, copy);
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "delete"){
              state.currentForm.questions.splice(qIndex, 1);
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "add-option"){
              if (!Array.isArray(q.options_json)) q.options_json = [];
              q.options_json.push("");
              renderQuestionList();
              return;
            }

            if (action === "delete-option"){
              const optIndex = Number(btn.dataset.optionIndex);
              q.options_json.splice(optIndex, 1);
              if (!q.options_json.length && ["multiple_choice","checkboxes","dropdown"].includes(q.question_type)){
                q.options_json = [""];
              }
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "option-up"){
              const optIndex = Number(btn.dataset.optionIndex);
              moveItem(q.options_json, optIndex, optIndex - 1);
              renderQuestionList();
              renderPreview();
              return;
            }

            if (action === "option-down"){
              const optIndex = Number(btn.dataset.optionIndex);
              moveItem(q.options_json, optIndex, optIndex + 1);
              renderQuestionList();
              renderPreview();
            }
          });
        }

        function bindQuestionTypeButtons(){
          document.querySelectorAll("#screen-forms [data-question-type]").forEach(btn => {
            btn.addEventListener("click", function(){
              if (!state.currentForm) state.currentForm = blankForm();
              state.currentForm.questions.push(blankQuestion(btn.dataset.questionType));
              renderQuestionList();
              renderPreview();
            });
          });
        }

        async function createNewFormFlow(){
          state.currentForm = blankForm();
          renderEditor();
          setStep("setup");
          setSavePill("Ready");
          showBuilder();
        }

        function bindGeneralActions(){
          $("formsCreateBtn").addEventListener("click", createNewFormFlow);

          $("formsBackBtn").addEventListener("click", function(){
            showHome();
            loadForms();
          });

          document.querySelectorAll("#formsStatusTabs [data-status]").forEach(btn => {
            btn.addEventListener("click", async function(){
              state.statusFilter = btn.dataset.status || "draft";
              renderHomeTabs();
              await loadForms();
            });
          });

          $("formsListBox").addEventListener("click", async function(e){
            const btn = e.target.closest("[data-form-action]");
            if (!btn) return;

            const action = btn.dataset.formAction;
            const formId = btn.dataset.formId;
            if (!formId) return;

            if (action === "open" || action === "edit"){
              await openForm(formId);
              return;
            }

            if (action === "delete"){
              const yes = confirm("Delete this form?");
              if (!yes) return;

              try{
                setSavePill("Deleting...", "warn");
                await invokeFormsManager({
                  action: "delete_form",
                  form_id: formId,
                  ...getActorPayload()
                });
                await loadForms();
                setSavePill("Deleted");
              }catch(err){
                console.error(err);
                setSavePill(err.message || "Delete failed", "error");
                alert(err.message || "Could not delete form.");
              }
            }
          });

          $("formsContinueToQuestionsBtn").addEventListener("click", async function(){
            try{
              setSavePill("Saving setup...", "warn");
              await saveSetupOnly();
              await loadForms();
              setStep("questions");
              setSavePill("Setup saved");
            } catch (err) {
              console.error(err);
              setSavePill(err.message || "Could not save setup", "error");
              alert(err.message || "Could not save setup.");
            }
          });

          $("formsBackToSetupBtn").addEventListener("click", function(){
            setStep("setup");
          });

          $("formsContinueToPreviewBtn").addEventListener("click", async function(){
            try{
              if (!(state.currentForm?.questions || []).length){
                alert("Add at least one question before preview.");
                return;
              }

              setSavePill("Saving questions...", "warn");
              await saveFormWithQuestions();
              await loadForms();
              renderPreview();
              setStep("preview");
              setSavePill("Questions saved");
            } catch (err) {
              console.error(err);
              setSavePill(err.message || "Could not save questions", "error");
              alert(err.message || "Could not save questions.");
            }
          });

          $("formsBackToQuestionsBtn").addEventListener("click", function(){
            setStep("questions");
          });

          $("formsSaveDraftBtn").addEventListener("click", saveDraft);
          $("formsPublishBtn").addEventListener("click", publishForm);
          $("formsPublishBottomBtn").addEventListener("click", publishForm);
        }

        async function init(){
          state.sb = createClientSafe();
          state.session = getAdminSession();

          if (!state.sb){
            $("formsListBox").innerHTML = `<div class="forms-empty">Supabase client is not ready on this page.</div>`;
            return;
          }

          if (!state.session){
            $("formsListBox").innerHTML = `<div class="forms-empty">Admin session not found. Sign in again.</div>`;
            return;
          }

          bindGeneralActions();
          attachSetupInputs();
          bindQuestionInputs();
          bindQuestionTypeButtons();

          renderHomeTabs();
          renderEditor();
          showHome();
          await loadForms();
        }

        if (document.readyState === "loading"){
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
  </div>
</section>
