<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --bg:#eef4ff;
      --card:#ffffff;
      --line:#e5e7eb;
      --muted:#6b7280;
      --text:#111827;
      --soft-blue:#eff6ff;
      --shadow:0 12px 28px rgba(15,23,42,.08);
      --radius:24px;
    }

    *{ box-sizing:border-box; }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:radial-gradient(circle at top, #e7f0ff, #ffffff 60%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      background:#fff;
      padding:calc(env(safe-area-inset-top) + 10px) 14px 96px;
      position:relative;
    }

    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:10px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .brand-logo{
      width:36px;
      height:36px;
      border-radius:12px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      box-shadow:var(--shadow);
    }

    .brand-logo svg{
      width:18px;
      height:18px;
    }

    .brand-name{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.02em;
    }

    .avatar-chip{
      width:40px;
      height:40px;
      border-radius:999px;
      border:none;
      background:linear-gradient(135deg,#1d4ed8,#22c55e);
      color:#fff;
      font-weight:800;
      box-shadow:var(--shadow);
      cursor:pointer;
    }

    main{
      -ms-overflow-style:none;
      scrollbar-width:none;
    }

    main::-webkit-scrollbar{
      width:0;height:0;display:none;
    }

    .hero{
      margin:4px 2px 16px;
    }

    .hero-line{
      font-size:12px;
      color:var(--muted);
      margin-bottom:4px;
      font-weight:600;
    }

    .hero-title{
      font-size:24px;
      line-height:1.18;
      font-weight:800;
      letter-spacing:-.03em;
      margin:0 0 8px;
    }

    .hero-title span{
      color:var(--blue);
    }

    .hero-sub{
      font-size:13px;
      line-height:1.45;
      color:var(--muted);
      margin-bottom:14px;
    }

    .cta{
      width:100%;
      border:none;
      border-radius:999px;
      padding:13px 16px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
      transition:transform .05s ease;
    }

    .cta:active,.quick-card:active,.mini-btn:active,.nav-btn:active{
      transform:scale(.98);
    }

    .cta.primary{
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      box-shadow:var(--shadow);
    }

    .cta.secondary{
      margin-top:10px;
      background:#f8fbff;
      border:1px solid #dbeafe;
      color:var(--blue);
    }

    .cta svg,.quick-card svg,.nav-btn svg,.icon-btn svg{
      width:18px;
      height:18px;
      flex-shrink:0;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
      margin:16px 2px 4px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px 13px;
      box-shadow:0 8px 24px rgba(15,23,42,.05);
    }

    .stat-value{
      font-size:22px;
      font-weight:800;
      line-height:1;
      margin-bottom:6px;
    }

    .stat-label{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      font-weight:800;
      letter-spacing:.06em;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin:20px 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:15px;
      font-weight:800;
      letter-spacing:-.02em;
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:20px;
      padding:14px;
      box-shadow:0 10px 30px rgba(15,23,42,.06);
      margin:0 2px 14px;
    }

    .quick-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .quick-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px 10px;
      text-align:left;
      cursor:pointer;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .quick-icon{
      width:40px;
      height:40px;
      border-radius:14px;
      background:var(--soft-blue);
      color:var(--blue);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .quick-text strong{
      display:block;
      font-size:13px;
      line-height:1.2;
    }

    .quick-text span{
      display:block;
      margin-top:4px;
      color:var(--muted);
      font-size:11px;
      line-height:1.3;
    }

    .hidden{
      display:none !important;
    }

    .field{
      margin-bottom:12px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:700;
      color:#334155;
      margin-bottom:6px;
    }

    .input,.textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:14px;
      padding:12px 13px;
      background:#fff;
      font-size:14px;
      color:var(--text);
      outline:none;
    }

    .textarea{
      min-height:96px;
      resize:vertical;
    }

    .locked-box{
      width:100%;
      border-radius:14px;
      padding:12px 13px;
      border:1px dashed #bfdbfe;
      background:#f8fbff;
      color:var(--blue-dark);
      font-size:14px;
      font-weight:700;
    }

    .generated-box{
      display:none;
      margin-top:12px;
      border-radius:16px;
      border:1px dashed #bfdbfe;
      background:#f8fbff;
      padding:12px;
    }

    .generated-item + .generated-item{
      margin-top:10px;
    }

    .generated-label{
      font-size:10px;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.08em;
      margin-bottom:5px;
    }

    .generated-value{
      background:#fff;
      border:1px solid var(--line);
      border-radius:12px;
      padding:10px 12px;
      font-size:13px;
      font-weight:700;
      word-break:break-word;
    }

    .btn-row{
      display:flex;
      gap:10px;
      margin-top:12px;
    }

    .mini-btn{
      flex:1;
      border:none;
      border-radius:999px;
      padding:12px 14px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
    }

    .mini-btn.primary{
      color:#fff;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      box-shadow:var(--shadow);
    }

    .mini-btn.secondary{
      color:var(--text);
      background:#fff;
      border:1px solid var(--line);
    }

    .mini-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .message{
      display:none;
      margin-top:12px;
      padding:11px 12px;
      border-radius:14px;
      font-size:13px;
      line-height:1.45;
    }

    .message.success{
      display:block;
      background:#ecfdf5;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .history-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .history-card{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .history-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      margin-bottom:8px;
    }

    .history-title{
      font-size:14px;
      font-weight:800;
      line-height:1.2;
    }

    .history-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.35;
      margin-top:3px;
    }

    .pill{
      flex-shrink:0;
      border-radius:999px;
      padding:5px 10px;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:#eff6ff;
      color:var(--blue);
    }

    .empty{
      font-size:13px;
      color:var(--muted);
      text-align:center;
      padding:16px 8px;
    }

    .top-tools{
      display:flex;
      justify-content:flex-end;
      margin-bottom:8px;
    }

    .icon-btn{
      width:38px;
      height:38px;
      border-radius:12px;
      border:1px solid var(--line);
      background:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      color:var(--text);
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 28px);
      max-width:392px;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(16px);
      border:1px solid rgba(229,231,235,.9);
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      border-radius:26px;
      padding:8px 8px 10px;
      display:flex;
      justify-content:space-between;
      z-index:30;
    }

    .nav-btn{
      flex:1;
      border:none;
      background:transparent;
      color:#94a3b8;
      text-align:center;
      font-size:11px;
      cursor:pointer;
      padding-top:2px;
    }

    .nav-btn.active{
      color:var(--blue);
      font-weight:800;
    }

    .nav-inner{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:3px;
    }

    @media (max-width:360px){
      .btn-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 5h12v14H6z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="avatar-chip" id="avatarChip">H</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-line" id="schoolNameText">School</div>
        <h1 class="hero-title">
          Manage your<br><span>school dashboard</span>
        </h1>
        <div class="hero-sub">
          Create HOD accounts, send announcements, and monitor your school activity.
        </div>

        <button class="cta primary" id="openHodShortcut">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
          </svg>
          <span>Create new HOD account</span>
        </button>

        <button class="cta secondary" id="openAnnouncementShortcut">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M22 2L11 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
          <span>Send announcement</span>
        </button>
      </section>

      <div class="top-tools">
        <button class="icon-btn" id="refreshBtn" type="button" aria-label="Refresh dashboard">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M20 11a8 8 0 10-2.34 5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M20 4v7h-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-value" id="totalHodCount">--</div>
          <div class="stat-label">HODs</div>
        </div>

        <div class="stat-card">
          <div class="stat-value" id="totalStudentCount">--</div>
          <div class="stat-label">Students</div>
        </div>

        <div class="stat-card">
          <div class="stat-value" id="totalLecturerCount">--</div>
          <div class="stat-label">Lecturers</div>
        </div>

        <div class="stat-card">
          <div class="stat-value" id="totalAnnouncementCount">--</div>
          <div class="stat-label">Announcements</div>
        </div>
      </section>

      <div class="section-head">
        <div class="section-title">Shortcuts</div>
      </div>

      <section class="card">
        <div class="quick-grid">
          <button class="quick-card" id="openHodShortcutCard" type="button">
            <div class="quick-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="quick-text">
              <strong>Create HOD</strong>
              <span>Open the HOD form</span>
            </div>
          </button>

          <button class="quick-card" id="openAnnouncementShortcutCard" type="button">
            <div class="quick-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M22 2L11 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="quick-text">
              <strong>Announcement</strong>
              <span>Open announcement form</span>
            </div>
          </button>
        </div>
      </section>

      <div class="section-head hidden" id="hodSectionHead">
        <div class="section-title">Create HOD account</div>
      </div>

      <section class="card hidden" id="hodSection">
        <div class="field">
          <label for="hodFullName">Full name</label>
          <input id="hodFullName" class="input" placeholder="Enter HOD full name">
        </div>

        <div class="field">
          <label for="hodDepartment">Department</label>
          <input id="hodDepartment" class="input" placeholder="Enter department">
        </div>

        <div class="field">
          <label>School</label>
          <div class="locked-box" id="lockedSchoolName">-</div>
        </div>

        <div class="generated-box" id="createdHodBox">
          <div class="generated-item">
            <div class="generated-label">Generated login ID</div>
            <div class="generated-value" id="createdHodLoginId">-</div>
          </div>
          <div class="generated-item">
            <div class="generated-label">Temporary password</div>
            <div class="generated-value" id="createdHodPassword">-</div>
          </div>
        </div>

        <div class="btn-row">
          <button class="mini-btn primary" id="createHodBtn" type="button">Create HOD</button>
          <button class="mini-btn secondary" id="clearHodFormBtn" type="button">Clear</button>
        </div>

        <div class="message" id="hodMessage"></div>
      </section>

      <div class="section-head hidden" id="announcementSectionHead">
        <div class="section-title">Send announcement</div>
      </div>

      <section class="card hidden" id="announcementSection">
        <div class="field">
          <label for="announcementTitle">Title</label>
          <input id="announcementTitle" class="input" placeholder="Announcement title">
        </div>

        <div class="field">
          <label for="announcementBody">Message</label>
          <textarea id="announcementBody" class="textarea" placeholder="Write your school-wide announcement here..."></textarea>
        </div>

        <div class="btn-row">
          <button class="mini-btn primary" id="sendAnnouncementBtn" type="button">Send</button>
          <button class="mini-btn secondary" id="clearAnnouncementBtn" type="button">Clear</button>
        </div>

        <div class="message" id="announcementMessageBox"></div>
      </section>

      <div class="section-head">
        <div class="section-title">Last 2 HOD history</div>
      </div>

      <section class="card">
        <div class="history-list" id="hodHistoryList">
          <div class="empty">Loading...</div>
        </div>
      </section>

      <div class="section-head">
        <div class="section-title">Last 2 announcement history</div>
      </div>

      <section class="card">
        <div class="history-list" id="announcementHistoryList">
          <div class="empty">Loading...</div>
        </div>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 01-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 014.5 19v-8.25z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Home</span>
      </span>
    </button>

    <button class="nav-btn" type="button" id="navOpenHod">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        </svg>
        <span>HOD</span>
      </span>
    </button>

    <button class="nav-btn" type="button" id="navOpenAnnouncement">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M22 2L11 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <span>Alert</span>
      </span>
    </button>

    <button class="nav-btn" type="button" id="logoutBtn">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 17l5-5-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M13 4H6a2 2 0 00-2 2v12a2 2 0 002 2h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>Logout</span>
      </span>
    </button>
  </nav>

  <script>
    const SUPABASE_URL = "YOUR_SUPABASE_URL";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";

    const EDGE = {
      createHod: "hos-create-hod-account",
      sendAnnouncement: "hos-send-announcement"
    };

    const TABLES = {
      hod: "hod_accounts",
      students: "student_accounts",
      lecturers: "lecturer_accounts",
      announcements: "school_announcements"
    };

    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let adminSession = null;
    let currentSchoolName = "";
    let lastCreatedHodLoginId = "";
    let lastCreatedHodPassword = "";

    function $(id){
      return document.getElementById(id);
    }

    function escapeHtml(value){
      return String(value || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#39;");
    }

    function formatDate(value){
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function copyText(text, successText){
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        alert(successText || "Copied");
      }).catch(() => {
        alert("Could not copy. Please copy manually.");
      });
    }

    function getAdminSession(){
      try{
        return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
      }catch{
        return null;
      }
    }

    function requireHosSession(){
      adminSession = getAdminSession();

      if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
        window.location.href = "index.html";
        return false;
      }

      currentSchoolName =
        adminSession.school_name ||
        adminSession.school ||
        adminSession.schoolName ||
        "";

      $("schoolNameText").textContent = currentSchoolName || "School not found";
      $("lockedSchoolName").textContent = currentSchoolName || "-";

      const initial = (adminSession.full_name || "H")
        .trim()
        .charAt(0)
        .toUpperCase() || "H";

      $("avatarChip").textContent = initial;
      return true;
    }

    async function invokeEdge(functionName, body){
      const { data, error } = await sb.functions.invoke(functionName, {
        body: body || {}
      });

      if (error){
        throw new Error((data && data.error) || error.message || "Request failed.");
      }

      return data || {};
    }

    async function countFromTable(table, schoolName){
      let query = sb.from(table).select("*", { count:"exact", head:true });

      if (schoolName){
        query = query.eq("school_name", schoolName);
      }

      const { count, error } = await query;
      if (error) throw error;
      return count || 0;
    }

    async function fetchRows(table, schoolName, limit = 2){
      let query = sb.from(table).select("*");

      if (schoolName){
        query = query.eq("school_name", schoolName);
      }

      const { data, error } = await query
        .order("created_at", { ascending:false })
        .limit(limit);

      if (error) throw error;
      return Array.isArray(data) ? data : [];
    }

    function renderHodHistory(rows){
      const wrap = $("hodHistoryList");
      if (!wrap) return;

      if (!rows.length){
        wrap.innerHTML = '<div class="empty">No HOD history yet.</div>';
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.full_name || "-")}</div>
              <div class="history-sub">${escapeHtml(item.department || item.department_name || "No department")}</div>
            </div>
            <div class="pill">HOD</div>
          </div>
          <div class="history-sub">Login ID: ${escapeHtml(item.login_id || "-")}</div>
          <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
        </div>
      `).join("");
    }

    function renderAnnouncementHistory(rows){
      const wrap = $("announcementHistoryList");
      if (!wrap) return;

      if (!rows.length){
        wrap.innerHTML = '<div class="empty">No announcement history yet.</div>';
        return;
      }

      wrap.innerHTML = rows.map((item) => `
        <div class="history-card">
          <div class="history-top">
            <div>
              <div class="history-title">${escapeHtml(item.title || "Untitled announcement")}</div>
              <div class="history-sub">${escapeHtml((item.message || item.body || "").slice(0, 140) || "-")}</div>
            </div>
            <div class="pill">School</div>
          </div>
          <div class="history-sub">Created: ${escapeHtml(formatDate(item.created_at))}</div>
        </div>
      `).join("");
    }

    async function loadDashboardData(){
      const school = currentSchoolName || "";

      $("totalHodCount").textContent = "--";
      $("totalStudentCount").textContent = "--";
      $("totalLecturerCount").textContent = "--";
      $("totalAnnouncementCount").textContent = "--";

      try{
        const [
          totalHod,
          totalStudents,
          totalLecturers,
          totalAnnouncements,
          hodHistory,
          announcementHistory
        ] = await Promise.all([
          countFromTable(TABLES.hod, school),
          countFromTable(TABLES.students, school),
          countFromTable(TABLES.lecturers, school),
          countFromTable(TABLES.announcements, school),
          fetchRows(TABLES.hod, school, 2),
          fetchRows(TABLES.announcements, school, 2)
        ]);

        $("totalHodCount").textContent = String(totalHod);
        $("totalStudentCount").textContent = String(totalStudents);
        $("totalLecturerCount").textContent = String(totalLecturers);
        $("totalAnnouncementCount").textContent = String(totalAnnouncements);

        renderHodHistory(hodHistory);
        renderAnnouncementHistory(announcementHistory);
      }catch(err){
        console.error(err);
        $("totalHodCount").textContent = "0";
        $("totalStudentCount").textContent = "0";
        $("totalLecturerCount").textContent = "0";
        $("totalAnnouncementCount").textContent = "0";
        renderHodHistory([]);
        renderAnnouncementHistory([]);
      }
    }

    function showMessage(id, text, type){
      const box = $(id);
      if (!box) return;

      box.textContent = text || "";
      box.className = "message";

      if (text){
        box.classList.add(type === "error" ? "error" : "success");
      }
    }

    function showHodForm(){
      $("hodSectionHead").classList.remove("hidden");
      $("hodSection").classList.remove("hidden");
      $("announcementSectionHead").classList.add("hidden");
      $("announcementSection").classList.add("hidden");
      $("hodSection").scrollIntoView({ behavior:"smooth", block:"start" });
    }

    function showAnnouncementForm(){
      $("announcementSectionHead").classList.remove("hidden");
      $("announcementSection").classList.remove("hidden");
      $("hodSectionHead").classList.add("hidden");
      $("hodSection").classList.add("hidden");
      $("announcementSection").scrollIntoView({ behavior:"smooth", block:"start" });
    }

    async function createHodAccount(){
      const fullName = ($("hodFullName").value || "").trim();
      const department = ($("hodDepartment").value || "").trim();

      showMessage("hodMessage", "", "");

      if (!fullName){
        showMessage("hodMessage", "Please enter the full name.", "error");
        return;
      }

      if (!department){
        showMessage("hodMessage", "Please enter the department.", "error");
        return;
      }

      const btn = $("createHodBtn");
      btn.disabled = true;

      try{
        const result = await invokeEdge(EDGE.createHod, {
          full_name: fullName,
          department,
          school_name: currentSchoolName,
          hos_admin_id: adminSession.id || null
        });

        if (!result.ok){
          throw new Error(result.error || "Could not create HOD account.");
        }

        const hod = result.hod_account || result.hod || {};
        lastCreatedHodLoginId = hod.login_id || result.login_id || "";
        lastCreatedHodPassword = result.temporary_password || result.password || "";

        $("createdHodLoginId").textContent = lastCreatedHodLoginId || "-";
        $("createdHodPassword").textContent = lastCreatedHodPassword || "-";
        $("createdHodBox").style.display = "block";

        showMessage("hodMessage", "HOD account created successfully.", "success");

        $("hodFullName").value = "";
        $("hodDepartment").value = "";

        await loadDashboardData();
      }catch(err){
        console.error(err);
        showMessage("hodMessage", err.message || "Could not create HOD account.", "error");
      }finally{
        btn.disabled = false;
      }
    }

    function clearHodForm(){
      $("hodFullName").value = "";
      $("hodDepartment").value = "";
      $("createdHodBox").style.display = "none";
      $("createdHodLoginId").textContent = "-";
      $("createdHodPassword").textContent = "-";
      lastCreatedHodLoginId = "";
      lastCreatedHodPassword = "";
      showMessage("hodMessage", "", "");
    }

    async function sendAnnouncement(){
      const title = ($("announcementTitle").value || "").trim();
      const message = ($("announcementBody").value || "").trim();

      showMessage("announcementMessageBox", "", "");

      if (!title){
        showMessage("announcementMessageBox", "Please enter the announcement title.", "error");
        return;
      }

      if (!message){
        showMessage("announcementMessageBox", "Please enter the announcement message.", "error");
        return;
      }

      const btn = $("sendAnnouncementBtn");
      btn.disabled = true;

      try{
        const result = await invokeEdge(EDGE.sendAnnouncement, {
          title,
          message,
          school_name: currentSchoolName,
          hos_admin_id: adminSession.id || null
        });

        if (!result.ok){
          throw new Error(result.error || "Could not send announcement.");
        }

        showMessage("announcementMessageBox", "Announcement sent successfully.", "success");
        $("announcementTitle").value = "";
        $("announcementBody").value = "";

        await loadDashboardData();
      }catch(err){
        console.error(err);
        showMessage("announcementMessageBox", err.message || "Could not send announcement.", "error");
      }finally{
        btn.disabled = false;
      }
    }

    function clearAnnouncementForm(){
      $("announcementTitle").value = "";
      $("announcementBody").value = "";
      showMessage("announcementMessageBox", "", "");
    }

    function logoutAdmin(){
      localStorage.removeItem("colspot_admin_session");
      localStorage.removeItem("colspot_pending_admin");
      window.location.href = "index.html";
    }

    document.addEventListener("DOMContentLoaded", async () => {
      if (!requireHosSession()) return;

      $("refreshBtn").addEventListener("click", loadDashboardData);
      $("createHodBtn").addEventListener("click", createHodAccount);
      $("clearHodFormBtn").addEventListener("click", clearHodForm);
      $("sendAnnouncementBtn").addEventListener("click", sendAnnouncement);
      $("clearAnnouncementBtn").addEventListener("click", clearAnnouncementForm);
      $("logoutBtn").addEventListener("click", logoutAdmin);

      $("openHodShortcut").addEventListener("click", showHodForm);
      $("openAnnouncementShortcut").addEventListener("click", showAnnouncementForm);
      $("openHodShortcutCard").addEventListener("click", showHodForm);
      $("openAnnouncementShortcutCard").addEventListener("click", showAnnouncementForm);
      $("navOpenHod").addEventListener("click", showHodForm);
      $("navOpenAnnouncement").addEventListener("click", showAnnouncementForm);

      $("avatarChip").addEventListener("click", () => {
        if (lastCreatedHodLoginId) {
          copyText(lastCreatedHodLoginId, "Last login ID copied");
        }
      });

      await loadDashboardData();
    });
  </script>
</body>
</html>
