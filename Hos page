      } catch {
        return null;
      }
    })();

    if (!hosSession || String(hosSession.role || "").toLowerCase() !== "hos") {
      window.location.href = "index.html";
    }

    const schoolName = hosSession?.school_name || "Ekiti State University";
    const fullName = hosSession?.full_name || "Head of School";

    const state = {
