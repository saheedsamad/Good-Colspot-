(function () {
  if (window.__formsBackendSystemInitializedV3) return;
  window.__formsBackendSystemInitializedV3 = true;

  const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
  const SUPABASE_ANON_KEY = "YOUR_ANON_KEY_HERE";
  const FORMS_FUNCTION = "forms-manager";
  const LEVEL_OPTIONS = ["100", "200", "300", "400", "500", "600", "700"];

  const state = {
    sb: null,
    session: null,
    statusFilter: "draft",
    currentStep: "setup",
    forms: [],
    programmes: [],
    loadingList: false,
    currentForm: null,
    pickerSearch: "",
    pickerSelectedMap: {},
  };

  function $(id) {
    return document.getElementById(id);
  }

  function escapeHtml(value) {
    return String(value || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function uid(prefix) {
    return `${prefix}_${Math.random().toString(36).slice(2, 10)}_${Date.now().toString(36)}`;
  }

  function normalizeText(value) {
    return String(value || "").trim().replace(/\s+/g, " ");
  }

  function createClientSafe() {
    try {
      if (window.supabase && typeof window.supabase.createClient === "function") {
        return window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      }
    } catch (err) {
      console.error("Forms supabase init failed:", err);
    }
    return null;
  }

  function getAdminSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function getActorPayload() {
    const session = state.session || {};
    const account = session.account || {};
    const role = session.role || account.role || "";

    if (role === "hos") {
      return { hos_admin_id: account.id || session.id || "" };
    }
    if (role === "form_agent") {
      return { form_agent_id: account.id || session.id || "" };
    }
    return { hos_admin_id: account.id || session.id || "" };
  }

  function ensureIdentityModeOptions() {
    const select = $("formIdentityMode");
    if (!select) return;

    const current = (select.value || "auto").toLowerCase();
    select.innerHTML = `
      <option value="auto">Use logged-in identity</option>
      <option value="anonymous">Anonymous</option>
    `;

    select.value = current === "anonymous" ? "anonymous" : "auto";
  }

  function blankForm() {
    return {
      id: null,
      title: "",
      description: "",
      audience_mode: "all_students",
      target_audience: "all_students",
      programme_targets: [],
      open_at: "",
      close_at: "",
      response_rule: "one",
      identity_mode: "auto",
      status: "draft",
      questions: [],
    };
  }

  function blankQuestion(type) {
    const q = {
      local_id: uid("q"),
      id: null,
      question_text: "",
      question_type: type,
      help_text: "",
      placeholder_text: "",
      is_required: false,
      options_json: [],
      allowed_file_types: [],
      max_file_size_mb: 5,
      max_files: 1,
      section_name: "",
      sort_order: 0,
    };

    if (["multiple_choice", "checkboxes", "dropdown"].includes(type)) {
      q.options_json = ["", ""];
    }

    if (type === "yes_no") {
      q.options_json = ["Yes", "No"];
    }

    return q;
  }

  function formatDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return value;
    return d.toLocaleDateString();
  }

  function getQuestionTypeLabel(type) {
    const map = {
      short_answer: "Short Answer",
      paragraph: "Paragraph",
      multiple_choice: "Multiple Choice",
      checkboxes: "Checkboxes",
      dropdown: "Dropdown",
      date: "Date",
      file_upload: "File Upload",
      yes_no: "Yes / No",
    };
    return map[type] || type;
  }

  function getAudienceLabel(form) {
    return (form.audience_mode || "") === "programme_filter"
      ? "FILTER BY PROGRAMME"
      : "ALL STUDENTS";
