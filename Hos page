          forms: [],
          currentForm: null,
          loadingList: false,
          loadingForm: false,
          saving: false
        };

        function $(id){ return document.getElementById(id); }

        function escapeHtml(value){
          return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
        }

        function uid(prefix){
          return prefix + "_" + Math.random().toString(36).slice(2,10) + "_" + Date.now().toString(36);
        }

        function createClientSafe(){
          try{
            if (window.supabase && typeof window.supabase.createClient === "function") {
              return window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            }
          }catch(err){
            console.error("Forms supabase init failed:", err);
          }
          return null;
        }

        function getAdminSession(){
          try{
            return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
          }catch{
            return null;
          }
        }

        function getActorPayload(){
          const session = state.session || {};
          const account = session.account || {};
          const role = session.role || account.role || "";

          if (role === "hos") {
            return {
              hos_admin_id: account.id || session.id || ""
            };
          }

          if (role === "form_agent") {
            return {
              form_agent_id: account.id || session.id || ""
            };
          }

          return {
            hos_admin_id: account.id || session.id || ""
          };
        }

        function setSavePill(text, type){
          const pill = $("formsSavePill");
          pill.className = "save-pill" + (type ? " " + type : "");
          pill.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>${escapeHtml(text)}</span>
          `;
        }

        function showHome(){
          $("formsHomeView").classList.remove("forms-hidden");
          $("formsBuilderView").classList.add("forms-hidden");
        }

        function showBuilder(){
          $("formsHomeView").classList.add("forms-hidden");
          $("formsBuilderView").classList.remove("forms-hidden");
        }

        function setStep(step){
          state.currentStep = step;

          $("formsStageSetup").classList.toggle("forms-hidden", step !== "setup");
          $("formsStageQuestions").classList.toggle("forms-hidden", step !== "questions");
          $("formsStagePreview").classList.toggle("forms-hidden", step !== "preview");

          $("stepChipSetup").className = "forms-step" + (step === "setup" ? " active" : (step === "questions" || step === "preview" ? " done" : ""));
          $("stepChipQuestions").className = "forms-step" + (step === "questions" ? " active" : (step === "preview" ? " done" : ""));
          $("stepChipPreview").className = "forms-step" + (step === "preview" ? " active" : "");
        }

        function formatDate(value){
          if (!value) return "—";
          const d = new Date(value);
          if (Number.isNaN(d.getTime())) return value;
          return d.toLocaleDateString();
        }

        function getAudienceLabel(value){
          const map = {
            all_students: "All Students",
            all_staff: "All Staff",
            lecturers: "Lecturers",
            department_students: "Department Students",
            specific_group: "Specific Group"
          };
          return map[value] || value || "Audience";
        }

        function getQuestionTypeLabel(type){
          const map = {
            short_answer: "Short Answer",
            paragraph: "Paragraph",
            multiple_choice: "Multiple Choice",
            checkboxes: "Checkboxes",
            dropdown: "Dropdown",
            date: "Date",
            file_upload: "File Upload",
            yes_no: "Yes / No"
          };
          return map[type] || type;
        }

        function blankForm(){
          return {
            id: null,
            title: "",
            description: "",
            target_audience: "all_students",
            open_at: "",
            close_at: "",
            response_rule: "one",
            identity_mode: "auto",
            status: "draft",
            questions: []
          };
        }

        function blankQuestion(type){
          const q = {
            local_id: uid("q"),
            question_text: "",
            question_type: type,
            help_text: "",
            placeholder_text: "",
            is_required: false,
            options_json: [],
            allowed_file_types: [],
            max_file_size_mb: 5,
            max_files: 1,
            section_name: "",
            sort_order: 0
          };

          if (type === "multiple_choice" || type === "checkboxes" || type === "dropdown") {
            q.options_json = ["", ""];
          }

          if (type === "yes_no") {
            q.options_json = ["Yes", "No"];
          }

          return q;
        }

        function loadFormIntoEditor(form, questions){
          state.currentForm = {
            id: form?.id || null,
            title: form?.title || "",
            description: form?.description || "",
            target_audience: form?.target_audience || "all_students",
            open_at: form?.open_at ? String(form.open_at).slice(0,10) : "",
            close_at: form?.close_at ? String(form.close_at).slice(0,10) : "",
            response_rule: form?.response_rule || "one",
            identity_mode: form?.identity_mode || "auto",
            status: form?.status || "draft",
            questions: Array.isArray(questions) ? questions.map((q, i) => ({
              local_id: q.id || uid("q"),
              id: q.id || null,
              question_text: q.question_text || "",
              question_type: q.question_type || "short_answer",
              help_text: q.help_text || "",
              placeholder_text: q.placeholder_text || "",
              is_required: !!q.is_required,
              options_json: Array.isArray(q.options_json) ? q.options_json : [],
              allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types : [],
              max_file_size_mb: Number(q.max_file_size_mb || 5),
              max_files: Number(q.max_files || 1),
              section_name: q.section_name || "",
              sort_order: Number.isFinite(Number(q.sort_order)) ? Number(q.sort_order) : (i + 1)
            })) : []
          };

          renderEditor();
        }

        function renderEditor(){
          const form = state.currentForm || blankForm();

          $("formTitleInput").value = form.title || "";
          $("formDescriptionInput").value = form.description || "";
          $("formTargetAudience").value = form.target_audience || "all_students";
          $("formOpenDateInput").value = form.open_at || "";
          $("formCloseDateInput").value = form.close_at || "";
          $("formResponseRule").value = form.response_rule || "one";
          $("formIdentityMode").value = form.identity_mode || "auto";

          renderQuestionList();
          renderPreview();
        }

        function renderHomeTabs(){
          document.querySelectorAll("#formsStatusTabs [data-status]").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.status === state.statusFilter);
          });
        }

        function renderFormsList(){
          const box = $("formsListBox");

          if (state.loadingList){
            box.innerHTML = `<div class="forms-empty">Loading forms...</div>`;
            return;
          }

          const items = (state.forms || []).filter(item => item.status === state.statusFilter);

          if (!items.length){
            box.innerHTML = `<div class="forms-empty">No ${escapeHtml(state.statusFilter)} forms yet.</div>`;
            return;
          }

          box.innerHTML = items.map(form => `
            <div class="form-item">
              <div class="form-item-head">
                <div>
                  <h4 class="form-item-title">${escapeHtml(form.title || "Untitled Form")}</h4>
                  <p class="form-item-desc">${escapeHtml(form.description || "No description yet.")}</p>
                </div>
                <span class="status-pill ${escapeHtml(form.status || "draft")}">${escapeHtml(form.status || "draft")}</span>
              </div>

              <div class="form-item-meta">
                <span class="meta-chip">${Number(form.question_count || 0)} Questions</span>
                <span class="meta-chip">${escapeHtml(getAudienceLabel(form.target_audience))}</span>
                <span class="meta-chip">Updated ${escapeHtml(formatDate(form.updated_at || form.created_at))}</span>
              </div>

              <div class="form-item-actions">
                <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
                <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
                <button type="button" class="forms-mini-btn red" data-form-action="delete" data-form-id="${form.id}">Delete</button>
              </div>
            </div>
          `).join("");
        }

        function renderQuestionList(){
          const list = $("formsQuestionList");
          const empty = $("formsQuestionEmpty");
          const form = state.currentForm || blankForm();
          const questions = Array.isArray(form.questions) ? form.questions : [];

          if (!questions.length){
            list.innerHTML = "";
            empty.classList.remove("forms-hidden");
            return;
          }

          empty.classList.add("forms-hidden");

          list.innerHTML = questions.map((q, index) => {
            const supportsOptions = ["multiple_choice","checkboxes","dropdown"].includes(q.question_type);
            const isFile = q.question_type === "file_upload";
            const isYesNo = q.question_type === "yes_no";

            return `
              <div class="question-card" data-question-id="${q.local_id}">
                <div class="question-card-head">
                  <div class="question-head-left">
                    <div class="question-number">${index + 1}</div>
                    <div>
                      <div class="question-title-static">${escapeHtml(q.question_text || "Untitled Question")}</div>
                      <div class="question-type-static">${escapeHtml(getQuestionTypeLabel(q.question_type))}</div>
