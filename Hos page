  function setSavePill(text, type) {
    const pill = $("formsSavePill");
    if (!pill) return;
    pill.className = "save-pill" + (type ? " " + type : "");
    pill.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>${escapeHtml(text)}</span>
    `;
  }

  function setButtonLoading(button, loadingText, isLoading) {
    if (!button) return;
    const textNode = button.querySelector(".btn-text") || button;

    if (!button.dataset.defaultText) {
      button.dataset.defaultText = textNode.textContent.trim();
    }

    if (isLoading) {
      button.disabled = true;
      button.style.opacity = "0.7";
      textNode.textContent = loadingText;
    } else {
      button.disabled = false;
      button.style.opacity = "";
      textNode.textContent = button.dataset.defaultText || textNode.textContent;
    }
  }

  function showHome() {
    $("formsHomeView")?.classList.remove("forms-hidden");
    $("formsBuilderView")?.classList.add("forms-hidden");
  }

  function showBuilder() {
    $("formsHomeView")?.classList.add("forms-hidden");
    $("formsBuilderView")?.classList.remove("forms-hidden");
  }

  function setStep(step) {
    state.currentStep = step;

    $("formsStageSetup")?.classList.toggle("forms-hidden", step !== "setup");
    $("formsStageQuestions")?.classList.toggle("forms-hidden", step !== "questions");
    $("formsStagePreview")?.classList.toggle("forms-hidden", step !== "preview");

    $("stepChipSetup").className =
      "forms-step" + (step === "setup" ? " active" : step === "questions" || step === "preview" ? " done" : "");
    $("stepChipQuestions").className =
      "forms-step" + (step === "questions" ? " active" : step === "preview" ? " done" : "");
    $("stepChipPreview").className = "forms-step" + (step === "preview" ? " active" : "");
  }

  async function invokeFormsManager(body) {
    if (!state.sb) throw new Error("Supabase is not ready.");
    const { data, error } = await state.sb.functions.invoke(FORMS_FUNCTION, { body });
    if (error) throw new Error(error.message || "Request failed.");
    if (!data?.ok) throw new Error(data?.error || "Request failed.");
    return data;
  }

  function ensureCurrentForm() {
    if (!state.currentForm) state.currentForm = blankForm();
  }

  function getFormQuestions() {
    ensureCurrentForm();
    if (!Array.isArray(state.currentForm.questions)) {
      state.currentForm.questions = [];
    }
    return state.currentForm.questions;
  }

  function getFormProgrammeTargets() {
    ensureCurrentForm();
    if (!Array.isArray(state.currentForm.programme_targets)) {
      state.currentForm.programme_targets = [];
    }
    return state.currentForm.programme_targets;
  }

  async function loadProgrammes() {
    const listBox = $("programmeListBox");
    try {
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">Loading programmes...</div>`;
      }

      const { data, error } = await state.sb
        .from("programmes")
        .select("id, programme_name")
        .eq("is_active", true)
        .order("programme_name", { ascending: true });

      if (error) throw error;

      state.programmes = Array.isArray(data) ? data : [];
      renderProgrammePickerList();
    } catch (err) {
      console.error("Load programmes error:", err);
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load programmes.")}</div>`;
      }
    }
  }

  function renderProgrammePickerList() {
    const listBox = $("programmeListBox");
    if (!listBox) return;

    const search = normalizeText(state.pickerSearch).toUpperCase();
    const items = (state.programmes || []).filter((item) => {
      if (!search) return true;
      return String(item.programme_name || "").includes(search);
    });

    if (!items.length) {
      listBox.innerHTML = `<div class="forms-empty">No programme found.</div>`;
      return;
    }

    listBox.innerHTML = items
      .map((item) => {
        const checked = !!state.pickerSelectedMap[item.programme_name];
        return `
          <label class="question-card" style="cursor:pointer;">
            <div class="question-card-body" style="grid-template-columns:1fr auto; display:grid; align-items:center;">
              <div><div class="question-title-static">${escapeHtml(item.programme_name)}</div></div>
              <input type="checkbox" data-programme-pick="${escapeHtml(item.programme_name)}" ${checked ? "checked" : ""}>
            </div>
          </label>
        `;
      })
      .join("");
  }

  function openProgrammePicker() {
    const modal = $("programmePickerModal");
    if (!modal) return;

    const currentTargets = getFormProgrammeTargets();
    state.pickerSelectedMap = {};
    currentTargets.forEach((item) => {
      state.pickerSelectedMap[item.programme_name] = true;
    });

    state.pickerSearch = "";
    if ($("programmeSearchInput")) $("programmeSearchInput").value = "";
    renderProgrammePickerList();
    modal.classList.remove("forms-hidden");
  }

  function closeProgrammePicker() {
    $("programmePickerModal")?.classList.add("forms-hidden");
  }

  function applyProgrammePickerSelection() {
    ensureCurrentForm();

    const currentTargets = getFormProgrammeTargets();
    const preserved = {};
    currentTargets.forEach((item) => {
      preserved[item.programme_name] = Array.isArray(item.levels) ? item.levels.slice() : [];
    });

    const nextTargets = Object.keys(state.pickerSelectedMap)
      .filter((name) => !!state.pickerSelectedMap[name])
      .sort((a, b) => a.localeCompare(b))
      .map((name) => ({
        programme_name: name,
        levels: preserved[name] || [],
      }));

    state.currentForm.programme_targets = nextTargets;
    renderProgrammeTargets();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
    closeProgrammePicker();
  }

  function removeProgramme(programmeName) {
    ensureCurrentForm();
    state.currentForm.programme_targets = getFormProgrammeTargets().filter(
      (item) => item.programme_name !== programmeName
    );
    renderProgrammeTargets();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function toggleProgrammeLevel(programmeName, level) {
    ensureCurrentForm();
    const target = getFormProgrammeTargets().find((item) => item.programme_name === programmeName);
    if (!target) return;

    if (!Array.isArray(target.levels)) target.levels = [];

    if (target.levels.includes(level)) {
      target.levels = target.levels.filter((v) => v !== level);
    } else {
      target.levels.push(level);
      target.levels.sort((a, b) => Number(a) - Number(b));
    }

    renderProgrammeTargets();
    renderPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function renderProgrammeTargets() {
    const wrap = $("programmeTargetWrap");
    const selectedBox = $("selectedProgrammesBox");
    const stack = $("programmeLevelStack");
    const summary = $("targetSummaryText");
    const allMode = $("audienceAllStudents")?.checked;

    if (allMode) {
      wrap?.classList.add("forms-hidden");
      if (summary) summary.textContent = "This form is for all students.";
      return;
    }

    wrap?.classList.remove("forms-hidden");

    const targets = getFormProgrammeTargets();

    if (!targets.length) {
      if (selectedBox) {
        selectedBox.innerHTML = `<div class="forms-empty" style="min-height:100px;">No programme selected yet.</div>`;
      }
      if (stack) stack.innerHTML = "";
      if (summary) summary.textContent = "No programme and level selected yet.";
      return;
    }

    if (selectedBox) {
      selectedBox.innerHTML = targets
        .map(
          (item) => `
          <div class="programme-pill">
            <span>${escapeHtml(item.programme_name)}</span>
            <button type="button" data-remove-programme="${escapeHtml(item.programme_name)}">×</button>
          </div>
        `
        )
        .join("");
    }

    if (stack) {
      stack.innerHTML = targets
        .map(
          (item) => `
          <div class="programme-level-card">
            <div class="programme-level-head">
              <div>
                <div class="programme-level-name">${escapeHtml(item.programme_name)}</div>
                <div class="programme-level-sub">Choose level(s) under this programme.</div>
              </div>
            </div>

            <div class="level-chip-row">
              ${LEVEL_OPTIONS.map(
                (level) => `
                <label class="level-option">
                  <input
                    type="checkbox"
                    data-programme-level-programme="${escapeHtml(item.programme_name)}"
                    data-programme-level-value="${level}"
                    ${Array.isArray(item.levels) && item.levels.includes(level) ? "checked" : ""}
                  >
                  <span class="level-chip">${level}</span>
                </label>
              `
              ).join("")}
            </div>
          </div>
        `
        )
        .join("");
    }

    const filled = targets
      .filter((item) => Array.isArray(item.levels) && item.levels.length)
      .map((item) => `${item.programme_name} (${item.levels.join(", ")})`);

    if (summary) {
      summary.textContent = filled.length
        ? filled.join(" • ")
        : "Programme selected, but no level chosen yet.";
    }
  }

  function patchQuestionHeader(questionId) {
    const question = getFormQuestions().find((q) => q.local_id === questionId);
    const card = document.querySelector(`.question-card[data-question-id="${CSS.escape(questionId)}"]`);
    if (!question || !card) return;

    const titleNode = card.querySelector(".question-title-static");
    const typeNode = card.querySelector(".question-type-static");

    if (titleNode) {
      titleNode.textContent = question.question_text || "Untitled Question";
    }
    if (typeNode) {
      typeNode.textContent = getQuestionTypeLabel(question.question_type);
    }
  }

  function patchPreviewMeta() {
    const form = state.currentForm || blankForm();
    $("studentPreviewTitle").textContent = form.title || "Untitled Form";
    $("studentPreviewDescription").textContent = form.description || "Form description will appear here.";
  }

  function loadFormIntoEditor(form, questions) {
    state.currentForm = {
      id: form?.id || null,
      title: form?.title || "",
      description: form?.description || "",
      audience_mode: form?.audience_mode || (form?.programme_targets?.length ? "programme_filter" : "all_students"),
      target_audience: form?.target_audience || "all_students",
      programme_targets: Array.isArray(form?.programme_targets)
        ? form.programme_targets.map((item) => ({
            programme_name: item.programme_name || "",
            levels: Array.isArray(item.levels) ? item.levels : [],
          }))
        : [],
      open_at: form?.open_at ? String(form.open_at).slice(0, 10) : "",
      close_at: form?.close_at ? String(form.close_at).slice(0, 10) : "",
      response_rule: form?.response_rule || "one",
      identity_mode: form?.identity_mode === "anonymous" ? "anonymous" : "auto",
      status: form?.status || "draft",
      questions: Array.isArray(questions)
        ? questions.map((q, i) => ({
            local_id: q.id || uid("q"),
            id: q.id || null,
            question_text: q.question_text || "",
            question_type: q.question_type || "short_answer",
            help_text: q.help_text || "",
            placeholder_text: q.placeholder_text || "",
            is_required: !!q.is_required,
            options_json: Array.isArray(q.options_json) ? q.options_json : [],
            allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types : [],
            max_file_size_mb: Number(q.max_file_size_mb || 5),
            max_files: Number(q.max_files || 1),
            section_name: q.section_name || "",
            sort_order: Number.isFinite(Number(q.sort_order)) ? Number(q.sort_order) : i + 1,
          }))
        : [],
    };

    renderEditor();
  }

  function renderEditor() {
    ensureCurrentForm();
    const form = state.currentForm;

    $("formTitleInput").value = form.title || "";
    $("formDescriptionInput").value = form.description || "";
    $("formOpenDateInput").value = form.open_at || "";
    $("formCloseDateInput").value = form.close_at || "";
    $("formResponseRule").value = form.response_rule || "one";

    ensureIdentityModeOptions();
    $("formIdentityMode").value = form.identity_mode === "anonymous" ? "anonymous" : "auto";

    if ((form.audience_mode || "all_students") === "programme_filter") {
      $("audienceProgrammeFilter").checked = true;
      $("audienceAllStudents").checked = false;
    } else {
      $("audienceAllStudents").checked = true;
      $("audienceProgrammeFilter").checked = false;
    }

    renderProgrammeTargets();
    renderQuestionList();
    renderPreview();
  }

  function renderHomeTabs() {
    document.querySelectorAll("#formsStatusTabs [data-status]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.status === state.statusFilter);
    });
  }

  function renderFormsList() {
    const box = $("formsListBox");

    if (state.loadingList) {
      box.innerHTML = `<div class="forms-empty">Loading forms...</div>`;
      return;
    }

    const items = (state.forms || []).filter((item) => item.status === state.statusFilter);

    if (!items.length) {
      box.innerHTML = `<div class="forms-empty">No ${escapeHtml(state.statusFilter)} forms yet.</div>`;
      return;
    }

    box.innerHTML = items
      .map(
        (form) => `
        <div class="form-item">
          <div class="form-item-head">
            <div>
              <h4 class="form-item-title">${escapeHtml(form.title || "Untitled Form")}</h4>
              <p class="form-item-desc">${escapeHtml(form.description || "No description yet.")}</p>
            </div>
            <span class="status-pill ${escapeHtml(form.status || "draft")}">${escapeHtml(form.status || "draft")}</span>
          </div>

          <div class="form-item-meta">
            <span class="meta-chip">${Number(form.question_count || 0)} Questions</span>
            <span class="meta-chip">${escapeHtml(getAudienceLabel(form))}</span>
            <span class="meta-chip">Updated ${escapeHtml(formatDate(form.updated_at || form.created_at))}</span>
          </div>

          <div class="form-item-actions">
            <button type="button" class="forms-mini-btn" data-form-action="open" data-form-id="${form.id}">Open</button>
            <button type="button" class="forms-mini-btn gray" data-form-action="edit" data-form-id="${form.id}">Edit</button>
            <button type="button" class="forms-mini-btn red" data-form-action="delete" data-form-id="${form.id}">Delete</button>
          </div>
        </div>
      `
      )
      .join("");
  }

  function renderQuestionList() {
    const list = $("formsQuestionList");
    const empty = $("formsQuestionEmpty");
    const questions = getFormQuestions();

    if (!questions.length) {
      list.innerHTML = "";
      empty.classList.remove("forms-hidden");
      return;
    }

    empty.classList.add("forms-hidden");

    list.innerHTML = questions
      .map((q, index) => {
        const supportsOptions = ["multiple_choice", "checkboxes", "dropdown"].includes(q.question_type);
        const isFile = q.question_type === "file_upload";

        return `
          <div class="question-card" data-question-id="${q.local_id}">
            <div class="question-card-head">
              <div class="question-head-left">
                <div class="question-number">${index + 1}</div>
                <div>
                  <div class="question-title-static">${escapeHtml(q.question_text || "Untitled Question")}</div>
                  <div class="question-type-static">${escapeHtml(getQuestionTypeLabel(q.question_type))}</div>
                </div>
              </div>

              <div class="question-head-right">
                <label class="toggle-wrap">
                  <span>Required</span>
                  <span class="switch">
                    <input type="checkbox" data-question-action="toggle-required" data-question-id="${q.local_id}" ${q.is_required ? "checked" : ""}>
                    <span class="slider"></span>
                  </span>
                </label>

                <button type="button" class="icon-btn" data-question-action="move-up" data-question-id="${q.local_id}" title="Move Up">↑</button>
                <button type="button" class="icon-btn" data-question-action="move-down" data-question-id="${q.local_id}" title="Move Down">↓</button>
                <button type="button" class="icon-btn" data-question-action="duplicate" data-question-id="${q.local_id}" title="Duplicate">⧉</button>
                <button type="button" class="icon-btn" data-question-action="delete" data-question-id="${q.local_id}" title="Delete">✕</button>
              </div>
            </div>

            <div class="question-card-body">
              <div class="question-grid-2">
                <div class="forms-field">
                  <label>Question Title</label>
                  <input
                    class="forms-input"
                    type="text"
                    value="${escapeHtml(q.question_text || "")}"
                    data-question-input="question_text"
                    data-question-id="${q.local_id}"
                    placeholder="Enter your question here."
                  >
                </div>

                <div class="forms-field">
                  <label>Question Type</label>
                  <select class="forms-select" data-question-input="question_type" data-question-id="${q.local_id}">
                    <option value="short_answer" ${q.question_type === "short_answer" ? "selected" : ""}>Short Answer</option>
                    <option value="paragraph" ${q.question_type === "paragraph" ? "selected" : ""}>Paragraph</option>
                    <option value="multiple_choice" ${q.question_type === "multiple_choice" ? "selected" : ""}>Multiple Choice</option>
                    <option value="checkboxes" ${q.question_type === "checkboxes" ? "selected" : ""}>Checkboxes</option>
                    <option value="dropdown" ${q.question_type === "dropdown" ? "selected" : ""}>Dropdown</option>
                    <option value="date" ${q.question_type === "date" ? "selected" : ""}>Date</option>
                    <option value="file_upload" ${q.question_type === "file_upload" ? "selected" : ""}>File Upload</option>
                    <option value="yes_no" ${q.question_type === "yes_no" ? "selected" : ""}>Yes / No</option>
                  </select>
                </div>
              </div>

              <div class="forms-field">
                <label>Help Text</label>
                <input
                  class="forms-input"
                  type="text"
                  value="${escapeHtml(q.help_text || "")}"
                  data-question-input="help_text"
                  data-question-id="${q.local_id}"
                  placeholder="Optional helper text."
                >
              </div>

              ${!isFile ? `
                <div class="forms-field">
                  <label>Placeholder</label>
                  <input
                    class="forms-input"
                    type="text"
                    value="${escapeHtml(q.placeholder_text || "")}"
                    data-question-input="placeholder_text"
                    data-question-id="${q.local_id}"
                    placeholder="Optional placeholder."
                  >
                </div>
              ` : ""}

              ${
                supportsOptions
                  ? `
                <div class="forms-field">
                  <label>Options</label>
                  <div class="options-list">
                    ${(q.options_json || [])
                      .map(
                        (opt, optIndex) => `
                      <div class="option-row">
                        <div class="option-badge">${optIndex + 1}</div>
                        <input
                          class="forms-input"
                          type="text"
                          value="${escapeHtml(opt || "")}"
                          data-question-input="option"
                          data-question-id="${q.local_id}"
                          data-option-index="${optIndex}"
                          placeholder="Option text"
                        >
                        <div class="option-actions">
                          <button type="button" class="icon-btn" data-question-action="remove-option" data-question-id="${q.local_id}" data-option-index="${optIndex}">✕</button>
                        </div>
                      </div>
                    `
                      )
                      .join("")}
                  </div>
                  <div class="question-footer" style="margin-top:10px;">
                    <div class="question-footer-left">
                      <button type="button" class="forms-mini-btn" data-question-action="add-option" data-question-id="${q.local_id}">
                        Add Option
                      </button>
                    </div>
                  </div>
                </div>
              `
                  : ""
              }

              ${
                isFile
                  ? `
                <div class="question-grid-2">
                  <div class="forms-field">
                    <label>Allowed File Types</label>
                    <input
                      class="forms-input"
                      type="text"
                      value="${escapeHtml((q.allowed_file_types || []).join(", "))}"
                      data-question-input="allowed_file_types"
                      data-question-id="${q.local_id}"
                      placeholder="pdf, jpg, png"
                    >
                  </div>
                  <div class="forms-field">
                    <label>Max Upload</label>
                    <input
                      class="forms-input"
                      type="number"
                      min="1"
                      value="${Number(q.max_files || 1)}"
                      data-question-input="max_files"
                      data-question-id="${q.local_id}"
                    >
                  </div>
                </div>
              `
                  : ""
              }
            </div>
          </div>
        `;
      })
      .join("");
