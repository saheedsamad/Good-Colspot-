    const card = document.querySelector(`.question-card[data-question-id="${questionId}"]`);
    if (!question || !card) return;

    const titleNode = card.querySelector(".question-title-static");
    const typeNode = card.querySelector(".question-type-static");

    if (titleNode) {
      titleNode.textContent = question.question_text || "Untitled Question";
    }
    if (typeNode) {
      typeNode.textContent = getQuestionTypeLabel(question.question_type);
    }
  }

  function patchPreviewMeta() {
    const form = state.currentForm || blankForm();
    if ($("studentPreviewTitle")) $("studentPreviewTitle").textContent = form.title || "Untitled Form";
    if ($("studentPreviewDescription")) {
      $("studentPreviewDescription").textContent = form.description || "Form description will appear here.";
    }
  }

  function loadFormIntoEditor(form, questions) {
    state.currentForm = {
      id: form?.id || null,
      title: form?.title || "",
      description: form?.description || "",
      audience_mode: form?.audience_mode || (form?.programme_targets?.length ? "programme_filter" : "all_students"),
      target_audience: form?.target_audience || "all_students",
      programme_targets: Array.isArray(form?.programme_targets)
        ? form.programme_targets.map((item) => ({
            programme_name: item.programme_name || "",
            levels: Array.isArray(item.levels) ? item.levels.map((v) => String(v)) : [],
          }))
        : [],
      open_at: form?.open_at ? String(form.open_at).slice(0, 10) : "",
      close_at: form?.close_at ? String(form.close_at).slice(0, 10) : "",
      response_rule: form?.response_rule || "one",
      identity_mode: form?.identity_mode === "anonymous" ? "anonymous" : "auto",
      status: form?.status || "draft",
      notification_title: form?.notification_title || "",
      notification_body: form?.notification_body || "",
      questions: Array.isArray(questions)
        ? questions.map((q, i) => ({
            local_id: q.id || uid("q"),
            id: q.id || null,
            question_text: q.question_text || "",
            question_type: q.question_type || "short_answer",
            help_text: q.help_text || "",
            placeholder_text: q.placeholder_text || "",
            is_required: !!q.is_required,
            options_json: Array.isArray(q.options_json) ? q.options_json.slice() : [],
            allowed_file_types: Array.isArray(q.allowed_file_types) ? q.allowed_file_types.slice() : [],
            max_file_size_mb: Number(q.max_file_size_mb || 5),
            max_files: Number(q.max_files || 1),
            section_name: q.section_name || "",
            sort_order: Number.isFinite(Number(q.sort_order)) ? Number(q.sort_order) : i + 1,
          }))
        : [],
    };

    renderEditor();
    refreshMatchedStudentsPreview();
  }

  function renderEditor() {
    ensureCurrentForm();
    const form = state.currentForm;

    if ($("formTitleInput")) $("formTitleInput").value = form.title || "";
    if ($("formDescriptionInput")) $("formDescriptionInput").value = form.description || "";
    if ($("formOpenDateInput")) $("formOpenDateInput").value = form.open_at || "";
    if ($("formCloseDateInput")) $("formCloseDateInput").value = form.close_at || "";
    if ($("formResponseRule")) $("formResponseRule").value = form.response_rule || "one";

    ensureIdentityModeOptions();
    if ($("formIdentityMode")) {
      $("formIdentityMode").value = form.identity_mode === "anonymous" ? "anonymous" : "auto";
    }

    if ((form.audience_mode || "all_students") === "programme_filter") {
      if ($("audienceProgrammeFilter")) $("audienceProgrammeFilter").checked = true;
      if ($("audienceAllStudents")) $("audienceAllStudents").checked = false;
    } else {
      if ($("audienceAllStudents")) $("audienceAllStudents").checked = true;
      if ($("audienceProgrammeFilter")) $("audienceProgrammeFilter").checked = false;
    }

    if ($("announcementTitleInput")) {
      $("announcementTitleInput").value = form.notification_title || "";
    }
    if ($("announcementBodyInput")) {
      $("announcementBodyInput").value = form.notification_body || "";
      updateAnnouncementBodyCount();
    }

    renderProgrammeTargets();
    renderQuestionList();
    renderPreview();
    renderAnnouncementPreview();
  }

