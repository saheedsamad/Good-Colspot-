    if (!button.dataset.defaultText) {
      button.dataset.defaultText = textNode.textContent.trim();
    }

    if (isLoading) {
      button.disabled = true;
      button.style.opacity = "0.7";
      textNode.textContent = loadingText;
    } else {
      button.disabled = false;
      button.style.opacity = "";
      textNode.textContent = button.dataset.defaultText || textNode.textContent;
    }
  }

  function showHome() {
    $("formsHomeView")?.classList.remove("forms-hidden");
    $("formsBuilderView")?.classList.add("forms-hidden");
  }

  function showBuilder() {
    $("formsHomeView")?.classList.add("forms-hidden");
    $("formsBuilderView")?.classList.remove("forms-hidden");
  }

  function setStep(step) {
    state.currentStep = step;

    $("formsStageSetup")?.classList.toggle("forms-hidden", step !== "setup");
    $("formsStageQuestions")?.classList.toggle("forms-hidden", step !== "questions");
    $("formsStagePreview")?.classList.toggle("forms-hidden", step !== "preview");
    $("formsStageAnnouncement")?.classList.toggle("forms-hidden", step !== "announcement");

    const setupChip = $("stepChipSetup");
    const questionsChip = $("stepChipQuestions");
    const previewChip = $("stepChipPreview");
    const announcementChip = $("stepChipAnnouncement");

    if (setupChip) {
      setupChip.className = "forms-step" + (
        step === "setup" ? " active" :
        ["questions", "preview", "announcement"].includes(step) ? " done" : ""
      );
    }

    if (questionsChip) {
      questionsChip.className = "forms-step" + (
        step === "questions" ? " active" :
        ["preview", "announcement"].includes(step) ? " done" : ""
      );
    }

    if (previewChip) {
      previewChip.className = "forms-step" + (
        step === "preview" ? " active" :
        step === "announcement" ? " done" : ""
      );
    }

    if (announcementChip) {
      announcementChip.className = "forms-step" + (step === "announcement" ? " active" : "");
    }

    renderAnnouncementPreview();
  }

  async function invokeFormsManager(body) {
    if (!state.sb) throw new Error("Supabase is not ready.");

    console.log("FORMS BODY SENT:", JSON.stringify(body, null, 2));

    const { data, error } = await state.sb.functions.invoke(FORMS_FUNCTION, { body });

    console.log("FORMS RAW DATA:", data);
    console.log("FORMS RAW ERROR:", error);

    if (error) throw new Error(error.message || "Request failed.");
    if (!data?.ok) throw new Error(data?.error || "Request failed.");
    return data;
  }

  function ensureCurrentForm() {
    if (!state.currentForm) state.currentForm = blankForm();
  }

  function getFormQuestions() {
    ensureCurrentForm();
    if (!Array.isArray(state.currentForm.questions)) {
      state.currentForm.questions = [];
    }
    return state.currentForm.questions;
  }

  function getFormProgrammeTargets() {
    ensureCurrentForm();
    if (!Array.isArray(state.currentForm.programme_targets)) {
      state.currentForm.programme_targets = [];
    }
    return state.currentForm.programme_targets;
  }

  async function loadProgrammes() {
    const listBox = $("programmeListBox");
    try {
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">Loading programmes...</div>`;
      }

      const { data, error } = await state.sb
        .from("programmes")
        .select("id, programme_name")
        .eq("is_active", true)
        .order("programme_name", { ascending: true });

      if (error) throw error;

      state.programmes = Array.isArray(data) ? data : [];
      renderProgrammePickerList();
    } catch (err) {
      console.error("Load programmes error:", err);
      if (listBox) {
        listBox.innerHTML = `<div class="forms-empty">${escapeHtml(err.message || "Could not load programmes.")}</div>`;
      }
    }
  }

  function renderProgrammePickerList() {
    const listBox = $("programmeListBox");
    if (!listBox) return;

    const search = normalizeUpper(state.pickerSearch);
    const items = (state.programmes || []).filter((item) => {
      const name = normalizeUpper(item.programme_name || "");
      return !search || name.includes(search);
    });

    if (!items.length) {
      listBox.innerHTML = `<div class="forms-empty">No programme found.</div>`;
      return;
    }

    listBox.innerHTML = items.map((item) => {
      const programmeName = String(item.programme_name || "");
      const checked = !!state.pickerSelectedMap[programmeName];

      return `
        <label class="question-card" style="cursor:pointer;">
          <div class="question-card-body" style="display:grid; grid-template-columns:1fr auto; align-items:center;">
            <div>
              <div class="question-title-static">${escapeHtml(programmeName)}</div>
            </div>
            <input type="checkbox" data-programme-pick="${escapeHtml(programmeName)}" ${checked ? "checked" : ""}>
          </div>
        </label>
      `;
    }).join("");
  }

  function openProgrammePicker() {
    const modal = $("programmePickerModal");
    if (!modal) return;

    state.pickerSelectedMap = {};
    getFormProgrammeTargets().forEach((item) => {
      state.pickerSelectedMap[item.programme_name] = true;
    });

    state.pickerSearch = "";
    if ($("programmeSearchInput")) $("programmeSearchInput").value = "";
    renderProgrammePickerList();
    modal.classList.remove("forms-hidden");
  }

  function closeProgrammePicker() {
    $("programmePickerModal")?.classList.add("forms-hidden");
  }

  function applyProgrammePickerSelection() {
    ensureCurrentForm();

    const currentTargets = getFormProgrammeTargets();
    const preserved = {};
    currentTargets.forEach((item) => {
      preserved[item.programme_name] = Array.isArray(item.levels) ? item.levels.slice() : [];
    });

    const nextTargets = Object.keys(state.pickerSelectedMap)
      .filter((name) => !!state.pickerSelectedMap[name])
      .sort((a, b) => a.localeCompare(b))
      .map((name) => ({
        programme_name: name,
        levels: preserved[name] || [],
      }));

    state.currentForm.programme_targets = nextTargets;
    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function removeProgramme(programmeName) {
    ensureCurrentForm();
    state.currentForm.programme_targets = getFormProgrammeTargets().filter(
      (item) => item.programme_name !== programmeName
    );
    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function toggleProgrammeLevel(programmeName, level) {
    ensureCurrentForm();
    const target = getFormProgrammeTargets().find((item) => item.programme_name === programmeName);
    if (!target) return;

    if (!Array.isArray(target.levels)) target.levels = [];

    if (target.levels.includes(level)) {
      target.levels = target.levels.filter((v) => v !== level);
    } else {
      target.levels.push(level);
      target.levels.sort((a, b) => Number(a) - Number(b));
    }

    renderProgrammeTargets();
    renderPreview();
    renderAnnouncementPreview();
    setSavePill("Unsaved changes", "warn");
  }

  function renderProgrammeTargets() {
    const wrap = $("programmeTargetWrap");
    const selectedBox = $("selectedProgrammesBox");
    const stack = $("programmeLevelStack");
    const summary = $("targetSummaryText");
    const allMode = $("audienceAllStudents")?.checked;

    if (allMode) {
      wrap?.classList.add("forms-hidden");
      if (summary) summary.textContent = "This form is for all students.";
      updateAudienceMatchedCountUI();
      return;
    }

    wrap?.classList.remove("forms-hidden");

    const targets = getFormProgrammeTargets();

    if (!targets.length) {
      if (selectedBox) {
        selectedBox.innerHTML = `<div class="forms-empty" style="min-height:100px;">No programme selected yet.</div>`;
      }
      if (stack) stack.innerHTML = "";
      if (summary) summary.textContent = "No programme and level selected yet.";
      updateAudienceMatchedCountUI();
      return;
    }

    if (selectedBox) {
      selectedBox.innerHTML = targets.map((item) => `
        <div class="programme-pill">
          <span>${escapeHtml(item.programme_name)}</span>
          <button type="button" data-remove-programme="${escapeHtml(item.programme_name)}">×</button>
        </div>
      `).join("");
    }

    if (stack) {
      stack.innerHTML = targets.map((item) => `
        <div class="programme-level-card">
          <div class="programme-level-head">
            <div>
              <div class="programme-level-name">${escapeHtml(item.programme_name)}</div>
              <div class="programme-level-sub">Choose level(s) under this programme.</div>
            </div>
          </div>

          <div class="level-chip-row">
            ${LEVEL_OPTIONS.map((level) => `
              <label class="level-option">
                <input
                  type="checkbox"
                  data-programme-level-programme="${escapeHtml(item.programme_name)}"
                  data-programme-level-value="${level}"
                  ${Array.isArray(item.levels) && item.levels.includes(level) ? "checked" : ""}
                >
                <span class="level-chip">${level}</span>
              </label>
            `).join("")}
          </div>
        </div>
      `).join("");
    }

    const filled = targets
      .filter((item) => Array.isArray(item.levels) && item.levels.length)
      .map((item) => `${item.programme_name} (${item.levels.join(", ")})`);

    if (summary) {
      summary.textContent = filled.length
        ? filled.join(" • ")
        : "Programme selected, but no level chosen yet.";
    }

    updateAudienceMatchedCountUI();
  }

  function updateAudienceMatchedCountUI() {
    const counter = $("announcementMatchedCount");
    const audienceLabel = $("announcementAudienceText");
    if (audienceLabel) audienceLabel.textContent = buildTargetSummaryText();

    if (counter) {
      const count = Array.isArray(state.matchedStudentsPreview) ? state.matchedStudentsPreview.length : 0;
      counter.textContent = String(count);
    }
  }

  function buildTargetSummaryText() {
    ensureCurrentForm();
    const form = state.currentForm;

    if ((form.audience_mode || "all_students") !== "programme_filter") {
      return "All students";
    }

    const targets = Array.isArray(form.programme_targets) ? form.programme_targets : [];
    const filled = targets
      .filter((item) => Array.isArray(item.levels) && item.levels.length)
      .map((item) => `${item.programme_name} (${item.levels.join(", ")})`);

    return filled.length ? filled.join(" • ") : "Programme selected, but no level chosen yet.";
  }

  async function refreshMatchedStudentsPreview() {
    if (!state.sb || !state.currentForm) return;
    try {
      state.announcementLoading = true;
      renderAnnouncementPreview();

      const schoolName = normalizeText((state.session?.account?.school_name || state.session?.school_name || ""));
      if (!schoolName) {
        state.matchedStudentsPreview = [];
        renderAnnouncementPreview();
        return;
      }

      const { data, error } = await state.sb
        .from("student_accounts")
        .select("user_id, full_name, school_name, programme, level");

      if (error) throw error;

      const allStudents = (data || []).filter((row) => {
        return normalizeUpper(row.school_name) === normalizeUpper(schoolName) && !!row.user_id;
      });

      if ((state.currentForm.audience_mode || "all_students") !== "programme_filter") {
        state.matchedStudentsPreview = allStudents;
        renderAnnouncementPreview();
        return;
      }

      const targets = Array.isArray(state.currentForm.programme_targets)
        ? state.currentForm.programme_targets
        : [];

      const matched = allStudents.filter((row) => {
        const programme = normalizeUpper(row.programme);
        const level = normalizeText(String(row.level || "")).replace(/\bLEVEL\b/gi, "").trim();

        return targets.some((target) => {
          const targetProgramme = normalizeUpper(target.programme_name);
          const targetLevels = Array.isArray(target.levels) ? target.levels.map((v) => String(v).trim()) : [];
          return targetProgramme === programme && targetLevels.includes(level);
        });
      });

      state.matchedStudentsPreview = matched;
      renderAnnouncementPreview();
    } catch (err) {
      console.error("Matched students preview error:", err);
      state.matchedStudentsPreview = [];
      renderAnnouncementPreview();
    } finally {
      state.announcementLoading = false;
      renderAnnouncementPreview();
    }
  }

