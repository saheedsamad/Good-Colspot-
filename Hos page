<section id="screen-forms" class="screen">
  <style>
    #screen-forms .forms-shell{
      display:grid;
      gap:18px;
    }

    #screen-forms .forms-toolbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-toolbar-left{
      min-width:0;
    }

    #screen-forms .forms-title{
      margin:0;
      font-size:28px;
      font-weight:900;
      letter-spacing:-.03em;
      color:#0f172a;
    }

    #screen-forms .forms-sub{
      margin:8px 0 0;
      font-size:14px;
      color:var(--muted, #6b7280);
      line-height:1.6;
      max-width:780px;
    }

    #screen-forms .forms-toolbar-right{
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-search{
      width:260px;
      min-width:220px;
      height:48px;
      background:#fff;
      border:1px solid var(--line, #e5e7eb);
      border-radius:16px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
      box-shadow:var(--shadow-soft, 0 10px 25px rgba(37,99,235,.08));
    }

    #screen-forms .forms-search svg{
      width:18px;
      height:18px;
      color:#64748b;
      flex-shrink:0;
    }

    #screen-forms .forms-search input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      font-size:14px;
      color:#0f172a;
    }

    #screen-forms .forms-primary-btn,
    #screen-forms .forms-secondary-btn,
    #screen-forms .forms-danger-btn,
    #screen-forms .forms-soft-btn{
      border:none;
      border-radius:16px;
      min-height:48px;
      padding:0 16px;
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      cursor:pointer;
      transition:.18s ease;
      white-space:nowrap;
    }

    #screen-forms .forms-primary-btn{
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      color:#fff;
      box-shadow:0 16px 30px rgba(37,99,235,.22);
    }

    #screen-forms .forms-secondary-btn{
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-forms .forms-soft-btn{
      background:#fff;
      color:#0f172a;
      border:1px solid var(--line, #e5e7eb);
    }

    #screen-forms .forms-danger-btn{
      background:#fef2f2;
      color:#b91c1c;
      border:1px solid #fecaca;
    }

    #screen-forms .forms-primary-btn svg,
    #screen-forms .forms-secondary-btn svg,
    #screen-forms .forms-danger-btn svg,
    #screen-forms .forms-soft-btn svg{
      width:18px;
      height:18px;
      flex-shrink:0;
    }

    #screen-forms .forms-overview-grid{
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:14px;
    }

    #screen-forms .forms-stat{
      background:#fff;
      border:1px solid var(--line, #e5e7eb);
      border-radius:22px;
      padding:18px;
      min-height:120px;
      box-shadow:var(--shadow-soft, 0 10px 25px rgba(37,99,235,.08));
      position:relative;
      overflow:hidden;
    }

    #screen-forms .forms-stat::after{
      content:"";
      position:absolute;
      right:-18px;
      bottom:-18px;
      width:84px;
      height:84px;
      border-radius:50%;
      background:#eff6ff;
    }

    #screen-forms .forms-stat-label{
      position:relative;
      z-index:1;
      font-size:13px;
      color:#64748b;
      font-weight:700;
      margin-bottom:16px;
    }

    #screen-forms .forms-stat-value{
      position:relative;
      z-index:1;
      font-size:36px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.05em;
      color:#0f172a;
    }

    #screen-forms .forms-stat-note{
      position:relative;
      z-index:1;
      margin-top:8px;
      font-size:12px;
      color:#64748b;
    }

    #screen-forms .forms-main-grid{
      display:grid;
      grid-template-columns:1.02fr 1.3fr;
      gap:18px;
      align-items:start;
    }

    #screen-forms .forms-panel{
      background:#fff;
      border:1px solid var(--line, #e5e7eb);
      border-radius:24px;
      box-shadow:var(--shadow-soft, 0 10px 25px rgba(37,99,235,.08));
      overflow:hidden;
    }

    #screen-forms .forms-panel-head{
      padding:18px 20px;
      border-bottom:1px solid var(--line, #e5e7eb);
      background:linear-gradient(180deg,#ffffff 0%, #fafcff 100%);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-panel-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    #screen-forms .forms-panel-sub{
      margin:5px 0 0;
      font-size:13px;
      color:#64748b;
      line-height:1.5;
    }

    #screen-forms .forms-panel-body{
      padding:18px 20px;
    }

    #screen-forms .forms-tabs{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-tab{
      border:none;
      background:#f8fbff;
      color:#334155;
      min-height:40px;
      padding:0 14px;
      border-radius:999px;
      font-size:13px;
      font-weight:800;
      cursor:pointer;
    }

    #screen-forms .forms-tab.active{
      background:#2563eb;
      color:#fff;
    }

    #screen-forms .forms-filter-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-bottom:16px;
    }

    #screen-forms .forms-select,
    #screen-forms .forms-input,
    #screen-forms .forms-textarea{
      width:100%;
      background:#fff;
      color:#0f172a;
      border:1px solid #dbe3ee;
      border-radius:16px;
      outline:none;
      padding:0 14px;
      font-size:14px;
    }

    #screen-forms .forms-select,
    #screen-forms .forms-input{
      min-height:50px;
    }

    #screen-forms .forms-textarea{
      min-height:108px;
      resize:vertical;
      padding:14px;
      line-height:1.6;
    }

    #screen-forms .forms-select:focus,
    #screen-forms .forms-input:focus,
    #screen-forms .forms-textarea:focus{
      border-color:#2563eb;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    #screen-forms .forms-inline-field{
      display:grid;
      gap:8px;
      min-width:0;
      flex:1;
    }

    #screen-forms .forms-inline-label,
    #screen-forms .forms-field label{
      font-size:13px;
      font-weight:800;
      color:#0f172a;
    }

    #screen-forms .forms-field{
      display:grid;
      gap:8px;
    }

    #screen-forms .forms-fields-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    #screen-forms .forms-fields-grid.three{
      grid-template-columns:1fr 1fr 1fr;
    }

    #screen-forms .forms-form-card{
      border:1px solid #e9eef5;
      border-radius:20px;
      padding:16px;
      background:#fff;
      margin-bottom:14px;
    }

    #screen-forms .forms-form-card:last-child{
      margin-bottom:0;
    }

    #screen-forms .forms-form-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:12px;
    }

    #screen-forms .forms-form-name{
      font-size:16px;
      font-weight:900;
      color:#0f172a;
      line-height:1.35;
      margin:0;
    }

    #screen-forms .forms-form-desc{
      font-size:13px;
      color:#64748b;
      line-height:1.5;
      margin:6px 0 0;
    }

    #screen-forms .forms-badges{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:10px;
    }

    #screen-forms .forms-badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:30px;
      padding:0 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-forms .forms-badge.green{
      background:#effdf4;
      color:#15803d;
    }

    #screen-forms .forms-badge.orange{
      background:#fff7ed;
      color:#c2410c;
    }

    #screen-forms .forms-badge.red{
      background:#fef2f2;
      color:#b91c1c;
    }

    #screen-forms .forms-form-meta{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
      margin-top:14px;
    }

    #screen-forms .forms-form-meta-item{
      min-height:52px;
      border:1px solid #edf2f7;
      border-radius:14px;
      background:#fbfdff;
      padding:10px 12px;
    }

    #screen-forms .forms-form-meta-label{
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.06em;
      color:#64748b;
      font-weight:800;
      margin-bottom:4px;
    }

    #screen-forms .forms-form-meta-value{
      font-size:13px;
      color:#0f172a;
      font-weight:700;
      line-height:1.4;
      word-break:break-word;
    }

    #screen-forms .forms-form-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:14px;
    }

    #screen-forms .forms-mini-btn{
      border:none;
      min-height:40px;
      padding:0 14px;
      border-radius:12px;
      font-size:13px;
      font-weight:800;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
    }

    #screen-forms .forms-mini-btn svg{
      width:15px;
      height:15px;
    }

    #screen-forms .forms-mini-btn.blue{
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-forms .forms-mini-btn.green{
      background:#effdf4;
      color:#15803d;
    }

    #screen-forms .forms-mini-btn.orange{
      background:#fff7ed;
      color:#c2410c;
    }

    #screen-forms .forms-mini-btn.red{
      background:#fef2f2;
      color:#b91c1c;
    }

    #screen-forms .forms-mini-btn.dark{
      background:#0f172a;
      color:#fff;
    }

    #screen-forms .forms-builder{
      display:grid;
      gap:18px;
    }

    #screen-forms .forms-builder-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-builder-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    #screen-forms .forms-section-card{
      border:1px solid #e9eef5;
      background:#fbfdff;
      border-radius:22px;
      padding:16px;
    }

    #screen-forms .forms-question-list{
      display:grid;
      gap:16px;
      margin-top:16px;
    }

    #screen-forms .question-card{
      border:1px solid #e5edf7;
      background:#fff;
      border-radius:22px;
      box-shadow:0 10px 24px rgba(15,23,42,.04);
      overflow:hidden;
    }

    #screen-forms .question-head{
      padding:16px 18px;
      border-bottom:1px solid #edf2f7;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      background:linear-gradient(180deg,#ffffff 0%, #fbfdff 100%);
    }

    #screen-forms .question-head-left{
      display:flex;
      align-items:flex-start;
      gap:12px;
      min-width:0;
      flex:1;
    }

    #screen-forms .question-number{
      width:34px;
      height:34px;
      border-radius:12px;
      background:#eff6ff;
      color:#1d4ed8;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:13px;
      font-weight:900;
      flex-shrink:0;
    }

    #screen-forms .question-head-right{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      align-items:center;
    }

    #screen-forms .question-body{
      padding:16px 18px 18px;
      display:grid;
      gap:16px;
    }

    #screen-forms .question-row{
      display:grid;
      gap:14px;
    }

    #screen-forms .question-row.two{
      grid-template-columns:1fr 240px;
    }

    #screen-forms .question-row.three{
      grid-template-columns:1fr 1fr 1fr;
    }

    #screen-forms .required-toggle{
      display:inline-flex;
      align-items:center;
      gap:10px;
      min-height:42px;
      padding:0 12px;
      border-radius:999px;
      background:#f8fbff;
      border:1px solid #e5edf7;
      font-size:13px;
      font-weight:800;
      color:#334155;
    }

    #screen-forms .switch{
      position:relative;
      width:46px;
      height:26px;
      flex-shrink:0;
    }

    #screen-forms .switch input{
      opacity:0;
      width:0;
      height:0;
      position:absolute;
    }

    #screen-forms .slider{
      position:absolute;
      inset:0;
      background:#cbd5e1;
      border-radius:999px;
      transition:.2s ease;
      cursor:pointer;
    }

    #screen-forms .slider::before{
      content:"";
      position:absolute;
      width:20px;
      height:20px;
      left:3px;
      top:3px;
      border-radius:50%;
      background:#fff;
      transition:.2s ease;
      box-shadow:0 2px 8px rgba(0,0,0,.12);
    }

    #screen-forms .switch input:checked + .slider{
      background:#22c55e;
    }

    #screen-forms .switch input:checked + .slider::before{
      transform:translateX(20px);
    }

    #screen-forms .option-list{
      display:grid;
      gap:10px;
    }

    #screen-forms .option-row{
      display:grid;
      grid-template-columns:40px 1fr auto;
      gap:10px;
      align-items:center;
    }

    #screen-forms .option-bullet{
      width:40px;
      height:42px;
      border-radius:12px;
      border:1px solid #e5edf7;
      background:#fbfdff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:12px;
      font-weight:900;
      color:#64748b;
    }

    #screen-forms .option-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    #screen-forms .icon-btn{
      border:none;
      width:40px;
      height:40px;
      border-radius:12px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      background:#f8fbff;
      color:#334155;
      border:1px solid #e5edf7;
    }

    #screen-forms .icon-btn svg{
      width:16px;
      height:16px;
    }

    #screen-forms .question-footer{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
      justify-content:space-between;
    }

    #screen-forms .question-footer-left,
    #screen-forms .question-footer-right{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
    }

    #screen-forms .forms-note{
      padding:14px 16px;
      border-radius:16px;
      background:#eff6ff;
      color:#1d4ed8;
      font-size:13px;
      line-height:1.5;
      border:1px solid #bfdbfe;
    }

    #screen-forms .forms-warning{
      padding:14px 16px;
      border-radius:16px;
      background:#fff7ed;
      color:#c2410c;
      font-size:13px;
      line-height:1.5;
      border:1px solid #fed7aa;
    }

    #screen-forms .forms-danger-note{
      padding:14px 16px;
      border-radius:16px;
      background:#fef2f2;
      color:#b91c1c;
      font-size:13px;
      line-height:1.5;
      border:1px solid #fecaca;
    }

    #screen-forms .student-preview{
      border:1px solid #e5edf7;
      border-radius:22px;
      background:#fff;
      box-shadow:0 10px 24px rgba(15,23,42,.04);
      overflow:hidden;
    }

    #screen-forms .student-preview-head{
      padding:24px 22px 18px;
      border-bottom:1px solid #edf2f7;
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 60%, #60a5fa 100%);
      color:#fff;
    }

    #screen-forms .student-preview-title{
      margin:0;
      font-size:28px;
      font-weight:900;
      letter-spacing:-.03em;
    }

    #screen-forms .student-preview-desc{
      margin:10px 0 0;
      font-size:14px;
      line-height:1.65;
      opacity:.96;
    }

    #screen-forms .student-preview-body{
      padding:20px;
      display:grid;
      gap:16px;
    }

    #screen-forms .student-q{
      border:1px solid #e9eef5;
      border-radius:20px;
      padding:18px;
      background:#fbfdff;
    }

    #screen-forms .student-q-title{
      font-size:15px;
      font-weight:900;
      color:#0f172a;
      line-height:1.45;
      margin:0 0 4px;
    }

    #screen-forms .student-q-help{
      font-size:12px;
      color:#64748b;
      margin-bottom:12px;
      line-height:1.5;
    }

    #screen-forms .student-required{
      color:#dc2626;
      margin-left:4px;
    }

    #screen-forms .student-option-list{
      display:grid;
      gap:10px;
    }

    #screen-forms .student-option{
      display:flex;
      align-items:center;
      gap:10px;
      min-height:44px;
      padding:0 14px;
      border:1px solid #e5edf7;
      border-radius:14px;
      background:#fff;
      color:#0f172a;
      font-size:14px;
    }

    #screen-forms .student-option input{
      accent-color:#2563eb;
    }

    #screen-forms .student-preview-footer{
      padding:0 20px 20px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    #screen-forms .responses-wrap{
      display:grid;
      gap:16px;
    }

    #screen-forms .responses-summary{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
    }

    #screen-forms .responses-stat{
      min-height:96px;
      border-radius:18px;
      border:1px solid #e5edf7;
      background:#fbfdff;
      padding:14px 16px;
    }

    #screen-forms .responses-stat-label{
      font-size:12px;
      color:#64748b;
      font-weight:700;
      margin-bottom:12px;
    }

    #screen-forms .responses-stat-value{
      font-size:28px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.04em;
      color:#0f172a;
    }

    #screen-forms .responses-tools{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    #screen-forms .responses-table-wrap{
      overflow:auto;
      border:1px solid #e5edf7;
      border-radius:20px;
      background:#fff;
    }

    #screen-forms .responses-table{
      width:100%;
      min-width:860px;
      border-collapse:collapse;
    }

    #screen-forms .responses-table th{
      text-align:left;
      font-size:12px;
      color:#64748b;
      font-weight:800;
      padding:14px 16px;
      border-bottom:1px solid #edf2f7;
      background:#fbfdff;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    #screen-forms .responses-table td{
      font-size:13px;
      color:#0f172a;
      padding:14px 16px;
      border-bottom:1px solid #edf2f7;
      vertical-align:top;
      line-height:1.5;
    }

    #screen-forms .responses-table tr:last-child td{
      border-bottom:none;
    }

    #screen-forms .empty-card{
      min-height:180px;
      border:1px dashed #d7e0eb;
      border-radius:20px;
      background:#fbfdff;
      color:#64748b;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:22px;
      font-size:14px;
      line-height:1.6;
    }

    #screen-forms .section-hidden{
      display:none !important;
    }

    #screen-forms .save-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:40px;
      padding:0 12px;
      border-radius:999px;
      background:#effdf4;
      color:#15803d;
      font-size:12px;
      font-weight:800;
      border:1px solid #bbf7d0;
    }

    #screen-forms .save-pill svg{
      width:15px;
      height:15px;
    }

    #screen-forms .question-type-strip{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:10px;
    }

    #screen-forms .type-btn{
      border:none;
      min-height:48px;
      padding:0 12px;
      border-radius:14px;
      background:#f8fbff;
      color:#334155;
      font-size:13px;
      font-weight:800;
      cursor:pointer;
      border:1px solid #e5edf7;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      text-align:center;
    }

    #screen-forms .type-btn svg{
      width:16px;
      height:16px;
      flex-shrink:0;
    }

    #screen-forms .builder-section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      margin-bottom:12px;
    }

    #screen-forms .builder-section-title{
      margin:0;
      font-size:16px;
      font-weight:900;
      color:#0f172a;
      letter-spacing:-.02em;
    }

    #screen-forms .helper-text{
      font-size:12px;
      color:#64748b;
      line-height:1.5;
    }

    #screen-forms .student-success{
      border:1px solid #bbf7d0;
      background:#effdf4;
