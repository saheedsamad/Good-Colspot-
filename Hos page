<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --bg:#eef4ff;
      --card:#ffffff;
      --line:#e5e7eb;
      --muted:#6b7280;
      --text:#111827;
      --soft-blue:#eff6ff;
      --shadow:0 12px 28px rgba(15,23,42,.08);
    }

    *{ box-sizing:border-box; }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:radial-gradient(circle at top, #e7f0ff, #ffffff 60%);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      background:#fff;
      padding:calc(env(safe-area-inset-top) + 10px) 14px 96px;
      position:relative;
    }

    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:10px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .brand-logo{
      width:36px;
      height:36px;
      border-radius:12px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      box-shadow:var(--shadow);
    }

    .brand-logo svg{
      width:18px;
      height:18px;
    }

    .brand-name{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.02em;
    }

    .avatar-chip{
      width:40px;
      height:40px;
      border-radius:999px;
      border:none;
      background:linear-gradient(135deg,#1d4ed8,#22c55e);
      color:#fff;
      font-weight:800;
      box-shadow:var(--shadow);
      cursor:pointer;
    }

    .hero{
      margin:4px 2px 16px;
    }

    .hero-line{
      font-size:12px;
      color:var(--muted);
      margin-bottom:4px;
      font-weight:600;
    }

    .hero-title{
      font-size:24px;
      line-height:1.18;
      font-weight:800;
      letter-spacing:-.03em;
      margin:0 0 8px;
    }

    .hero-title span{
      color:var(--blue);
    }

    .hero-sub{
      font-size:13px;
      line-height:1.45;
      color:var(--muted);
      margin-bottom:14px;
    }

    .top-tools{
      display:flex;
      justify-content:flex-end;
      margin-bottom:8px;
    }

    .icon-btn{
      width:38px;
      height:38px;
      border-radius:12px;
      border:1px solid var(--line);
      background:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      color:var(--text);
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
      margin:16px 2px 4px;
    }

    .stat-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px 13px;
      box-shadow:0 8px 24px rgba(15,23,42,.05);
    }

    .stat-value{
      font-size:22px;
      font-weight:800;
      line-height:1;
      margin-bottom:6px;
    }

    .stat-label{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      font-weight:800;
      letter-spacing:.06em;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin:20px 4px 10px;
    }

    .section-title{
      margin:0;
      font-size:15px;
      font-weight:800;
      letter-spacing:-.02em;
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:20px;
      padding:14px;
      box-shadow:0 10px 30px rgba(15,23,42,.06);
      margin:0 2px 14px;
    }

    .history-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .history-card{
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      background:#fff;
    }

    .history-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      margin-bottom:8px;
    }

    .history-title{
      font-size:14px;
      font-weight:800;
      line-height:1.2;
    }

    .history-sub{
      font-size:12px;
      color:var(--muted);
      line-height:1.35;
      margin-top:3px;
    }

    .pill{
      flex-shrink:0;
      border-radius:999px;
      padding:5px 10px;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:#eff6ff;
      color:var(--blue);
    }

    .empty{
      font-size:13px;
      color:var(--muted);
      text-align:center;
      padding:16px 8px;
    }

    .message{
      display:none;
      margin:0 2px 14px;
      padding:11px 12px;
      border-radius:14px;
      font-size:13px;
      line-height:1.45;
    }

    .message.error{
      display:block;
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 28px);
      max-width:392px;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(16px);
      border:1px solid rgba(229,231,235,.9);
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      border-radius:26px;
      padding:8px 8px 10px;
      display:flex;
      justify-content:space-between;
      z-index:30;
    }

    .nav-btn{
      flex:1;
      border:none;
      background:transparent;
      color:#94a3b8;
      text-align:center;
      font-size:11px;
      cursor:pointer;
      padding-top:2px;
    }

    .nav-btn.active{
      color:var(--blue);
      font-weight:800;
    }

    .nav-inner{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:3px;
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 5h12v14H6z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="avatar-chip" id="avatarChip">H</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-line" id="schoolNameText">School</div>
        <h1 class="hero-title">
          Manage your<br><span>students</span>
        </h1>
        <div class="hero-sub">
          This page is now focused on pulling the student count and student list for the HOS school.
        </div>
      </section>

      <div class="top-tools">
        <button class="icon-btn" id="refreshBtn" type="button" aria-label="Refresh dashboard">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M20 11a8 8 0 10-2.34 5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M20 4v7h-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-value" id="totalStudentCount">--</div>
          <div class="stat-label">Students</div>
        </div>

        <div class="stat-card">
          <div class="stat-value" id="totalStudentShown">--</div>
          <div class="stat-label">Shown</div>
        </div>
      </section>

      <div class="message" id="pageErrorBox"></div>

      <div class="section-head">
        <div class="section-title">Students in this school</div>
      </div>

      <section class="card">
        <div class="history-list" id="studentList">
          <div class="empty">Loading students...</div>
        </div>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" type="button">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 01-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 014.5 19v-8.25z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>Home</span>
      </span>
    </button>

    <button class="nav-btn" type="button" id="logoutBtn">
      <span class="nav-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 17l5-5-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M13 4H6a2 2 0 00-2 2v12a2 2 0 002 2h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>Logout</span>
      </span>
    </button>
  </nav>

  <script>
    (() => {
      const SUPABASE_URL = "YOUR_SUPABASE_URL";
      const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";

      const EDGE = {
        summary: "hos-student-summary"
      };

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      let adminSession = null;
      let currentSchoolName = "";

      function $(id){
        return document.getElementById(id);
      }

      function escapeHtml(value){
        return String(value || "")
          .replaceAll("&","&amp;")
          .replaceAll("<","&lt;")
          .replaceAll(">","&gt;")
          .replaceAll('"',"&quot;")
          .replaceAll("'","&#39;");
      }

      function getAdminSession(){
        try{
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        }catch{
          return null;
        }
      }

      function showPageError(text){
        const box = $("pageErrorBox");
        if (!text){
          box.textContent = "";
          box.className = "message";
          return;
        }
        box.textContent = text;
        box.className = "message error";
      }

      function requireHosSession(){
        adminSession = getAdminSession();

        if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos"){
          window.location.href = "index.html";
          return false;
        }

        currentSchoolName =
          adminSession.school_name ||
          adminSession.school ||
          adminSession.schoolName ||
          "";

        $("schoolNameText").textContent = currentSchoolName || "School not found";

        const initial = (adminSession.full_name || "H")
          .trim()
          .charAt(0)
          .toUpperCase() || "H";

        $("avatarChip").textContent = initial;
        return true;
      }

      async function invokeEdge(functionName, body){
        const { data, error } = await sb.functions.invoke(functionName, {
          body: body || {}
        });

        if (error){
          throw new Error((data && data.error) || error.message || "Request failed.");
        }

        return data || {};
      }

      function renderStudentList(rows){
        const wrap = $("studentList");
        if (!wrap) return;

        if (!rows || !rows.length){
          wrap.innerHTML = '<div class="empty">No students found for this school.</div>';
          return;
        }

        wrap.innerHTML = rows.map((item) => `
          <div class="history-card">
            <div class="history-top">
              <div>
                <div class="history-title">${escapeHtml(item.full_name || "No name")}</div>
                <div class="history-sub">${escapeHtml(item.matric_number || "No matric number")}</div>
              </div>
              <div class="pill">Student</div>
            </div>
            <div class="history-sub">Faculty: ${escapeHtml(item.faculty || "-")}</div>
            <div class="history-sub">Department: ${escapeHtml(item.department || "-")}</div>
            <div class="history-sub">Programme: ${escapeHtml(item.programme || "-")}</div>
            <div class="history-sub">Level: ${escapeHtml(item.level || "-")}</div>
            <div class="history-sub">School: ${escapeHtml(item.school_name || "-")}</div>
          </div>
        `).join("");
      }

      async function loadDashboardData(){
        $("totalStudentCount").textContent = "--";
        $("totalStudentShown").textContent = "--";
        showPageError("");

        try{
          console.log("HOS SESSION:", adminSession);
          console.log("CURRENT SCHOOL:", currentSchoolName);

          const result = await invokeEdge(EDGE.summary, {
            hos_admin_id: adminSession.id,
            school_name: currentSchoolName
          });

          console.log("HOS STUDENT SUMMARY RESULT:", result);

          if (!result.ok){
            throw new Error(result.error || "Could not load student summary.");
          }

          const totals = result.totals || {};
          const students = Array.isArray(result.students) ? result.students : [];

          $("totalStudentCount").textContent = String(totals.students || 0);
          $("totalStudentShown").textContent = String(students.length || 0);

          renderStudentList(students);
        }catch(err){
          console.error(err);
          $("totalStudentCount").textContent = "0";
          $("totalStudentShown").textContent = "0";
          renderStudentList([]);
          showPageError(err.message || "Could not load students.");
        }
      }

      function logoutAdmin(){
        localStorage.removeItem("colspot_admin_session");
        localStorage.removeItem("colspot_pending_admin");
        window.location.href = "index.html";
      }

      document.addEventListener("DOMContentLoaded", async () => {
        if (!requireHosSession()) return;

        $("refreshBtn").addEventListener("click", loadDashboardData);
        $("logoutBtn").addEventListener("click", logoutAdmin);

        await loadDashboardData();
      });
    })();
  </script>
</body>
</html>
