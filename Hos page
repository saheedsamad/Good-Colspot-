  <script>
    (function () {
      if (window.__formsSectionInit) return;
      window.__formsSectionInit = true;

      const STORAGE_KEY = "colspot_forms_agent_workspace_v1";
      const RESPONSES_KEY = "colspot_forms_agent_responses_v1";

      const state = {
        workspaceMode: "builder",
        listFilter: "all",
        searchTerm: "",
        forms: [],
        responses: [],
        activeFormId: null
      };

      function $(id){
        return document.getElementById(id);
      }

      function uid(prefix = "id"){
        return prefix + "_" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
      }

      function escapeHtml(value){
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function nowDate(){
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${day}`;
      }

      function formatDate(value){
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return value;
        return d.toLocaleDateString();
      }

      function formatDateTime(value){
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return value;
        return d.toLocaleString();
      }

      function deepClone(obj){
        return JSON.parse(JSON.stringify(obj));
      }

      function saveWorkspace(){
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          forms: state.forms,
          activeFormId: state.activeFormId
        }));

        const pill = $("formsSaveState");
        if (pill) {
          pill.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Saved</span>
          `;
        }
      }

      function saveResponses(){
        localStorage.setItem(RESPONSES_KEY, JSON.stringify(state.responses));
      }

      function loadWorkspace(){
        try{
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw){
            const parsed = JSON.parse(raw);
            state.forms = Array.isArray(parsed.forms) ? parsed.forms : [];
            state.activeFormId = parsed.activeFormId || null;
          }
        }catch(err){
          console.error("Failed to load forms workspace:", err);
        }

        try{
          const rawResponses = localStorage.getItem(RESPONSES_KEY);
          if (rawResponses){
            const parsedResponses = JSON.parse(rawResponses);
            state.responses = Array.isArray(parsedResponses) ? parsedResponses : [];
          }
        }catch(err){
          console.error("Failed to load form responses:", err);
        }

        if (!state.forms.length){
          const starterForm = createEmptyForm();
          starterForm.title = "New Student Feedback";
          starterForm.description = "Collect feedback from students about the school experience.";
          starterForm.targetAudience = "all_students";
          starterForm.status = "draft";
          starterForm.questions = [
            createQuestion("short_answer"),
            createQuestion("multiple_choice")
          ];
          starterForm.questions[0].title = "Enter your full name";
          starterForm.questions[0].required = true;
          starterForm.questions[0].helpText = "This can also be auto-filled if identity is collected automatically.";

          starterForm.questions[1].title = "How satisfied are you with the school experience?";
          starterForm.questions[1].required = true;
          starterForm.questions[1].options = ["Excellent", "Good", "Average", "Poor"];

          state.forms.push(starterForm);
          state.activeFormId = starterForm.id;
          saveWorkspace();
        }

        if (!state.activeFormId && state.forms.length){
          state.activeFormId = state.forms[0].id;
        }
      }

      function createEmptyForm(){
        return {
          id: uid("form"),
          title: "",
          description: "",
          targetAudience: "all_students",
          status: "draft",
          openDate: nowDate(),
          closeDate: "",
          responseRule: "one",
          identityMode: "auto",
          questions: [],
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString()
        };
      }

      function createQuestion(type = "short_answer"){
        const base = {
          id: uid("q"),
          type,
          title: "",
          helpText: "",
          placeholder: "",
          required: false,
          options: [],
          fileTypes: "pdf,image",
          maxFileSize: "5MB",
          maxFiles: 1
        };

        if (type === "multiple_choice"){
          base.title = "New multiple choice question";
          base.options = ["Option 1", "Option 2"];
        } else if (type === "checkboxes"){
          base.title = "New checkbox question";
          base.options = ["Option 1", "Option 2"];
        } else if (type === "dropdown"){
          base.title = "New dropdown question";
          base.options = ["Option 1", "Option 2"];
        } else if (type === "paragraph"){
          base.title = "New paragraph question";
        } else if (type === "date"){
          base.title = "New date question";
        } else if (type === "file_upload"){
          base.title = "New file upload question";
        } else if (type === "yes_no"){
          base.title = "New yes/no question";
          base.options = ["Yes", "No"];
        } else {
          base.title = "New short answer question";
        }

        return base;
      }

      function getActiveForm(){
        return state.forms.find(form => form.id === state.activeFormId) || null;
      }

      function setActiveForm(formId){
        state.activeFormId = formId;
        saveWorkspace();
        renderAll();
      }

      function ensureActiveForm(){
        if (!getActiveForm() && state.forms.length){
          state.activeFormId = state.forms[0].id;
        }
      }

      function markUpdated(form){
        form.updatedAt = new Date().toISOString();
        saveWorkspace();
        renderOverviewStats();
      }

      function renderOverviewStats(){
        const all = state.forms.length;
        const draft = state.forms.filter(f => f.status === "draft").length;
        const published = state.forms.filter(f => f.status === "published").length;
        const closed = state.forms.filter(f => f.status === "closed").length;
        const totalResponses = state.responses.length;

        $("formsStatAll").textContent = String(all);
        $("formsStatDraft").textContent = String(draft);
        $("formsStatPublished").textContent = String(published);
        $("formsStatClosed").textContent = String(closed);
        $("formsStatResponses").textContent = String(totalResponses);

        $("responsesStatTotal").textContent = String(totalResponses);
        $("responsesStatPublished").textContent = String(published);
        $("responsesStatDraft").textContent = String(draft);

        if (state.responses.length){
          const latest = [...state.responses].sort((a, b) => new Date(b.submittedAt) - new Date(a.submittedAt))[0];
          $("responsesStatLatest").textContent = formatDate(latest.submittedAt);
        } else {
          $("responsesStatLatest").textContent = "--";
        }
      }

      function getStatusBadgeClass(status){
        if (status === "published") return "green";
        if (status === "closed") return "orange";
        if (status === "archived") return "red";
        return "";
      }

      function getAudienceLabel(value){
        const map = {
          all_students: "All Students",
          all_staff: "All Staff",
          lecturers: "Lecturers",
          department_students: "Department Students",
          specific_group: "Specific Group"
        };
        return map[value] || value || "—";
      }

      function getTypeLabel(type){
        const map = {
          short_answer: "Short Answer",
          paragraph: "Paragraph",
          multiple_choice: "Multiple Choice",
          checkboxes: "Checkboxes",
          dropdown: "Dropdown",
          date: "Date",
          file_upload: "File Upload",
          yes_no: "Yes / No"
        };
        return map[type] || type;
      }

      function getFilteredForms(){
        const term = state.searchTerm.trim().toLowerCase();

        return state.forms.filter(form => {
          const statusMatch = state.listFilter === "all" ? true : form.status === state.listFilter;
          const textMatch = !term
            ? true
            : (
                String(form.title || "").toLowerCase().includes(term) ||
                String(form.description || "").toLowerCase().includes(term) ||
                getAudienceLabel(form.targetAudience).toLowerCase().includes(term)
              );

          return statusMatch && textMatch;
        }).sort((a, b) => new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt));
      }

      function renderFormsList(){
        const wrap = $("formsListWrap");
        const forms = getFilteredForms();

        if (!forms.length){
          wrap.innerHTML = `
            <div class="empty-card">
              No forms matched this filter. Create a new form or change your search.
            </div>
          `;
          return;
        }

        wrap.innerHTML = forms.map(form => {
          const responsesForForm = state.responses.filter(r => r.formId === form.id).length;
          const isActive = form.id === state.activeFormId;

          return `
            <div class="forms-form-card">
              <div class="forms-form-top">
                <div>
                  <h4 class="forms-form-name">${escapeHtml(form.title || "Untitled Form")}</h4>
                  <p class="forms-form-desc">${escapeHtml(form.description || "No description added yet.")}</p>

                  <div class="forms-badges">
                    <span class="forms-badge ${getStatusBadgeClass(form.status)}">${escapeHtml(form.status)}</span>
                    <span class="forms-badge">${escapeHtml(getAudienceLabel(form.targetAudience))}</span>
                    <span class="forms-badge">${form.questions.length} Question${form.questions.length === 1 ? "" : "s"}</span>
                    ${isActive ? '<span class="forms-badge green">Open in workspace</span>' : ''}
                  </div>
                </div>
              </div>

              <div class="forms-form-meta">
                <div class="forms-form-meta-item">
                  <div class="forms-form-meta-label">Open Date</div>
                  <div class="forms-form-meta-value">${escapeHtml(formatDate(form.openDate))}</div>
                </div>

                <div class="forms-form-meta-item">
                  <div class="forms-form-meta-label">Close Date</div>
                  <div class="forms-form-meta-value">${escapeHtml(formatDate(form.closeDate))}</div>
                </div>

                <div class="forms-form-meta-item">
                  <div class="forms-form-meta-label">Responses</div>
                  <div class="forms-form-meta-value">${responsesForForm}</div>
                </div>

                <div class="forms-form-meta-item">
                  <div class="forms-form-meta-label">Updated</div>
                  <div class="forms-form-meta-value">${escapeHtml(formatDateTime(form.updatedAt || form.createdAt))}</div>
                </div>
              </div>

              <div class="forms-form-actions">
                <button type="button" class="forms-mini-btn blue" data-action="open-form" data-id="${form.id}">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="m13 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
