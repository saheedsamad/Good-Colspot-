        const list = $("formsQuestionList");
        const emptyNote = $("formsQuestionsEmptyNote");

        if (!form) {
          list.innerHTML = "";
          emptyNote.style.display = "block";
          return;
        }

        if (!form.questions.length){
          list.innerHTML = "";
          emptyNote.style.display = "block";
          return;
        }

        emptyNote.style.display = "none";

        list.innerHTML = form.questions.map((question, index) => {
          const hasOptions = ["multiple_choice", "checkboxes", "dropdown"].includes(question.type);
