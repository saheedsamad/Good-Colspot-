<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOS Main</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --page-bg:#f5f7fb;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#707786;
      --line:#e8edf5;

      --blue-1:#2f6cff;
      --blue-2:#2a56df;

      --green-1:#77b84d;
      --green-2:#5e9f3a;

      --orange-1:#ffb13a;
      --orange-2:#f39212;

      --nav-text:#9aa3b2;
      --shadow:0 14px 34px rgba(15,23,42,.08);
      --soft-shadow:0 12px 24px rgba(47,108,255,.14);

      --error:#991b1b;
      --error-bg:#fef2f2;
      --success:#166534;
      --success-bg:#ecfdf5;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:#edf2fb;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      color:var(--text);
      -webkit-text-size-adjust:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      background:var(--page-bg);
      padding:
        calc(env(safe-area-inset-top) + 10px)
        16px
        calc(env(safe-area-inset-bottom) + 108px);
      position:relative;
      overflow-x:hidden;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:38px;
      height:38px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .brand-logo svg{
      width:38px;
      height:38px;
      display:block;
    }

    .brand-name{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.03em;
      color:#102043;
    }

    .avatar-wrap{
      position:relative;
      flex-shrink:0;
    }

    .avatar-btn{
      width:50px;
      height:50px;
      border:none;
      border-radius:999px;
      color:#fff;
      font-size:19px;
      font-weight:800;
      cursor:pointer;
      background:linear-gradient(135deg,#2f6cff 0%, #18b774 100%);
      box-shadow:0 16px 28px rgba(47,108,255,.18);
    }

    .profile-menu{
      position:absolute;
      top:62px;
      right:0;
      width:205px;
      border-radius:20px;
      background:#fff;
      border:1px solid #e7edf5;
      box-shadow:0 20px 40px rgba(15,23,42,.14);
      overflow:hidden;
      display:none;
      z-index:30;
    }

    .profile-menu.show{
      display:block;
    }

    .profile-row{
      width:100%;
      border:none;
      background:#fff;
      padding:14px 16px;
      display:flex;
      align-items:center;
      gap:10px;
      text-align:left;
      cursor:pointer;
      font-size:14px;
      font-weight:700;
      color:#334155;
      border-bottom:1px solid #eef2f7;
    }

    .profile-row:last-child{
      border-bottom:none;
    }

    .profile-school{
      display:block;
      padding:14px 16px;
      font-size:13px;
      color:#6b7280;
      background:#fff;
    }

    .hero{
      margin-bottom:18px;
    }

    .hero-line{
      font-size:13px;
      color:var(--muted);
      margin-bottom:8px;
      font-weight:500;
      word-break:break-word;
    }

    .hero-title{
      margin:0;
      font-size:29px;
      line-height:1.08;
      letter-spacing:-.055em;
      font-weight:900;
      color:#111c37;
      max-width:310px;
    }

    .hero-title .accent{
      display:block;
      color:#2f6cff;
    }

    .message{
      display:none;
      margin:0 0 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--error-bg);
      border:1px solid #fecaca;
      color:var(--error);
    }

    .message.success{
      background:var(--success-bg);
      border:1px solid #bbf7d0;
      color:var(--success);
    }

    .quick-actions{
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-bottom:22px;
    }

    .quick-btn{
      width:100%;
      border:none;
      border-radius:999px;
      padding:18px 20px;
      display:flex;
      align-items:center;
      gap:14px;
      color:#fff;
      font-size:16px;
      font-weight:800;
      letter-spacing:-.02em;
      text-decoration:none;
      box-shadow:var(--soft-shadow);
    }

    .quick-btn svg{
      width:23px;
      height:23px;
      flex-shrink:0;
    }

    .quick-btn.blue{
      background:linear-gradient(90deg,var(--blue-1) 0%, var(--blue-2) 100%);
    }

    .quick-btn.green{
      background:linear-gradient(90deg,var(--green-1) 0%, var(--green-2) 100%);
    }

    .quick-btn.orange{
      background:linear-gradient(90deg,var(--orange-1) 0%, var(--orange-2) 100%);
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:4px 2px 12px;
    }

    .section-title{
      margin:0;
      font-size:15px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#111c37;
    }

    .section-link{
      text-decoration:none;
      color:#2563eb;
      font-size:13px;
      font-weight:700;
      display:flex;
      align-items:center;
      gap:4px;
      white-space:nowrap;
    }

    .overview-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:22px;
    }

    .overview-card{
      color:#fff;
      border-radius:18px;
      padding:14px 14px 12px;
      min-height:98px;
      box-shadow:var(--shadow);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .overview-card.blue{
      background:linear-gradient(135deg,#2f6cff 0%, #2357df 100%);
    }

    .overview-card.orange{
      background:linear-gradient(135deg,#ffb13a 0%, #f39413 100%);
    }

    .overview-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
    }

    .overview-icon{
      width:38px;
      height:38px;
      border-radius:14px;
      background:rgba(255,255,255,.18);
      display:flex;
      align-items:center;
      justify-content:center;
      backdrop-filter:blur(8px);
      flex-shrink:0;
    }

    .overview-icon svg{
      width:21px;
      height:21px;
    }

    .overview-value{
      font-size:30px;
      line-height:1;
      font-weight:900;
      letter-spacing:-.05em;
      text-align:right;
      white-space:nowrap;
    }

    .overview-label{
      margin-top:12px;
      font-size:13px;
      font-weight:800;
      line-height:1.05;
    }

    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:var(--shadow);
      padding:12px;
    }

    .list-wrap{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .report-item{
      display:flex;
      align-items:flex-start;
      gap:12px;
      padding:12px;
      border-radius:18px;
      background:#fff;
      border:1px solid #edf2f7;
    }

    .item-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#eef4ff;
      color:#255fe9;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .item-icon svg{
      width:20px;
      height:20px;
    }

    .item-content{
      flex:1;
      min-width:0;
    }

    .item-title{
      margin:0;
      font-size:15px;
      line-height:1.25;
      font-weight:800;
      letter-spacing:-.02em;
      color:#111c37;
    }

    .item-sub{
      margin:4px 0 0;
      font-size:13px;
      color:var(--muted);
      line-height:1.4;
      word-break:break-word;
    }

    .item-time{
      flex-shrink:0;
      font-size:12px;
      color:#7a8494;
      font-weight:700;
      white-space:nowrap;
      margin-left:8px;
    }

    .empty{
      padding:16px 8px;
      text-align:center;
      font-size:13px;
      color:var(--muted);
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:max(12px, env(safe-area-inset-bottom));
      width:calc(100% - 24px);
      max-width:396px;
      background:rgba(255,255,255,.98);
      border:1px solid #e7edf5;
      border-radius:31px;
      box-shadow:0 20px 40px rgba(15,23,42,.12);
      padding:10px 8px 12px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:2px;
      z-index:50;
      backdrop-filter:blur(14px);
    }

    .nav-btn{
      color:var(--nav-text);
      text-decoration:none;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:4px;
      min-height:64px;
      border-radius:18px;
      padding:4px 2px;
    }

    .nav-btn svg{
      width:22px;
      height:22px;
    }

    .nav-btn span{
      font-size:11px;
      font-weight:700;
      letter-spacing:-.01em;
      text-align:center;
      line-height:1.2;
    }

    .nav-btn.active{
      color:#2563eb;
    }

    @media (max-width:360px){
      .hero-title{
        font-size:26px;
      }

      .quick-btn{
        font-size:15px;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-logo" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none">
            <path d="M32 8 54 18v14c0 13.5-9.2 23.6-22 27C19.2 55.6 10 45.5 10 32V18L32 8Z" fill="url(#g1)"/>
            <path d="M22 26h20M22 33h15" stroke="white" stroke-width="4" stroke-linecap="round"/>
            <path d="M20 19h24" stroke="#0f172a" stroke-width="5" stroke-linecap="round"/>
            <defs>
              <linearGradient id="g1" x1="10" y1="8" x2="54" y2="59" gradientUnits="userSpaceOnUse">
                <stop stop-color="#1d4ed8"/>
                <stop offset="1" stop-color="#06b6d4"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <div class="avatar-wrap">
        <button class="avatar-btn" id="avatarBtn" type="button">H</button>

        <div class="profile-menu" id="profileMenu">
          <button class="profile-row" type="button" id="accountMenuBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c1.8-3.2 5-5 8-5s6.2 1.8 8 5"></path>
            </svg>
            <span>My account</span>
          </button>

          <button class="profile-row" type="button" id="logoutBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <path d="M16 17l5-5-5-5"></path>
              <path d="M21 12H9"></path>
            </svg>
            <span>Logout</span>
          </button>

          <span class="profile-school" id="profileSchoolText">School</span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-line" id="schoolNameText">Hello, School</div>
        <h1 class="hero-title">
          What would you like to
          <span class="accent">do today?</span>
        </h1>
      </section>

      <div class="message" id="pageMessageBox"></div>

      <section class="quick-actions">
        <a href="Announcement.html" class="quick-btn blue" id="announcementShortcut">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path>
          </svg>
          <span>Send Announcement</span>
        </a>

        <a href="Hod.html" class="quick-btn green" id="hodShortcut">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
            <circle cx="9.5" cy="7" r="3"></circle>
            <path d="M20 8v6"></path>
            <path d="M17 11h6"></path>
          </svg>
          <span>Create HOD Account</span>
        </a>

        <a href="report-agent.html" class="quick-btn orange" id="reportAgentShortcut">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 21s-6.5-4.35-8.5-7A5.48 5.48 0 0 1 3 11a5 5 0 0 1 9-3 5 5 0 0 1 9 3 5.48 5.48 0 0 1-.5 3c-2 2.65-8.5 7-8.5 7Z"></path>
            <path d="M12 10v4"></path>
            <path d="M10 12h4"></path>
          </svg>
          <span>Create Reports Agent</span>
        </a>
      </section>

      <div class="section-head">
        <h2 class="section-title">School Overview</h2>
      </div>

      <section class="overview-grid">
        <article class="overview-card blue">
          <div class="overview-top">
            <div class="overview-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
                <circle cx="9.5" cy="7" r="3"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="overview-value" id="hodCount">0</div>
          </div>
          <div class="overview-label">HODs</div>
        </article>

        <article class="overview-card orange">
          <div class="overview-top">
            <div class="overview-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 19.5V5.5A1.5 1.5 0 0 1 5.5 4H20"></path>
                <path d="M8 7h12v13H8a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"></path>
                <path d="M12 11h4M12 15h4"></path>
              </svg>
            </div>
            <div class="overview-value" id="studentCount">0</div>
          </div>
          <div class="overview-label">Students</div>
        </article>
      </section>

      <div class="section-head">
        <h2 class="section-title">Recent Reports</h2>
        <a href="reports.html" class="section-link">
          <span>View All Reports</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <section class="card">
        <div class="list-wrap" id="recentReportsList">
          <div class="empty">Loading reports...</div>
        </div>
      </section>
    </main>
  </div>

  <nav class="bottom-nav">
    <a href="hos.html" class="nav-btn active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 10.5 12 3l9 7.5"></path>
        <path d="M5 9.5V21h14V9.5"></path>
      </svg>
      <span>Home</span>
    </a>

    <a href="Hod.html" class="nav-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
        <circle cx="9.5" cy="7" r="3"></circle>
        <path d="M20 8v6"></path>
        <path d="M17 11h6"></path>
      </svg>
      <span>HOD</span>
    </a>

    <a href="Announcement.html" class="nav-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 11v2a2 2 0 0 0 2 2h2l4 4v-4h4l5 3V6l-5 3H5a2 2 0 0 0-2 2Z"></path>
      </svg>
      <span>Announcements</span>
    </a>

    <a href="history.html" class="nav-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 3-6.7"></path>
        <path d="M3 4v5h5"></path>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <span>History</span>
    </a>
  </nav>

  <script>
    (() => {
      const SUPABASE_URL = "YOUR_SUPABASE_URL";
      const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const $ = (id) => document.getElementById(id);

      let adminSession = null;
      let currentSchoolName = "";

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function showMessage(text, type = "error") {
        const box = $("pageMessageBox");
        if (!text) {
          box.textContent = "";
          box.className = "message";
          return;
        }
        box.textContent = text;
        box.className = `message show ${type}`;
      }

      function formatRelativeDate(value) {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "";
        return date.toLocaleString([], {
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        });
      }

      function getAdminSession() {
        try {
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        } catch {
          return null;
        }
      }

      function requireHosSession() {
        adminSession = getAdminSession();

        if (!adminSession || String(adminSession.role || "").toLowerCase() !== "hos") {
          window.location.href = "index.html";
          return false;
        }

        currentSchoolName =
          adminSession.school_name ||
          adminSession.school ||
          adminSession.schoolName ||
          "";

        $("schoolNameText").textContent = currentSchoolName
          ? `Hello, ${currentSchoolName}`
          : "Hello, School";

        $("profileSchoolText").textContent = currentSchoolName || "School";

        const initial = (adminSession.full_name || "H").trim().charAt(0).toUpperCase() || "H";
        $("avatarBtn").textContent = initial;

        return true;
      }

      async function loadStats() {
        try {
          const { count: hodCount, error: hodError } = await sb
            .from("admin_accounts")
            .select("*", { count: "exact", head: true })
            .eq("role", "hod")
            .eq("school_name", currentSchoolName);

          if (hodError) throw hodError;

          const { count: studentCount, error: studentError } = await sb
            .from("student_accounts")
            .select("*", { count: "exact", head: true })
            .eq("school_name", currentSchoolName);

          if (studentError) throw studentError;

          $("hodCount").textContent = String(hodCount || 0);
          $("studentCount").textContent = String(studentCount || 0);
        } catch (err) {
          console.error(err);
          $("hodCount").textContent = "0";
          $("studentCount").textContent = "0";
          showMessage("Could not load school overview.");
        }
      }

      async function loadRecentReports() {
        const wrap = $("recentReportsList");
        wrap.innerHTML = '<div class="empty">Loading reports...</div>';

        try {
          const { data, error } = await sb
            .from("student_reports")
            .select("title, category, created_at, is_anonymous, full_name, department")
            .eq("school_name", currentSchoolName)
            .order("created_at", { ascending: false })
            .limit(2);

          if (error) throw error;

          if (!data || !data.length) {
            wrap.innerHTML = '<div class="empty">No recent reports yet.</div>';
            return;
          }

          wrap.innerHTML = data.map((item) => {
            const personText = item.is_anonymous ? "Anonymous" : (item.full_name || "Student");

            return `
              <article class="report-item">
                <div class="item-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 21s-6.5-4.35-8.5-7A5.48 5.48 0 0 1 3 11a5 5 0 0 1 9-3 5 5 0 0 1 9 3 5.48 5.48 0 0 1-.5 3c-2 2.65-8.5 7-8.5 7Z"></path>
                  </svg>
                </div>

                <div class="item-content">
                  <h3 class="item-title">${escapeHtml(item.title || "Untitled report")}</h3>
                  <p class="item-sub">${escapeHtml(personText)}${item.category ? ` • ${escapeHtml(item.category)}` : ""}</p>
                  <p class="item-sub">${escapeHtml(item.department || "-")}</p>
                </div>

                <div class="item-time">${escapeHtml(formatRelativeDate(item.created_at))}</div>
              </article>
            `;
          }).join("");
        } catch (err) {
          console.error(err);
          wrap.innerHTML = '<div class="empty">Could not load recent reports.</div>';
        }
      }

      function setupProfileMenu() {
        const avatarBtn = $("avatarBtn");
        const profileMenu = $("profileMenu");

        avatarBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          profileMenu.classList.toggle("show");
        });

        document.addEventListener("click", (e) => {
          if (!profileMenu.contains(e.target) && !avatarBtn.contains(e.target)) {
            profileMenu.classList.remove("show");
          }
        });
      }

      function setupActions() {
        $("logoutBtn").addEventListener("click", () => {
          localStorage.removeItem("colspot_admin_session");
          localStorage.removeItem("colspot_pending_admin");
          window.location.href = "index.html";
        });

        $("accountMenuBtn").addEventListener("click", () => {
          window.location.href = "account.html";
        });
      }

      document.addEventListener("DOMContentLoaded", async () => {
        if (!requireHosSession()) return;
        setupProfileMenu();
        setupActions();
        showMessage("");
        await loadStats();
        await loadRecentReports();
      });
    })();
  </script>
</body>
</html>
