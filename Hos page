          return `
            <div class="question-card" data-question-id="${question.id}">
              <div class="question-head">
                <div class="question-head-left">
                  <div class="question-number">${index + 1}</div>
                  <div style="min-width:0; flex:1;">
                    <div style="font-size:15px; font-weight:900; color:#0f172a; line-height:1.4;">${escapeHtml(question.title || "Untitled Question")}</div>
                    <div class="helper-text">${escapeHtml(getTypeLabel(question.type))}</div>
                  </div>
                </div>

                <div class="question-head-right">
                  <label class="required-toggle">
                    <span>Required</span>
                    <span class="switch">
                      <input type="checkbox" data-action="toggle-required" data-question-id="${question.id}" ${question.required ? "checked" : ""}>
                      <span class="slider"></span>
                    </span>
                  </label>

                  <button type="button" class="icon-btn" data-action="move-question-up" data-question-id="${question.id}" title="Move up">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m7 14 5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <button type="button" class="icon-btn" data-action="move-question-down" data-question-id="${question.id}" title="Move down">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <button type="button" class="icon-btn" data-action="duplicate-question" data-question-id="${question.id}" title="Duplicate">
                    <svg viewBox="0 0 24 24" fill="none">
                      <rect x="9" y="9" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
                      <rect x="5" y="5" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
