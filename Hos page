<section id="screen-forms" class="screen">
  <style>
    #screen-forms{
      --forms-card:#ffffff;
      --forms-line:#e5e7eb;
      --forms-text:#0f172a;
      --forms-muted:#64748b;
      --forms-blue:#2563eb;
      --forms-blue-dark:#1d4ed8;
      --forms-blue-soft:#eff6ff;
      --forms-green:#16a34a;
      --forms-green-soft:#effdf4;
      --forms-orange:#f97316;
      --forms-orange-soft:#fff7ed;
      --forms-red:#ef4444;
      --forms-red-soft:#fef2f2;
      --forms-shadow:0 10px 25px rgba(37,99,235,.08);
      --forms-shadow-soft:0 18px 40px rgba(15,23,42,.06);
    }

    #screen-forms *{
      box-sizing:border-box;
    }

    #screen-forms .forms-system{
      display:grid;
      gap:18px;
    }

    #screen-forms .forms-hidden{
      display:none !important;
    }

    #screen-forms .forms-btn,
    #screen-forms .forms-btn-soft,
    #screen-forms .forms-btn-danger{
      border:none;
      min-height:48px;
      padding:0 16px;
      border-radius:16px;
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      cursor:pointer;
      transition:.18s ease;
      white-space:nowrap;
      text-decoration:none;
    }

    #screen-forms .forms-btn{
      background:linear-gradient(135deg,var(--forms-blue),var(--forms-blue-dark));
      color:#fff;
      box-shadow:0 16px 30px rgba(37,99,235,.20);
    }

    #screen-forms .forms-btn-soft{
      background:#fff;
      color:var(--forms-text);
      border:1px solid var(--forms-line);
    }

    #screen-forms .forms-btn-danger{
      background:var(--forms-red-soft);
      color:#b91c1c;
      border:1px solid #fecaca;
    }

    #screen-forms .forms-btn svg,
    #screen-forms .forms-btn-soft svg,
    #screen-forms .forms-btn-danger svg{
      width:18px;
      height:18px;
      flex-shrink:0;
    }

    #screen-forms .forms-card{
      background:var(--forms-card);
      border:1px solid var(--forms-line);
      border-radius:24px;
      box-shadow:var(--forms-shadow);
      overflow:hidden;
    }

    #screen-forms .forms-card-head{
      padding:18px 20px;
      border-bottom:1px solid var(--forms-line);
      background:linear-gradient(180deg,#fff 0%, #fafcff 100%);
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-card-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:var(--forms-text);
    }

    #screen-forms .forms-card-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--forms-muted);
      line-height:1.5;
    }

    #screen-forms .forms-card-body{
      padding:18px 20px;
      display:grid;
      gap:16px;
    }

    #screen-forms .forms-field{
      display:grid;
      gap:8px;
    }

    #screen-forms .forms-field label{
      font-size:13px;
      font-weight:800;
      color:var(--forms-text);
    }

    #screen-forms .forms-input,
    #screen-forms .forms-select,
    #screen-forms .forms-textarea{
      width:100%;
      border:1px solid #dbe3ee;
      border-radius:16px;
      outline:none;
      background:#fff;
      color:var(--forms-text);
      font-size:14px;
    }

    #screen-forms .forms-input,
    #screen-forms .forms-select{
      min-height:50px;
      padding:0 14px;
    }

    #screen-forms .forms-textarea{
      min-height:110px;
      padding:14px;
      resize:vertical;
      line-height:1.55;
    }

    #screen-forms .forms-grid-2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    #screen-forms .forms-grid-3{
      display:grid;
      grid-template-columns:1fr 1fr 1fr;
      gap:14px;
    }

    #screen-forms .forms-note{
      border-radius:16px;
      padding:14px 15px;
      font-size:13px;
      line-height:1.55;
    }

    #screen-forms .forms-note.info{
      background:var(--forms-blue-soft);
      border:1px solid #bfdbfe;
      color:#1d4ed8;
    }

    #screen-forms .forms-note.success{
      background:var(--forms-green-soft);
      border:1px solid #bbf7d0;
      color:#166534;
    }

    #screen-forms .forms-empty{
      min-height:180px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      border:1px dashed #d7e0eb;
      border-radius:20px;
      background:#fbfdff;
      color:var(--forms-muted);
      padding:20px;
      font-size:14px;
      line-height:1.6;
    }

    #screen-forms .status-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:30px;
      padding:0 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      white-space:nowrap;
      background:var(--forms-blue-soft);
      color:#1d4ed8;
    }

    #screen-forms .status-pill.draft{
      background:var(--forms-orange-soft);
      color:#c2410c;
    }

    #screen-forms .status-pill.published{
      background:var(--forms-green-soft);
      color:#166534;
    }

    #screen-forms .status-pill.closed{
      background:#f1f5f9;
      color:#475569;
    }

    #screen-forms .status-pill.archived{
      background:var(--forms-red-soft);
      color:#991b1b;
    }

    #screen-forms .meta-chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:30px;
      padding:0 11px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      background:#f8fbff;
      color:#334155;
      border:1px solid #e5edf7;
    }

    /* HOME VIEW */
    #screen-forms .forms-home{
      display:grid;
      gap:18px;
    }

    #screen-forms .forms-home-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }

    #screen-forms .forms-home-title{
      margin:0;
      font-size:30px;
      line-height:1.08;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--forms-text);
    }

    #screen-forms .forms-home-sub{
      margin:8px 0 0;
      font-size:14px;
      line-height:1.6;
      color:var(--forms-muted);
      max-width:760px;
    }

    #screen-forms .forms-status-tabs{
      display:flex;
      gap:0;
      flex-wrap:wrap;
      border:1px solid var(--forms-line);
      border-radius:18px;
      overflow:hidden;
      background:#fff;
      box-shadow:var(--forms-shadow);
    }

    #screen-forms .forms-status-tab{
      border:none;
      min-height:54px;
      padding:0 22px;
      background:#fff;
      color:#475569;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
      border-right:1px solid var(--forms-line);
      display:inline-flex;
      align-items:center;
      gap:10px;
    }

    #screen-forms .forms-status-tab:last-child{
      border-right:none;
    }

    #screen-forms .forms-status-tab.active{
      background:var(--forms-blue-soft);
      color:#1d4ed8;
      box-shadow:inset 0 -3px 0 var(--forms-blue);
    }

    #screen-forms .forms-list-grid{
      display:grid;
      gap:14px;
    }

    #screen-forms .form-item{
      border:1px solid #e9eef5;
      border-radius:22px;
      background:#fff;
      padding:18px;
      display:grid;
      gap:14px;
      box-shadow:var(--forms-shadow);
    }

    #screen-forms .form-item-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .form-item-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      color:var(--forms-text);
      line-height:1.35;
    }

    #screen-forms .form-item-desc{
      margin:7px 0 0;
      font-size:14px;
      color:var(--forms-muted);
      line-height:1.55;
    }

    #screen-forms .form-item-meta{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    #screen-forms .form-item-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    #screen-forms .mini-btn{
      border:none;
      min-height:40px;
      padding:0 14px;
      border-radius:13px;
      font-size:13px;
      font-weight:800;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-forms .mini-btn.gray{
      background:#f8fafc;
      color:#334155;
    }

    #screen-forms .mini-btn.red{
      background:var(--forms-red-soft);
      color:#991b1b;
    }

    /* BUILDER VIEW */
    #screen-forms .forms-builder-system{
      display:grid;
      gap:18px;
    }

    #screen-forms .forms-builder-topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      padding:16px 18px;
      border:1px solid var(--forms-line);
      border-radius:20px;
      background:#fff;
      box-shadow:var(--forms-shadow);
    }

    #screen-forms .forms-builder-topbar-left,
    #screen-forms .forms-builder-topbar-right{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    #screen-forms .save-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:40px;
      padding:0 12px;
      border-radius:999px;
      background:var(--forms-green-soft);
      color:#166534;
      font-size:12px;
      font-weight:800;
      border:1px solid #bbf7d0;
    }

    #screen-forms .save-pill svg{
      width:15px;
      height:15px;
    }

    #screen-forms .builder-tabs{
      display:flex;
      gap:0;
      border:1px solid var(--forms-line);
      border-radius:18px;
      overflow:hidden;
      background:#fff;
      box-shadow:var(--forms-shadow);
      width:max-content;
      max-width:100%;
      flex-wrap:wrap;
    }

    #screen-forms .builder-tab{
      border:none;
      min-height:52px;
      padding:0 22px;
      background:#fff;
      color:#475569;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
      border-right:1px solid var(--forms-line);
    }

    #screen-forms .builder-tab:last-child{
      border-right:none;
    }

    #screen-forms .builder-tab.active{
      background:var(--forms-blue-soft);
      color:#1d4ed8;
      box-shadow:inset 0 -3px 0 var(--forms-blue);
    }

    #screen-forms .builder-layout{
      display:grid;
      grid-template-columns:420px minmax(0,1fr);
      gap:18px;
      align-items:start;
    }

    #screen-forms .builder-side,
    #screen-forms .builder-main{
      display:grid;
      gap:18px;
    }

    #screen-forms .builder-panel{
      background:#fff;
      border:1px solid var(--forms-line);
      border-radius:24px;
      box-shadow:var(--forms-shadow);
      overflow:hidden;
    }

    #screen-forms .builder-panel-head{
      padding:18px 20px;
      border-bottom:1px solid var(--forms-line);
      background:linear-gradient(180deg,#fff 0%, #fafcff 100%);
    }

    #screen-forms .builder-panel-head h3{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:var(--forms-text);
    }

    #screen-forms .builder-panel-head p{
      margin:6px 0 0;
      font-size:13px;
      color:var(--forms-muted);
      line-height:1.5;
    }

    #screen-forms .builder-panel-body{
      padding:18px 20px;
      display:grid;
      gap:18px;
    }

    #screen-forms .question-list{
      display:grid;
      gap:16px;
    }

    #screen-forms .question-card{
      border:1px solid #e7edf6;
      border-radius:22px;
      overflow:hidden;
      background:#fff;
      box-shadow:var(--forms-shadow-soft);
    }

    #screen-forms .question-card-head{
      padding:16px 18px;
      border-bottom:1px solid #edf2f7;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      background:linear-gradient(180deg,#fff 0%, #fbfdff 100%);
    }

    #screen-forms .question-head-left{
      display:flex;
      align-items:flex-start;
      gap:12px;
      min-width:0;
      flex:1;
    }

    #screen-forms .question-number{
      width:34px;
      height:34px;
      border-radius:12px;
      background:var(--forms-blue-soft);
      color:#1d4ed8;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:13px;
      font-weight:900;
      flex-shrink:0;
    }

    #screen-forms .question-title-static{
      font-size:15px;
      font-weight:900;
      color:var(--forms-text);
      line-height:1.4;
    }

    #screen-forms .question-type-static{
      font-size:12px;
      color:var(--forms-muted);
      margin-top:3px;
    }

    #screen-forms .question-head-right{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }

    #screen-forms .toggle-wrap{
      display:inline-flex;
      align-items:center;
      gap:10px;
      min-height:40px;
      padding:0 12px;
      border-radius:999px;
      background:#f8fbff;
      border:1px solid #e5edf7;
      font-size:12px;
      font-weight:800;
      color:#334155;
    }

    #screen-forms .switch{
      position:relative;
      width:46px;
      height:26px;
      flex-shrink:0;
    }

    #screen-forms .switch input{
      opacity:0;
      width:0;
      height:0;
      position:absolute;
    }

    #screen-forms .slider{
      position:absolute;
      inset:0;
      background:#cbd5e1;
      border-radius:999px;
      transition:.18s ease;
      cursor:pointer;
    }

    #screen-forms .slider::before{
      content:"";
      position:absolute;
      width:20px;
      height:20px;
      left:3px;
      top:3px;
      border-radius:50%;
      background:#fff;
      transition:.18s ease;
      box-shadow:0 2px 8px rgba(0,0,0,.12);
    }

    #screen-forms .switch input:checked + .slider{
      background:#22c55e;
    }

    #screen-forms .switch input:checked + .slider::before{
      transform:translateX(20px);
    }

    #screen-forms .icon-btn{
      border:none;
      width:40px;
      height:40px;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#f8fbff;
      color:#334155;
      border:1px solid #e5edf7;
      cursor:pointer;
    }

    #screen-forms .icon-btn svg{
      width:16px;
      height:16px;
    }

    #screen-forms .question-card-body{
      padding:18px;
      display:grid;
      gap:16px;
    }

    #screen-forms .question-grid-2{
      display:grid;
      grid-template-columns:1fr 240px;
      gap:14px;
    }

    #screen-forms .question-grid-3{
      display:grid;
      grid-template-columns:1fr 1fr 1fr;
      gap:14px;
    }

    #screen-forms .options-list{
      display:grid;
      gap:10px;
    }

    #screen-forms .option-row{
      display:grid;
      grid-template-columns:40px 1fr auto;
      gap:10px;
      align-items:center;
    }

    #screen-forms .option-badge{
      width:40px;
      height:42px;
      border-radius:12px;
      border:1px solid #e5edf7;
      background:#fbfdff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:12px;
      font-weight:900;
      color:#64748b;
    }

    #screen-forms .option-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    #screen-forms .question-footer{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .question-footer-left,
    #screen-forms .question-footer-right{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    /* ADD QUESTION PICKER AFTER LAST QUESTION */
    #screen-forms .add-question-dock{
      border:1px dashed #bfdbfe;
      border-radius:24px;
      background:linear-gradient(180deg,#f8fbff 0%, #ffffff 100%);
      padding:18px;
      display:grid;
      gap:14px;
    }

    #screen-forms .add-question-dock-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    #screen-forms .add-question-dock-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      color:var(--forms-text);
      letter-spacing:-.02em;
    }

    #screen-forms .add-question-dock-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--forms-muted);
      line-height:1.5;
    }

    #screen-forms .quick-type-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:10px;
    }

    #screen-forms .type-btn{
      border:none;
      min-height:52px;
      padding:0 12px;
      border-radius:16px;
      background:#fff;
      color:#334155;
      font-size:13px;
      font-weight:800;
      border:1px solid #dbe7f5;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      text-align:center;
      box-shadow:0 6px 16px rgba(15,23,42,.03);
    }

    #screen-forms .type-btn svg{
      width:16px;
      height:16px;
      flex-shrink:0;
    }

    /* PREVIEW */
    #screen-forms .student-preview{
      border:1px solid #e5edf7;
      border-radius:24px;
      overflow:hidden;
      background:#fff;
      box-shadow:var(--forms-shadow);
    }

    #screen-forms .student-preview-head{
      padding:24px 22px 18px;
      background:linear-gradient(135deg,#2563eb 0%, #3b82f6 60%, #60a5fa 100%);
      color:#fff;
    }

    #screen-forms .student-preview-title{
      margin:0;
      font-size:28px;
      font-weight:900;
      letter-spacing:-.03em;
    }

    #screen-forms .student-preview-desc{
      margin:10px 0 0;
      font-size:14px;
      line-height:1.65;
      opacity:.96;
    }

    #screen-forms .student-preview-body{
      padding:20px;
      display:grid;
      gap:16px;
    }

    #screen-forms .student-q{
      border:1px solid #e9eef5;
      border-radius:20px;
      padding:18px;
      background:#fbfdff;
    }

    #screen-forms .student-q h4{
      margin:0 0 6px;
      font-size:15px;
      font-weight:900;
      color:var(--forms-text);
      line-height:1.45;
    }

    #screen-forms .student-q p{
      margin:0 0 12px;
      font-size:12px;
      color:var(--forms-muted);
      line-height:1.5;
    }

    #screen-forms .student-required{
      color:#dc2626;
      margin-left:4px;
    }

    #screen-forms .student-option-list{
      display:grid;
      gap:10px;
    }

    #screen-forms .student-option{
      display:flex;
      align-items:center;
      gap:10px;
      min-height:44px;
      padding:0 14px;
      border:1px solid #e5edf7;
      border-radius:14px;
      background:#fff;
      color:var(--forms-text);
      font-size:14px;
    }

    #screen-forms .student-option input{
      accent-color:#2563eb;
    }

    #screen-forms .student-preview-footer{
      padding:0 20px 20px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    @media (max-width:1400px){
      #screen-forms .builder-layout{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:980px){
      #screen-forms .forms-grid-2,
      #screen-forms .forms-grid-3,
      #screen-forms .question-grid-2,
      #screen-forms .question-grid-3{
        grid-template-columns:1fr;
      }

      #screen-forms .quick-type-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width:700px){
      #screen-forms .quick-type-grid{
        grid-template-columns:1fr;
      }

      #screen-forms .option-row{
        grid-template-columns:1fr;
      }

      #screen-forms .option-badge{
        width:100%;
      }
    }
  </style>

  <div class="forms-system">
    <!-- FORMS HOME -->
    <div class="forms-home">
      <div class="forms-home-top">
        <div>
          <h2 class="forms-home-title">Forms</h2>
          <p class="forms-home-sub">
            Create and manage school forms. Open a form to continue editing, preview it, or publish it when ready.
          </p>
        </div>

        <button type="button" class="forms-btn">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>Create Form</span>
        </button>
      </div>

      <div class="forms-status-tabs">
        <button type="button" class="forms-status-tab active">Draft</button>
        <button type="button" class="forms-status-tab">Published</button>
        <button type="button" class="forms-status-tab">Closed</button>
        <button type="button" class="forms-status-tab">Archived</button>
      </div>

      <div class="forms-card">
        <div class="forms-card-head">
          <div>
            <h3 class="forms-card-title">Forms List</h3>
            <p class="forms-card-sub">Forms you create will appear here.</p>
