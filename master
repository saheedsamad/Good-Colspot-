<script>
  const individualState = {
    loaded: false,
    formId: null,
    form: null,
    rows: [],
    filteredRows: [],
    selectedResponseId: null,
    selectedDetails: null,
    questionMap: new Map(),
  };

  function getActorPayloadForIndividual() {
    try {
      const keys = [
        "colspot_hos_session",
        "colspot_admin_session",
        "hos_session",
        "admin_session",
        "colspot_session"
      ];

      let stored = null;

      for (const key of keys) {
        const raw = localStorage.getItem(key);
        if (!raw) continue;
        try {
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed === "object") {
            stored = parsed;
            break;
          }
        } catch (_) {}
      }

      const params = new URLSearchParams(window.location.search);

      const hosAdminId =
        (stored && (stored.hos_admin_id || (stored.role === "hos" ? stored.id : ""))) ||
        params.get("hos_admin_id") ||
        "";

      const formAgentId =
        (stored && (stored.form_agent_id || (stored.role === "form_agent" ? stored.id : ""))) ||
        params.get("form_agent_id") ||
        "";

      if (hosAdminId) return { hos_admin_id: hosAdminId };
      if (formAgentId) return { form_agent_id: formAgentId };

      throw new Error("HOS or Form Agent session not found.");
    } catch (err) {
      throw err;
    }
  }

  function getCurrentFormIdForIndividual() {
    const params = new URLSearchParams(window.location.search);
    const formId = params.get("form_id") || "";
    if (!formId) throw new Error("form_id is missing in URL.");
    return formId;
  }

  function normalizeIndividualText(value) {
    return String(value ?? "").trim().replace(/\s+/g, " ");
  }

  function normalizeIndividualUpper(value) {
    return normalizeIndividualText(value).toUpperCase();
  }

  function formatIndividualDateTime(value) {
    if (!value) return "—";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "—";
    return d.toLocaleString([], {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  }

  function escapeIndividualHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function formatQuestionTypeLabel(value) {
    const map = {
      short_answer: "Short Answer",
      paragraph: "Paragraph",
      multiple_choice: "Multiple Choice",
      checkboxes: "Checkboxes",
      dropdown: "Dropdown",
      date: "Date",
      file_upload: "File Upload",
      yes_no: "Yes / No",
    };
    return map[value] || value || "Question";
  }

  async function invokeFormResponseManager(payload) {
    if (!window.supabase || typeof window.supabase.createClient !== "function") {
      throw new Error("Supabase browser library is not loaded on this page.");
    }

    if (
      !SUPABASE_URL ||
      !SUPABASE_ANON_KEY ||
      SUPABASE_URL.includes("YOUR_SUPABASE_URL") ||
      SUPABASE_ANON_KEY.includes("YOUR_SUPABASE_ANON_KEY")
    ) {
      throw new Error("Set your real SUPABASE_URL and SUPABASE_ANON_KEY first.");
    }

    const response = await fetch(`${SUPABASE_URL}/functions/v1/form-response-manager`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "apikey": SUPABASE_ANON_KEY,
        "Authorization": `Bearer ${SUPABASE_ANON_KEY}`,
      },
      body: JSON.stringify(payload),
    });

    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(result?.error || "Edge Function returned a non-2xx status code");
    }

    if (!result?.ok) {
      throw new Error(result?.error || "Request failed.");
    }

    return result;
  }

  async function loadIndividualResponses(force = false) {
    if (individualState.loaded && !force) return;

    const actorPayload = getActorPayloadForIndividual();
    const formId = getCurrentFormIdForIndividual();

    const result = await invokeFormResponseManager({
      action: "list_individual_responses",
      form_id: formId,
      ...actorPayload,
    });

    individualState.loaded = true;
    individualState.formId = formId;
    individualState.form = result.form || null;
    individualState.rows = Array.isArray(result.responses) ? result.responses : [];
    individualState.filteredRows = [...individualState.rows];
    individualState.selectedResponseId = null;
    individualState.selectedDetails = null;

    populateIndividualFilters();
    applyIndividualFilters();
    renderIndividualList();
    renderIndividualDetailEmpty();
  }

  function populateIndividualFilters() {
    const programmeSelect = document.getElementById("individualProgrammeFilter");
    const levelSelect = document.getElementById("individualLevelFilter");
    if (!programmeSelect || !levelSelect) return;

    const programmes = [...new Set(
      individualState.rows
        .map((row) => normalizeIndividualText(row.programme))
        .filter(Boolean)
    )].sort((a, b) => a.localeCompare(b));

    const levels = [...new Set(
      individualState.rows
        .map((row) => normalizeIndividualText(row.level))
        .filter(Boolean)
    )].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

    const currentProgramme = programmeSelect.value;
    const currentLevel = levelSelect.value;

    programmeSelect.innerHTML =
      `<option value="">All Programmes</option>` +
      programmes.map((item) => `<option value="${escapeIndividualHtml(item)}">${escapeIndividualHtml(item)}</option>`).join("");

    levelSelect.innerHTML =
      `<option value="">All Levels</option>` +
      levels.map((item) => `<option value="${escapeIndividualHtml(item)}">${escapeIndividualHtml(item)}</option>`).join("");

    if (programmes.includes(currentProgramme)) programmeSelect.value = currentProgramme;
    if (levels.includes(currentLevel)) levelSelect.value = currentLevel;
  }

  function applyIndividualFilters() {
    const searchInput = document.getElementById("individualSearchInput");
    const programmeSelect = document.getElementById("individualProgrammeFilter");
    const levelSelect = document.getElementById("individualLevelFilter");

    const search = normalizeIndividualUpper(searchInput?.value || "");
    const programme = normalizeIndividualUpper(programmeSelect?.value || "");
    const level = normalizeIndividualUpper(levelSelect?.value || "");

    individualState.filteredRows = individualState.rows.filter((row) => {
      const rowName = normalizeIndividualUpper(row.full_name);
      const rowProgramme = normalizeIndividualUpper(row.programme);
      const rowLevel = normalizeIndividualUpper(row.level);

      const searchOk =
        !search ||
        rowName.includes(search) ||
        rowProgramme.includes(search) ||
        rowLevel.includes(search);

      const programmeOk = !programme || rowProgramme === programme;
      const levelOk = !level || rowLevel === level;

      return searchOk && programmeOk && levelOk;
    });

    const totalCount = document.getElementById("individualTotalCount");
    const filteredCount = document.getElementById("individualFilteredCount");
    if (totalCount) totalCount.textContent = String(individualState.rows.length);
    if (filteredCount) filteredCount.textContent = String(individualState.filteredRows.length);

    if (
      individualState.selectedResponseId &&
      !individualState.filteredRows.some((row) => row.response_id === individualState.selectedResponseId)
    ) {
      individualState.selectedResponseId = null;
      individualState.selectedDetails = null;
    }
  }

  function renderIndividualList() {
    const list = document.getElementById("individualList");
    const empty = document.getElementById("individualListEmpty");
    if (!list || !empty) return;

    if (!individualState.filteredRows.length) {
      list.innerHTML = "";
      empty.style.display = "flex";
      empty.textContent = "No submitted response found for this filter.";
      return;
    }

    empty.style.display = "none";

    list.innerHTML = individualState.filteredRows.map((row) => {
      const active = row.response_id === individualState.selectedResponseId ? " active" : "";
      const initials = normalizeIndividualText(row.full_name || "A").charAt(0).toUpperCase() || "A";

      return `
        <div class="individual-row${active}">
          <div class="individual-row-left">
            <h4 class="individual-row-name">${escapeIndividualHtml(row.full_name || "Anonymous")}</h4>

            <div class="individual-row-meta">
              ${row.programme ? `<span class="individual-chip">${escapeIndividualHtml(row.programme)}</span>` : ""}
              ${row.level ? `<span class="individual-chip">${escapeIndividualHtml(row.level)}</span>` : ""}
              ${row.is_anonymous ? `<span class="individual-chip">Anonymous</span>` : `<span class="individual-chip">Identified</span>`}
            </div>

            <div class="individual-row-time">${escapeIndividualHtml(formatIndividualDateTime(row.submitted_at))}</div>
          </div>

          <button
            type="button"
            class="individual-view-btn"
            data-response-id="${escapeIndividualHtml(row.response_id)}"
          >
            View Details
          </button>
        </div>
      `;
    }).join("");

    list.querySelectorAll(".individual-view-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const responseId = btn.getAttribute("data-response-id") || "";
        await loadIndividualDetail(responseId);
      });
    });
  }

  async function loadIndividualDetail(responseId) {
    const actorPayload = getActorPayloadForIndividual();
    const result = await invokeFormResponseManager({
      action: "get_individual_response",
      form_id: individualState.formId,
      response_id: responseId,
      ...actorPayload,
    });

    individualState.selectedResponseId = responseId;
    individualState.selectedDetails = result;

    renderIndividualList();
    renderIndividualDetail();
  }

  function renderIndividualDetailEmpty() {
    const empty = document.getElementById("individualDetailEmpty");
    const body = document.getElementById("individualDetailBody");
    if (empty) empty.style.display = "flex";
    if (body) body.style.display = "none";
  }

  function renderIndividualDetail() {
    const empty = document.getElementById("individualDetailEmpty");
    const body = document.getElementById("individualDetailBody");
    const data = individualState.selectedDetails;

    if (!data || !data.respondent) {
      renderIndividualDetailEmpty();
      return;
    }

    if (empty) empty.style.display = "none";
    if (body) body.style.display = "block";

    const respondent = data.respondent;
    const answers = Array.isArray(data.answers) ? data.answers : [];
    const answeredCount = answers.filter((item) => item.answered).length;
    const fullName = respondent.full_name || "Anonymous";
    const initials = normalizeIndividualText(fullName).charAt(0).toUpperCase() || "A";

    const avatar = document.getElementById("individualAvatar");
    const personName = document.getElementById("individualPersonName");
    const personProgramme = document.getElementById("individualPersonProgramme");
    const personLevel = document.getElementById("individualPersonLevel");
    const personSubmittedAt = document.getElementById("individualPersonSubmittedAt");
    const responseId = document.getElementById("individualResponseId");
    const identityMode = document.getElementById("individualIdentityMode");
    const answered = document.getElementById("individualAnsweredCount");
    const questionCount = document.getElementById("individualQuestionCount");
    const answerList = document.getElementById("individualAnswerList");

    if (avatar) avatar.textContent = initials;
    if (personName) personName.textContent = fullName;
    if (personProgramme) personProgramme.textContent = respondent.programme || "No programme";
    if (personLevel) personLevel.textContent = respondent.level || "No level";
    if (personSubmittedAt) personSubmittedAt.textContent = formatIndividualDateTime(respondent.submitted_at);
    if (responseId) responseId.textContent = respondent.response_id || "—";
    if (identityMode) identityMode.textContent = respondent.is_anonymous ? "Anonymous" : "Use login identity";
    if (answered) answered.textContent = String(answeredCount);
    if (questionCount) questionCount.textContent = String(answers.length);

    if (!answerList) return;

    if (!answers.length) {
      answerList.innerHTML = `
        <div class="individual-detail-empty" style="min-height:180px;">
          No answers found for this response.
        </div>
      `;
      return;
    }

    answerList.innerHTML = answers.map((item) => {
      const typeLabel = formatQuestionTypeLabel(item.question_type);
      const helper = item.section_name ? `<p>${escapeIndividualHtml(item.section_name)}</p>` : "";

      let bodyHtml = `<div class="individual-answer-text individual-answer-empty">No answer submitted.</div>`;

      if (item.file_urls && item.file_urls.length) {
        bodyHtml = `
          <div class="individual-file-list">
            ${item.file_urls.map((url) => `
              <div class="individual-file-item">
                <a href="${escapeIndividualHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeIndividualHtml(url)}</a>
              </div>
            `).join("")}
          </div>
        `;
      } else if (item.answer_list && item.answer_list.length) {
        bodyHtml = `
          <div class="individual-answer-list-items">
            ${item.answer_list.map((value) => `<span>${escapeIndividualHtml(value)}</span>`).join("")}
          </div>
        `;
      } else if (normalizeIndividualText(item.answer_text)) {
        bodyHtml = `<div class="individual-answer-text">${escapeIndividualHtml(item.answer_text)}</div>`;
      }

      return `
        <div class="individual-answer-card">
          <div class="individual-answer-top">
            <div class="individual-answer-question">
              <h5>${escapeIndividualHtml(item.question_text || "Untitled question")}</h5>
              ${helper}
            </div>
            <div class="individual-answer-type">${escapeIndividualHtml(typeLabel)}</div>
          </div>

          <div class="individual-answer-body">
            ${bodyHtml}
          </div>
        </div>
      `;
    }).join("");
  }

  function showIndividualView() {
    const individualView = document.getElementById("individualView");
    const questionsView = document.getElementById("questionsView");
    const questionsPlaceholder = document.getElementById("questionsPlaceholder");
    const individualPlaceholder = document.getElementById("individualPlaceholder");
    const exportPlaceholder = document.getElementById("exportPlaceholder");

    document.querySelectorAll(".hero-card, .row-grid, .info-grid").forEach((el) => {
      el.style.display = "none";
    });

    if (questionsView) questionsView.style.display = "none";
    if (questionsPlaceholder) questionsPlaceholder.style.display = "none";
    if (individualPlaceholder) individualPlaceholder.style.display = "none";
    if (exportPlaceholder) exportPlaceholder.style.display = "none";
    if (individualView) individualView.style.display = "block";

    const links = Array.from(document.querySelectorAll(".side-link"));
    links.forEach((btn) => btn.classList.remove("active"));
    if (links[2]) links[2].classList.add("active");

    const h2 = document.querySelector(".topbar-title h2");
    const p = document.querySelector(".topbar-title p");
    if (h2) h2.textContent = "Individual";
    if (p) p.textContent = "View one submitted response at a time";

    loadIndividualResponses().catch((err) => {
      console.error("individual view load error:", err);
      const list = document.getElementById("individualList");
      const empty = document.getElementById("individualListEmpty");
      if (list) list.innerHTML = "";
      if (empty) {
        empty.style.display = "flex";
        empty.textContent = err?.message || "Unable to load individual responses.";
      }
      renderIndividualDetailEmpty();
    });
  }

  function wireIndividualView() {
    const links = Array.from(document.querySelectorAll(".side-link"));
    if (links[2]) {
      links[2].addEventListener("click", showIndividualView);
    }

    const search = document.getElementById("individualSearchInput");
    const programme = document.getElementById("individualProgrammeFilter");
    const level = document.getElementById("individualLevelFilter");
    const refresh = document.getElementById("individualRefreshBtn");

    if (search) {
      search.addEventListener("input", () => {
        applyIndividualFilters();
        renderIndividualList();
        if (!individualState.selectedResponseId) renderIndividualDetailEmpty();
      });
    }

    if (programme) {
      programme.addEventListener("change", () => {
        applyIndividualFilters();
        renderIndividualList();
        if (!individualState.selectedResponseId) renderIndividualDetailEmpty();
      });
    }

    if (level) {
      level.addEventListener("change", () => {
        applyIndividualFilters();
        renderIndividualList();
        if (!individualState.selectedResponseId) renderIndividualDetailEmpty();
      });
    }

    if (refresh) {
      refresh.addEventListener("click", async () => {
        try {
          refresh.disabled = true;
          individualState.loaded = false;
          await loadIndividualResponses(true);
        } catch (err) {
          console.error("individual refresh error:", err);
          alert(err?.message || "Unable to refresh responses.");
        } finally {
          refresh.disabled = false;
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", wireIndividualView);
</script>

