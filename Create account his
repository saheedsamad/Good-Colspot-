<section id="screen-create-account" class="screen">
  <style>
    #screen-create-account .create-account-wrap{
      display:grid;
      gap:18px;
    }

    #screen-create-account .create-account-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
    }

    #screen-create-account .create-account-grid{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:18px;
    }

    #screen-create-account .create-panel{
      background:#fff;
      border:1px solid var(--line, #e5e7eb);
      border-radius:24px;
      box-shadow:var(--shadow-soft, 0 10px 25px rgba(37,99,235,.08));
      overflow:hidden;
    }

    #screen-create-account .create-panel-head{
      padding:18px 20px;
      border-bottom:1px solid var(--line, #e5e7eb);
      background:linear-gradient(180deg,#ffffff 0%, #fafcff 100%);
    }

    #screen-create-account .create-panel-title{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
    }

    #screen-create-account .create-panel-sub{
      margin:6px 0 0;
      font-size:13px;
      color:var(--muted, #6b7280);
      line-height:1.5;
    }

    #screen-create-account .create-form{
      padding:20px;
      display:grid;
      gap:16px;
    }

    #screen-create-account .form-row{
      display:grid;
      gap:14px;
    }

    #screen-create-account .form-row.two{
      grid-template-columns:1fr 1fr;
    }

    #screen-create-account .field{
      display:grid;
      gap:8px;
    }

    #screen-create-account .field label{
      font-size:13px;
      font-weight:800;
      color:#0f172a;
    }

    #screen-create-account .field input,
    #screen-create-account .field select{
      width:100%;
      height:52px;
      border:1px solid #dbe3ee;
      border-radius:16px;
      outline:none;
      padding:0 15px;
      font-size:14px;
      color:#0f172a;
      background:#fff;
    }

    #screen-create-account .field input:focus,
    #screen-create-account .field select:focus{
      border-color:#2563eb;
      box-shadow:0 0 0 4px rgba(37,99,235,.10);
    }

    #screen-create-account .optional-text{
      font-weight:700;
      color:var(--muted, #6b7280);
      font-size:12px;
    }

    #screen-create-account .read-only-box{
      min-height:52px;
      border:1px solid #dbe3ee;
      border-radius:16px;
      padding:14px 15px;
      font-size:14px;
      color:#475569;
      background:#f8fbff;
      display:flex;
      align-items:center;
    }

    #screen-create-account .create-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      padding-top:4px;
    }

    #screen-create-account .primary-create-btn,
    #screen-create-account .secondary-create-btn{
      border:none;
      border-radius:16px;
      min-height:52px;
      padding:0 18px;
      font-size:14px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
    }

    #screen-create-account .primary-create-btn{
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      color:#fff;
      box-shadow:0 16px 30px rgba(37,99,235,.22);
    }

    #screen-create-account .secondary-create-btn{
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-create-account .primary-create-btn svg,
    #screen-create-account .secondary-create-btn svg{
      width:18px;
      height:18px;
    }

    #screen-create-account .primary-create-btn:disabled,
    #screen-create-account .secondary-create-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    #screen-create-account .mini-alert{
      border-radius:16px;
      padding:13px 14px;
      font-size:13px;
      line-height:1.5;
    }

    #screen-create-account .mini-alert.error{
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    #screen-create-account .mini-alert.success{
      background:#effdf4;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    #screen-create-account .created-state{
      padding:24px 20px;
      color:var(--muted, #6b7280);
      font-size:14px;
    }

    #screen-create-account .created-list{
      padding:0 18px 18px;
    }

    #screen-create-account .created-item{
      border:1px solid #e9eef5;
      border-radius:18px;
      padding:16px;
      margin-top:14px;
      background:#fff;
    }

    #screen-create-account .created-item:first-child{
      margin-top:18px;
    }

    #screen-create-account .created-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:10px;
    }

    #screen-create-account .created-name{
      font-size:15px;
      font-weight:900;
      color:#0f172a;
      line-height:1.35;
    }

    #screen-create-account .created-role{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      padding:6px 10px;
      font-size:11px;
      font-weight:800;
      background:#eff6ff;
      color:#1d4ed8;
      white-space:nowrap;
    }

    #screen-create-account .created-meta{
      display:grid;
      gap:8px;
    }

    #screen-create-account .created-meta-row{
      font-size:13px;
      color:#475569;
      line-height:1.45;
    }

    #screen-create-account .created-meta-label{
      font-weight:800;
      color:#0f172a;
    }

    #screen-create-account .created-empty{
      padding:24px 20px;
      color:var(--muted, #6b7280);
      font-size:14px;
    }

    @media (max-width:1180px){
      #screen-create-account .create-account-grid{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:700px){
      #screen-create-account .form-row.two{
        grid-template-columns:1fr;
      }
    }
  </style>

  <div class="create-account-wrap">
    <div class="create-account-top">
      <div>
        <h2 class="holder-title">Create Account</h2>
        <p class="holder-sub">
          Create HOD, report agent, form agent, and announcement agent accounts from here.
        </p>
      </div>
    </div>

    <div class="create-account-grid">
      <div class="create-panel">
        <div class="create-panel-head">
          <h3 class="create-panel-title">New Account</h3>
          <p class="create-panel-sub">
            Fill the details below and create a new account.
          </p>
        </div>

        <form id="createAccountForm" class="create-form">
          <div class="form-row two">
            <div class="field">
              <label for="createAccountType">Account Type</label>
              <select id="createAccountType" required>
                <option value="">Select account type</option>
                <option value="hod">HOD</option>
                <option value="report_agent">Report Agent</option>
                <option value="form_agent">Form Agent</option>
                <option value="announcement_agent">Announcement Agent</option>
              </select>
            </div>

            <div class="field">
              <label for="createFullName">Full Name</label>
              <input type="text" id="createFullName" placeholder="Enter full name" required />
            </div>
          </div>

          <div class="form-row two">
            <div class="field">
              <label for="createEmail">Email <span class="optional-text">(optional)</span></label>
              <input type="email" id="createEmail" placeholder="Enter email address" />
            </div>

            <div class="field" id="departmentFieldWrap" style="display:none;">
              <label for="createDepartment">Department</label>
              <input type="text" id="createDepartment" placeholder="Enter department name" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label>School</label>
              <div class="read-only-box" id="createSchoolDisplay">School</div>
            </div>
          </div>

          <div id="createAccountError" class="mini-alert error" style="display:none;"></div>
          <div id="createAccountSuccess" class="mini-alert success" style="display:none;"></div>

          <div class="create-actions">
            <button type="submit" class="primary-create-btn" id="createAccountBtn">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span id="createAccountBtnText">Create Account</span>
            </button>

            <button type="button" class="secondary-create-btn" id="refreshCreatedAccountsBtn">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M20 12a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M20 4v6h-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Refresh List</span>
            </button>
          </div>
        </form>
      </div>

      <div class="create-panel">
        <div class="create-panel-head">
          <h3 class="create-panel-title">Created Accounts</h3>
          <p class="create-panel-sub">
            Accounts created by this HOS will appear here.
          </p>
        </div>

        <div id="createdAccountsState" class="created-state">
          Loading created accounts...
        </div>

        <div id="createdAccountsList" class="created-list" style="display:none;"></div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      if (window.__createAccountSectionInit) return;
      window.__createAccountSectionInit = true;

      function escapeHtml(value){
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function hideCreateMessages(){
        const err = document.getElementById("createAccountError");
        const ok = document.getElementById("createAccountSuccess");
        if (err) {
          err.style.display = "none";
          err.textContent = "";
        }
        if (ok) {
          ok.style.display = "none";
          ok.textContent = "";
        }
      }

      function showCreateError(message){
        const err = document.getElementById("createAccountError");
        const ok = document.getElementById("createAccountSuccess");
        if (ok) {
          ok.style.display = "none";
          ok.textContent = "";
        }
        if (err) {
          err.textContent = message;
          err.style.display = "block";
        }
      }

      function showCreateSuccess(message){
        const err = document.getElementById("createAccountError");
        const ok = document.getElementById("createAccountSuccess");
        if (err) {
          err.style.display = "none";
          err.textContent = "";
        }
        if (ok) {
          ok.textContent = message;
          ok.style.display = "block";
        }
      }

      function normalizeRoleLabel(role, functionType){
        if (role === "hod") return "HOD";
        if (role === "report_agent") return "Report Agent";
        if (role === "form_agent") return "Form Agent";
        if (role === "announcement_agent") return "Announcement Agent";
        if (role === "agent" && functionType === "report") return "Report Agent";
        if (role === "agent" && functionType === "form") return "Form Agent";
        if (role === "agent" && functionType === "announcement") return "Announcement Agent";
        return role || "Account";
      }

      function getCreateFunctionName(type){
        if (type === "hod") return "create-hod-account";
        if (type === "report_agent") return "create-report-agent-account";
        if (type === "form_agent") return "create-form-agent-account";
        if (type === "announcement_agent") return "create-announcement-agent-account";
        return "";
      }

      function setCreateLoading(isLoading){
        const btn = document.getElementById("createAccountBtn");
        const btnText = document.getElementById("createAccountBtnText");
        const refreshBtn = document.getElementById("refreshCreatedAccountsBtn");
        if (btn) btn.disabled = isLoading;
        if (refreshBtn) refreshBtn.disabled = isLoading;
        if (btnText) btnText.textContent = isLoading ? "Creating..." : "Create Account";
      }

      function setCreatedAccountsLoading(message){
        const state = document.getElementById("createdAccountsState");
        const list = document.getElementById("createdAccountsList");
        if (state) {
          state.textContent = message || "Loading...";
          state.style.display = "block";
        }
        if (list) {
          list.style.display = "none";
          list.innerHTML = "";
        }
      }

      function renderCreatedAccounts(items){
        const state = document.getElementById("createdAccountsState");
        const list = document.getElementById("createdAccountsList");

        if (!list || !state) return;

        if (!Array.isArray(items) || !items.length) {
          state.style.display = "block";
          state.innerHTML = '<div class="created-empty">No created accounts yet.</div>';
          list.style.display = "none";
          list.innerHTML = "";
          return;
        }

        state.style.display = "none";
        list.style.display = "block";
        list.innerHTML = items.map((item) => {
          const fullName = item.full_name || "No name";
          const role = item.account_type || "";
          const functionType = item.function_type || "";
          const email = item.linked_email || "—";
          const department = item.department_name || "—";
          const loginId = item.login_id || "—";
          const activeText = item.is_active ? "Active" : "Disabled";

          return `
            <div class="created-item">
              <div class="created-top">
                <div class="created-name">${escapeHtml(fullName)}</div>
                <div class="created-role">${escapeHtml(normalizeRoleLabel(role, functionType))}</div>
              </div>

              <div class="created-meta">
                <div class="created-meta-row">
                  <span class="created-meta-label">Login ID:</span>
                  <span>${escapeHtml(loginId)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Email:</span>
                  <span>${escapeHtml(email)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Department:</span>
                  <span>${escapeHtml(department)}</span>
                </div>

                <div class="created-meta-row">
                  <span class="created-meta-label">Status:</span>
                  <span>${escapeHtml(activeText)}</span>
                </div>
              </div>
            </div>
          `;
        }).join("");
      }

      async function callHosEdgeFunction(functionName, payload){
        if (!window.SUPABASE_URL || !window.SUPABASE_ANON_KEY) {
          throw new Error("SUPABASE_URL or SUPABASE_ANON_KEY is missing in your main script.");
        }

        const headers = {
          "Content-Type": "application/json",
          "apikey": window.SUPABASE_ANON_KEY
        };

        const res = await fetch(`${window.SUPABASE_URL}/functions/v1/${functionName}`, {
          method: "POST",
          headers,
          body: JSON.stringify(payload)
        });

        let data = null;
        try {
          data = await res.json();
        } catch {
          data = null;
        }

        if (!res.ok || !data || data.ok === false) {
          const message =
            (data && (data.error || data.message)) ||
            `Request failed for ${functionName}`;
          throw new Error(message);
        }

        return data;
      }

      function getHosAdminId(){
        if (window.adminSession) {
          return (window.adminSession.account && window.adminSession.account.id) || window.adminSession.id || "";
        }
        return "";
      }

      function getHosSchoolName(){
        if (window.adminSession) {
          return (window.adminSession.account && window.adminSession.account.school_name) || window.adminSession.school_name || "School";
        }
        return "School";
      }

      async function loadCreatedAccounts(){
        try {
          setCreatedAccountsLoading("Loading created accounts...");

          const hosAdminId = getHosAdminId();
          if (!hosAdminId) {
            throw new Error("HOS session not found.");
          }

          const data = await callHosEdgeFunction("list-hos-created-accounts", {
            hos_admin_id: hosAdminId
          });

          renderCreatedAccounts(data.accounts || []);
        } catch (error) {
          const state = document.getElementById("createdAccountsState");
          const list = document.getElementById("createdAccountsList");

          if (list) {
            list.style.display = "none";
            list.innerHTML = "";
          }

          if (state) {
            state.style.display = "block";
            state.textContent = error.message || "Could not load created accounts.";
          }
        }
      }

      function initCreateAccountSection(){
        const accountType = document.getElementById("createAccountType");
        const fullName = document.getElementById("createFullName");
        const email = document.getElementById("createEmail");
        const department = document.getElementById("createDepartment");
        const departmentWrap = document.getElementById("departmentFieldWrap");
        const schoolDisplay = document.getElementById("createSchoolDisplay");
        const form = document.getElementById("createAccountForm");
        const refreshBtn = document.getElementById("refreshCreatedAccountsBtn");

        if (!form) return;

        if (schoolDisplay) {
          schoolDisplay.textContent = getHosSchoolName();
        }

        function updateDepartmentVisibility(){
          const isHod = accountType.value === "hod";
          departmentWrap.style.display = isHod ? "grid" : "none";
          department.required = isHod;
          if (!isHod) department.value = "";
        }

        accountType.addEventListener("change", updateDepartmentVisibility);
        updateDepartmentVisibility();

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          hideCreateMessages();

          const type = accountType.value.trim();
          const name = fullName.value.trim();
          const mail = email.value.trim();
          const dept = department.value.trim();

          if (!type) {
            showCreateError("Select an account type.");
            return;
          }

          if (!name) {
            showCreateError("Full name is required.");
            return;
          }

          if (type === "hod" && !dept) {
            showCreateError("Department is required for HOD.");
            return;
          }

          const functionName = getCreateFunctionName(type);
          if (!functionName) {
            showCreateError("Invalid account type selected.");
            return;
          }

          const hosAdminId = getHosAdminId();
          if (!hosAdminId) {
            showCreateError("HOS session not found.");
            return;
          }

          const payload = {
            hos_admin_id: hosAdminId,
            full_name: name
          };

          if (type === "hod") {
            payload.department_name = dept;
          } else if (mail) {
            payload.email = mail;
          }

          setCreateLoading(true);

          try {
            const data = await callHosEdgeFunction(functionName, payload);

            let loginId = "";
            const tempPassword = data.temporary_password || "";

            if (type === "hod") {
              loginId = (data.hod_account && data.hod_account.login_id) || "";
            } else if (type === "report_agent") {
              loginId = (data.report_agent_account && data.report_agent_account.login_id) || "";
            } else if (type === "form_agent") {
              loginId = (data.form_agent_account && data.form_agent_account.login_id) || "";
            } else if (type === "announcement_agent") {
              loginId = (data.announcement_agent_account && data.announcement_agent_account.login_id) || "";
            }

            showCreateSuccess(
              `${normalizeRoleLabel(type)} created successfully. Login ID: ${loginId || "Generated"} | Temporary Password: ${tempPassword || "Generated"}`
            );

            form.reset();
            updateDepartmentVisibility();
            await loadCreatedAccounts();
          } catch (error) {
            showCreateError(error.message || "Could not create account.");
          } finally {
            setCreateLoading(false);
          }
        });

        if (refreshBtn) {
          refreshBtn.addEventListener("click", loadCreatedAccounts);
        }

        loadCreatedAccounts();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCreateAccountSection);
      } else {
        initCreateAccountSection();
      }
    })();
  </script>
</section>
