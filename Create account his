<!-- CREATE ACCOUNT -->
<section class="screen" id="screen-create-account">
  <style>
    #screen-create-account{
      padding:8px 6px 40px;
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
    }

    #screen-create-account .hero{
      padding:4px 4px 6px;
      margin-bottom:6px;
    }

    #screen-create-account .hero-line-1{
      font-size:12px;
      font-weight:500;
      color:var(--muted);
      margin-bottom:3px;
    }

    #screen-create-account .hero-title{
      font-size:20px;
      font-weight:800;
      letter-spacing:-0.03em;
      line-height:1.2;
      color:var(--text);
      margin:0;
    }

    #screen-create-account .hero-title span{
      color:var(--blue);
      font-weight:600;
    }

    #screen-create-account .section-title{
      font-size:13px;
      font-weight:600;
      color:var(--text);
      margin:8px 2px 4px;
    }

    #screen-create-account .section-sub{
      font-size:12px;
      color:var(--muted);
      margin:0 2px 8px;
      line-height:1.45;
    }

    #screen-create-account .card{
      background:#f9fafb;
      border-radius:18px;
      padding:10px 10px;
      border:1px solid #e5e7eb;
      margin-bottom:14px;
      box-shadow:0 10px 30px rgba(15,23,42,.06);
    }

    #screen-create-account .field-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    #screen-create-account .field{
      display:flex;
      flex-direction:column;
      gap:6px;
      margin-bottom:10px;
    }

    #screen-create-account .field.full{
      grid-column:1 / -1;
    }

    #screen-create-account .field label{
      font-size:12px;
      font-weight:600;
      color:var(--text);
    }

    #screen-create-account .text-input,
    #screen-create-account .select-input{
      width:100%;
      height:46px;
      border-radius:999px;
      border:1px solid #e5e7eb;
      background:#fff;
      padding:0 14px;
      font-size:15px;
      color:var(--text);
    }

    #screen-create-account .text-input:focus,
    #screen-create-account .select-input:focus,
    #screen-create-account .search-input:focus{
      outline:none;
      border-color:#2563eb;
      box-shadow:0 0 0 2px rgba(37,99,235,.18);
    }

    #screen-create-account .field-help{
      font-size:11px;
      color:var(--muted);
      line-height:1.4;
    }

    #screen-create-account .create-layout{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:14px;
      align-items:start;
    }

    #screen-create-account .result-box{
      border-radius:16px;
      border:1px solid #e5e7eb;
      background:#fff;
      padding:12px;
      margin-bottom:10px;
      display:none;
    }

    #screen-create-account .result-title{
      font-size:13px;
      font-weight:700;
      color:var(--text);
      margin-bottom:10px;
    }

    #screen-create-account .result-row{
      display:flex;
      justify-content:space-between;
      gap:12px;
      padding:9px 0;
      border-top:1px solid #eef2f7;
    }

    #screen-create-account .result-row:first-of-type{
      border-top:none;
      padding-top:0;
    }

    #screen-create-account .result-key{
      font-size:12px;
      color:var(--muted);
      font-weight:600;
    }

    #screen-create-account .result-value{
      font-size:13px;
      color:var(--text);
      font-weight:700;
      text-align:right;
      word-break:break-word;
    }

    #screen-create-account .copy-row{
      display:flex;
      gap:8px;
      margin-top:10px;
    }

    #screen-create-account .mini-btn{
      flex:1;
      border-radius:999px;
      padding:9px 12px;
      font-size:13px;
      border:1px solid #e5e7eb;
      background:#ffffff;
      cursor:pointer;
      color:var(--text);
      font-weight:600;
    }

    #screen-create-account .secondary-btn{
      border-radius:999px;
      padding:9px 12px;
      font-size:13px;
      border:1px solid #e5e7eb;
      background:#ffffff;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      color:var(--text);
      font-weight:600;
      width:100%;
      margin-top:6px;
    }

    #screen-create-account .secondary-btn svg{
      width:16px;
      height:16px;
    }

    #screen-create-account .primary-btn{
      width:100%;
      margin-top:10px;
      border-radius:999px;
      border:none;
      padding:12px 14px;
      font-size:15px;
      font-weight:600;
      cursor:pointer;
      color:#ffffff;
      background:linear-gradient(135deg, var(--blue), var(--blue-dark));
      box-shadow:0 14px 35px rgba(37,99,235,.45);
      transition:background .15s, transform .05s, box-shadow .15s;
    }

    #screen-create-account .primary-btn:hover{
      background:var(--blue-dark);
    }

    #screen-create-account .primary-btn:active{
      transform:scale(.97);
    }

    #screen-create-account .primary-btn:disabled{
      background:#93c5fd;
      cursor:not-allowed;
      box-shadow:none;
    }

    #screen-create-account .message{
      margin-top:8px;
      font-size:12px;
      text-align:center;
      white-space:pre-line;
      display:none;
    }

    #screen-create-account .message.error{
      color:#dc2626;
    }

    #screen-create-account .message.success{
      color:#15803d;
    }

    #screen-create-account .search-row{
      display:flex;
      gap:6px;
      margin-bottom:8px;
      align-items:center;
      flex-wrap:wrap;
    }

    #screen-create-account .search-input{
      flex:1;
      min-width:220px;
      padding:10px 12px;
      border-radius:999px;
      border:1px solid #e5e7eb;
      font-size:14px;
      background:#fff;
    }

    #screen-create-account .stat-chip{
      border-radius:999px;
      padding:8px 10px;
      font-size:11px;
      font-weight:700;
      border:1px solid #e5e7eb;
      background:#fff;
      color:#334155;
      white-space:nowrap;
    }

    #screen-create-account .table-wrap{
      width:100%;
      overflow:auto;
      border-radius:16px;
      border:1px solid #e5e7eb;
      background:#fff;
    }

    #screen-create-account table{
      width:100%;
      border-collapse:collapse;
      min-width:860px;
    }

    #screen-create-account th,
    #screen-create-account td{
      text-align:left;
      padding:12px 12px;
      border-bottom:1px solid #eef2f7;
      font-size:13px;
      vertical-align:top;
    }

    #screen-create-account th{
      background:#f8fafc;
      color:#64748b;
      font-weight:700;
    }

    #screen-create-account td{
      color:var(--text);
      font-weight:500;
    }

    #screen-create-account tr:last-child td{
      border-bottom:none;
    }

    #screen-create-account .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:74px;
      padding:5px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      white-space:nowrap;
    }

    #screen-create-account .pill.type{
      background:#eff6ff;
      color:#1d4ed8;
    }

    #screen-create-account .pill.status{
      background:#ecfdf5;
      color:#15803d;
    }

    #screen-create-account .empty-box{
      padding:24px 14px;
      text-align:center;
      color:var(--muted);
      font-size:12px;
      font-weight:600;
    }

    @media (max-width: 1080px){
      #screen-create-account .create-layout{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 720px){
      #screen-create-account .field-grid{
        grid-template-columns:1fr;
      }
    }
  </style>

  <section class="hero">
    <div class="hero-line-1">Create Account</div>
    <h1 class="hero-title">
      Create admin account<br />
      <span>Choose HOD or agent type</span>
    </h1>
  </section>

  <section>
    <div class="section-title">1. Enter account details</div>
    <div class="section-sub">
      Choose the account type, enter full name, add email if available, and create the account.
      Department is required only for HOD.
    </div>

    <div class="create-layout">
      <div class="card">
        <div class="field-grid">
          <div class="field">
            <label for="createAccountType">Account type</label>
            <select id="createAccountType" class="select-input">
              <option value="">Select account type</option>
              <option value="hod">HOD account</option>
              <option value="report_agent">Report agent</option>
              <option value="form_agent">Form agent</option>
              <option value="announcement_agent">Announcement agent</option>
            </select>
          </div>

          <div class="field">
            <label for="createFullName">Full name</label>
            <input
              id="createFullName"
              type="text"
              class="text-input"
              placeholder="Enter full name"
            />
          </div>

          <div class="field full">
            <label for="createEmail">Email (optional)</label>
            <input
              id="createEmail"
              type="email"
              class="text-input"
              placeholder="Enter email address"
            />
          </div>

          <div class="field full" id="createDepartmentWrap">
            <label for="createDepartment">Department</label>
            <input
              id="createDepartment"
              type="text"
              class="text-input"
              placeholder="Enter department name"
            />
            <div class="field-help">Only needed when creating HOD account.</div>
          </div>
        </div>

        <button id="createAccountBtn" class="primary-btn" type="button">
          Create account
        </button>

        <button id="clearCreateAccountBtn" class="secondary-btn" type="button">
          <svg viewBox="0 0 20 20" fill="none">
            <path
              d="M5 5l10 10M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
          <span>Clear form</span>
        </button>

        <div id="createAccountError" class="message error"></div>
        <div id="createAccountSuccess" class="message success"></div>
      </div>

      <div class="card">
        <div id="createdAccountBox" class="result-box">
          <div class="result-title">Generated account details</div>

          <div class="result-row">
            <div class="result-key">Type</div>
            <div id="generatedType" class="result-value">-</div>
          </div>

          <div class="result-row">
            <div class="result-key">Full name</div>
            <div id="generatedFullName" class="result-value">-</div>
          </div>

          <div class="result-row">
            <div class="result-key">Login ID</div>
            <div id="generatedLoginId" class="result-value">-</div>
          </div>

          <div class="result-row">
            <div class="result-key">Temporary password</div>
            <div id="generatedPassword" class="result-value">-</div>
          </div>

          <div class="copy-row">
            <button id="copyGeneratedLoginBtn" class="mini-btn" type="button">Copy login</button>
            <button id="copyGeneratedPasswordBtn" class="mini-btn" type="button">Copy password</button>
          </div>
        </div>

        <div class="result-box" style="display:block;">
          <div class="result-title">Notes</div>
          <div class="field-help" style="font-size:12px;">
            HOD account creates a department head.<br />
            Agent account types are Report agent, Form agent, and Announcement agent.<br />
            After creation, the generated login ID and password will appear here.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-title">2. Created accounts</div>
    <div class="section-sub">
      View all HOD and agent accounts created under this HOS.
    </div>

    <div class="card">
      <div class="search-row">
        <input
          id="createAccountSearch"
          type="text"
          class="search-input"
          placeholder="Search by full name, type, login ID or email…"
        />

        <div class="stat-chip">HOD: <span id="countHodAccounts">0</span></div>
        <div class="stat-chip">Report: <span id="countReportAgents">0</span></div>
        <div class="stat-chip">Form: <span id="countFormAgents">0</span></div>
        <div class="stat-chip">Announcement: <span id="countAnnouncementAgents">0</span></div>
        <div class="stat-chip">Total: <span id="countAllHosAccounts">0</span></div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Full name</th>
              <th>Type</th>
              <th>Department</th>
              <th>Login ID</th>
              <th>Email</th>
              <th>Status</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody id="hosCreatedAccountsBody">
            <tr>
              <td colspan="7">
                <div class="empty-box">Loading accounts...</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    let hosCreatedAccounts = [];
    let lastGeneratedHosLoginId = "";
    let lastGeneratedHosPassword = "";

    function showCreateAccountError(msg) {
      const e = document.getElementById("createAccountError");
      const s = document.getElementById("createAccountSuccess");
      if (s) s.style.display = "none";
      if (e) {
        e.textContent = msg || "";
        e.style.display = msg ? "block" : "none";
      }
    }

    function showCreateAccountSuccess(msg) {
      const e = document.getElementById("createAccountError");
      const s = document.getElementById("createAccountSuccess");
      if (e) e.style.display = "none";
      if (s) {
        s.textContent = msg || "";
        s.style.display = msg ? "block" : "none";
      }
    }

    function clearCreateAccountMessages() {
      showCreateAccountError("");
      showCreateAccountSuccess("");
    }

    function formatHosAccountType(row) {
      if (!row) return "-";
      if (row.account_type === "hod" || row.function_type === "hod") return "HOD";
      if (row.function_type === "report") return "Report agent";
      if (row.function_type === "form") return "Form agent";
      if (row.function_type === "announcement") return "Announcement agent";
      if (row.account_type === "agent") return "Agent";
      return "-";
    }

    function formatHosAccountDate(value) {
      if (!value) return "-";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return "-";
      return d.toLocaleString();
    }

    function escapeHosHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function updateCreateDepartmentVisibility() {
      const type = document.getElementById("createAccountType")?.value || "";
      const wrap = document.getElementById("createDepartmentWrap");
      const input = document.getElementById("createDepartment");

      if (!wrap || !input) return;

      if (type === "hod") {
        wrap.style.display = "";
      } else {
        wrap.style.display = "none";
        input.value = "";
      }
    }

    function updateHosCreateCounts(counts = {}) {
      const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(value ?? 0);
      };

      setText("countHodAccounts", counts.hods || 0);
      setText("countReportAgents", counts.report_agents || 0);
      setText("countFormAgents", counts.form_agents || 0);
      setText("countAnnouncementAgents", counts.announcement_agents || 0);
      setText("countAllHosAccounts", counts.total || 0);
    }

    function renderHosCreatedAccounts() {
      const tbody = document.getElementById("hosCreatedAccountsBody");
      const search = (document.getElementById("createAccountSearch")?.value || "").trim().toLowerCase();

      if (!tbody) return;

      const filtered = hosCreatedAccounts.filter((row) => {
        const hay = [
          row.full_name,
          row.account_type,
          row.function_type,
          row.department_name,
          row.login_id,
          row.linked_email
        ]
          .map(v => String(v || "").toLowerCase())
          .join(" ");
        return !search || hay.includes(search);
      });

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              <div class="empty-box">No accounts found.</div>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map((row) => `
        <tr>
          <td>${escapeHosHtml(row.full_name || "-")}</td>
          <td><span class="pill type">${escapeHosHtml(formatHosAccountType(row))}</span></td>
          <td>${escapeHosHtml(row.department_name || "-")}</td>
          <td>${escapeHosHtml(row.login_id || "-")}</td>
          <td>${escapeHosHtml(row.linked_email || "-")}</td>
          <td><span class="pill status">${row.is_active ? "Active" : "Inactive"}</span></td>
          <td>${escapeHosHtml(formatHosAccountDate(row.created_at))}</td>
        </tr>
      `).join("");
    }

    async function loadHosCreatedAccounts() {
      const tbody = document.getElementById("hosCreatedAccountsBody");
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              <div class="empty-box">Loading accounts...</div>
            </td>
          </tr>
        `;
      }

      try {
        const hosSessionRaw = sessionStorage.getItem("colspot_hos_session");
        if (!hosSessionRaw) {
          throw new Error("HOS session not found. Please sign in again.");
        }

        const hosSession = JSON.parse(hosSessionRaw);
        const hosAdminId = hosSession?.id;

        if (!hosAdminId) {
          throw new Error("Invalid HOS session. Please sign in again.");
        }

        if (typeof supabase === "undefined") {
          throw new Error("Supabase is not ready.");
        }

        const { data, error } = await supabase.functions.invoke("list-hos-created-accounts", {
          body: { hos_admin_id: hosAdminId }
        });

        if (error) throw error;
        if (!data?.ok) throw new Error(data?.error || "Could not load accounts.");

        hosCreatedAccounts = Array.isArray(data.accounts) ? data.accounts : [];
        updateHosCreateCounts(data.counts || {});
        renderHosCreatedAccounts();
      } catch (err) {
        console.error(err);
        if (tbody) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7">
                <div class="empty-box">${escapeHosHtml(err.message || "Could not load accounts.")}</div>
              </td>
            </tr>
          `;
        }
      }
    }

    async function createHosManagedAccount() {
      clearCreateAccountMessages();

      const type = (document.getElementById("createAccountType")?.value || "").trim();
      const fullName = (document.getElementById("createFullName")?.value || "").trim();
      const email = (document.getElementById("createEmail")?.value || "").trim();
      const departmentName = (document.getElementById("createDepartment")?.value || "").trim();
      const btn = document.getElementById("createAccountBtn");

      if (!type) {
        showCreateAccountError("Please choose an account type.");
        return;
      }

      if (!fullName) {
        showCreateAccountError("Please enter full name.");
        return;
      }

      if (type === "hod" && !departmentName) {
        showCreateAccountError("Please enter department name for HOD account.");
        return;
      }

      let hosSession;
      try {
        hosSession = JSON.parse(sessionStorage.getItem("colspot_hos_session") || "{}");
      } catch {
        hosSession = null;
      }

      if (!hosSession?.id) {
        showCreateAccountError("HOS session not found. Please sign in again.");
        return;
      }

      if (typeof supabase === "undefined") {
        showCreateAccountError("Supabase is not ready.");
        return;
      }

      let functionName = "";
      let payload = {
        hos_admin_id: hosSession.id,
        full_name: fullName,
        email: email || null,
        linked_email: email || null
      };

      if (type === "hod") {
        functionName = "create-hod-account";
        payload.department_name = departmentName;
      } else if (type === "report_agent") {
        functionName = "create-report-agent-account";
      } else if (type === "form_agent") {
        functionName = "create-form-agent-account";
      } else if (type === "announcement_agent") {
        functionName = "create-announcement-agent-account";
      }

      if (!functionName) {
        showCreateAccountError("Invalid account type selected.");
        return;
      }

      btn.disabled = true;
      btn.textContent = "Creating...";

      try {
        const { data, error } = await supabase.functions.invoke(functionName, {
          body: payload
        });

        if (error) throw error;
        if (!data?.ok) throw new Error(data?.error || "Could not create account.");

        let created = null;
        if (type === "hod") created = data.hod_account || null;
        if (type === "report_agent") created = data.report_agent_account || null;
        if (type === "form_agent") created = data.form_agent_account || null;
        if (type === "announcement_agent") created = data.announcement_agent_account || null;

        lastGeneratedHosLoginId = created?.login_id || "";
        lastGeneratedHosPassword = data.temporary_password || "";

        const box = document.getElementById("createdAccountBox");
        const typeEl = document.getElementById("generatedType");
        const nameEl = document.getElementById("generatedFullName");
        const loginEl = document.getElementById("generatedLoginId");
        const passEl = document.getElementById("generatedPassword");

        if (typeEl) typeEl.textContent = formatHosAccountType({
          account_type: type === "hod" ? "hod" : "agent",
          function_type: type === "hod" ? "hod" : type.replace("_agent", "")
        });
        if (nameEl) nameEl.textContent = created?.full_name || fullName || "-";
        if (loginEl) loginEl.textContent = lastGeneratedHosLoginId || "-";
        if (passEl) passEl.textContent = lastGeneratedHosPassword || "-";
        if (box) box.style.display = "block";

        showCreateAccountSuccess("Account created successfully.");

        const fullNameInput = document.getElementById("createFullName");
        const emailInput = document.getElementById("createEmail");
        const deptInput = document.getElementById("createDepartment");

        if (fullNameInput) fullNameInput.value = "";
        if (emailInput) emailInput.value = "";
        if (deptInput) deptInput.value = "";

        await loadHosCreatedAccounts();
      } catch (err) {
        console.error(err);
        showCreateAccountError(err.message || "Could not create account.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Create account";
      }
    }

    function clearHosCreateForm() {
      const type = document.getElementById("createAccountType");
      const fullName = document.getElementById("createFullName");
      const email = document.getElementById("createEmail");
      const department = document.getElementById("createDepartment");
      const box = document.getElementById("createdAccountBox");
      const typeEl = document.getElementById("generatedType");
      const nameEl = document.getElementById("generatedFullName");
      const loginEl = document.getElementById("generatedLoginId");
      const passEl = document.getElementById("generatedPassword");

      if (type) type.value = "";
      if (fullName) fullName.value = "";
      if (email) email.value = "";
      if (department) department.value = "";

      if (box) box.style.display = "none";
      if (typeEl) typeEl.textContent = "-";
      if (nameEl) nameEl.textContent = "-";
      if (loginEl) loginEl.textContent = "-";
      if (passEl) passEl.textContent = "-";

      lastGeneratedHosLoginId = "";
      lastGeneratedHosPassword = "";

      clearCreateAccountMessages();
      updateCreateDepartmentVisibility();
    }

    async function copyHosCreateText(text, successMessage) {
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        showCreateAccountSuccess(successMessage);
      } catch (err) {
        console.error(err);
        showCreateAccountError("Could not copy.");
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const type = document.getElementById("createAccountType");
      const createBtn = document.getElementById("createAccountBtn");
      const clearBtn = document.getElementById("clearCreateAccountBtn");
      const search = document.getElementById("createAccountSearch");
      const copyLoginBtn = document.getElementById("copyGeneratedLoginBtn");
      const copyPasswordBtn = document.getElementById("copyGeneratedPasswordBtn");

      if (type) {
        type.addEventListener("change", updateCreateDepartmentVisibility);
        updateCreateDepartmentVisibility();
      }

      if (createBtn) {
        createBtn.addEventListener("click", createHosManagedAccount);
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", clearHosCreateForm);
      }

      if (search) {
        search.addEventListener("input", renderHosCreatedAccounts);
      }

      if (copyLoginBtn) {
        copyLoginBtn.addEventListener("click", () => {
          if (!lastGeneratedHosLoginId) return;
          copyHosCreateText(lastGeneratedHosLoginId, "Generated login ID copied");
        });
      }

      if (copyPasswordBtn) {
        copyPasswordBtn.addEventListener("click", () => {
          if (!lastGeneratedHosPassword) return;
          copyHosCreateText(lastGeneratedHosPassword, "Generated password copied");
        });
      }

      loadHosCreatedAccounts();
    });
  </script>
</section>
