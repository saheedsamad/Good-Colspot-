  async function getNearbyCurrentUser() {
    if (window.ColspotGuard && ColspotGuard.GuardState && ColspotGuard.GuardState.user) {
      return { user: ColspotGuard.GuardState.user, networkIssue: false };
    }

    if (typeof supabase === "undefined") {
      return { user: null, networkIssue: true };
    }

    try {
      const { data, error } = await supabase.auth.getUser();

      if (error || !data || !data.user) {
        const isNet =
          window.ColspotGuard &&
          typeof ColspotGuard.isLikelyOfflineError === "function" &&
          ColspotGuard.isLikelyOfflineError(error);
        return { user: null, networkIssue: !!isNet };
      }

      const user = data.user;
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.saveLocalUserFromSupabaseUser === "function"
      ) {
        ColspotGuard.saveLocalUserFromSupabaseUser(user);
      }
      return { user, networkIssue: false };
    } catch (e) {
      const isNet =
        window.ColspotGuard &&
        typeof ColspotGuard.isLikelyOfflineError === "function" &&
        ColspotGuard.isLikelyOfflineError(e);
      return { user: null, networkIssue: !!isNet };
    }
  }

  async function prepareNearbyConfirm() {
    if (!selectedNearbySession) {
      showNearbyJoinError("Please pick a session first.");
      return;
    }

    clearNearbyJoinMessages();
    showStudentDetailsForm(false);

    const pin = (document.getElementById("joinPin")?.value || "").trim();
    if (!pin) {
      showNearbyJoinError("Please enter the PIN code.");
      return;
    }

    if (String(pin) !== String(selectedNearbySession.pin_code)) {
      showNearbyJoinError("Incorrect PIN. Please check and try again.");
      return;
    }

    if (isColspotOffline()) {
      showNearbyJoinError("No internet connection. Please connect and try again.");
      return;
    }

    if (typeof supabase === "undefined") {
      showNearbyJoinError(
        "We couldn't connect to the server. Please check your internet and try again."
      );
      return;
    }

    const { user, networkIssue } = await getNearbyCurrentUser();

    if (networkIssue) {
      showNearbyJoinError("Network is bad. Please check your data and try again.");
      return;
    }

    if (!user) {
      showNearbyJoinError("Session expired. Please sign in again.");
      return;
    }

    const verificationCheck = await ensureTopVerificationBeforeJoin();
    if (!verificationCheck.ok) {
      showNearbyJoinError(verificationCheck.message);
      return;
    }

    const membershipCheck = await ensureStudentIsClassMember(user.id, selectedNearbySession);
    if (!membershipCheck.ok) {
      showNearbyJoinError(membershipCheck.message);
      return;
    }

    let profile = null;
    try {
      const { data, error } = await supabase
        .from("student_profiles")
        .select("full_name, matric_number, department")
        .eq("user_id", user.id)
        .maybeSingle();

      if (error) {
        showNearbyJoinError(
          "We couldn't load your details. Please check your internet and try again."
        );
        return;
      }

      profile = data;
    } catch (e) {
      showNearbyJoinError(
        "We couldn't load your details. Please check your internet and try again."
      );
      return;
    }

    const studentName = (profile?.full_name || "").trim();
    const studentMatric = (profile?.matric_number || "").trim();
    const studentDepartment = (profile?.department || "").trim();

    if (!profile || !studentMatric || !studentDepartment || !studentName) {
      pendingStudentProfileUser = user;
      pendingPinForStudentProfile = pin;
      showStudentDetailsForm(true);
      showNearbyJoinError(
        "We couldn't find your student details. Please enter your Matric number and Department, then tap Save."
      );
      return;
