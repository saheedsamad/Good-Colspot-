<script>
  if (typeof STUDENT_HISTORY_KEY === "undefined") {
    var STUDENT_HISTORY_KEY = "colspot_student_history";
  }

  const PENDING_NEARBY_JOIN_KEY = "colspot_pending_nearby_join";
  const FACE_VERIFY_PAGE_URL = "face_verification.html";

  // detection action pages
  const COURSE_FORM_PAGE_URL = "verify-class.html";
  const BIOMETRIC_PAGE_URL = "face-capture.html";

  let pendingNearbyJoinContext = null;
  let nearbyFinalizingJoin = false;

  // verification state
  let nearbyVerificationState = {
    loading: true,
    hasUser: false,
    courseFormOk: false,
    biometricOk: false,
    missingItems: [],
  };

  function addToStudentHistory(entry) {
    try {
      const raw = localStorage.getItem(STUDENT_HISTORY_KEY);
      let list = [];
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) list = parsed;
        } catch (_) {}
      }

      list = list.filter(
        (item) =>
          !(
            item.session_id === entry.session_id &&
            item.student_matric === entry.student_matric
          )
      );

      list.unshift(entry);
      list = list.slice(0, 50);

