  async function accountDeleteAccount() {
    if (!accountCurrentUser) {
      alert("We could not find your account. Please sign in again.");
      return;
    }

    const confirmed = window.confirm(
      "This will permanently delete your Colspot data for this account, including classes, attendance sessions, attendees, warmup locations, scans and linked devices. You won’t be able to undo this. Continue?"
    );
    if (!confirmed) return;

    const typed = window.prompt(
      "To confirm, type DELETE in capital letters and tap OK."
    );
    if (!typed || typed.trim().toUpperCase() !== "DELETE") {
      alert("Account deletion cancelled. You did not type DELETE.");
      return;
    }

    const userId = accountCurrentUser.id;

    try {
      if (typeof supabase !== "undefined") {
        let sessionIds = [];
        try {
          const { data: sessions, error: sessionsError } = await supabase
            .from("attendance_sessions")
            .select("id")
            .eq("created_by", userId);

          if (!sessionsError && sessions && sessions.length > 0) {
            sessionIds = sessions.map((s) => s.id);
          }
        } catch (e) {
          console.warn("Could not load lecturer sessions for delete:", e);
        }

        const deletions = [];

        if (sessionIds.length > 0) {
          deletions.push(
            supabase
              .from("attendance_records")
              .delete()
              .in("session_id", sessionIds)
          );
        }

        deletions.push(
          supabase.from("user_devices").delete().eq("user_id", userId)
        );

        deletions.push(
          supabase
            .from("attendance_warmup_main")
            .delete()
            .eq("lecturer_id", userId)
        );
        deletions.push(
          supabase
            .from("attendance_warmup_attendance")
            .delete()
            .eq("lecturer_id", userId)
        );

        deletions.push(
          supabase
            .from("attendance_sessions")
            .delete()
            .eq("created_by", userId)
        );

        deletions.push(
          supabase.from("scan_sheets").delete().eq("user_id", userId)
        );

        deletions.push(
          supabase.from("lecturers").delete().eq("id", userId)
        );

        await Promise.allSettled(deletions);

        try {
          if (supabase.functions && supabase.functions.invoke) {
            await supabase.functions.invoke("delete_my_account", {
              body: {}
            });
          }
        } catch (e) {
          console.warn("delete_my_account function failed:", e);
        }

        try {
          await supabase.auth.signOut();
        } catch (e) {
          console.warn("signOut after delete failed:", e);
        }
      }

      try {
        localStorage.removeItem("colspot_local_user");
        localStorage.removeItem("colspot_history_cache");
        localStorage.removeItem("colspot_scan_cache");
        localStorage.removeItem(ACCOUNT_DEVICE_STORAGE_KEY);
      } catch (e) {
        console.warn("Failed to clear local cache on delete:", e);
      }

      alert("Your Colspot data for this account has been deleted.");
      window.location.href = "index.html";
    } catch (e) {
      console.error("accountDeleteAccount error:", e);
      alert(
        "We could not delete your data. Please check your internet connection and try again."
      );
    }
  }

