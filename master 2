  async function downloadFullHistoryCsv() {
    if (!combinedHistoryItems.length) {
      alert("No history to export yet.");
      return;
    }

    const header = [
      "Type",
      "Title",
      "Subtitle",
      "Created at",
      "Extra"
    ];

    const esc = (v) => `"${String(v).replace(/"/g, '""')}"`;

    const rows = combinedHistoryItems.map((item) => {
      if (item.type === "student") {
        const e = item.entry;
        return [
          "Student attendance",
          e.course_code || "",
          e.lecturer_name || "",
          e.attended_at || "",
          e.student_matric || ""
        ].map(esc).join(",");
      }

      if (item.type === "class") {
        const c = item.course;
        return [
          "Created class",
          c.course_code || "",
          c.course_title || "",
          c.created_at || "",
          c.invite_code || ""
        ].map(esc).join(",");
      }

      if (item.type === "attendance_session") {
        const s = item.session;
        return [
          "Attendance session",
          s.course_code || "",
          s.course_title || s.lecturer_name || "",
          s.created_at || s.starts_at || "",
          s.pin_code || ""
        ].map(esc).join(",");
      }

      if (item.type === "activity") {
        const a = item.activity;
        return [
          "Class activity",
          a.title || "",
          `${a.course_code || ""} ${a.course_title || ""}`.trim(),
          a.created_at || "",
          `${a.activity_type || ""} • submitted: ${a.submitted_count || 0}`
        ].map(esc).join(",");
      }

      if (item.type === "announcement") {
        const a = item.announcement;
        return [
          "School announcement",
          a.title || "",
          a.message || "",
          a.created_at || "",
          a.school_name || ""
        ].map(esc).join(",");
      }

      if (item.type === "report") {
        const r = item.report;
        return [
          "Student report",
          r.title || r.category || "",
          r.message || "",
          r.created_at || "",
          r.status || ""
        ].map(esc).join(",");
      }

      const s = item.scan;
      return [
        "Scan sheet",
        s.title || "",
        s.status || "",
        s.created_at || "",
        s.s3_object_key || ""
      ].map(esc).join(",");
    });

    const csv = [header.join(","), ...rows].join("\n");
    const filename = "colspot_full_history.csv";

    const Cap = window.Capacitor;
    const isNative = !!Cap && !!Cap.isNativePlatform;
    const Filesystem = Cap?.Plugins?.Filesystem;
    const Share = Cap?.Plugins?.Share;

    try {
      if (isNative && Filesystem) {
        const Directory = Filesystem.Directory || Filesystem?.Directory;
        const Encoding = Filesystem.Encoding || Filesystem?.Encoding;

        const writeRes = await Filesystem.writeFile({
          path: filename,
          data: csv,
          directory: Directory ? Directory.Documents : "DOCUMENTS",
          encoding: Encoding ? Encoding.UTF8 : "utf8",
        });

        if (Share && writeRes && writeRes.uri) {
          await Share.share({
            title: "Colspot Full History CSV",
            text: "Full history export",
            url: writeRes.uri,
            dialogTitle: "Share / Save CSV",
          });
          return;
        }

        alert(
          "CSV saved. Open your Files app / Documents and look for: " +
            filename
        );
        return;
      }

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    } catch (err) {
      console.error("downloadFullHistoryCsv error", err);
      alert("Could not start CSV download. Please try again.");
    }
  }

