<script>
  // Simple AI chat front-end for Supabase Edge Function "super-function"
  // Requires a global `supabase` client already set up.

  (function () {
    // DOM refs
    let aiMessagesEl,
      aiForm,
      aiInput,
      aiMessagesLeftEl,
      aiImagesLeftEl,
      aiMessagesLeftBottomEl,
      aiImagesLeftBottomEl,
      aiAttachBtn,
      aiImageInput,
      aiImagePreviewEl,
      aiScrollBtn,
      aiBackBtn;

    // Simple in-memory message list
    const aiMessages = [];

    // Track selected images (for preview + sending)
    let selectedImageUrls = [];
    let selectedImageFiles = [];

    let aiInitialized = false;
    let aiSending = false;

    function ensureAiInitialized() {
      if (aiInitialized) return;
      aiInitialized = true;

      aiMessages.push({
        role: "assistant",
        text: "Hi 👋 I’m Colspot AI. How can I assist you today?",
      });
      renderAiMessages();
    }

    function updateScrollButtonVisibility() {
      if (!aiMessagesEl || !aiScrollBtn) return;
      const scrollDiff =
        aiMessagesEl.scrollHeight -
        aiMessagesEl.scrollTop -
        aiMessagesEl.clientHeight;

      const nearBottom = scrollDiff < 40;
      if (nearBottom) {
        aiScrollBtn.classList.remove("ai-scroll-bottom-visible");
      } else {
        aiScrollBtn.classList.add("ai-scroll-bottom-visible");
      }
    }

    // 🔹 Detect native (Capacitor) platform
    function aiIsNative() {
      const Cap = window.Capacitor;
      if (!Cap) return false;
      if (typeof Cap.isNativePlatform === "function") return Cap.isNativePlatform();
      if (typeof Cap.isNativePlatform === "boolean") return Cap.isNativePlatform;
      return false;
    }

    // 🔹 Download attachment (web + native)
    async function downloadAttachment(att) {
      if (!att) return;
      const format = att.format || "word";
      const content = att.content || "";

      let mime = "text/plain";
      let ext = "txt";
      let filenamePrefix = "colspot";

      if (format === "word") {
        mime = "application/msword";
        ext = "doc"; // simple text .doc; Word opens it
        filenamePrefix = "colspot_word";
      } else if (format === "excel") {
        mime = "text/csv";
        ext = "csv";
        filenamePrefix = "colspot_excel";
      } else if (format === "csv") {
        mime = "text/csv";
        ext = "csv";
        filenamePrefix = "colspot_csv";
      }

      const filename = `${filenamePrefix}_${Date.now()}.${ext}`;

      // ----- ANDROID / IOS (Capacitor) -----
      if (aiIsNative()) {
        const Cap = window.Capacitor;
        const Filesystem = Cap?.Plugins?.Filesystem;
        const Share = Cap?.Plugins?.Share;

        if (!Filesystem) {
          alert(
            "Filesystem plugin missing. Install @capacitor/filesystem and run npx cap sync.",
          );
          return;
        }

        const Directory = Filesystem.Directory || Filesystem?.Directory;
        const Encoding = Filesystem.Encoding || Filesystem?.Encoding;

        const writeRes = await Filesystem.writeFile({
          path: filename,
          data: content, // plain text content
          directory: Directory ? Directory.Documents : "DOCUMENTS",
          encoding: Encoding ? Encoding.UTF8 : "utf8",
        });

        if (Share && writeRes?.uri) {
          await Share.share({
            title: "Colspot AI file",
            text: `Generated by Colspot AI (${format.toUpperCase()})`,
            url: writeRes.uri,
            dialogTitle: "Share / Save file",
          });
          return;
        }

        alert("File saved. Check your Files/Documents app for: " + filename);
        return;
      }

      // ----- NORMAL BROWSER (website) -----
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function renderAiMessages() {
      if (!aiMessagesEl) return;

      aiMessagesEl.innerHTML = "";

      aiMessages.forEach((msg) => {
        const row = document.createElement("div");
        row.classList.add("ai-message-row");
        if (msg.role === "assistant") {
          row.classList.add("ai-message-row-bot");
