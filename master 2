  async function ensureStudentIsClassMember(userId, sessionRow) {
    if (!sessionRow) {
      return {
        ok: false,
        message: "Session information is missing. Please refresh and try again.",
      };
    }

    const courseCode = String(sessionRow.course_code || "").trim();
    if (!courseCode) {
      return {
        ok: false,
        message: "This attendance session is missing a course code. Please contact your lecturer.",
      };
    }

    try {
      const { data: courseRow, error: courseError } = await supabase
        .from("courses")
        .select("id")
        .eq("course_code", courseCode)
        .limit(1)
        .maybeSingle();

      if (courseError) {
        return {
          ok: false,
          message: "We could not verify your class membership right now. Please try again.",
        };
      }

      if (!courseRow || !courseRow.id) {
        return {
          ok: false,
          message: "This attendance session is not linked to a class yet. Please contact your lecturer.",
        };
      }

      const { data, error } = await supabase
        .from("course_memberships")
        .select("id")
        .eq("user_id", userId)
        .eq("course_id", courseRow.id)
        .limit(1)
        .maybeSingle();

      if (error) {
        return {
          ok: false,
          message: "We could not verify your class membership right now. Please try again.",
        };
      }

      if (!data) {
        return {
          ok: false,
          message: "You are not a member of this class. Join the class first before taking attendance.",
        };
      }

      return { ok: true };
    } catch (e) {
      return {
        ok: false,
        message: "We could not verify your class membership right now. Please try again.",
      };
    }
  }

  async function getCurrentPositionOnce() {
    return new Promise(async (resolve) => {
      lastNearbyLocationError = null;

      try {
        const hasCapacitor =
          typeof window !== "undefined" &&
          window.Capacitor &&
          window.Capacitor.Plugins &&
          window.Capacitor.Plugins.Geolocation;

        if (hasCapacitor) {
          const Geolocation = window.Capacitor.Plugins.Geolocation;

          const perm = await Geolocation.requestPermissions();
          if (perm && perm.location === "denied") {
            lastNearbyLocationError = "PERMISSION_DENIED";
            return resolve(null);
          }

          try {
            const pos = await Geolocation.getCurrentPosition({
              enableHighAccuracy: true,
              timeout: 20000,
              maximumAge: 0,
            });
            lastNearbyLocationError = null;
            return resolve(pos);
          } catch (err) {
            lastNearbyLocationError = mapGeoErrorCode(err);
            return resolve(null);
          }
        } else if ("geolocation" in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              lastNearbyLocationError = null;
              resolve(pos);
            },
            (err) => {
              lastNearbyLocationError = mapGeoErrorCode(err);
              resolve(null);
            },
            {
              enableHighAccuracy: true,
              maximumAge: 0,
              timeout: 20000,
            }
          );
        } else {
          lastNearbyLocationError = "POSITION_UNAVAILABLE";
          resolve(null);
        }
      } catch (err) {
        lastNearbyLocationError = mapGeoErrorCode(err);
        resolve(null);
      }
    });
  }

  async function getSmartLocation(maxReads = 5, desiredAccuracy = 100) {
    const readings = [];

    for (let i = 0; i < maxReads; i++) {
      const pos = await getCurrentPositionOnce();
      if (pos && pos.coords) {
        const acc =
          typeof pos.coords.accuracy === "number" && !Number.isNaN(pos.coords.accuracy)
            ? pos.coords.accuracy
            : null;

        readings.push({ pos, accuracy: acc });

        if (acc !== null && acc <= desiredAccuracy) break;
      }

      await new Promise((r) => setTimeout(r, 1500));
    }

    if (!readings.length) return null;

    let best = readings[0];
    for (const r of readings) {
      if (r.accuracy == null) continue;
      if (best.accuracy == null || r.accuracy < best.accuracy) best = r;
    }

    return best.pos;
  }

