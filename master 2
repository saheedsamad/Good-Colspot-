  async function loadNearbyVerificationState(force = false) {
    if (typeof supabase === "undefined") {
      nearbyVerificationState = {
        loading: false,
        hasUser: false,
        courseFormOk: false,
        biometricOk: false,
        missingItems: [],
      };
      updateNearbyVerificationUi();
      return nearbyVerificationState;
    }

    const { user, networkIssue } = await getNearbyCurrentUser();

    if (networkIssue || !user) {
      nearbyVerificationState = {
        loading: false,
        hasUser: false,
        courseFormOk: false,
        biometricOk: false,
        missingItems: [],
      };
      updateNearbyVerificationUi();
      return nearbyVerificationState;
    }

    if (!force && !nearbyVerificationState.loading && nearbyVerificationState.hasUser) {
      return nearbyVerificationState;
    }

    nearbyVerificationState = {
      loading: true,
      hasUser: true,
      courseFormOk: false,
      biometricOk: false,
      missingItems: [],
    };

    let courseFormOk = false;
    let biometricOk = false;

    try {
      const [courseFormRes, faceRes] = await Promise.all([
        supabase
          .from("verification_course_forms")
          .select("id, user_id, created_at")
          .eq("user_id", user.id)
          .limit(1)
          .maybeSingle(),

        supabase
          .from("face_profiles")
          .select("id, face_verified")
          .eq("user_id", user.id)
          .limit(1)
          .maybeSingle(),
      ]);

      if (!courseFormRes.error && courseFormRes.data) {
        courseFormOk = true;
      }

      if (!faceRes.error && faceRes.data && faceRes.data.face_verified === true) {
        biometricOk = true;
      }
    } catch (err) {
      console.warn("loadNearbyVerificationState failed:", err);
    }

    const missingItems = [];
    if (!courseFormOk) missingItems.push("course_form");
    if (!biometricOk) missingItems.push("biometric");

    nearbyVerificationState = {
      loading: false,
      hasUser: true,
      courseFormOk,
      biometricOk,
      missingItems,
    };

    updateNearbyVerificationUi();
    return nearbyVerificationState;
  }

