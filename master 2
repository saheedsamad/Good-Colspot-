            img.src = u;
            img.className = "ai-sent-image";
            imageWrapper.appendChild(img);
          });

          bubble.appendChild(imageWrapper);
        }

        const text = msg.text || "";
        if (text) {
          if (imgUrls.length) {
            const textWrapper = document.createElement("div");
            textWrapper.className =
              msg.role === "assistant"
                ? "ai-text-bubble-bot"
                : "ai-text-bubble-user";

