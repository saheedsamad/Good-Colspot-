    function applyUpdateRuleFromLocal() {
      let raw;
      try {
        raw = localStorage.getItem(UPDATE_RULE_LOCAL_KEY);
      } catch {
        raw = null;
      }
      if (!raw) {
        hideSoftUpdateBanner();
        hideHardUpdateOverlay();
        return;
      }

      let rule;
      try {
        rule = JSON.parse(raw);
      } catch {
        hideSoftUpdateBanner();
        hideHardUpdateOverlay();
        return;
      }

      if (!rule || !rule.mode || rule.mode === "none") {
        hideSoftUpdateBanner();
        hideHardUpdateOverlay();
        return;
      }

      const now = new Date();
      if (rule.deadline && new Date(rule.deadline) < now && rule.mode === "soft") {
        rule.mode = "hard";
      }

      currentUpdateRule = rule;

      if (rule.mode === "soft") {
        showSoftUpdateBanner(rule);
        hideHardUpdateOverlay();
      } else if (rule.mode === "hard") {
        hideSoftUpdateBanner();
        showHardUpdateOverlay(rule);
      } else {
        hideSoftUpdateBanner();
        hideHardUpdateOverlay();
      }
    }

    function showSoftUpdateBanner(rule) {
      const sec = document.getElementById("updateSoftSection");
      const titleEl = document.getElementById("updateSoftTitle");
      const msgEl = document.getElementById("updateSoftMessage");
      if (!sec || !titleEl || !msgEl) return;

      titleEl.textContent = rule.message_title || "New version available";
      msgEl.textContent =
        rule.message_body ||
        "A newer version of Colspot is available. Please update when you can.";
      sec.style.display = "block";
    }

    function hideSoftUpdateBanner() {
      const sec = document.getElementById("updateSoftSection");
      if (sec) sec.style.display = "none";
    }

    function showHardUpdateOverlay(rule) {
      const overlay = document.getElementById("updateHardOverlay");
      const titleEl = document.getElementById("updateHardTitle");
      const msgEl = document.getElementById("updateHardMessage");
      if (!overlay || !titleEl || !msgEl) return;

      titleEl.textContent = rule.message_title || "Update required";
      msgEl.textContent =
        rule.message_body ||
        "A newer version of Colspot is required to continue. Please update to keep using the app.";
      overlay.style.display = "flex";
    }

    function hideHardUpdateOverlay() {
      const overlay = document.getElementById("updateHardOverlay");
      if (overlay) overlay.style.display = "none";
    }

    function openUpdateUrlFromRule() {
      if (!currentUpdateRule || !currentUpdateRule.update_url) return;
      try {
        window.location.href = currentUpdateRule.update_url;
      } catch {
        window.open(currentUpdateRule.update_url, "_blank");
      }
    }

    function getCurrentMonthKey() {
      const d = new Date();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      return `${d.getFullYear()}-${m}`;
    }

    function loadUserScanQuota(userId) {
      const key = `colspot_scan_quota_${userId}`;
      const monthKey = getCurrentMonthKey();
      try {
        const raw = localStorage.getItem(key);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (
            parsed &&
            parsed.month === monthKey &&
            typeof parsed.used === "number"
          ) {
            return { month: monthKey, used: parsed.used };
          }
        }
      } catch (e) {
        console.warn("Could not read scan quota:", e);
      }
      const initial = { month: monthKey, used: 0 };
      saveUserScanQuota(userId, initial);
      return initial;
    }

    function saveUserScanQuota(userId, quota) {
      const key = `colspot_scan_quota_${userId}`;
      try {
        localStorage.setItem(key, JSON.stringify(quota));
      } catch (e) {
        console.warn("Could not save scan quota:", e);
      }
    }

    function updateScanQuotaText() {
      const el = document.getElementById("scanQuotaText");
      if (!el || !currentScanQuota) return;

      const used = currentScanQuota.used || 0;
      let remaining = SCAN_MAX_PER_MONTH - used;
      if (remaining < 0) remaining = 0;

      el.classList.remove("scan-quota-low", "scan-quota-zero");

      if (remaining > 0) {
        el.textContent = `You have ${remaining} of ${SCAN_MAX_PER_MONTH} scans left this month.`;
        if (remaining <= 5) {
          el.classList.add("scan-quota-low");
        }
      } else {
        el.textContent = `You have used all ${SCAN_MAX_PER_MONTH} scans for this month. Scanning will be available again next month.`;
        el.classList.add("scan-quota-zero");
      }
    }

    async function initScanQuotaUI() {
      const quotaEl = document.getElementById("scanQuotaText");
      if (!quotaEl) return;

      const userCtx = await getUserContextForScan();
      if (!userCtx || !userCtx.id) {
        quotaEl.textContent = `You have ${SCAN_MAX_PER_MONTH} scans per month.`;
        quotaEl.classList.remove("scan-quota-low", "scan-quota-zero");
        currentScanQuota = null;
        currentScanUserId = null;
        return;
      }

      currentScanUserId = userCtx.id;
      currentScanQuota = loadUserScanQuota(userCtx.id);
      updateScanQuotaText();
    }

    function openScanFilePicker() {
      const input = document.getElementById("scanFileInput");
      if (input) input.click();
    }

    async function getUserContextForScan() {
      const user = await ensureCurrentUser();
      if (user) {
        return { id: user.id, email: user.email || "" };
      }
      const cached = getCachedAuthFromLocalUser();
      if (cached) {
        return { id: cached.user_id || cached.id, email: cached.email || "" };
      }
      return null;
    }

    async function submitScanForm(event) {
      event.preventDefault();

      const statusEl = document.getElementById("scanStatusText");
      const btn = document.getElementById("scanSubmitBtn");
      const nameInput = document.getElementById("scanFileName");
      const fileInput = document.getElementById("scanFileInput");
      const formatRadio = document.querySelector(
        'input[name="scanFormat"]:checked'
      );

      if (!fileInput || !fileInput.files || !fileInput.files[0]) {
        statusEl.className = "scan-status error";
        statusEl.textContent = "Please choose a photo or PDF to scan.";
        return;
      }

      const userCtx = await getUserContextForScan();
      if (!userCtx) {
        statusEl.className = "scan-status error";
        statusEl.textContent =
          "We could not find your account. Please sign in again.";
        return;
      }

      currentScanUserId = userCtx.id;
      currentScanQuota = loadUserScanQuota(userCtx.id);
      const used = currentScanQuota.used || 0;
      if (used >= SCAN_MAX_PER_MONTH) {
        statusEl.className = "scan-status error";
        statusEl.textContent =
          `You have used all ${SCAN_MAX_PER_MONTH} scans for this month. Try again next month.`;
        updateScanQuotaText();
        return;
      }

      const file = fileInput.files[0];
      const fileNameRaw = nameInput.value.trim();
      const fileName = fileNameRaw || file.name || "Untitled scan";
      const outputFormat = formatRadio ? formatRadio.value : "excel";

      statusEl.className = "scan-status";
      statusEl.textContent = "Uploading and scanning… please wait.";
      btn.disabled = true;

      try {
        const base64Data = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result || "";
            const parts = String(result).split(",");
            resolve(parts.length > 1 ? parts[1] : parts[0]);
          };
          reader.onerror = () =>
            reject(new Error("Could not read file on device."));
          reader.readAsDataURL(file);
        });

        const payload = {
          user_id: userCtx.id,
          file_name: fileName,
          output_format: outputFormat,
          file_data: base64Data,
          mime_type: file.type || "application/octet-stream",
        };

        const resp = await fetch(SCAN_LAMBDA_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        let data = null;
        try {
          data = await resp.json();
        } catch {
          data = null;
        }

        if (!resp.ok) {
          const msg =
            (data && (data.message || data.error)) ||
            "Scan failed on server.";
          throw new Error(msg);
        }

        if (typeof supabase !== "undefined" && userCtx && userCtx.id) {
          try {
            const record = {
              user_id: userCtx.id,
              title: fileName,
              page_count: data?.page_count ?? null,
              total_rows: data?.total_rows ?? null,
              s3_object_key: data?.s3_object_key ?? null,
              status: data?.status ?? "completed",
              result_json: data?.result_json ?? null,
              error_message: data?.error_message ?? null,
            };

            if (data && data.scan_sheet_id) {
              record.id = data.scan_sheet_id;
            }

            await supabase.from("scan_sheets").insert(record);
          } catch (e) {
            console.warn("Supabase scan_sheets insert failed (non-fatal):", e);
          }
        }

        if (currentScanUserId) {
          currentScanQuota = loadUserScanQuota(currentScanUserId);
          currentScanQuota.used = (currentScanQuota.used || 0) + 1;
          if (currentScanQuota.used < 0) currentScanQuota.used = 0;
          saveUserScanQuota(currentScanUserId, currentScanQuota);
        }
        updateScanQuotaText();

        const remaining =
          currentScanQuota
            ? Math.max(
                0,
                SCAN_MAX_PER_MONTH - (currentScanQuota.used || 0)
              )
            : null;

        statusEl.className = "scan-status ok";

        const remainingText =
          remaining === null
            ? ""
            : ` You now have ${remaining} of ${SCAN_MAX_PER_MONTH} scans left this month.`;

        if (data && data.result_json && data.result_json.download_url) {
          statusEl.innerHTML =
            "Scan completed." +
            remainingText +
            "<br>It may take a few seconds to appear in <b>History</b>." +
            '<br>Go to the <b>History</b> tab to view and download it, or ' +
            '<a href="' +
            data.result_json.download_url +
            '" target="_blank" rel="noopener">open it now</a>.';
        } else {
          statusEl.textContent =
            "Scan completed." +
            remainingText +
            " Go to the History tab to view and download it.";
        }

        fileInput.value = "";
        const chosenText2 = document.getElementById("scanFileChosenText");
        if (chosenText2) chosenText2.textContent = "";
      } catch (err) {
        console.error("Scan error:", err);

        // UPDATED: nicer message when network is off / "Failed to fetch"
        const rawMsg = (err && err.message) ? String(err.message).toLowerCase() : "";
        const looksLikeNetwork =
          rawMsg.includes("failed to fetch") ||
          rawMsg.includes("network") ||
          rawMsg.includes("timeout") ||
          rawMsg.includes("timed out") ||
          rawMsg.includes("err_name_not_resolved");

        statusEl.className = "scan-status error";
        if (looksLikeNetwork) {
          statusEl.textContent =
            "We couldn’t reach Colspot servers. Please check your internet connection and try again.";
        } else {
          statusEl.textContent =
            err && err.message
              ? err.message
              : "Scan failed. Please try again.";
        }
      } finally {
        btn.disabled = false;
      }
    }

    function setupKeyboardNavHide() {
      const focusSelector =
        "input, textarea, select, [contenteditable='true']";

      document.addEventListener("focusin", (event) => {
        if (event.target.matches(focusSelector)) {
          document.body.classList.add("keyboard-open");
        }
      });

      document.addEventListener("focusout", (event) => {
        if (event.target.matches(focusSelector)) {
          setTimeout(() => {
            const active = document.activeElement;
            if (!active || !active.matches(focusSelector)) {
              document.body.classList.remove("keyboard-open");
            }
          }, 50);
        }
      });
    }

    setupKeyboardNavHide();
  </script>
