            textDiv.className = "ai-bubble-text";
            textDiv.textContent = text;

            textWrapper.appendChild(textDiv);
            bubble.appendChild(textWrapper);
          } else {
            const textDiv = document.createElement("div");
            textDiv.className = "ai-bubble-text";
            textDiv.textContent = text;
            bubble.appendChild(textDiv);
          }
        }

        if (msg.role === "assistant" && msg.fileAttachment) {
          const format = msg.fileAttachment.format || "word";
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "ai-download-button";

          if (format === "word") {
            btn.textContent = "Download Word file";
          } else if (format === "excel") {
            btn.textContent = "Download Excel file";
          } else if (format === "csv") {
            btn.textContent = "Download CSV file";
          } else {
            btn.textContent = "Download file";
          }

          btn.addEventListener("click", function () {
            downloadAttachment(msg.fileAttachment);
          });

          bubble.appendChild(btn);
        }

        if (msg.role === "assistant") {
          row.appendChild(avatar);
          row.appendChild(bubble);
        } else {
          row.appendChild(bubble);
          row.appendChild(avatar);
        }

        aiMessagesEl.appendChild(row);
      });

      aiMessagesEl.scrollTop = aiMessagesEl.scrollHeight;
      updateScrollButtonVisibility();
    }

    function refreshImagePreview() {
      if (!aiImagePreviewEl) return;
      if (!selectedImageUrls.length) {
        aiImagePreviewEl.style.display = "none";
        aiImagePreviewEl.innerHTML = "";
        return;
      }

      aiImagePreviewEl.style.display = "flex";
      aiImagePreviewEl.innerHTML = "";

      selectedImageUrls.forEach((url, index) => {
        const wrapper = document.createElement("div");
        wrapper.style.display = "inline-block";
        wrapper.style.position = "relative";

        const img = document.createElement("img");
        img.src = url;

        const clear = document.createElement("span");
        clear.textContent = "Remove";
        clear.className = "ai-image-preview-clear";
        clear.onclick = function () {
          // remove this image
          selectedImageUrls.splice(index, 1);
          selectedImageFiles.splice(index, 1);
          refreshImagePreview();
        };

        wrapper.appendChild(img);
        wrapper.appendChild(clear);
        aiImagePreviewEl.appendChild(wrapper);
      });
    }

    function fileToDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function sendAiQuestion(text, imageFiles, requestedFormat) {
      if (!window.supabase) {
        console.error("supabase client not found");
        aiMessages.push({
          role: "assistant",
          text: "Sorry, I can't reach Colspot AI right now.",
        });
        renderAiMessages();
        return;
      }

      aiSending = true;

      aiMessages.push({
        role: "assistant",
        text: "Thinking…",
        pending: true,
        fileAttachment: null,
      });
      renderAiMessages();

      let responseText =
        "Sorry, something went wrong. Please try again in a moment.";
      let usage = null;

      try {
        let kind = "text";
        const body = {
          kind: "text",
          message: text,
        };

        if (imageFiles && imageFiles.length > 0) {
          kind = "image";
          body.kind = "image";
          body.message = text || "Please help with these images.";

          const limited = imageFiles.slice(0, 3);
          const dataUrls = await Promise.all(
            limited.map((file) => fileToDataUrl(file)),
          );
          body.image_urls = dataUrls; // backend can use array
          body.image_url = dataUrls[0]; // backwards compatible (first image)
        }

        const { data, error } = await supabase.functions.invoke(
          "super-function",
          {
            body,
          },
        );

        if (error) {
          console.error("super-function error:", error);
        } else if (data) {
          if (data.error === "TEXT_LIMIT") {
            responseText =
              data.message ||
              "You’ve reached today’s text limit (10 questions).";
          } else if (data.error === "IMAGE_LIMIT") {
            responseText =
              data.message ||
              "You’ve reached today’s image limit (3 uploads).";
          } else if (data.message) {
            responseText = data.message;
          }
          usage = data.usage || null;
        }
      } catch (err) {
        console.error("super-function exception:", err);
      }

      const last = aiMessages[aiMessages.length - 1];
      if (last && last.role === "assistant" && last.pending) {
        last.text = responseText;
        delete last.pending;

        if (requestedFormat) {
          last.fileAttachment = {
            format: requestedFormat,
            content: responseText,
          };
        }
      } else {
        const msg = { role: "assistant", text: responseText };
        if (requestedFormat) {
          msg.fileAttachment = {
            format: requestedFormat,
            content: responseText,
          };
        }
        aiMessages.push(msg);
      }

      if (usage) {
        const msgLeft = usage.text_limit - usage.text_used;
        const imgLeft = usage.image_limit - usage.image_used;

        if (aiMessagesLeftEl) aiMessagesLeftEl.textContent = msgLeft;
        if (aiImagesLeftEl) aiImagesLeftEl.textContent = imgLeft;
        if (aiMessagesLeftBottomEl)
          aiMessagesLeftBottomEl.textContent = msgLeft;
        if (aiImagesLeftBottomEl)
          aiImagesLeftBottomEl.textContent = imgLeft;
      }

      aiSending = false;
      renderAiMessages();
    }

    function updateAiKeyboardOffset() {
      const screenAi = document.getElementById("screen-ai");
      if (!screenAi) return;

      let offset = 0;

      if (window.visualViewport) {
        const vv = window.visualViewport;
        const keyboardHeight = Math.max(
          0,
          window.innerHeight - vv.height - vv.offsetTop
        );

        if (keyboardHeight > 80) {
          offset = keyboardHeight;
        }
      }

      screenAi.style.setProperty("--ai-keyboard-offset", `${offset}px`);

      if (aiMessagesEl) {
        requestAnimationFrame(() => {
          aiMessagesEl.scrollTop = aiMessagesEl.scrollHeight;
          updateScrollButtonVisibility();
        });
      }
    }

    function setupAiKeyboardHandling() {
      if (!aiInput) return;

      aiInput.addEventListener("focus", function () {
        setTimeout(updateAiKeyboardOffset, 60);
      });

      aiInput.addEventListener("blur", function () {
        setTimeout(updateAiKeyboardOffset, 120);
      });

      window.addEventListener("resize", updateAiKeyboardOffset);

      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", updateAiKeyboardOffset);
        window.visualViewport.addEventListener("scroll", updateAiKeyboardOffset);
      }

      updateAiKeyboardOffset();
    }

    function setupAiScreen() {
      aiMessagesEl = document.getElementById("ai-messages");
      aiForm = document.getElementById("ai-form");
      aiInput = document.getElementById("ai-input");
      aiMessagesLeftEl = document.getElementById("ai-messages-left");
      aiImagesLeftEl = document.getElementById("ai-images-left");
      aiMessagesLeftBottomEl =
        document.getElementById("ai-messages-left-bottom");
      aiImagesLeftBottomEl =
        document.getElementById("ai-images-left-bottom");
      aiAttachBtn = document.getElementById("ai-attach-btn");
      aiImageInput = document.getElementById("ai-image-input");
      aiImagePreviewEl = document.getElementById("ai-image-preview");
      aiScrollBtn = document.getElementById("ai-scroll-bottom");
      aiBackBtn = document.getElementById("ai-back-button");

      if (!aiForm || !aiInput) return;

      ensureAiInitialized();

      if (aiBackBtn) {
        aiBackBtn.addEventListener("click", function () {
          if (window.showScreen) {
            window.showScreen("home");
          }
        });
      }

      if (aiMessagesEl) {
        aiMessagesEl.addEventListener("scroll", updateScrollButtonVisibility);
      }

      if (aiScrollBtn && aiMessagesEl) {
        aiScrollBtn.addEventListener("click", function () {
          aiMessagesEl.scrollTo({
            top: aiMessagesEl.scrollHeight,
            behavior: "smooth",
          });
        });
      }

      aiForm.addEventListener("submit", function (e) {
        e.preventDefault();
        if (aiSending) return;

        const text = aiInput.value.trim();
        const hasImages =
          selectedImageFiles && selectedImageFiles.length > 0;
        if (!text && !hasImages) return;

        // Read remaining counts from UI
        const msgLeftRaw =
          (aiMessagesLeftBottomEl &&
            aiMessagesLeftBottomEl.textContent) ||
          (aiMessagesLeftEl && aiMessagesLeftEl.textContent) ||
          "999";
        const imgLeftRaw =
          (aiImagesLeftBottomEl &&
            aiImagesLeftBottomEl.textContent) ||
          (aiImagesLeftEl && aiImagesLeftEl.textContent) ||
          "999";

        let msgLeft = parseInt(msgLeftRaw, 10);
        let imgLeft = parseInt(imgLeftRaw, 10);
        if (isNaN(msgLeft)) msgLeft = Infinity;
        if (isNaN(imgLeft)) imgLeft = Infinity;

        // Frontend guard for limits
        if (text && msgLeft <= 0 && !hasImages) {
          aiMessages.push({
            role: "assistant",
            text:
              "You’ve reached today’s text question limit (10). You can continue tomorrow.",
          });
          aiInput.value = "";
          renderAiMessages();
          return;
        }

        if (hasImages && imgLeft <= 0 && !text) {
          aiMessages.push({
            role: "assistant",
            text:
              "You’ve reached today’s image upload limit (3). You can continue tomorrow.",
          });
          aiInput.value = "";
          renderAiMessages();
          return;
        }

        if (text && msgLeft <= 0 && hasImages && imgLeft > 0) {
          aiMessages.push({
            role: "assistant",
            text:
              "You’ve reached today’s text question limit (10). You can still send images only by clearing the question box.",
          });
          renderAiMessages();
          return;
        }

        if (hasImages && imgLeft <= 0 && text && msgLeft > 0) {
          aiMessages.push({
            role: "assistant",
            text:
              "You’ve reached today’s image upload limit (3). You can still ask text questions without images.",
          });
          aiInput.value = "";
          renderAiMessages();
          return;
        }

        const lower = (text || "").toLowerCase();
        let requestedFormat = null;
        if (lower.includes("word")) {
          requestedFormat = "word";
        } else if (lower.includes("excel")) {
          requestedFormat = "excel";
        } else if (lower.includes("csv")) {
          requestedFormat = "csv";
        }

        const imageFilesToSend = selectedImageFiles.slice();
        const imageUrlsForMessage = selectedImageUrls.slice();

        let displayText = text || "";
        aiMessages.push({
          role: "user",
          text: displayText,
          imageUrls: imageUrlsForMessage.length ? imageUrlsForMessage : null,
        });
        aiInput.value = "";
        renderAiMessages();

        // Clear selected images
        selectedImageFiles = [];
        selectedImageUrls = [];
        if (aiImageInput) aiImageInput.value = "";
        refreshImagePreview();

        sendAiQuestion(text, imageFilesToSend, requestedFormat);
      });

      if (aiAttachBtn && aiImageInput) {
        aiAttachBtn.addEventListener("click", function () {
          aiImageInput.click();
        });

        aiImageInput.addEventListener("change", function () {
          const files = Array.from(aiImageInput.files || []);
          if (!files.length) {
            selectedImageFiles = [];
            selectedImageUrls = [];
            refreshImagePreview();
            return;
          }

          const MAX_IMAGES = 3;
          if (selectedImageFiles.length >= MAX_IMAGES) {
            alert("You can only attach up to 3 images for one question.");
            aiImageInput.value = "";
            return;
          }

          const available = MAX_IMAGES - selectedImageFiles.length;
          const toUse = files.slice(0, available);
          if (files.length > available) {
            alert("Only the first 3 images will be used.");
          }

          toUse.forEach((file) => {
            selectedImageFiles.push(file);
            const url = URL.createObjectURL(file);
            selectedImageUrls.push(url);
          });

          refreshImagePreview();
        });
      }

      setupAiKeyboardHandling();
      updateScrollButtonVisibility();
    }

    const originalShowScreen = window.showScreen;
    window.showScreen = function (id) {
      if (typeof originalShowScreen === "function") {
        originalShowScreen(id);
      } else {
        document
          .querySelectorAll(".screen")
          .forEach((el) => (el.style.display = "none"));
        const target =
          document.getElementById("screen-" + id) ||
          document.getElementById(id);
        if (target) target.style.display = "block";
      }

      if (id === "ai" || id === "screen-ai") {
        ensureAiInitialized();
      }
    };

    document.addEventListener("DOMContentLoaded", setupAiScreen);
  })();
</script>
