  async function studentOpenActivityIntro(activityId) {
    const found = (state.activities || []).find((x) => x.id === activityId);
    if (!found) return;

    const titleEl = document.getElementById("studentActivityIntroTitle");
    const courseEl = document.getElementById("studentActivityIntroCourse");
    const questionsEl = document.getElementById("studentActivityIntroQuestions");
    const timeEl = document.getElementById("studentActivityIntroTime");
    const dueEl = document.getElementById("studentActivityIntroDue");
    const warningEl = document.getElementById("studentActivityStartWarning");
    const startBtn = document.getElementById("studentStartActivityBtn");

    if (titleEl) titleEl.textContent = found.title || "Activity";
    if (courseEl) courseEl.textContent = `${found.class_code || ""}${found.class_title ? " - " + found.class_title : ""}`.trim();
    if (questionsEl) questionsEl.textContent = `${found.questions_count || 0} Questions`;
    if (timeEl) timeEl.textContent = found.time_limit ? studentFormatDuration(found.time_limit) : "No limit";
    if (dueEl) dueEl.textContent = found.due_text || "No due date";

    if (warningEl) {
      warningEl.textContent = found.time_limit
        ? `Once you start, this activity will expire after ${studentFormatDuration(found.time_limit)}. A countdown will show at the top while you answer. You can only submit once, and your score will not show immediately.`
