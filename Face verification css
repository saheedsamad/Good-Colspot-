:root {
  --bg: #eef4ff;
  --card: #ffffff;
  --line: #e5e7eb;
  --text-main: #111827;
  --text-muted: #6b7280;
  --blue: #2563eb;
  --blue-dark: #1d4ed8;
  --blue-soft: #dbeafe;
  --green: #16a34a;
  --green-soft: #dcfce7;
  --red: #dc2626;
  --red-soft: #fee2e2;
  --shadow-soft: 0 12px 30px rgba(148, 163, 184, 0.22);
  --shadow-card: 0 16px 38px rgba(15, 23, 42, 0.12);
  --shadow-strong: 0 18px 40px rgba(15, 23, 42, 0.18);
  --radius-xl: 24px;
  --radius-lg: 20px;
  --radius-md: 16px;
  --radius-pill: 999px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background: linear-gradient(180deg, #f5f8ff 0%, #edf4ff 100%);
  font-family: Inter, Arial, sans-serif;
  color: var(--text-main);
  min-height: 100%;
}

body {
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
input,
video,
canvas {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.phone-shell {
  width: 100%;
  min-height: 100vh;
  padding:
    calc(env(safe-area-inset-top) + 14px)
    14px
    calc(env(safe-area-inset-bottom) + 18px);
}

.page {
  max-width: 460px;
  margin: 0 auto;
}

.hero {
  margin-bottom: 14px;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.icon-back-btn {
  width: 38px;
  height: 38px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
  cursor: pointer;
}

.icon-back-btn svg {
  width: 18px;
  height: 18px;
  stroke: #4b5563;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-line-1 {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--blue-dark);
  text-transform: uppercase;
  margin-bottom: 6px;
}

.hero-title {
  margin: 0;
  font-size: 29px;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--text-main);
}

.hero-title span {
  color: var(--blue-dark);
}

.hero-subtitle {
  margin: 10px 2px 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-muted);
}

.top-message-card {
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid var(--line);
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: var(--shadow-soft);
  margin-bottom: 14px;
}

.top-message-icon {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  background: #e0e7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-message-icon svg {
  width: 15px;
  height: 15px;
  stroke: #4338ca;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.top-message-text {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.35;
}

.verify-step-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 14px;
}

.verify-step-pill {
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid var(--line);
  min-height: 74px;
  padding: 10px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-shadow: var(--shadow-soft);
}

.verify-step-pill.active {
  background: linear-gradient(180deg, #eef5ff 0%, #e4efff 100%);
  border-color: #bfdbfe;
}

.verify-step-number {
  width: 26px;
  height: 26px;
  border-radius: 999px;
  background: #e5e7eb;
  color: #4b5563;
  font-size: 12px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.verify-step-pill.active .verify-step-number {
  background: var(--blue);
  color: #ffffff;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.35);
}

.verify-step-text {
  font-size: 12px;
  font-weight: 700;
  color: #4b5563;
  text-align: center;
  line-height: 1.2;
}

.verify-step-pill.active .verify-step-text {
  color: var(--blue-dark);
}

.camera-card,
.tips-card,
.verify-result-card {
  border-radius: var(--radius-lg);
  background: var(--card);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-card);
  padding: 14px;
  margin-bottom: 14px;
}

.camera-card-head,
.verify-result-head,
.tips-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.camera-card-title,
.verify-result-title,
.tips-title {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-main);
}

.camera-card-subtitle,
.tips-subtitle {
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.4;
  color: var(--text-muted);
}

.camera-badge {
  border-radius: 999px;
  border: 1px solid #dbeafe;
  background: #eff6ff;
  color: var(--blue-dark);
  font-size: 11px;
  font-weight: 700;
  padding: 6px 10px;
  white-space: nowrap;
}

.camera-stage {
  position: relative;
  margin-top: 14px;
  border-radius: 24px;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(255,255,255,0.25), rgba(255,255,255,0) 30%),
    linear-gradient(180deg, #dbe7ff 0%, #b8cbfb 100%);
  min-height: 360px;
  aspect-ratio: 3 / 4;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.35);
}

.camera-video,
.camera-canvas,
.face-preview-wrap {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.camera-video,
.face-preview-image {
  object-fit: cover;
}

.camera-canvas {
  pointer-events: none;
}

.face-preview-wrap.hidden,
.hidden {
  display: none !important;
}

.face-preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

.face-guide-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.face-frame {
  width: 66%;
  aspect-ratio: 0.8 / 1;
  border-radius: 38px;
  border: 3px solid rgba(219, 234, 254, 0.95);
  box-shadow:
    0 0 0 999px rgba(15, 23, 42, 0.18),
    inset 0 0 0 1px rgba(255,255,255,0.55),
    0 0 30px rgba(191, 219, 254, 0.55);
  position: relative;
}

.face-frame::before,
.face-frame::after {
  content: "";
  position: absolute;
  width: 34px;
  height: 34px;
  border: 5px solid #bfdbfe;
  border-radius: 12px;
}

.face-frame::before {
  top: -3px;
  left: -3px;
  border-right: none;
  border-bottom: none;
}

.face-frame::after {
  right: -3px;
  bottom: -3px;
  border-left: none;
  border-top: none;
}

.face-guide-text {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.66);
  color: #ffffff;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  backdrop-filter: blur(8px);
}

.camera-action-row {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.action-btn,
.primary-action-btn,
.ghost-btn {
  border: none;
  cursor: pointer;
  transition: transform 0.08s ease, box-shadow 0.08s ease, opacity 0.08s ease;
}

.action-btn:active,
.primary-action-btn:active,
.ghost-btn:active {
  transform: translateY(1px) scale(0.985);
}

.action-btn {
  flex: 1;
  border-radius: var(--radius-pill);
  border: 1px solid var(--line);
  background: #f9fafb;
  color: #374151;
  min-height: 44px;
  font-size: 13px;
  font-weight: 700;
  box-shadow: 0 10px 24px rgba(148, 163, 184, 0.22);
}

.primary-action-btn {
  width: 100%;
  border-radius: var(--radius-pill);
  min-height: 48px;
  background: var(--blue);
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  box-shadow: 0 14px 32px rgba(37, 99, 235, 0.35);
  margin-top: 12px;
}

.primary-action-btn:disabled,
.action-btn:disabled {
  cursor: not-allowed;
  opacity: 0.58;
  box-shadow: none;
}

.tips-icon {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: #fff7ed;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tips-icon svg {
  width: 18px;
  height: 18px;
  stroke: #f59e0b;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tips-list {
  margin: 14px 0 0;
  padding-left: 18px;
  color: var(--text-muted);
}

.tips-list li {
  margin-bottom: 10px;
  font-size: 13px;
  line-height: 1.5;
}

.verify-result-pill {
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  padding: 6px 10px;
  border: 1px solid transparent;
  white-space: nowrap;
}

.verify-result-pill.neutral {
  background: #f3f4f6;
  color: #4b5563;
  border-color: #e5e7eb;
}

.verify-result-pill.success {
  background: var(--green-soft);
  color: var(--green);
  border-color: #bbf7d0;
}

.verify-result-pill.error {
  background: var(--red-soft);
  color: var(--red);
  border-color: #fecaca;
}

.verify-result-text {
  margin: 12px 0 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-muted);
}

.message-box {
  margin-top: 12px;
  border-radius: 16px;
  padding: 12px 13px;
  font-size: 13px;
  line-height: 1.45;
  font-weight: 600;
}

.message-box.error {
  background: var(--red-soft);
  color: #b91c1c;
  border: 1px solid #fecaca;
}

.message-box.success {
  background: var(--green-soft);
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.bottom-action-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 8px;
}

.verify-btn {
  margin-top: 0;
}

.ghost-btn {
  width: 100%;
  min-height: 46px;
  border-radius: var(--radius-pill);
  background: #ffffff;
  border: 1px solid var(--line);
  color: #4b5563;
  font-size: 14px;
  font-weight: 700;
  box-shadow: var(--shadow-soft);
}

@media (max-width: 420px) {
  .hero-title {
    font-size: 26px;
  }

  .camera-stage {
    min-height: 320px;
  }

  .verify-step-pill {
    min-height: 70px;
  }

  .verify-step-text {
    font-size: 11px;
  }
}
