<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOD Account</title>

  <style>
    :root{
      --bg:#f4f7fb;
      --card:#f9fafb;
      --white:#ffffff;
      --line:#e5e7eb;
      --text-main:#111827;
      --text-muted:#6b7280;
      --blue:#2563eb;
      --blue-soft:#e0ecff;
      --blue-soft-border:#d1ddff;
      --red:#b91c1c;
      --red-bg:#fef2f2;
      --red-border:#fecaca;
      --green:#15803d;
      --green-bg:#ecfdf5;
      --green-border:#bbf7d0;
      --shadow:0 14px 36px rgba(15,23,42,.08);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      background:var(--bg);
      color:var(--text-main);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      min-height:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:16px 14px 32px;
    }

    .account-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:4px 2px 10px;
    }

    .account-header-left{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:12px;
      background:linear-gradient(135deg,#60a5fa,#2563eb);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:22px;
      font-weight:800;
      flex-shrink:0;
      box-shadow:0 12px 22px rgba(37,99,235,.24);
    }

    .account-title{
      font-size:18px;
      font-weight:800;
      color:var(--text-main);
    }

    .account-sub{
      font-size:12px;
      color:var(--text-muted);
    }

    .account-header-actions{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .account-header-pill{
      padding:8px 16px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
    }

    .profile-card{
      background:var(--card);
      border-radius:24px;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      padding:18px 16px 18px;
      margin-bottom:14px;
    }

    .profile-top{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:10px;
      margin-bottom:10px;
    }

    .avatar-circle{
      width:92px;
      height:92px;
      border-radius:999px;
      background:radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      display:flex;
      align-items:center;
      justify-content:center;
      color:white;
      font-size:40px;
      font-weight:800;
      overflow:hidden;
      position:relative;
    }

    .profile-name{
      font-size:20px;
      font-weight:800;
      color:var(--text-main);
    }

    .profile-role{
      font-size:13px;
      color:var(--text-muted);
      margin-top:-4px;
    }

    .profile-email-line{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      font-size:13px;
      color:var(--text-muted);
      flex-wrap:wrap;
      text-align:center;
    }

    .profile-email-line svg{
      width:14px;
      height:14px;
      stroke:#6b7280;
      stroke-width:1.7;
      fill:none;
    }

    .role-pill{
      margin-top:6px;
      padding:5px 14px;
      border-radius:999px;
      background:#e5edff;
      color:#1e40af;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
    }

    .status-pill{
      margin-top:4px;
      padding:6px 14px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:1px solid var(--green-border);
      background:var(--green-bg);
      color:var(--green);
    }

    .status-dot{
      width:8px;
      height:8px;
      border-radius:999px;
      background:currentColor;
    }

    .profile-detail-card{
      margin-top:12px;
      border-radius:20px;
      border:1px solid var(--line);
      background:var(--white);
      padding:4px 0;
    }

    .detail-row{
      padding:11px 14px;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .detail-row + .detail-row{
      border-top:1px solid var(--line);
    }

    .detail-icon{
      width:30px;
      height:30px;
      border-radius:999px;
      background:#eef2ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .detail-icon svg{
      width:16px;
      height:16px;
      stroke-width:1.7;
      stroke:#4f46e5;
      fill:none;
    }

    .detail-text{
      flex:1;
      min-width:0;
    }

    .detail-label{
      font-size:12px;
      color:var(--text-muted);
    }

    .detail-value{
      font-size:14px;
      color:var(--text-main);
      font-weight:600;
      word-break:break-word;
    }

    .section-heading{
      font-size:13px;
      font-weight:700;
      color:var(--text-muted);
      margin:10px 4px 6px;
    }

    .actions-row{
      display:flex;
      gap:8px;
      margin-bottom:8px;
    }

    .action-btn{
      flex:1;
      padding:11px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      cursor:pointer;
    }

    .action-btn svg{
      width:16px;
      height:16px;
      stroke-width:1.8;
      stroke:currentColor;
      fill:none;
    }

    .action-btn.primary{
      background:var(--blue-soft);
      border-color:var(--blue-soft-border);
      color:#1d4ed8;
    }

    .action-btn.danger{
      background:var(--red-bg);
      border-color:var(--red-border);
      color:var(--red);
    }

    .message{
      display:none;
      margin:0 0 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    @media (max-width:360px){
      .actions-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="account-header">
      <div class="account-header-left">
        <div class="brand-logo">C</div>
        <div>
          <div class="account-title">Colspot</div>
          <div class="account-sub">HOD account profile.</div>
        </div>
      </div>

      <div class="account-header-actions">
        <button class="account-header-pill" id="backBtn" type="button">Back</button>
        <button class="account-header-pill" id="hodLogoutBtn" type="button">Logout</button>
      </div>
    </div>

    <div class="message" id="pageMessage"></div>

    <section class="profile-card">
      <div class="profile-top">
        <div class="avatar-circle">
          <span id="hodAvatarInitial">H</span>
        </div>

        <div class="profile-name" id="hodName">Loading...</div>
        <div class="profile-role">Head of Department</div>

        <div class="profile-email-line">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
            <circle cx="12" cy="11" r="2.5"></circle>
          </svg>
          <span id="hodDepartmentTop">Department</span>
        </div>

        <div class="role-pill">HOD Account</div>

        <div class="status-pill">
          <span class="status-dot"></span>
          <span>Active</span>
        </div>
      </div>

      <div class="profile-detail-card">
        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 18c1-3 3-4.5 7-4.5s6 1.5 7 4.5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Full name</div>
            <div class="detail-value" id="hodFullNameValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="14" rx="2"></rect>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Login ID</div>
            <div class="detail-value" id="hodLoginIdValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Department</div>
            <div class="detail-value" id="hodDepartmentValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">School name</div>
            <div class="detail-value" id="hodSchoolValue">-</div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-heading">Account actions</div>
    <div class="actions-row">
      <button class="action-btn primary" id="backDashboardBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        Back to dashboard
      </button>

      <button class="action-btn danger" id="hodLogoutActionBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M15 3h4v18h-4"></path>
          <path d="M10 17l5-5-5-5"></path>
          <path d="M4 12h11"></path>
        </svg>
        Log out
      </button>
    </div>
  </div>

  <script>
    (() => {
      function $(id) {
        return document.getElementById(id);
      }

      function getSession() {
        try {
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        } catch {
          return null;
        }
      }

      function showMessage(text = "", type = "error") {
        const box = $("pageMessage");
        if (!text) {
          box.className = "message";
          box.textContent = "";
          return;
        }
        box.className = `message show ${type}`;
        box.textContent = text;
      }

      function loadHodProfile() {
        const hodSession = getSession();

        if (!hodSession) {
          window.location.href = "index.html";
          return;
        }

        if (String(hodSession.role || "").toLowerCase() !== "hod") {
          window.location.href = "index.html";
          return;
        }

        const fullName = hodSession.full_name || "HOD";
        const schoolName = hodSession.school_name || "-";
        const departmentName = hodSession.department_name || "-";
        const loginId = hodSession.login_id || "-";
        const initial = fullName.trim().charAt(0).toUpperCase() || "H";

        $("hodAvatarInitial").textContent = initial;
        $("hodName").textContent = fullName;
        $("hodFullNameValue").textContent = fullName;
        $("hodDepartmentTop").textContent = departmentName;
        $("hodDepartmentValue").textContent = departmentName;
        $("hodSchoolValue").textContent = schoolName;
        $("hodLoginIdValue").textContent = loginId;

        showMessage("", "error");
      }

      function logout() {
        localStorage.removeItem("colspot_admin_session");
        localStorage.removeItem("colspot_pending_admin");
        window.location.href = "index.html";
      }

      function goBack() {
        window.location.href = "hod.html";
      }

      document.addEventListener("DOMContentLoaded", () => {
        try {
          loadHodProfile();
        } catch (e) {
          console.error("loadHodProfile error:", e);
          showMessage("Could not load HOD profile.");
        }

        $("backBtn").addEventListener("click", goBack);
        $("backDashboardBtn").addEventListener("click", goBack);
        $("hodLogoutBtn").addEventListener("click", logout);
        $("hodLogoutActionBtn").addEventListener("click", logout);
      });
    })();
  </script>
</body>
</html>
