<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • HOD Account</title>

  <style>
    :root{
      --bg:#f4f7fb;
      --card:#f9fafb;
      --white:#ffffff;
      --line:#e5e7eb;
      --text-main:#111827;
      --text-muted:#6b7280;
      --blue:#2563eb;
      --blue-soft:#e0ecff;
      --blue-soft-border:#d1ddff;
      --red:#b91c1c;
      --red-bg:#fef2f2;
      --red-border:#fecaca;
      --green:#15803d;
      --green-bg:#ecfdf5;
      --green-border:#bbf7d0;
      --shadow:0 14px 36px rgba(15,23,42,.08);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      background:var(--bg);
      color:var(--text-main);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      min-height:100%;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:16px 14px 32px;
    }

    .account-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:4px 2px 10px;
    }

    .account-header-left{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:12px;
      background:linear-gradient(135deg,#60a5fa,#2563eb);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:22px;
      font-weight:800;
      flex-shrink:0;
      box-shadow:0 12px 22px rgba(37,99,235,.24);
    }

    .account-title{
      font-size:18px;
      font-weight:800;
      color:var(--text-main);
    }

    .account-sub{
      font-size:12px;
      color:var(--text-muted);
    }

    .account-header-actions{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .account-header-pill{
      padding:8px 16px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
    }

    .profile-card{
      background:var(--card);
      border-radius:24px;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      padding:18px 16px 18px;
      margin-bottom:14px;
    }

    .profile-top{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:10px;
      margin-bottom:10px;
    }

    .avatar-circle{
      width:92px;
      height:92px;
      border-radius:999px;
      background:radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      display:flex;
      align-items:center;
      justify-content:center;
      color:white;
      font-size:40px;
      font-weight:800;
      overflow:hidden;
      position:relative;
    }

    .profile-name{
      font-size:20px;
      font-weight:800;
      color:var(--text-main);
    }

    .profile-role{
      font-size:13px;
      color:var(--text-muted);
      margin-top:-4px;
    }

    .profile-email-line{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      font-size:13px;
      color:var(--text-muted);
      flex-wrap:wrap;
      text-align:center;
    }

    .profile-email-line svg{
      width:14px;
      height:14px;
      stroke:#6b7280;
      stroke-width:1.7;
      fill:none;
    }

    .role-pill{
      margin-top:6px;
      padding:5px 14px;
      border-radius:999px;
      background:#e5edff;
      color:#1e40af;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
    }

    .status-pill{
      margin-top:4px;
      padding:6px 14px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:1px solid var(--green-border);
      background:var(--green-bg);
      color:var(--green);
    }

    .status-dot{
      width:8px;
      height:8px;
      border-radius:999px;
      background:currentColor;
    }

    .profile-detail-card{
      margin-top:12px;
      border-radius:20px;
      border:1px solid var(--line);
      background:var(--white);
      padding:4px 0;
    }

    .detail-row{
      padding:11px 14px;
      display:flex;
      align-items:flex-start;
      gap:10px;
    }

    .detail-row + .detail-row{
      border-top:1px solid var(--line);
    }

    .detail-icon{
      width:30px;
      height:30px;
      border-radius:999px;
      background:#eef2ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .detail-icon svg{
      width:16px;
      height:16px;
      stroke-width:1.7;
      stroke:#4f46e5;
      fill:none;
    }

    .detail-text{
      flex:1;
      min-width:0;
    }

    .detail-label{
      font-size:12px;
      color:var(--text-muted);
      margin-bottom:2px;
    }

    .detail-value{
      font-size:14px;
      color:var(--text-main);
      font-weight:600;
      word-break:break-word;
    }

    .detail-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
    }

    .edit-link{
      border:none;
      background:transparent;
      color:#2563eb;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
      padding:0;
      flex-shrink:0;
    }

    .verify-badge{
      display:inline-flex;
      align-items:center;
      gap:6px;
      margin-top:7px;
      padding:5px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      width:max-content;
    }

    .verify-badge.verified{
      background:var(--green-bg);
      border:1px solid var(--green-border);
      color:var(--green);
    }

    .verify-badge.unverified{
      background:#fff7ed;
      border:1px solid #fed7aa;
      color:#c2410c;
    }

    .email-editor{
      margin-top:12px;
      border:1px solid #dbeafe;
      background:#f8fbff;
      border-radius:16px;
      padding:12px;
      display:none;
    }

    .email-editor.show{
      display:block;
    }

    .field{
      margin-bottom:10px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:700;
      color:#334155;
      margin-bottom:6px;
    }

    .input{
      width:100%;
      border:1px solid var(--line);
      border-radius:14px;
      padding:12px 13px;
      background:#fff;
      font-size:14px;
      color:var(--text-main);
      outline:none;
    }

    .helper-text{
      font-size:12px;
      color:var(--text-muted);
      line-height:1.45;
      margin:4px 0 10px;
    }

    .editor-row{
      display:flex;
      gap:8px;
      margin-top:10px;
    }

    .editor-btn{
      flex:1;
      padding:11px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
    }

    .editor-btn.primary{
      background:var(--blue-soft);
      border-color:var(--blue-soft-border);
      color:#1d4ed8;
    }

    .editor-btn.secondary{
      background:#fff;
      color:#374151;
    }

    .section-heading{
      font-size:13px;
      font-weight:700;
      color:var(--text-muted);
      margin:10px 4px 6px;
    }

    .actions-row{
      display:flex;
      gap:8px;
      margin-bottom:8px;
    }

    .action-btn{
      flex:1;
      padding:11px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:700;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      cursor:pointer;
    }

    .action-btn svg{
      width:16px;
      height:16px;
      stroke-width:1.8;
      stroke:currentColor;
      fill:none;
    }

    .action-btn.primary{
      background:var(--blue-soft);
      border-color:var(--blue-soft-border);
      color:#1d4ed8;
    }

    .action-btn.danger{
      background:var(--red-bg);
      border-color:var(--red-border);
      color:var(--red);
    }

    .message{
      display:none;
      margin:0 0 14px;
      padding:12px 13px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:#fef2f2;
      border:1px solid #fecaca;
      color:#991b1b;
    }

    .message.success{
      background:#ecfdf5;
      border:1px solid #bbf7d0;
      color:#166534;
    }

    @media (max-width:360px){
      .actions-row,
      .editor-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="account-header">
      <div class="account-header-left">
        <div class="brand-logo">C</div>
        <div>
          <div class="account-title">Colspot</div>
          <div class="account-sub">HOD account profile.</div>
        </div>
      </div>

      <div class="account-header-actions">
        <button class="account-header-pill" id="backBtn" type="button">Back</button>
        <button class="account-header-pill" id="hodLogoutBtn" type="button">Logout</button>
      </div>
    </div>

    <div class="message" id="pageMessage"></div>

    <section class="profile-card">
      <div class="profile-top">
        <div class="avatar-circle">
          <span id="hodAvatarInitial">H</span>
        </div>

        <div class="profile-name" id="hodName">Loading...</div>
        <div class="profile-role">Head of Department</div>

        <div class="profile-email-line">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
            <circle cx="12" cy="11" r="2.5"></circle>
          </svg>
          <span id="hodDepartmentTop">Department</span>
        </div>

        <div class="role-pill">HOD Account</div>

        <div class="status-pill">
          <span class="status-dot"></span>
          <span>Active</span>
        </div>
      </div>

      <div class="profile-detail-card">
        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 18c1-3 3-4.5 7-4.5s6 1.5 7 4.5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Full name</div>
            <div class="detail-value" id="hodFullNameValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="14" rx="2"></rect>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Login ID</div>
            <div class="detail-value" id="hodLoginIdValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z"></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">Department</div>
            <div class="detail-value" id="hodDepartmentValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-label">School name</div>
            <div class="detail-value" id="hodSchoolValue">-</div>
          </div>
        </div>

        <div class="detail-row">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="detail-text">
            <div class="detail-top">
              <div>
                <div class="detail-label">Linked email</div>
                <div class="detail-value" id="hodEmailValue">No linked email</div>
              </div>
              <button class="edit-link" id="editEmailBtn" type="button">Edit</button>
            </div>

            <div class="verify-badge unverified" id="emailStatusBadge">
              <span id="emailStatusText">Not verified</span>
            </div>

            <div class="email-editor" id="emailEditor">
              <div class="field">
                <label for="newEmailInput">New email</label>
                <input id="newEmailInput" class="input" type="email" placeholder="Enter new email address">
              </div>

              <div class="helper-text" id="emailEditorText">
                Enter a new email address and send a verification code.
              </div>

              <div class="editor-row">
                <button class="editor-btn primary" id="sendCodeBtn" type="button">Send code</button>
                <button class="editor-btn secondary" id="cancelEmailEditBtn" type="button">Cancel</button>
              </div>

              <div class="field" id="codeFieldWrap" style="display:none; margin-top:12px;">
                <label for="emailCodeInput">Verification code</label>
                <input id="emailCodeInput" class="input" type="text" inputmode="numeric" placeholder="Enter 6-digit code">
              </div>

              <div class="editor-row" id="verifyRow" style="display:none;">
                <button class="editor-btn primary" id="verifyCodeBtn" type="button">Verify email</button>
                <button class="editor-btn secondary" id="resendCodeBtn" type="button">Resend code</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-heading">Account actions</div>
    <div class="actions-row">
      <button class="action-btn primary" id="resetPasswordBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M12 3a9 9 0 1 0 8.2 5.3"></path>
          <path d="M21 3v6h-6"></path>
        </svg>
        Reset Password
      </button>

      <button class="action-btn danger" id="hodLogoutActionBtn" type="button">
        <svg viewBox="0 0 24 24">
          <path d="M15 3h4v18h-4"></path>
          <path d="M10 17l5-5-5-5"></path>
          <path d="M4 12h11"></path>
        </svg>
        Log out
      </button>
    </div>
  </div>

<script>
(() => {
  const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
  const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
  const EDGE_BASE = `${SUPABASE_URL}/functions/v1`;

  const EDGE = {
    startEmailVerification: "start-hod-email-verification",
    verifyEmailVerification: "verify-hod-email-verification",
    getHodProfile: "get-hod-profile"
  };

  let hodSession = null;
  let pendingEmail = "";

  function $(id) {
    return document.getElementById(id);
  }

  function getSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function saveSession(session) {
    localStorage.setItem("colspot_admin_session", JSON.stringify(session));
  }

  function showMessage(text = "", type = "error") {
    const box = $("pageMessage");
    if (!text) {
      box.className = "message";
      box.textContent = "";
      return;
    }
    box.className = `message show ${type}`;
    box.textContent = text;
  }

  async function invokeEdge(name, payload = {}) {
    const res = await fetch(`${EDGE_BASE}/${name}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "apikey": SUPABASE_ANON_KEY,
        "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
      },
      body: JSON.stringify(payload)
    });

    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result.ok) {
      throw new Error(result.error || `Edge function failed: ${name}`);
    }

    return result;
  }

  function setEmailStatus(linkedEmail, emailVerified) {
    const hasEmail = !!String(linkedEmail || "").trim();
    const badge = $("emailStatusBadge");
    const text = $("emailStatusText");

    if (hasEmail && emailVerified) {
      badge.className = "verify-badge verified";
      text.textContent = "Verified";
    } else if (hasEmail) {
      badge.className = "verify-badge unverified";
      text.textContent = "Not verified";
    } else {
      badge.className = "verify-badge unverified";
      text.textContent = "No email linked";
    }
  }

  function paintProfile(session) {
    const fullName = session.full_name || "HOD";
    const schoolName = session.school_name || "-";
    const departmentName = session.department_name || "-";
    const loginId = session.login_id || "-";
    const linkedEmail = session.linked_email || "";
    const emailVerified = !!session.email_verified;
    const initial = fullName.trim().charAt(0).toUpperCase() || "H";

    $("hodAvatarInitial").textContent = initial;
    $("hodName").textContent = fullName;
    $("hodFullNameValue").textContent = fullName;
    $("hodDepartmentTop").textContent = departmentName;
    $("hodDepartmentValue").textContent = departmentName;
    $("hodSchoolValue").textContent = schoolName;
    $("hodLoginIdValue").textContent = loginId;
    $("hodEmailValue").textContent = linkedEmail || "No linked email";

    setEmailStatus(linkedEmail, emailVerified);
  }

  async function renderHodProfile() {
    hodSession = getSession();

    if (!hodSession) {
      window.location.href = "index.html";
      return;
    }

    if (String(hodSession.role || "").toLowerCase() !== "hod") {
      window.location.href = "index.html";
      return;
    }

    paintProfile(hodSession);

    try {
      const result = await invokeEdge("get-hod-profile", { hod_id: hodSession.id });
      const profile = result.account || {};

      hodSession = {
        ...hodSession,
        ...profile,
        role: "hod"
      };

      saveSession(hodSession);
      paintProfile(hodSession);
    } catch (e) {
      console.error("refresh profile failed:", e);
    }

    showMessage("", "error");
  }

  async function verifyEmailCode() {
    if (!hodSession) return;

    const code = ($("emailCodeInput").value || "").trim();
    if (!code) {
      showMessage("Please enter the verification code.");
      return;
    }

    const btn = $("verifyCodeBtn");
    const oldText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Verifying...";

    try {
      const result = await invokeEdge(EDGE.verifyEmailVerification, {
        hod_id: hodSession.id,
        code
      });

      const updatedEmail = result.linked_email || pendingEmail || "";
      hodSession.linked_email = updatedEmail;
      hodSession.email_verified = true;
      saveSession(hodSession);

      paintProfile(hodSession);

      $("emailEditor").classList.remove("show");
      $("newEmailInput").value = "";
      $("emailCodeInput").value = "";
      $("codeFieldWrap").style.display = "none";
      $("verifyRow").style.display = "none";
      $("emailEditorText").textContent = "Enter a new email address and send a verification code.";
      pendingEmail = "";

      showMessage(result.message || "Email verified successfully.", "success");
    } catch (e) {
      console.error("verifyEmailCode error:", e);
      showMessage(e.message || "Could not verify email.");
    } finally {
      btn.disabled = false;
      btn.textContent = oldText;
    }
  }

  function logout() {
    localStorage.removeItem("colspot_admin_session");
    localStorage.removeItem("colspot_pending_admin");
    window.location.href = "index.html";
  }

  function goBack() {
    window.location.href = "hod.html";
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderHodProfile();

    $("backBtn").addEventListener("click", goBack);
    $("resetPasswordBtn").addEventListener("click", () => {
      window.location.href = "hod_reset_password.html";
    });
    $("hodLogoutBtn").addEventListener("click", logout);
    $("hodLogoutActionBtn").addEventListener("click", logout);
    $("verifyCodeBtn").addEventListener("click", verifyEmailCode);
  });
})();
</script>
</body>
</html>
