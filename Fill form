  async function studentStartForm() {
    const form = window.studentClassActivityState.currentForm;
    if (!form) return;

    if (form.status === "closed") {
      alert("This form is closed.");
      return;
    }

    if (form.status === "submitted" && form.response_rule !== "many") {
      alert("You have already submitted this form.");
      return;
    }

    const btn = qs("studentStartFormBtn");
    const oldText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Opening...";

    try {
      const formData = await loadFormDetails(form.id);
      const state = window.studentClassActivityState;
      state.currentForm = formData;
      state.formQuestions = formData.questions || [];
      state.currentFormIndex = 0;
      state.currentFormResponseId = formData.response_id || null;

      const answersMap = {};
      (formData.answers || []).forEach((a) => {
        let value = a.answer_text;

        if (value == null && a.answer_value != null) value = a.answer_value;
        if (value == null && a.answer_file_url != null) value = a.answer_file_url;
        if (value == null && a.answer_date != null) value = a.answer_date;

        if (value == null && a.answer_json != null) {
          value = a.answer_json;
        }

        try {
          if (typeof value === "string" && (value.startsWith("[") || value.startsWith("{"))) {
            value = JSON.parse(value);
          }
        } catch {}

        answersMap[a.question_id] = value;
      });

      state.formAnswers = answersMap;
      renderFormQuestion();
      showView("studentFormQuestionView");
    } catch (err) {
      console.error("studentStartForm failed:", err);
      alert(err?.message || "Could not open form.");
    } finally {
      btn.disabled = false;
      btn.textContent = oldText;
    }
  }

  function getCurrentFormQuestion() {
    const state = window.studentClassActivityState;
    return (state.formQuestions || [])[state.currentFormIndex] || null;
  }

  function hideAllFormBlocks() {
    [
      "studentFormShortAnswerBlock",
      "studentFormParagraphBlock",
      "studentFormMultipleChoiceBlock",
      "studentFormCheckboxBlock",
      "studentFormDropdownBlock",
      "studentFormYesNoBlock",
      "studentFormDateBlock",
      "studentFormFileBlock"
    ].forEach((id) => qs(id).classList.add("hidden"));
  }

  function setFieldNote(text = "") {
    qs("studentFormFieldNote").textContent = text || "";
  }

  function setCurrentFormValue(value) {
    const state = window.studentClassActivityState;
    const q = getCurrentFormQuestion();
    if (!q) return;
    state.formAnswers[q.id] = value;
  }

  function getCurrentFormValue() {
    const state = window.studentClassActivityState;
    const q = getCurrentFormQuestion();
    if (!q) return "";
    return state.formAnswers[q.id];
  }

  function renderChoiceList(containerId, values, multiple = false) {
    const current = getCurrentFormValue();
    const wrap = qs(containerId);
    wrap.classList.remove("hidden");

    wrap.innerHTML = values.map((value, index) => {
      const active = multiple
        ? Array.isArray(current) && current.includes(value)
        : current === value;

      return `
        <div class="choice-option ${active ? "active" : ""}" data-form-choice="${escapeHtml(value)}">
          <div class="choice-mark">${multiple ? "✓" : String.fromCharCode(65 + index)}</div>
          <div class="choice-text">${escapeHtml(value)}</div>
        </div>
      `;
    }).join("");

    wrap.querySelectorAll("[data-form-choice]").forEach((el) => {
      el.addEventListener("click", () => {
        const value = el.getAttribute("data-form-choice");
        if (multiple) {
          const now = Array.isArray(getCurrentFormValue()) ? [...getCurrentFormValue()] : [];
          const idx = now.indexOf(value);
          if (idx >= 0) now.splice(idx, 1);
          else now.push(value);
          setCurrentFormValue(now);
        } else {
          setCurrentFormValue(value);
        }
        renderFormQuestion();
      });
    });
  }

  function renderFormQuestion() {
    const state = window.studentClassActivityState;
    const questions = state.formQuestions || [];
    const index = Number(state.currentFormIndex || 0);
    const q = questions[index];
    if (!q) return;

    const total = questions.length || 1;
    const percent = Math.round(((index + 1) / total) * 100);

    qs("studentFormProgressText").textContent = `Question ${index + 1} of ${total}`;
    qs("studentFormProgressPercent").textContent = `${percent}%`;
    qs("studentFormProgressBar").style.width = `${percent}%`;

    qs("studentFormQuestionTitle").textContent = q.question_text || "Question";
    const helpEl = qs("studentFormQuestionHelp");
    if (normalizeText(q.help_text || q.description)) {
      helpEl.textContent = q.help_text || q.description || "";
      helpEl.classList.remove("hidden");
    } else {
      helpEl.classList.add("hidden");
    }

    hideAllFormBlocks();
    setFieldNote("");

    const type = String(q.question_type || "short_answer").toLowerCase();
    let options = ensureArray(q.options);

    if (!options.length && q.option_json) {
      try { options = ensureArray(typeof q.option_json === "string" ? JSON.parse(q.option_json) : q.option_json); } catch {}
    }

    if (type === "short_answer" || type === "text") {
      qs("studentFormShortAnswerBlock").classList.remove("hidden");
      qs("studentFormShortAnswerInput").value = getCurrentFormValue() || "";
    } else if (type === "paragraph" || type === "long_text") {
      qs("studentFormParagraphBlock").classList.remove("hidden");
      qs("studentFormParagraphInput").value = getCurrentFormValue() || "";
    } else if (type === "multiple_choice") {
      renderChoiceList("studentFormMultipleChoiceBlock", options, false);
    } else if (type === "checkboxes") {
      renderChoiceList("studentFormCheckboxBlock", options, true);
    } else if (type === "dropdown") {
      const select = qs("studentFormDropdownInput");
      qs("studentFormDropdownBlock").classList.remove("hidden");
      select.innerHTML = `<option value="">Select an option</option>` + options.map((v) => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join("");
      select.value = getCurrentFormValue() || "";
    } else if (type === "yes_no") {
      renderChoiceList("studentFormYesNoBlock", ["Yes", "No"], false);
    } else if (type === "date") {
      qs("studentFormDateBlock").classList.remove("hidden");
      qs("studentFormDateInput").value = getCurrentFormValue() || "";
    } else if (type === "file_upload") {
      qs("studentFormFileBlock").classList.remove("hidden");
      const maxFiles = Number(q.max_files || 1);
      const allowed = ensureArray(q.allowed_file_types || q.file_types || []);
      const fileInput = qs("studentFormFileInput");
      fileInput.multiple = maxFiles > 1;
      if (allowed.length) {
        fileInput.setAttribute("accept", allowed.join(","));
      } else {
        fileInput.removeAttribute("accept");
      }
      qs("studentFormFileRules").textContent =
        `${allowed.length ? "Allowed: " + allowed.join(", ") + ". " : ""}${maxFiles > 1 ? `You can upload up to ${maxFiles} files.` : "Upload one file."}`;

      const current = getCurrentFormValue();
      if (Array.isArray(current) && current.length) {
        setFieldNote(`${current.length} file(s) already selected/uploaded.`);
      } else if (typeof current === "string" && current) {
        setFieldNote("1 file already uploaded.");
      }
    } else {
      qs("studentFormParagraphBlock").classList.remove("hidden");
      qs("studentFormParagraphInput").value = getCurrentFormValue() || "";
    }

    qs("studentFormPrevBtn").onclick = studentGoPrevFormQuestion;
    qs("studentFormNextBtn").onclick = studentGoNextFormQuestion;
    qs("studentFormNextBtn").textContent = index === total - 1 ? "Review" : "Next";
  }

  function collectCurrentFormInputValue() {
    const q = getCurrentFormQuestion();
    if (!q) return;

    const type = String(q.question_type || "short_answer").toLowerCase();

    if (type === "short_answer" || type === "text") {
      setCurrentFormValue(qs("studentFormShortAnswerInput").value.trim());
    } else if (type === "paragraph" || type === "long_text") {
      setCurrentFormValue(qs("studentFormParagraphInput").value.trim());
    } else if (type === "dropdown") {
      setCurrentFormValue(qs("studentFormDropdownInput").value || "");
    } else if (type === "date") {
      setCurrentFormValue(qs("studentFormDateInput").value || "");
    }
  }

  function isRequiredQuestion(q) {
    return q?.is_required === true || q?.required === true;
  }

  function validateCurrentFormQuestion() {
    collectCurrentFormInputValue();

    const q = getCurrentFormQuestion();
    if (!q) return true;
    if (!isRequiredQuestion(q)) return true;

    const answer = getCurrentFormValue();
    const type = String(q.question_type || "short_answer").toLowerCase();

    if (type === "checkboxes") {
      return Array.isArray(answer) && answer.length > 0;
    }

    if (type === "file_upload") {
      return (
        (Array.isArray(answer) && answer.length > 0) ||
        (typeof answer === "string" && !!answer)
      );
    }

    return !!normalizeText(answer);
  }

  async function uploadFormFiles(files, q) {
    if (!files?.length) return;

    const maxFiles = Number(q.max_files || 1);
    const allowed = ensureArray(q.allowed_file_types || q.file_types || []);

    if (files.length > maxFiles) {
      alert(`You can only upload up to ${maxFiles} file(s).`);
      return;
    }

    for (const file of files) {
      if (allowed.length) {
        const extension = "." + file.name.split(".").pop().toLowerCase();
        const mime = file.type || "";
        const matches = allowed.some((type) => {
          const t = String(type || "").toLowerCase();
          return t === mime.toLowerCase() || t === extension || t === file.name.toLowerCase();
        });

        if (!matches) {
          alert(`${file.name} is not an allowed file type.`);
          qs("studentFormFileInput").value = "";
          return;
        }
      }
    }

    const uploadedUrls = [];

    for (const file of files) {
      const fileExt = file.name.includes(".") ? file.name.split(".").pop() : "bin";
      const path = `student-form-uploads/${Date.now()}-${Math.random().toString(36).slice(2)}.${fileExt}`;

      const { error: uploadError } = await supabase.storage
        .from("form-uploads")
        .upload(path, file, { upsert: false });

      if (uploadError) {
        console.error("Form file upload failed:", uploadError);
        alert(uploadError.message || "Could not upload file.");
        return;
      }

      const { data: publicUrlData } = supabase.storage
        .from("form-uploads")
        .getPublicUrl(path);

      uploadedUrls.push(publicUrlData?.publicUrl || "");
    }

    setCurrentFormValue(maxFiles > 1 ? uploadedUrls : uploadedUrls[0]);
    setFieldNote(`${uploadedUrls.length} file(s) uploaded successfully.`);
  }

  function studentGoNextFormQuestion() {
    if (!validateCurrentFormQuestion()) {
      alert("Please answer this required question before continuing.");
      return;
    }

    const state = window.studentClassActivityState;
    const total = (state.formQuestions || []).length;

    if (state.currentFormIndex >= total - 1) {
      renderFormReview();
      showView("studentFormReviewView");
      return;
    }

    state.currentFormIndex += 1;
    renderFormQuestion();
  }

  function studentGoPrevFormQuestion() {
    const state = window.studentClassActivityState;
    if (state.currentFormIndex > 0) {
      state.currentFormIndex -= 1;
      renderFormQuestion();
    } else {
      showView("studentFormDetailsView");
    }
  }

  window.studentGoPrevFormQuestion = studentGoPrevFormQuestion;

  function formatFormAnswerPreview(q, answer) {
    const type = String(q.question_type || "short_answer").toLowerCase();

    if (type === "checkboxes") {
      return Array.isArray(answer) && answer.length ? answer.join(", ") : "No answer";
    }

    if (type === "file_upload") {
      if (Array.isArray(answer) && answer.length) return `${answer.length} file(s) uploaded`;
      if (typeof answer === "string" && answer) return "1 file uploaded";
      return "No file uploaded";
    }

    return normalizeText(answer) || "No answer";
  }

  function renderFormReview() {
    const state = window.studentClassActivityState;
    const wrap = qs("studentFormReviewList");

    wrap.innerHTML = (state.formQuestions || []).map((q, index) => {
      const answer = state.formAnswers[q.id];
      return `
        <div class="review-item" data-review-form-index="${index}">
          <div class="review-q">${escapeHtml(q.question_text || "Question")}</div>
          <div class="review-a"><strong>Your answer:</strong> ${escapeHtml(formatFormAnswerPreview(q, answer))}</div>
        </div>
      `;
    }).join("");

    wrap.querySelectorAll("[data-review-form-index]").forEach((el) => {
      el.addEventListener("click", () => {
        window.studentClassActivityState.currentFormIndex = Number(el.getAttribute("data-review-form-index"));
        renderFormQuestion();
        showView("studentFormQuestionView");
      });
    });
  }

  function studentBackToFormQuestions() {
    showView("studentFormQuestionView");
    renderFormQuestion();
  }

  window.studentBackToFormQuestions = studentBackToFormQuestions;

  async function ensureFormResponse() {
    const state = window.studentClassActivityState;
    const form = state.currentForm;
    const user = await ensureUser();

    if (state.currentFormResponseId) return state.currentFormResponseId;

    const { data: existing, error: existingError } = await supabase
      .from("form_responses")
      .select("id")
      .eq("form_id", form.id)
      .eq("submitted_by", user.id)
      .maybeSingle();

    if (existingError) throw existingError;

    if (existing) {
      state.currentFormResponseId = existing.id;
      return existing.id;
    }

    return null;
  }

  function buildStudentFormAnswersPayload(responseId) {
    const state = window.studentClassActivityState;
    const rows = [];

    for (const q of state.formQuestions || []) {
      const rawAnswer = state.formAnswers[q.id];
      const type = String(q.question_type || "short_answer").toLowerCase();

      let answer_text = null;
      let answer_json = null;
      let answer_date = null;
      let answer_file_url = null;

      if (type === "date") {
        answer_date = rawAnswer || null;
        answer_text = rawAnswer || null;
      } else if (type === "file_upload") {
        if (Array.isArray(rawAnswer)) {
          answer_json = rawAnswer;
          answer_text = rawAnswer.join(", ");
          answer_file_url = rawAnswer[0] || null;
        } else if (rawAnswer && typeof rawAnswer === "string") {
          answer_text = rawAnswer;
          answer_file_url = rawAnswer;
        }
      } else if (Array.isArray(rawAnswer)) {
        answer_json = rawAnswer;
        answer_text = rawAnswer.join(", ");
      } else if (rawAnswer && typeof rawAnswer === "object") {
        answer_json = rawAnswer;
        answer_text = JSON.stringify(rawAnswer);
      } else {
        answer_text = rawAnswer == null ? "" : String(rawAnswer);
      }

      rows.push({
        response_id: responseId,
        question_id: q.id,
        answer_text,
        answer_json,
        answer_date,
        answer_file_url
      });
    }

    return rows;
  }

  async function submitForm() {
    const state = window.studentClassActivityState;
    const form = state.currentForm;
    if (!form) return;

    if (form.status === "submitted" && form.response_rule !== "many") {
      alert("You have already submitted this form.");
      return;
    }

    if (form.status === "closed") {
      alert("This form is closed.");
      return;
    }

    const btn = qs("studentSubmitFormBtn");
    const oldText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Submitting...";

    try {
      for (let i = 0; i < (state.formQuestions || []).length; i++) {
        state.currentFormIndex = i;
        if (!validateCurrentFormQuestion()) {
          alert("Please answer all required questions before submitting.");
          btn.disabled = false;
          btn.textContent = oldText;
          return;
        }
      }

      const user = await ensureUser();
      const existingResponseId = await ensureFormResponse();

      if (existingResponseId) {
        const { error: deleteError } = await supabase
          .from("form_answers")
          .delete()
          .eq("response_id", existingResponseId);

        if (deleteError) throw deleteError;

        const rows = buildStudentFormAnswersPayload(existingResponseId);
        if (rows.length) {
          const { error: answerError } = await supabase
            .from("form_answers")
            .insert(rows);
          if (answerError) throw answerError;
        }

        const { error: updateResponseError } = await supabase
          .from("form_responses")
          .update({
            status: "submitted",
            submitted_at: new Date().toISOString()
          })
          .eq("id", existingResponseId);

        if (updateResponseError) throw updateResponseError;

        state.currentFormResponseId = existingResponseId;
      } else {
        const { data: createdResponse, error: responseError } = await supabase
          .from("form_responses")
          .insert([{
            form_id: form.id,
            submitted_by: user.id,
            submitted_by_role: "student",
            submitter_name: user.user_metadata?.full_name || user.email || "Student",
            submitter_email: user.email || null,
            school_name: form.school_name || null,
            status: "submitted",
            submitted_at: new Date().toISOString()
          }])
          .select("id")
          .single();

        if (responseError) throw responseError;

        state.currentFormResponseId = createdResponse.id;

        const rows = buildStudentFormAnswersPayload(createdResponse.id);
        if (rows.length) {
          const { error: answerError } = await supabase
            .from("form_answers")
            .insert(rows);
          if (answerError) throw answerError;
        }
      }

      showView("studentFormSubmittedView");
    } catch (err) {
      console.error("submitForm failed:", err);
      alert(err?.message || "Could not submit form.");
    } finally {
      btn.disabled = false;
      btn.textContent = oldText;
    }
  }

  function bindStaticEvents() {
    qs("studentStartActivityBtn").addEventListener("click", studentStartActivity);
    qs("studentSubmitActivityBtn").addEventListener("click", () => studentSubmitActivity(false));
    qs("studentStartFormBtn").addEventListener("click", studentStartForm);
    qs("studentSubmitFormBtn").addEventListener("click", submitForm);

    qs("studentFormShortAnswerInput").addEventListener("input", () => {
      setCurrentFormValue(qs("studentFormShortAnswerInput").value);
    });

    qs("studentFormParagraphInput").addEventListener("input", () => {
      setCurrentFormValue(qs("studentFormParagraphInput").value);
    });

    qs("studentFormDropdownInput").addEventListener("change", () => {
      setCurrentFormValue(qs("studentFormDropdownInput").value);
    });

    qs("studentFormDateInput").addEventListener("change", () => {
      setCurrentFormValue(qs("studentFormDateInput").value);
    });

    qs("studentFormChooseFileBtn").addEventListener("click", () => {
      qs("studentFormFileInput").click();
    });

    qs("studentFormFileInput").addEventListener("change", async (e) => {
      const q = getCurrentFormQuestion();
      if (!q) return;
      await uploadFormFiles(Array.from(e.target.files || []), q);
    });
  }

  async function initPage() {
    bindStaticEvents();

    try {
      const { type, id } = getParams();
      if (!type || !id) throw new Error("Missing type or id in page link.");

      window.studentClassActivityState.mode = type;
      window.studentClassActivityState.itemId = id;

      if (type === "form") {
        await openFormDetails(id);
      } else if (type === "revision") {
        await openActivityIntro(id);
      } else {
        throw new Error("Unsupported page type.");
      }
    } catch (err) {
      console.error("fill_form init failed:", err);
      showError(err?.message || "Could not load this page.");
    }
  }

  initPage();
</script>
</body>
