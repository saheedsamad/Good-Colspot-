    }

    const type = String(currentUpdateRule.type || "").toLowerCase();
    const title = currentUpdateRule.title || "New version available";
    const message = currentUpdateRule.message || "Please update Colspot.";

    if (type === "hard") {
      if (softSection) softSection.style.display = "none";
      if (hardTitle) hardTitle.textContent = title;
      if (hardMessage) hardMessage.textContent = message;
      if (hardOverlay) hardOverlay.style.display = "flex";
