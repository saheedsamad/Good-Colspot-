  function applyUpdateRuleFromLocal() {
    const softSection = document.getElementById("updateSoftSection");
    const softTitle = document.getElementById("updateSoftTitle");
    const softMessage = document.getElementById("updateSoftMessage");
    const hardOverlay = document.getElementById("updateHardOverlay");
    const hardTitle = document.getElementById("updateHardTitle");
