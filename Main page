  function initNearbyAttendance() {
    const statusEl = document.getElementById("nearbyStatus");
    if (!statusEl) return;

    if (!locationEnabled) {
      statusEl.textContent =
        "Location is off. Turn it on to see nearby sessions, or use a PIN from your lecturer.";
      return;
    }

    if (isBrowserOffline()) {
      statusEl.textContent =
        "No internet connection. We’ll refresh nearby sessions when you’re back online.";
      scheduleOfflineRetry();
      return;
    }

    if (!("geolocation" in navigator)) {
      showLastSessionFallback(statusEl);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        if (typeof supabase === "undefined") {
          statusEl.textContent =
            "Location is OK but we can’t reach Colspot servers right now. Please check your internet or close and reopen the app.";
          return;
        }

        try {
          const nowIso = new Date().toISOString();

          const { data, error } = await supabase
            .from("attendance_sessions")
            .select(
              "id, course_code, expires_at, latitude, longitude, created_at"
            )
            .gte("expires_at", nowIso);

          if (error) throw error;

          const sessions = (data || []).filter(
            (s) =>
              typeof s.latitude === "number" &&
              typeof s.longitude === "number"
          );

          let nearby = sessions.filter((s) => {
            const d = distanceInMeters(lat, lng, s.latitude, s.longitude);
            return d <= NEARBY_RADIUS_METERS;
          });

          if (!nearby.length && sessions.length > 0) {
            sessions.sort((a, b) => {
              const da = distanceInMeters(lat, lng, a.latitude, a.longitude);
              const db = distanceInMeters(lat, lng, b.latitude, b.longitude);
              return da - db;
            });
            nearby = [sessions[0]];
          }

          if (!nearby.length) {
            await showLastSessionFallback(statusEl);
            return;
          }

          const s0 = nearby[0];
          const end = s0.expires_at ? new Date(s0.expires_at) : null;
          const timeStr = end
            ? end.toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })
            : "--:--";

          const code = s0.course_code || "Attendance session";
          statusEl.textContent = `Active near you: ${code} (until ${timeStr})`;

          stopOfflineRetry();
        } catch (e) {
          console.error(e);
          statusEl.textContent =
            "Error loading nearby attendance. We’ll keep trying in the background. You can still create a session.";
          scheduleOfflineRetry();
        }
      },
      async () => {
        await showLastSessionFallback(statusEl);
      },
      {
        enableHighAccuracy: false,
        maximumAge: 60000,
        timeout: 10000,
      }
    );
  }

  async function showLastSessionFallback(statusEl) {
    if (typeof supabase === "undefined") {
      statusEl.textContent =
        "We couldn’t reach the server yet. Please check your internet connection or try again in a moment.";
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (isBrowserOffline()) {
        statusEl.textContent =
          "No internet connection. We’ll try again automatically…";
      } else {
        statusEl.textContent =
          "Trying to reconnect… we’ll update this automatically.";
      }
      scheduleOfflineRetry();
      return;
    }

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("course_code, starts_at, created_at, expires_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;

      const s = (data || [])[0];
      if (!s) {
        statusEl.textContent =
          "No attendance sessions yet. Create one to get started.";
        stopOfflineRetry();
        return;
      }

      const baseDateStr = s.starts_at || s.expires_at || s.created_at;
      const d = baseDateStr ? new Date(baseDateStr) : null;
      const timeStr = d
        ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "--:--";

      const code = s.course_code || "Attendance session";
      statusEl.textContent = `Last session you created: ${code} (at ${timeStr})`;

      stopOfflineRetry();
    } catch (e) {
      console.error(e);
      statusEl.textContent =
        "We couldn't load your recent sessions yet. We’ll keep trying. You can still create a new one.";
      scheduleOfflineRetry();
    }
  }

