    }
  }

  function isBrowserOffline() {
    try {
      if (typeof navigator === "undefined" || navigator === null) return false;
      return navigator.onLine === false;
    } catch {
      return false;
    }
  }

  function updateHistoryNavBadge(totalUnread) {
    const badge = document.getElementById("historyUnreadBadge");
    if (!badge) return;

    if (!totalUnread || totalUnread <= 0) {
      badge.style.display = "none";
      badge.textContent = "0";
      return;
    }

    badge.style.display = "inline-block";
    badge.textContent = totalUnread > 99 ? "99+" : String(totalUnread);
  }

  async function loadHistoryUnreadBadge() {
    try {
      if (typeof supabase === "undefined") return;

      const user = await ensureCurrentUser();
      if (!user || !user.id) return;

      let formsUnread = 0;
      let announcementsUnread = 0;
      let revisionsUnread = 0;

      const { count: formCount, error: formError } = await supabase
        .from("form_notifications")
        .select("*", { count: "exact", head: true })
        .eq("user_id", user.id)
        .eq("is_read", false);

      if (!formError) formsUnread = formCount || 0;

      const { count: announcementCount, error: announcementError } = await supabase
        .from("announcement_notifications")
        .select("*", { count: "exact", head: true })
        .eq("user_id", user.id)
        .eq("is_read", false);

      if (!announcementError) announcementsUnread = announcementCount || 0;

      const { data: memberships, error: membershipError } = await supabase
        .from("course_memberships")
        .select("course_id")
        .eq("user_id", user.id);

      if (!membershipError) {
        const classIds = (memberships || []).map((row) => row.course_id).filter(Boolean);

        if (classIds.length) {
          const { data: activities, error: activitiesError } = await supabase
            .from("class_activities")
            .select("id")
            .in("class_id", classIds)
            .eq("is_published", true)
            .eq("status", "published");

          if (!activitiesError) {
            const activityIds = (activities || []).map((row) => row.id).filter(Boolean);

            if (activityIds.length) {
              const { data: attempts, error: attemptsError } = await supabase
                .from("class_activity_attempts")
                .select("activity_id")
                .eq("user_id", user.id)
                .in("activity_id", activityIds);

              if (!attemptsError) {
                const attemptedSet = new Set((attempts || []).map((row) => row.activity_id));
                revisionsUnread = activityIds.filter((id) => !attemptedSet.has(id)).length;
              }
            }
          }
        }
      }

