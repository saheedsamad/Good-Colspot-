  </div>

  <div id="rowList" class="row-list"></div>
  <div id="emptyState" class="empty-state" style="display:none;">
    No students found for this course yet.
  </div>
</div>

<script>
  let reportsAllCourses = [];
  let reportsCurrentCourse = null;
  let reportsCurrentRows = [];

  let reportsRuleTotalMarks = 20;
  let reportsRuleMinAttendance = 75;
  let reportsRuleBelowMarks = 0;
  let reportsMarksEnabled = true;

  function reportsShowError(msg) {
    const box = document.getElementById("errorBox");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function reportsSetStatsText(text) {
    const el = document.getElementById("statsText");
    if (el) el.textContent = text;
  }

  function reportsUpdateRuleSummary() {
    const el = document.getElementById("ruleSummary");
    if (!el) return;
    if (!reportsMarksEnabled) {
      el.textContent =
        "Marks disabled, only attendance % will be shown in the table.";
      return;
    }
    el.textContent =
      `e.g. students with at least ${reportsRuleMinAttendance}% get ${reportsRuleTotalMarks} marks. ` +
      `Others get ${reportsRuleBelowMarks} marks.`;
  }

  function reportsIsOffline() {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isBrowserOffline === "function"
      ) {
        return ColspotGuard.isBrowserOffline();
      }
    } catch (e) {}
    try {
      return typeof navigator !== "undefined" && navigator.onLine === false;
    } catch {
      return false;
    }
  }

  function reportsIsLikelyOfflineError(err) {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isLikelyOfflineError === "function"
      ) {
        if (ColspotGuard.isLikelyOfflineError(err)) return true;
      }
    } catch (e) {}
    return reportsIsOffline();
  }

  function reportsSafeText(v) {
    return String(v || "").trim();
  }

  function reportsNormalizeCourse(course) {
    if (!course || typeof course !== "object") return null;
    return {
      raw: course,
      id: course.id || null,
      course_code: reportsSafeText(course.course_code),
      course_title: reportsSafeText(course.course_title),
      academic_session: reportsSafeText(course.academic_session),
      created_by: course.created_by || null
    };
  }

  function reportsCourseLabel(course) {
    const code = reportsSafeText(course?.course_code);
    const title = reportsSafeText(course?.course_title);
    if (code && title) return `${code} — ${title}`;
    return code || title || "Unnamed course";
  }

  function reportsCourseMatchesSearch(course, q) {
    const code = reportsSafeText(course?.course_code).toLowerCase();
    const title = reportsSafeText(course?.course_title).toLowerCase();
    const session = reportsSafeText(course?.academic_session).toLowerCase();
    return (
      code.includes(q) ||
      title.includes(q) ||
      session.includes(q)
    );
  }

  function reportsFindCourseById(courseId) {
    return reportsAllCourses.find((c) => String(c.id) === String(courseId)) || null;
  }

  function reportsRowKeyFromMember(row) {
    const matric =
      reportsSafeText(row.student_matric) ||
      reportsSafeText(row.matric_number) ||
      reportsSafeText(row.matric) ||
      reportsSafeText(row.student_id_number);

    const name =
      reportsSafeText(row.student_name) ||
      reportsSafeText(row.full_name) ||
      reportsSafeText(row.name) ||
      reportsSafeText(row.member_name);

    const userId =
      reportsSafeText(row.student_id) ||
      reportsSafeText(row.user_id) ||
      reportsSafeText(row.member_user_id) ||
      reportsSafeText(row.profile_id);

    return matric || userId || name || `member-${Math.random().toString(36).slice(2)}`;
  }

  function reportsNormalizeMember(row) {
    return {
      key: reportsRowKeyFromMember(row),
      name:
        reportsSafeText(row.student_name) ||
        reportsSafeText(row.full_name) ||
        reportsSafeText(row.name) ||
        reportsSafeText(row.member_name) ||
        "Student",
      matric:
        reportsSafeText(row.student_matric) ||
        reportsSafeText(row.matric_number) ||
        reportsSafeText(row.matric) ||
        reportsSafeText(row.student_id_number) ||
        "",
      dept:
        reportsSafeText(row.student_department) ||
        reportsSafeText(row.department) ||
        reportsSafeText(row.programme) ||
        reportsSafeText(row.program) ||
        "",
      userId:
        reportsSafeText(row.student_id) ||
        reportsSafeText(row.user_id) ||
        reportsSafeText(row.member_user_id) ||
        reportsSafeText(row.profile_id) ||
        "",
      raw: row
    };
  }

  function reportsRowKeyFromAttendanceRecord(rec) {
    const matric = reportsSafeText(rec.student_matric);
    const name = reportsSafeText(rec.student_name);
    const userId = reportsSafeText(rec.user_id);
    return matric || userId || name || "";
  }

  function reportsSessionBelongsToCourse(session, course) {
    if (!session || !course) return false;

    const sessionCourseId =
      session.course_id ||
      session.class_id ||
      session.course_ref_id ||
      null;

    if (sessionCourseId && course.id && String(sessionCourseId) === String(course.id)) {
      return true;
    }

    const sessionCourseCode = reportsSafeText(session.course_code).toUpperCase();
    const courseCode = reportsSafeText(course.course_code).toUpperCase();

    if (sessionCourseCode && courseCode && sessionCourseCode === courseCode) {
      return true;
    }

    return false;
  }

  function reportsMembershipBelongsToCourse(member, course) {
    if (!member || !course) return false;

    const membershipCourseId =
      member.course_id ||
      member.class_id ||
      member.course_ref_id ||
      null;

    if (membershipCourseId && course.id && String(membershipCourseId) === String(course.id)) {
      return true;
    }

    const membershipCourseCode = reportsSafeText(member.course_code).toUpperCase();
    const courseCode = reportsSafeText(course.course_code).toUpperCase();

    if (membershipCourseCode && courseCode && membershipCourseCode === courseCode) {
      return true;
    }

    return false;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await new Promise((r) => setTimeout(r, 50));

    const totalInput = document.getElementById("ruleTotalMarks");
    const minInput = document.getElementById("ruleMinAttendance");
    const belowInput = document.getElementById("ruleBelowMarks");

    if (totalInput) {
      totalInput.addEventListener("input", () => {
        reportsRuleTotalMarks = parseFloat(totalInput.value || "0") || 0;
        reportsMarksEnabled = true;
        reportsUpdateRuleSummary();
        reportsApplyRuleAndRender();
      });
    }
    if (minInput) {
      minInput.addEventListener("input", () => {
        reportsRuleMinAttendance = parseFloat(minInput.value || "0") || 0;
        reportsMarksEnabled = true;
        reportsUpdateRuleSummary();
        reportsApplyRuleAndRender();
      });
    }
    if (belowInput) {
      belowInput.addEventListener("input", () => {
        reportsRuleBelowMarks = parseFloat(belowInput.value || "0") || 0;
        reportsMarksEnabled = true;
        reportsUpdateRuleSummary();
        reportsApplyRuleAndRender();
      });
    }

    reportsUpdateRuleSummary();

    if (typeof supabase === "undefined") {
      reportsShowError("Backend not available. Please reload when online.");
      reportsSetStatsText("Backend not connected.");
      return;
    }

    let user = null;
    try {
      if (typeof ensureCurrentUser === "function") {
        user = await ensureCurrentUser();
      } else {
        const { data, error } = await supabase.auth.getUser();
        if (!error && data && data.user) {
          user = data.user;
        } else if (reportsIsLikelyOfflineError(error)) {
          reportsShowError("");
          reportsSetStatsText(
            "No internet connection or bad network. We’ll load your reports when you reconnect."
          );
          return;
        }
      }
    } catch (e) {
      if (reportsIsLikelyOfflineError(e)) {
        reportsShowError("");
        reportsSetStatsText(
          "No internet connection or bad network. We’ll load your reports when you reconnect."
        );
        return;
      }
      reportsShowError(
        "Could not confirm your account. Try again or sign in again from the Home screen."
      );
      reportsSetStatsText("Unable to load reports.");
      return;
    }

    if (!user) {
      reportsShowError(
        "We couldn't confirm your account. Go back Home and sign in again if needed."
      );
      reportsSetStatsText("Unable to load reports.");
      return;
    }

    if (typeof currentUser !== "undefined") {
      currentUser = user;
    }

    reportsLoadCourses();
  });

  async function reportsLoadCourses() {
    const select = document.getElementById("courseSelect");
    const searchField = document.getElementById("courseSearchInput");
    if (!select) return;

    if (searchField) searchField.value = "";
    reportsShowError("");
    reportsSetStatsText("Loading courses...");

    if (typeof supabase === "undefined") {
      reportsShowError("Backend not available.");
      reportsSetStatsText("Backend not connected.");
      return;
    }

    if (reportsIsOffline()) {
      reportsSetStatsText(
        "No internet connection. We will load your courses and reports when you are back online."
      );
      reportsShowError("");
      select.innerHTML =
        '<option value="">Offline – cannot load courses</option>';
      return;
    }

    if (!currentUser) {
      reportsSetStatsText("We couldn't confirm your account.");
      select.innerHTML =
        '<option value="">Sign in again from Home</option>';
      return;
    }

    try {
      const { data, error } = await supabase
        .from("courses")
        .select("*")
        .eq("created_by", currentUser.id)
        .order("created_at", { ascending: false });

      if (error) {
        console.error(error);
        select.innerHTML = '<option value="">Could not load courses</option>';
        reportsSetStatsText("Error loading courses.");
        reportsShowError("Could not load courses. Please try again.");
        return;
      }

      reportsAllCourses = (data || [])
        .map(reportsNormalizeCourse)
        .filter(Boolean);

      if (!reportsAllCourses.length) {
        select.innerHTML =
          '<option value="">No classes yet – create a class first</option>';
        reportsSetStatsText("0 classes • 0 students");
        const meta = document.getElementById("courseMeta");
        if (meta) meta.textContent = "—";
        return;
      }

      reportsRenderCourseOptions();
      reportsSetStatsText("Select a class to view report.");
      const meta = document.getElementById("courseMeta");
      if (meta) meta.textContent = "—";
    } catch (e) {
      console.error("reportsLoadCourses error:", e);
      reportsShowError("Unexpected error while loading courses.");
      reportsSetStatsText("Error loading courses.");
    }
  }

  function reportsRenderCourseOptions(filterText = "") {
    const select = document.getElementById("courseSelect");
    if (!select) return;

    const q = reportsSafeText(filterText).toLowerCase();
    select.innerHTML = '<option value="">Select a course</option>';

    let found = false;

    reportsAllCourses.forEach((course) => {
      if (!q || reportsCourseMatchesSearch(course, q)) {
        const opt = document.createElement("option");
        opt.value = course.id || course.course_code || "";
        opt.textContent = reportsCourseLabel(course);
        if (reportsCurrentCourse && String(opt.value) === String(reportsCurrentCourse.id || reportsCurrentCourse.course_code)) {
          opt.selected = true;
        }
        select.appendChild(opt);
        found = true;
      }
    });

    if (!found) {
      const opt = document.createElement("option");
      opt.disabled = true;
      opt.textContent = "No matching course";
      select.appendChild(opt);
    }
  }

  function reportsFilterCourseOptions() {
    const input = document.getElementById("courseSearchInput");
    if (!input) return;
    reportsRenderCourseOptions(input.value);
  }

  function reportsOnCourseChange() {
    const select = document.getElementById("courseSelect");
    if (!select) return;

    const selectedValue = select.value || "";
    reportsCurrentCourse =
      reportsFindCourseById(selectedValue) ||
      reportsAllCourses.find((c) => reportsSafeText(c.course_code) === reportsSafeText(selectedValue)) ||
      null;

    const search = document.getElementById("searchInput");
    if (search) search.value = "";

    if (!reportsCurrentCourse) {
      reportsCurrentRows = [];
      reportsRenderRows();
      reportsSetStatsText("Select a class to view report.");
      const meta = document.getElementById("courseMeta");
      if (meta) meta.textContent = "—";
      return;
    }

    reportsLoadCourseReport(reportsCurrentCourse);
  }

  async function reportsLoadCourseReport(course) {
    reportsShowError("");
    const rowList = document.getElementById("rowList");
    const emptyState = document.getElementById("emptyState");
    if (!rowList || !emptyState) return;

    rowList.innerHTML = "";
    emptyState.style.display = "none";
    reportsSetStatsText("Loading attendance for " + reportsCourseLabel(course) + "...");

    if (typeof supabase === "undefined") {
      reportsShowError("Backend not available.");
      reportsSetStatsText("Backend not connected.");
      return;
    }

    if (reportsIsOffline()) {
      reportsShowError(
        "No internet connection. Connect again to load this report."
      );
      reportsSetStatsText("Offline – cannot load report for " + reportsCourseLabel(course));
      return;
    }

    try {
      const [
        membershipRes,
        sessionsRes
      ] = await Promise.all([
        supabase.from("course_memberships").select("*"),
        supabase
          .from("attendance_sessions")
          .select("*")
          .eq("created_by", currentUser.id)
          .order("created_at", { ascending: false })
      ]);

      if (membershipRes.error) {
        console.error("course_memberships error:", membershipRes.error);
        reportsShowError(
          "Could not load class members. Make sure the course_memberships table exists and try again."
        );
        reportsSetStatsText("Error loading members.");
        return;
      }

      if (sessionsRes.error) {
        console.error("attendance_sessions error:", sessionsRes.error);
        reportsShowError(
          "Could not load attendance sessions. Please try again."
        );
        reportsSetStatsText("Error loading sessions.");
        return;
      }

      const allMemberships = Array.isArray(membershipRes.data) ? membershipRes.data : [];
      const allSessions = Array.isArray(sessionsRes.data) ? sessionsRes.data : [];

      const memberships = allMemberships.filter((m) =>
        reportsMembershipBelongsToCourse(m, course)
      );

      const sessions = allSessions.filter((s) =>
        reportsSessionBelongsToCourse(s, course)
      );

      const totalSessions = sessions.length;
      const sessionIds = sessions
        .map((s) => s.id)
        .filter(Boolean);

      let records = [];
      if (sessionIds.length) {
        const { data: recData, error: recError } = await supabase
          .from("attendance_records")
          .select("session_id, student_name, student_matric, student_department, user_id")
          .in("session_id", sessionIds);

        if (recError) {
          console.error("attendance_records error:", recError);
          reportsShowError(
            "Could not load attendance records. Please try again."
          );
          reportsSetStatsText("Error loading attendance records.");
          return;
        }

        records = Array.isArray(recData) ? recData : [];
      }

      const attendedByKey = new Map();

      records.forEach((rec) => {
        const key = reportsRowKeyFromAttendanceRecord(rec);
        if (!key) return;

        if (!attendedByKey.has(key)) {
          attendedByKey.set(key, {
            sessionIds: new Set(),
            latestName: reportsSafeText(rec.student_name),
            latestMatric: reportsSafeText(rec.student_matric),
            latestDept: reportsSafeText(rec.student_department)
          });
        }

        const existing = attendedByKey.get(key);
        if (rec.session_id) existing.sessionIds.add(rec.session_id);
        if (!existing.latestName && rec.student_name) existing.latestName = reportsSafeText(rec.student_name);
        if (!existing.latestMatric && rec.student_matric) existing.latestMatric = reportsSafeText(rec.student_matric);
        if (!existing.latestDept && rec.student_department) existing.latestDept = reportsSafeText(rec.student_department);
      });

      const rosterRows = memberships.map((memberRow) => {
        const member = reportsNormalizeMember(memberRow);
        const attendanceInfo = attendedByKey.get(member.key);

        const attended = attendanceInfo ? attendanceInfo.sessionIds.size : 0;
        const total = totalSessions;
        const percent = total > 0 ? (attended / total) * 100 : 0;

        return {
          name: member.name || attendanceInfo?.latestName || "Student",
          matric: member.matric || attendanceInfo?.latestMatric || "",
          dept: member.dept || attendanceInfo?.latestDept || "",
          attended,
          total,
          percent,
          mark: null
        };
      });

      rosterRows.sort((a, b) => {
        if (a.matric && b.matric) return a.matric.localeCompare(b.matric);
        return (a.name || "").localeCompare(b.name || "");
      });

      reportsCurrentRows = rosterRows;

      const meta = document.getElementById("courseMeta");
      if (meta) {
        meta.textContent =
          `${memberships.length} members • ${totalSessions} total sessions` +
          (course.academic_session ? ` • ${course.academic_session}` : "");
      }

      reportsApplyRuleAndRender();
    } catch (e) {
      console.error("reportsLoadCourseReport error:", e);
      reportsShowError(
        "Unexpected error while loading report. Please try again."
      );
      reportsSetStatsText("Error loading report.");
    }
  }

  function reportsApplyRuleAndRender() {
    if (!reportsCurrentCourse || !reportsCurrentRows.length) {
      reportsRenderRows();
      return;
    }

    const totalInput = document.getElementById("ruleTotalMarks");
    const minInput = document.getElementById("ruleMinAttendance");
    const belowInput = document.getElementById("ruleBelowMarks");

    reportsRuleTotalMarks = parseFloat(totalInput?.value || "0") || 0;
    reportsRuleMinAttendance = parseFloat(minInput?.value || "0") || 0;
    reportsRuleBelowMarks = parseFloat(belowInput?.value || "0") || 0;
    reportsMarksEnabled = true;
    reportsUpdateRuleSummary();

    reportsCurrentRows = reportsCurrentRows.map((r) => {
      let mark = 0;
      if (r.total > 0) {
        if (r.percent >= reportsRuleMinAttendance) {
          mark = reportsRuleTotalMarks;
        } else {
          mark = reportsRuleBelowMarks;
        }
      }
      return { ...r, mark };
    });

    reportsRenderRows();
  }

  function reportsRenderRows() {
    const rowList = document.getElementById("rowList");
    const emptyState = document.getElementById("emptyState");
    if (!rowList || !emptyState) return;

    rowList.innerHTML = "";

    if (!reportsCurrentRows.length || !reportsCurrentCourse) {
      emptyState.style.display = "block";
      reportsSetStatsText("No students found for this course yet.");
      return;
    }

    const search = document
      .getElementById("searchInput")
      .value.trim()
      .toLowerCase();

    const filtered = reportsCurrentRows.filter((r) => {
      if (!search) return true;
      return (
        (r.name || "").toLowerCase().includes(search) ||
        (r.matric || "").toLowerCase().includes(search)
      );
    });

    emptyState.style.display = filtered.length ? "none" : "block";

    let totalStudents = filtered.length;
    let totalAttended = 0;
    filtered.forEach((r) => (totalAttended += r.attended));

    reportsSetStatsText(
      `${reportsCourseLabel(reportsCurrentCourse)} • ${totalStudents} students • ${totalAttended} total attendances`
    );

    filtered.forEach((r) => {
      const row = document.createElement("div");
      row.className = "report-row";

      const nameCell = document.createElement("div");
      nameCell.className = "cell";
      nameCell.textContent = r.name || "Student";

      const matricCell = document.createElement("div");
      matricCell.className = "cell";
      matricCell.textContent = r.matric || "—";

      const deptCell = document.createElement("div");
      deptCell.className = "cell";
      deptCell.textContent = r.dept || "—";

      const pctCell = document.createElement("div");
      pctCell.className =
        "cell-muted " +
        (r.percent < reportsRuleMinAttendance ? "cell-danger" : "");
      const pct = Math.round(r.percent);
      pctCell.textContent = isNaN(pct) ? "0%" : `${pct}%`;

      const markCell = document.createElement("div");
      markCell.className = "cell-mark";
      markCell.textContent =
        !reportsMarksEnabled && r.mark == null ? "—" : (r.mark ?? "—");

      row.appendChild(nameCell);
      row.appendChild(matricCell);
      row.appendChild(deptCell);
      row.appendChild(pctCell);
      row.appendChild(markCell);

      rowList.appendChild(row);
    });
  }

  function reportsIsNative() {
    const Cap = window.Capacitor;
    if (!Cap) return false;
    if (typeof Cap.isNativePlatform === "function") return Cap.isNativePlatform();
    if (typeof Cap.isNativePlatform === "boolean") return Cap.isNativePlatform;
    return false;
  }

  async function reportsDownloadReportCsv() {
    try {
      if (!reportsCurrentCourse || !reportsCurrentRows.length) {
        alert("No report to export yet.");
        return;
      }

      const includeMarksEl = document.getElementById("includeMarksExport");
      const includeMarks = includeMarksEl ? includeMarksEl.checked : true;

      const header = [
        "Course code",
        "Course title",
        "Academic session",
        "Student name",
        "Matric",
        "Department",
        "Sessions attended",
        "Total sessions",
        "Attendance %",
        "Attendance mark",
        "Minimum attendance required %",
        "Total marks from attendance",
        "Marks if below minimum",
        "Marks enabled in export",
      ];

      const esc = (v) => `"${String(v).replace(/"/g, '""')}"`;

      const rows = reportsCurrentRows.map((r) => {
        const pct = Math.round(r.percent);
        const markVal = includeMarks ? r.mark : "";
        const values = [
          reportsCurrentCourse.course_code || "",
          reportsCurrentCourse.course_title || "",
          reportsCurrentCourse.academic_session || "",
          r.name || "",
          r.matric || "",
          r.dept || "",
          r.attended,
          r.total,
          pct,
          markVal,
          includeMarks ? reportsRuleMinAttendance : "",
          includeMarks ? reportsRuleTotalMarks : "",
          includeMarks ? reportsRuleBelowMarks : "",
          includeMarks ? "yes" : "no",
        ];
        return values.map(esc).join(",");
      });

      const csv = [header.join(","), ...rows].join("\n");
      const filename = `${reportsCurrentCourse.course_code || "course"}_attendance_report.csv`;

      if (reportsIsNative()) {
        const Cap = window.Capacitor;
        const Filesystem = Cap?.Plugins?.Filesystem;
        const Share = Cap?.Plugins?.Share;

        if (!Filesystem) {
          alert(
            "Filesystem plugin missing. Run: npm i @capacitor/filesystem && npx cap sync android"
          );
          return;
        }

        const Directory = Filesystem.Directory || Filesystem?.Directory;
        const Encoding = Filesystem.Encoding || Filesystem?.Encoding;

        const writeRes = await Filesystem.writeFile({
          path: filename,
          data: csv,
          directory: Directory ? Directory.Documents : "DOCUMENTS",
          encoding: Encoding ? Encoding.UTF8 : "utf8",
        });

        if (Share && writeRes?.uri) {
          await Share.share({
            title: "Colspot Report CSV",
            text: `Attendance report: ${reportsCurrentCourse.course_code || ""}`,
            url: writeRes.uri,
            dialogTitle: "Share / Save CSV",
          });
          return;
        }

        alert(
          "CSV saved. Open your Files app / Documents and look for: " +
            filename
        );
        return;
      }

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);

      const a = document.createElement("a");
      const supportsDownload = "download" in a;

      if (supportsDownload) {
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 2000);
      } else {
        window.location.href = url;
      }
    } catch (err) {
      console.error("reportsDownloadReportCsv error", err);
      reportsShowError("Could not start download. Please try again.");
    }
  }
</script>
