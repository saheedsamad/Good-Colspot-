  <script>
    window.classesScreenState = window.classesScreenState || {
      classes: [],
      selectedClass: null,
      activityType: "assignment",
      activityId: "",
      correctOption: "A",
      savedQuestions: [],
      lastQuestionPosition: 0,
      activitySelectedClassId: ""
    };

    function classesEscapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function showClassesMsg(id, text, type = "") {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.display = "block";
      el.className = "message " + type;
      el.textContent = text;
    }

    function clearClassesMsg(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.display = "none";
      el.textContent = "";
      el.className = "message";
    }

    function renderClassesList(filterText = "") {
      const wrap = document.getElementById("classesList");
      if (!wrap) return;

      const f = String(filterText || "").trim().toLowerCase();
      let rows = Array.isArray(window.classesScreenState.classes) ? window.classesScreenState.classes : [];

      if (f) {
        rows = rows.filter((c) =>
          [c.course_code, c.course_title, c.academic_session]
            .map(v => String(v || "").toLowerCase())
            .some(v => v.includes(f))
        );
      }

      if (!rows.length) {
        wrap.innerHTML = `<div class="section-sub" style="margin:0;">No class found.</div>`;
        return;
      }

      wrap.innerHTML = rows.map((c) => {
        const selected =
          window.classesScreenState.selectedClass &&
          String(window.classesScreenState.selectedClass.id) === String(c.id);

        return `
          <div class="recent-item ${selected ? "selected" : ""}" onclick="selectClassesScreenClass('${String(c.id)}')">
            <div class="recent-item-title">${classesEscapeHtml(c.course_code || "Untitled class")}</div>
            <div class="recent-item-sub">${classesEscapeHtml(c.academic_session || "")}${c.course_title ? " • " + classesEscapeHtml(c.course_title) : ""}</div>
          </div>
        `;
      }).join("");
    }

    function renderActivityClassList(filterText = "") {
      const wrap = document.getElementById("activityClassList");
      if (!wrap) return;

      const f = String(filterText || "").trim().toLowerCase();
      let rows = Array.isArray(window.classesScreenState.classes) ? window.classesScreenState.classes : [];

      if (f) {
        rows = rows.filter((c) =>
          [c.course_code, c.course_title, c.academic_session]
            .map(v => String(v || "").toLowerCase())
            .some(v => v.includes(f))
        );
      }

      if (!rows.length) {
        wrap.innerHTML = `<div class="section-sub" style="margin:0;">No class found.</div>`;
        return;
      }

      wrap.innerHTML = rows.map((c) => {
        const selected = String(window.classesScreenState.activitySelectedClassId || "") === String(c.id);

        return `
          <div class="recent-item ${selected ? "selected" : ""}" onclick="selectActivityClassInScreen('${String(c.id)}')">
            <div class="recent-item-title">${classesEscapeHtml(c.course_code || "Untitled class")}</div>
            <div class="recent-item-sub">${classesEscapeHtml(c.academic_session || "")}${c.course_title ? " • " + classesEscapeHtml(c.course_title) : ""}</div>
          </div>
        `;
      }).join("");
    }

    function selectClassesScreenClass(classId) {
      const found = window.classesScreenState.classes.find(c => String(c.id) === String(classId));
      window.classesScreenState.selectedClass = found || null;
      renderClassesList(document.getElementById("classesSearchInput")?.value || "");
    }

    function selectActivityClassInScreen(classId) {
      window.classesScreenState.activitySelectedClassId = classId;
      renderActivityClassList(document.getElementById("activityClassSearchInput")?.value || "");
    }

    function openCreateClassPageFromClasses() {
      window.location.href = "create_class.html";
    }

    function openActivityBuilderFromClasses() {
      document.getElementById("classesMainPanel")?.classList.add("hidden");
      document.getElementById("activityBuilderPanel")?.classList.remove("hidden");
      document.getElementById("classesHeroLine").textContent = "Assessment";
      document.getElementById("classesHeroTitle").innerHTML = 'Create <span>activity</span>';
      document.getElementById("classesHeroSub").textContent = "Create an assignment, revision, or test and then add multiple-choice questions one by one.";
      renderActivityClassList(document.getElementById("activityClassSearchInput")?.value || "");
    }

    function closeActivityBuilderFromClasses() {
      document.getElementById("activityBuilderPanel")?.classList.add("hidden");
      document.getElementById("classesMainPanel")?.classList.remove("hidden");
      document.getElementById("classesHeroLine").textContent = "Classes";
      document.getElementById("classesHeroTitle").innerHTML = 'Manage your <span>classes</span>';
      document.getElementById("classesHeroSub").textContent = "Create classes, manage them, and build assignments, revision, or tests.";
    }

    function applyActivityTypeUI() {
      document.querySelectorAll('#screen-classes .type-btn').forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.type === window.classesScreenState.activityType);
      });

      const label = window.classesScreenState.activityType.charAt(0).toUpperCase() + window.classesScreenState.activityType.slice(1);
      const badge = document.getElementById("activityTypeBadge");
      if (badge) badge.textContent = label;
    }

    function applyCorrectOptionUI() {
      document.querySelectorAll('#screen-classes .correct-btn').forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.correct === window.classesScreenState.correctOption);
      });
    }

    async function reloadClassesScreenData() {
      if (typeof supabase === "undefined") return;

      try {
        const { data: userData, error: userError } = await supabase.auth.getUser();
        if (userError || !userData?.user) return;

        const { data, error } = await supabase
          .from("courses")
          .select("id, course_code, course_title, academic_session, created_at")
          .eq("created_by", userData.user.id)
          .order("created_at", { ascending: false });

        if (error) throw error;

        window.classesScreenState.classes = Array.isArray(data) ? data : [];
        renderClassesList(document.getElementById("classesSearchInput")?.value || "");
        renderActivityClassList(document.getElementById("activityClassSearchInput")?.value || "");
      } catch (err) {
        console.error("reloadClassesScreenData failed:", err);
        window.classesScreenState.classes = [];
        renderClassesList();
        renderActivityClassList();
      }
    }

    function getActivityPayloadFromScreen() {
      const title = (document.getElementById("activityTitleInput")?.value || "").trim();
      const instruction = (document.getElementById("activityInstructionInput")?.value || "").trim();
      const dueInput = (document.getElementById("activityDueInput")?.value || "").trim();
      const timeLimitInput = (document.getElementById("activityTimeLimitInput")?.value || "").trim();
      const attemptsInput = (document.getElementById("activityAttemptsInput")?.value || "").trim();

      if (!window.classesScreenState.activityType) {
        showClassesMsg("activitySetupMsg", "Choose the activity type.", "error");
        return null;
      }

      if (!title) {
        showClassesMsg("activitySetupMsg", "Enter the activity title.", "error");
        return null;
      }

      if (!window.classesScreenState.activitySelectedClassId) {
        showClassesMsg("activitySetupMsg", "Select the class for this activity.", "error");
        return null;
      }

      const attemptsAllowed = Number(attemptsInput || 1);
      if (!Number.isFinite(attemptsAllowed) || attemptsAllowed < 1) {
        showClassesMsg("activitySetupMsg", "Attempts allowed must be 1 or more.", "error");
        return null;
      }

      let timeLimitMinutes = null;
      if (timeLimitInput) {
        timeLimitMinutes = Number(timeLimitInput);
        if (!Number.isFinite(timeLimitMinutes) || timeLimitMinutes <= 0) {
          showClassesMsg("activitySetupMsg", "Time limit must be greater than 0.", "error");
          return null;
        }
      }

      let dueAt = null;
      if (dueInput) {
        const dt = new Date(dueInput);
        if (Number.isNaN(dt.getTime())) {
          showClassesMsg("activitySetupMsg", "Due date is not valid.", "error");
          return null;
        }
        dueAt = dt.toISOString();
      }

      return {
        class_id: window.classesScreenState.activitySelectedClassId,
        created_by: currentUser?.id,
        activity_type: window.classesScreenState.activityType,
        title,
        instruction,
        due_at: dueAt,
        time_limit_minutes: timeLimitMinutes,
        attempts_allowed: attemptsAllowed,
        is_published: false,
        status: "draft"
      };
    }

    async function saveActivityFromClassesScreen() {
      clearClassesMsg("activitySetupMsg");
      if (typeof supabase === "undefined") return;

      try {
        if (!currentUser) {
          const { data: userData, error: userError } = await supabase.auth.getUser();
          if (userError || !userData?.user) {
            showClassesMsg("activitySetupMsg", "Please sign in again.", "error");
            return;
          }
          currentUser = userData.user;
        }

        const payload = getActivityPayloadFromScreen();
        if (!payload) return;

        const btn = document.getElementById("saveActivityBtn");
        const oldText = btn?.textContent || "Save activity & continue";
        if (btn) {
          btn.disabled = true;
          btn.textContent = window.classesScreenState.activityId ? "Saving..." : "Creating...";
        }

        if (window.classesScreenState.activityId) {
          const { error } = await supabase
            .from("class_activities")
            .update(payload)
            .eq("id", window.classesScreenState.activityId)
            .eq("created_by", currentUser.id);

          if (error) throw error;

          showClassesMsg("activitySetupMsg", "Activity updated. You can now continue adding questions.", "success");
        } else {
          const { data, error } = await supabase
            .from("class_activities")
            .insert([payload])
            .select("id")
            .single();

          if (error) throw error;

          window.classesScreenState.activityId = data.id;
          showClassesMsg("activitySetupMsg", "Activity saved successfully. Now add your questions.", "success");
        }

        document.getElementById("activityQuestionsSection")?.classList.remove("hidden");
        document.getElementById("activityStepCard2")?.classList.add("active");

        setTimeout(() => {
          document.getElementById("activityQuestionsSection")?.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        }, 180);

        await loadSavedQuestionsFromClassesScreen();

        if (btn) {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      } catch (err) {
        console.error("saveActivityFromClassesScreen failed:", err);
        showClassesMsg("activitySetupMsg", err.message || "Could not save activity.", "error");
        const btn = document.getElementById("saveActivityBtn");
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Save activity & continue";
        }
      }
    }

    function getQuestionPayloadFromClassesScreen() {
      const questionText = (document.getElementById("activityQuestionText")?.value || "").trim();
      const optionA = (document.getElementById("activityOptionA")?.value || "").trim();
      const optionB = (document.getElementById("activityOptionB")?.value || "").trim();
      const optionC = (document.getElementById("activityOptionC")?.value || "").trim();
      const optionD = (document.getElementById("activityOptionD")?.value || "").trim();
      const points = Number(document.getElementById("activityQuestionPoints")?.value || 1);

      if (!window.classesScreenState.activityId) {
        showClassesMsg("activityQuestionMsg", "Save the activity first before adding questions.", "error");
        return null;
      }

      if (!questionText) {
        showClassesMsg("activityQuestionMsg", "Enter the question text.", "error");
        return null;
      }

      if (!optionA || !optionB || !optionC || !optionD) {
        showClassesMsg("activityQuestionMsg", "Fill option A, B, C and D before saving.", "error");
        return null;
      }

      if (!["A", "B", "C", "D"].includes(window.classesScreenState.correctOption)) {
        showClassesMsg("activityQuestionMsg", "Choose the correct answer.", "error");
        return null;
      }

      if (!Number.isFinite(points) || points < 1) {
        showClassesMsg("activityQuestionMsg", "Points must be 1 or more.", "error");
        return null;
      }

      return {
        activity_id: window.classesScreenState.activityId,
        question_text: questionText,
        option_a: optionA,
        option_b: optionB,
        option_c: optionC,
        option_d: optionD,
        correct_option: window.classesScreenState.correctOption,
        points,
        position: Number(window.classesScreenState.lastQuestionPosition || 0) + 1
      };
    }

    function clearQuestionFormFromClassesScreen() {
      ["activityQuestionText","activityOptionA","activityOptionB","activityOptionC","activityOptionD"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.value = "";
      });

      const points = document.getElementById("activityQuestionPoints");
      if (points) points.value = "1";

      window.classesScreenState.correctOption = "A";
      applyCorrectOptionUI();

      const qNo = document.getElementById("activityQuestionNo");
      if (qNo) qNo.textContent = `Question ${Number(window.classesScreenState.lastQuestionPosition || 0) + 1}`;
    }

    async function saveQuestionFromClassesScreen(goNext = false) {
      clearClassesMsg("activityQuestionMsg");
      if (typeof supabase === "undefined") return;

      const payload = getQuestionPayloadFromClassesScreen();
      if (!payload) return;

      try {
        const btn = document.getElementById(goNext ? "saveQuestionNextBtn" : "saveQuestionBtn");
        const oldText = btn?.textContent || "Save";
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Saving...";
        }

        const { error } = await supabase
          .from("class_activity_questions")
          .insert([payload]);

        if (error) throw error;

        window.classesScreenState.lastQuestionPosition = payload.position;
        showClassesMsg("activityQuestionMsg", `Question ${payload.position} saved successfully.`, "success");
        await loadSavedQuestionsFromClassesScreen();

        if (goNext) {
          clearQuestionFormFromClassesScreen();
          document.getElementById("activityQuestionText")?.focus();
        }

        if (btn) {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      } catch (err) {
        console.error("saveQuestionFromClassesScreen failed:", err);
        showClassesMsg("activityQuestionMsg", err.message || "Could not save question.", "error");
        const btn = document.getElementById(goNext ? "saveQuestionNextBtn" : "saveQuestionBtn");
        if (btn) {
          btn.disabled = false;
          btn.textContent = goNext ? "Save & add next" : "Save question";
        }
      }
    }

    async function loadSavedQuestionsFromClassesScreen() {
      if (typeof supabase === "undefined") return;
      if (!window.classesScreenState.activityId) return;

      try {
        const { data, error } = await supabase
          .from("class_activity_questions")
          .select("*")
          .eq("activity_id", window.classesScreenState.activityId)
          .order("position", { ascending: true });

        if (error) throw error;

        window.classesScreenState.savedQuestions = Array.isArray(data) ? data : [];
        window.classesScreenState.lastQuestionPosition = window.classesScreenState.savedQuestions.length
          ? Math.max(...window.classesScreenState.savedQuestions.map((q) => Number(q.position || 0)))
          : 0;

        const qNo = document.getElementById("activityQuestionNo");
        if (qNo) qNo.textContent = `Question ${Number(window.classesScreenState.lastQuestionPosition || 0) + 1}`;

        renderSavedQuestionsFromClassesScreen();
      } catch (err) {
        console.error("loadSavedQuestionsFromClassesScreen failed:", err);
        renderSavedQuestionsFromClassesScreen();
      }
    }

    function renderSavedQuestionsFromClassesScreen() {
      const wrap = document.getElementById("savedQuestionsList");
      if (!wrap) return;

      const list = Array.isArray(window.classesScreenState.savedQuestions) ? window.classesScreenState.savedQuestions : [];

      if (!list.length) {
        wrap.innerHTML = `<div class="hint" style="margin-top:4px;">No question saved yet. Add your first question above.</div>`;
        return;
      }

      wrap.innerHTML = list
        .sort((a, b) => Number(a.position || 0) - Number(b.position || 0))
        .map((q) => {
          const correct = String(q.correct_option || "A").toUpperCase();
          const correctMap = {
            A: q.option_a,
            B: q.option_b,
            C: q.option_c,
            D: q.option_d
          };

          return `
            <div class="saved-item">
              <div class="saved-top">
                <div>
                  <div class="saved-q-no">Question ${classesEscapeHtml(q.position)}</div>
                  <div class="saved-q-text">${classesEscapeHtml(q.question_text)}</div>
                </div>
                <div class="saved-points">${classesEscapeHtml(q.points)} pt</div>
              </div>

              <div class="saved-options">
