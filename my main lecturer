      color: #dc2626;
    }

    #screen-reports .empty-state {
      font-size: 13px;
      color: var(--text-muted);
      margin: 10px 2px;
    }

    #screen-reports .error-text {
      font-size: 12px;
      color: #dc2626;
      margin: 6px 2px 2px;
    }
  </style>

  <section class="hero">
