  async function loadFullHistory(options = {}) {
    const silent = options.silent === true;
    const listEl = document.getElementById("fullHistoryList");
    const emptyEl = document.getElementById("fullHistoryEmpty");
    if (!listEl || !emptyEl) return;

    if (loadFullHistory._loading) return;
    loadFullHistory._loading = true;

    const previousScrollY = window.scrollY;

    try {
      if (!silent) {
        showFullHistoryError("");
        setFullHistoryStats("Loading history...");
        listEl.innerHTML = "";
        emptyEl.style.display = "none";
      } else {
        showFullHistoryError("");
      }

      if (typeof supabase === "undefined") {
        if (!silent) {
          showFullHistoryError("Backend not available. Please reload later.");
          setFullHistoryStats("Error loading history.");
        }
        return;
      }

      let user = null;
      try {
        const { data, error } = await supabase.auth.getUser();

        if (error || !data || !data.user) {
          const offline = isLikelyOfflineErrorHistory(error);
          if (!silent) {
            if (offline) {
              showFullHistoryError(
                "No internet connection or bad network. We’ll refresh automatically when you reconnect."
              );
            } else {
              showFullHistoryError(
                "Could not verify your account right now. Please try again or sign in again from the main screen."
              );
            }
            setFullHistoryStats("0 items");
          }
          return;
        }
        user = data.user;
      } catch (e) {
        console.error(e);
        const offline = isLikelyOfflineErrorHistory(e);
        if (!silent) {
          if (offline) {
            showFullHistoryError(
              "No internet connection or bad network. We’ll refresh automatically when you reconnect."
            );
          } else {
            showFullHistoryError(
              "Could not check your account right now. Please try again or sign in again from the main screen."
            );
          }
          setFullHistoryStats("0 items");
        }
        return;
      }

      try {
        const { data: classes, error: classError } = await supabase
          .from("courses")
          .select(`
            id,
            course_code,
            course_title,
            creator_name,
            invite_code,
            academic_session,
            created_at,
            allowed_departments,
            allowed_levels,
            allowed_department_levels
          `)
          .eq("created_by", user.id)
          .order("created_at", { ascending: false });

        if (classError) {
          console.error(classError);
          if (!silent) {
            showFullHistoryError("Could not load class history. Please try again.");
          }
          fullHistoryClasses = [];
        } else if (!classes || classes.length === 0) {
          fullHistoryClasses = [];
        } else {
          const classIds = classes.map((c) => c.id);

          const { data: memberships, error: memError } = await supabase
            .from("course_memberships")
            .select("course_id")
            .in("course_id", classIds);

          if (memError && !silent) {
            console.error(memError);
            showFullHistoryError(
              "Could not load joined students count. Please try again."
            );
          }

          const countMap = {};
          (memberships || []).forEach((row) => {
            countMap[row.course_id] = (countMap[row.course_id] || 0) + 1;
          });

          fullHistoryClasses = classes.map((course) => ({
            course,
            memberCount: countMap[course.id] || 0
          }));
        }
      } catch (e) {
        console.error(e);
        if (!silent) {
          showFullHistoryError("Unexpected error while loading class history.");
        }
        fullHistoryClasses = [];
      }

      attendanceSessionHistoryItems = await loadAttendanceSessionsForHistory(user);
      formHistoryItems = await loadFormHistoryForHistory(user);
      activityHistoryItems = await loadActivityHistoryForHistory(user);

      try {
        const { data: scans, error: scansError } = await supabase
          .from("scan_sheets")
          .select("id, title, created_at, status, s3_object_key, result_json")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false })
          .limit(50);

        if (scansError) {
          console.error(scansError);
          scanHistoryItems = [];
        } else {
          scanHistoryItems = scans || [];
        }
      } catch (e) {
        console.error(e);
        scanHistoryItems = [];
      }

      schoolAnnouncementItems = await loadSchoolAnnouncementsForHistory(user);
      reportHistoryItems = await loadReportHistoryForHistory(user);

      rebuildCombinedHistory();
      updateFullHistoryStatsSummary();

      const emptyElVisible = !combinedHistoryFiltered.length;
      if (emptyElVisible) {
        emptyEl.style.display = "block";
        listEl.innerHTML = "";
      } else {
        emptyEl.style.display = "none";
        renderFullHistoryList();
        if (silent) {
          window.scrollTo(0, previousScrollY);
        }
      }
    } finally {
      loadFullHistory._loading = false;
    }
  }

  function updateFullHistoryStatsSummary() {
    const totalItems = combinedHistoryItems.length;
    const totalClasses = fullHistoryClasses.length;
    const totalSessions = attendanceSessionHistoryItems.length;
    const totalForms = formHistoryItems.length;
    const totalRevisions = activityHistoryItems.length;
    const totalAnnouncements = schoolAnnouncementItems.length;
    const totalReports = reportHistoryItems.length;

    setFullHistoryStats(
      `${totalItems} items • ${totalClasses} classes • ${totalSessions} attendance • ${totalForms} forms • ${totalRevisions} revisions • ${totalAnnouncements} announcements • ${totalReports} reports`
    );
  }

  function applyFullHistorySearchFilter() {
    const searchInput = document.getElementById("fullHistorySearch");
    if (!searchInput) return;

    const query = searchInput.value.trim().toLowerCase();
    if (!query) {
      combinedHistoryFiltered = combinedHistoryItems.slice();
      renderFullHistoryList();
      return;
    }

    combinedHistoryFiltered = combinedHistoryItems.filter((item) => {
      if (item.type === "student") {
        const e = item.entry;
        const course = (e.course_code || "").toLowerCase();
        const lecturer = (e.lecturer_name || "").toLowerCase();
        return course.includes(query) || lecturer.includes(query);
      } else if (item.type === "class") {
        const c = item.course;
        const code = (c.course_code || "").toLowerCase();
        const title = (c.course_title || "").toLowerCase();
        const invite = (c.invite_code || "").toLowerCase();
        const creator = (c.creator_name || "").toLowerCase();
        return (
          code.includes(query) ||
          title.includes(query) ||
          invite.includes(query) ||
          creator.includes(query)
        );
      } else if (item.type === "attendance_session") {
        const s = item.session;
        const code = (s.course_code || "").toLowerCase();
        const title = (s.course_title || "").toLowerCase();
        const lecturer = (s.lecturer_name || "").toLowerCase();
        const pin = (s.pin_code || "").toLowerCase();
        return (
          code.includes(query) ||
          title.includes(query) ||
          lecturer.includes(query) ||
          pin.includes(query)
        );
      } else if (item.type === "form") {
        const f = item.form;
        const title = (f.title || "").toLowerCase();
        const sub = (f.sub_title || "").toLowerCase();
        const status = (f.status || "").toLowerCase();
        return title.includes(query) || sub.includes(query) || status.includes(query);
      } else if (item.type === "activity") {
        const a = item.activity;
        const code = (a.course_code || "").toLowerCase();
        const title = (a.title || "").toLowerCase();
        const type = (a.activity_type || "").toLowerCase();
        const sub = (a.course_title || "").toLowerCase();
        const status = (a.history_status || "").toLowerCase();
        return (
          code.includes(query) ||
          title.includes(query) ||
          type.includes(query) ||
          sub.includes(query) ||
          status.includes(query)
        );
      } else if (item.type === "announcement") {
        const ann = item.announcement;
        const title = (ann.title || "").toLowerCase();
        const message = (ann.message || "").toLowerCase();
        const body = (ann.body || "").toLowerCase();
        return title.includes(query) || message.includes(query) || body.includes(query);
      } else if (item.type === "report") {
        const report = item.report;
        const title = (report.title || "").toLowerCase();
        const category = (report.category || "").toLowerCase();
        const message = (report.message || "").toLowerCase();
        const code = (report.tracking_code || "").toLowerCase();
        const status = (report.status || "").toLowerCase();
        return (
          title.includes(query) ||
          category.includes(query) ||
          message.includes(query) ||
          code.includes(query) ||
          status.includes(query)
        );
      } else {
        const scan = item.scan;
        const title = (scan.title || "").toLowerCase();
        return title.includes(query);
      }
    });

    renderFullHistoryList();
  }

