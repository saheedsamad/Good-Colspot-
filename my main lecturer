  <div class="stats-row">
    <div id="statsText">Select a course to see stats.</div>
    <div class="export-row">
      <label class="checkbox-row">
        <input type="checkbox" id="includeMarksExport" checked />
        <span>Include CA marks in export</span>
      </label>
      <button class="download-btn" onclick="reportsDownloadReportCsv()">
        <svg viewBox="0 0 24 24">
          <path d="M12 3v14"></path>
          <path d="M8 13l4 4 4-4"></path>
          <path d="M5 20h14"></path>
        </svg>
        <span>Download CSV</span>
