      (accountCurrentUser && accountCurrentUser.user_metadata?.full_name) ||
      "Lecturer";
    const safeSchool =
      school ||
      (accountCurrentUser && accountCurrentUser.user_metadata?.school_name) ||
      "School";
    const safeStaffId =
      staffId ||
      (accountCurrentUser && accountCurrentUser.user_metadata?.staff_id) ||
