    async function publishActivityFromClassesScreen() {
      clearClassesMsg("activityQuestionMsg");
      if (typeof supabase === "undefined") return;

      if (!window.classesScreenState.activityId) {
        showClassesMsg("activityQuestionMsg", "Save the activity first before publishing.", "error");
        return;
      }

      if (!window.classesScreenState.savedQuestions.length) {
        showClassesMsg("activityQuestionMsg", "Add at least one question before publishing.", "error");
        return;
      }

      try {
        const btn = document.getElementById("publishActivityBtn");
        const oldText = btn?.textContent || "Publish activity";
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Publishing...";
        }

        const { error } = await supabase
          .from("class_activities")
          .update({
            is_published: true,
            status: "published"
          })
          .eq("id", window.classesScreenState.activityId)
          .eq("created_by", currentUser.id);

        if (error) throw error;

        showClassesMsg("activityQuestionMsg", "Activity published successfully.", "success");

        if (btn) {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      } catch (err) {
        console.error("publishActivityFromClassesScreen failed:", err);
        showClassesMsg("activityQuestionMsg", err.message || "Could not publish activity.", "error");
        const btn = document.getElementById("publishActivityBtn");
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Publish activity";
        }
      }
    }

    function bindClassesScreenEvents() {
      document.getElementById("classesSearchInput")?.addEventListener("input", (e) => {
        renderClassesList(e.target.value || "");
      });

      document.getElementById("activityClassSearchInput")?.addEventListener("input", (e) => {
        renderActivityClassList(e.target.value || "");
      });

      document.querySelectorAll('#screen-classes .type-btn').forEach((btn) => {
        btn.addEventListener("click", () => {
          window.classesScreenState.activityType = btn.dataset.type || "assignment";
          applyActivityTypeUI();
        });
      });

      document.querySelectorAll('#screen-classes .correct-btn').forEach((btn) => {
        btn.addEventListener("click", () => {
          window.classesScreenState.correctOption = btn.dataset.correct || "A";
          applyCorrectOptionUI();
        });
      });

      document.getElementById("saveActivityBtn")?.addEventListener("click", saveActivityFromClassesScreen);
      document.getElementById("saveQuestionBtn")?.addEventListener("click", () => saveQuestionFromClassesScreen(false));
      document.getElementById("saveQuestionNextBtn")?.addEventListener("click", () => saveQuestionFromClassesScreen(true));
      document.getElementById("publishActivityBtn")?.addEventListener("click", publishActivityFromClassesScreen);
    }

    document.addEventListener("DOMContentLoaded", () => {
      bindClassesScreenEvents();
      applyActivityTypeUI();
      applyCorrectOptionUI();
      reloadClassesScreenData();
    });
  </script>
