  function arrayBufferToBase64(buffer) {
    let binary = "";
    const bytes = new Uint8Array(buffer);
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      const sub = bytes.subarray(i, i + chunk);
      binary += String.fromCharCode.apply(null, sub);
    }
    return btoa(binary);
  }

  async function submitScanSheet() {
    const fileInput = document.getElementById("scanFileInput");
    const statusEl = document.getElementById("scanStatus");
    const btn = document.getElementById("scanSubmitBtn");
    const titleInput = document.getElementById("scanTitle");
    const outputTypeEl = document.querySelector(
      'input[name="scanOutputType"]:checked'
    );

    if (!fileInput || !fileInput.files || !fileInput.files[0]) {
      if (statusEl) {
        statusEl.textContent = "Please choose a file first.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    if (!currentScanQuota) {
      await initScanQuotaUI();
    }

    if (currentScanQuota && currentScanQuota.remaining <= 0) {
      if (statusEl) {
        statusEl.textContent = "You have reached your monthly scan limit.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (statusEl) {
        statusEl.textContent = "Please sign in again.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    try {
      if (btn) btn.disabled = true;
      if (statusEl) {
        statusEl.textContent = "Uploading and processing your scan...";
        statusEl.className = "scan-status";
      }

      const file = fileInput.files[0];
      const outputType = outputTypeEl ? outputTypeEl.value : "excel";
      const title = norm(titleInput?.value) || file.name || "Scan";

      const buffer = await file.arrayBuffer();
      const base64 = arrayBufferToBase64(buffer);

      const response = await fetch(SCAN_LAMBDA_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          user_id: user.id,
          title,
          output_type: outputType,
          filename: file.name,
          mime_type: file.type || "application/octet-stream",
          file_base64: base64
        })
      });

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error((result && result.error) || "Scan failed.");
      }

      try {
        if (typeof supabase !== "undefined") {
          const insertPayload = {
            user_id: user.id,
            title,
            output_type: outputType,
            source_name: file.name
          };

          const tryInsert = await supabase
            .from("scan_sheets")
            .insert({
              ...insertPayload,
              month_key: getCurrentMonthKey()
            });

          if (tryInsert.error && String(tryInsert.error.message || "").toLowerCase().includes("month_key")) {
            await supabase.from("scan_sheets").insert(insertPayload);
          }
        }
      } catch (logErr) {
        console.warn("scan_sheets insert failed:", logErr);
      }

      await initScanQuotaUI();

      if (statusEl) {
        statusEl.textContent =
          result?.message || "Scan completed successfully.";
        statusEl.className = "scan-status ok";
      }

      if (result?.download_url) {
        window.open(result.download_url, "_blank");
      }
    } catch (e) {
      console.error("submitScanSheet failed:", e);
      if (statusEl) {
        statusEl.textContent = e.message || "Could not process scan.";
        statusEl.className = "scan-status error";
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

