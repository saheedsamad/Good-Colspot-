    if (announcementState.uploadedImageUrl) {
      if (els.imageUploadStatus) els.imageUploadStatus.textContent = "Image uploaded";
      els.imageUploadPreview?.classList.remove("hidden");
      if (els.imageUploadPreviewImg) els.imageUploadPreviewImg.src = announcementState.uploadedImageUrl;
    } else {
      if (els.imageUploadStatus) {
        els.imageUploadStatus.textContent = announcementState.uploadingImage
          ? "Uploading image..."
          : "No image selected";
      }
      els.imageUploadPreview?.classList.add("hidden");
      els.imageUploadPreviewImg?.removeAttribute("src");
      if (els.imageFileInput) els.imageFileInput.value = "";
    }
  }

  function renderFileUploadState() {
    const els = announcementEls();

    if (announcementState.uploadedFileUrl) {
      if (els.fileUploadStatus) els.fileUploadStatus.textContent = "File uploaded";
      els.fileChip?.classList.remove("hidden");
      if (els.fileChipName) els.fileChipName.textContent = announcementState.uploadedFileName || "Attached file";
    } else {
      if (els.fileUploadStatus) {
