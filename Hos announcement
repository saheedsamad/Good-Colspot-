<script>
(function () {
  if (window.__hosAnnouncementSystemInitializedV3) return;
  window.__hosAnnouncementSystemInitializedV3 = true;

  const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
  const SUPABASE_ANON_KEY = "YOUR_ANON_KEY_HERE";
  const ANNOUNCEMENT_FUNCTION = "announcement-manager";
  const ANNOUNCEMENT_BUCKET = "announcement-media";

  const announcementState = {
    sb: null,
    session: null,
    items: [],
    filteredItems: [],
    selectedId: null,
    activeStatus: "all",
    search: "",
    composeMode: "create",
    editingId: null,
    audienceMode: "all_students",
    programmeTargets: [],
    deliveryMode: "published",
    matchedStudents: [],
    loadingMatched: false,
    programmes: [],
    uploadedImageUrl: "",
    uploadedFileUrl: "",
    uploadedFileName: "",
    uploadingImage: false,
    uploadingFile: false,

    composeStep: 1,
    studentNoticeTitle: "",
    studentNoticeBody: ""
  };

  function $(id) {
    return document.getElementById(id);
  }

  function escapeHtml(value) {
    return String(value || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function normalizeText(value) {
    return String(value || "").trim().replace(/\s+/g, " ");
  }

  function createClientSafe() {
    try {
      if (window.sb && typeof window.sb.functions?.invoke === "function") {
        return window.sb;
      }

      if (window.supabase && typeof window.supabase.createClient === "function") {
        return window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      }
    } catch (err) {
      console.error("Announcement supabase init failed:", err);
    }
    return null;
  }

  function getAdminSession() {
    try {
      return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
    } catch {
      return null;
    }
  }

  function getActorPayload() {
    const session = announcementState.session || {};
    const account = session.account || {};
    const role = session.role || account.role || "";

    if (role === "hos") {
      return { hos_admin_id: account.id || session.id || "" };
    }
    if (role === "form_agent") {
      return { form_agent_id: account.id || session.id || "" };
    }
    return { hos_admin_id: account.id || session.id || "" };
  }

  async function invokeAnnouncementManager(payload) {
    if (!announcementState.sb) {
      throw new Error("Supabase client not ready.");
    }

    const { data, error } = await announcementState.sb.functions.invoke(ANNOUNCEMENT_FUNCTION, {
      body: payload
    });

    console.log("ANNOUNCEMENT BODY SENT:", payload);
    console.log("ANNOUNCEMENT RAW DATA:", data);
    console.log("ANNOUNCEMENT RAW ERROR:", error);

    if (error) {
      throw new Error(error.message || "Announcement manager request failed.");
    }

    if (data && data.ok === false) {
      throw new Error(data.error || "Announcement manager request failed.");
    }

    return data || {};
  }

