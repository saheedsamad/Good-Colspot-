  function renderAnnouncementList() {
    const els = announcementEls();
    if (!els.list) return;

    els.list.innerHTML = "";

    const items = announcementState.filteredItems;
    if (!items.length) {
      if (els.empty) els.empty.classList.remove("hidden");
      if (els.empty) els.list.appendChild(els.empty);
      renderAnnouncementPreview();
      return;
    }

    if (els.empty) els.empty.classList.add("hidden");

    items.forEach((item) => {
      const card = document.createElement("div");
      card.className = `announcement-item${announcementState.selectedId === item.id ? " active" : ""}`;
      card.dataset.id = item.id;

      const thumb = item.image_url
        ? `<img src="${escapeHtml(item.image_url)}" alt="">`
        : `<span>No Image</span>`;

      card.innerHTML = `
        <div class="announcement-item-thumb">${thumb}</div>
        <div class="announcement-item-main">
          <div class="announcement-item-top">
            <div class="announcement-item-title">${escapeHtml(item.title || "Untitled announcement")}</div>
            <div class="announcement-item-status ${announcementStatusClass(item.status)}">
              ${escapeHtml(formatAnnouncementStatus(item.status))}
            </div>
          </div>

          <div class="announcement-item-audience">${escapeHtml(buildAnnouncementAudienceText(item))}</div>

          <div class="announcement-item-body">${escapeHtml(truncateAnnouncementText(item.body || "", 180))}</div>

          <div class="announcement-item-meta">
            <span>${escapeHtml(item.created_by_admin_name || "Admin")}</span>
            <span>${escapeHtml(formatAnnouncementTime(item.published_at || item.updated_at || item.created_at))}</span>
            <span>${item.link_url ? "Has link" : "No link"}</span>
            <span>${item.file_url ? "Has file" : "No file"}</span>
          </div>

          <div class="announcement-item-actions">
            <button class="mini-btn" type="button" data-action="open">Open</button>
            <button class="mini-btn" type="button" data-action="edit">Edit</button>
          </div>
        </div>
      `;

      card.addEventListener("click", (e) => {
        const action = e.target?.dataset?.action;
        announcementState.selectedId = item.id;
        renderAnnouncementList();
        renderAnnouncementPreview();

        if (action === "edit") {
          openAnnouncementComposer("edit", item);
        }
      });

      els.list.appendChild(card);
    });
  }

  function renderAnnouncementPreview() {
    const els = announcementEls();
    const item = announcementState.items.find((x) => x.id === announcementState.selectedId);

    if (!item) {
      els.previewEmpty?.classList.remove("hidden");
      els.previewCard?.classList.add("hidden");
      return;
    }

    els.previewEmpty?.classList.add("hidden");
    els.previewCard?.classList.remove("hidden");

    if (els.previewTitle) els.previewTitle.textContent = item.title || "Untitled announcement";

    if (els.previewStatus) {
      els.previewStatus.textContent = formatAnnouncementStatus(item.status);
      els.previewStatus.className = `announcement-preview-status ${announcementStatusClass(item.status)}`;
    }

    if (els.previewAudience) els.previewAudience.textContent = buildAnnouncementAudienceText(item);
    if (els.previewBody) els.previewBody.textContent = item.body || "";

    if (els.previewMatchedCount) {
      const count = Number(item.matched_students_count || 0);
      els.previewMatchedCount.textContent = `${count} student${count === 1 ? "" : "s"}`;
    }

    if (els.previewAuthor) els.previewAuthor.textContent = item.created_by_admin_name || "Admin";
    if (els.previewTime) els.previewTime.textContent = formatAnnouncementTime(item.published_at || item.updated_at || item.created_at);

    if (item.image_url) {
      els.previewImageWrap?.classList.remove("hidden");
      if (els.previewImage) els.previewImage.src = item.image_url;
    } else {
      els.previewImageWrap?.classList.add("hidden");
      els.previewImage?.removeAttribute("src");
    }

    if (item.link_url) {
      els.previewLinkWrap?.classList.remove("hidden");
      if (els.previewLinkLabel) els.previewLinkLabel.textContent = item.link_label || "Open link";
      if (els.previewLinkUrl) els.previewLinkUrl.textContent = item.link_url;
    } else {
      els.previewLinkWrap?.classList.add("hidden");
    }

    if (item.file_url) {
      els.previewFileWrap?.classList.remove("hidden");
      if (els.previewFileUrl) els.previewFileUrl.textContent = item.file_url;
    } else {
      els.previewFileWrap?.classList.add("hidden");
    }
  }

  function applyAnnouncementFilters() {
    const status = announcementState.activeStatus;
    const search = announcementState.search.trim().toLowerCase();

    let items = [...announcementState.items];

    if (status !== "all") {
      items = items.filter((item) => String(item.status || "").toLowerCase() === status);
    }

    if (search) {
      items = items.filter((item) => {
        const haystack = [
          item.title,
          item.body,
          item.created_by_admin_name,
          buildAnnouncementAudienceText(item)
        ].join(" ").toLowerCase();

        return haystack.includes(search);
      });
    }

    announcementState.filteredItems = items;

    if (!announcementState.selectedId || !items.some((item) => item.id === announcementState.selectedId)) {
      announcementState.selectedId = items[0]?.id || null;
    }

    renderAnnouncementList();
  }

  async function loadAnnouncements(statusOverride = null) {
    try {
      const payload = {
        action: "list_announcements",
        ...(statusOverride && statusOverride !== "all" ? { status: statusOverride } : {}),
        ...getActorPayload()
      };

      const res = await invokeAnnouncementManager(payload);
      announcementState.items = Array.isArray(res.announcements) ? res.announcements : [];
      applyAnnouncementFilters();
    } catch (err) {
      console.error("loadAnnouncements failed:", err);
    }
  }

  function resetAnnouncementUploads() {
    announcementState.uploadedImageUrl = "";
    announcementState.uploadedFileUrl = "";
    announcementState.uploadedFileName = "";
    announcementState.uploadingImage = false;
    announcementState.uploadingFile = false;
    renderImageUploadState();
    renderFileUploadState();
  }

  function resetAnnouncementComposeState() {
    announcementState.composeStep = 1;
    announcementState.studentNoticeTitle = "";
    announcementState.studentNoticeBody = "";
    announcementState.audienceMode = "all_students";
    announcementState.programmeTargets = [];
    announcementState.deliveryMode = "published";
    announcementState.matchedStudents = [];
  }

  function syncStudentNoticeDefaults() {
    const els = announcementEls();
    const mainTitle = els.titleInput?.value?.trim() || "";
    const mainBody = els.bodyInput?.value?.trim() || "";

    if (!announcementState.studentNoticeTitle.trim()) {
      announcementState.studentNoticeTitle = mainTitle;
    }
    if (!announcementState.studentNoticeBody.trim()) {
      announcementState.studentNoticeBody = mainBody;
    }

    if (els.studentTitleInput && document.activeElement !== els.studentTitleInput) {
      els.studentTitleInput.value = announcementState.studentNoticeTitle;
    }
    if (els.studentBodyInput && document.activeElement !== els.studentBodyInput) {
      els.studentBodyInput.value = announcementState.studentNoticeBody;
    }
  }

  function renderAnnouncementStepUI() {
    const els = announcementEls();
    const step = announcementState.composeStep;

    els.stepOneWrap?.classList.toggle("hidden", step !== 1);
    els.stepTwoWrap?.classList.toggle("hidden", step !== 2);

    els.stepBadgeOne?.classList.toggle("active", step === 1);
    els.stepBadgeTwo?.classList.toggle("active", step === 2);

    els.backBtn?.classList.toggle("hidden", step === 1);
    els.nextBtn?.classList.toggle("hidden", step !== 1);
    els.publishBtn?.classList.toggle("hidden", step !== 2);

    if (els.saveDraftBtn) {
      els.saveDraftBtn.textContent = "Save Draft";
    }

    if (els.nextBtn) {
      els.nextBtn.textContent = "Next";
    }

    if (els.publishBtn) {
      els.publishBtn.textContent =
        announcementState.deliveryMode === "scheduled" ? "Schedule Announcement" : "Send Announcement";
    }
  }

  function refreshAnnouncementAudienceModeUI() {
    const els = announcementEls();
    const isFilter = announcementState.audienceMode === "programme_filter";
    els.programmeFilterBox?.classList.toggle("hidden", !isFilter);
  }

  function renderAnnouncementTargetList() {
    const els = announcementEls();
    if (!els.targetList) return;

    els.targetList.innerHTML = "";

    if (!announcementState.programmeTargets.length) return;

    announcementState.programmeTargets.forEach((target, index) => {
      const chip = document.createElement("div");
      chip.className = "announcement-target-chip";

      const programme = String(target.programme_name || "").trim();
      const levels = Array.isArray(target.levels) ? target.levels.join(", ") : "";

      chip.innerHTML = `
        <span>${escapeHtml(programme)}${levels ? ` (${escapeHtml(levels)})` : ""}</span>
        <button type="button" data-index="${index}">&times;</button>
      `;

      chip.querySelector("button")?.addEventListener("click", () => {
        announcementState.programmeTargets.splice(index, 1);
        renderAnnouncementTargetList();
        refreshAnnouncementPreviewCard();
        refreshAnnouncementMatchedPreview();
      });

      els.targetList.appendChild(chip);
    });
  }

  function refreshStudentPhonePreview() {
    const els = announcementEls();

    syncStudentNoticeDefaults();

    const title = announcementState.studentNoticeTitle.trim() || "Announcement title";
    const body = announcementState.studentNoticeBody.trim() || "This is how the announcement will look on the student's phone.";
    const audienceText = announcementState.audienceMode === "programme_filter"
      ? buildAnnouncementAudienceText({ audience_mode: "programme_filter", programme_targets: announcementState.programmeTargets })
      : "All students";

    const count = Array.isArray(announcementState.matchedStudents)
      ? announcementState.matchedStudents.length
      : 0;

    if (els.studentPhoneTitle) els.studentPhoneTitle.textContent = title;
    if (els.studentPhoneBody) els.studentPhoneBody.textContent = body;
    if (els.studentPhoneAudience) els.studentPhoneAudience.textContent = audienceText;
    if (els.studentAudienceLine) els.studentAudienceLine.textContent = audienceText;
    if (els.studentMatchedCount) els.studentMatchedCount.textContent = `${count} student${count === 1 ? "" : "s"}`;

    const linkLabel = els.linkLabelInput?.value?.trim() || "Open link";
    const linkUrl = els.linkUrlInput?.value?.trim();
    const imageUrl = announcementState.uploadedImageUrl;
    const fileUrl = announcementState.uploadedFileUrl;

    if (imageUrl) {
      els.studentPhoneImageWrap?.classList.remove("hidden");
      if (els.studentPhoneImage) els.studentPhoneImage.src = imageUrl;
    } else {
      els.studentPhoneImageWrap?.classList.add("hidden");
      els.studentPhoneImage?.removeAttribute("src");
    }

    if (linkUrl) {
      els.studentPhoneLinkWrap?.classList.remove("hidden");
      if (els.studentPhoneLinkLabel) els.studentPhoneLinkLabel.textContent = linkLabel;
      if (els.studentPhoneLinkUrl) els.studentPhoneLinkUrl.textContent = linkUrl;
    } else {
      els.studentPhoneLinkWrap?.classList.add("hidden");
    }

    if (fileUrl) {
      els.studentPhoneFileWrap?.classList.remove("hidden");
      if (els.studentPhoneFileUrl) {
        els.studentPhoneFileUrl.textContent = announcementState.uploadedFileName || fileUrl;
      }
    } else {
      els.studentPhoneFileWrap?.classList.add("hidden");
    }
  }

  function refreshAnnouncementPreviewCard() {
    const els = announcementEls();

    const title = els.titleInput?.value?.trim() || "Announcement title";
    const body = els.bodyInput?.value?.trim() || "Your announcement message preview will show here.";
    const linkLabel = els.linkLabelInput?.value?.trim() || "Open link";
    const linkUrl = els.linkUrlInput?.value?.trim();
    const imageUrl = announcementState.uploadedImageUrl;
    const fileUrl = announcementState.uploadedFileUrl;

    if (els.composePreviewTitle) els.composePreviewTitle.textContent = title;
    if (els.composePreviewBody) els.composePreviewBody.textContent = body;

    const audienceText = announcementState.audienceMode === "programme_filter"
      ? buildAnnouncementAudienceText({ audience_mode: "programme_filter", programme_targets: announcementState.programmeTargets })
      : "All students";

    if (els.audienceText) els.audienceText.textContent = audienceText;
    if (els.audienceTextMini) els.audienceTextMini.textContent = audienceText;

    const count = Array.isArray(announcementState.matchedStudents)
      ? announcementState.matchedStudents.length
      : 0;

    if (els.matchedCount) els.matchedCount.textContent = String(count);
    if (els.composePreviewMatched) els.composePreviewMatched.textContent = `${count} student${count === 1 ? "" : "s"}`;

    const statusText =
      announcementState.deliveryMode === "scheduled"
        ? "Scheduled"
        : announcementState.deliveryMode === "draft"
        ? "Draft"
        : "Send now";

    if (els.composePreviewStatus) els.composePreviewStatus.textContent = statusText;

    if (imageUrl) {
      els.composePreviewImageWrap?.classList.remove("hidden");
      if (els.composePreviewImage) els.composePreviewImage.src = imageUrl;
    } else {
      els.composePreviewImageWrap?.classList.add("hidden");
      els.composePreviewImage?.removeAttribute("src");
    }

    if (linkUrl) {
      els.composePreviewLinkWrap?.classList.remove("hidden");
      if (els.composePreviewLinkLabel) els.composePreviewLinkLabel.textContent = linkLabel;
      if (els.composePreviewLinkUrl) els.composePreviewLinkUrl.textContent = linkUrl;
    } else {
      els.composePreviewLinkWrap?.classList.add("hidden");
    }

    if (fileUrl) {
      els.composePreviewFileWrap?.classList.remove("hidden");
      if (els.composePreviewFileUrl) els.composePreviewFileUrl.textContent = announcementState.uploadedFileName || fileUrl;
    } else {
      els.composePreviewFileWrap?.classList.add("hidden");
    }

    els.scheduleWrap?.classList.toggle("hidden", announcementState.deliveryMode !== "scheduled");

    syncStudentNoticeDefaults();
    refreshStudentPhonePreview();
    renderAnnouncementStepUI();
  }

  async function refreshAnnouncementMatchedPreview() {
    try {
      announcementState.loadingMatched = true;
      refreshAnnouncementPreviewCard();

      const payload = {
        action: "preview_matched_students",
        audience_mode: announcementState.audienceMode,
        programme_targets: announcementState.programmeTargets,
        ...getActorPayload()
      };

      const res = await invokeAnnouncementManager(payload);
      announcementState.matchedStudents = Array.isArray(res.matched_students) ? res.matched_students : [];
      refreshAnnouncementPreviewCard();
    } catch (err) {
      console.error("refreshAnnouncementMatchedPreview failed:", err);
      announcementState.matchedStudents = [];
      refreshAnnouncementPreviewCard();
    } finally {
      announcementState.loadingMatched = false;
    }
  }

  function validateAnnouncementStepOne() {
    const els = announcementEls();

    const title = els.titleInput?.value?.trim() || "";
    const body = els.bodyInput?.value?.trim() || "";

    if (!title) {
      alert("Enter announcement title.");
      return false;
    }

    if (!body) {
      alert("Enter announcement message.");
      return false;
    }

    if (announcementState.audienceMode === "programme_filter" && !announcementState.programmeTargets.length) {
      alert("Add at least one programme and level target.");
      return false;
    }

    if (announcementState.deliveryMode === "scheduled" && !(els.scheduleInput?.value || "")) {
      alert("Choose a schedule date and time.");
      return false;
    }

    return true;
  }

  function goToAnnouncementStep(step) {
    if (step === 2) {
      if (!validateAnnouncementStepOne()) return;
      syncStudentNoticeDefaults();
    }

    announcementState.composeStep = step;
    refreshAnnouncementPreviewCard();
  }

  function collectAnnouncementPayload(statusOverride = null) {
    const els = announcementEls();
    const status = statusOverride || announcementState.deliveryMode;

    return {
      title: announcementState.studentNoticeTitle?.trim() || els.titleInput?.value?.trim() || "",
      body: announcementState.studentNoticeBody?.trim() || els.bodyInput?.value?.trim() || "",
      link_label: els.linkLabelInput?.value?.trim() || "",
      link_url: els.linkUrlInput?.value?.trim() || "",
      image_url: announcementState.uploadedImageUrl || "",
      file_url: announcementState.uploadedFileUrl || "",
      audience_mode: announcementState.audienceMode,
      programme_targets: announcementState.programmeTargets,
      status,
      scheduled_at: status === "scheduled" ? (els.scheduleInput?.value || "") : ""
    };
  }

  async function saveAnnouncement(statusOverride = null) {
    const payload = collectAnnouncementPayload(statusOverride);

    if (!payload.title) {
      alert("Enter the student-facing announcement title.");
      return;
    }

    if (!payload.body) {
      alert("Enter the student-facing announcement description.");
      return;
    }

    if (payload.status === "scheduled" && !payload.scheduled_at) {
      alert("Choose a schedule date and time.");
      return;
    }

    try {
      if (announcementState.composeMode === "edit" && announcementState.editingId) {
        await invokeAnnouncementManager({
          action: "update_announcement",
          announcement_id: announcementState.editingId,
          ...payload,
          ...getActorPayload()
        });

        if (payload.status === "published") {
          await invokeAnnouncementManager({
            action: "publish_announcement",
            announcement_id: announcementState.editingId,
            ...getActorPayload()
          });
        }
      } else {
        await invokeAnnouncementManager({
          action: "create_announcement",
          ...payload,
          ...getActorPayload()
        });
      }

      closeAnnouncementComposer();
      await loadAnnouncements(announcementState.activeStatus);
    } catch (err) {
      console.error("saveAnnouncement failed:", err);
      alert(err.message || "Failed to save announcement.");
    }
  }

  async function handleAnnouncementImageUpload(file) {
    if (!file) return;
    announcementState.uploadingImage = true;
    renderImageUploadState();

    try {
      const result = await uploadAnnouncementAsset(file, "images");
      announcementState.uploadedImageUrl = result.publicUrl;
    } catch (err) {
      console.error("Image upload failed:", err);
      alert(err.message || "Image upload failed.");
      announcementState.uploadedImageUrl = "";
    } finally {
      announcementState.uploadingImage = false;
      renderImageUploadState();
      refreshAnnouncementPreviewCard();
    }
  }

  async function handleAnnouncementFileUpload(file) {
    if (!file) return;
    announcementState.uploadingFile = true;
    renderFileUploadState();

    try {
      const result = await uploadAnnouncementAsset(file, "files");
      announcementState.uploadedFileUrl = result.publicUrl;
      announcementState.uploadedFileName = result.fileName;
    } catch (err) {
      console.error("File upload failed:", err);
      alert(err.message || "File upload failed.");
      announcementState.uploadedFileUrl = "";
      announcementState.uploadedFileName = "";
    } finally {
      announcementState.uploadingFile = false;
      renderFileUploadState();
      refreshAnnouncementPreviewCard();
    }
  }

  function mergeProgrammeTarget(programmeName, levelValue) {
    const programme = normalizeText(programmeName).toUpperCase();
    const level = normalizeText(levelValue);

    if (!programme || !level) return;

    const existing = announcementState.programmeTargets.find(
      (item) => String(item.programme_name || "").toUpperCase() === programme
    );

    if (existing) {
      const levelSet = new Set(Array.isArray(existing.levels) ? existing.levels : []);
      levelSet.add(level);
      existing.levels = Array.from(levelSet);
      return;
    }

    announcementState.programmeTargets.push({
      programme_name: programme,
      levels: [level]
    });
  }

  function openAnnouncementComposer(mode = "create", item = null) {
    const els = announcementEls();

    announcementState.composeMode = mode;
    announcementState.editingId = item?.id || null;
    announcementState.composeStep = 1;
    announcementState.audienceMode = item?.audience_mode || "all_students";
    announcementState.programmeTargets = Array.isArray(item?.programme_targets) ? [...item.programme_targets] : [];
    announcementState.deliveryMode = item?.status === "scheduled"
      ? "scheduled"
      : item?.status === "draft"
      ? "draft"
      : "published";

    announcementState.uploadedImageUrl = item?.image_url || "";
    announcementState.uploadedFileUrl = item?.file_url || "";
    announcementState.uploadedFileName = item?.file_url ? item.file_url.split("/").pop() : "";
    announcementState.studentNoticeTitle = item?.title || "";
    announcementState.studentNoticeBody = item?.body || "";

    if (els.composeTitle) {
      els.composeTitle.textContent = mode === "edit" ? "Edit Announcement" : "New Announcement";
    }

    if (els.titleInput) els.titleInput.value = item?.title || "";
    if (els.bodyInput) els.bodyInput.value = item?.body || "";
    if (els.linkLabelInput) els.linkLabelInput.value = item?.link_label || "";
    if (els.linkUrlInput) els.linkUrlInput.value = item?.link_url || "";
    if (els.scheduleInput) els.scheduleInput.value = item?.scheduled_at ? toDateTimeLocal(item.scheduled_at) : "";
    if (els.studentTitleInput) els.studentTitleInput.value = announcementState.studentNoticeTitle || "";
    if (els.studentBodyInput) els.studentBodyInput.value = announcementState.studentNoticeBody || "";

    document.querySelectorAll(".audience-mode-card").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.mode === announcementState.audienceMode);
    });

    document.querySelectorAll(".delivery-option").forEach((label) => {
      const input = label.querySelector("input");
      const active = input && input.value === announcementState.deliveryMode;
      label.classList.toggle("active", active);
      if (input) input.checked = active;
    });

    renderImageUploadState();
    renderFileUploadState();
    refreshAnnouncementAudienceModeUI();
    renderAnnouncementTargetList();
    refreshAnnouncementPreviewCard();
    refreshAnnouncementMatchedPreview();
    renderAnnouncementStepUI();

    els.modal?.classList.remove("hidden");
  }

  function closeAnnouncementComposer() {
    announcementEls().modal?.classList.add("hidden");
  }

  function bindAnnouncementEvents() {
    $("announcementNewBtn")?.addEventListener("click", () => {
      resetAnnouncementComposeState();
      resetAnnouncementUploads();
      openAnnouncementComposer("create");
    });

    $("announcementComposerCloseBtn")?.addEventListener("click", closeAnnouncementComposer);
    $("announcementComposerBackdrop")?.addEventListener("click", closeAnnouncementComposer);
    $("announcementCancelBtn")?.addEventListener("click", closeAnnouncementComposer);

    $("announcementBackBtn")?.addEventListener("click", () => {
      goToAnnouncementStep(1);
    });

    $("announcementNextBtn")?.addEventListener("click", () => {
      goToAnnouncementStep(2);
    });

    $("announcementSaveDraftBtn")?.addEventListener("click", () => {
      announcementState.deliveryMode = "draft";
      document.querySelectorAll(".delivery-option").forEach((label) => {
        const input = label.querySelector("input");
        const active = input && input.value === "draft";
        label.classList.toggle("active", active);
        if (input) input.checked = active;
      });
      refreshAnnouncementPreviewCard();
      saveAnnouncement("draft");
    });

    $("announcementPublishBtn")?.addEventListener("click", () => {
      saveAnnouncement(announcementState.deliveryMode);
    });

    document.querySelectorAll(".announcement-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".announcement-tab").forEach((btn) => btn.classList.remove("active"));
        tab.classList.add("active");
        announcementState.activeStatus = tab.dataset.status || "all";
        loadAnnouncements(announcementState.activeStatus);
      });
    });

    $("announcementSearchInput")?.addEventListener("input", (e) => {
      announcementState.search = e.target.value || "";
      applyAnnouncementFilters();
    });

    document.querySelectorAll(".audience-mode-card").forEach((btn) => {
      btn.addEventListener("click", () => {
        announcementState.audienceMode = btn.dataset.mode || "all_students";
        document.querySelectorAll(".audience-mode-card").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        refreshAnnouncementAudienceModeUI();
        refreshAnnouncementPreviewCard();
        refreshAnnouncementMatchedPreview();
      });
    });

    $("announcementAddTargetBtn")?.addEventListener("click", () => {
      const els = announcementEls();
      const programme = els.programmeSelect?.value || "";
      const level = els.levelSelect?.value || "";

      if (!programme) {
        alert("Select programme.");
        return;
      }

      if (!level) {
        alert("Select level.");
        return;
      }

      mergeProgrammeTarget(programme, level);
      if (els.programmeSelect) els.programmeSelect.value = "";
      if (els.levelSelect) els.levelSelect.value = "";
      renderAnnouncementTargetList();
      refreshAnnouncementPreviewCard();
      refreshAnnouncementMatchedPreview();
    });

    document.querySelectorAll('input[name="announcementDeliveryMode"]').forEach((input) => {
      input.addEventListener("change", () => {
        announcementState.deliveryMode = input.value;
        document.querySelectorAll(".delivery-option").forEach((label) => {
          const radio = label.querySelector("input");
          label.classList.toggle("active", radio && radio.value === input.value);
        });
        refreshAnnouncementPreviewCard();
      });
    });

    [
      "announcementTitleInput",
      "announcementBodyInput",
      "announcementLinkLabelInput",
      "announcementLinkUrlInput",
      "announcementScheduleInput"
    ].forEach((id) => {
      $(id)?.addEventListener("input", () => {
        if (id === "announcementTitleInput" && !$("announcementStudentTitleInput")?.matches(":focus")) {
          announcementState.studentNoticeTitle = $("announcementTitleInput")?.value?.trim() || "";
        }
        if (id === "announcementBodyInput" && !$("announcementStudentBodyInput")?.matches(":focus")) {
          announcementState.studentNoticeBody = $("announcementBodyInput")?.value?.trim() || "";
        }
        refreshAnnouncementPreviewCard();
      });
    });

    $("announcementStudentTitleInput")?.addEventListener("input", (e) => {
      announcementState.studentNoticeTitle = e.target.value || "";
      refreshStudentPhonePreview();
    });

    $("announcementStudentBodyInput")?.addEventListener("input", (e) => {
      announcementState.studentNoticeBody = e.target.value || "";
      refreshStudentPhonePreview();
    });

    $("announcementImageFileInput")?.addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      await handleAnnouncementImageUpload(file);
    });

    $("announcementFileAttachmentInput")?.addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      await handleAnnouncementFileUpload(file);
    });

    $("announcementRemoveImageBtn")?.addEventListener("click", () => {
      announcementState.uploadedImageUrl = "";
      renderImageUploadState();
      refreshAnnouncementPreviewCard();
    });

    $("announcementRemoveFileBtn")?.addEventListener("click", () => {
      announcementState.uploadedFileUrl = "";
      announcementState.uploadedFileName = "";
      renderFileUploadState();
      refreshAnnouncementPreviewCard();
    });

    $("announcementEditBtn")?.addEventListener("click", () => {
      const item = announcementState.items.find((x) => x.id === announcementState.selectedId);
      if (item) openAnnouncementComposer("edit", item);
    });

    $("announcementDuplicateBtn")?.addEventListener("click", () => {
      const item = announcementState.items.find((x) => x.id === announcementState.selectedId);
      if (!item) return;

      const clone = {
        ...item,
        id: null,
        title: `${item.title || "Announcement"} Copy`,
        status: "draft"
      };

      openAnnouncementComposer("create", clone);
    });

    $("announcementArchiveBtn")?.addEventListener("click", async () => {
      if (!announcementState.selectedId) return;
      try {
        await invokeAnnouncementManager({
          action: "archive_announcement",
          announcement_id: announcementState.selectedId,
          ...getActorPayload()
        });
        await loadAnnouncements(announcementState.activeStatus);
      } catch (err) {
        console.error("archive announcement failed:", err);
        alert(err.message || "Failed to archive announcement.");
      }
    });

    $("announcementDeleteBtn")?.addEventListener("click", async () => {
      if (!announcementState.selectedId) return;
      if (!confirm("Delete this announcement?")) return;

      try {
        await invokeAnnouncementManager({
          action: "delete_announcement",
          announcement_id: announcementState.selectedId,
          ...getActorPayload()
        });
        await loadAnnouncements(announcementState.activeStatus);
      } catch (err) {
        console.error("delete announcement failed:", err);
        alert(err.message || "Failed to delete announcement.");
      }
    });
  }

  function toDateTimeLocal(value) {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "";
    const pad = (n) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  async function initAnnouncementSystem() {
    announcementState.sb = createClientSafe();
    announcementState.session = getAdminSession();

    if (!announcementState.sb) {
      console.error("Announcement supabase client could not be created.");
      return;
    }

    bindAnnouncementEvents();
    renderImageUploadState();
    renderFileUploadState();
    renderAnnouncementStepUI();
    await loadProgrammes();
    await loadAnnouncements("all");
  }

  document.addEventListener("DOMContentLoaded", () => {
    initAnnouncementSystem();
  });
})();
</script>
