  function formatAnnouncementStatus(status) {
    const value = String(status || "draft").toLowerCase();
    return value.charAt(0).toUpperCase() + value.slice(1);
  }

  function formatAnnouncementTime(value) {
    if (!value) return "Now";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleString();
  }

  function truncateAnnouncementText(value, max = 160) {
    const text = String(value || "").trim();
    if (!text) return "";
    return text.length > max ? text.slice(0, max - 3) + "..." : text;
  }

  function buildAnnouncementAudienceText(item) {
    const mode = String(item?.audience_mode || announcementState.audienceMode || "all_students");
    if (mode !== "programme_filter") return "All students";

    const targets = Array.isArray(item?.programme_targets)
      ? item.programme_targets
      : announcementState.programmeTargets;

    if (!targets.length) return "Filtered audience";

    return targets
      .map((target) => {
        const programme = String(target.programme_name || "").trim();
        const levels = Array.isArray(target.levels) ? target.levels.filter(Boolean).join(", ") : "";
        return levels ? `${programme} (${levels})` : programme;
      })
      .filter(Boolean)
      .join(" • ");
  }

  function announcementStatusClass(status) {
    return `announcement-status-${String(status || "draft").toLowerCase()}`;
  }

  function getStoragePublicUrl(path) {
    const { data } = announcementState.sb.storage.from(ANNOUNCEMENT_BUCKET).getPublicUrl(path);
    return data?.publicUrl || "";
  }

  function safeFileName(name) {
    return String(name || "file")
      .toLowerCase()
      .replace(/[^a-z0-9.\-_]+/g, "-")
      .replace(/-+/g, "-");
  }

  async function uploadAnnouncementAsset(file, folder) {
    if (!announcementState.sb) {
      throw new Error("Supabase client not ready.");
    }

    const actor = getActorPayload();
    const actorId = actor.hos_admin_id || actor.form_agent_id || "unknown";
    const ext = (file.name.split(".").pop() || "").toLowerCase();
    const stamp = Date.now();
    const fileName = safeFileName(file.name || `${folder}-${stamp}.${ext || "bin"}`);
    const path = `${actorId}/${folder}/${stamp}-${fileName}`;

    const { error } = await announcementState.sb.storage
      .from(ANNOUNCEMENT_BUCKET)
      .upload(path, file, {
        cacheControl: "3600",
        upsert: true
      });

    if (error) {
      throw new Error(error.message || "Upload failed.");
    }

    return {
      path,
      publicUrl: getStoragePublicUrl(path),
      fileName: file.name || fileName
    };
  }

  async function loadProgrammes() {
    const els = announcementEls();
    if (!announcementState.sb || !els.programmeSelect) return;

    try {
      const { data, error } = await announcementState.sb
        .from("programmes")
        .select("id, programme_name")
        .eq("is_active", true)
        .order("programme_name", { ascending: true });

      if (error) throw error;

      announcementState.programmes = Array.isArray(data) ? data : [];

      els.programmeSelect.innerHTML = `<option value="">Select programme</option>` +
        announcementState.programmes
          .map((row) => `<option value="${escapeHtml(row.programme_name)}">${escapeHtml(row.programme_name)}</option>`)
          .join("");
    } catch (err) {
      console.error("Load programmes error:", err);
      els.programmeSelect.innerHTML = `<option value="">Unable to load programmes</option>`;
    }
  }

