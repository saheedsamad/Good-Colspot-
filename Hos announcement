<section id="screen-announcements" class="screen">
  <div class="section-shell">
    <article class="panel announcements-panel">
      <div class="panel-head announcements-head">
        <div>
          <div class="panel-title">Announcements</div>
          <div class="panel-sub">Send updates, links, and media to students.</div>
        </div>

        <div class="announcements-head-actions">
          <button class="btn btn-primary" id="announcementNewBtn" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
            New Announcement
          </button>
        </div>
      </div>

      <div class="panel-body announcements-body">
        <div class="announcements-layout">
          <div class="announcements-main">
            <div class="announcement-toolbar">
              <div class="announcement-tabs" id="announcementTabs">
                <button class="announcement-tab active" type="button" data-status="all">All</button>
                <button class="announcement-tab" type="button" data-status="published">Published</button>
                <button class="announcement-tab" type="button" data-status="scheduled">Scheduled</button>
                <button class="announcement-tab" type="button" data-status="draft">Draft</button>
                <button class="announcement-tab" type="button" data-status="archived">Archived</button>
              </div>

              <div class="announcement-search-wrap">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
                  <path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <input
                  id="announcementSearchInput"
                  type="text"
                  placeholder="Search announcements..."
                  autocomplete="off"
                />
              </div>
            </div>

            <div class="announcement-list" id="announcementList">
              <div class="announcement-empty" id="announcementEmptyState">
                No announcements yet.
              </div>
            </div>
          </div>

          <aside class="announcement-preview-panel" id="announcementPreviewPanel">
            <div class="announcement-preview-empty" id="announcementPreviewEmpty">
              Select an announcement to preview it here.
            </div>

            <div class="announcement-preview-card hidden" id="announcementPreviewCard">
              <div class="announcement-preview-top">
                <div class="announcement-preview-title-wrap">
                  <h3 id="announcementPreviewTitle">Announcement title</h3>
                  <div class="announcement-preview-status" id="announcementPreviewStatus">Draft</div>
                </div>
                <div class="announcement-preview-audience" id="announcementPreviewAudience">All students</div>
              </div>

              <p class="announcement-preview-body" id="announcementPreviewBody">
                Announcement body preview will show here.
              </p>

              <div class="announcement-preview-image hidden" id="announcementPreviewImageWrap">
                <img id="announcementPreviewImage" alt="Announcement image preview" />
              </div>

              <div class="announcement-preview-link hidden" id="announcementPreviewLinkWrap">
                <div class="announcement-preview-link-label" id="announcementPreviewLinkLabel">Open link</div>
                <div class="announcement-preview-link-url" id="announcementPreviewLinkUrl">example.com</div>
              </div>

              <div class="announcement-preview-file hidden" id="announcementPreviewFileWrap">
                <div class="announcement-preview-file-label">Attached file</div>
                <div class="announcement-preview-file-url" id="announcementPreviewFileUrl">file.pdf</div>
              </div>

              <div class="announcement-preview-meta">
                <div class="announcement-preview-meta-row">
                  <span>Matched audience</span>
                  <strong id="announcementPreviewMatchedCount">0 students</strong>
                </div>
                <div class="announcement-preview-meta-row">
                  <span>Created by</span>
                  <strong id="announcementPreviewAuthor">Admin</strong>
                </div>
                <div class="announcement-preview-meta-row">
                  <span>Time</span>
                  <strong id="announcementPreviewTime">Now</strong>
                </div>
              </div>

              <div class="announcement-preview-actions">
                <button class="btn btn-light" id="announcementEditBtn" type="button">Edit</button>
                <button class="btn btn-light" id="announcementDuplicateBtn" type="button">Duplicate</button>
                <button class="btn btn-light" id="announcementArchiveBtn" type="button">Archive</button>
                <button class="btn btn-danger-soft" id="announcementDeleteBtn" type="button">Delete</button>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>
  </div>

  <div class="announcement-modal hidden" id="announcementComposerModal">
    <div class="announcement-modal-backdrop" id="announcementComposerBackdrop"></div>

    <div class="announcement-modal-dialog">
      <div class="announcement-modal-head">
        <div>
          <div class="announcement-modal-title" id="announcementComposerTitle">New Announcement</div>
          <div class="announcement-modal-sub">Create a message students will receive.</div>
        </div>

        <button class="announcement-close-btn" id="announcementComposerCloseBtn" type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="announcement-modal-body">
        <div class="announcement-step-header">
          <div class="announcement-step-badge active" id="announcementStepBadgeOne">
            <span class="announcement-step-number">1</span>
            <div class="announcement-step-copy">
              <strong>Compose</strong>
              <small>Details, media, audience</small>
            </div>
          </div>

          <div class="announcement-step-line"></div>

          <div class="announcement-step-badge" id="announcementStepBadgeTwo">
            <span class="announcement-step-number">2</span>
            <div class="announcement-step-copy">
              <strong>Student View</strong>
              <small>What students will see</small>
            </div>
          </div>
        </div>

        <div class="announcement-step" id="announcementStepOne">
          <div class="announcement-compose-grid">
            <div class="announcement-compose-left">
              <section class="announcement-compose-section">
                <div class="announcement-compose-section-title">Announcement Details</div>

                <label class="field">
                  <span class="field-label">Internal Title</span>
                  <input id="announcementTitleInput" type="text" placeholder="Enter internal announcement title" />
                </label>

                <label class="field">
                  <span class="field-label">Internal Message</span>
                  <textarea id="announcementBodyInput" rows="6" placeholder="Write the announcement content"></textarea>
                </label>

                <div class="field-grid two">
                  <label class="field">
                    <span class="field-label">CTA Text</span>
                    <input id="announcementLinkLabelInput" type="text" placeholder="Open registration" />
                  </label>

                  <label class="field">
                    <span class="field-label">Link URL</span>
                    <input id="announcementLinkUrlInput" type="text" placeholder="https://example.com" />
                  </label>
                </div>
              </section>

              <section class="announcement-compose-section">
                <div class="announcement-compose-section-title">Media Upload</div>

                <div class="announcement-upload-grid">
                  <div class="announcement-upload-card">
                    <div class="announcement-upload-top">
                      <div>
                        <div class="announcement-upload-title">Image</div>
                        <div class="announcement-upload-sub">Upload banner, flyer, or photo</div>
                      </div>
                      <label class="btn btn-light announcement-upload-btn">
                        Upload Image
                        <input id="announcementImageFileInput" type="file" accept="image/*" hidden />
                      </label>
                    </div>

                    <div class="announcement-upload-status" id="announcementImageUploadStatus">No image selected</div>

                    <div class="announcement-upload-preview hidden" id="announcementImageUploadPreview">
                      <img id="announcementImageUploadPreviewImg" alt="Uploaded announcement image preview" />
                      <div class="announcement-upload-actions">
                        <button class="btn btn-light" id="announcementRemoveImageBtn" type="button">Remove Image</button>
                      </div>
                    </div>
                  </div>

                  <div class="announcement-upload-card">
                    <div class="announcement-upload-top">
                      <div>
                        <div class="announcement-upload-title">Attachment</div>
                        <div class="announcement-upload-sub">Upload PDF, DOCX, image, or file</div>
                      </div>
                      <label class="btn btn-light announcement-upload-btn">
                        Upload File
                        <input id="announcementFileAttachmentInput" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.webp,.txt" hidden />
                      </label>
                    </div>

                    <div class="announcement-upload-status" id="announcementFileUploadStatus">No file selected</div>

                    <div class="announcement-file-chip hidden" id="announcementFileChip">
                      <div class="announcement-file-chip-name" id="announcementFileChipName">document.pdf</div>
                      <button class="announcement-file-chip-remove" id="announcementRemoveFileBtn" type="button">&times;</button>
                    </div>
                  </div>
                </div>
              </section>

              <section class="announcement-compose-section">
                <div class="announcement-compose-section-title">Audience</div>

                <div class="audience-mode-cards">
                  <button class="audience-mode-card active" type="button" data-mode="all_students" id="announcementAudienceAllBtn">
                    <div class="audience-mode-card-title">All students</div>
                    <div class="audience-mode-card-sub">Send to every student in this school.</div>
                  </button>

                  <button class="audience-mode-card" type="button" data-mode="programme_filter" id="announcementAudienceFilterBtn">
                    <div class="audience-mode-card-title">Filter audience</div>
                    <div class="audience-mode-card-sub">Choose programme and level.</div>
                  </button>
                </div>

                <div class="audience-target-box hidden" id="announcementProgrammeFilterBox">
                  <div class="field-grid three">
                    <label class="field">
                      <span class="field-label">Programme</span>
                      <select id="announcementProgrammeSelect">
                        <option value="">Select programme</option>
                      </select>
                    </label>

                    <label class="field">
                      <span class="field-label">Level</span>
                      <select id="announcementLevelSelect">
                        <option value="">Select level</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="300">300</option>
                        <option value="400">400</option>
                        <option value="500">500</option>
                        <option value="600">600</option>
                        <option value="700">700</option>
                      </select>
                    </label>

                    <div class="field add-target-field">
                      <span class="field-label">&nbsp;</span>
                      <button class="btn btn-light" id="announcementAddTargetBtn" type="button">Add Target</button>
                    </div>
                  </div>

                  <div class="announcement-target-list" id="announcementTargetList"></div>
                </div>

                <div class="announcement-audience-summary">
                  <div class="announcement-audience-count-card">
                    <div class="announcement-audience-count-label">Matched Students</div>
                    <div class="announcement-audience-count-value" id="announcementMatchedCount">0</div>
                    <div class="announcement-audience-count-sub" id="announcementAudienceTextMini">All students</div>
                  </div>
                </div>
              </section>

              <section class="announcement-compose-section">
                <div class="announcement-compose-section-title">Delivery</div>

                <div class="delivery-options">
                  <label class="delivery-option active" data-delivery="published">
                    <input type="radio" name="announcementDeliveryMode" value="published" checked />
                    <span>Send now</span>
                  </label>

                  <label class="delivery-option" data-delivery="draft">
                    <input type="radio" name="announcementDeliveryMode" value="draft" />
                    <span>Save as draft</span>
                  </label>

                  <label class="delivery-option" data-delivery="scheduled">
                    <input type="radio" name="announcementDeliveryMode" value="scheduled" />
                    <span>Schedule</span>
                  </label>
                </div>

                <div class="field hidden" id="announcementScheduleWrap">
                  <span class="field-label">Schedule Time</span>
                  <input id="announcementScheduleInput" type="datetime-local" />
                </div>
              </section>
            </div>

            <div class="announcement-compose-right">
              <div class="compose-preview-card">
                <div class="compose-preview-title">Internal Preview</div>

                <div class="compose-preview-message-card">
                  <h3 id="announcementComposePreviewTitle">Announcement title</h3>
                  <div class="compose-preview-audience-pill" id="announcementAudienceText">All students</div>

                  <p id="announcementComposePreviewBody">
                    Your announcement message preview will show here.
                  </p>

                  <div class="compose-preview-image hidden" id="announcementComposePreviewImageWrap">
                    <img id="announcementComposePreviewImage" alt="Announcement preview image" />
                  </div>

                  <div class="compose-preview-link hidden" id="announcementComposePreviewLinkWrap">
                    <div class="compose-preview-link-main" id="announcementComposePreviewLinkLabel">Open link</div>
                    <div class="compose-preview-link-sub" id="announcementComposePreviewLinkUrl">https://example.com</div>
                  </div>

                  <div class="compose-preview-file hidden" id="announcementComposePreviewFileWrap">
                    <div class="compose-preview-file-main">Attached file</div>
                    <div class="compose-preview-file-sub" id="announcementComposePreviewFileUrl">file.pdf</div>
                  </div>

                  <div class="compose-preview-summary">
                    <div class="compose-preview-summary-row">
                      <span>Matched audience</span>
                      <strong id="announcementComposePreviewMatched">0 students</strong>
                    </div>
                    <div class="compose-preview-summary-row">
                      <span>Status</span>
                      <strong id="announcementComposePreviewStatus">Send now</strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div><!-- end step one -->

        <div class="announcement-step hidden" id="announcementStepTwo">
          <div class="announcement-step-two-grid">
            <div class="announcement-step-two-left">
              <section class="announcement-compose-section">
                <div class="announcement-compose-section-title">Student Announcement Details</div>
                <div class="announcement-step-note">
                  This is what students will see on their phone when the announcement is delivered.
                </div>

                <label class="field">
                  <span class="field-label">Student Title</span>
                  <input id="announcementStudentTitleInput" type="text" placeholder="Enter the title students will see" />
                </label>

                <label class="field">
                  <span class="field-label">Student Description</span>
                  <textarea id="announcementStudentBodyInput" rows="7" placeholder="Write the student-facing description"></textarea>
                </label>

                <div class="announcement-step-summary-card">
                  <div class="announcement-step-summary-row">
                    <span>Audience</span>
                    <strong id="announcementStudentAudienceLine">All students</strong>
                  </div>
                  <div class="announcement-step-summary-row">
                    <span>Matched Students</span>
                    <strong id="announcementStudentMatchedCount">0 students</strong>
                  </div>
                </div>
              </section>
            </div>

            <div class="announcement-step-two-right">
              <div class="announcement-phone-shell">
                <div class="announcement-phone-topbar">
                  <span></span>
                  <div class="announcement-phone-notch"></div>
                  <span></span>
                </div>

                <div class="announcement-phone-content">
                  <div class="announcement-phone-label">Student Preview</div>

                  <div class="announcement-phone-card">
                    <div class="announcement-phone-chip" id="announcementStudentPhoneAudience">All students</div>

                    <h3 id="announcementStudentPhoneTitle">Announcement title</h3>

                    <p id="announcementStudentPhoneBody">
                      This is how the announcement will look on the student's phone.
                    </p>

                    <div class="announcement-phone-image hidden" id="announcementStudentPhoneImageWrap">
                      <img id="announcementStudentPhoneImage" alt="Student announcement preview image" />
                    </div>

                    <div class="announcement-phone-link hidden" id="announcementStudentPhoneLinkWrap">
                      <div class="announcement-phone-link-main" id="announcementStudentPhoneLinkLabel">Open link</div>
                      <div class="announcement-phone-link-sub" id="announcementStudentPhoneLinkUrl">https://example.com</div>
                    </div>

                    <div class="announcement-phone-file hidden" id="announcementStudentPhoneFileWrap">
                      <div class="announcement-phone-file-main">Attached file</div>
                      <div class="announcement-phone-file-sub" id="announcementStudentPhoneFileUrl">file.pdf</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div><!-- end step two -->

        <div class="announcement-modal-foot">
          <button class="btn btn-light" id="announcementCancelBtn" type="button">Cancel</button>
          <button class="btn btn-light" id="announcementBackBtn" type="button">Back</button>
          <button class="btn btn-light" id="announcementSaveDraftBtn" type="button">Save Draft</button>
          <button class="btn btn-primary" id="announcementNextBtn" type="button">Next</button>
          <button class="btn btn-primary hidden" id="announcementPublishBtn" type="button">Send Announcement</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .announcements-panel {
    overflow: hidden;
  }

  .announcements-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .announcements-head-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .announcements-head-actions .btn svg {
    width: 18px;
    height: 18px;
  }

  .announcements-body {
    padding-top: 8px;
  }

  .announcements-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.85fr);
    gap: 18px;
    align-items: start;
  }

  .announcement-toolbar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 16px;
  }

  .announcement-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .announcement-tab {
    border: 1px solid #d8deef;
    background: #fff;
    color: #24324f;
    border-radius: 14px;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: .2s ease;
  }

  .announcement-tab.active {
    background: linear-gradient(135deg, #2f6cf6, #5a8cff);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 10px 24px rgba(47,108,246,.18);
  }

  .announcement-search-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #d8deef;
    background: #fff;
    border-radius: 16px;
    padding: 0 14px;
    height: 52px;
  }

  .announcement-search-wrap svg {
    width: 18px;
    height: 18px;
    color: #7d8aa8;
    flex: 0 0 auto;
  }

  .announcement-search-wrap input {
    border: 0;
    outline: none;
    width: 100%;
    height: 100%;
    background: transparent;
    font-size: 15px;
    color: #18233a;
  }

  .announcement-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .announcement-empty,
  .announcement-preview-empty {
    border: 1px dashed #d9dfef;
    background: #f8faff;
    border-radius: 18px;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #73809b;
    font-size: 15px;
    text-align: center;
    padding: 24px;
  }

  .announcement-item {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    border: 1px solid #e0e6f3;
    border-radius: 20px;
    background: #fff;
    padding: 14px;
    cursor: pointer;
    transition: .2s ease;
  }

  .announcement-item:hover,
  .announcement-item.active {
    border-color: #b8c8f5;
    box-shadow: 0 12px 26px rgba(27,39,94,.08);
    transform: translateY(-1px);
  }

  .announcement-item-thumb {
    width: 112px;
    height: 92px;
    border-radius: 16px;
    background: #eef3ff;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a88a8;
    font-size: 12px;
    font-weight: 700;
  }

  .announcement-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .announcement-item-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .announcement-item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .announcement-item-title {
    font-size: 18px;
    font-weight: 800;
    color: #16213b;
    line-height: 1.2;
  }

  .announcement-item-status {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 800;
    text-transform: capitalize;
    background: #eef3ff;
    color: #3658b3;
  }

  .announcement-status-published {
    background: #edf8ef;
    color: #1d8b48;
  }

  .announcement-status-draft {
    background: #f4f5f8;
    color: #67758f;
  }

  .announcement-status-scheduled {
    background: #f8f3e8;
    color: #936d19;
  }

  .announcement-status-archived {
    background: #f1eefb;
    color: #7252b0;
  }

  .announcement-item-audience {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    border-radius: 999px;
    padding: 7px 12px;
    background: #f7f9fd;
    color: #425270;
    font-size: 13px;
    font-weight: 700;
  }

  .announcement-item-body {
    color: #5d6b86;
    font-size: 14px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .announcement-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    color: #7a87a2;
    font-size: 13px;
    font-weight: 600;
  }

  .announcement-item-actions {
    display: flex;
    gap: 10px;
    margin-top: 2px;
  }

  .announcement-item-actions .mini-btn {
    border: 1px solid #dbe2f2;
    background: #fff;
    color: #2e3b59;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .announcement-preview-panel {
    position: sticky;
    top: 12px;
  }

  .announcement-preview-card {
    border: 1px solid #e0e6f3;
    background: #fff;
    border-radius: 22px;
    padding: 18px;
    box-shadow: 0 10px 24px rgba(27,39,94,.05);
  }

  .announcement-preview-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .announcement-preview-title-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .announcement-preview-title-wrap h3 {
    margin: 0;
    font-size: 28px;
    line-height: 1.15;
    color: #13203c;
  }

  .announcement-preview-status {
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 800;
