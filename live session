<!-- 🔹 LIVE SESSION SCREEN START -->
<div id="screen-live-session" class="screen">
  <style>
    #screen-live-session {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #e5f0ff;
      --bg2: #f8fbff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --error: #dc2626;
      --success: #16a34a;

      padding: 8px 6px 90px;
      background: #ffffff;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    #screen-live-session * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Inter, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    #screen-live-session .hero {
      padding: 4px 4px 6px;
      margin-bottom: 6px;
    }

    #screen-live-session .hero-title {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      color: var(--text-main);
      margin: 0;
    }

    #screen-live-session .phone-shell {
      width: 100%;
      max-width: none;
      margin: 0;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
      display: block;
      padding: 0;
      position: relative;
    }

    #screen-live-session main {
      display: block;
      overflow: visible;
      padding: 0 0 90px;
    }

    #screen-live-session .session-card {
      background: radial-gradient(
        circle at top left,
        #e0edff 0,
        #f9fbff 45%,
        #ffffff 100%
      );
      border-radius: 20px;
      padding: 14px 14px 12px;
      border: 1px solid #e0ecff;
      margin-bottom: 12px;
    }

    #screen-live-session .session-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 8px;
    }

    #screen-live-session .session-title-block {
      flex: 1;
      min-width: 0;
    }

    #screen-live-session .session-class {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    #screen-live-session .session-class-sub {
      font-size: 12px;
      color: var(--text-muted);
    }

    #screen-live-session .status-pill {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      border: 1px solid #bbf7d0;
      background: #ecfdf5;
      color: #166534;
      white-space: nowrap;
    }

    #screen-live-session .status-pill-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #16a34a;
    }

    #screen-live-session .status-pill.expired {
      border-color: #fecaca;
      background: #fef2f2;
      color: #b91c1c;
    }

    #screen-live-session .status-pill.expired .status-pill-dot {
      background: #dc2626;
    }

    #screen-live-session .session-middle {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 8px;
    }

    #screen-live-session .pin-block {
      flex: 1;
      min-width: 0;
    }

    #screen-live-session .pin-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    #screen-live-session .pin-value {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--text-main);
    }

    #screen-live-session .session-code-block {
      margin-top: 10px;
      width: fit-content;
      max-width: 100%;
      border-radius: 14px;
      border: 1px solid #dbeafe;
      background: #eff6ff;
      padding: 8px 10px;
    }

    #screen-live-session .session-code-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #2563eb;
      font-weight: 800;
      margin-bottom: 2px;
    }

    #screen-live-session .session-code-value {
      font-size: 16px;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    #screen-live-session .session-code-note {
      font-size: 10.5px;
      color: #64748b;
      margin-top: 3px;
      line-height: 1.3;
    }

    #screen-live-session .timer-block {
      text-align: right;
      font-size: 12px;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    #screen-live-session .timer-value {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-main);
    }

    #screen-live-session .session-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 4px;
      font-size: 12px;
      color: var(--text-muted);
    }

    #screen-live-session .session-footer strong {
      color: var(--text-main);
    }

    #screen-live-session .pill-row {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    #screen-live-session .pill-btn {
      flex: 1;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      padding: 8px 12px;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      cursor: pointer;
    }

    #screen-live-session .pill-btn.primary {
      background: #eef2ff;
      border-color: #dbeafe;
      color: #1d4ed8;
    }

    #screen-live-session .pill-btn:disabled {
      opacity: 0.6;
      cursor: default;
    }

    #screen-live-session .pill-btn svg {
      width: 16px;
      height: 16px;
      stroke-width: 2;
      stroke: currentColor;
      fill: none;
    }

    #screen-live-session .end-session-row {
      margin-top: 10px;
    }

    #screen-live-session .end-session-btn {
      width: 100%;
      border-radius: 999px;
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #b91c1c;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(220, 38, 38, 0.25);
    }

    #screen-live-session .end-session-btn svg {
      width: 18px;
      height: 18px;
      stroke-width: 2;
      stroke: currentColor;
      fill: none;
    }

    #screen-live-session .end-session-btn.ended {
      background: #f3f4f6;
      border-color: #e5e7eb;
      color: #9ca3af;
      box-shadow: none;
    }

    #screen-live-session .end-session-btn:disabled {
      opacity: 1;
      cursor: default;
    }

    #screen-live-session .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      margin: 8px 2px 4px;
    }

    #screen-live-session .section-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin: 0 2px 8px;
    }

    #screen-live-session .attendee-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
    }

    #screen-live-session .add-student-btn {
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      padding: 6px 10px;
      font-size: 11px;
      cursor: pointer;
    }

    #screen-live-session .add-student-btn:active {
      transform: scale(0.97);
    }

    #screen-live-session .filter-wrapper {
      position: relative;
      margin-bottom: 6px;
    }

    #screen-live-session .attendee-filter {
      width: 100%;
      padding: 7px 34px 7px 12px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      font-size: 16px;
      background: #f9fafb;
    }

    #screen-live-session .attendee-filter:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
      background: #ffffff;
    }

    #screen-live-session .filter-wrapper svg {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      stroke: #9ca3af;
      fill: none;
    }

    #screen-live-session .attendee-header-row {
      display: grid;
      grid-template-columns: 2fr 1.4fr 1.6fr 1fr;
      gap: 8px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      border-bottom: 1px solid #e5e7eb;
      margin: 0 0 4px;
    }

    #screen-live-session .attendee-header-row div {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #screen-live-session .attendee-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 10px;
    }

    #screen-live-session .attendee-card {
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      padding: 6px 10px;
      display: grid;
      grid-template-columns: 2fr 1.4fr 1.6fr 1fr;
      gap: 8px;
      align-items: center;
      cursor: pointer;
    }

    #screen-live-session .attendee-card + .attendee-card {
      margin-top: 4px;
    }

    #screen-live-session .attendee-cell {
      font-size: 12px;
      color: var(--text-main);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #screen-live-session .attendee-cell-small {
      font-size: 11px;
      color: var(--text-muted);
    }

    #screen-live-session .empty-state {
      font-size: 13px;
      color: var(--text-muted);
      margin: 8px 2px;
    }

    #screen-live-session .error-text {
      font-size: 12px;
      color: var(--error);
      margin: 4px 2px;
    }

    #screen-live-session .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }

    #screen-live-session .modal-sheet {
      width: 100%;
      max-width: 380px;
      max-height: 60vh;
      background: #ffffff;
      border-radius: 18px;
      padding: 12px 14px 14px;
      box-shadow: 0 18px 35px rgba(15, 23, 42, 0.35);
      animation: fadeInUp 0.18s ease-out;
      overflow-y: auto;
    }

    @keyframes fadeInUp {
      from {
        transform: translateY(10px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    #screen-live-session .modal-grip {
      width: 34px;
      height: 3px;
      border-radius: 999px;
      background: #e5e7eb;
      margin: 0 auto 8px;
    }

    #screen-live-session .modal-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
      text-align: left;
    }

    #screen-live-session .modal-sub {
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    #screen-live-session .modal-field {
      margin-bottom: 6px;
    }

    #screen-live-session .modal-label {
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 3px;
    }

    #screen-live-session .modal-input {
      width: 100%;
      padding: 8px 9px;
      border-radius: 9px;
      border: 1px solid #e5e7eb;
      font-size: 16px;
    }

    #screen-live-session .modal-input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
    }

    #screen-live-session .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 8px;
    }

    #screen-live-session .modal-btn {
      border-radius: 999px;
      padding: 7px 13px;
      font-size: 13px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      cursor: pointer;
    }

    #screen-live-session .modal-btn-primary {
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      border-color: #1d4ed8;
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.45);
    }

    #screen-live-session .modal-btn-primary:active,
    #screen-live-session .modal-btn:active {
      transform: scale(0.97);
    }

    #screen-live-session .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(env(safe-area-inset-bottom) + 8px);
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 420px;
      border-top: 1px solid #e5e7eb;
      padding: 6px 8px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: #ffffff;
      border-radius: 26px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
      z-index: 50;
      will-change: transform;
    }

    #screen-live-session .nav-btn {
      flex: 1;
      text-align: center;
      font-size: 11px;
      color: #9ca3af;
      padding-top: 2px;
      cursor: pointer;
    }

    #screen-live-session .nav-btn .icon {
      display: flex;
      justify-content: center;
      margin-bottom: 2px;
    }

    #screen-live-session .nav-btn svg {
      width: 20px;
      height: 20px;
      stroke-width: 1.7;
      stroke: currentColor;
      fill: none;
      display: block;
    }

    #screen-live-session .nav-btn.active {
      color: var(--blue);
      font-weight: 600;
    }

    @media (max-width: 380px) {
      #screen-live-session .pill-row {
        flex-direction: column;
      }

      #screen-live-session .session-middle {
        flex-direction: column;
        gap: 10px;
      }

      #screen-live-session .timer-block {
        text-align: left;
      }
    }
  </style>

  <section class="hero">
    <h1 class="hero-title">Live Attendance</h1>
  </section>

  <div class="phone-shell">
    <main>
      <section class="session-card">
        <div class="session-top-row">
          <div class="session-title-block">
            <div id="sessionClass" class="session-class">Loading...</div>
            <div id="sessionClassSub" class="session-class-sub">
              Checking details for this session.
            </div>
          </div>
          <div id="statusPill" class="status-pill">
            <span class="status-pill-dot"></span>
            <span>Active</span>
          </div>
        </div>

        <div class="session-middle">
          <div class="pin-block">
            <div class="pin-label">Session PIN</div>
            <div id="pinValue" class="pin-value">••••••</div>

            <div class="session-code-block">
              <div class="session-code-label">Session ID</div>
              <div id="sessionCodeValue" class="session-code-value">Loading...</div>
              <div class="session-code-note">
                Students can search this ID on Nearby attendance.
              </div>
            </div>
          </div>

          <div class="timer-block">
            <div>Time left</div>
            <div id="timerValue" class="timer-value">--:--</div>
          </div>
        </div>

        <div class="session-footer">
          <div>
            <span id="joinedCount"><strong>0</strong> joined</span>
          </div>
        </div>

        <div class="pill-row">
          <button class="pill-btn primary" type="button" onclick="liveSessionReloadAttendees()">
            <svg viewBox="0 0 24 24">
              <path d="M4 4v6h6" />
              <path d="M20 20v-6h-6" />
              <path d="M5 19a9 9 0 0 0 14-3" />
              <path d="M19 5a9 9 0 0 0-14 3" />
            </svg>
            <span>Refresh</span>
          </button>

          <button class="pill-btn" type="button" onclick="liveSessionDownloadAttendeesCsv()">
            <svg viewBox="0 0 24 24">
              <path d="M12 3v9" />
              <path d="M8.5 9.5L12 13l3.5-3.5" />
              <path d="M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
            </svg>
            <span>Download CSV</span>
          </button>
        </div>

        <div class="end-session-row">
          <button
            id="endSessionBtn"
            class="end-session-btn"
            type="button"
            onclick="liveSessionEndSession()"
          >
            <svg viewBox="0 0 24 24">
              <rect x="5" y="5" width="14" height="14" rx="3" />
              <path d="M9 9h6v6H9z" />
            </svg>
            <span class="end-session-label">End session</span>
          </button>
        </div>
      </section>

      <section>
        <div class="attendee-header-bar">
          <div class="section-title">Attendees</div>
          <button class="add-student-btn" type="button" onclick="liveSessionOpenAddStudentModal()">Add student</button>
        </div>
        <p class="section-sub">
          Students who have successfully joined this session.
        </p>

        <div class="filter-wrapper">
          <input
            id="attendeeFilter"
            class="attendee-filter"
            type="text"
            placeholder="Filter by name, matric or department"
            oninput="liveSessionApplyAttendeeFilter()"
          />
          <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6" />
            <path d="M16 16l4 4" />
          </svg>
        </div>

        <div class="attendee-header-row">
          <div>Name</div>
          <div>Matric no</div>
          <div>Department</div>
          <div>Joined at</div>
        </div>

        <div id="errorBox" class="error-text" style="display:none;"></div>

        <div id="attendeeList" class="attendee-list"></div>
        <div id="emptyState" class="empty-state" style="display:none;">
          No one has joined yet. Ask your class to enter the PIN in Colspot.
        </div>
      </section>
    </main>

    <div id="addStudentModal" class="modal-backdrop" style="display:none;">
      <div class="modal-sheet">
        <div class="modal-grip"></div>
        <div class="modal-title">Add student</div>
        <div class="modal-sub">
          Manually add a student who is in the class but cannot join from their device.
        </div>

        <div class="modal-field">
          <div class="modal-label">
            Full name <span style="color:var(--error);">*</span>
          </div>
          <input
            id="modalStudentName"
            type="text"
            class="modal-input"
            placeholder="e.g. John Doe"
          />
        </div>

        <div class="modal-field">
          <div class="modal-label">Matric number (optional)</div>
          <input
            id="modalStudentMatric"
            type="text"
            class="modal-input"
            placeholder="e.g. CSC/22/001"
          />
        </div>

        <div class="modal-field">
          <div class="modal-label">Department (optional)</div>
          <input
            id="modalStudentDept"
            type="text"
            class="modal-input"
            placeholder="e.g. Computer Science"
          />
        </div>

        <div id="modalStudentError" class="error-text" style="display:none;"></div>

        <div class="modal-actions">
          <button type="button" class="modal-btn" onclick="liveSessionCloseAddStudentModal()">
            Cancel
          </button>
          <button
            type="button"
            id="modalAddBtn"
            class="modal-btn modal-btn-primary"
            onclick="liveSessionSubmitAddStudentModal()"
          >
            Add student
          </button>
        </div>
      </div>
    </div>
  </div>

  <nav class="bottom-nav">
    <div class="nav-btn" onclick="liveSessionGoHome()">
      <div class="icon">
        <svg viewBox="0 0 24 24">
          <path d="M3 11l9-8 9 8" />
          <path d="M5 10v10h14V10" />
        </svg>
      </div>
      Home
    </div>

    <div class="nav-btn active" onclick="liveSessionGoAttendance()">
      <div class="icon">
        <svg viewBox="0 0 24 24">
          <rect x="4" y="4" width="16" height="16" rx="2" />
          <path d="M8 8h8" />
          <path d="M8 12h5" />
          <path d="M8 16h6" />
        </svg>
      </div>
      Attendance
    </div>

    <div class="nav-btn" onclick="liveSessionGoHistory()">
      <div class="icon">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 3" />
        </svg>
      </div>
      History
    </div>

    <div class="nav-btn" onclick="liveSessionGoReports()">
      <div class="icon">
        <svg viewBox="0 0 24 24">
          <path d="M4 19h4V9H4z" />
          <path d="M10 19h4V5h-4z" />
          <path d="M16 19h4v-8h-4z" />
        </svg>
      </div>
      Reports
    </div>
  </nav>

<script>
  let selectedClass = null;
  let serverClassesCache = [];
  let lastAttendanceLocationReason = null;

  const LOCATION_REASON_MESSAGES = {
    PERMISSION_DENIED:
      "Location permission is blocked.\n\nPlease go to your phone Settings, open Colspot, allow Location access, and turn ON Precise Location. Then close and reopen Colspot and try again.",

    LOCATION_OFF:
      "Your phone Location is turned off.\n\nPlease turn Location ON, allow Colspot to use your location, and try again.",

    POSITION_UNAVAILABLE:
      "Colspot could not get your location right now.\n\nPlease move closer to a window or go outside, make sure you are not inside a thick building, and try again.",

    TIMEOUT:
      "Location request took too long.\n\nPlease check your internet connection, turn Location ON, move closer to a window or outside, then try again.",

    NO_READING:
      "Colspot could not get your location.\n\nPlease turn Location ON, allow Colspot location access, check your internet, move closer to a window or outside, and try again.",

    ACCURACY_TOO_POOR_ANDROID:
      "Your location accuracy is too poor. We need accuracy under 300 m.\n\nMove closer to a window or outside and try again. Do not stay deep inside a building when starting a location-based attendance.",

    ACCURACY_TOO_POOR_IOS:
      "Your location accuracy is too poor. We need accuracy under 1 km on iPhone.\n\nMove closer to a window or outside and try again. Also make sure Precise Location is turned ON for Colspot.",

    LOCATION_TOO_WEAK_ANDROID:
      "Your phone found your location, but it is not accurate enough.\n\nAndroid needs accuracy under 300 m. Move closer to a window or outside, avoid staying deep indoor, and try again.",

    LOCATION_TOO_WEAK_IOS:
      "Your iPhone found your location, but it is not accurate enough.\n\niPhone needs accuracy under 1 km. Turn ON Precise Location for Colspot, move closer to a window or outside, and try again."
  };

  function normalizeSchoolName(value) {
    return String(value || "").trim().replace(/\s+/g, " ").toUpperCase();
  }

  function openAttendanceErrorPopup(msg, title = "Location issue") {
