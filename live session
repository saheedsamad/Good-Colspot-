  function getPlatformForLocation() {
    try {
      if (window.Capacitor && typeof window.Capacitor.getPlatform === "function") {
        return window.Capacitor.getPlatform();
      }

      const ua = navigator.userAgent || navigator.vendor || "";
      if (/android/i.test(ua)) return "android";
      if (/iphone|ipad|ipod/i.test(ua)) return "ios";

      return "web";
    } catch {
      return "web";
    }
  }

  function mapLocationError(err) {
    try {
      if (!err) return "NO_READING";

      if (typeof err.code === "number") {
        if (err.code === 1) return "PERMISSION_DENIED";
        if (err.code === 2) return "POSITION_UNAVAILABLE";
        if (err.code === 3) return "TIMEOUT";
      }

      const msg = String(err.message || "").toLowerCase();

      if (msg.includes("permission") && msg.includes("denied")) return "PERMISSION_DENIED";
      if (msg.includes("location services") && msg.includes("disabled")) return "LOCATION_OFF";
      if (msg.includes("disabled")) return "LOCATION_OFF";
      if (msg.includes("timeout")) return "TIMEOUT";
      if (msg.includes("unavailable")) return "POSITION_UNAVAILABLE";

      return "NO_READING";
    } catch (_) {
      return "NO_READING";
    }
  }

  function buildLocationFailureMessage(reason, platform) {
    const isIos = platform === "ios";

    if (reason === "ACCURACY_TOO_POOR") {
      return isIos
        ? LOCATION_REASON_MESSAGES.ACCURACY_TOO_POOR_IOS
        : LOCATION_REASON_MESSAGES.ACCURACY_TOO_POOR_ANDROID;
    }

    if (reason === "WARMUP_ONLY_BAD" || reason === "LIVE_ONLY_BAD") {
      return isIos
        ? LOCATION_REASON_MESSAGES.LOCATION_TOO_WEAK_IOS
        : LOCATION_REASON_MESSAGES.LOCATION_TOO_WEAK_ANDROID;
    }

    return LOCATION_REASON_MESSAGES[reason] ||
      "Colspot could not get your location right now.\n\nPlease turn Location ON, allow Colspot location access, check your internet, move closer to a window or outside, and try again.";
  }

  function getLocationPopupTitle(reason) {
    if (reason === "PERMISSION_DENIED") return "Location is blocked";
    if (reason === "LOCATION_OFF") return "Location is off";
    if (reason === "TIMEOUT") return "Location took too long";
    if (
      reason === "ACCURACY_TOO_POOR" ||
      reason === "WARMUP_ONLY_BAD" ||
      reason === "LIVE_ONLY_BAD"
    ) {
      return "Location accuracy is weak";
    }
    return "Location issue";
  }

  function getCurrentPositionOnce() {
    return new Promise(async (resolve) => {
      try {
        const hasCapacitor =
          typeof window !== "undefined" &&
          window.Capacitor &&
          window.Capacitor.Plugins &&
          window.Capacitor.Plugins.Geolocation;

        if (hasCapacitor) {
          const Geolocation = window.Capacitor.Plugins.Geolocation;

          try {
            const perm = await Geolocation.requestPermissions();

            if (
              perm &&
              (perm.location === "denied" || perm.coarseLocation === "denied")
            ) {
              return resolve({ ok: false, reason: "PERMISSION_DENIED", pos: null });
            }
          } catch (permErr) {
            return resolve({ ok: false, reason: mapLocationError(permErr), pos: null });
          }

          try {
            const pos = await Geolocation.getCurrentPosition({
              enableHighAccuracy: true,
              timeout: 20000,
              maximumAge: 0
            });

            return resolve({ ok: true, reason: null, pos });
          } catch (err) {
            return resolve({ ok: false, reason: mapLocationError(err), pos: null });
          }
        } else if ("geolocation" in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => resolve({ ok: true, reason: null, pos }),
            (err) => resolve({ ok: false, reason: mapLocationError(err), pos: null }),
            { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 }
          );
        } else {
          resolve({ ok: false, reason: "POSITION_UNAVAILABLE", pos: null });
        }
      } catch (err) {
        resolve({ ok: false, reason: mapLocationError(err), pos: null });
      }
    });
  }

  async function getSmartLocation(maxReads = 7, desiredAccuracy = 100) {
    const readings = [];
    let lastReason = "NO_READING";

    for (let i = 0; i < maxReads; i++) {
      const result = await getCurrentPositionOnce();

      if (result && result.ok && result.pos && result.pos.coords) {
        const acc =
          typeof result.pos.coords.accuracy === "number" &&
          !Number.isNaN(result.pos.coords.accuracy)
            ? result.pos.coords.accuracy
            : null;

        readings.push({ pos: result.pos, accuracy: acc });

        if (acc !== null && acc <= desiredAccuracy) {
          return {
            ok: true,
            reason: null,
            pos: result.pos,
            accuracyMeters: acc,
            readings
          };
        }
      } else {
        lastReason = result?.reason || lastReason;
      }

      await new Promise((r) => setTimeout(r, 1500));
    }

    if (!readings.length) {
      return {
        ok: false,
        reason: lastReason || "NO_READING",
        pos: null,
        accuracyMeters: null,
        readings: []
      };
    }

    let best = readings[0];

    for (const r of readings) {
      if (r.accuracy == null) continue;
      if (best.accuracy == null || r.accuracy < best.accuracy) best = r;
    }

    return {
      ok: false,
      reason: "ACCURACY_TOO_POOR",
      pos: best.pos || null,
      accuracyMeters:
        best.accuracy != null && !Number.isNaN(best.accuracy) ? best.accuracy : null,
      readings
    };
  }

  async function getLocationForSession() {
    const best = await getSmartLocation(7, 100);

    if (best.ok && best.pos && best.pos.coords) {
      return {
        ok: true,
        reason: null,
        lat: best.pos.coords.latitude,
        lng: best.pos.coords.longitude,
        accuracyMeters:
          best.accuracyMeters != null ? best.accuracyMeters : best.pos.coords.accuracy
      };
    }

    return {
      ok: false,
      reason: best.reason || "NO_READING",
      lat: null,
      lng: null,
      accuracyMeters: best.accuracyMeters ?? null
    };
  }

  async function runAttendanceWarmupOnce() {
    try {
      if (typeof supabase === "undefined") return;

      const { data: userData, error: userError } = await supabase.auth.getUser();
      if (userError || !userData?.user) return;

      const user = userData.user;
      const deviceId = getDeviceIdForWarmup();

      const warm = await getSmartLocation(10, 120);
      if (!warm.ok || !warm.pos || !warm.pos.coords) return;

      const { latitude, longitude } = warm.pos.coords;
      const accuracyMeters =
        warm.accuracyMeters != null ? warm.accuracyMeters : warm.pos.coords.accuracy;

      if (accuracyMeters == null) return;

      await supabase.from("attendance_warmup_attendance").insert([
        {
          lecturer_id: user.id,
          device_id: deviceId,
          lat: latitude,
          lng: longitude,
          accuracy_m: accuracyMeters
        }
      ]);
    } catch (e) {
      console.warn("[attendance] warmup insert failed:", e);
    }
  }

  async function fetchBestWarmupLocation(userId, deviceId) {
    if (typeof supabase === "undefined" || !userId) {
      return { ok: false, reason: "NO_READING", source: "warmup", data: null };
    }

    const threeMinutesAgo = new Date(Date.now() - 3 * 60 * 1000).toISOString();
    const candidates = [];

    try {
      const queryMain = supabase
        .from("attendance_warmup_main")
        .select("lat, lng, accuracy_m, created_at")
        .eq("lecturer_id", userId)
        .gte("created_at", threeMinutesAgo)
        .order("accuracy_m", { ascending: true })
        .limit(1);

      const queryAtt = supabase
        .from("attendance_warmup_attendance")
        .select("lat, lng, accuracy_m, created_at")
        .eq("lecturer_id", userId)
        .gte("created_at", threeMinutesAgo)
        .order("accuracy_m", { ascending: true })
        .limit(1);

      const [mainRes, attRes] = await Promise.all([queryMain, queryAtt]);

      if (mainRes?.data?.[0]) candidates.push(mainRes.data[0]);
      if (attRes?.data?.[0]) candidates.push(attRes.data[0]);
    } catch (e) {
      console.warn("[attendance] fetchBestWarmupLocation failed:", e);
    }

    if (!candidates.length) {
      return { ok: false, reason: "NO_READING", source: "warmup", data: null };
    }

    let bestRow = null;

    for (const row of candidates) {
      const acc = typeof row.accuracy_m === "number" ? row.accuracy_m : null;
      if (acc == null) continue;
      if (!bestRow || acc < bestRow.accuracy_m) bestRow = row;
    }

    if (!bestRow) {
      return { ok: false, reason: "NO_READING", source: "warmup", data: null };
    }

    return {
      ok: true,
      reason: null,
      source: "warmup",
      data: {
        lat: bestRow.lat,
        lng: bestRow.lng,
        accuracyMeters: bestRow.accuracy_m
      }
    };
  }

  function pickBestLocationCandidate(candidates, maxAllowedAccMeters) {
    const maxAcc = typeof maxAllowedAccMeters === "number" ? maxAllowedAccMeters : 300;

    const valid = (candidates || []).filter(
      (c) =>
        c &&
        typeof c.lat === "number" &&
        typeof c.lng === "number" &&
        typeof c.accuracyMeters === "number" &&
        !Number.isNaN(c.accuracyMeters) &&
        c.accuracyMeters <= maxAcc
    );

    if (!valid.length) return null;

    let best = valid[0];

    for (const c of valid) {
      if (c.accuracyMeters < best.accuracyMeters) best = c;
    }

    return best;
  }

