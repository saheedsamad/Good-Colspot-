  async function startSession() {
    clearMessages();
    lastAttendanceLocationReason = null;

    if (!selectedClass) {
      showError("Please select a class first.", "Class required");
      return;
    }

    const pinInput = document.getElementById("pinInput");
    const timerRange = document.getElementById("timerRange");
    const btn = document.getElementById("btnStartSession");
    const useLocation = !!document.getElementById("useLocationToggle")?.checked;

    const pin = (pinInput?.value || "").trim();

    if (!pin) {
      showError("Please enter a PIN before starting session.", "PIN required");
      return;
    }

    if (pin.length < 4) {
      showError("Please enter a valid PIN with at least 4 digits.", "Invalid PIN");
      return;
    }

    if (typeof isBrowserOffline === "function" && isBrowserOffline()) {
      showError("No internet connection. Please check your network and try again.", "No internet");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Starting…";

    try {
      if (typeof supabase === "undefined") {
        showError("We couldn’t connect to the server. Please close and reopen Colspot.", "Server issue");
        return;
      }

      const { data: userData, error: userError } = await supabase.auth.getUser();

      if (userError || !userData?.user) {
        showError("Your session has expired. Please sign in again.", "Session expired");
        return;
      }

      const user = userData.user;
      const lecturerName = getDisplayName(user);
      const courseTitle = (selectedClass.title || "").trim() || null;
      const academicSession = (selectedClass.academicSession || "").trim() || null;
      const deviceId = getDeviceIdForWarmup();

      const accountInfo = await getCurrentUserRoleAndSchool(user);
      const schoolName = normalizeSchoolName(accountInfo.schoolName || "");

      if (!schoolName) {
        showError("We couldn’t load your school information.", "School missing");
        return;
      }

      const minutes = parseInt(timerRange?.value || "10", 10);
      const now = new Date();
      const expiresAt = new Date(now.getTime() + minutes * 60000);

      let lat = null;
      let lng = null;
      let creatorAccuracy = null;

      if (useLocation) {
        const platform = getPlatformForLocation();
        const maxAccMeters = platform === "ios" ? 1000 : 300;

        const [warmupBest, liveLoc] = await Promise.all([
          fetchBestWarmupLocation(user.id, deviceId),
          getLocationForSession()
        ]);

        const candidates = [];

        if (warmupBest.ok && warmupBest.data) {
          candidates.push(warmupBest.data);
        }

        if (liveLoc.ok) {
          candidates.push({
            lat: liveLoc.lat,
            lng: liveLoc.lng,
            accuracyMeters: liveLoc.accuracyMeters
          });
        }

        const finalLoc = pickBestLocationCandidate(candidates, maxAccMeters);

        if (!finalLoc) {
          let reason = "NO_READING";

          if (!warmupBest.ok && !liveLoc.ok) {
            reason = liveLoc.reason || warmupBest.reason || "NO_READING";
          } else if (warmupBest.ok && !liveLoc.ok) {
            if (
              warmupBest.data &&
              typeof warmupBest.data.accuracyMeters === "number" &&
              warmupBest.data.accuracyMeters > maxAccMeters
            ) {
              reason = "WARMUP_ONLY_BAD";
            } else {
              reason = liveLoc.reason || "NO_READING";
            }
          } else if (!warmupBest.ok && liveLoc.ok) {
            if (
              typeof liveLoc.accuracyMeters === "number" &&
              liveLoc.accuracyMeters > maxAccMeters
            ) {
              reason = "LIVE_ONLY_BAD";
            } else {
              reason = "NO_READING";
            }
          } else {
            reason = "ACCURACY_TOO_POOR";
          }

          lastAttendanceLocationReason = reason;

          const friendlyMessage = buildLocationFailureMessage(reason, platform);
          const friendlyTitle = getLocationPopupTitle(reason);

          showError(friendlyMessage, friendlyTitle);
          return;
        }

        lat = finalLoc.lat;
        lng = finalLoc.lng;
        creatorAccuracy = finalLoc.accuracyMeters;
      }

      const insertRow = {
        created_by: user.id,
        course_code: selectedClass.code,
        course_title: courseTitle,
        academic_session: academicSession,
        lecturer_name: lecturerName,
        school_name: schoolName,
        pin_code: pin,
        starts_at: now.toISOString(),
        expires_at: expiresAt.toISOString(),
        is_active: true,
        use_location: useLocation
      };

      if (useLocation) {
        insertRow.latitude = lat;
        insertRow.longitude = lng;
        insertRow.radius_meters = 400;
        insertRow.creator_accuracy_meters = creatorAccuracy;
      } else {
        insertRow.latitude = null;
        insertRow.longitude = null;
        insertRow.radius_meters = null;
        insertRow.creator_accuracy_meters = null;
      }

      const { data, error } = await supabase
        .from("attendance_sessions")
        .insert([insertRow])
        .select()
        .single();

      if (error) {
        if (
          error.code === "23505" ||
          (error.message || "").includes("attendance_sessions_unique_active_per_creator")
        ) {
          showError(
            "You already have a live attendance for this course code. End it first before starting another one.",
            "Live session already exists"
          );
        } else {
          showError(
            "We couldn’t start this session. Please check your network and try again.",
            "Could not start session"
          );
        }

        return;
      }

      if (data && data.id) {
        localStorage.setItem("colspot_last_session_id", data.id);
        localStorage.setItem("colspot_active_session_id", data.id);
        sessionStorage.setItem("colspot_live_session_id", data.id);

        resetAttendanceFormState();

        const openedInnerScreen = openLiveSessionInnerScreen(data);

        if (openedInnerScreen) {
          return;
        }

        showSuccess("Attendance session started. Open Live Attendance from your dashboard.");
        return;
      }

      showSuccess("Attendance session started.");
    } catch (e) {
      console.error(e);
      showError(
        "Something went wrong. Please check your internet and try again.",
        "Something went wrong"
      );
    } finally {
      btn.disabled = false;
      btn.textContent = "Start session";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderRecent();
    syncClassesFromSupabase();
    runAttendanceWarmupOnce();

    const btnShowNewClass = document.getElementById("btnShowNewClass");

    if (btnShowNewClass) {
      btnShowNewClass.addEventListener("click", () => {
        window.location.href = "create_class.html";
      });
    }

    const searchClass = document.getElementById("searchClass");

    if (searchClass) {
      searchClass.addEventListener("input", (e) => {
        renderRecent(e.target.value);
      });
    }

    const timerRange = document.getElementById("timerRange");

    if (timerRange) {
      timerRange.addEventListener("input", (e) => {
        const minutes = e.target.value;
        const label = document.getElementById("timerLabel");

        if (label) {
          label.textContent = `Expires in ${minutes} minute${minutes === "1" ? "" : "s"}`;
        }
      });
    }

    const useLocationToggle = document.getElementById("useLocationToggle");

    if (useLocationToggle) {
      useLocationToggle.addEventListener("change", updateAttendanceLocationUI);
      updateAttendanceLocationUI();
    }

    const popupBtn = document.getElementById("attendanceErrorPopupBtn");

    if (popupBtn) {
      popupBtn.addEventListener("click", closeAttendanceErrorPopup);
    }

    const popupWrap = document.getElementById("attendanceErrorPopup");

    if (popupWrap) {
      popupWrap.addEventListener("click", (e) => {
        if (e.target === popupWrap) closeAttendanceErrorPopup();
      });
    }

    const btnStartSession = document.getElementById("btnStartSession");

    if (btnStartSession) {
      btnStartSession.addEventListener("click", startSession);
    }

    resetAttendanceFormState();
  });
</script>
</div>
<!-- 🔹 LIVE SESSION SCREEN END -->
