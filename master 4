  function canChangeAfter30Days(lastUpdated) {
    if (!lastUpdated) return { allowed: true, remainingDays: 0, nextDateStr: "" };

    const last = new Date(lastUpdated);
    const now = new Date();
    const diffMs = now.getTime() - last.getTime();
    const diffDays = diffMs / (1000 * 60 * 60 * 24);

    if (diffDays >= 30) {
      return { allowed: true, remainingDays: 0, nextDateStr: "" };
    }

    const remainingDays = Math.ceil(30 - diffDays);
    const nextDate = new Date(last.getTime() + 30 * 24 * 60 * 60 * 1000);
    const nextDateStr = nextDate.toLocaleDateString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric"
    });

    return { allowed: false, remainingDays, nextDateStr };
  }

