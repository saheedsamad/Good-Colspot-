        loadHistoryUnreadBadge();
      }
    } catch (e) {
      console.warn("online handler failed, doing soft reload instead:", e);
      loadMiniHistory();
      initNearbyAttendance();
      initScanQuotaUI();
      loadAnnouncements();
      applyUpdateRuleFromLocal();
      loadHistoryUnreadBadge();
    }
  });

  function getCachedAuthFromLocalUser() {
    try {
      const raw = localStorage.getItem(LOCAL_USER_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.id) return null;

      if (parsed.last_seen) {
        const t = new Date(parsed.last_seen).getTime();
        if (!Number.isNaN(t)) {
          const age = Date.now() - t;
          if (age > LOCAL_USER_TTL_MS) {
            localStorage.removeItem(LOCAL_USER_KEY);
            return null;
          }
        }
      }

      return {
        user_id: parsed.id,
        email: parsed.email || "",
        full_name: parsed.email || ""
      };
    } catch (e) {
      console.error("Could not read local cached user:", e);
      return null;
    }
  }

