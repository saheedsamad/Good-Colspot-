</div>

<script>
  if (typeof STUDENT_HISTORY_KEY === "undefined") {
    var STUDENT_HISTORY_KEY = "colspot_student_history";
  }

  const HISTORY_REFRESH_INTERVAL_MS = 10000;

  let studentHistoryEntries = [];
  let fullHistoryClasses = [];
  let attendanceSessionHistoryItems = [];
  let scanHistoryItems = [];
  let schoolAnnouncementItems = [];
  let reportHistoryItems = [];
  let formHistoryItems = [];
  let activityHistoryItems = [];
  let combinedHistoryItems = [];
  let combinedHistoryFiltered = [];

  function showFullHistoryError(msg) {
    const box = document.getElementById("fullHistoryError");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function setFullHistoryStats(text) {
    const el = document.getElementById("fullStatsText");
    if (el) el.textContent = text;
  }

  function formatHistoryDateShort(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleDateString([], {
      year: "numeric",
      month: "short",
      day: "2-digit",
    });
  }

  function formatHistoryTimeShort(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function isHistoryOffline() {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isBrowserOffline === "function"
      ) {
        return ColspotGuard.isBrowserOffline();
      }
    } catch (e) {}
    try {
      return typeof navigator !== "undefined" && navigator.onLine === false;
    } catch {
      return false;
    }
  }

  function isLikelyOfflineErrorHistory(err) {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isLikelyOfflineError === "function"
      ) {
        if (ColspotGuard.isLikelyOfflineError(err)) return true;
      }
    } catch (e) {}
    return isHistoryOffline();
  }

  const SCAN_BUCKET = "colspot-scan-uploads-saheed";
  const SCAN_REGION = "eu-west-1";

  function buildScanDownloadUrl(scanRow) {
    if (scanRow.download_url) return scanRow.download_url;
    if (scanRow.result_json && scanRow.result_json.download_url) {
      return scanRow.result_json.download_url;
    }
    if (!scanRow.s3_object_key) return null;
    return (
      "https://" +
      SCAN_BUCKET +
      ".s3." +
      SCAN_REGION +
      ".amazonaws.com/" +
      encodeURIComponent(scanRow.s3_object_key)
    );
  }

  async function openScanDownload(url, filename) {
    if (!url) return;

    const isNative =
      !!window.Capacitor && !!window.Capacitor.isNativePlatform;
    const hasBrowserPlugin =
      !!window.Capacitor &&
      !!window.Capacitor.Plugins &&
      !!window.Capacitor.Plugins.Browser;

    try {
      if (isNative && hasBrowserPlugin) {
        await window.Capacitor.Plugins.Browser.open({ url });
      } else {
        const a = document.createElement("a");
        a.href = url;
        a.target = "_blank";
        a.rel = "noopener";
        if (filename) a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }
    } catch (err) {
      console.error("openScanDownload error:", err);
      window.open(url, "_blank");
    }
  }

  function loadStudentHistoryFromCache() {
    studentHistoryEntries = [];
    try {
      const raw = localStorage.getItem(STUDENT_HISTORY_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          studentHistoryEntries = parsed;
        }
      }
    } catch (e) {
      console.error("Failed to parse student history cache:", e);
    }
  }

  function openAnnouncementMessage(announcement) {
    window.location.href =
      "view_message.html?announcement_id=" +
      encodeURIComponent(announcement?.id || "");
  }

  function openFillFormPage(type, id) {
    window.location.href =
      `fill_form.html?type=${encodeURIComponent(type)}&id=${encodeURIComponent(id || "")}`;
  }

  async function loadSchoolAnnouncementsForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    let schoolName = "";

    try {
      const { data: studentRow, error: studentErr } = await supabase
        .from("student_accounts")
        .select("school_name")
        .eq("user_id", user.id)
        .maybeSingle();

      if (!studentErr && studentRow?.school_name) {
        schoolName = studentRow.school_name;
      }

      if (!schoolName) {
        const { data: lecturerRow, error: lecturerErr } = await supabase
          .from("lecturer_accounts")
          .select("school_name")
          .eq("user_id", user.id)
          .maybeSingle();

        if (!lecturerErr && lecturerRow?.school_name) {
          schoolName = lecturerRow.school_name;
        }
      }

      if (!schoolName) return [];

      const { data, error } = await supabase
        .from("school_announcements")
        .select("id, school_name, title, body, notification_title, notification_body, created_at")
        .ilike("school_name", schoolName)
        .order("created_at", { ascending: false })
        .limit(50);

      if (error) {
        console.error("Announcement history load error:", error);
        return [];
      }

      return (data || []).map((item) => ({
        id: item.id,
        school_name: item.school_name || "",
        title: item.notification_title || item.title || "School announcement",
        message: item.notification_body || item.body || "",
        body: item.body || "",
        created_at: item.created_at || null
      }));
    } catch (e) {
      console.error("loadSchoolAnnouncementsForHistory error:", e);
      return [];
    }
  }

  async function loadFormHistoryForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    try {
      const { data: notifications, error: notifError } = await supabase
        .from("form_notifications")
        .select("id, form_id, title, message, created_at")
        .eq("user_id", user.id)
        .order("created_at", { ascending: false });

      if (notifError) {
        console.error("Form history notifications error:", notifError);
        return [];
      }

      if (!notifications || !notifications.length) return [];

      const formIds = [...new Set(notifications.map((x) => x.form_id).filter(Boolean))];

      const { data: forms, error: formsError } = await supabase
        .from("forms")
        .select("id, title, description, close_at, created_at")
        .in("id", formIds);

      if (formsError) {
        console.error("Form history forms error:", formsError);
        return [];
      }

      const { data: responses, error: respError } = await supabase
        .from("form_responses")
        .select("id, form_id, submitted_at, status")
        .eq("submitted_by", user.id)
        .in("form_id", formIds);

      if (respError) {
        console.error("Form history responses error:", respError);
        return [];
      }

      const formMap = {};
      (forms || []).forEach((f) => {
        formMap[f.id] = f;
      });

      const responseMap = {};
      (responses || []).forEach((r) => {
        if (!responseMap[r.form_id]) responseMap[r.form_id] = r;
      });

      return notifications
        .map((n) => {
          const form = formMap[n.form_id];
          if (!form) return null;

          const response = responseMap[form.id] || null;
          const status = response?.submitted_at ? "submitted" : "pending";

          return {
            id: form.id,
            notification_id: n.id,
            title: form.title || n.title || "Form",
            sub_title: n.message || form.description || "School form",
            created_at: n.created_at || form.created_at || null,
            status,
            response_id: response?.id || null,
            submitted_at: response?.submitted_at || null
          };
        })
        .filter(Boolean);
    } catch (e) {
      console.error("loadFormHistoryForHistory error:", e);
      return [];
    }
  }

  async function loadReportHistoryForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    try {
      const { data, error } = await supabase.functions.invoke("get-my-school-reports", {
        body: {
          submitted_by_user_id: user.id
        }
      });

      if (error) {
        console.error("Report history function error:", error);
        return [];
      }

      if (!data?.ok) {
        console.error("Report history data error:", data?.error);
        return [];
      }

      return Array.isArray(data.reports) ? data.reports : [];
    } catch (e) {
      console.error("loadReportHistoryForHistory error:", e);
      return [];
    }
  }

  async function loadAttendanceSessionsForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select(`
          id,
          course_code,
          course_title,
          lecturer_name,
          pin_code,
          starts_at,
          expires_at,
          created_at,
          is_active,
          use_location
        `)
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(100);

      if (error) {
        console.error("Attendance session history load error:", error);
        return [];
      }

      if (!data || !data.length) return [];

      const sessionIds = data.map((row) => row.id);

      let countMap = {};
      const { data: attendanceRows, error: countError } = await supabase
        .from("attendance_records")
        .select("session_id")
        .in("session_id", sessionIds);

      if (!countError && attendanceRows) {
        attendanceRows.forEach((row) => {
          countMap[row.session_id] = (countMap[row.session_id] || 0) + 1;
        });
      }

      return data.map((row) => ({
        ...row,
        joined_count: countMap[row.id] || 0
      }));
    } catch (e) {
      console.error("loadAttendanceSessionsForHistory error:", e);
      return [];
    }
  }

  async function loadActivityHistoryForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    try {
      const { data: memberships, error: memError } = await supabase
        .from("course_memberships")
        .select("course_id")
        .eq("user_id", user.id);

      if (memError) {
        console.error("Revision history memberships error:", memError);
        return [];
      }

      const classIds = [...new Set((memberships || []).map((m) => m.course_id).filter(Boolean))];
      if (!classIds.length) return [];

      const { data: activities, error: activityError } = await supabase
        .from("class_activities")
        .select(`
          id,
          class_id,
          activity_type,
          title,
          instruction,
          due_at,
          time_limit_minutes,
          attempts_allowed,
          is_published,
          status,
          created_at
        `)
        .in("class_id", classIds)
        .eq("is_published", true)
        .eq("status", "published")
        .order("created_at", { ascending: false })
        .limit(100);

      if (activityError) {
        console.error("Revision history load error:", activityError);
        return [];
      }

      if (!activities || !activities.length) return [];

      const activityIds = activities.map((a) => a.id).filter(Boolean);

      let coursesMap = {};
      const { data: courses, error: courseError } = await supabase
        .from("courses")
        .select("id, course_code, course_title")
        .in("id", classIds);

      if (courseError) {
        console.error("Revision history courses load error:", courseError);
      } else {
        (courses || []).forEach((c) => {
          coursesMap[c.id] = c;
        });
      }

      let attemptsMap = {};
      const { data: attempts, error: attemptsError } = await supabase
        .from("class_activity_attempts")
        .select("id, activity_id, submitted_at, status")
        .eq("user_id", user.id)
        .in("activity_id", activityIds);

      if (attemptsError) {
        console.error("Revision history attempts load error:", attemptsError);
      } else {
        (attempts || []).forEach((row) => {
          if (!attemptsMap[row.activity_id]) attemptsMap[row.activity_id] = row;
        });
      }

      return activities.map((activity) => {
        const course = coursesMap[activity.class_id] || {};
        const attempt = attemptsMap[activity.id] || null;
        const historyStatus =
          attempt?.submitted_at || attempt?.status === "submitted"
            ? "submitted"
            : "pending";

        return {
          ...activity,
          course_code: course.course_code || "Class",
          course_title: course.course_title || "",
          history_status: historyStatus,
          attempt_id: attempt?.id || null
        };
      });
    } catch (e) {
      console.error("loadActivityHistoryForHistory error:", e);
      return [];
    }
  }

  function rebuildCombinedHistory() {
    combinedHistoryItems = [];

    studentHistoryEntries.forEach((entry) => {
      combinedHistoryItems.push({
        type: "student",
        created_at: entry.attended_at || entry.created_at || null,
        entry,
      });
    });

    fullHistoryClasses.forEach((item) => {
      combinedHistoryItems.push({
        type: "class",
        created_at: item.course.created_at || null,
        course: item.course,
        memberCount: item.memberCount,
      });
    });

    attendanceSessionHistoryItems.forEach((session) => {
      combinedHistoryItems.push({
        type: "attendance_session",
        created_at: session.created_at || session.starts_at || null,
        session
      });
    });

    formHistoryItems.forEach((form) => {
      combinedHistoryItems.push({
        type: "form",
        created_at: form.created_at || null,
        form
      });
    });

    activityHistoryItems.forEach((activity) => {
      combinedHistoryItems.push({
        type: "activity",
        created_at: activity.created_at || null,
        activity
      });
    });

    scanHistoryItems.forEach((scan) => {
      combinedHistoryItems.push({
        type: "scan",
        created_at: scan.created_at,
        scan,
      });
    });

    schoolAnnouncementItems.forEach((announcement) => {
      combinedHistoryItems.push({
        type: "announcement",
        created_at: announcement.created_at || null,
        announcement,
      });
    });

    reportHistoryItems.forEach((report) => {
      combinedHistoryItems.push({
        type: "report",
        created_at: report.created_at || null,
        report,
      });
    });

    combinedHistoryItems.sort((a, b) => {
      const da = a.created_at ? new Date(a.created_at).getTime() : 0;
      const db = b.created_at ? new Date(b.created_at).getTime() : 0;
      return db - da;
    });

    applyFullHistorySearchFilter();
  }

  function openStudentHistoryDetail(entry) {
    const modal = document.getElementById("studentHistoryModal");
    if (!modal) return;

    const courseHeading = document.getElementById("shCourseHeading");
    const courseLine = document.getElementById("shCourseLine");
    const lecturerLine = document.getElementById("shLecturerLine");
    const statusLine = document.getElementById("shStatusLine");
    const timeLine = document.getElementById("shTimeLine");
    const pinLine = document.getElementById("shPinLine");
    const nameLine = document.getElementById("shNameLine");
    const matricLine = document.getElementById("shMatricLine");
    const deptLine = document.getElementById("shDeptLine");

    if (courseHeading)
      courseHeading.textContent =
        entry.course_code || "Attendance details";

    if (courseLine) courseLine.textContent = entry.course_code || "—";
    if (lecturerLine)
      lecturerLine.textContent = entry.lecturer_name || "—";
    if (statusLine) statusLine.textContent = entry.status || "Present";

    const datePart = formatHistoryDateShort(entry.attended_at);
    const timePart = formatHistoryTimeShort(entry.attended_at);
    if (timeLine)
      timeLine.textContent =
        datePart && timePart ? `${datePart} · ${timePart}` : datePart || "";

    if (pinLine) pinLine.textContent = entry.pin_used || "—";
    if (nameLine) nameLine.textContent = entry.student_name || "—";
    if (matricLine) matricLine.textContent = entry.student_matric || "—";
    if (deptLine) deptLine.textContent = entry.student_department || "—";

    modal.classList.add("active");
  }

  function closeStudentHistoryModal() {
    const modal = document.getElementById("studentHistoryModal");
    if (modal) modal.classList.remove("active");
  }

  async function loadFullHistory(options = {}) {
    const silent = options.silent === true;
    const listEl = document.getElementById("fullHistoryList");
    const emptyEl = document.getElementById("fullHistoryEmpty");
    if (!listEl || !emptyEl) return;

    if (loadFullHistory._loading) return;
    loadFullHistory._loading = true;

    const previousScrollY = window.scrollY;

    try {
      if (!silent) {
        showFullHistoryError("");
        setFullHistoryStats("Loading history...");
        listEl.innerHTML = "";
        emptyEl.style.display = "none";
      } else {
        showFullHistoryError("");
      }

      if (typeof supabase === "undefined") {
        if (!silent) {
          showFullHistoryError("Backend not available. Please reload later.");
          setFullHistoryStats("Error loading history.");
        }
        return;
      }

      let user = null;
      try {
        const { data, error } = await supabase.auth.getUser();

        if (error || !data || !data.user) {
          const offline = isLikelyOfflineErrorHistory(error);
          if (!silent) {
            if (offline) {
              showFullHistoryError(
                "No internet connection or bad network. We’ll refresh automatically when you reconnect."
              );
            } else {
              showFullHistoryError(
                "Could not verify your account right now. Please try again or sign in again from the main screen."
              );
            }
            setFullHistoryStats("0 items");
          }
          return;
        }
        user = data.user;
      } catch (e) {
        console.error(e);
        const offline = isLikelyOfflineErrorHistory(e);
        if (!silent) {
          if (offline) {
            showFullHistoryError(
              "No internet connection or bad network. We’ll refresh automatically when you reconnect."
            );
          } else {
            showFullHistoryError(
              "Could not check your account right now. Please try again or sign in again from the main screen."
            );
          }
          setFullHistoryStats("0 items");
        }
        return;
      }

      try {
        const { data: classes, error: classError } = await supabase
          .from("courses")
          .select(`
            id,
            course_code,
            course_title,
            creator_name,
            invite_code,
            academic_session,
            created_at,
            allowed_departments,
            allowed_levels,
            allowed_department_levels
          `)
          .eq("created_by", user.id)
          .order("created_at", { ascending: false });

        if (classError) {
          console.error(classError);
          if (!silent) {
            showFullHistoryError("Could not load class history. Please try again.");
          }
          fullHistoryClasses = [];
        } else if (!classes || classes.length === 0) {
          fullHistoryClasses = [];
        } else {
          const classIds = classes.map((c) => c.id);

          const { data: memberships, error: memError } = await supabase
            .from("course_memberships")
            .select("course_id")
            .in("course_id", classIds);

          if (memError && !silent) {
            console.error(memError);
            showFullHistoryError(
              "Could not load joined students count. Please try again."
            );
          }

          const countMap = {};
          (memberships || []).forEach((row) => {
            countMap[row.course_id] = (countMap[row.course_id] || 0) + 1;
          });

          fullHistoryClasses = classes.map((course) => ({
            course,
            memberCount: countMap[course.id] || 0
          }));
        }
      } catch (e) {
        console.error(e);
        if (!silent) {
          showFullHistoryError("Unexpected error while loading class history.");
        }
        fullHistoryClasses = [];
      }

      attendanceSessionHistoryItems = await loadAttendanceSessionsForHistory(user);
      formHistoryItems = await loadFormHistoryForHistory(user);
      activityHistoryItems = await loadActivityHistoryForHistory(user);

      try {
        const { data: scans, error: scansError } = await supabase
          .from("scan_sheets")
          .select("id, title, created_at, status, s3_object_key, result_json")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false })
          .limit(50);

        if (scansError) {
          console.error(scansError);
          scanHistoryItems = [];
        } else {
          scanHistoryItems = scans || [];
        }
      } catch (e) {
        console.error(e);
        scanHistoryItems = [];
      }

      schoolAnnouncementItems = await loadSchoolAnnouncementsForHistory(user);
      reportHistoryItems = await loadReportHistoryForHistory(user);

      rebuildCombinedHistory();
      updateFullHistoryStatsSummary();

      const emptyElVisible = !combinedHistoryFiltered.length;
      if (emptyElVisible) {
        emptyEl.style.display = "block";
        listEl.innerHTML = "";
      } else {
        emptyEl.style.display = "none";
        renderFullHistoryList();
        if (silent) {
          window.scrollTo(0, previousScrollY);
        }
      }
    } finally {
      loadFullHistory._loading = false;
    }
  }

  function updateFullHistoryStatsSummary() {
    const totalItems = combinedHistoryItems.length;
    const totalClasses = fullHistoryClasses.length;
    const totalSessions = attendanceSessionHistoryItems.length;
    const totalForms = formHistoryItems.length;
    const totalRevisions = activityHistoryItems.length;
