  async function loadAccountDevices() {
    const list = document.getElementById("devicesList");
    const statusEl = document.getElementById("devicesStatus");
    const badge = document.getElementById("devicesCountBadge");

    if (!accountCurrentUser || !list || !statusEl || !badge) return;

    list.innerHTML = "";
    statusEl.textContent = "Loading devices...";

    const currentDeviceId = getAccountStoredDeviceId();

    try {
      const { data, error } = await supabase
        .from("user_devices")
        .select("id, device_id, created_at")
        .eq("user_id", accountCurrentUser.id)
        .order("created_at", { ascending: true });

      if (error) {
        console.error("loadDevices error:", error);
        statusEl.textContent = "Could not load your devices. Please pull to refresh later.";
        return;
      }

      const devices = data || [];
      badge.textContent = `${devices.length} / 2`;

      if (devices.length === 0) {
        statusEl.textContent =
          "No devices linked yet. When you sign in on a phone, it will appear here.";
        return;
      }

      statusEl.textContent = "";

      devices.forEach((row) => {
        const rowDeviceId = String(row.device_id || "").trim();
        const localDeviceId = String(currentDeviceId || "").trim();
        const isThis = !!localDeviceId && rowDeviceId === localDeviceId;

        const deviceRow = document.createElement("div");
        deviceRow.className = "device-row";

        const main = document.createElement("div");
        main.className = "device-main";

        const icon = document.createElement("div");
        icon.className = "device-icon";
        icon.innerHTML = `
          <svg viewBox="0 0 24 24">
            <rect x="7" y="3" width="10" height="18" rx="2"></rect>
            <circle cx="12" cy="17" r="1"></circle>
          </svg>
        `;

        const text = document.createElement("div");
        text.className = "device-text";

        const nameEl = document.createElement("div");
        nameEl.className = "device-name";
        nameEl.textContent = isThis ? "This phone" : "Other device";

        const metaEl = document.createElement("div");
        metaEl.className = "device-meta";
        const created = row.created_at
          ? new Date(row.created_at).toLocaleString()
          : "";
        metaEl.textContent = created ? `Linked on ${created}` : "Linked device";

        const tags = document.createElement("div");
        tags.className = "device-tags";

        const primaryPill = document.createElement("span");
        primaryPill.className = "device-pill primary";
        primaryPill.textContent = isThis ? "Active here" : "Signed in";
        tags.appendChild(primaryPill);

        if (!isThis) {
          const warnPill = document.createElement("span");
          warnPill.className = "device-pill";
          warnPill.textContent = "You can remove this";
          tags.appendChild(warnPill);
        }

        text.appendChild(nameEl);
        text.appendChild(metaEl);
        text.appendChild(tags);

        main.appendChild(icon);
        main.appendChild(text);
        deviceRow.appendChild(main);

        if (!isThis) {
          const removeBtn = document.createElement("button");
          removeBtn.className = "device-remove-btn";
          removeBtn.textContent = "Remove";
          removeBtn.onclick = () => removeAccountDevice(row.id);
          deviceRow.appendChild(removeBtn);
        }

        list.appendChild(deviceRow);
      });
    } catch (e) {
      console.error("loadDevices error:", e);
      statusEl.textContent = "Could not load your devices. Please try again later.";
    }
  }

