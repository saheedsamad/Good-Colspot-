      <div class="student-history-summary">
        <div class="sh-row">
          <div class="sh-label">Course</div>
          <div id="shCourseLine" class="sh-value"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">Lecturer</div>
          <div id="shLecturerLine" class="sh-value"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">Status</div>
          <div id="shStatusLine" class="sh-value status"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">Time</div>
          <div id="shTimeLine" class="sh-value"></div>
        </div>
        <div class="sh-row">
          <div class="sh-label">PIN used</div>
          <div id="shPinLine" class="sh-value"></div>
        </div>
