  async function ensureCurrentUser() {
    if (currentUser) return currentUser;
    if (typeof supabase === "undefined") return null;

    try {
      const { data, error } = await supabase.auth.getUser();
      if (error || !data || !data.user) {
        scheduleOfflineRetry();
        return null;
      }
      currentUser = data.user;
      saveLocalUserFromSupabaseUser(currentUser);
      return currentUser;
    } catch (e) {
      console.error("ensureCurrentUser failed:", e);
      scheduleOfflineRetry();
      return null;
    }
  }

  async function loadMiniHistory() {
    const listEl = document.getElementById("historyList");
    if (!listEl) return;

    listEl.innerHTML =
      '<div class="history-empty">Loading your recent sessions...</div>';

    if (typeof supabase === "undefined") {
      listEl.innerHTML =
        '<div class="history-empty">We’re having trouble talking to the server. Please check your internet connection or close and reopen Colspot.</div>';
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (isBrowserOffline()) {
        listEl.innerHTML =
          '<div class="history-empty">No internet connection. We’ll try again automatically…</div>';
      } else {
        listEl.innerHTML =
          '<div class="history-empty">Trying to reconnect… we’ll update this automatically.</div>';
      }
      scheduleOfflineRetry();
      return;
    }

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("id, course_code, starts_at, created_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;

      const sessions = data || [];
      if (!sessions.length) {
        listEl.innerHTML =
          '<div class="history-empty">No previous sessions yet. Create one to get started.</div>';
        stopOfflineRetry();
        return;
      }

      const s = sessions[0];
      const baseDateStr = s.starts_at || s.created_at;
      const d = baseDateStr ? new Date(baseDateStr) : null;
      const timeStr = d
        ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "--:--";

      const code = s.course_code || "Attendance session";

      listEl.innerHTML = "";
      const item = document.createElement("div");
      item.className = "history-item";

      const header = document.createElement("div");
      header.className = "history-item-header";

      const course = document.createElement("div");
      course.className = "history-course";
      course.textContent = code;

      const time = document.createElement("div");
      time.className = "history-time";
      time.textContent = timeStr;

      header.appendChild(course);
      header.appendChild(time);

      const meta = document.createElement("div");
      meta.className = "history-meta";
      meta.textContent = "Last session you created";

      const track = document.createElement("div");
      track.className = "history-progress-track";

      const bar = document.createElement("div");
      bar.className = "history-progress-bar";
      track.appendChild(bar);

      item.appendChild(header);
      item.appendChild(meta);
      item.appendChild(track);

      listEl.appendChild(item);

      stopOfflineRetry();
    } catch (e) {
      console.error(e);
      listEl.innerHTML =
        '<div class="history-empty">Could not load history yet. We’ll keep trying in the background.</div>';
      scheduleOfflineRetry();
    }
  }

  function getCurrentMonthKey() {
    const d = new Date();
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, "0");
    return `${year}-${month}`;
  }

  async function loadScanQuota() {
    if (typeof supabase === "undefined") return null;
    const user = await ensureCurrentUser();
    if (!user) return null;

    currentScanUserId = user.id;
    const monthKey = getCurrentMonthKey();

    try {
      const { data, error } = await supabase
        .from("scan_sheets")
        .select("id", { count: "exact", head: false })
        .eq("user_id", user.id)
        .eq("month_key", monthKey);

      if (error) throw error;

      const used = Array.isArray(data) ? data.length : 0;
      currentScanQuota = {
        used,
        remaining: Math.max(0, SCAN_MAX_PER_MONTH - used),
        monthKey
      };
      return currentScanQuota;
    } catch (e) {
      console.error("loadScanQuota failed:", e);
      return null;
    }
  }

  function renderScanQuotaUI() {
    const quotaEls = document.querySelectorAll("[data-scan-quota]");
    if (!quotaEls.length) return;

    quotaEls.forEach((el) => {
      if (!currentScanQuota) {
        el.textContent = "Could not load monthly quota.";
        el.classList.remove("scan-quota-low", "scan-quota-zero");
        return;
      }

      el.textContent = `Monthly scans used: ${currentScanQuota.used}/${SCAN_MAX_PER_MONTH} • Remaining: ${currentScanQuota.remaining}`;

      el.classList.remove("scan-quota-low", "scan-quota-zero");

      if (currentScanQuota.remaining === 0) {
        el.classList.add("scan-quota-zero");
      } else if (currentScanQuota.remaining <= 3) {
        el.classList.add("scan-quota-low");
      }
    });
  }

  async function initScanQuotaUI() {
    await loadScanQuota();
    renderScanQuotaUI();
  }

  async function submitScanSheet() {
    const fileInput = document.getElementById("scanFileInput");
    const statusEl = document.getElementById("scanStatus");
    const btn = document.getElementById("scanSubmitBtn");
    const titleInput = document.getElementById("scanTitle");
    const outputTypeEl = document.querySelector('input[name="scanOutputType"]:checked');

    if (!fileInput || !fileInput.files || !fileInput.files[0]) {
      if (statusEl) {
        statusEl.textContent = "Please choose a file first.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    if (!currentScanQuota) {
      await initScanQuotaUI();
    }

    if (currentScanQuota && currentScanQuota.remaining <= 0) {
      if (statusEl) {
        statusEl.textContent = "You have reached your monthly scan limit.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (statusEl) {
        statusEl.textContent = "Please sign in again.";
        statusEl.className = "scan-status error";
      }
      return;
    }

    try {
      if (btn) btn.disabled = true;
      if (statusEl) {
        statusEl.textContent = "Uploading and processing your scan...";
        statusEl.className = "scan-status";
      }

      const file = fileInput.files[0];
      const outputType = outputTypeEl ? outputTypeEl.value : "excel";
      const title = (titleInput?.value || "").trim() || file.name || "Scan";

      const buffer = await file.arrayBuffer();
      const base64 = arrayBufferToBase64(buffer);

      const response = await fetch(SCAN_LAMBDA_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          user_id: user.id,
          title,
          output_type: outputType,
          filename: file.name,
          mime_type: file.type || "application/octet-stream",
          file_base64: base64
        })
      });

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error((result && result.error) || "Scan failed.");
      }

      try {
        if (typeof supabase !== "undefined") {
          await supabase.from("scan_sheets").insert({
            user_id: user.id,
            title,
            month_key: getCurrentMonthKey(),
            output_type: outputType,
            source_name: file.name
          });
        }
      } catch (logErr) {
        console.warn("scan_sheets insert failed:", logErr);
      }

      await initScanQuotaUI();

      if (statusEl) {
        statusEl.textContent = result?.message || "Scan completed successfully.";
        statusEl.className = "scan-status ok";
      }

      if (result?.download_url) {
        window.open(result.download_url, "_blank");
      }
    } catch (e) {
      console.error("submitScanSheet failed:", e);
      if (statusEl) {
        statusEl.textContent = e.message || "Could not process scan.";
        statusEl.className = "scan-status error";
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  function arrayBufferToBase64(buffer) {
    let binary = "";
    const bytes = new Uint8Array(buffer);
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      const sub = bytes.subarray(i, i + chunk);
      binary += String.fromCharCode.apply(null, sub);
    }
    return btoa(binary);
  }

  async function loadAnnouncements() {
    const section = document.getElementById("announcementSection");
    const titleEl = document.getElementById("announcementTitle");
    const msgEl = document.getElementById("announcementMessage");
    if (!section || !titleEl || !msgEl) return;

    if (typeof supabase === "undefined") {
      section.style.display = "none";
      return;
    }

    try {
      const { data, error } = await supabase
        .from("app_announcements")
        .select("id,title,message,show_until,is_active,created_at")
        .eq("is_active", true)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;
      const ann = data && data[0];

      if (!ann) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      if (ann.show_until && new Date(ann.show_until) < new Date()) {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      const dismissKey = "colspot_announcement_dismissed_" + ann.id;
      if (localStorage.getItem(dismissKey) === "1") {
        section.style.display = "none";
        stopOfflineRetry();
        return;
      }

      section.dataset.announcementId = ann.id;
      titleEl.textContent = ann.title || "Update";
      msgEl.textContent = ann.message || "";
      section.style.display = "block";

      stopOfflineRetry();
    } catch (e) {
      console.error("loadAnnouncements failed:", e);
      scheduleOfflineRetry();
    }
  }

  function dismissAnnouncement() {
    const section = document.getElementById("announcementSection");
    if (!section) return;
    const annId = section.dataset.announcementId;
    if (annId) {
      localStorage.setItem("colspot_announcement_dismissed_" + annId, "1");
    }
    section.style.display = "none";
  }

  function applyUpdateRuleFromLocal() {
    const softSection = document.getElementById("updateSoftSection");
    const softTitle = document.getElementById("updateSoftTitle");
    const softMessage = document.getElementById("updateSoftMessage");
    const hardOverlay = document.getElementById("updateHardOverlay");
    const hardTitle = document.getElementById("updateHardTitle");
    const hardMessage = document.getElementById("updateHardMessage");

    try {
      const raw = localStorage.getItem(UPDATE_RULE_LOCAL_KEY);
      currentUpdateRule = raw ? JSON.parse(raw) : null;
    } catch {
      currentUpdateRule = null;
    }

    if (!currentUpdateRule) {
      if (softSection) softSection.style.display = "none";
      if (hardOverlay) hardOverlay.style.display = "none";
      return;
    }

    const type = String(currentUpdateRule.type || "").toLowerCase();
    const title = currentUpdateRule.title || "New version available";
    const message = currentUpdateRule.message || "Please update Colspot.";

    if (type === "hard") {
      if (softSection) softSection.style.display = "none";
      if (hardTitle) hardTitle.textContent = title;
      if (hardMessage) hardMessage.textContent = message;
      if (hardOverlay) hardOverlay.style.display = "flex";
      return;
    }

    if (softTitle) softTitle.textContent = title;
    if (softMessage) softMessage.textContent = message;
    if (softSection) softSection.style.display = "block";
    if (hardOverlay) hardOverlay.style.display = "none";
  }

  function openUpdateUrlFromRule() {
    if (!currentUpdateRule || !currentUpdateRule.url) return;
    window.open(currentUpdateRule.url, "_blank");
  }

  function initNearbyAttendance() {
    const statusEl = document.getElementById("nearbyStatus");
    if (!statusEl) return;

    if (!locationEnabled) {
      statusEl.textContent =
        "Location is off. Turn it on to see nearby sessions, or use a PIN from your lecturer.";
      return;
    }

    if (isBrowserOffline()) {
      statusEl.textContent =
        "No internet connection. We’ll refresh nearby sessions when you’re back online.";
      scheduleOfflineRetry();
      return;
    }

    if (!("geolocation" in navigator)) {
      showLastSessionFallback(statusEl);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        if (typeof supabase === "undefined") {
          statusEl.textContent =
            "Location is OK but we can’t reach Colspot servers right now. Please check your internet or close and reopen the app.";
          return;
        }

        try {
          const nowIso = new Date().toISOString();

          const { data, error } = await supabase
            .from("attendance_sessions")
            .select(
              "id, course_code, expires_at, latitude, longitude, created_at"
            )
            .gte("expires_at", nowIso);

          if (error) throw error;

          const sessions = (data || []).filter(
            (s) =>
              typeof s.latitude === "number" &&
              typeof s.longitude === "number"
          );

          let nearby = sessions.filter((s) => {
            const d = distanceInMeters(lat, lng, s.latitude, s.longitude);
            return d <= NEARBY_RADIUS_METERS;
          });

          if (!nearby.length && sessions.length > 0) {
            sessions.sort((a, b) => {
              const da = distanceInMeters(lat, lng, a.latitude, a.longitude);
              const db = distanceInMeters(lat, lng, b.latitude, b.longitude);
              return da - db;
            });
            nearby = [sessions[0]];
          }

          if (!nearby.length) {
            await showLastSessionFallback(statusEl);
            return;
          }

          const s0 = nearby[0];
          const end = s0.expires_at ? new Date(s0.expires_at) : null;
          const timeStr = end
            ? end.toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })
            : "--:--";

          const code = s0.course_code || "Attendance session";
          statusEl.textContent = `Active near you: ${code} (until ${timeStr})`;

          stopOfflineRetry();
        } catch (e) {
          console.error(e);
          statusEl.textContent =
            "Error loading nearby attendance. We’ll keep trying in the background. You can still create a session.";
          scheduleOfflineRetry();
        }
      },
      async () => {
        await showLastSessionFallback(statusEl);
      },
      {
        enableHighAccuracy: false,
        maximumAge: 60000,
        timeout: 10000,
      }
    );
  }

  async function showLastSessionFallback(statusEl) {
    if (typeof supabase === "undefined") {
      statusEl.textContent =
        "We couldn’t reach the server yet. Please check your internet connection or try again in a moment.";
      return;
    }

    const user = await ensureCurrentUser();
    if (!user) {
      if (isBrowserOffline()) {
        statusEl.textContent =
          "No internet connection. We’ll try again automatically…";
      } else {
        statusEl.textContent =
          "Trying to reconnect… we’ll update this automatically.";
      }
      scheduleOfflineRetry();
      return;
    }

    try {
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("course_code, starts_at, created_at, expires_at")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;

      const s = (data || [])[0];
      if (!s) {
        statusEl.textContent =
          "No attendance sessions yet. Create one to get started.";
        stopOfflineRetry();
        return;
      }

      const baseDateStr = s.starts_at || s.expires_at || s.created_at;
      const d = baseDateStr ? new Date(baseDateStr) : null;
      const timeStr = d
        ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
        : "--:--";

      const code = s.course_code || "Attendance session";
      statusEl.textContent = `Last session you created: ${code} (at ${timeStr})`;

      stopOfflineRetry();
    } catch (e) {
      console.error(e);
      statusEl.textContent =
        "We couldn't load your recent sessions yet. We’ll keep trying. You can still create a new one.";
      scheduleOfflineRetry();
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await new Promise((r) => setTimeout(r, 50));

    lockBottomNavToScreen();

    let localAuth = null;
    try {
      if (window.ColspotGuard && typeof ColspotGuard.guardPageAccess === "function") {
        const localUser = ColspotGuard.guardPageAccess();
        if (!localUser) {
          return;
        }
        localAuth = {
          user_id: localUser.id,
          email: localUser.email || "",
          full_name: localUser.email || ""
        };
      } else {
        localAuth = getCachedAuthFromLocalUser();
        if (!localAuth) {
          window.location.href = "index.html";
          return;
        }
      }
    } catch (e) {
      console.error("guardPageAccess failed on main:", e);
      window.location.href = "index.html";
      return;
    }

    if (localAuth) {
      const localName =
        (localAuth.full_name && localAuth.full_name.trim()) ||
        (localAuth.email && localAuth.email.trim()) ||
        "";
      if (localName) {
        setGreetingFromProfile(localName);
      }
    }

    const stored = localStorage.getItem("colspotLocationEnabled");
    if (stored === "false") {
      locationEnabled = false;
    }
    updateLocationToggleUI();

    const fileInput = document.getElementById("scanFileInput");
    const chosenText = document.getElementById("scanFileChosenText");
    if (fileInput && chosenText) {
      fileInput.addEventListener("change", () => {
        if (fileInput.files && fileInput.files[0]) {
          chosenText.textContent = "Selected: " + fileInput.files[0].name;
        } else {
          chosenText.textContent = "";
        }
      });
    }

    if (window.ColspotGuard && typeof ColspotGuard.verifySupabaseSessionInBackground === "function") {
      ColspotGuard.verifySupabaseSessionInBackground();
    } else if (typeof supabase !== "undefined") {
      try {
        const { data, error } = await supabase.auth.getUser();
        if (!error && data && data.user) {
          currentUser = data.user;
          const profileName =
            (currentUser.user_metadata &&
              currentUser.user_metadata.full_name) ||
            currentUser.email ||
            currentUser.phone ||
            "";
          saveLocalUserFromSupabaseUser(currentUser);
          if (profileName) {
            setGreetingFromProfile(profileName);
          }
        }
      } catch (e) {
        console.error("Fallback getUser on main failed:", e);
      }
    }

    askForLocationOnce();
    initNearbyAttendance();
    loadMiniHistory();
    initScanQuotaUI();
    loadAnnouncements();
    applyUpdateRuleFromLocal();
    loadHistoryUnreadBadge();
    tryInitPush();
    runMainWarmupOnce();
  });

  function goHome()        { showScreen('home'); }
  function goToAttendance(){ showScreen('attendance'); }
  function goToReports()   { showScreen('reports'); }
  function goToNearby()    { showScreen('nearby'); }
  function goToHistory()   { showScreen('history'); }
  function goToAccount()   { showScreen('account'); }

  window.showScreen = showScreen;
  window.goHome = goHome;
  window.goToAttendance = goToAttendance;
  window.goToReports = goToReports;
  window.goToNearby = goToNearby;
  window.goToHistory = goToHistory;
  window.goToAccount = goToAccount;
  window.toggleLocation = toggleLocation;
  window.dismissAnnouncement = dismissAnnouncement;
  window.openUpdateUrlFromRule = openUpdateUrlFromRule;
  window.submitScanSheet = submitScanSheet;
</script>
