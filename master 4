      <circle cx="11" cy="11" r="6" stroke="#9ca3af" stroke-width="1.6" />
      <line
        x1="15.5"
        y1="15.5"
        x2="20"
        y2="20"
        stroke="#9ca3af"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </svg>
    <input
      id="fullHistorySearch"
      class="search-input"
      type="search"
      placeholder="Search title, class, form, revision or announcement"
    />
