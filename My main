<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot – Home</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #e5f0ff;
      --bg2: #f8fbff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --shadow-strong: 0 20px 55px rgba(15, 23, 42, 0.18);
      --shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.12);
      --card-border: #e7edf8;
      --error: #dc2626;
      --success: #16a34a;
    }

    * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Inter, sans-serif;
    }

    html, body {
      height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overscroll-behavior: none;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: #ffffff;
      border-radius: 0;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      padding: calc(env(safe-area-inset-top) + 8px) 14px 0;
      position: relative;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 4px 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-logo {
      height: 32px;
      width: 32px;
      border-radius: 8px;
      overflow: hidden;
      background: #eff6ff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-logo img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      display: block;
    }

    .brand-name {
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.02em;
      color: var(--text-main);
    }

    .avatar-chip {
      height: 34px;
      width: 34px;
      min-width: 34px;
      border-radius: 999px;
      background: linear-gradient(135deg, #1d4ed8, #22c55e);
      color: #f9fafb;
      font-size: 14px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
      position: relative;
      overflow: hidden;
      padding: 0;
    }

    .avatar-chip img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: none;
      z-index: 2;
    }

    .avatar-chip span {
      position: relative;
      z-index: 1;
    }

    main {
      flex: 1;
      overflow-y: auto;
      padding: 0 2px 90px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    main::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    .hero {
      margin: 4px 2px 12px;
    }

    .hero-line-1 {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .hero-title {
      font-size: 22px;
      line-height: 1.25;
      margin: 0 0 14px;
      color: var(--text-main);
      font-weight: 700;
    }

    .hero-title span {
      color: var(--blue);
    }

    .primary-cta {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 12px 16px;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .primary-cta svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .primary-cta:active {
      transform: scale(0.97);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      filter: brightness(0.97);
    }

    .sub-cta-wrap {
      display: flex;
      justify-content: center;
      margin-top: 12px;
    }

    .sub-cta {
      min-width: 170px;
      border-radius: 999px;
      border: none;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
      color: var(--blue);
      background: #ffffff;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
    }

    .sub-cta:active {
      transform: scale(0.97);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 20px 4px 8px;
    }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    .section-action {
      font-size: 12px;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }

    .section-action svg {
      width: 12px;
      height: 12px;
    }

    .card {
      border-radius: 18px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 12px 12px 11px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .announcement-card {
      margin: 0 2px 6px;
      padding: 10px 12px;
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .announcement-icon {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #1d4ed8;
      margin-top: 2px;
    }

    .announcement-body {
      flex: 1;
    }

    .announcement-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .announcement-text {
      font-size: 11px;
      color: var(--text-main);
    }

    .announcement-close {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 14px;
      cursor: pointer;
      padding: 0;
      margin-left: 4px;
      flex-shrink: 0;
    }

    .update-soft-btn {
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      border: none;
      font-size: 11px;
      font-weight: 600;
      background: #ffffff;
      color: var(--blue);
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
    }

    .update-soft-btn:active {
      transform: scale(0.97);
    }

    .update-hard-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .update-hard-card {
      width: 90%;
      max-width: 380px;
      border-radius: 22px;
      background: #ffffff;
      padding: 18px 16px 16px;
      text-align: center;
      box-shadow: var(--shadow-strong);
    }

    .update-hard-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text-main);
    }

    .update-hard-text {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .update-hard-btn {
      width: 100%;
      border-radius: 999px;
      border: none;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      cursor: pointer;
    }

    .update-hard-note {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 6px;
    }

    .dashboard-card {
      background: #f8fbff;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 82px;
    }

    .dashboard-icon {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .dashboard-icon.blue {
      background: #eff6ff;
      color: #2563eb;
    }

    .dashboard-icon.green {
      background: #ecfdf5;
      color: #16a34a;
    }

    .dashboard-icon svg {
      width: 20px;
      height: 20px;
    }

    .dashboard-meta {
      min-width: 0;
    }

    .dashboard-title {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .dashboard-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
    }

    .scan-card {
      margin-top: 14px;
      background: #ffffff;
    }

    .scan-card-header,
    .ai-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }

    .scan-card-icon,
    .ai-card-icon {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .scan-card-icon {
      background: #eff6ff;
      color: #2563eb;
    }

    .ai-card-icon {
      background: #f5f3ff;
      color: #4f46e5;
    }

    .scan-card-icon svg,
    .ai-card-icon svg {
      width: 18px;
      height: 18px;
    }

    .scan-card-title,
    .ai-card-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .scan-card-subtitle,
    .ai-card-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .scan-card-button,
    .ai-card-button {
      width: 100%;
      margin-top: 6px;
      border-radius: 999px;
      border: none;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.05s, box-shadow 0.15s, filter 0.1s;
    }

    .scan-card-button {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .ai-card-button {
      background: linear-gradient(135deg, #4f46e5, #2563eb);
    }

    .scan-card-button:active,
    .ai-card-button:active {
      transform: scale(0.97);
    }

    .history-card {
      margin-top: 6px;
      cursor: pointer;
      transition: box-shadow 0.15s, transform 0.05s;
    }

    .history-card:active {
      transform: scale(0.99);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .history-empty {
      font-size: 12px;
      color: var(--text-muted);
    }

    .history-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 12px;
      color: var(--text-main);
    }

    .history-item-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 6px;
    }

    .history-course {
      font-weight: 600;
    }

    .history-time {
      font-size: 11px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .history-progress-track {
      margin-top: 4px;
      width: 100%;
      height: 4px;
      border-radius: 999px;
      background: #e5e7eb;
      overflow: hidden;
    }

    .history-progress-bar {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      width: 100%;
    }

    .history-meta {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(env(safe-area-inset-bottom) + 8px);
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 420px;
      border-top: 1px solid #e5e7eb;
      padding: 6px 8px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: #ffffff;
      border-radius: 26px;
      box-shadow: 0 10px 30px rgba(15,23,42,0.18);
      z-index: 50;
      will-change: transform;
    }

    .nav-btn {
      flex: 1;
      text-align: center;
      font-size: 11px;
      color: #9ca3af;
      cursor: pointer;
      padding-top: 2px;
    }

    .nav-btn-inner {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .nav-btn svg {
      width: 20px;
      height: 20px;
      display: block;
    }

    .nav-btn.active {
      color: var(--blue);
      font-weight: 600;
    }

    .placeholder-note {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.45;
      margin: 4px 2px 14px;
    }

    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    body.keyboard-open .bottom-nav {
      display: none;
    }
  </style>
</head>

<body>
  <div class="phone-shell">
    <header>
      <div class="brand">
        <div class="brand-logo">
          <img src="asset/logo walpaper.jpeg" alt="Colspot logo" />
        </div>
        <div class="brand-name">Colspot</div>
      </div>

      <button class="avatar-chip" id="avatarChip" onclick="showScreen('account')">
        <img id="avatarChipImg" src="" alt="Profile picture" />
        <span id="avatarChipText">C</span>
      </button>
    </header>

    <main>
      <div id="screen-home" class="screen active">
        <section class="hero">
          <div class="hero-line-1" id="greetingLine">Welcome back</div>
          <h1 class="hero-title">
            What do you want to<br />
            <span>do today?</span>
          </h1>

          <button class="primary-cta" onclick="showScreen('attendance')">
            <svg viewBox="0 0 20 20" fill="none">
              <path
                d="M10 4v12M4 10h12"
                stroke="white"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <span>Create new attendance</span>
          </button>

          <div class="sub-cta-wrap">
            <button class="sub-cta" id="createClassBtn" type="button">Create class</button>
          </div>
        </section>

        <section id="updateSoftSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="announcement-body">
              <div id="updateSoftTitle" class="announcement-title">New version available</div>
              <div id="updateSoftMessage" class="announcement-text"></div>
              <button
                type="button"
                class="update-soft-btn"
                onclick="openUpdateUrlFromRule()"
              >
                Update now
              </button>
            </div>
          </article>
        </section>

        <section id="announcementSection" style="display:none;">
          <article class="announcement-card">
            <div class="announcement-icon">
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M10 2.5a7.5 7.5 0 107.5 7.5A7.51 7.51 0 0010 2.5zm0 4v4.5M10 13.5h.01"
                  stroke="#1d4ed8"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="announcement-body">
              <div id="announcementTitle" class="announcement-title">Update</div>
              <div id="announcementMessage" class="announcement-text"></div>
            </div>
            <button type="button" class="announcement-close" onclick="dismissAnnouncement()">✕</button>
          </article>
        </section>

        <section>
          <div class="section-header">
            <div class="section-title">Dashboard</div>
            <div class="section-action" onclick="showScreen('classes')">
              <span>Open</span>
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M7 4l6 6-6 6"
                  stroke="#2563eb"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <div class="dashboard-grid">
            <article class="dashboard-card">
              <div class="dashboard-icon blue">
                <svg viewBox="0 0 20 20" fill="none">
                  <rect x="4.5" y="3.5" width="11" height="13" rx="1.4" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="dashboard-meta">
                <div class="dashboard-title">Total class</div>
                <div class="dashboard-value" id="totalClassesValue">0</div>
              </div>
            </article>

            <article class="dashboard-card">
              <div class="dashboard-icon green">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M13.5 16v-1.2a2.8 2.8 0 00-2.8-2.8H6.8A2.8 2.8 0 004 14.8V16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  <circle cx="8.8" cy="7" r="2.7" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M15.2 7.2v4.2M17.3 9.3h-4.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="dashboard-meta">
                <div class="dashboard-title">Total student</div>
                <div class="dashboard-value" id="totalStudentsValue">0</div>
              </div>
            </article>
          </div>
        </section>

        <section>
          <article class="card ai-card">
            <div class="ai-card-header">
              <div class="ai-card-icon">
                <svg viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="10" r="7" stroke="#4f46e5" stroke-width="1.4"/>
                  <path d="M7.5 9.5c.4-1.4 1.5-2.3 2.7-2.3 1.3 0 2.5.9 2.8 2.3" stroke="#4f46e5" stroke-width="1.3" stroke-linecap="round"/>
                  <path d="M8.2 12.2h3.6" stroke="#4f46e5" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <div class="ai-card-title">Chat with Colspot AI</div>
                <div class="ai-card-subtitle">
                  Ask quick questions about using Colspot or summarise attendance information in simple language.
                </div>
              </div>
            </div>
            <button class="ai-card-button" onclick="showScreen('ai')">
              Open Colspot AI
            </button>
          </article>
        </section>

        <section>
          <article class="card scan-card">
            <div class="scan-card-header">
              <div class="scan-card-icon">
                <svg viewBox="0 0 20 20" fill="none">
                  <rect x="4" y="3.5" width="9" height="13" rx="1.2" stroke="#2563eb" stroke-width="1.4"/>
                  <path d="M7 6.5h7a1.5 1.5 0 011.5 1.5v7.5a1 1 0 01-1 1h-7" stroke="#2563eb" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M6.5 9.5h4" stroke="#2563eb" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <div class="scan-card-title">Scan paper sheet</div>
                <div class="scan-card-subtitle">
                  Take a photo of any list and turn it into Excel or Word. Use it for attendance or anything else.
                </div>
              </div>
            </div>
            <button class="scan-card-button" onclick="showScreen('scan')">
              Scan paper sheet
            </button>
          </article>
        </section>

        <section>
          <div class="section-header">
            <div class="section-title">Recent history</div>
            <div class="section-action" onclick="showScreen('history')">
              <span>View all</span>
              <svg viewBox="0 0 20 20" fill="none">
                <path
                  d="M7 4l6 6-6 6"
                  stroke="#2563eb"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <article class="card history-card" onclick="showScreen('history')">
            <div class="history-list" id="historyList">
              <div class="history-empty">
                Loading your recent sessions...
              </div>
            </div>
          </article>
        </section>
      </div>

      <div id="screen-ai" class="screen">
        <section class="hero">
          <div class="hero-line-1">Colspot AI</div>
          <h1 class="hero-title">
            Chat with<span> Colspot AI</span>
          </h1>
          <p style="font-size:13px; color:#6b7280; margin:4px 2px 14px;">
            This is the AI page placeholder. You will paste the real AI chat UI here later.
          </p>
        </section>
      </div>

      <!-- KEEP ALL YOUR OTHER EXISTING SCREENS HERE EXACTLY AS THEY ALREADY ARE
           attendance / live-session / classes / history / reports / account / scan / etc. -->

    </main>
  </div>

  <div id="updateHardOverlay" class="update-hard-overlay">
    <div class="update-hard-card">
      <div class="update-hard-title" id="updateHardTitle">
        Please update Colspot
      </div>
      <div class="update-hard-text" id="updateHardMessage">
        A newer version of Colspot is required to continue. Please update to keep using the app.
      </div>
      <button class="update-hard-btn" onclick="openUpdateUrlFromRule()">
        Update app
      </button>
      <div class="update-hard-note">
        This device will not be able to continue until you install the latest version.
      </div>
    </div>
  </div>

  <nav class="bottom-nav" id="bottomNav">
    <div class="nav-btn active" data-nav="home" onclick="showScreen('home')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M4.5 10.75L12 4l7.5 6.75V19a1.5 1.5 0 01-1.5 1.5h-4.25v-4.25h-3.5V20.5H6A1.5 1.5 0 014.5 19v-8.25z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"
          />
        </svg>
        <span>Home</span>
      </div>
    </div>

    <div class="nav-btn" data-nav="attendance" onclick="showScreen('attendance')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M12 5v14M5 12h14"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
        <span>Attendance</span>
      </div>
    </div>

    <div class="nav-btn" data-nav="history" onclick="showScreen('history')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M12 8v5l3 2"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle
            cx="12"
            cy="12"
            r="8"
            stroke="currentColor"
            stroke-width="1.7"
          />
        </svg>
        <span>History</span>
      </div>
    </div>

    <div class="nav-btn" data-nav="scan" onclick="showScreen('scan')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M7 3H5a2 2 0 00-2 2v2M17 3h2a2 2 0 012 2v2M7 21H5a2 2 0 01-2-2v-2M17 21h2a2 2 0 002-2v-2"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
          <rect
            x="7"
            y="7"
            width="10"
            height="10"
            rx="2"
            stroke="currentColor"
            stroke-width="1.7"
          />
        </svg>
        <span>Scan</span>
      </div>
    </div>

    <div class="nav-btn" data-nav="account" onclick="showScreen('account')">
      <div class="nav-btn-inner">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7" />
          <path
            d="M5 19c1-3 3-4.5 7-4.5s6 1.5 7 4.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
        <span>Account</span>
      </div>
    </div>
  </nav>
<script>
  let currentUser = null;
  let currentUpdateRule = null;

  function appendMainDebug() {}

  function getCachedAuthFromLocalUser() {
    try {
      const raw = localStorage.getItem("colspot_local_user");
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.id) return null;

      return {
        user_id: parsed.id,
        email: parsed.email || "",
        full_name: parsed.full_name || parsed.email || ""
      };
    } catch (e) {
      console.warn("Failed to read local auth:", e);
      return null;
    }
  }

  function saveLocalUserFromSupabaseUser(user) {
    if (!user || !user.id) return;

    try {
      const payload = {
        id: user.id,
        email: user.email || "",
        full_name:
          (user.user_metadata && user.user_metadata.full_name) ||
          user.email ||
          "",
        avatar_url:
          (user.user_metadata && user.user_metadata.avatar_url) || ""
      };

      localStorage.setItem("colspot_local_user", JSON.stringify(payload));
    } catch (e) {
      console.warn("Failed to save local user:", e);
    }
  }

  function setGreetingFromProfile(name) {
    const greetingLine = document.getElementById("greetingLine");
    if (!greetingLine) return;

    const safeName = String(name || "").trim();
    if (!safeName) {
      greetingLine.textContent = "Welcome back";
      return;
    }

    const first = safeName.split(" ")[0];
    greetingLine.textContent = `Welcome back, ${first}`;
  }

  function syncTopRightAvatar(avatarUrl, initial) {
    const avatarChipImg = document.getElementById("avatarChipImg");
    const avatarChipText = document.getElementById("avatarChipText");
    const oldAvatarInitial = document.getElementById("avatarInitial");

    const safeInitial = (initial || "C").toUpperCase();

    if (avatarChipImg && avatarChipText) {
      if (avatarUrl) {
        avatarChipImg.src = avatarUrl;
        avatarChipImg.style.display = "block";
        avatarChipText.textContent = safeInitial;
        avatarChipText.style.opacity = "0";
      } else {
        avatarChipImg.removeAttribute("src");
        avatarChipImg.style.display = "none";
        avatarChipText.textContent = safeInitial;
        avatarChipText.style.opacity = "1";
      }
    }

    if (oldAvatarInitial) {
      oldAvatarInitial.textContent = safeInitial;
    }
  }

  function lockBottomNavToScreen(screenName) {
    const navButtons = document.querySelectorAll(".bottom-nav .nav-btn");
    navButtons.forEach((btn) => {
      const isActive = btn.getAttribute("data-nav") === screenName;
      btn.classList.toggle("active", isActive);
    });
  }

  function showScreen(screenName) {
    const screens = document.querySelectorAll(".screen");
    screens.forEach((screen) => screen.classList.remove("active"));

    const target = document.getElementById(`screen-${screenName}`);
    if (target) {
      target.classList.add("active");
    }

    lockBottomNavToScreen(screenName);

    if (screenName === "history") {
      loadMiniHistory(true);
    }

    if (screenName === "home") {
      loadStudentDashboard();
      loadMiniHistory(false);
    }

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function dismissAnnouncement() {
    const announcementSection = document.getElementById("announcementSection");
    if (announcementSection) {
      announcementSection.style.display = "none";
    }
  }

  function openUpdateUrlFromRule() {
    if (!currentUpdateRule || !currentUpdateRule.url) return;
    window.open(currentUpdateRule.url, "_blank");
  }

  function applyUpdateRuleFromLocal() {
    try {
      const raw = localStorage.getItem("colspot_update_rule");
      if (!raw) return;

      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.url) return;

      currentUpdateRule = parsed;

      const softSection = document.getElementById("updateSoftSection");
      const softTitle = document.getElementById("updateSoftTitle");
      const softMessage = document.getElementById("updateSoftMessage");

      const hardOverlay = document.getElementById("updateHardOverlay");
      const hardTitle = document.getElementById("updateHardTitle");
      const hardMessage = document.getElementById("updateHardMessage");

      if (parsed.type === "hard") {
        if (hardTitle) hardTitle.textContent = parsed.title || "Please update Colspot";
        if (hardMessage) {
          hardMessage.textContent =
            parsed.message ||
            "A newer version of Colspot is required to continue. Please update to keep using the app.";
        }
        if (hardOverlay) hardOverlay.style.display = "flex";
      } else {
        if (softTitle) softTitle.textContent = parsed.title || "New version available";
        if (softMessage) {
          softMessage.textContent =
            parsed.message || "A newer version of Colspot is available.";
        }
        if (softSection) softSection.style.display = "block";
      }
    } catch (e) {
      console.warn("Could not apply update rule:", e);
    }
  }

  function loadAnnouncements() {
    const announcementSection = document.getElementById("announcementSection");
    const announcementTitle = document.getElementById("announcementTitle");
    const announcementMessage = document.getElementById("announcementMessage");

    try {
      const raw = localStorage.getItem("colspot_announcement");
      if (!raw) return;

      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.message) return;

      if (announcementTitle) {
        announcementTitle.textContent = parsed.title || "Update";
      }

      if (announcementMessage) {
        announcementMessage.textContent = parsed.message;
      }

      if (announcementSection) {
        announcementSection.style.display = "block";
      }
    } catch (e) {
      console.warn("Could not load announcement:", e);
    }
  }

  async function loadStudentDashboard() {
    const totalClassesValue = document.getElementById("totalClassesValue");
    const totalStudentsValue = document.getElementById("totalStudentsValue");

    if (totalClassesValue) totalClassesValue.textContent = "0";
    if (totalStudentsValue) totalStudentsValue.textContent = "0";

    if (!currentUser || typeof supabase === "undefined") return;

    try {
      const userId = currentUser.id;

      const { data: sessions, error: sessionsError } = await supabase
        .from("attendance_sessions")
        .select("id")
        .eq("created_by", userId);

      if (!sessionsError && Array.isArray(sessions)) {
        if (totalClassesValue) totalClassesValue.textContent = String(sessions.length);

        const sessionIds = sessions.map((s) => s.id).filter(Boolean);

        if (sessionIds.length > 0) {
          const { data: records, error: recordsError } = await supabase
            .from("attendance_records")
            .select("student_id, session_id")
            .in("session_id", sessionIds);

          if (!recordsError && Array.isArray(records)) {
            const uniqueStudents = new Set(
              records.map((r) => r.student_id).filter(Boolean)
            );
            if (totalStudentsValue) {
              totalStudentsValue.textContent = String(uniqueStudents.size);
            }
          }
        }
      }
    } catch (e) {
      console.error("loadStudentDashboard failed:", e);
    }
  }

  async function loadMiniHistory(forceHistoryScreen) {
    const historyList = document.getElementById("historyList");
    if (!historyList) return;

    historyList.innerHTML =
      '<div class="history-empty">Loading your recent sessions...</div>';

    if (!currentUser || typeof supabase === "undefined") {
      historyList.innerHTML =
        '<div class="history-empty">No recent sessions yet.</div>';
      return;
    }

    try {
      const { data: sessions, error } = await supabase
        .from("attendance_sessions")
        .select("id, course_title, course_code, created_at, ends_at")
        .eq("created_by", currentUser.id)
        .order("created_at", { ascending: false })
        .limit(forceHistoryScreen ? 20 : 5);

      if (error) throw error;

      if (!sessions || sessions.length === 0) {
        historyList.innerHTML =
          '<div class="history-empty">No recent sessions yet.</div>';
        return;
      }

      historyList.innerHTML = "";

      sessions.forEach((session) => {
        const item = document.createElement("div");
        item.className = "history-item";

        const title =
          session.course_title ||
          session.course_code ||
          "Attendance session";

        const dateText = session.created_at
          ? new Date(session.created_at).toLocaleString()
          : "Recently";

        item.innerHTML = `
          <div class="history-item-header">
            <div class="history-course">${title}</div>
            <div class="history-time">${dateText}</div>
          </div>
          <div class="history-meta">
            <span>${session.course_code || "Session"}</span>
          </div>
          <div class="history-progress-track">
            <div class="history-progress-bar"></div>
          </div>
        `;

        historyList.appendChild(item);
      });
    } catch (e) {
      console.error("loadMiniHistory failed:", e);
      historyList.innerHTML =
        '<div class="history-empty">Could not load history right now.</div>';
    }
  }

  function initScanQuotaUI() {
    const quotaEls = document.querySelectorAll(".scan-quota");
    quotaEls.forEach((el) => {
      const text = (el.textContent || "").toLowerCase();
      el.classList.remove("scan-quota-low", "scan-quota-zero");

      if (text.includes("0 left") || text.includes("no scans")) {
        el.classList.add("scan-quota-zero");
      } else if (text.includes("1 left") || text.includes("2 left")) {
        el.classList.add("scan-quota-low");
      }
    });
  }

  async function submitScanSheet() {
    alert("Keep your current scan JS here.");
  }

  function tryInitPush() {}

  function runMainWarmupOnce() {}

  function openCreateClass() {
    if (typeof window.showScreen === "function") {
      showScreen("attendance");
    } else {
      window.location.href = "attendance.html";
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    appendMainDebug("DOMContentLoaded fired");
    await new Promise((r) => setTimeout(r, 50));

    lockBottomNavToScreen("home");

    let localAuth = null;

    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.guardPageAccess === "function"
      ) {
        const localUser = ColspotGuard.guardPageAccess();
        if (!localUser) return;

        localAuth = {
          user_id: localUser.id,
          email: localUser.email || "",
          full_name: localUser.full_name || localUser.email || ""
        };
      } else {
        localAuth = getCachedAuthFromLocalUser();
        if (!localAuth) {
          window.location.href = "index.html";
          return;
        }
      }
    } catch (e) {
      console.error("guardPageAccess failed on main:", e);
      window.location.href = "index.html";
      return;
    }

    if (localAuth) {
      const localName =
        (localAuth.full_name && localAuth.full_name.trim()) ||
        (localAuth.email && localAuth.email.trim()) ||
        "";
      if (localName) {
        setGreetingFromProfile(localName);
        syncTopRightAvatar("", localName.trim().charAt(0).toUpperCase());
      }
    }

    const fileInput = document.getElementById("scanFileInput");
    const chosenText = document.getElementById("scanFileChosenText");
    if (fileInput && chosenText) {
      fileInput.addEventListener("change", () => {
        if (fileInput.files && fileInput.files[0]) {
          chosenText.textContent = "Selected: " + fileInput.files[0].name;
        } else {
          chosenText.textContent = "";
        }
      });
    }

    const scanSubmitBtn = document.getElementById("scanSubmitBtn");
    if (scanSubmitBtn) {
      scanSubmitBtn.addEventListener("click", submitScanSheet);
    }

    const createClassBtn = document.getElementById("createClassBtn");
    if (createClassBtn) {
      createClassBtn.addEventListener("click", openCreateClass);
    }

    if (
      window.ColspotGuard &&
      typeof ColspotGuard.verifySupabaseSessionInBackground === "function"
    ) {
      ColspotGuard.verifySupabaseSessionInBackground();
    } else if (typeof supabase !== "undefined") {
      try {
        const { data, error } = await supabase.auth.getUser();
        if (!error && data && data.user) {
          currentUser = data.user;

          const profileName =
            (currentUser.user_metadata && currentUser.user_metadata.full_name) ||
            currentUser.email ||
            currentUser.phone ||
            "";

          saveLocalUserFromSupabaseUser(currentUser);

          if (profileName) {
            setGreetingFromProfile(profileName);
          }

          syncTopRightAvatar(
            (currentUser.user_metadata && currentUser.user_metadata.avatar_url) || "",
            profileName ? profileName.trim().charAt(0).toUpperCase() : "S"
          );
        }
      } catch (e) {
        console.error("Fallback getUser on main failed:", e);
      }
    }

    loadStudentDashboard();
    loadMiniHistory(false);
    initScanQuotaUI();
    loadAnnouncements();
    applyUpdateRuleFromLocal();
    tryInitPush();
    appendMainDebug("Initial delay complete");
    appendMainDebug("tryInitPush finished");
    runMainWarmupOnce();
  });

  window.showScreen = showScreen;
  window.dismissAnnouncement = dismissAnnouncement;
  window.openUpdateUrlFromRule = openUpdateUrlFromRule;
  window.submitScanSheet = submitScanSheet;
  window.openCreateClass = openCreateClass;
</script>
</body>
</html>
