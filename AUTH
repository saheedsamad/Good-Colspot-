      if (existing.exists) {
        msgEl.textContent = existing.message || MSG.SIGNUP_ALREADY_EXISTS;
        msgEl.className = "message error";
        return;
      }

      pendingSignup = {
        email,
        password,
        fullName,
        role,
        schoolName,
        dept,
