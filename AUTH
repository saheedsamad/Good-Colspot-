async function resolveUserRole(userId, userEmail = "") {
  if (!userId || !window.supabase) return getAuthRole() || "";

  try {
    const { data: studentByUser } = await supabase
      .from("student_accounts")
      .select("user_id,email")
      .eq("user_id", userId)
      .maybeSingle();

    if (studentByUser?.user_id) {
      saveAuthRole("student");
      return "student";
    }

    const { data: lecturerByUser } = await supabase
      .from("lecturer_accounts")
      .select("user_id,email")
      .eq("user_id", userId)
      .maybeSingle();

    if (lecturerByUser?.user_id) {
      saveAuthRole("lecturer");
      return "lecturer";
    }

    const email = String(userEmail || "").trim().toLowerCase();

    if (email) {
      const { data: studentByEmail } = await supabase
        .from("student_accounts")
        .select("user_id,email")
        .eq("email", email)
        .maybeSingle();

      if (studentByEmail?.user_id) {
        saveAuthRole("student");
        return "student";
      }

      const { data: lecturerByEmail } = await supabase
        .from("lecturer_accounts")
        .select("user_id,email")
        .eq("email", email)
        .maybeSingle();

      if (lecturerByEmail?.user_id) {
        saveAuthRole("lecturer");
        return "lecturer";
      }
    }

    return getAuthRole() || "";
  } catch (e) {
    console.error("resolveUserRole failed:", e);
    return getAuthRole() || "";
  }
}

/* ----------------------------
 * Existing account checks
 * ---------------------------- */
async function checkExistingAccountForSignup(email, role) {
  if (!window.supabase || !email) return { exists: false, message: "" };

  const cleanEmail = String(email).trim().toLowerCase();

  try {
    const [studentRes, lecturerRes] = await Promise.all([
      supabase
        .from("student_accounts")
        .select("user_id,email,full_name")
        .eq("email", cleanEmail)
        .maybeSingle(),
      supabase
        .from("lecturer_accounts")
        .select("user_id,email,full_name")
        .eq("email", cleanEmail)
        .maybeSingle()
    ]);

    const studentRow = studentRes.data || null;
    const lecturerRow = lecturerRes.data || null;

    if (role === "student") {
      if (studentRow) {
        return {
          exists: true,
          message: MSG.SIGNUP_ALREADY_EXISTS
        };
      }

      if (lecturerRow) {
        return {
          exists: true,
          message: "This email already belongs to a lecturer account. Please go back and sign in through the Lecturer flow."
        };
      }
    }

    if (role === "lecturer") {
      if (lecturerRow) {
        return {
          exists: true,
          message: MSG.SIGNUP_ALREADY_EXISTS
        };
      }

      if (studentRow) {
        return {
          exists: true,
          message: "You have already created a student account with this email. Please go back and sign in."
        };
      }
    }

    return { exists: false, message: "" };
  } catch (e) {
    console.error("checkExistingAccountForSignup failed:", e);
    return { exists: false, message: "" };
  }
}

