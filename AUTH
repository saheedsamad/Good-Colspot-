async function handleForgotPassword() {
  const emailInput = document.getElementById("forgot-email");
  const msgEl =
    document.getElementById("forgot-message") ||
    document.getElementById("signin-message");

  const email = emailInput ? emailInput.value.trim() : "";

  if (msgEl) {
    msgEl.textContent = "";
    msgEl.className = "message";
  }

  if (!email) {
    if (msgEl) {
      msgEl.textContent = MSG.FORGOT_NO_EMAIL;
      msgEl.className = "message error";
    }
    return;
  }

  if (!window.supabase) {
    if (msgEl) {
      msgEl.textContent = MSG.AUTH_NOT_READY;
      msgEl.className = "message error";
    }
    return;
  }

  try {
    setButtonLoading(
      "forgot-send-btn",
      "forgot-send-text",
      "forgot-send-loader",
      true
    );

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        shouldCreateUser: false,
      },
    });

    if (error) {
      console.error("forgot password OTP error:", error);
      const lower = (error.message || "").toLowerCase();

      if (isLikelyOfflineError(error)) {
        updateOfflineUI();
        if (msgEl) {
          msgEl.textContent = MSG.OFFLINE_SIGNIN;
          msgEl.className = "message error";
        }
      } else if (
        lower.includes("throttle") ||
        lower.includes("rate limit") ||
        lower.includes("too many")
      ) {
        if (msgEl) {
          msgEl.textContent = MSG.FORGOT_THROTTLED;
          msgEl.className = "message error";
        }
      } else if (
        lower.includes("user") &&
        lower.includes("not")
      ) {
        if (msgEl) {
          msgEl.textContent =
            "We couldn’t find any Colspot account with that email.";
          msgEl.className = "message error";
        }
      } else if (msgEl) {
        msgEl.textContent = MSG.FORGOT_SEND_FAIL;
        msgEl.className = "message error";
      }
      return;
    }

    resetEmail = email;
    try {
      localStorage.setItem("colspot_reset_email", email);
    } catch (e) {
      console.error("Could not cache reset email:", e);
    }

    showResetPanel(email);

    const rMsg = document.getElementById("reset-message");
    if (rMsg) {
      rMsg.textContent = MSG.FORGOT_SEND_OK;
      rMsg.className = "message success";
    }
  } catch (err) {
    console.error("forgot password failed:", err);
    if (isLikelyOfflineError(err)) {
      updateOfflineUI();
      if (msgEl) {
        msgEl.textContent = MSG.OFFLINE_SIGNIN;
        msgEl.className = "message error";
      }
    } else if (msgEl) {
      msgEl.textContent = MSG.FORGOT_SEND_FAIL;
      msgEl.className = "message error";
    }
  } finally {
    setButtonLoading(
      "forgot-send-btn",
      "forgot-send-text",
      "forgot-send-loader",
      false
    );
  }
}

