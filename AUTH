      msgEl.className = "message error";
      return;
    }

    if (!fullName || !schoolName || !accountId || !email || !password || !password2) {
      msgEl.textContent = MSG.SIGNUP_MISSING_FIELDS;
      msgEl.className = "message error";
      return;
    }

    if (!isStrongPassword(password)) {
      msgEl.textContent = MSG.SIGNUP_WEAK_PASSWORD;
