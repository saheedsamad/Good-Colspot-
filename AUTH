      msgEl.className = "message error";
      return;
    }

    if (!code || code.length < 4) {
      msgEl.textContent = MSG.VERIFY_MISSING_CODE;
      msgEl.className = "message error";
      return;
    }

    if (!window.supabase) {
      msgEl.textContent = MSG.AUTH_NOT_READY;
      msgEl.className = "message error";
      return;
    }

    try {
      setButtonLoading(
        "verify-code-btn",
        "verify-code-text",
        "verify-code-loader",
        true
      );

      const { data, error } = await supabase.auth.verifyOtp({
        email,
        token: code,
        type: "email",
      });

      if (error) {
        console.error(error);
        msgEl.textContent = MSG.VERIFY_FAIL;
        msgEl.className = "message error";
        return;
      }

      if (pendingSignup && pendingSignup.password) {
        const {
          password,
          fullName,
          role,
          schoolName,
          dept,
          accountId
        } = pendingSignup;

        const metadata = {
          full_name: fullName,
          role,
          school_name: schoolName,
          department: dept || "",
          ...(role === "student"
            ? { matric_number: accountId }
            : { staff_id: accountId })
        };

        const { error: updateError } = await supabase.auth.updateUser({
          password,
          data: metadata,
        });

        if (updateError) {
          console.error(updateError);
          msgEl.textContent = MSG.VERIFY_SET_PASSWORD_FAIL;
          msgEl.className = "message error";
          return;
        }
      }

      if (data && data.session) {
        try {
          await linkDeviceForSession(data.session);
        } catch (deviceErr) {
          await supabase.auth.signOut();
          clearLocalUser();
          msgEl.textContent = deviceErr.message || MSG.DEVICE_REGISTER_FAIL;
          msgEl.className = "message error";
          return;
        }

        localStorage.setItem(
          "colspot_last_user",
          JSON.stringify({
            id: data.session.user.id,
            email: data.session.user.email,
          })
        );

        await recordLoginEvent(data.session);
        saveLocalUserFromSession(data.session);

        try {
          if (pendingSignup) {
            await saveSignupAccountRow(
              data.session.user.id,
              pendingSignup,
              data.session.user.email
            );
          }
        } catch (profileErr) {
          console.error("account table save error:", profileErr);
          msgEl.textContent = MSG.SIGNUP_SAVE_PROFILE_FAIL;
          msgEl.className = "message error";
          return;
        }

        await resolveUserRole(
          data.session.user.id,
          data.session.user.email || email
        );
      }

      msgEl.textContent = MSG.VERIFY_OK_REDIRECT;
      msgEl.className = "message success";

      setTimeout(() => {
        goToAuthCallback();
      }, 800);
    } catch (err) {
      console.error(err);
      msgEl.textContent = MSG.VERIFY_FAIL;
      msgEl.className = "message error";
    } finally {
      setButtonLoading(
        "verify-code-btn",
        "verify-code-text",
        "verify-code-loader",
        false
      );
    }
  });

