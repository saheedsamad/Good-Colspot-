    const code = document.getElementById("reset-code")?.value?.trim() || "";
    const newPw = document.getElementById("reset-password")?.value || "";
    const newPw2 = document.getElementById("reset-password2")?.value || "";
    const msgEl = document.getElementById("reset-message");
    msgEl.textContent = "";
    msgEl.className = "message";

    const email =
      resetEmail || localStorage.getItem("colspot_reset_email") || "";

    if (!email) {
      msgEl.textContent = MSG.RESET_NO_EMAIL;
      msgEl.className = "message error";
      return;
    }

    if (!code || code.length < 4) {
      msgEl.textContent = MSG.RESET_MISSING_CODE;
      msgEl.className = "message error";
      return;
    }

    if (!isStrongPassword(newPw)) {
      msgEl.textContent = MSG.RESET_WEAK_PASSWORD;
      msgEl.className = "message error";
      return;
    }

    if (newPw !== newPw2) {
      msgEl.textContent = MSG.RESET_PASSWORD_MISMATCH;
      msgEl.className = "message error";
      return;
    }

    if (!window.supabase) {
      msgEl.textContent = MSG.AUTH_NOT_READY;
      msgEl.className = "message error";
      return;
    }

    try {
      setButtonLoading(
        "reset-submit-btn",
        "reset-submit-text",
        "reset-submit-loader",
        true
      );

      const { data, error } = await supabase.auth.verifyOtp({
        email,
        token: code,
        type: "email",
      });

      if (error) {
        console.error(error);
        msgEl.textContent = MSG.RESET_FAIL_VERIFY;
        msgEl.className = "message error";
        return;
      }

      const { error: updateError } = await supabase.auth.updateUser({
        password: newPw,
      });

      if (updateError) {
        console.error("Password update error:", updateError);
      }

      if (data && data.session) {
        try {
          await linkDeviceForSession(data.session);
        } catch (deviceErr) {
          await supabase.auth.signOut();
          clearLocalUser();
          msgEl.textContent = deviceErr.message || MSG.DEVICE_REGISTER_FAIL;
          msgEl.className = "message error";
          return;
        }

        await recordLoginEvent(data.session);
        saveLocalUserFromSession(data.session);
        await resolveUserRole(data.session.user.id, data.session.user.email || email);
      }

      msgEl.textContent = MSG.RESET_OK_REDIRECT;
      msgEl.className = "message success";

      setTimeout(() => {
        goToAuthCallback();
      }, 800);
    } catch (err) {
      console.error(err);
      msgEl.textContent = MSG.RESET_FAIL_UPDATE;
      msgEl.className = "message error";
    } finally {
      setButtonLoading(
        "reset-submit-btn",
        "reset-submit-text",
        "reset-submit-loader",
        false
      );
    }
  });

document
  .getElementById("reset-back-btn")
  ?.addEventListener("click", () => {
    resetEmail = null;
    try {
      localStorage.removeItem("colspot_reset_email");
    } catch (e) {
      console.error("Could not clear reset email cache:", e);
    }
    hideResetPanel();
    switchMode("signin");
  });

/* ----------------------------
 * Admin login
 * ---------------------------- */
const adminFormEl = document.getElementById("admin-form");
if (adminFormEl) {
  adminFormEl.addEventListener("submit", async (e) => {
    e.preventDefault();
    saveAuthRole("admin");

    const identifier = (document.getElementById("admin-identifier")?.value || "").trim();
    const password = document.getElementById("admin-password")?.value || "";
    const msgEl = document.getElementById("admin-message");

    if (msgEl) {
      msgEl.textContent = "";
      msgEl.className = "message";
    }

    const rule = getVersionRuleCache();
    if (rule && rule.mode === "hard") {
      if (msgEl) {
        msgEl.textContent = MSG.VERSION_HARD_BLOCK;
        msgEl.className = "message error";
      }
      return;
    }

    if (!identifier || !password) {
      if (msgEl) {
        msgEl.textContent = MSG.ADMIN_MISSING_FIELDS;
        msgEl.className = "message error";
      }
      return;
    }

    if (isBrowserOffline()) {
      updateOfflineUI();
      if (msgEl) {
        msgEl.textContent = MSG.OFFLINE_SIGNIN;
        msgEl.className = "message error";
      }
      return;
    }

    if (!window.supabase) {
      if (msgEl) {
        msgEl.textContent = MSG.AUTH_NOT_READY;
        msgEl.className = "message error";
      }
      return;
    }

    if (!identifier.includes("@")) {
      if (msgEl) {
        msgEl.textContent = MSG.ADMIN_USERNAME_NOT_SUPPORTED;
        msgEl.className = "message error";
      }
      return;
    }

    try {
      setButtonLoading("admin-btn", "admin-text", "admin-loader", true);

      const { data, error } = await supabase.auth.signInWithPassword({
        email: identifier.toLowerCase(),
        password,
      });

      if (error) {
        console.error("Admin login error:", error);
        if (msgEl) {
          msgEl.textContent = MSG.ADMIN_GENERIC;
          msgEl.className = "message error";
        }
        return;
      }

      if (data && data.session && data.session.user) {
        try {
          await linkDeviceForSession(data.session);
        } catch (deviceErr) {
          await supabase.auth.signOut();
          clearLocalUser();
          if (msgEl) {
            msgEl.textContent = deviceErr.message || MSG.DEVICE_REGISTER_FAIL;
            msgEl.className = "message error";
          }
          return;
        }

        localStorage.setItem(
          "colspot_last_user",
          JSON.stringify({
            id: data.session.user.id,
            email: data.session.user.email,
          })
        );

        await recordLoginEvent(data.session);
        saveLocalUserFromSession(data.session);
      }

      window.location.href = ADMIN_MAIN_PATH;
    } catch (err) {
      console.error("Admin login failed:", err);
      if (msgEl) {
        msgEl.textContent = MSG.ADMIN_GENERIC;
        msgEl.className = "message error";
      }
    } finally {
      setButtonLoading("admin-btn", "admin-text", "admin-loader", false);
    }
  });
}

/* ----------------------------
 * Init
 * ---------------------------- */
async function initAuth() {
  const splash = document.getElementById("splash-screen");
  const authShell = document.getElementById("auth-shell");

  try {
    await checkAndCacheVersionRules();
  } catch (e) {
    console.error("Version check failed during init:", e);
  }

  const redirected = await redirectIfSignedIn();
  if (redirected) return;

  if (splash) splash.classList.add("hidden");
  if (authShell) authShell.classList.remove("hidden");

  const savedRole = getAuthRole();

  if (savedRole === "lecturer") {
    if (typeof window.showAuthSection === "function") {
      window.showAuthSection("lecturer");
    }
    switchMode("signin");
  } else if (savedRole === "student") {
    if (typeof window.showAuthSection === "function") {
      window.showAuthSection("student");
    }
  } else if (savedRole === "admin") {
    if (typeof window.showAuthSection === "function") {
      window.showAuthSection("admin");
    }
  } else if (typeof window.backToRoleSelection === "function") {
    window.backToRoleSelection();
  }

  updateOfflineUI();
}

/* ----------------------------
 * Expose for HTML onclick
 * ---------------------------- */
window.openForgotPasswordPage = openForgotPasswordPage;
window.handleForgotPassword = handleForgotPassword;
window.switchMode = switchMode;
window.toggleAuthMode = toggleAuthMode;
window.signInWithGoogle = signInWithGoogle;

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initAuth);
} else {
  initAuth();
}
