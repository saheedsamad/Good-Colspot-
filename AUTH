async function recordLoginEvent(session) {
  if (!session || !session.user || !window.supabase) return;

  const userId = session.user.id;
  const deviceId = await getOrCreateDeviceId();
  const deviceName = await getDeviceName();
  if (!deviceId) return;

  try {
    const { error } = await supabase.from("user_login_events").insert({
      user_id: userId,
      device_id: deviceId,
      device_name: deviceName,
    });
    if (error) {
      console.error("recordLoginEvent insert error:", error);
    }
  } catch (err) {
    console.error("recordLoginEvent failed:", err);
  }
}

/* ----------------------------
 * Mode switching
 * ---------------------------- */
function switchMode(mode) {
  currentMode = mode;

  hideVerifyPanel();
  hideResetPanel();
  hideForgotPanel();

  const signinForm = document.getElementById("signin-form");
  const signupForm = document.getElementById("signup-form");

  const tabSignin = document.getElementById("tab-signin");
  const tabSignup = document.getElementById("tab-signup");

  const title = document.getElementById("card-title");
  const subtitle = document.getElementById("card-subtitle");
  const switchText = document.getElementById("switch-text");
  const switchLabel = document.getElementById("switch-link-label");

  clearMessages();
  saveAuthRole("lecturer");

  if (mode === "signin") {
    if (signinForm) signinForm.classList.remove("hidden");
    if (signupForm) signupForm.classList.add("hidden");

    if (tabSignin) tabSignin.classList.add("active");
    if (tabSignup) tabSignup.classList.remove("active");

