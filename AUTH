}

/* ----------------------------
 * Offline detection helpers
 * ---------------------------- */
function isBrowserOffline() {
  try {
    if (typeof navigator === "undefined" || navigator === null) return false;
    return navigator.onLine === false;
  } catch {
    return false;
  }
}

function isLikelyOfflineError(error) {
  if (isBrowserOffline()) return true;
  if (!error) return false;

  const msg = (error.message || "").toLowerCase();
  if (msg.includes("failed to fetch")) return true;
  if (msg.includes("network")) return true;
  if (typeof error.status === "number" && error.status === 0) return true;

  return false;
}

function updateOfflineUI() {
  const offline = isBrowserOffline();
  const banner = document.getElementById("offline-banner");
  const bannerText = document.getElementById("offline-text");
  const msgEl = document.getElementById("signin-message");

  if (banner) {
    if (offline) {
      banner.classList.remove("hidden");
      if (bannerText) {
        bannerText.textContent = MSG.OFFLINE_BANNER;
      }
    } else {
      banner.classList.add("hidden");
    }
  }

  if (msgEl) {
    if (offline) {
      msgEl.textContent = MSG.OFFLINE_SIGNIN_HINT;
      msgEl.className = "message error";
    } else {
      if (
        msgEl.textContent &&
        msgEl.textContent.toLowerCase().includes("offline")
      ) {
        msgEl.textContent = "";
        msgEl.className = "message";
      }
    }
  }
}

if (typeof window !== "undefined") {
  window.addEventListener("online", updateOfflineUI);
  window.addEventListener("offline", updateOfflineUI);
}

/* ----------------------------
 * Semver helper
 * ---------------------------- */
function parseSemver(v) {
  if (!v) return [0, 0, 0];
  const parts = String(v).split(".").map((x) => parseInt(x, 10) || 0);
  return [parts[0] || 0, parts[1] || 0, parts[2] || 0];
}

function compareSemver(a, b) {
  const [a1, a2, a3] = parseSemver(a);
  const [b1, b2, b3] = parseSemver(b);
  if (a1 !== b1) return a1 < b1 ? -1 : 1;
  if (a2 !== b2) return a2 < b2 ? -1 : 1;
  if (a3 !== b3) return a3 < b3 ? -1 : 1;
  return 0;
}

/* ----------------------------
 * Version rule helpers
 * ---------------------------- */
function saveVersionRuleCache(rule) {
  try {
    localStorage.setItem(
      VERSION_RULE_KEY,
      JSON.stringify({
        ...rule,
        checked_at: new Date().toISOString()
      })
    );
  } catch (e) {
    console.error("Could not save version rule cache:", e);
  }
}

function getVersionRuleCache() {
  try {
    const raw = localStorage.getItem(VERSION_RULE_KEY);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch (e) {
    console.error("Could not read version rule cache:", e);
    return null;
  }
}

async function fetchVersionRuleFrom(tableName) {
  const { data, error } = await supabase
    .from(tableName)
    .select("*")
    .eq("platform", APP_PLATFORM)
    .maybeSingle();

  if (error) throw error;
  return data;
}

async function checkAndCacheVersionRules() {
  if (!window.supabase) {
    return getVersionRuleCache();
  }

  if (isBrowserOffline()) {
    return getVersionRuleCache();
  }

  try {
    let data = null;

    try {
      data = await fetchVersionRuleFrom("app_version_rule");
    } catch (e1) {
      console.warn("app_version_rule fetch failed, trying app_version_rules:", e1);
      try {
        data = await fetchVersionRuleFrom("app_version_rules");
      } catch (e2) {
        console.error("Version rule fetch failed:", e2);
        return getVersionRuleCache();
      }
    }

    if (!data) {
      const rule = { mode: "ok" };
      saveVersionRuleCache(rule);
      return rule;
    }

    const minSoftVersion = data.min_soft_version || data.mini_soft_version || "";
    const minHardVersion = data.min_hard_version || data.mini_hard_version || "";
    const deadline = data.deadline || null;
    const messageTitle = data.message_title || "";
    const messageBody = data.message_body || "";
    const updateUrl = data.update_url || "";

    let mode = "ok";

    if (minHardVersion && compareSemver(APP_VERSION, minHardVersion) < 0) {
      mode = "hard";
    }

    if (deadline) {
      const now = new Date();
      const d = new Date(deadline);
      if (now > d && minHardVersion && compareSemver(APP_VERSION, minHardVersion) < 0) {
        mode = "hard";
      }
    }

    if (mode !== "hard" && minSoftVersion && compareSemver(APP_VERSION, minSoftVersion) < 0) {
      mode = "soft";
    }

    const rule = {
      mode,
      title: messageTitle,
      body: messageBody,
      update_url: updateUrl
    };

    saveVersionRuleCache(rule);
    return rule;
  } catch (err) {
    console.error("checkAndCacheVersionRules failed:", err);
    return getVersionRuleCache();
  }
}

/* ----------------------------
 * Local state
 * ---------------------------- */
function saveLocalUserFromSession(session) {
  if (!session || !session.user) return;
  try {
    const payload = {
      id: session.user.id,
      email: session.user.email || "",
      role: getAuthRole() || "",
      last_seen: new Date().toISOString(),
    };
    localStorage.setItem(LOCAL_USER_KEY, JSON.stringify(payload));
  } catch (e) {
    console.error("Could not write local user cache:", e);
  }
}

function getLocalUser() {
  try {
    const raw = localStorage.getItem(LOCAL_USER_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    if (!parsed || !parsed.id) return null;

    if (parsed.last_seen) {
      const t = new Date(parsed.last_seen).getTime();
      if (!Number.isNaN(t)) {
        const age = Date.now() - t;
        if (age > LOCAL_USER_TTL_MS) {
          localStorage.removeItem(LOCAL_USER_KEY);
          return null;
        }
      }
    }

    return parsed;
  } catch (e) {
    console.error("Could not read local user cache:", e);
    return null;
  }
}

function clearLocalUser() {
  try {
    localStorage.removeItem(LOCAL_USER_KEY);
  } catch (e) {
    console.error("Could not clear local user cache:", e);
  }
}

/* ----------------------------
 * Password strength helper
 * ---------------------------- */
function isStrongPassword(pw) {
  if (!pw) return false;
  const hasLetter = /[A-Za-z]/.test(pw);
  const hasNumber = /[0-9]/.test(pw);
  return pw.length >= 6 && hasLetter && hasNumber;
}

/* ----------------------------
 * Device ID + device rules
 * ---------------------------- */
function generateRandomId() {
  try {
    if (
      typeof window !== "undefined" &&
      window.crypto &&
      typeof window.crypto.randomUUID === "function"
    ) {
      return window.crypto.randomUUID();
    }
  } catch (e) {
    console.error("randomUUID failed, using fallback:", e);
  }

  return (
    Math.random().toString(36).slice(2) +
    "-" +
    Date.now().toString(36)
  );
}

async function getOrCreateDeviceId() {
  const storageKey = "colspot_device_id_v2";

  try {
    if (typeof window !== "undefined" && window.localStorage) {
      const existing = window.localStorage.getItem(storageKey);
      if (existing && typeof existing === "string" && existing.trim() !== "") {
        return existing;
      }
    }
  } catch (e) {
    console.error("Could not read device id from localStorage:", e);
  }

  let newId = null;

  const platform =
    typeof APP_PLATFORM !== "undefined" && APP_PLATFORM
      ? APP_PLATFORM
      : (typeof window !== "undefined" &&
          window.Capacitor &&
          typeof window.Capacitor.getPlatform === "function"
          ? window.Capacitor.getPlatform()
          : "web");

  let nativePlugin = null;
  if (
    typeof window !== "undefined" &&
    window.Capacitor &&
    window.Capacitor.Plugins
  ) {
    nativePlugin =
      window.Capacitor.Plugins.ColspotNative ||
      window.Capacitor.Plugins.ColspotNativePlugin ||
      null;
  }
  if (!nativePlugin && typeof window !== "undefined" && window.Plugins) {
    nativePlugin =
      window.Plugins.ColspotNative ||
      window.Plugins.ColspotNativePlugin ||
      null;
  }

  if (
    platform === "android" &&
    nativePlugin &&
    typeof nativePlugin.getDeviceId === "function"
  ) {
    try {
      const result = await nativePlugin.getDeviceId();
      if (result && typeof result.value === "string" && result.value.trim() !== "") {
        newId = result.value.trim();
      }
    } catch (err) {
      console.error("Android native device id error:", err);
    }
  }

  if (platform === "ios") {
    if (!newId && nativePlugin && typeof nativePlugin.getDeviceId === "function") {
      try {
        const result = await nativePlugin.getDeviceId();
        const raw =
          (result &&
            (result.value || result.identifier || result.id || result.uuid)) ||
          "";

        if (raw && typeof raw === "string" && raw.trim() !== "") {
          newId = raw.trim();
        }
      } catch (err) {
        console.error("iOS native device id error:", err);
      }
    }

    if (
      !newId &&
      typeof window !== "undefined" &&
      window.Capacitor &&
      window.Capacitor.Plugins &&
      window.Capacitor.Plugins.Device &&
      typeof window.Capacitor.Plugins.Device.getId === "function"
    ) {
      try {
        const result = await window.Capacitor.Plugins.Device.getId();
        const raw = (result && (result.identifier || result.uuid || result.id)) || "";
        if (raw && typeof raw === "string" && raw.trim() !== "") {
          newId = "I-" + raw.trim();
        }
      } catch (err) {
        console.error("Device.getId error:", err);
      }
    }
  }

  if (!newId) {
    newId = "B-" + generateRandomId();
  }

  try {
    if (typeof window !== "undefined" && window.localStorage) {
      window.localStorage.setItem(storageKey, newId);
    }
  } catch (e) {
    console.error("Could not save device id to localStorage:", e);
  }

  return newId;
}

async function getDeviceName() {
  try {
    if (
      typeof window !== "undefined" &&
      window.Capacitor &&
      window.Capacitor.Plugins &&
      window.Capacitor.Plugins.Device &&
      typeof window.Capacitor.Plugins.Device.getInfo === "function"
    ) {
      const info = await window.Capacitor.Plugins.Device.getInfo();
      const platform = (info.platform || APP_PLATFORM || "").toLowerCase();

      if (platform === "ios") {
        return "iPhone";
      }

      let name = (info.model || info.name || "").trim();
      if (!name) {
        name = "Android device";
      }
      return name;
    }
  } catch (err) {
    console.error("getDeviceName failed:", err);
  }

  if (APP_PLATFORM === "ios") return "iPhone";
  if (APP_PLATFORM === "android") return "Android device";
  return "Browser";
}

async function linkDeviceForSession(session) {
  if (!session || !session.user || !window.supabase) return;

  const userId = session.user.id;
  const deviceId = await getOrCreateDeviceId();
  const deviceName = await getDeviceName();

  if (!deviceId) {
    throw new Error("We couldn’t get a device ID. Please try again.");
  }

  const { data: byDevice, error: errA } = await supabase
    .from("user_devices")
    .select("id,user_id,device_id")
    .eq("device_id", deviceId);

  if (errA) {
    console.error("user_devices by device error:", errA);
    throw new Error(MSG.DEVICE_REGISTER_FAIL);
  }

  if (byDevice && byDevice.length > 0) {
    const row = byDevice[0];
    if (row.user_id !== userId) {
      throw new Error(MSG.DEVICE_CONFLICT);
    } else {
      return;
    }
  }

  const { data: byUser, error: errB } = await supabase
    .from("user_devices")
    .select("id,device_id")
    .eq("user_id", userId);

  if (errB) {
    console.error("user_devices by user error:", errB);
    throw new Error(MSG.DEVICE_REGISTER_FAIL);
  }

  if (byUser && byUser.length >= 2) {
    throw new Error(MSG.DEVICE_LIMIT);
  }

  const { error: insertErr } = await supabase.from("user_devices").insert({
    user_id: userId,
    device_id: deviceId,
    device_name: deviceName,
  });

  if (insertErr) {
    console.error("user_devices insert error:", insertErr);
    const msg = (insertErr.message || "").toLowerCase();

    if (msg.includes("user_devices_device_id_key")) {
      throw new Error(MSG.DEVICE_CONFLICT);
    }
    if (msg.includes("user_devices_user_id_key")) {
      throw new Error(MSG.DEVICE_LIMIT);
    }
    if (msg.includes("already linked 2 phones")) {
      throw new Error(MSG.DEVICE_LIMIT);
    }

    throw new Error(MSG.DEVICE_REGISTER_FAIL);
  }
}

/* ----------------------------
 * Login analytics helper
