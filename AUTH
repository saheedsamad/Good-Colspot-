 * ---------------------------- */
function saveAuthRole(role) {
  try {
    localStorage.setItem(AUTH_ROLE_KEY, role || "");
  } catch (e) {
    console.error("Could not save auth role:", e);
  }
}

function getAuthRole() {
  try {
    return localStorage.getItem(AUTH_ROLE_KEY) || "";
  } catch (e) {
    console.error("Could not get auth role:", e);
    return "";
  }
}

function getSignupRole() {
  const roleSelect =
    document.getElementById("signup-role") ||
    document.getElementById("lecturer-signup-role");

  const raw = (roleSelect?.value || "lecturer").toLowerCase().trim();
  return raw === "student" ? "student" : "lecturer";
}

function getSignupDept() {
  return (
    document.getElementById("signup-dept")?.value?.trim() ||
    document.getElementById("signup-department")?.value?.trim() ||
