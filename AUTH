/* ----------------------------
 * Lecturer sign in
 * ---------------------------- */
const signinFormEl = document.getElementById("signin-form");
if (signinFormEl) {
  signinFormEl.addEventListener("submit", async (e) => {
    e.preventDefault();
saveAuthRole("lecturer");
saveAuthIntent("signin");
    const email = document.getElementById("signin-email")?.value?.trim() || "";
    const password = document.getElementById("signin-password")?.value || "";
    const msgEl = document.getElementById("signin-message");
    msgEl.textContent = "";
    msgEl.className = "message";

    const rule = getVersionRuleCache();
    if (rule && rule.mode === "hard") {
      msgEl.textContent = MSG.VERSION_HARD_BLOCK;
      msgEl.className = "message error";
      return;
    }

    if (!email || !password) {
      msgEl.textContent = MSG.SIGNIN_MISSING_FIELDS;
      msgEl.className = "message error";
      return;
    }

    if (isBrowserOffline()) {
      updateOfflineUI();
      msgEl.textContent = MSG.OFFLINE_SIGNIN;
      msgEl.className = "message error";
      return;
    }

    if (!window.supabase) {
      msgEl.textContent = MSG.AUTH_NOT_READY;
      msgEl.className = "message error";
      return;
    }

    try {
      setButtonLoading("signin-btn", "signin-text", "signin-loader", true);

      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        if (isLikelyOfflineError(error)) {
          updateOfflineUI();
          msgEl.textContent = MSG.OFFLINE_SIGNIN;
        } else {
          const lower = (error.message || "").toLowerCase();
          if (lower.includes("invalid login credentials")) {
            msgEl.textContent = MSG.SIGNIN_INVALID_CREDENTIALS;
          } else {
            msgEl.textContent = MSG.SIGNIN_GENERIC;
          }
        }
        msgEl.className = "message error";
        return;
      }

      if (data && data.session && data.session.user) {
        try {
          await linkDeviceForSession(data.session);
        } catch (deviceErr) {
          await supabase.auth.signOut();
          clearLocalUser();
          msgEl.textContent = deviceErr.message || MSG.DEVICE_REGISTER_FAIL;
          msgEl.className = "message error";
          return;
        }

        localStorage.setItem(
          "colspot_last_user",
          JSON.stringify({
            id: data.session.user.id,
            email: data.session.user.email,
          })
        );

        await recordLoginEvent(data.session);
        saveLocalUserFromSession(data.session);
        await resolveUserRole(data.session.user.id, data.session.user.email || email);
      }

      goToAuthCallback();
    } catch (err) {
      console.error(err);
      if (isLikelyOfflineError(err)) {
        updateOfflineUI();
        msgEl.textContent = MSG.OFFLINE_SIGNIN;
      } else {
        msgEl.textContent = MSG.SIGNIN_GENERIC;
      }
      msgEl.className = "message error";
    } finally {
      setButtonLoading("signin-btn", "signin-text", "signin-loader", false);
    }
  });
}

