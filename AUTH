      console.error(err);
      if (isLikelyOfflineError(err)) {
        updateOfflineUI();
        msgEl.textContent = MSG.SIGNUP_SEND_CODE_FAIL;
      } else {
        msgEl.textContent = MSG.SIGNUP_SEND_CODE_FAIL;
      }
      msgEl.className = "message error";
      pendingSignup = null;
    } finally {
      setButtonLoading("signup-btn", "signup-text", "signup-loader", false);
    }
  });
