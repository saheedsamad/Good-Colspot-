/* ----------------------------
 * Save role profile into tables
 * ---------------------------- */
async function saveSignupAccountRow(userId, signupData, userEmail) {
  if (!userId || !signupData || !window.supabase) {
    throw new Error("Missing signup data");
  }

  const {
    fullName,
    role,
    schoolName,
    dept,
    accountId
  } = signupData;

  const emailToSave = (userEmail || signupData.email || "").trim().toLowerCase();

  if (role === "student") {
    const payload = {
      user_id: userId,
      full_name: fullName,
      school_name: schoolName,
      department: dept || "",
      matric_number: accountId,
      email: emailToSave
    };

    const { error } = await supabase
      .from("student_accounts")
      .upsert(payload, { onConflict: "user_id" });

    if (error) throw error;
    return;
  }

  if (role === "lecturer") {
    const payload = {
      user_id: userId,
      full_name: fullName,
      school_name: schoolName,
      department: dept || "",
      staff_id: accountId,
      email: emailToSave
    };

    const { error } = await supabase
      .from("lecturer_accounts")
      .upsert(payload, { onConflict: "user_id" });

    if (error) throw error;
    return;
  }

  throw new Error("Invalid role selected");
}

