    const matric = (document.getElementById("nearStudentMatric")?.value || "").trim();
    const dept = (document.getElementById("nearStudentDept")?.value || "").trim();

    if (!matric) {
      showNearbyJoinError("Please enter your matric number.");
      return;
    }
    if (!dept) {
      showNearbyJoinError("Please enter your department.");
      return;
    }

    const user = pendingStudentProfileUser;
    const fullName =
      (user.user_metadata && user.user_metadata.full_name) ||
      user.email ||
      "Student";

    try {
      const { error } = await supabase.from("student_profiles").insert([
        {
          user_id: user.id,
          full_name: fullName,
          matric_number: matric,
          department: dept,
        },
      ]);

      if (error) {
        showNearbyJoinError(
          "We couldn't save your details. Please check your internet and try again."
        );
        return;
      }

      showStudentDetailsForm(false);
      clearNearbyJoinMessages();

      pendingNearbyJoinData = {
        studentName: fullName,
        studentMatric: matric,
        studentDepartment: dept,
      };

      const sessionLabel = selectedNearbySession.course_code || "Attendance session";
      const title = document.getElementById("nearConfirmTitle");
      const sLine = document.getElementById("nearConfirmSessionLine");
      const nLine = document.getElementById("nearConfirmNameLine");
      const mLine = document.getElementById("nearConfirmMatricLine");
      const dLine = document.getElementById("nearConfirmDeptLine");

      if (title) title.textContent = "Join " + sessionLabel;
      if (sLine) sLine.textContent = "Session: " + sessionLabel;
      if (nLine) nLine.textContent = "Name: " + fullName;
      if (mLine) mLine.textContent = "Matric: " + matric;
      if (dLine) dLine.textContent = "Department: " + dept;

      showNearSubscreen("confirm");
    } catch (e) {
      showNearbyJoinError(
        "We couldn't save your details. Please check your internet and try again."
      );
    }
  }

  function startFaceVerificationFlow() {
    if (!selectedNearbySession || !pendingNearbyJoinData) {
      showNearSubscreen("join");
      showNearbyJoinError("Missing attendance details. Please try again.");
      return;
    }

    const payload = {
      selectedNearbySession,
      pendingNearbyJoinData,
      savedAt: new Date().toISOString(),
    };

    savePendingNearbyJoinContext(payload);

    const returnTo = getNearbyReturnPage();
    const url = new URL(FACE_VERIFY_PAGE_URL, window.location.href);

    url.searchParams.set("returnTo", returnTo);
    url.searchParams.set("sessionId", selectedNearbySession.id || "");
    url.searchParams.set("courseCode", selectedNearbySession.course_code || "");
    url.searchParams.set("threshold", "0.70");

    window.location.href = url.toString();
  }

  async function confirmNearbyJoin() {
    if (!pendingNearbyJoinData || !selectedNearbySession) {
      showNearSubscreen("join");
      showNearbyJoinError("Something went wrong. Please try again.");
      return;
    }

    if (isColspotOffline()) {
      showNearSubscreen("join");
      showNearbyJoinError("No internet connection. Please connect and try again.");
      return;
    }

    if (typeof supabase === "undefined") {
      showNearSubscreen("join");
      showNearbyJoinError(
        "We couldn't connect to the server. Please check your internet and try again."
      );
      return;
    }

    try {
      if (selectedNearbySession.expires_at) {
        const end = new Date(selectedNearbySession.expires_at);
        const now = new Date();
        if (end < now) {
          showNearSubscreen("join");
          showNearbyJoinError("This attendance session has ended.");
          return;
        }
      }
    } catch (_) {}

    const confirmBtn = document.getElementById("nearConfirmOk");
    const cancelBtn = document.getElementById("nearConfirmCancel");
    const closeBtn = document.getElementById("nearConfirmClose");

    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.textContent = "Opening...";
    }
    if (cancelBtn) cancelBtn.disabled = true;
    if (closeBtn) closeBtn.disabled = true;

    try {
      const { user, networkIssue } = await getNearbyCurrentUser();

      if (networkIssue) {
        showNearSubscreen("join");
        showNearbyJoinError("Network is bad. Please check your data and try again.");
        return;
      }

      if (!user) {
        showNearSubscreen("join");
        showNearbyJoinError("Session expired. Please sign in again.");
        return;
      }

      const verificationCheck = await ensureTopVerificationBeforeJoin();
      if (!verificationCheck.ok) {
        showNearSubscreen("join");
        showNearbyJoinError(verificationCheck.message);
        return;
      }

      startFaceVerificationFlow();
    } catch (e) {
      showNearSubscreen("join");
      showNearbyJoinError("We couldn't open face verification. Please try again.");
    } finally {
      if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.textContent = "OK";
      }
      if (cancelBtn) cancelBtn.disabled = false;
      if (closeBtn) closeBtn.disabled = false;
    }
  }

  async function finalizeNearbyJoinAfterFaceVerify(verifyData) {
    if (nearbyFinalizingJoin) return;

    const context = readPendingNearbyJoinContext();
    if (!verifyData || !context) return;

    nearbyFinalizingJoin = true;

    selectedNearbySession = context.selectedNearbySession || null;
    pendingNearbyJoinData = context.pendingNearbyJoinData || null;

    if (!selectedNearbySession || !pendingNearbyJoinData) {
      clearPendingNearbyJoinContext();
      nearbyFinalizingJoin = false;
      showNearSubscreen("join");
      showNearbyJoinError("Missing attendance details after face verification. Please try again.");
      return;
    }

    if (!verifyData.ok || !verifyData.faceMatch) {
      clearPendingNearbyJoinContext();
      nearbyFinalizingJoin = false;
      showNearSubscreen("join");
      showNearbyJoinError(verifyData.error || "Face verification failed. Please try again.");
      return;
    }

    setNearbyStatus("Face verified. Completing attendance...");
    showNearSubscreen("list");
    showNearbyGlobalBanner("Face verified. Completing your attendance...");

    try {
      const { user, networkIssue } = await getNearbyCurrentUser();

      if (networkIssue) {
        clearPendingNearbyJoinContext();
        showNearSubscreen("join");
        showNearbyGlobalBanner("");
        showNearbyJoinError(
          "Face verified, but network is bad. Please check your internet and try again."
        );
        return;
      }

      if (!user) {
        clearPendingNearbyJoinContext();
        showNearSubscreen("join");
        showNearbyGlobalBanner("");
        showNearbyJoinError("Session expired. Please sign in again.");
        return;
      }

      try {
        if (selectedNearbySession.expires_at) {
          const end = new Date(selectedNearbySession.expires_at);
          const now = new Date();
          if (end < now) {
            clearPendingNearbyJoinContext();
            showNearSubscreen("join");
            showNearbyGlobalBanner("");
            showNearbyJoinError("This attendance session has ended.");
            return;
          }
        }
      } catch (_) {}

      const { studentName, studentMatric, studentDepartment } = pendingNearbyJoinData;

      let joinLat = null;
      let joinLng = null;
      let joinAccuracy = null;
      let joinDistance = null;

      try {
        let pos = null;
        if (typeof getSmartLocation === "function") {
          pos = await getSmartLocation(3, 100);
        } else if (typeof getCurrentPositionOnce === "function") {
          pos = await getCurrentPositionOnce();
        }

        if (pos && pos.coords) {
          joinLat =
            typeof pos.coords.latitude === "number" ? pos.coords.latitude : null;
          joinLng =
            typeof pos.coords.longitude === "number" ? pos.coords.longitude : null;

          if (
            typeof pos.coords.accuracy === "number" &&
            !Number.isNaN(pos.coords.accuracy)
          ) {
            joinAccuracy = pos.coords.accuracy;
          }

          if (
            typeof distanceInMeters === "function" &&
            joinLat !== null &&
            joinLng !== null &&
            typeof selectedNearbySession.latitude === "number" &&
            typeof selectedNearbySession.longitude === "number"
          ) {
            joinDistance = distanceInMeters(
              joinLat,
              joinLng,
              selectedNearbySession.latitude,
              selectedNearbySession.longitude
            );
          }
        }
      } catch (locErr) {
        console.warn("Nearby join location error:", locErr);
      }

      const payload = {
        session_id: selectedNearbySession.id,
        user_id: user.id,
        student_name: studentName || null,
        student_matric: studentMatric || null,
        student_department: studentDepartment || null,
        checked_in_at: new Date().toISOString(),
        latitude: joinLat,
        longitude: joinLng,
        accuracy_meters: joinAccuracy,
        distance_meters: joinDistance,
        face_match: true,
        face_similarity: Number(verifyData.similarity || 0),
        face_verified_at: new Date().toISOString(),
      };

      const { error } = await supabase.from("attendance_records").insert([payload]);

      if (error) {
        clearPendingNearbyJoinContext();
        showNearSubscreen("join");
        showNearbyGlobalBanner("");

        const msg = String(error.message || "").toLowerCase();
        const code = error.code || "";

        if (
          code === "23505" ||
          msg.includes("duplicate key") ||
          msg.includes("already joined")
        ) {
          showNearbyJoinError("You have already joined this attendance.");
        } else if (msg.includes("expired")) {
          showNearbyJoinError("This attendance session has ended.");
        } else {
          showNearbyJoinError(
            "Face verified, but we couldn't save your attendance. Please try again."
          );
        }
        return;
      }

      const historyEntry = {
        session_id: selectedNearbySession.id,
        course_code: selectedNearbySession.course_code || "",
        course_title: selectedNearbySession.course_title || "",
        lecturer_name: selectedNearbySession.lecturer_name || "",
        attended_at: new Date().toISOString(),
        pin_used: String(selectedNearbySession.pin_code || ""),
        student_name: studentName || "",
        student_matric: studentMatric || "",
        student_department: studentDepartment || "",
        face_match: true,
        face_similarity: Number(verifyData.similarity || 0),
      };

      addToStudentHistory(historyEntry);

      clearPendingNearbyJoinContext();
      showNearSubscreen("list");
      clearNearbyJoinMessages();
      showStudentDetailsForm(false);

      const courseLabel =
        selectedNearbySession.course_code ||
        selectedNearbySession.course_title ||
        "this class";
      const lecturer = (selectedNearbySession.lecturer_name || "").trim();

      let congrats = "Congratulations, you have joined " + courseLabel + " attendance";
      if (lecturer) congrats += " under " + lecturer + ".";
      else congrats += ".";

      showNearbyGlobalBanner(congrats);
      setNearbyStatus("Attendance joined successfully.");
      loadNearbySessions();
    } catch (e) {
      clearPendingNearbyJoinContext();
      showNearSubscreen("join");
      showNearbyGlobalBanner("");
      showNearbyJoinError(
        "Face verified, but something went wrong while completing attendance. Please try again."
      );
    } finally {
      nearbyFinalizingJoin = false;
    }
  }

  function handleFaceVerificationReturn() {
    const params = new URLSearchParams(window.location.search);
    const flag = params.get("faceVerified");
    const similarity = params.get("similarity");
    const threshold = params.get("threshold");
    const context = readPendingNearbyJoinContext();

    if (flag === "0") {
      clearPendingNearbyJoinContext();
      cleanNearbyReturnQueryFlags();
      showNearSubscreen("join");
      showNearbyJoinError("Face verification was cancelled. Please try again.");
      return true;
    }

    if (flag === "1" && context) {
      cleanNearbyReturnQueryFlags();
      finalizeNearbyJoinAfterFaceVerify({
        ok: true,
        faceMatch: true,
        similarity: Number(similarity || 0),
        threshold: Number(threshold || 0.7),
      });
      return true;
    }

    return false;
  }

  function filterNonLocationSessions() {
    const term = (nearNonLocationSearchTerm || "").trim().toLowerCase();
    if (!term) return lastNonLocationSessions.slice();

    return lastNonLocationSessions.filter((s) => {
      const code = (s.course_code || "").toLowerCase();
      const title = (s.course_title || "").toLowerCase();
      const lect = (s.lecturer_name || "").toLowerCase();
      return code.includes(term) || title.includes(term) || lect.includes(term);
    });
  }

  async function loadNearbySessions() {
    const listEl = document.getElementById("nearSessionList");
    if (!listEl) return;

    const outerScreen = document.getElementById("screen-nearby");
    if (outerScreen && !outerScreen.classList.contains("active")) return;

    if (typeof supabase === "undefined") {
      setNearbyStatus(
        "We couldn't connect to the server yet. Please check your internet connection."
      );
      if (nearCurrentMode === "location" && !lastNearbySessions.length) {
        showNearbyEmpty(true);
      }
      if (nearCurrentMode === "nonlocation" && !lastNonLocationSessions.length) {
        showNearbyEmpty(true);
      }
      return;
    }

    if (isColspotOffline()) {
      setNearbyStatus("No internet connection. We'll keep showing the last sessions we found.");
      return;
    }

    const loadId = ++nearbyLoadSeq;

    const topMsg = document.getElementById("nearTopMessageText");
    const locationNote = document.getElementById("nearLocationNote");

    if (nearCurrentMode === "location") {
      if (lastNearbySessions.length) setNearbyStatus("Updating nearby sessions…");
      else setNearbyStatus("Getting your location...");

      if (topMsg) {
        topMsg.textContent = "Colspot is looking for nearby attendance sessions around you…";
      }
      if (locationNote) {
        locationNote.innerHTML =
          "<strong>Colspot uses your location to find the right classes.</strong><br />Please allow location when asked, turn Location ON, and check that your internet connection is working.";
      }
    } else {
      setNearbyStatus("Loading non-location attendance sessions…");
      if (topMsg) {
        topMsg.textContent =
          "Showing non-location attendance sessions. Use search to find your class.";
      }
      if (locationNote) {
        locationNote.innerHTML =
          "<strong>Location is not required for these sessions.</strong><br />Your lecturer may ask you to join with a PIN only.";
      }
    }

    if (nearCurrentMode === "nonlocation") {
      try {
        const nowIso = new Date().toISOString();
        const { data, error } = await supabase
          .from("attendance_sessions")
          .select("id, course_code, course_title, lecturer_name, expires_at, pin_code, use_location")
          .gte("expires_at", nowIso)
          .eq("use_location", false)
          .order("expires_at", { ascending: true });

        if (loadId !== nearbyLoadSeq) return;

        if (error) {
          setNearbyStatus(
            "We couldn't load non-location attendance right now. Please check your internet connection."
          );
          return;
        }

        lastNonLocationSessions = (data || []).slice();

        const filtered = filterNonLocationSessions();
        if (!filtered.length) {
          setNearbyStatus("No non-location attendance sessions found right now.");
        } else {
          setNearbyStatus(
            "Showing " +
              filtered.length +
              " non-location attendance session" +
              (filtered.length > 1 ? "s." : ".")
          );
        }

        renderNearbySessionList(filtered);
      } catch (e) {
        setNearbyStatus(
          "We couldn't load non-location attendance right now. Please check your internet connection."
        );
      }
      return;
    }

    let loc = null;
    lastNearbyLocationError = null;
    const startedAt = Date.now();

    try {
      const locPromise = (async () => {
        if (typeof getSmartLocation === "function") {
          const pos = await getSmartLocation(5, 100);
          if (pos && pos.coords) {
            return { lat: pos.coords.latitude, lng: pos.coords.longitude };
          }
        } else if (typeof getCurrentPositionOnce === "function") {
          const pos = await getCurrentPositionOnce();
          if (pos && pos.coords) {
            return { lat: pos.coords.latitude, lng: pos.coords.longitude };
          }
        }
        return null;
      })();

      loc = await Promise.race([
        locPromise,
        new Promise((resolve) => setTimeout(() => resolve(null), NEARBY_LOCATION_TIMEOUT_MS)),
      ]);
    } catch (e) {
      loc = null;
    }

    const elapsed = Date.now() - startedAt;
    const errCode = lastNearbyLocationError;

    if (!loc) {
      if (errCode === "PERMISSION_DENIED") {
        setNearbyStatus(
          "Location permission is blocked. Please allow Location for Colspot in your phone Settings, then come back and tap Refresh."
        );
      } else if (errCode === "POSITION_UNAVAILABLE" || errCode === "TIMEOUT") {
        setNearbyStatus(
          "We couldn’t get your location yet. Make sure you turn on your location and have good network. Also check your internet connection and make sure Airplane mode is turned off."
        );
      } else if (elapsed >= NEARBY_LOCATION_TIMEOUT_MS) {
        setNearbyStatus(
          "We couldn’t get your location yet. Turn Location ON and try again. If it’s already ON, check your internet and try again."
        );
      } else {
        setNearbyStatus(
          "We couldn’t get your location yet. Turn Location ON and try again. If it’s already ON, check your internet and try again."
        );
      }

      if (!lastNearbySessions.length) showNearbyEmpty(true);
      return;
    }

    const { lat, lng } = loc;

    try {
      const nowIso = new Date().toISOString();
      const { data, error } = await supabase
        .from("attendance_sessions")
        .select("id, course_code, course_title, lecturer_name, expires_at, latitude, longitude, pin_code, use_location")
        .gte("expires_at", nowIso)
        .eq("use_location", true);

      if (loadId !== nearbyLoadSeq) return;

      if (error) {
        setNearbyStatus(
          "We couldn't refresh nearby sessions right now. Please check your internet connection. We'll keep showing the last ones we found."
        );
        return;
      }

      const sessions = (data || []).filter(
        (s) =>
          typeof s.latitude === "number" &&
          typeof s.longitude === "number" &&
          s.expires_at
      );

      if (!sessions.length) {
        lastNearbySessions = [];
        seenNearbySessionIds = [];
        setNearbyStatus("No active attendance sessions near your location.");
        renderNearbySessionList([]);
        return;
      }

      let withDistance = sessions.map((s) => {
        let distance = 0;
        if (typeof distanceInMeters === "function") {
          distance = distanceInMeters(lat, lng, s.latitude, s.longitude);
        }
        return { ...s, distance };
      });

      let nearbyNow = withDistance.filter(
        (s) => s.distance <= NEARBY_FULL_RADIUS_METERS
      );

      nearbyNow.forEach((s) => markSessionSeen(s.id));

      let combined = withDistance.filter((s) => seenNearbySessionIds.includes(s.id));

      if (!combined.length) {
        lastNearbySessions = [];
        setNearbyStatus("No active attendance sessions near your location.");
        renderNearbySessionList([]);
        return;
      }

      lastNearbySessions = combined.slice();

      setNearbyStatus(
        "Found " +
          combined.length +
          " active session" +
          (combined.length > 1 ? "s" : "") +
          " near you (based on your recent location)."
      );

      renderNearbySessionList(combined);
    } catch (e) {
      setNearbyStatus(
        "We couldn't load nearby attendance right now. Please check your internet connection. We'll keep showing the last sessions we found."
      );
    }
  }

  function switchNearbyMode(mode) {
    if (mode !== "location" && mode !== "nonlocation") return;
    if (nearCurrentMode === mode) return;

    nearCurrentMode = mode;
    showNearSubscreen("list");
    showNearbyGlobalBanner("");
    clearNearbyJoinMessages();
    showStudentDetailsForm(false);

    const btnLoc = document.getElementById("nearModeLocation");
    const btnNon = document.getElementById("nearModeNonLocation");
    const searchRow = document.getElementById("nearSearchRow");

    if (btnLoc && btnNon) {
      btnLoc.classList.toggle("active", mode === "location");
      btnNon.classList.toggle("active", mode === "nonlocation");
    }

    if (searchRow) {
      if (mode === "nonlocation") searchRow.classList.remove("near-hidden");
      else searchRow.classList.add("near-hidden");
    }

    clearNearbySessions();
    showNearbyEmpty(false);

    loadNearbySessions();
  }

  document.addEventListener("DOMContentLoaded", () => {
    const refreshBtn = document.getElementById("nearRefreshBtn");
    if (refreshBtn) refreshBtn.addEventListener("click", loadNearbySessions);

    const joinBtn = document.getElementById("nearJoinSubmit");
    if (joinBtn) joinBtn.addEventListener("click", prepareNearbyConfirm);

    const confirmOk = document.getElementById("nearConfirmOk");
    if (confirmOk) confirmOk.addEventListener("click", confirmNearbyJoin);

    const confirmCancel = document.getElementById("nearConfirmCancel");
    if (confirmCancel) {
      confirmCancel.addEventListener("click", () => showNearSubscreen("join"));
    }

    const confirmClose = document.getElementById("nearConfirmClose");
    if (confirmClose) {
      confirmClose.addEventListener("click", () => showNearSubscreen("join"));
    }

    const joinClose = document.getElementById("nearJoinClose");
    if (joinClose) {
      joinClose.addEventListener("click", () => {
        showNearSubscreen("list");
        clearNearbyJoinMessages();
        showStudentDetailsForm(false);
      });
    }

    const studentSave = document.getElementById("nearStudentSave");
    if (studentSave) {
      studentSave.addEventListener("click", saveStudentDetailsAndContinue);
    }

    const btnModeLoc = document.getElementById("nearModeLocation");
    const btnModeNon = document.getElementById("nearModeNonLocation");

    if (btnModeLoc) {
      btnModeLoc.addEventListener("click", () => switchNearbyMode("location"));
    }
    if (btnModeNon) {
      btnModeNon.addEventListener("click", () => switchNearbyMode("nonlocation"));
    }

    const searchInput = document.getElementById("nearSearchInput");
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        nearNonLocationSearchTerm = e.target.value || "";
        if (nearCurrentMode === "nonlocation") {
          const filtered = filterNonLocationSessions();
          renderNearbySessionList(filtered);
          if (filtered.length) {
            setNearbyStatus(
              "Showing " +
                filtered.length +
                " non-location attendance session" +
                (filtered.length > 1 ? "s." : ".")
            );
          } else {
            setNearbyStatus("No non-location attendance sessions match your search.");
          }
        }
      });
    }

    const navNearby = document.querySelector('.nav-btn[data-nav="nearby"]');
    if (navNearby) {
      navNearby.addEventListener("click", () => {
        setTimeout(() => {
          loadNearbySessions();
          loadNearbyVerificationState(true);
        }, 0);
      });
    }

    const homeOpenBtn = document.querySelector(".nearby-open-btn");
    if (homeOpenBtn) {
      homeOpenBtn.addEventListener("click", () => {
        setTimeout(() => {
          loadNearbySessions();
          loadNearbyVerificationState(true);
        }, 0);
      });
    }

    const courseFormBtn = document.getElementById("nearVerifyCourseFormBtn");
    if (courseFormBtn) {
      courseFormBtn.addEventListener("click", openCourseFormPage);
    }

    const biometricBtn = document.getElementById("nearVerifyBiometricBtn");
    if (biometricBtn) {
      biometricBtn.addEventListener("click", openBiometricPage);
    }

    handleFaceVerificationReturn();

    setInterval(() => {
      const outer = document.getElementById("screen-nearby");
      if (outer && outer.classList.contains("active")) {
        loadNearbySessions();
      }
    }, NEARBY_REFRESH_INTERVAL_MS);

    loadNearbySessions();
    loadNearbyVerificationState(true);
  });
</script>
