<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Face Capture</title>

  <style>
    :root{
      --bg:#edf3ff;
      --panel:#f4f7ff;
      --card:#ffffff;
      --text:#182033;
      --muted:#7a8499;
      --line:#dfe7f6;
      --blue:#4c83f6;
      --blue-dark:#316df0;
      --green:#22c55e;
      --green-soft:#dcfce7;
      --red:#dc2626;
      --red-soft:#fee2e2;
      --shadow:0 18px 40px rgba(76,131,246,.12);
      --shadow-soft:0 10px 24px rgba(15,23,42,.08);
      --safe-top:env(safe-area-inset-top, 0px);
      --safe-bottom:env(safe-area-inset-bottom, 0px);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html, body{
      margin:0;
      padding:0;
      min-height:100%;
      background:#e9eef7;
      color:var(--text);
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body{
      display:flex;
      justify-content:center;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }

    button,
    input,
    select,
    textarea{
      font:inherit;
    }

    .face-page{
      width:100%;
      max-width:430px;
      min-height:100vh;
      background:var(--bg);
      padding:
        calc(10px + var(--safe-top))
        14px
        calc(18px + var(--safe-bottom));
    }

    .fc-header{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:14px;
    }

    .fc-back-btn{
      width:42px;
      height:42px;
      border:none;
      border-radius:14px;
      background:#f1f4fb;
      box-shadow:inset 0 0 0 1px rgba(24,32,51,.04);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      cursor:pointer;
    }

    .fc-back-btn svg{
      width:20px;
      height:20px;
      color:#3b455c;
    }

    .fc-header-title{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.02em;
      color:#20283a;
    }

    .fc-main-card{
      background:var(--panel);
      border-radius:34px;
      padding:18px 16px 16px;
      box-shadow:var(--shadow);
      border:1px solid rgba(255,255,255,.55);
    }

    .fc-camera-card{
      margin:0;
      padding:0;
      background:transparent;
      border:none;
      box-shadow:none;
    }

    .fc-camera-shell{
      position:relative;
      width:100%;
      aspect-ratio:1/1.08;
      min-height:320px;
      border-radius:28px;
      overflow:hidden;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,.65), rgba(255,255,255,0) 24%),
        linear-gradient(180deg,#dcecff 0%, #c8dcf9 100%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.65);
    }

    .fc-camera-video,
    .fc-overlay-canvas,
    .fc-capture-canvas,
    .fc-capture-preview{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .fc-camera-video{
      display:block;
      background:transparent;
      transform:scaleX(-1);
      z-index:1;
    }

    .fc-overlay-canvas{
      z-index:3;
      pointer-events:none;
    }

    .fc-capture-canvas{
      display:none;
    }

    .fc-capture-preview{
      z-index:4;
      display:block;
      background:transparent;
    }

    .fc-capture-preview.hidden{
      display:none !important;
    }

    .fc-camera-overlay{
      position:absolute;
      inset:0;
      z-index:5;
      display:flex;
      align-items:center;
      justify-content:center;
      pointer-events:none;
    }

    .fc-frame{
      width:78%;
      height:78%;
      border-radius:30px;
      border:2px dashed rgba(123,170,239,.55);
      position:relative;
      box-shadow:inset 0 0 0 999px rgba(255,255,255,.04);
    }

    .fc-corner{
      position:absolute;
      width:42px;
      height:42px;
      border:5px solid rgba(255,255,255,.92);
      border-radius:14px;
    }

    .fc-corner.tl{
      top:-2px;
      left:-2px;
      border-right:none;
      border-bottom:none;
    }

    .fc-corner.tr{
      top:-2px;
      right:-2px;
      border-left:none;
      border-bottom:none;
    }

    .fc-corner.bl{
      bottom:-2px;
      left:-2px;
      border-right:none;
      border-top:none;
    }

    .fc-corner.br{
      right:-2px;
      bottom:-2px;
      border-left:none;
      border-top:none;
    }

    .fc-camera-placeholder{
      position:absolute;
      inset:0;
      z-index:2;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .fc-camera-placeholder-icon{
      width:84px;
      height:84px;
      border-radius:22px;
      background:rgba(255,255,255,.20);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#7da7dd;
      backdrop-filter:blur(8px);
    }

    .fc-camera-placeholder-icon svg{
      width:34px;
      height:34px;
    }

    .fc-live-pill{
      position:absolute;
      left:50%;
      bottom:18px;
      transform:translateX(-50%);
      z-index:6;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:48px;
      padding:0 18px;
      border-radius:999px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      font-size:13px;
      font-weight:700;
      box-shadow:0 10px 26px rgba(76,131,246,.28);
      text-align:center;
      max-width:92%;
    }

    .fc-step-track-wrap{
      margin:14px 2px 12px;
    }

    .fc-step-track{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:0;
      margin-bottom:12px;
    }

    .fc-step-line{
      flex:1;
      max-width:58px;
      height:4px;
      border-radius:999px;
      background:#d7dfef;
      margin:0 6px;
    }

    .fc-step-line.done{
      background:#a9dcff;
    }

    .fc-step-circle{
      width:24px;
      height:24px;
      border-radius:999px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:11px;
      font-weight:800;
      background:#d9e0ee;
      color:#8b96aa;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.55);
    }

    .fc-step-circle.active{
      background:var(--blue);
      color:#fff;
    }

    .fc-step-circle.done{
      background:#59c5dd;
      color:#fff;
    }

    .fc-step-chip{
      width:max-content;
      max-width:100%;
      margin:0 auto;
      padding:10px 16px;
      border-radius:999px;
      background:#ffffff;
      box-shadow:var(--shadow-soft);
      color:#1f2a3d;
      font-weight:700;
      font-size:13px;
      text-align:center;
      border:1px solid rgba(76,131,246,.08);
    }

    .fc-status-sub{
      margin:0 auto 12px;
      max-width:310px;
      text-align:center;
      color:var(--muted);
      font-size:.93rem;
      line-height:1.48;
    }

    .fc-status-message{
      margin:10px 0 0;
      padding:12px 14px;
      border-radius:16px;
      font-size:.90rem;
      line-height:1.45;
      font-weight:700;
    }

    .fc-status-message-error{
      background:var(--red-soft);
      color:var(--red);
      border:1px solid rgba(220,38,38,.12);
    }

    .fc-status-message-success{
      background:var(--green-soft);
      color:var(--green);
      border:1px solid rgba(22,163,74,.12);
    }

    .fc-actions-card{
      margin-top:10px;
    }

    .fc-btn{
      min-height:60px;
      width:100%;
      border:none;
      border-radius:18px;
      font-size:16px;
      font-weight:700;
      cursor:pointer;
      transition:.18s ease;
    }

    .fc-btn:disabled{
      opacity:.56;
      cursor:not-allowed;
    }

    .fc-btn-white{
      background:#ffffff;
      color:#20283a;
      box-shadow:var(--shadow-soft);
    }

    .fc-btn-primary{
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      box-shadow:0 12px 28px rgba(76,131,246,.28);
    }

    .fc-btn-secondary{
      background:#fff;
      color:#2b3447;
      box-shadow:var(--shadow-soft);
    }

    .fc-action-row{
      display:grid;
      grid-template-columns:1fr 1.2fr;
      gap:12px;
      margin-top:12px;
    }

    .fc-bottom-dots{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      margin:14px 0 8px;
    }

    .fc-bottom-dots span{
      width:7px;
      height:7px;
      border-radius:999px;
      background:#d8dfef;
    }

    .fc-bottom-dots span.active{
      width:26px;
      background:var(--blue);
    }

    .fc-help-link{
      display:block;
      width:100%;
      background:transparent;
      border:none;
      text-align:center;
      color:#7c8cab;
      font-size:14px;
      cursor:pointer;
      margin-top:6px;
    }

    .hidden{
      display:none !important;
    }

    .fc-modal{
      position:fixed;
      inset:0;
      background:rgba(12,18,32,.42);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:20px;
      z-index:9999;
    }

    .fc-modal.hidden{
      display:none !important;
    }

    .fc-modal-card{
      width:100%;
      max-width:360px;
      background:#fff;
      border-radius:24px;
      padding:22px 18px 18px;
      box-shadow:0 24px 60px rgba(15,23,42,.22);
      text-align:center;
    }

    .fc-modal-icon{
      width:62px;
      height:62px;
      margin:0 auto 12px;
      border-radius:999px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:var(--green-soft);
      color:var(--green);
      font-size:28px;
      font-weight:900;
    }

    .fc-modal-title{
      font-size:20px;
      font-weight:900;
      color:#1b2436;
      margin-bottom:8px;
    }

    .fc-modal-sub{
      font-size:14px;
      line-height:1.5;
      color:#667085;
      margin-bottom:12px;
    }

    .fc-modal-countdown{
      font-size:13px;
      font-weight:800;
      color:#316df0;
    }

    @media (max-width:380px){
      .fc-camera-shell{
        min-height:290px;
      }

      .fc-action-row{
        grid-template-columns:1fr;
      }

      .fc-header-title{
        font-size:16px;
      }
    }
  </style>
</head>
<body>
  <div class="face-page">
    <header class="fc-header">
      <button class="fc-back-btn" id="backBtn" type="button" aria-label="Go back">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.5 19.5L8 12l7.5-7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="fc-header-title">Face capture</div>
    </header>

    <section class="fc-main-card">
      <section class="fc-camera-card">
        <div class="fc-camera-shell" id="cameraShell">
          <video id="cameraVideo" class="fc-camera-video" playsinline autoplay muted></video>
          <canvas id="overlayCanvas" class="fc-overlay-canvas"></canvas>
          <canvas id="captureCanvas" class="fc-capture-canvas"></canvas>
          <img id="capturePreview" class="fc-capture-preview hidden" alt="Captured face preview" />

          <div class="fc-camera-overlay">
            <div class="fc-frame">
              <div class="fc-corner tl"></div>
              <div class="fc-corner tr"></div>
              <div class="fc-corner bl"></div>
              <div class="fc-corner br"></div>
            </div>
          </div>

          <div class="fc-camera-placeholder" id="cameraPlaceholder">
            <div class="fc-camera-placeholder-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 8.5V7.8A4.8 4.8 0 0 1 11.8 3h.4A4.8 4.8 0 0 1 17 7.8v.7M5.5 21h13A2.5 2.5 0 0 0 21 18.5v-7A2.5 2.5 0 0 0 18.5 9h-13A2.5 2.5 0 0 0 3 11.5v7A2.5 2.5 0 0 0 5.5 21Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="14.5" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </div>
          </div>

          <div class="fc-live-pill" id="cameraBadge">
            Look straight, turn left, turn right, then look straight again
          </div>
        </div>

        <div class="fc-step-track-wrap">
          <div class="fc-step-track">
            <div class="fc-step-line done"></div>
            <div class="fc-step-circle done">✓</div>
            <div class="fc-step-line done"></div>
            <div class="fc-step-circle active">2</div>
            <div class="fc-step-line"></div>
            <div class="fc-step-circle">3</div>
            <div class="fc-step-line"></div>
            <div class="fc-step-circle">4</div>
            <div class="fc-step-line"></div>
          </div>

          <div class="fc-step-chip" id="statusTitle">Look straight</div>
        </div>

        <p class="fc-status-sub" id="statusSub">
          Start your camera and follow the movement guide.
        </p>

        <div class="fc-status-message fc-status-message-error hidden" id="errorMsg"></div>
        <div class="fc-status-message fc-status-message-success hidden" id="successMsg"></div>
      </section>

      <section class="fc-actions-card">
        <button class="fc-btn fc-btn-white" id="startCameraBtn" type="button">
          Start camera
        </button>

        <div class="fc-action-row hidden" id="captureActions">
          <button class="fc-btn fc-btn-secondary" id="retakeBtn" type="button">
            Retake
          </button>

          <button class="fc-btn fc-btn-primary" id="continueBtn" type="button">
            Verify and continue
          </button>
        </div>

        <button class="fc-btn fc-btn-primary hidden" id="stopCameraBtn" type="button">
          Stop camera
        </button>

        <div class="fc-bottom-dots">
          <span></span>
          <span></span>
          <span></span>
          <span class="active"></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <button class="fc-help-link" id="whyBtn" type="button">
          Why am I doing this?
        </button>
      </section>
    </section>
  </div>

  <div class="fc-modal hidden" id="approvedModal">
    <div class="fc-modal-card">
      <div class="fc-modal-icon">✓</div>
      <div class="fc-modal-title">Verification approved</div>
      <div class="fc-modal-sub">
        Your face has been approved successfully. You will be redirected to the main page shortly.
      </div>
      <div class="fc-modal-countdown" id="modalCountdown">Redirecting in 5 seconds...</div>
    </div>
  </div>

  <script>
    window.SUPABASE_URL = "YOUR_SUPABASE_URL";
    window.SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
  </script>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js"></script>

<script>
  const BUCKET = "verification_uploads";
  const EXTRACT_FN_URL = "https://wtlrfujfimxcmsnqrnig.functions.supabase.co/extract-clearance";
  const VERIFICATION_TABLE = "verification_course_forms";
  const DUPLICATE_CHECK_TABLE = "verification_course_forms";
  const ACCOUNT_TABLE = "student_accounts";
  const FACE_TABLE = "face_profiles";
  const FACE_CAPTURE_URL = "face-capture.html";
  const MAIN_URL = "main.html";
  const INDEX_URL = "index.html";
  const DEBUG_MODE = false;

  const el = (id) => document.getElementById(id);

  function showErr(msg) {
    el("msgWarn").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgErr").style.display = "block";
    el("msgErr").textContent = msg || "";
  }

  function showOk(msg) {
    el("msgWarn").style.display = "none";
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "block";
    el("msgOk").textContent = msg || "";
  }

  function showWarn(msg) {
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgWarn").style.display = "block";
    el("msgWarn").className = "msg warn";
    el("msgWarn").textContent = msg || "";
  }

  function clearMsgs() {
    el("msgErr").style.display = "none";
    el("msgOk").style.display = "none";
    el("msgWarn").style.display = "none";
    el("msgErr").textContent = "";
    el("msgOk").textContent = "";
    el("msgWarn").textContent = "";
    el("msgWarn").className = "msg";
  }

  function setLoading(on) {
    el("loading").style.display = on ? "block" : "none";
    el("btnExtract").disabled = on || !pickedFile || verificationLocked;
    if (el("btnContinue")) el("btnContinue").disabled = on || verificationLocked;
    if (el("btnCancel")) el("btnCancel").disabled = on || verificationLocked;
    if (el("btnReset")) el("btnReset").disabled = on || verificationLocked;
    if (el("fileInput")) el("fileInput").disabled = on || verificationLocked;
  }

  function bytesToSize(bytes) {
    const sizes = ["Bytes", "KB", "MB", "GB"];
    if (!bytes && bytes !== 0) return "—";
    if (bytes === 0) return "0 Bytes";
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(1) + " " + sizes[i];
  }

  function setDebug() {}
  function clearDebug() {}

  function normalizeText(value) {
    return String(value || "").trim();
  }

  function normalizeUpper(value) {
    return String(value || "").trim().toUpperCase();
  }

  let pickedFile = null;
  let uploadedPath = null;
  let extracted = null;
  let currentUser = null;
  let verificationLocked = false;
  let verificationAlreadyExists = false;

  async function getUser() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not loaded. Check client_supabase.js");

    const { data, error } = await sb.auth.getUser();
    if (error) throw error;
    if (data && data.user) return data.user;

    try {
      const cached = JSON.parse(localStorage.getItem("colspot_local_user") || "null");
      if (cached && (cached.user_id || cached.id)) {
        return {
          id: cached.user_id || cached.id,
          email: cached.email || null
        };
      }
    } catch {}

    throw new Error("Not signed in.");
  }

  async function ensureCurrentUser() {
    if (!currentUser || !currentUser.id) {
      currentUser = await getUser();
    }

    if (!currentUser || !currentUser.id) {
      throw new Error("Could not find your account. Please sign in again.");
    }

    return currentUser;
  }

  function renderPreview(file) {
    el("preview").style.display = "flex";
    el("fileName").textContent = file.name || "Selected file";
    el("fileSize").textContent = bytesToSize(file.size);

    const thumb = el("thumb");
    thumb.innerHTML = "";

    const div = document.createElement("div");
    div.className = "pdf";
    div.textContent = "PDF";
    thumb.appendChild(div);
  }

  function paintExtracted(details) {
    el("vFullName").textContent = details?.full_name || "—";
    el("vMatric").textContent = details?.matric_no || details?.matric || "—";
    el("vSchool").textContent = normalizeUpper(details?.school_name) || "—";
    el("vDept").textContent = details?.department || "—";
    el("vProgramme").textContent = details?.programme || "—";
    el("vFaculty").textContent = details?.faculty || "—";
    el("vLevel").textContent = details?.level || "—";
    el("vSession").textContent = details?.session || "—";
    el("vSemester").textContent = details?.semester || "—";
  }

  function clearExtractedDetails() {
    extracted = null;
    uploadedPath = null;
    el("details").style.display = "none";
    el("vFullName").textContent = "—";
    el("vMatric").textContent = "—";
    el("vSchool").textContent = "—";
    el("vDept").textContent = "—";
    el("vProgramme").textContent = "—";
    el("vFaculty").textContent = "—";
    el("vLevel").textContent = "—";
    el("vSession").textContent = "—";
    el("vSemester").textContent = "—";
  }

  function lockVerificationUi() {
    verificationLocked = true;

    if (el("fileInput")) el("fileInput").disabled = true;
    if (el("btnExtract")) el("btnExtract").disabled = true;
    if (el("btnReset")) el("btnReset").disabled = true;
    if (el("btnContinue")) el("btnContinue").disabled = true;
    if (el("btnCancel")) el("btnCancel").disabled = true;

    const fileBtn = el("fileBtn");
    if (fileBtn) {
      fileBtn.style.pointerEvents = "none";
      fileBtn.style.opacity = ".55";
    }
  }

  function unlockVerificationUi() {
    verificationLocked = false;

    if (el("fileInput")) el("fileInput").disabled = false;
    if (el("btnExtract")) el("btnExtract").disabled = !pickedFile;
    if (el("btnReset")) el("btnReset").disabled = false;
    if (el("btnContinue")) el("btnContinue").disabled = false;
    if (el("btnCancel")) el("btnCancel").disabled = false;

    const fileBtn = el("fileBtn");
    if (fileBtn) {
      fileBtn.style.pointerEvents = "auto";
      fileBtn.style.opacity = "1";
    }
  }

  function resetAll() {
    pickedFile = null;
    uploadedPath = null;
    extracted = null;
    verificationLocked = false;
    verificationAlreadyExists = false;

    if (el("fileInput")) {
      el("fileInput").value = "";
      el("fileInput").disabled = false;
    }

    if (el("preview")) el("preview").style.display = "none";
    if (el("btnExtract")) el("btnExtract").disabled = true;
    if (el("btnReset")) {
      el("btnReset").style.display = "inline-flex";
      el("btnReset").disabled = false;
    }
    if (el("btnContinue")) el("btnContinue").disabled = false;
    if (el("btnCancel")) el("btnCancel").disabled = false;
    if (el("details")) el("details").style.display = "none";

    clearMsgs();
    clearDebug();
    setLoading(false);

    const fileBtn = el("fileBtn");
    if (fileBtn) {
      fileBtn.style.pointerEvents = "auto";
      fileBtn.style.opacity = "1";
    }

    clearExtractedDetails();
  }

  async function uploadToStorage(file) {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const name = "course_form_" + Date.now() + "_" + Math.random().toString(16).slice(2) + ".pdf";
    const path = `${currentUser.id}/${name}`;

    const { error } = await sb.storage
      .from(BUCKET)
      .upload(path, file, {
        cacheControl: "3600",
        upsert: false,
        contentType: "application/pdf",
      });

    if (error) throw error;
    return path;
  }

  async function callExtractFunction(storagePath, file) {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    const { data: sessData, error: sessErr } = await sb.auth.getSession();
    if (sessErr) throw sessErr;

    const accessToken = sessData?.session?.access_token || "";
    if (!accessToken) throw new Error("Missing authorization header. Please sign in again.");

    const payload = {
      bucket: BUCKET,
      path: storagePath,
      mime_type: "application/pdf",
      file_size: file.size || null
    };

    const resp = await fetch(EXTRACT_FN_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${accessToken}`,
        "x-debug": "1"
      },
      body: JSON.stringify(payload),
    });

    let data = null;
    try {
      data = await resp.json();
    } catch {
      data = null;
    }

    if (!resp.ok) {
      const msg =
        (data && (data.error || data.message || data.details)) ||
        `Verification failed (${resp.status})`;
      throw new Error(msg);
    }

    return data;
  }

  function buildNormalizedExtracted() {
    return {
      full_name: normalizeText(extracted?.full_name),
      matric_no: normalizeText(extracted?.matric_no || extracted?.matric),
      school_name: normalizeUpper(extracted?.school_name),
      department: normalizeText(extracted?.department),
      programme: normalizeText(extracted?.programme),
      faculty: normalizeText(extracted?.faculty),
      level: normalizeText(extracted?.level),
      session: normalizeText(extracted?.session),
      semester: normalizeText(extracted?.semester)
    };
  }

  async function saveToVerificationTable() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    const payload = {
      user_id: currentUser.id,
      file_bucket: BUCKET,
      file_path: uploadedPath,
      full_name: normalized.full_name || null,
      matric_no: normalized.matric_no || null,
      school_name: normalized.school_name || null,
      department: normalized.department || null,
      programme: normalized.programme || null,
      faculty: normalized.faculty || null,
      level: normalized.level || null,
      session: normalized.session || null,
      semester: normalized.semester || null,
      extracted_json: {
        ...(extracted || {}),
        school_name: normalized.school_name || null,
        matric_no: normalized.matric_no || null
      },
      status: "successful"
    };

    const { data: existing, error: checkError } = await sb
      .from(VERIFICATION_TABLE)
      .select("id, status")
      .eq("user_id", currentUser.id)
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (checkError) throw checkError;

    if (existing?.id) {
      const { error: updateError } = await sb
        .from(VERIFICATION_TABLE)
        .update(payload)
        .eq("id", existing.id);

      if (updateError) throw updateError;
      return;
    }

    const { error: insertError } = await sb
      .from(VERIFICATION_TABLE)
      .insert(payload);

    if (insertError) throw insertError;
  }

  async function saveToStudentAccount() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    const payload = {
      user_id: currentUser.id,
      full_name: normalized.full_name || null,
      school_name: normalized.school_name || null,
      department: normalized.department || null,
      programme: normalized.programme || null,
      matric_number: normalized.matric_no || null,
      level: normalized.level || null,
      email: currentUser?.email ? String(currentUser.email).trim().toLowerCase() : null
    };

    const { error } = await sb
      .from(ACCOUNT_TABLE)
      .upsert(payload, { onConflict: "user_id" });

    if (error) throw error;
  }

  async function checkDuplicateMatricInVerificationCourseForms() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();
    const normalized = buildNormalizedExtracted();

    if (!normalized.school_name) {
      throw new Error("School name is missing from the verified course form.");
    }

    if (!normalized.matric_no) {
      throw new Error("Matric number is missing from the verified course form.");
    }

    const { data, error } = await sb
      .from(DUPLICATE_CHECK_TABLE)
      .select("user_id, school_name, matric_no")
      .eq("school_name", normalized.school_name)
      .eq("matric_no", normalized.matric_no)
      .neq("user_id", currentUser.id)
      .limit(1)
      .maybeSingle();

    if (error) throw error;
    return !!data;
  }

  async function hasVerifiedCourseFormAlready() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const { data, error } = await sb
      .from(VERIFICATION_TABLE)
      .select("id, status, full_name, matric_no, school_name, department, programme, faculty, level, session, semester, extracted_json")
      .eq("user_id", currentUser.id)
      .eq("status", "successful")
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (error) throw error;
    return data || null;
  }

  async function hasVerifiedFaceAlready() {
    const sb = window.supabase;
    if (!sb) throw new Error("Supabase not ready.");

    await ensureCurrentUser();

    const { data, error } = await sb
      .from(FACE_TABLE)
      .select("user_id, face_verified, capture_status")
      .eq("user_id", currentUser.id)
      .limit(1)
      .maybeSingle();

    if (error) throw error;
    if (!data) return false;

    const status = String(data.capture_status || "").toLowerCase().trim();
    return data.face_verified === true || status === "approved" || status === "verified";
  }

  async function routeBasedOnVerificationState(options = {}) {
    const { silent = false } = options;

    const existingVerification = await hasVerifiedCourseFormAlready();
    const alreadyHasFace = await hasVerifiedFaceAlready();

    if (existingVerification) {
      verificationAlreadyExists = true;

      extracted = existingVerification.extracted_json || {
        full_name: existingVerification.full_name,
        matric_no: existingVerification.matric_no,
        school_name: existingVerification.school_name,
        department: existingVerification.department,
        programme: existingVerification.programme,
        faculty: existingVerification.faculty,
        level: existingVerification.level,
        session: existingVerification.session,
        semester: existingVerification.semester
      };

      if (extracted) {
        extracted.school_name = normalizeUpper(extracted.school_name);
        extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
      }

      paintExtracted(extracted);
      if (el("details")) el("details").style.display = "block";
      lockVerificationUi();

      try {
        localStorage.setItem("colspot_verification_done", "true");
      } catch {}

      if (alreadyHasFace) {
        try {
          localStorage.setItem("colspot_face_enrolled", "true");
          localStorage.removeItem("colspot_face_step_ready");
        } catch {}

        if (!silent) {
          showOk("Your course form and face are already verified. Redirecting to main...");
        }

        setTimeout(() => {
          window.location.href = MAIN_URL;
        }, silent ? 250 : 700);

        return true;
      }

      try {
        localStorage.setItem("colspot_face_step_ready", "true");
      } catch {}

      if (!silent) {
        showOk("Your course form is already verified. Redirecting to face capture...");
      }

      setTimeout(() => {
        window.location.href = FACE_CAPTURE_URL;
      }, silent ? 250 : 700);

      return true;
    }

    unlockVerificationUi();

    if (alreadyHasFace) {
      try {
        localStorage.removeItem("colspot_face_step_ready");
        localStorage.setItem("colspot_face_enrolled", "true");
      } catch {}
      if (!silent) {
        showWarn("Your face is already verified. Upload your course form to finish account verification.");
      }
    } else {
      try {
        localStorage.removeItem("colspot_face_enrolled");
        localStorage.removeItem("colspot_face_step_ready");
      } catch {}
    }

    return false;
  }

  async function routeAfterFreshVerification() {
    const alreadyHasFace = await hasVerifiedFaceAlready();

    try {
      localStorage.setItem("colspot_verification_done", "true");
    } catch {}

    if (alreadyHasFace) {
      try {
        localStorage.setItem("colspot_face_enrolled", "true");
        localStorage.removeItem("colspot_face_step_ready");
      } catch {}

      showOk("Verification successful. Face already captured before. Redirecting to main...");
      setTimeout(() => {
        window.location.href = MAIN_URL;
      }, 700);
      return;
    }

    try {
      localStorage.setItem("colspot_face_step_ready", "true");
      localStorage.removeItem("colspot_face_enrolled");
    } catch {}

    showOk("Verification successful. Redirecting to face capture...");
    setTimeout(() => {
      window.location.href = FACE_CAPTURE_URL;
    }, 700);
  }

  async function initVerificationPage() {
    try {
      resetAll();
      currentUser = await getUser();

      if (!currentUser || !currentUser.id) {
        throw new Error("Not signed in.");
      }

      const routedAway = await routeBasedOnVerificationState({ silent: true });
      if (routedAway) return;

      if (el("btnExtract")) el("btnExtract").disabled = !pickedFile;
    } catch (e) {
      console.error("verify_class init failed:", e);
      showErr("You need to be signed in to continue.");
      if (el("btnExtract")) el("btnExtract").disabled = true;
    }
  }

  window.addEventListener("load", initVerificationPage);

  const backBtn = document.querySelector(".back-btn");
  if (backBtn) {
    backBtn.addEventListener("click", (event) => {
      event.preventDefault();
      window.location.href = INDEX_URL;
    });
  }

  if (el("fileInput")) {
    el("fileInput").addEventListener("change", (e) => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      const file = e.target.files && e.target.files[0] ? e.target.files[0] : null;
      if (!file) return;

      const isPdf = (file.type || "") === "application/pdf";
      if (!isPdf) {
        resetAll();
        showErr("Please upload PDF only.");
        return;
      }

      const maxMb = 8;
      if (file.size > maxMb * 1024 * 1024) {
        resetAll();
        showErr(`File too large. Max is ${maxMb}MB.`);
        return;
      }

      pickedFile = file;
      renderPreview(file);
      if (el("btnExtract")) el("btnExtract").disabled = false;
      if (el("btnReset")) el("btnReset").style.display = "inline-flex";
      clearExtractedDetails();
    });
  }

  if (el("btnReset")) {
    el("btnReset").addEventListener("click", () => {
      if (verificationLocked) return;
      resetAll();
    });
  }

  if (el("btnCancel")) {
    el("btnCancel").addEventListener("click", () => {
      if (verificationLocked) return;
      clearMsgs();
      clearExtractedDetails();
      showWarn("Verification cancelled. Upload another course form PDF if you want to try again.");
    });
  }

  if (el("btnExtract")) {
    el("btnExtract").addEventListener("click", async () => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      if (!pickedFile) {
        showErr("Pick a file first.");
        return;
      }

      try {
        setLoading(true);

        await ensureCurrentUser();

        uploadedPath = await uploadToStorage(pickedFile);
        const data = await callExtractFunction(uploadedPath, pickedFile);

        if (!data || data.ok !== true) {
          throw new Error("Verification failed. Please try again.");
        }

        const result = data.extracted_result || null;

        if (!result) {
          throw new Error("No details found. Upload a clearer file.");
        }

        extracted = result.extracted || null;

        if (extracted) {
          extracted.school_name = normalizeUpper(extracted.school_name);
          extracted.matric_no = normalizeText(extracted.matric_no || extracted.matric);
        }

        const hasUsefulDetails =
          extracted &&
          (
            extracted.full_name ||
            extracted.matric_no ||
            extracted.school_name ||
            extracted.department ||
            extracted.programme ||
            extracted.level ||
            extracted.session ||
            extracted.semester
          );

        if (!hasUsefulDetails) {
          clearExtractedDetails();
          showErr(result.reason || "No details found. Upload a clearer PDF.");
          return;
        }

        paintExtracted(extracted);
        if (el("details")) el("details").style.display = "block";

        if (result.is_clearance_form === false) {
          showWarn(result.reason || "We found details, but the document type is uncertain. Please review before continuing.");
        } else {
          showOk("Verification details are ready. Please review them and continue.");
        }
      } catch (e) {
        console.error(e);
        showErr(e && e.message ? e.message : "Something went wrong.");
      } finally {
        setLoading(false);
      }
    });
  }

  if (el("btnContinue")) {
    el("btnContinue").addEventListener("click", async () => {
      clearMsgs();

      if (verificationLocked) {
        showErr("Verification already completed successfully.");
        return;
      }

      if (!extracted || !uploadedPath) {
        showErr("Please verify the course form first.");
        return;
      }

      try {
        setLoading(true);

        await ensureCurrentUser();

        const duplicateExists = await checkDuplicateMatricInVerificationCourseForms();
        if (duplicateExists) {
          showErr("This matric number is already linked to another account in this school.");
          return;
        }

        await saveToVerificationTable();
        await saveToStudentAccount();

        lockVerificationUi();
        await routeAfterFreshVerification();
      } catch (e) {
        console.error(e);
        showErr(e && e.message ? e.message : "Failed to save.");
      } finally {
        setLoading(false);
      }
    });
  }
</script>
