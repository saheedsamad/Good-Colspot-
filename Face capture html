<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Face Capture</title>

  <style>
    :root{
      --bg:#edf3ff;
      --panel:#f4f7ff;
      --card:#ffffff;
      --text:#182033;
      --muted:#7a8499;
      --line:#dfe7f6;
      --blue:#4c83f6;
      --blue-dark:#316df0;
      --green:#22c55e;
      --green-soft:#dcfce7;
      --red:#dc2626;
      --red-soft:#fee2e2;
      --warn:#d97706;
      --warn-soft:#fff7ed;
      --shadow:0 18px 40px rgba(76,131,246,.12);
      --shadow-soft:0 10px 24px rgba(15,23,42,.08);
      --safe-top:env(safe-area-inset-top, 0px);
      --safe-bottom:env(safe-area-inset-bottom, 0px);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html, body{
      margin:0;
      padding:0;
      min-height:100%;
      background:#e9eef7;
      color:var(--text);
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body{
      display:flex;
      justify-content:center;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }

    button,
    input,
    select,
    textarea{
      font:inherit;
    }

    .face-page{
      width:100%;
      max-width:430px;
      min-height:100vh;
      background:var(--bg);
      padding:
        calc(10px + var(--safe-top))
        14px
        calc(18px + var(--safe-bottom));
    }

    .fc-header{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:14px;
    }

    .fc-back-btn{
      width:42px;
      height:42px;
      border:none;
      border-radius:14px;
      background:#f1f4fb;
      box-shadow:inset 0 0 0 1px rgba(24,32,51,.04);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      cursor:pointer;
    }

    .fc-back-btn svg{
      width:20px;
      height:20px;
      color:#3b455c;
    }

    .fc-header-copy{
      min-width:0;
      flex:1;
    }

    .fc-header-title{
      font-size:17px;
      font-weight:800;
      letter-spacing:-.02em;
      color:#20283a;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .fc-header-sub{
      margin-top:2px;
      font-size:12px;
      color:var(--muted);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .fc-mode-pill{
      display:none;
      margin:0 0 12px;
      padding:12px 13px;
      border-radius:18px;
      background:var(--warn-soft);
      color:#92400e;
      border:1px solid rgba(217,119,6,.18);
      font-size:13px;
      font-weight:800;
      line-height:1.45;
      box-shadow:var(--shadow-soft);
    }

    .fc-mode-pill.show{
      display:block;
    }

    .fc-mode-pill strong{
      color:#78350f;
    }

    .fc-main-card{
      background:var(--panel);
      border-radius:34px;
      padding:18px 16px 16px;
      box-shadow:var(--shadow);
      border:1px solid rgba(255,255,255,.55);
    }

    .fc-camera-card{
      margin:0;
      padding:0;
      background:transparent;
      border:none;
      box-shadow:none;
    }

    .fc-camera-shell{
      position:relative;
      width:100%;
      aspect-ratio:1/1.08;
      min-height:320px;
      border-radius:28px;
      overflow:hidden;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,.65), rgba(255,255,255,0) 24%),
        linear-gradient(180deg,#dcecff 0%, #c8dcf9 100%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.65);
    }

    .fc-camera-video,
    .fc-overlay-canvas,
    .fc-capture-canvas,
    .fc-capture-preview{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .fc-camera-video{
      display:block;
      background:transparent;
      transform:scaleX(-1);
      z-index:1;
    }

    .fc-overlay-canvas{
      z-index:3;
      pointer-events:none;
    }

    .fc-capture-canvas{
      display:none;
    }

    .fc-capture-preview{
      z-index:4;
      display:block;
      background:transparent;
    }

    .fc-capture-preview.hidden{
      display:none !important;
    }

    .fc-camera-overlay{
      position:absolute;
      inset:0;
      z-index:5;
      display:flex;
      align-items:center;
      justify-content:center;
      pointer-events:none;
    }

    .fc-frame{
      width:78%;
      height:78%;
      border-radius:30px;
      border:2px dashed rgba(123,170,239,.55);
      position:relative;
      box-shadow:inset 0 0 0 999px rgba(255,255,255,.04);
    }

    .fc-corner{
      position:absolute;
      width:42px;
      height:42px;
      border:5px solid rgba(255,255,255,.92);
      border-radius:14px;
    }

    .fc-corner.tl{
      top:-2px;
      left:-2px;
      border-right:none;
      border-bottom:none;
    }

    .fc-corner.tr{
      top:-2px;
      right:-2px;
      border-left:none;
      border-bottom:none;
    }

    .fc-corner.bl{
      bottom:-2px;
      left:-2px;
      border-right:none;
      border-top:none;
    }

    .fc-corner.br{
      right:-2px;
      bottom:-2px;
      border-left:none;
      border-top:none;
    }

    .fc-camera-placeholder{
      position:absolute;
      inset:0;
      z-index:2;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .fc-camera-placeholder-icon{
      width:84px;
      height:84px;
      border-radius:22px;
      background:rgba(255,255,255,.20);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#7da7dd;
      backdrop-filter:blur(8px);
    }

    .fc-camera-placeholder-icon svg{
      width:34px;
      height:34px;
    }

    .fc-live-pill{
      position:absolute;
      left:50%;
      bottom:18px;
      transform:translateX(-50%);
      z-index:6;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:48px;
      padding:0 18px;
      border-radius:999px;
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      font-size:13px;
      font-weight:700;
      box-shadow:0 10px 26px rgba(76,131,246,.28);
      text-align:center;
      max-width:92%;
    }

    .fc-step-track-wrap{
      margin:14px 2px 12px;
    }

    .fc-step-track{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:0;
      margin-bottom:12px;
    }

    .fc-step-line{
      flex:1;
      max-width:44px;
      height:4px;
      border-radius:999px;
      background:#d7dfef;
      margin:0 6px;
    }

    .fc-step-line.done{
      background:#a9dcff;
    }

    .fc-step-circle{
      width:24px;
      height:24px;
      border-radius:999px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:11px;
      font-weight:800;
      background:#d9e0ee;
      color:#8b96aa;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.55);
      flex-shrink:0;
    }

    .fc-step-circle.active{
      background:var(--blue);
      color:#fff;
    }

    .fc-step-circle.done{
      background:#59c5dd;
      color:#fff;
    }

    .fc-step-chip{
      width:max-content;
      max-width:100%;
      margin:0 auto;
      padding:10px 16px;
      border-radius:999px;
      background:#ffffff;
      box-shadow:var(--shadow-soft);
      color:#1f2a3d;
      font-weight:700;
      font-size:13px;
      text-align:center;
      border:1px solid rgba(76,131,246,.08);
    }

    .fc-status-sub{
      margin:0 auto 12px;
      max-width:310px;
      text-align:center;
      color:var(--muted);
      font-size:.93rem;
      line-height:1.48;
    }

    .fc-status-message{
      margin:10px 0 0;
      padding:12px 14px;
      border-radius:16px;
      font-size:.90rem;
      line-height:1.45;
      font-weight:700;
    }

    .fc-status-message-error{
      background:var(--red-soft);
      color:var(--red);
      border:1px solid rgba(220,38,38,.12);
    }

    .fc-status-message-success{
      background:var(--green-soft);
      color:var(--green);
      border:1px solid rgba(22,163,74,.12);
    }

    .fc-actions-card{
      margin-top:10px;
    }

    .fc-btn{
      min-height:60px;
      width:100%;
      border:none;
      border-radius:18px;
      font-size:16px;
      font-weight:700;
      cursor:pointer;
      transition:.18s ease;
    }

    .fc-btn:disabled{
      opacity:.56;
      cursor:not-allowed;
    }

    .fc-btn-white{
      background:#ffffff;
      color:#20283a;
      box-shadow:var(--shadow-soft);
    }

    .fc-btn-primary{
      background:linear-gradient(135deg,var(--blue),var(--blue-dark));
      color:#fff;
      box-shadow:0 12px 28px rgba(76,131,246,.28);
    }

    .fc-btn-secondary{
      background:#fff;
      color:#2b3447;
      box-shadow:var(--shadow-soft);
    }

    .fc-action-row{
      display:grid;
      grid-template-columns:1fr 1.2fr;
      gap:12px;
      margin-top:12px;
    }

    .fc-bottom-dots{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      margin:14px 0 8px;
    }

    .fc-bottom-dots span{
      width:7px;
      height:7px;
      border-radius:999px;
      background:#d8dfef;
    }

    .fc-bottom-dots span.active{
      width:26px;
      background:var(--blue);
    }

    .fc-help-link{
      display:block;
      width:100%;
      background:transparent;
      border:none;
      text-align:center;
      color:#7c8cab;
      font-size:14px;
      cursor:pointer;
      margin-top:6px;
    }

    .hidden{
      display:none !important;
    }

    @media (max-width:380px){
      .fc-camera-shell{
        min-height:290px;
      }

      .fc-action-row{
        grid-template-columns:1fr;
      }

      .fc-header-title{
        font-size:16px;
      }

      .fc-step-line{
        max-width:30px;
        margin:0 4px;
      }
    }
  </style>
</head>
<body>
  <div class="face-page">
    <header class="fc-header">
      <button class="fc-back-btn" id="backBtn" type="button" aria-label="Go back">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.5 19.5L8 12l7.5-7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="fc-header-copy">
        <div class="fc-header-title" id="pageTitle">Face capture</div>
        <div class="fc-header-sub" id="pageSub">Complete live face verification</div>
      </div>
    </header>

    <div id="academicModePill" class="fc-mode-pill">
      <strong>Academic update:</strong> Your level, session and semester will only update after this face capture is approved.
    </div>

    <section class="fc-main-card">
      <section class="fc-camera-card">
        <div class="fc-camera-shell" id="cameraShell">
          <video id="cameraVideo" class="fc-camera-video" playsinline autoplay muted></video>
          <canvas id="overlayCanvas" class="fc-overlay-canvas"></canvas>
          <canvas id="captureCanvas" class="fc-capture-canvas"></canvas>
          <img id="capturePreview" class="fc-capture-preview hidden" alt="Captured face preview" />

          <div class="fc-camera-overlay">
            <div class="fc-frame">
              <div class="fc-corner tl"></div>
              <div class="fc-corner tr"></div>
              <div class="fc-corner bl"></div>
              <div class="fc-corner br"></div>
            </div>
          </div>

          <div class="fc-camera-placeholder" id="cameraPlaceholder">
            <div class="fc-camera-placeholder-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 8.5V7.8A4.8 4.8 0 0 1 11.8 3h.4A4.8 4.8 0 0 1 17 7.8v.7M5.5 21h13A2.5 2.5 0 0 0 21 18.5v-7A2.5 2.5 0 0 0 18.5 9h-13A2.5 2.5 0 0 0 3 11.5v7A2.5 2.5 0 0 0 5.5 21Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="14.5" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </div>
          </div>

          <div class="fc-live-pill" id="cameraBadge">
            Look straight, turn left, turn right, then face front again
          </div>
        </div>

        <div class="fc-step-track-wrap">
          <div class="fc-step-track">
            <div class="fc-step-circle active">1</div>
            <div class="fc-step-line"></div>
            <div class="fc-step-circle">2</div>
            <div class="fc-step-line"></div>
            <div class="fc-step-circle">3</div>
            <div class="fc-step-line"></div>
            <div class="fc-step-circle">4</div>
          </div>

          <div class="fc-step-chip" id="statusTitle">Look straight</div>
        </div>

        <p class="fc-status-sub" id="statusSub">
          Start your camera and follow the movement guide.
        </p>

        <div class="fc-status-message fc-status-message-error hidden" id="errorMsg"></div>
        <div class="fc-status-message fc-status-message-success hidden" id="successMsg"></div>
      </section>

      <section class="fc-actions-card">
        <button class="fc-btn fc-btn-white" id="startCameraBtn" type="button">
          Start camera
        </button>

        <div class="fc-action-row hidden" id="captureActions">
          <button class="fc-btn fc-btn-secondary" id="retakeBtn" type="button">
            Retake
          </button>

          <button class="fc-btn fc-btn-primary" id="continueBtn" type="button">
            Verify and continue
          </button>
        </div>

        <button class="fc-btn fc-btn-primary hidden" id="stopCameraBtn" type="button">
          Stop camera
        </button>

        <div class="fc-bottom-dots">
          <span></span>
          <span></span>
          <span></span>
          <span class="active"></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <button class="fc-help-link" id="whyBtn" type="button">
          Why am I doing this?
        </button>
      </section>
    </section>
  </div>

  <script src="./guard_session.js"></script>

  <script>
    window.SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
    window.SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY_HERE";
  </script>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js"></script>

  <script>
    const FACE_ENROLL_FUNCTION_URL = `${window.SUPABASE_URL}/functions/v1/face-enroll`;
    const SUCCESS_REDIRECT_URL = "main.html";

    const ACADEMIC_UPDATE_PENDING_KEY = "colspot_pending_academic_update";

    const urlParams = new URLSearchParams(window.location.search);
    const PAGE_MODE = String(urlParams.get("mode") || "").trim().toLowerCase();
    const REQUEST_ID = String(urlParams.get("requestId") || "").trim();
    const IS_ACADEMIC_UPDATE = PAGE_MODE === "academic_update";

    const supabaseClient = window.supabase.createClient(
      window.SUPABASE_URL,
      window.SUPABASE_ANON_KEY
    );

    const video = document.getElementById("cameraVideo");
    const overlayCanvas = document.getElementById("overlayCanvas");
    const overlayCtx = overlayCanvas.getContext("2d");
    const captureCanvas = document.getElementById("captureCanvas");
    const captureCtx = captureCanvas.getContext("2d");
    const capturePreview = document.getElementById("capturePreview");

    const cameraPlaceholder = document.getElementById("cameraPlaceholder");
    const cameraBadge = document.getElementById("cameraBadge");

    const statusTitle = document.getElementById("statusTitle");
    const statusSub = document.getElementById("statusSub");
    const errorMsg = document.getElementById("errorMsg");
    const successMsg = document.getElementById("successMsg");

    const startCameraBtn = document.getElementById("startCameraBtn");
    const stopCameraBtn = document.getElementById("stopCameraBtn");
    const retakeBtn = document.getElementById("retakeBtn");
    const continueBtn = document.getElementById("continueBtn");
    const backBtn = document.getElementById("backBtn");
    const whyBtn = document.getElementById("whyBtn");
    const captureActions = document.getElementById("captureActions");

    const pageTitle = document.getElementById("pageTitle");
    const pageSub = document.getElementById("pageSub");
    const academicModePill = document.getElementById("academicModePill");

    let mediaStream = null;
    let mpCamera = null;
    let faceMesh = null;
    let scanningActive = false;
    let captureLocked = false;
    let finalBase64 = null;
    let finalMimeType = "image/jpeg";
    let currentLocalUser = null;
    let pendingAcademicUpdate = null;

    let poseHoldFrames = 0;
    let currentStepIndex = 0;
    const scanSequence = ["center", "left", "right", "center"];
    const POSE_HOLD_TARGET = 8;

    function showError(message) {
      if (!errorMsg) return;
      errorMsg.textContent = message || "";
      errorMsg.classList.toggle("hidden", !message);
    }

    function showSuccess(message) {
      if (!successMsg) return;
      successMsg.textContent = message || "";
      successMsg.classList.toggle("hidden", !message);
    }

    function clearFlashMessages() {
      showError("");
      showSuccess("");
    }

    function setStatus(title, sub = "") {
      if (statusTitle) statusTitle.textContent = title || "";
      if (statusSub) statusSub.textContent = sub || "";
    }

    function setCameraBadge(text) {
      if (cameraBadge) cameraBadge.textContent = text || "";
    }

    function setButtonsForIdle() {
      if (startCameraBtn) startCameraBtn.classList.remove("hidden");
      if (stopCameraBtn) stopCameraBtn.classList.add("hidden");
      if (captureActions) captureActions.classList.add("hidden");
    }

    function setButtonsForLiveCamera() {
      if (startCameraBtn) startCameraBtn.classList.add("hidden");
      if (stopCameraBtn) stopCameraBtn.classList.remove("hidden");
      if (captureActions) captureActions.classList.add("hidden");
    }

    function setButtonsForCaptured() {
      if (startCameraBtn) startCameraBtn.classList.add("hidden");
      if (stopCameraBtn) stopCameraBtn.classList.add("hidden");
      if (captureActions) captureActions.classList.remove("hidden");
    }

    function readPendingAcademicUpdate() {
      try {
        const raw = localStorage.getItem(ACADEMIC_UPDATE_PENDING_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object") return null;
        return parsed;
      } catch (_) {
        return null;
      }
    }

    function clearPendingAcademicUpdate() {
      try {
        localStorage.removeItem(ACADEMIC_UPDATE_PENDING_KEY);
      } catch (_) {}
    }

    function setupModeUi() {
      if (!IS_ACADEMIC_UPDATE) return;

      pendingAcademicUpdate = readPendingAcademicUpdate();

      if (pageTitle) pageTitle.textContent = "Academic face capture";
      if (pageSub) pageSub.textContent = "Retake face to complete academic update";
      if (academicModePill) academicModePill.classList.add("show");
      if (continueBtn) continueBtn.textContent = "Verify and update";

      if (!pendingAcademicUpdate || !pendingAcademicUpdate.request_id) {
        showError("No pending academic update found. Please start again from Account.");
      }
    }

    function updateSequenceUI() {
      const circles = document.querySelectorAll(".fc-step-circle");
      const lines = document.querySelectorAll(".fc-step-line");

      circles.forEach((el, index) => {
        el.classList.remove("active", "done");
        el.textContent = String(index + 1);

        if (index < currentStepIndex) {
          el.classList.add("done");
          el.textContent = "✓";
        } else if (index === currentStepIndex) {
          el.classList.add("active");
        }
      });

      lines.forEach((el, index) => {
        el.classList.remove("done");
        if (index < currentStepIndex) {
          el.classList.add("done");
        }
      });

      setStatus(currentInstruction(), statusSub?.textContent || "");
    }

    function resetSequenceState() {
      currentStepIndex = 0;
      poseHoldFrames = 0;
      captureLocked = false;
      updateSequenceUI();
    }

    function currentInstruction() {
      const step = scanSequence[currentStepIndex] || "center";
      if (currentStepIndex === 0 && step === "center") return "Look straight";
      if (step === "left") return "Turn left";
      if (step === "right") return "Turn right";
      if (currentStepIndex === scanSequence.length - 1 && step === "center") return "Face front again";
      if (step === "center") return "Look straight";
      return "Hold still";
    }

    function instructionDescription() {
      const step = scanSequence[currentStepIndex] || "center";
      if (currentStepIndex === 0 && step === "center") {
        return "Start by looking straight at the camera.";
      }
      if (step === "left") {
        return "Turn your face slightly to the left and hold still.";
      }
      if (step === "right") {
        return "Turn your face slightly to the right and hold still.";
      }
      if (currentStepIndex === scanSequence.length - 1 && step === "center") {
        return "Now return your face to the center before capture.";
      }
      return "Follow the movement guide.";
    }

    function clearOverlay() {
      overlayCtx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);
    }

    function resizeOverlayToVideo() {
      const width = video.videoWidth || 720;
      const height = video.videoHeight || 960;
      overlayCanvas.width = width;
      overlayCanvas.height = height;
    }

    function ratioBetween(leftX, rightX, targetX) {
      const width = rightX - leftX;
      if (!width || Math.abs(width) < 0.00001) return 0.5;
      return (targetX - leftX) / width;
    }

    function computePose(landmarks) {
      const leftEyeOuter = landmarks[33];
      const rightEyeOuter = landmarks[263];
      const noseTip = landmarks[1];

      const ratio = ratioBetween(leftEyeOuter.x, rightEyeOuter.x, noseTip.x);

      if (ratio >= 0.45 && ratio <= 0.55) return "center";
      if (ratio < 0.43) return "left";
      if (ratio > 0.57) return "right";
      return "unknown";
    }

    function isFaceCentered(landmarks) {
      const leftCheek = landmarks[234];
      const rightCheek = landmarks[454];
      const forehead = landmarks[10];
      const chin = landmarks[152];

      const centerX = (leftCheek.x + rightCheek.x) / 2;
      const centerY = (forehead.y + chin.y) / 2;

      return centerX >= 0.35 && centerX <= 0.65 && centerY >= 0.30 && centerY <= 0.66;
    }

    function drawResults(results) {
      resizeOverlayToVideo();
      clearOverlay();

      if (!results || !results.multiFaceLandmarks || !results.multiFaceLandmarks.length) {
        return;
      }

      const landmarks = results.multiFaceLandmarks[0];

      drawConnectors(
        overlayCtx,
        landmarks,
        FACEMESH_TESSELATION,
        { color: "rgba(255,255,255,0.07)", lineWidth: 1 }
      );

      drawConnectors(
        overlayCtx,
        landmarks,
        FACEMESH_FACE_OVAL,
        { color: "rgba(59,130,246,0.95)", lineWidth: 2 }
      );
    }

    function hidePlaceholder() {
      if (cameraPlaceholder) cameraPlaceholder.classList.add("hidden");
    }

    function showPlaceholder() {
      if (cameraPlaceholder) cameraPlaceholder.classList.remove("hidden");
    }

    function showCapturedPreview(base64) {
      if (capturePreview) {
        capturePreview.src = base64;
        capturePreview.classList.remove("hidden");
      }
      if (video) video.classList.add("hidden");
    }

    function hideCapturedPreview() {
      if (capturePreview) {
        capturePreview.src = "";
        capturePreview.classList.add("hidden");
      }
      if (video) video.classList.remove("hidden");
    }

    function stopTracksOnly() {
      if (mediaStream) {
        mediaStream.getTracks().forEach((track) => track.stop());
        mediaStream = null;
      }

      if (mpCamera && typeof mpCamera.stop === "function") {
        try {
          mpCamera.stop();
        } catch (_) {}
      }

      mpCamera = null;
      scanningActive = false;
    }

    function fullResetToIdle() {
      stopTracksOnly();
      clearOverlay();
      finalBase64 = null;
      hideCapturedPreview();
      showPlaceholder();
      setButtonsForIdle();
      resetSequenceState();
      clearFlashMessages();

      if (IS_ACADEMIC_UPDATE) {
        setCameraBadge("Retake face to approve academic update");
        setStatus("Look straight", "Start your camera and complete face capture to apply your academic update.");
      } else {
        setCameraBadge("Look straight, turn left, turn right, then face front again");
        setStatus("Look straight", "Start your camera and follow the movement guide.");
      }
    }

    function buildCaptureMeta() {
      const meta = {
        source: "camera",
        stepSequence: scanSequence,
        deviceId:
          localStorage.getItem("colspot_device_id") ||
          localStorage.getItem("device_id") ||
          null,
        userId: currentLocalUser?.id || null
      };

      if (IS_ACADEMIC_UPDATE) {
        meta.mode = "academic_update";
        meta.academic_update_request_id =
          REQUEST_ID ||
          pendingAcademicUpdate?.request_id ||
          null;
      }

      return meta;
    }

    async function getLocalFirstUser() {
      const guard = window.ColspotGuard;

      if (IS_ACADEMIC_UPDATE) {
        try {
          const cached = JSON.parse(localStorage.getItem("colspot_local_user") || "null");

          if (cached && (cached.user_id || cached.id)) {
            currentLocalUser = {
              id: cached.user_id || cached.id,
              email: cached.email || null
            };

            return currentLocalUser;
          }
        } catch {}

        try {
          const { data, error } = await supabaseClient.auth.getUser();

          if (!error && data && data.user) {
            currentLocalUser = {
              id: data.user.id,
              email: data.user.email || null
            };

            try {
              localStorage.setItem("colspot_local_user", JSON.stringify({
                id: data.user.id,
                user_id: data.user.id,
                email: data.user.email || "",
                role: "student",
                last_seen: new Date().toISOString()
              }));

              localStorage.setItem("colspot_auth_role", "student");
            } catch {}

            return currentLocalUser;
          }
        } catch {}

        window.location.href = "index.html";
        return null;
      }

      if (guard && typeof guard.guardRolePageAccess === "function") {
        const localUser = await guard.guardRolePageAccess({
          requiredRole: "student",
          redirectTo: "index.html",
          studentHome: "main.html",
          lecturerHome: "main_lecturer.html"
        });

        if (localUser && localUser.id) {
          currentLocalUser = {
            id: localUser.id,
            email: localUser.email || null
          };
          return currentLocalUser;
        }
      }

      try {
        const cached = JSON.parse(localStorage.getItem("colspot_local_user") || "null");
        if (cached && (cached.user_id || cached.id)) {
          currentLocalUser = {
            id: cached.user_id || cached.id,
            email: cached.email || null
          };
          return currentLocalUser;
        }
      } catch {}

      window.location.href = "index.html";
      return null;
    }

    async function ensureUploadSession() {
      const { data, error } = await supabaseClient.auth.getSession();

      if (error || !data?.session) {
        showError("Your session expired. Please sign in again.");
        setStatus("Session expired", "Please go back and sign in again.");
        return null;
      }

      return data.session;
    }

    async function initFaceMesh() {
      if (faceMesh) return;

      faceMesh = new FaceMesh({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`
      });

      faceMesh.setOptions({
        maxNumFaces: 1,
        refineLandmarks: true,
        minDetectionConfidence: 0.6,
        minTrackingConfidence: 0.6
      });

      faceMesh.onResults((results) => {
        drawResults(results);

        if (!scanningActive || captureLocked) return;

        const faces = results.multiFaceLandmarks || [];

        if (!faces.length) {
          poseHoldFrames = 0;
          setCameraBadge("No face detected");
          setStatus(currentInstruction(), "Position your face inside the frame.");
          return;
        }

        if (faces.length > 1) {
          poseHoldFrames = 0;
          setCameraBadge("One face only");
          setStatus("Only one face", "Keep only your face visible in the camera.");
          return;
        }

        const landmarks = faces[0];
        const centered = isFaceCentered(landmarks);
        const expectedPose = scanSequence[currentStepIndex] || null;

        if (!expectedPose) {
          captureLocked = true;
          scanningActive = false;
          setCameraBadge("Capturing...");
          setStatus("Hold still", "We are capturing your face now.");
          setTimeout(captureFrame, 400);
          return;
        }

        const pose = computePose(landmarks);

        if (!centered) {
          poseHoldFrames = 0;
          setCameraBadge("Move into frame");
          setStatus("Center your face", "Move your face into the frame and keep only one face visible.");
          return;
        }

        setCameraBadge(`Expected: ${currentInstruction()}`);

        if (pose === expectedPose) {
          poseHoldFrames += 1;
          clearFlashMessages();
          setStatus(
            currentInstruction(),
            `${currentInstruction()} detected. Hold still...`
          );
        } else {
          poseHoldFrames = 0;
          setStatus(currentInstruction(), instructionDescription());
        }

        if (poseHoldFrames >= POSE_HOLD_TARGET) {
          currentStepIndex += 1;
          poseHoldFrames = 0;
          updateSequenceUI();

          if (currentStepIndex >= scanSequence.length) {
            captureLocked = true;
            scanningActive = false;
            setCameraBadge("Capturing...");
            setStatus("Hold still", "We are capturing your face now.");
            setTimeout(captureFrame, 400);
            return;
          }

          setStatus(currentInstruction(), instructionDescription());
        }
      });
    }

    function captureFrame() {
      const width = video.videoWidth;
      const height = video.videoHeight;

      if (!width || !height) {
        captureLocked = false;
        scanningActive = true;
        showError("Camera is not ready yet. Please try again.");
        return;
      }

      captureCanvas.width = width;
      captureCanvas.height = height;

      captureCtx.save();
      captureCtx.translate(width, 0);
      captureCtx.scale(-1, 1);
      captureCtx.drawImage(video, 0, 0, width, height);
      captureCtx.restore();

      finalBase64 = captureCanvas.toDataURL(finalMimeType, 0.95);
      showCapturedPreview(finalBase64);

      scanningActive = false;
      setButtonsForCaptured();
      setCameraBadge("Capture ready");
      showSuccess("Face captured successfully.");

      if (IS_ACADEMIC_UPDATE) {
        setStatus("Captured", "Review your face capture, then continue to approve your academic update.");
      } else {
        setStatus("Captured", "Review your center face capture or continue.");
      }
    }

    async function startCamera() {
      clearFlashMessages();

      const localUser = await getLocalFirstUser();
      if (!localUser) return;

      if (IS_ACADEMIC_UPDATE) {
        pendingAcademicUpdate = readPendingAcademicUpdate();

        if (!pendingAcademicUpdate || !pendingAcademicUpdate.request_id) {
          showError("No pending academic update found. Please go back to Account and start again.");
          setStatus("Pending update missing", "Start the academic update again from your Account screen.");
          return;
        }

        if (REQUEST_ID && pendingAcademicUpdate.request_id !== REQUEST_ID) {
          showError("This academic update request does not match this page. Please start again.");
          setStatus("Request mismatch", "Start the academic update again from your Account screen.");
          return;
        }
      }

      try {
        stopTracksOnly();
        hideCapturedPreview();
        showPlaceholder();
        resetSequenceState();
        finalBase64 = null;

        mediaStream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: "user",
            width: { ideal: 720 },
            height: { ideal: 960 }
          },
          audio: false
        });

        video.srcObject = mediaStream;
        await video.play();

        await initFaceMesh();

        mpCamera = new Camera(video, {
          onFrame: async () => {
            if (faceMesh) {
              await faceMesh.send({ image: video });
            }
          },
          width: 720,
          height: 960
        });

        await mpCamera.start();

        scanningActive = true;
        hidePlaceholder();
        setButtonsForLiveCamera();
        setCameraBadge("Expected: Look straight");

        if (IS_ACADEMIC_UPDATE) {
          setStatus("Look straight", "Retake your face to approve your academic update.");
        } else {
          setStatus("Look straight", "Start by looking straight at the camera.");
        }
      } catch (err) {
        console.error(err);
        showError("Camera access failed. Please allow camera permission and try again.");
        setStatus("Camera access failed", "Permission is required to continue.");
        fullResetToIdle();
      }
    }

    async function uploadToEdge() {
      clearFlashMessages();

      const localUser = await getLocalFirstUser();
      if (!localUser) return;

      const session = await ensureUploadSession();
      if (!session) return;

      if (!finalBase64) {
        showError("No captured image found. Please retake your face.");
        return;
      }

      if (IS_ACADEMIC_UPDATE) {
        pendingAcademicUpdate = readPendingAcademicUpdate();

        if (!pendingAcademicUpdate || !pendingAcademicUpdate.request_id) {
          showError("No pending academic update found. Please start again from Account.");
          setStatus("Pending update missing", "Start again from Account before taking face capture.");
          return;
        }
      }

      continueBtn.disabled = true;
      retakeBtn.disabled = true;

      if (IS_ACADEMIC_UPDATE) {
        setStatus("Approving update...", "Please wait while Colspot verifies your face and applies your academic update.");
        setCameraBadge("Approving update...");
      } else {
        setStatus("Saving your face...", "Please wait while we upload and verify your face image.");
        setCameraBadge("Uploading...");
      }

      try {
        const payload = {
          imageBase64: finalBase64,
          mimeType: finalMimeType,
          captureMeta: buildCaptureMeta()
        };

        if (IS_ACADEMIC_UPDATE) {
          payload.mode = "academic_update";
          payload.academic_update_request_id =
            REQUEST_ID ||
            pendingAcademicUpdate?.request_id ||
            null;
          payload.academicUpdateRequestId =
            REQUEST_ID ||
            pendingAcademicUpdate?.request_id ||
            null;
        }

        const res = await fetch(FACE_ENROLL_FUNCTION_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${session.access_token}`
          },
          body: JSON.stringify(payload)
        });

        const result = await res.json().catch(() => ({}));
        const status = String(result?.status || "").toLowerCase();

        if (res.ok && status === "approved") {
          localStorage.setItem("colspot_face_enrolled", "true");
          localStorage.removeItem("colspot_face_step_ready");

          if (IS_ACADEMIC_UPDATE) {
            clearPendingAcademicUpdate();

            showSuccess(result.message || "Face verified. Academic details updated successfully.");
            setStatus("Academic update complete", "Your level, session and semester have been updated.");
            setCameraBadge("Updated");

            setTimeout(() => {
              window.location.href = SUCCESS_REDIRECT_URL;
            }, 1200);

            return;
          }

          showSuccess(result.message || "Face verified successfully.");
          setStatus("Verification successful", "Your face has been verified successfully.");
          setCameraBadge("Done");

          setTimeout(() => {
            window.location.href = SUCCESS_REDIRECT_URL;
          }, 1200);
          return;
        }

        if (res.ok && status === "pending") {
          localStorage.removeItem("colspot_face_enrolled");

          if (IS_ACADEMIC_UPDATE) {
            showSuccess(result.message || "Face submitted and pending review. Academic update is still pending.");
            setStatus("Pending review", "Your academic update will only apply after face approval.");
            setCameraBadge("Pending");
          } else {
            showSuccess(result.message || "Face submitted and pending review.");
            setStatus("Pending review", "Your face was submitted successfully and is under review.");
            setCameraBadge("Pending");
          }

          continueBtn.disabled = false;
          retakeBtn.disabled = false;
          return;
        }

        if (status === "duplicate") {
          continueBtn.disabled = false;
          retakeBtn.disabled = false;
          showError(result.message || "This face is already linked to another account.");
          setStatus("Duplicate face found", "This face is already connected to another account in your school.");
          setCameraBadge("Duplicate");
          return;
        }

        if (status === "rejected") {
          continueBtn.disabled = false;
          retakeBtn.disabled = false;
          showError(result.message || "Face verification failed.");
          setStatus("Verification failed", "Please retake your face clearly and try again.");
          setCameraBadge("Rejected");
          return;
        }

        if (status === "already_enrolled") {
          localStorage.setItem("colspot_face_enrolled", "true");
          localStorage.removeItem("colspot_face_step_ready");

          if (IS_ACADEMIC_UPDATE) {
            clearPendingAcademicUpdate();

            showSuccess(result.message || "Face already verified. Academic update completed.");
            setStatus("Academic update complete", "Your academic details have been updated.");
            setCameraBadge("Updated");

            setTimeout(() => {
              window.location.href = SUCCESS_REDIRECT_URL;
            }, 1200);

            return;
          }

          showSuccess(result.message || "This account already has an approved face.");
          setStatus("Already verified", "This account already has an approved face.");
          setCameraBadge("Done");

          setTimeout(() => {
            window.location.href = SUCCESS_REDIRECT_URL;
          }, 1200);
          return;
        }

        const fallbackError =
          result?.message ||
          result?.error ||
          "Could not verify your face. Please try again.";

        continueBtn.disabled = false;
        retakeBtn.disabled = false;
        showError(fallbackError);
        setStatus("Verification failed", "Please check your capture and try again.");
        setCameraBadge("Capture ready");
      } catch (err) {
        console.error(err);
        continueBtn.disabled = false;
        retakeBtn.disabled = false;
        showError(err?.message || "Could not save your face. Please try again.");
        setStatus("Upload failed", "Please check your connection and try again.");
        setCameraBadge("Capture ready");
      }
    }

    function retakeCapture() {
      clearFlashMessages();
      hideCapturedPreview();
      finalBase64 = null;
      captureLocked = false;
      scanningActive = true;
      resetSequenceState();
      setButtonsForLiveCamera();
      setCameraBadge("Expected: Look straight");

      if (IS_ACADEMIC_UPDATE) {
        setStatus("Look straight", "Start again to approve your academic update.");
      } else {
        setStatus("Look straight", "Start again by looking straight at the camera.");
      }
    }

    if (backBtn) {
      backBtn.addEventListener("click", () => {
        if (IS_ACADEMIC_UPDATE) {
          window.location.href = "verify_class.html?mode=academic_update";
          return;
        }

        window.history.back();
      });
    }

    if (whyBtn) {
      whyBtn.addEventListener("click", () => {
        if (IS_ACADEMIC_UPDATE) {
          alert("This confirms that the real account owner is approving the academic update before Colspot changes level, session or semester.");
          return;
        }

        alert("This helps Colspot confirm that a real live student is completing verification.");
      });
    }

    if (startCameraBtn) {
      startCameraBtn.addEventListener("click", startCamera);
    }

    if (stopCameraBtn) {
      stopCameraBtn.addEventListener("click", () => {
        fullResetToIdle();
      });
    }

    if (retakeBtn) {
      retakeBtn.addEventListener("click", retakeCapture);
    }

    if (continueBtn) {
      continueBtn.addEventListener("click", uploadToEdge);
    }

    window.addEventListener("beforeunload", () => {
      stopTracksOnly();
    });

    (async function boot() {
      setupModeUi();

      const localUser = await getLocalFirstUser();
      if (!localUser) return;

      if (IS_ACADEMIC_UPDATE) {
        pendingAcademicUpdate = readPendingAcademicUpdate();

        if (!pendingAcademicUpdate || !pendingAcademicUpdate.request_id) {
          showError("No pending academic update found. Please start again from Account.");
          setStatus("Pending update missing", "Go back to Account and start academic update again.");
        }
      }

      fullResetToIdle();
    })();
  </script>
</body>
