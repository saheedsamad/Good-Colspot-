  <!-- HUB PAGE -->
  <div id="cgpaHubPage">
    <section class="hero">
      <div class="hero-line-1">CGPA</div>
      <h1 class="hero-title">
        CGPA calculator<br />
        <span>Add semesters &amp; calculate result</span>
      </h1>
    </section>

    <div class="summary-card">
      <div class="summary-top">
        <div>
          <div class="summary-top-label">Current CGPA</div>
          <div id="cgpaCurrentValue" class="summary-top-value">—</div>
        </div>
        <div id="cgpaCurrentStanding" class="summary-standing">No result yet</div>
      </div>
      <div class="summary-bottom">
        <div class="summary-bottom-item">
          <div class="summary-bottom-label">Semesters Saved</div>
          <div id="cgpaSavedCount" class="summary-bottom-value">0</div>
        </div>
        <div class="summary-bottom-item">
          <div class="summary-bottom-label">Total Units</div>
          <div id="cgpaTotalUnits" class="summary-bottom-value">0</div>
        </div>
      </div>
    </div>

    <div class="action-row">
      <button id="btnOpenSemesterPicker" class="secondary-btn" type="button">+ Add New Semester</button>
      <button id="btnCalculateCgpa" class="primary-btn" type="button">Calculate CGPA</button>
    </div>

    <section>
      <div class="section-title">Saved semesters</div>
      <div class="section-sub">
        Add new semesters, edit old ones, or select any saved semester for calculation.
      </div>

      <div class="card">
        <div id="cgpaSemesterList" class="list"></div>
        <div id="cgpaSemesterEmpty" class="empty-state hidden">
          No semester added yet. Tap <strong>Add New Semester</strong> to start.
        </div>
      </div>
    </section>

    <section>
      <div class="inline-head">
        <div class="section-title">Selected semesters</div>
        <button id="btnClearSelectedSemesters" class="inline-action" type="button">Clear All</button>
      </div>
      <div class="section-sub">
        These are only the semesters selected for the current calculation. Clear All will not delete saved data.
      </div>

      <div class="card">
        <div id="cgpaSelectedChips" class="chips"></div>
        <div id="cgpaSelectedEmpty" class="empty-state">
          No semester selected yet.
        </div>
      </div>
    </section>

    <div id="cgpaHubError" class="message error hidden"></div>
    <div id="cgpaHubSuccess" class="message success hidden"></div>
  </div>

  <!-- PICKER PAGE -->
  <div id="cgpaPickerPage" class="hidden">
    <section class="hero">
      <div class="hero-line-1">CGPA</div>
      <h1 class="hero-title">
