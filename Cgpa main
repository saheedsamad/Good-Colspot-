  <script>
    (function () {
      if (window.__cgpaReportsScreenInit) return;
      window.__cgpaReportsScreenInit = true;

      let cgpaSemestersCache = [];
      let cgpaSelectedSemesterIds = [];
      let cgpaCurrentEditorSemester = null;
      let cgpaCurrentEditorCourses = [];
      let cgpaEditingCourseId = null;
      let cgpaLatestSummary = null;

      function cgpaQ(id) {
        return document.getElementById(id);
      }

      function cgpaShowPage(pageId) {
        ["cgpaHubPage", "cgpaPickerPage", "cgpaEditorPage", "cgpaResultPage"].forEach((id) => {
          const el = cgpaQ(id);
          if (el) el.classList.toggle("hidden", id !== pageId);
        });
      }

      function cgpaShowMessage(targetId, msg, type) {
        const el = cgpaQ(targetId);
        if (!el) return;
        el.textContent = msg || "";
        el.className = "message " + (type || "error") + (msg ? "" : " hidden");
        if (!msg) el.classList.add("hidden");
      }

      function cgpaClearMessages() {
        [
          "cgpaHubError", "cgpaHubSuccess",
          "cgpaPickerError",
          "cgpaEditorError", "cgpaEditorSuccess",
          "cgpaResultError"
        ].forEach((id) => cgpaShowMessage(id, ""));
      }

      function cgpaSafeText(v) {
        return String(v || "").trim();
      }

      function cgpaRound2(n) {
        return Math.round((Number(n || 0) + Number.EPSILON) * 100) / 100;
      }

      function cgpaGradePoint(letter) {
        const g = cgpaSafeText(letter).toUpperCase();
        if (g === "A") return 5;
        if (g === "B") return 4;
        if (g === "C") return 3;
        if (g === "D") return 2;
        if (g === "E") return 1;
        return 0;
      }

      function cgpaStandingFromCgpa(cgpa) {
        const c = Number(cgpa || 0);
        if (c >= 4.5) return "First Class";
        if (c >= 3.5) return "Second Class Upper";
        if (c >= 2.4) return "Second Class Lower";
        if (c >= 1.5) return "Third Class";
        if (c >= 1.0) return "Pass";
        return "Fail";
      }

      function cgpaFormatSemester(level, semester, academicSession) {
        const semText = Number(semester) === 2 ? "2nd Semester" : "1st Semester";
        return `${level} Level · ${semText}${academicSession ? ` · ${academicSession}` : ""}`;
      }

      function cgpaFindSemesterById(id) {
        return cgpaSemestersCache.find((s) => String(s.id) === String(id)) || null;
      }

      function cgpaSetSelectedSemesterIds(ids) {
        cgpaSelectedSemesterIds = Array.from(new Set((ids || []).map(String)));
        try {
          localStorage.setItem("colspot_cgpa_selected_semester_ids", JSON.stringify(cgpaSelectedSemesterIds));
        } catch (e) {}
      }

      function cgpaLoadSelectedSemesterIds() {
        try {
          const raw = localStorage.getItem("colspot_cgpa_selected_semester_ids");
          const parsed = raw ? JSON.parse(raw) : [];
          cgpaSelectedSemesterIds = Array.isArray(parsed) ? parsed.map(String) : [];
        } catch (e) {
          cgpaSelectedSemesterIds = [];
        }
      }

      function cgpaToggleSelectedSemester(id) {
        const sid = String(id);
        if (cgpaSelectedSemesterIds.includes(sid)) {
          cgpaSetSelectedSemesterIds(cgpaSelectedSemesterIds.filter((x) => x !== sid));
        } else {
          cgpaSetSelectedSemesterIds([...cgpaSelectedSemesterIds, sid]);
        }
        cgpaRenderHub();
      }

      function cgpaRemoveSelectedSemester(id) {
        const sid = String(id);
        cgpaSetSelectedSemesterIds(cgpaSelectedSemesterIds.filter((x) => x !== sid));
        cgpaRenderHub();
      }

      function cgpaClearAllSelectedSemesters() {
        cgpaSetSelectedSemesterIds([]);
        cgpaRenderHub();
        cgpaShowMessage("cgpaHubSuccess", "Selected semesters cleared.", "success");
      }

      async function cgpaEnsureUser() {
        try {
          if (typeof ensureCurrentUser === "function") {
            const user = await ensureCurrentUser();
            if (user && typeof currentUser !== "undefined") currentUser = user;
            return user;
          }
        } catch (e) {}

        if (typeof supabase === "undefined") return null;

        try {
          const { data, error } = await supabase.auth.getUser();
          if (error || !data?.user) return null;
          if (typeof currentUser !== "undefined") currentUser = data.user;
          return data.user;
        } catch (e) {
          return null;
        }
      }

      async function cgpaLoadSemesters() {
        cgpaClearMessages();

        if (typeof supabase === "undefined") {
          cgpaShowMessage("cgpaHubError", "Backend not available. Please reload and try again.");
          return;
        }

        const user = await cgpaEnsureUser();
        if (!user) {
          cgpaShowMessage("cgpaHubError", "Your session has expired. Please sign in again.");
          return;
        }

        const { data, error } = await supabase
          .from("cgpa_semesters")
          .select("id, user_id, level, semester, academic_session, is_selected, created_at, updated_at")
          .eq("user_id", user.id)
          .order("level", { ascending: true })
          .order("semester", { ascending: true })
          .order("academic_session", { ascending: true });

        if (error) {
          cgpaShowMessage("cgpaHubError", error.message || "Could not load semesters. Please try again.");
          return;
        }

        cgpaSemestersCache = Array.isArray(data) ? data : [];
        cgpaSelectedSemesterIds = cgpaSelectedSemesterIds.filter((id) => cgpaFindSemesterById(id));
        cgpaSetSelectedSemesterIds(cgpaSelectedSemesterIds);

        await cgpaLoadHubSummary();
        cgpaRenderHub();
      }

      async function cgpaInvokeCalculator(semesterIds) {
        return await supabase.functions.invoke("cgpa-calculate", {
          body: { semester_ids: semesterIds }
        });
      }

      async function cgpaLoadHubSummary() {
        if (!cgpaSemestersCache.length) {
          cgpaLatestSummary = null;
          cgpaRenderSummaryCard();
          return;
        }

        const allIds = cgpaSemestersCache.map((s) => s.id);

        try {
          const { data, error } = await cgpaInvokeCalculator(allIds);
          if (error || !data?.success) {
            cgpaLatestSummary = null;
            cgpaRenderSummaryCard();
            return;
          }
          cgpaLatestSummary = data;
          cgpaRenderSummaryCard();
        } catch (e) {
          cgpaLatestSummary = null;
          cgpaRenderSummaryCard();
        }
      }

      function cgpaRenderSummaryCard() {
        const currentVal = cgpaQ("cgpaCurrentValue");
        const standingVal = cgpaQ("cgpaCurrentStanding");
        const savedCount = cgpaQ("cgpaSavedCount");
        const totalUnits = cgpaQ("cgpaTotalUnits");

        if (savedCount) savedCount.textContent = String(cgpaSemestersCache.length);

        if (!cgpaLatestSummary?.summary) {
          if (currentVal) currentVal.textContent = "—";
          if (standingVal) standingVal.textContent = cgpaSemestersCache.length ? "Tap Calculate CGPA" : "No result yet";
          if (totalUnits) totalUnits.textContent = "0";
          return;
        }

        const summary = cgpaLatestSummary.summary;
        if (currentVal) currentVal.textContent = Number(summary.cgpa || 0).toFixed(2);
        if (standingVal) standingVal.textContent = summary.class_standing || "—";
        if (totalUnits) totalUnits.textContent = String(summary.total_units || 0);
      }

      function cgpaRenderHub() {
        cgpaRenderSummaryCard();

        const list = cgpaQ("cgpaSemesterList");
        const empty = cgpaQ("cgpaSemesterEmpty");
        const chips = cgpaQ("cgpaSelectedChips");
        const chipsEmpty = cgpaQ("cgpaSelectedEmpty");

        if (list) list.innerHTML = "";
        if (chips) chips.innerHTML = "";

        if (!cgpaSemestersCache.length) {
          if (empty) empty.classList.remove("hidden");
        } else {
          if (empty) empty.classList.add("hidden");

          cgpaSemestersCache.forEach((sem) => {
            const selected = cgpaSelectedSemesterIds.includes(String(sem.id));
            const item = document.createElement("div");
            item.className = "semester-item";
            item.innerHTML = `
              <div class="semester-item-left">
                <div class="semester-item-title">${cgpaFormatSemester(sem.level, sem.semester, sem.academic_session)}</div>
                <div class="semester-item-sub" id="semesterSub_${sem.id}">Loading details...</div>
              </div>
              <div class="semester-item-right">
                <button class="tiny-btn select ${selected ? "active" : ""}" data-semester-select="${sem.id}" type="button">
                  ${selected ? "Selected" : "Select"}
                </button>
                <button class="tiny-btn edit" data-semester-edit="${sem.id}" type="button">Edit</button>
              </div>
            `;
            list.appendChild(item);
            cgpaFillSemesterCardSub(sem.id);
          });
        }

        const selectedItems = cgpaSelectedSemesterIds
          .map((id) => cgpaFindSemesterById(id))
          .filter(Boolean);

        if (!selectedItems.length) {
          if (chipsEmpty) chipsEmpty.classList.remove("hidden");
        } else {
          if (chipsEmpty) chipsEmpty.classList.add("hidden");
          selectedItems.forEach((sem) => {
            const chip = document.createElement("div");
            chip.className = "chip";
            chip.innerHTML = `
              <span>${cgpaFormatSemester(sem.level, sem.semester, "").replace(" · ", " · ")}</span>
              <button type="button" data-chip-remove="${sem.id}">×</button>
            `;
            chips.appendChild(chip);
          });
        }

        list?.querySelectorAll("[data-semester-select]").forEach((btn) => {
          btn.addEventListener("click", () => cgpaToggleSelectedSemester(btn.getAttribute("data-semester-select")));
        });

        list?.querySelectorAll("[data-semester-edit]").forEach((btn) => {
          btn.addEventListener("click", () => cgpaOpenEditor(btn.getAttribute("data-semester-edit")));
        });

        chips?.querySelectorAll("[data-chip-remove]").forEach((btn) => {
          btn.addEventListener("click", () => cgpaRemoveSelectedSemester(btn.getAttribute("data-chip-remove")));
        });
      }

      async function cgpaFillSemesterCardSub(semesterId) {
        const sub = cgpaQ("semesterSub_" + semesterId);
        if (!sub) return;

        try {
          const { data, error } = await cgpaInvokeCalculator([semesterId]);
          if (error || !data?.success || !data?.semester_breakdown?.length) {
            sub.textContent = "Could not load GPA.";
            return;
          }

          const item = data.semester_breakdown[0];
          const count = Array.isArray(item.courses) ? item.courses.length : 0;
          sub.textContent = `${count} course${count === 1 ? "" : "s"} • GPA ${Number(item.gpa || 0).toFixed(2)}`;
        } catch (e) {
          sub.textContent = "Could not load GPA.";
        }
      }

      function cgpaRenderPicker() {
        const list = cgpaQ("cgpaPickerList");
        if (!list) return;
        list.innerHTML = "";

        const sessionVal = cgpaSafeText(cgpaQ("cgpaPickerSessionInput")?.value);

        [100, 200, 300, 400, 500, 600, 700].forEach((level) => {
          [1, 2].forEach((semester) => {
            const existing = cgpaSemestersCache.find(
              (s) =>
                Number(s.level) === level &&
                Number(s.semester) === semester &&
                cgpaSafeText(s.academic_session) === sessionVal
            );

            const row = document.createElement("div");
            row.className = "picker-item";
            row.innerHTML = `
              <div>
                <div class="picker-item-title">${cgpaFormatSemester(level, semester, sessionVal)}</div>
                <div class="picker-item-sub">${existing ? "Already saved for this session. Tap to open and edit." : "Tap to create and add courses."}</div>
              </div>
              <div class="picker-badge ${existing ? "done" : ""}">${existing ? "Open" : "Add"}</div>
            `;
            row.addEventListener("click", () => cgpaCreateOrOpenSemester(level, semester, sessionVal));
            list.appendChild(row);
          });
        });
      }

      async function cgpaCreateOrOpenSemester(level, semester, academicSession) {
        cgpaShowMessage("cgpaPickerError", "");

        if (!academicSession) {
          cgpaShowMessage("cgpaPickerError", "Please enter academic session first.");
          return;
        }

        let existing = cgpaSemestersCache.find(
          (s) =>
            Number(s.level) === Number(level) &&
            Number(s.semester) === Number(semester) &&
            cgpaSafeText(s.academic_session) === cgpaSafeText(academicSession)
        );

        if (existing) {
          cgpaOpenEditor(existing.id);
          return;
        }

        const user = await cgpaEnsureUser();
        if (!user) {
          cgpaShowMessage("cgpaPickerError", "Your session has expired. Please sign in again.");
          return;
        }

        const { data, error } = await supabase
          .from("cgpa_semesters")
          .insert([{
            user_id: user.id,
            level: Number(level),
            semester: Number(semester),
            academic_session: academicSession,
            is_selected: true
          }])
          .select()
          .single();

        if (error) {
          cgpaShowMessage("cgpaPickerError", error.message || "Could not create semester.");
          return;
        }

        cgpaSemestersCache.push(data);
        cgpaSetSelectedSemesterIds([...cgpaSelectedSemesterIds, data.id]);
        await cgpaLoadHubSummary();
        cgpaOpenEditor(data.id);
      }

      async function cgpaOpenEditor(semesterId) {
        cgpaClearMessages();

        const semester = cgpaFindSemesterById(semesterId);
        if (!semester) {
          cgpaShowMessage("cgpaHubError", "Semester not found.");
          return;
        }

        cgpaCurrentEditorSemester = semester;
        cgpaEditingCourseId = null;
        cgpaEditorResetForm();

        const title = cgpaQ("cgpaEditorSemesterTitle");
        const sub = cgpaQ("cgpaEditorSemesterSub");
        if (title) title.textContent = cgpaFormatSemester(semester.level, semester.semester, semester.academic_session);
        if (sub) sub.textContent = "Add all your courses, units and grades for this semester, then save.";

        const { data, error } = await supabase
          .from("cgpa_courses")
          .select("id, semester_id, user_id, course_code, course_title, unit, grade_letter, created_at, updated_at")
          .eq("semester_id", semester.id)
          .order("created_at", { ascending: true });

        if (error) {
          cgpaShowMessage("cgpaEditorError", error.message || "Could not load courses for this semester.");
          return;
        }

        cgpaCurrentEditorCourses = Array.isArray(data) ? data : [];
        cgpaRenderEditorCourses();
        cgpaShowPage("cgpaEditorPage");
      }

      function cgpaEditorResetForm() {
        if (cgpaQ("cgpaCourseCodeInput")) cgpaQ("cgpaCourseCodeInput").value = "";
        if (cgpaQ("cgpaCourseTitleInput")) cgpaQ("cgpaCourseTitleInput").value = "";
        if (cgpaQ("cgpaCourseUnitInput")) cgpaQ("cgpaCourseUnitInput").value = "";
        if (cgpaQ("cgpaCourseGradeInput")) cgpaQ("cgpaCourseGradeInput").value = "";
        cgpaEditingCourseId = null;
      }

      function cgpaRenderEditorCourses() {
        const list = cgpaQ("cgpaCourseList");
        const empty = cgpaQ("cgpaCourseEmpty");

        if (list) list.innerHTML = "";

        if (!cgpaCurrentEditorCourses.length) {
          if (empty) empty.classList.remove("hidden");
        } else {
          if (empty) empty.classList.add("hidden");

          cgpaCurrentEditorCourses.forEach((course) => {
            const gp = cgpaGradePoint(course.grade_letter);
            const qp = Number(course.unit || 0) * gp;
            const div = document.createElement("div");
            div.className = "course-item";
            div.innerHTML = `
              <div class="course-item-top">
                <div>
                  <div class="course-code">${cgpaSafeText(course.course_code) || "Course"}</div>
                  <div class="course-title">${cgpaSafeText(course.course_title) || "No title added"}</div>
                </div>
                <div class="course-meta">${Number(course.unit || 0)} unit(s) · ${cgpaSafeText(course.grade_letter)} · ${cgpaRound2(qp)} pts</div>
              </div>
              <div class="course-actions">
                <button class="tiny-btn edit" data-course-edit="${course.id}" type="button">Edit</button>
                <button class="tiny-btn remove" data-course-delete="${course.id}" type="button">Delete</button>
              </div>
            `;
            list.appendChild(div);
          });
        }

        list?.querySelectorAll("[data-course-edit]").forEach((btn) => {
          btn.addEventListener("click", () => cgpaLoadCourseIntoForm(btn.getAttribute("data-course-edit")));
        });

        list?.querySelectorAll("[data-course-delete]").forEach((btn) => {
          btn.addEventListener("click", () => cgpaDeleteCourse(btn.getAttribute("data-course-delete")));
        });

        cgpaRenderEditorPreview();
      }

      function cgpaRenderEditorPreview() {
        const totalCourses = cgpaCurrentEditorCourses.length;
        let totalUnits = 0;
        let qualityPoints = 0;

        cgpaCurrentEditorCourses.forEach((course) => {
          const unit = Number(course.unit || 0);
          const gp = cgpaGradePoint(course.grade_letter);
          totalUnits += unit;
          qualityPoints += unit * gp;
        });

        const gpa = totalUnits > 0 ? qualityPoints / totalUnits : 0;

        if (cgpaQ("cgpaEditorPreviewCourses")) cgpaQ("cgpaEditorPreviewCourses").textContent = String(totalCourses);
        if (cgpaQ("cgpaEditorPreviewUnits")) cgpaQ("cgpaEditorPreviewUnits").textContent = String(cgpaRound2(totalUnits));
        if (cgpaQ("cgpaEditorPreviewGpa")) cgpaQ("cgpaEditorPreviewGpa").textContent = Number(gpa).toFixed(2);
        if (cgpaQ("cgpaEditorPreviewStanding")) cgpaQ("cgpaEditorPreviewStanding").textContent = cgpaStandingFromCgpa(gpa);
      }

      function cgpaLoadCourseIntoForm(courseId) {
        const course = cgpaCurrentEditorCourses.find((c) => String(c.id) === String(courseId));
        if (!course) return;

        cgpaEditingCourseId = course.id;
        cgpaQ("cgpaCourseCodeInput").value = cgpaSafeText(course.course_code);
        cgpaQ("cgpaCourseTitleInput").value = cgpaSafeText(course.course_title);
        cgpaQ("cgpaCourseUnitInput").value = String(course.unit || "");
        cgpaQ("cgpaCourseGradeInput").value = cgpaSafeText(course.grade_letter).toUpperCase();
        cgpaShowMessage("cgpaEditorSuccess", "Course loaded for editing.", "success");
      }

      async function cgpaAddOrUpdateCourse() {
        cgpaShowMessage("cgpaEditorError", "");
        cgpaShowMessage("cgpaEditorSuccess", "");

        if (!cgpaCurrentEditorSemester?.id) {
          cgpaShowMessage("cgpaEditorError", "No semester is open.");
          return;
        }

        const course_code = cgpaSafeText(cgpaQ("cgpaCourseCodeInput")?.value);
        const course_title = cgpaSafeText(cgpaQ("cgpaCourseTitleInput")?.value);
        const unit = Number(cgpaQ("cgpaCourseUnitInput")?.value || 0);
        const grade_letter = cgpaSafeText(cgpaQ("cgpaCourseGradeInput")?.value).toUpperCase();
        const user = await cgpaEnsureUser();

        if (!user) {
          cgpaShowMessage("cgpaEditorError", "Your session has expired. Please sign in again.");
          return;
        }

        if (!course_code) {
          cgpaShowMessage("cgpaEditorError", "Enter course code.");
          return;
        }

        if (!(unit > 0)) {
          cgpaShowMessage("cgpaEditorError", "Enter a valid course unit.");
          return;
        }

        if (!["A", "B", "C", "D", "E", "F"].includes(grade_letter)) {
          cgpaShowMessage("cgpaEditorError", "Choose a valid grade.");
          return;
        }

        const payload = {
          semester_id: cgpaCurrentEditorSemester.id,
          user_id: user.id,
          course_code,
          course_title: course_title || null,
          unit,
          grade_letter
        };

        if (cgpaEditingCourseId) {
          const { data, error } = await supabase
            .from("cgpa_courses")
            .update(payload)
            .eq("id", cgpaEditingCourseId)
            .select()
            .single();

          if (error) {
            cgpaShowMessage("cgpaEditorError", error.message || "Could not update course.");
            return;
          }

          cgpaCurrentEditorCourses = cgpaCurrentEditorCourses.map((c) =>
            String(c.id) === String(cgpaEditingCourseId) ? data : c
          );
          cgpaEditorResetForm();
          cgpaRenderEditorCourses();
          cgpaShowMessage("cgpaEditorSuccess", "Course updated.", "success");
          return;
        }

        const { data, error } = await supabase
          .from("cgpa_courses")
          .insert([payload])
          .select()
          .single();

        if (error) {
          cgpaShowMessage("cgpaEditorError", error.message || "Could not add course.");
          return;
        }

        cgpaCurrentEditorCourses.push(data);
        cgpaEditorResetForm();
        cgpaRenderEditorCourses();
        cgpaShowMessage("cgpaEditorSuccess", "Course added.", "success");
      }

      async function cgpaDeleteCourse(courseId) {
        if (!confirm("Delete this course from the semester?")) return;

        const { error } = await supabase
          .from("cgpa_courses")
          .delete()
          .eq("id", courseId);

        if (error) {
          cgpaShowMessage("cgpaEditorError", error.message || "Could not delete course.");
          return;
        }

        cgpaCurrentEditorCourses = cgpaCurrentEditorCourses.filter((c) => String(c.id) !== String(courseId));
        cgpaRenderEditorCourses();
        cgpaShowMessage("cgpaEditorSuccess", "Course deleted.", "success");
      }

      async function cgpaSaveSemesterAndBack() {
        if (!cgpaCurrentEditorSemester?.id) {
          cgpaShowMessage("cgpaEditorError", "No semester is open.");
          return;
        }

        if (!cgpaCurrentEditorCourses.length) {
          cgpaShowMessage("cgpaEditorError", "Add at least one course before saving.");
          return;
        }

        if (!cgpaSelectedSemesterIds.includes(String(cgpaCurrentEditorSemester.id))) {
          cgpaSetSelectedSemesterIds([...cgpaSelectedSemesterIds, String(cgpaCurrentEditorSemester.id)]);
        }

        await cgpaLoadSemesters();
        cgpaShowPage("cgpaHubPage");
        cgpaShowMessage("cgpaHubSuccess", "Semester saved successfully.", "success");
      }

      async function cgpaCalculateSelected() {
        cgpaShowMessage("cgpaHubError", "");
        cgpaShowMessage("cgpaResultError", "");

        if (!cgpaSelectedSemesterIds.length) {
          cgpaShowMessage("cgpaHubError", "Select at least one semester.");
          return;
        }

        try {
          const { data, error } = await cgpaInvokeCalculator(cgpaSelectedSemesterIds);

          if (error || !data?.success) {
            cgpaShowMessage("cgpaHubError", data?.error || error?.message || "Could not calculate CGPA.");
            return;
          }

          cgpaRenderResult(data);
          cgpaShowPage("cgpaResultPage");
        } catch (e) {
          cgpaShowMessage("cgpaHubError", "Could not calculate CGPA.");
        }
      }

      function cgpaRenderResult(data) {
        const summary = data?.summary || {};
        const breakdown = Array.isArray(data?.semester_breakdown) ? data.semester_breakdown : [];

        if (cgpaQ("cgpaResultCgpa")) cgpaQ("cgpaResultCgpa").textContent = Number(summary.cgpa || 0).toFixed(2);
        if (cgpaQ("cgpaResultUnits")) cgpaQ("cgpaResultUnits").textContent = String(summary.total_units || 0);
        if (cgpaQ("cgpaResultQualityPoints")) cgpaQ("cgpaResultQualityPoints").textContent = String(summary.total_quality_points || 0);
        if (cgpaQ("cgpaResultSemestersUsed")) cgpaQ("cgpaResultSemestersUsed").textContent = String(summary.total_semesters || breakdown.length || 0);

        if (cgpaQ("cgpaResultStanding")) cgpaQ("cgpaResultStanding").textContent = summary.class_standing || "—";
        if (cgpaQ("cgpaResultStandingSub")) {
          cgpaQ("cgpaResultStandingSub").textContent =
            summary.class_standing
              ? `This result was calculated from ${summary.total_semesters || breakdown.length} selected semester(s).`
              : "Your current class standing will appear here.";
        }

        const selectedList = cgpaQ("cgpaResultSelectedList");
        const breakdownList = cgpaQ("cgpaResultBreakdown");
        if (selectedList) selectedList.innerHTML = "";
        if (breakdownList) breakdownList.innerHTML = "";

        breakdown.forEach((item) => {
          const selected = document.createElement("div");
          selected.className = "breakdown-item";
          selected.innerHTML = `
            <div class="breakdown-head">
              <div class="breakdown-title">${cgpaFormatSemester(item.level, item.semester, item.academic_session)}</div>
              <div class="breakdown-gpa">GPA ${Number(item.gpa || 0).toFixed(2)}</div>
            </div>
            <div class="breakdown-sub">${item.total_units || 0} unit(s) • ${Array.isArray(item.courses) ? item.courses.length : 0} course(s)</div>
          `;
          selectedList?.appendChild(selected);
        });

        breakdown.forEach((item) => {
          const row = document.createElement("div");
          row.className = "breakdown-item";
          row.innerHTML = `
            <div class="breakdown-head">
              <div class="breakdown-title">${cgpaFormatSemester(item.level, item.semester, item.academic_session)}</div>
              <div class="breakdown-gpa">GPA ${Number(item.gpa || 0).toFixed(2)}</div>
            </div>
            <div class="breakdown-sub">
              ${item.total_units || 0} unit(s) • ${item.total_quality_points || 0} quality point(s)
            </div>
          `;
          breakdownList?.appendChild(row);
        });
      }

      function cgpaGoHub() {
        cgpaShowPage("cgpaHubPage");
      }

      function cgpaBindEvents() {
        cgpaQ("btnOpenSemesterPicker")?.addEventListener("click", () => {
          cgpaShowMessage("cgpaPickerError", "");
          const input = cgpaQ("cgpaPickerSessionInput");
          if (input && !input.value.trim()) input.value = "";
          cgpaRenderPicker();
          cgpaShowPage("cgpaPickerPage");
        });

        cgpaQ("btnCalculateCgpa")?.addEventListener("click", cgpaCalculateSelected);
        cgpaQ("btnClearSelectedSemesters")?.addEventListener("click", cgpaClearAllSelectedSemesters);

        cgpaQ("btnBackFromPicker")?.addEventListener("click", () => {
          cgpaGoHub();
        });

        cgpaQ("cgpaPickerSessionInput")?.addEventListener("input", cgpaRenderPicker);

        cgpaQ("btnAddCourseToSemester")?.addEventListener("click", cgpaAddOrUpdateCourse);
        cgpaQ("btnCancelCourseEdit")?.addEventListener("click", () => {
          cgpaEditorResetForm();
          cgpaShowMessage("cgpaEditorSuccess", "Course edit cancelled.", "success");
        });

        cgpaQ("btnBackFromEditor")?.addEventListener("click", () => {
          cgpaGoHub();
        });

        cgpaQ("btnSaveSemesterCourses")?.addEventListener("click", cgpaSaveSemesterAndBack);

        cgpaQ("btnBackFromResult")?.addEventListener("click", () => {
          cgpaGoHub();
        });

        cgpaQ("btnCalculateAgain")?.addEventListener("click", () => {
          cgpaGoHub();
        });
      }

      async function cgpaInit() {
        cgpaLoadSelectedSemesterIds();
        cgpaBindEvents();
        cgpaShowPage("cgpaHubPage");
        await cgpaLoadSemesters();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", cgpaInit);
      } else {
        cgpaInit();
      }
    })();
  </script>
</div>
