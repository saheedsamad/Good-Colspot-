  function studentBindChoiceGroup(containerId, questionId, multiple = false) {
    const wrap = document.getElementById(containerId);
    if (!wrap) return;

    wrap.querySelectorAll(".choice-option").forEach((node) => {
      node.addEventListener("click", () => {
        const value = node.getAttribute("data-choice-value") || "";
        if (!value) return;

        if (multiple) {
          const current = Array.isArray(studentGetFormAnswer(questionId)) ? [...studentGetFormAnswer(questionId)] : [];
          const exists = current.includes(value);
          const next = exists ? current.filter((x) => x !== value) : [...current, value];
          studentSetFormAnswer(questionId, next);

          wrap.querySelectorAll(".choice-option").forEach((el) => {
            const v = el.getAttribute("data-choice-value") || "";
            el.classList.toggle("active", next.includes(v));
          });
        } else {
          studentSetFormAnswer(questionId, value);
          wrap.querySelectorAll(".choice-option").forEach((el) => {
            el.classList.toggle("active", el.getAttribute("data-choice-value") === value);
          });
        }
      });
    });
  }

  function studentRenderFormQuestion() {
    const state = window.studentClassActivityState;
    const q = studentGetCurrentFormQuestion();
    if (!q) return;

    const total = state.formQuestions.length || 1;
    const current = state.currentFormIndex + 1;
    const percent = Math.round((current / total) * 100);

    const titleEl = document.getElementById("studentFormQuestionTitle");
    const helpEl = document.getElementById("studentFormQuestionHelp");
    const progressTextEl = document.getElementById("studentFormProgressText");
    const progressPercentEl = document.getElementById("studentFormProgressPercent");
    const progressBarEl = document.getElementById("studentFormProgressBar");
    const nextBtn = document.getElementById("studentFormNextBtn");

    if (titleEl) titleEl.textContent = q.question_text || "Question";
    if (helpEl) {
      helpEl.textContent = q.help_text || "";
      helpEl.classList.toggle("hidden", !studentNormalizeText(q.help_text));
    }
    if (progressTextEl) progressTextEl.textContent = `Question ${current} of ${total}`;
    if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
    if (progressBarEl) progressBarEl.style.width = `${percent}%`;
    if (nextBtn) nextBtn.textContent = current === total ? "Review" : "Next";

    studentHideFormBlocks();
    studentSetFormFieldNote("");

    const answer = studentGetFormAnswer(q.id);
    const type = q.question_type || "short_answer";
    const options = studentEnsureArray(q.options_json);

    if (type === "short_answer") {
      const block = document.getElementById("studentFormShortAnswerBlock");
      const input = document.getElementById("studentFormShortAnswerInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.value = typeof answer === "string" ? answer : "";
        input.placeholder = q.placeholder_text || "Type your answer";
      }
    } else if (type === "paragraph") {
      const block = document.getElementById("studentFormParagraphBlock");
      const input = document.getElementById("studentFormParagraphInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.value = typeof answer === "string" ? answer : "";
        input.placeholder = q.placeholder_text || "Type your answer here";
      }
    } else if (type === "multiple_choice") {
      const block = document.getElementById("studentFormMultipleChoiceBlock");
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = options.map((opt, index) => {
          const value = String(opt);
          const active = answer === value;
          const mark = String.fromCharCode(65 + index);
          return `
            <div class="choice-option ${active ? "active" : ""}" data-choice-value="${studentReportEscape(value)}">
              <div class="choice-mark">${studentReportEscape(mark)}</div>
              <div class="choice-text">${studentReportEscape(value)}</div>
            </div>
          `;
        }).join("");
        studentBindChoiceGroup("studentFormMultipleChoiceBlock", q.id, false);
      }
    } else if (type === "checkboxes") {
      const block = document.getElementById("studentFormCheckboxBlock");
      const selected = Array.isArray(answer) ? answer : [];
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = options.map((opt, index) => {
          const value = String(opt);
          const active = selected.includes(value);
          const mark = String.fromCharCode(65 + index);
          return `
            <div class="choice-option ${active ? "active" : ""}" data-choice-value="${studentReportEscape(value)}">
              <div class="choice-mark">${studentReportEscape(mark)}</div>
              <div class="choice-text">${studentReportEscape(value)}</div>
            </div>
          `;
        }).join("");
        studentBindChoiceGroup("studentFormCheckboxBlock", q.id, true);
      }
    } else if (type === "dropdown") {
      const block = document.getElementById("studentFormDropdownBlock");
      const select = document.getElementById("studentFormDropdownInput");
      if (block) block.classList.remove("hidden");
      if (select) {
        select.innerHTML = `<option value="">Select an option</option>` + options.map((opt) => {
          const value = String(opt);
          return `<option value="${studentReportEscape(value)}">${studentReportEscape(value)}</option>`;
        }).join("");
        select.value = typeof answer === "string" ? answer : "";
      }
    } else if (type === "yes_no") {
      const block = document.getElementById("studentFormYesNoBlock");
      const values = options.length ? options : ["Yes", "No"];
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = values.map((opt, index) => {
          const value = String(opt);
          const active = answer === value;
          const mark = index === 0 ? "Y" : "N";
          return `
            <div class="choice-option ${active ? "active" : ""}" data-choice-value="${studentReportEscape(value)}">
              <div class="choice-mark">${studentReportEscape(mark)}</div>
              <div class="choice-text">${studentReportEscape(value)}</div>
            </div>
          `;
        }).join("");
        studentBindChoiceGroup("studentFormYesNoBlock", q.id, false);
      }
    } else if (type === "date") {
      const block = document.getElementById("studentFormDateBlock");
      const input = document.getElementById("studentFormDateInput");
      if (block) block.classList.remove("hidden");
      if (input) input.value = typeof answer === "string" ? answer : "";
    } else if (type === "file_upload") {
      const block = document.getElementById("studentFormFileBlock");
      const fileRules = document.getElementById("studentFormFileRules");
      const input = document.getElementById("studentFormFileInput");
      if (block) block.classList.remove("hidden");

      const allowedTypes = studentEnsureArray(q.allowed_file_types).join(", ") || "Any supported file";
      const maxFiles = Number(q.max_files || 1);
      const maxSize = Number(q.max_file_size_mb || 5);

      if (fileRules) {
        fileRules.textContent = `${allowedTypes} · Max ${maxFiles} file${maxFiles > 1 ? "s" : ""} · Max ${maxSize}MB`;
      }

      if (input) {
        input.value = "";
        input.multiple = maxFiles > 1;
      }

      const existingFiles = Array.isArray(answer?.files) ? answer.files : [];
      studentSetFormFieldNote(existingFiles.length ? `${existingFiles.length} file selected.` : "Choose file to attach.");
    } else {
      const block = document.getElementById("studentFormShortAnswerBlock");
      const input = document.getElementById("studentFormShortAnswerInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.value = typeof answer === "string" ? answer : "";
        input.placeholder = q.placeholder_text || "Type your answer";
      }
    }
  }

  function studentReadCurrentFormAnswer() {
    const q = studentGetCurrentFormQuestion();
    if (!q) return null;

    const type = q.question_type || "short_answer";

    if (type === "short_answer") {
      return studentNormalizeText(document.getElementById("studentFormShortAnswerInput")?.value || "");
    }

    if (type === "paragraph") {
      return studentNormalizeText(document.getElementById("studentFormParagraphInput")?.value || "");
    }

    if (type === "dropdown") {
      return studentNormalizeText(document.getElementById("studentFormDropdownInput")?.value || "");
    }

    if (type === "date") {
      return studentNormalizeText(document.getElementById("studentFormDateInput")?.value || "");
    }

    if (type === "file_upload") {
      return studentGetFormAnswer(q.id) || null;
    }

    return studentGetFormAnswer(q.id) || null;
  }

  function studentValidateCurrentFormAnswer() {
    const q = studentGetCurrentFormQuestion();
    if (!q) return { ok: false, message: "Missing question." };

    const value = studentReadCurrentFormAnswer();

    if (q.is_required) {
      if (q.question_type === "checkboxes") {
        if (!Array.isArray(value) || !value.length) {
          return { ok: false, message: "Please select at least one option." };
        }
      } else if (q.question_type === "file_upload") {
        if (!value || !Array.isArray(value.files) || !value.files.length) {
          return { ok: false, message: "Please choose a file before continuing." };
        }
      } else if (!value || (typeof value === "string" && !studentNormalizeText(value))) {
        return { ok: false, message: "This question is required." };
      }
    }

    return { ok: true, value };
  }

  function studentStoreCurrentFormAnswer() {
    const q = studentGetCurrentFormQuestion();
    if (!q) return { ok: false, message: "Missing question." };

    const checked = studentValidateCurrentFormAnswer();
    if (!checked.ok) return checked;

    studentSetFormAnswer(q.id, checked.value);
    return { ok: true };
  }

  function studentFormAnswerSummary(question, answer) {
    if (answer == null || answer === "") return "No answer";
    if (Array.isArray(answer)) return answer.join(", ");
    if (typeof answer === "object" && Array.isArray(answer.files)) {
      return answer.files.map((f) => f.name || "File").join(", ");
    }
    return String(answer);
  }

