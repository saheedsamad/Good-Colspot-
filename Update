  function studentStoreCurrentFormAnswer() {
    const q = studentGetCurrentFormQuestion();
    if (!q) return { ok: true };

    const type = q.question_type;

    if (type === "short_answer") {
      const input = document.getElementById("studentFormShortAnswerInput");
      studentSetCurrentFormValue(input ? input.value || "" : "");
    } else if (type === "paragraph") {
      const input = document.getElementById("studentFormParagraphInput");
      studentSetCurrentFormValue(input ? input.value || "" : "");
    } else if (type === "dropdown") {
      const input = document.getElementById("studentFormDropdownInput");
      studentSetCurrentFormValue(input ? input.value || "" : "");
    } else if (type === "date") {
      const input = document.getElementById("studentFormDateInput");
      studentSetCurrentFormValue(input ? input.value || "" : "");
    }

    if (!studentValidateCurrentFormQuestion()) {
      return {
        ok: false,
        message: "Please answer this required question before continuing."
      };
    }

    return { ok: true };
  }

  function studentBuildFormAnswersPayload(responseId) {
    const state = window.studentClassActivityState;
    return (state.formQuestions || []).map((q) => {
      const rawValue = state.formAnswers[q.id];

      let answerText = null;
      let answerJson = null;

      if (q.question_type === "checkboxes") {
        answerJson = Array.isArray(rawValue) ? rawValue : [];
      } else if (q.question_type === "file_upload") {
        answerJson = Array.isArray(rawValue) ? rawValue : (rawValue ? [rawValue] : []);
      } else {
        answerText = rawValue != null ? String(rawValue) : null;
      }

      return {
        response_id: responseId,
        question_id: q.id,
        answer_text: answerText,
        answer_json: answerJson
      };
    });
  }

  async function studentSubmitForm() {
    const btn = document.getElementById("studentSubmitFormBtn");
    const oldText = btn ? btn.textContent : "Submit form";

    if (btn) {
      btn.disabled = true;
      btn.textContent = "Submitting...";
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again.");

      const state = window.studentClassActivityState;
      const form = state.currentForm;
      if (!form) throw new Error("Missing form.");

      for (let i = 0; i < state.formQuestions.length; i += 1) {
        state.currentFormIndex = i;
        const checked = studentStoreCurrentFormAnswer();
        if (!checked.ok) throw new Error(checked.message || "Please complete all required questions.");
      }

      const existingResponseId = state.currentFormResponseId || null;

      if (existingResponseId) {
        const { error: deleteError } = await supabase
          .from("form_answers")
          .delete()
          .eq("response_id", existingResponseId);

        if (deleteError) throw deleteError;

        const rows = studentBuildFormAnswersPayload(existingResponseId);
        if (rows.length) {
          const { error: answerError } = await supabase
            .from("form_answers")
            .insert(rows);
          if (answerError) throw answerError;
        }

        const { error: updateResponseError } = await supabase
          .from("form_responses")
          .update({
            status: "submitted",
            submitted_at: new Date().toISOString()
          })
          .eq("id", existingResponseId);

        if (updateResponseError) throw updateResponseError;
      } else {
        const { data: createdResponse, error: responseError } = await supabase
          .from("form_responses")
          .insert([{
            form_id: form.id,
            submitted_by: user.id,
            submitted_by_role: "student",
            submitter_name: user.user_metadata?.full_name || user.email || "Student",
            submitter_email: user.email || null,
            school_name: form.school_name || null,
            status: "submitted"
          }])
          .select("id")
          .single();

        if (responseError) throw responseError;

        state.currentFormResponseId = createdResponse.id;

        const rows = studentBuildFormAnswersPayload(createdResponse.id);
        if (rows.length) {
          const { error: answerError } = await supabase
            .from("form_answers")
            .insert(rows);
          if (answerError) throw answerError;
        }
      }

      studentShowReportsView("studentFormSubmittedView");
      await studentLoadReportsFeed();
    } catch (err) {
      console.error("studentSubmitForm failed:", err);
      alert(err?.message || "Could not submit this form right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

