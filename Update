<!-- 🔹 STUDENT CLASS + SCHOOL FORMS + ANNOUNCEMENTS SCREEN START -->
<div id="screen-reports" class="screen">
  <style>
    #screen-reports{
      --reports-blue:#2563eb;
      --reports-blue-dark:#1d4ed8;
      --reports-blue-soft:#eff6ff;
      --reports-purple:#7c3aed;
      --reports-purple-soft:#f5f3ff;
      --reports-green:#16a34a;
      --reports-green-soft:#ecfdf5;
      --reports-amber:#d97706;
      --reports-amber-soft:#fffbeb;
      --reports-red:#dc2626;
      --reports-red-soft:#fef2f2;
      --reports-text:#0f172a;
      --reports-muted:#64748b;
      --reports-line:#e5e7eb;
      --reports-line-2:#dbeafe;
      --reports-card:#ffffff;
      --reports-bg:#f8fbff;
      --reports-shadow:0 10px 30px rgba(15,23,42,.06);
      --reports-shadow-strong:0 18px 44px rgba(15,23,42,.08);

      padding:8px 6px 100px;
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
      background:
        radial-gradient(circle at top left, rgba(37,99,235,.06), transparent 28%),
        linear-gradient(180deg,#f8fbff 0%, #f6f9ff 38%, #f8fbff 100%);
    }

    #screen-reports *{
      box-sizing:border-box;
    }

    #screen-reports .hidden{
      display:none !important;
    }

    #screen-reports .reports-shell{
      display:flex;
      flex-direction:column;
      gap:12px;
    }

    #screen-reports .hero{
      padding:4px 4px 2px;
      margin-bottom:2px;
    }

    #screen-reports .hero-line-1{
      font-size:12px;
      font-weight:600;
      color:var(--reports-muted);
      margin-bottom:4px;
      letter-spacing:.02em;
      text-transform:uppercase;
    }

    #screen-reports .hero-title{
      font-size:22px;
      font-weight:900;
      letter-spacing:-0.04em;
      line-height:1.15;
      color:var(--reports-text);
      margin:0;
    }

    #screen-reports .hero-title span{
      color:var(--reports-blue);
      font-weight:800;
    }

    #screen-reports .hero-sub{
      font-size:12px;
      color:var(--reports-muted);
      margin:7px 0 0;
      line-height:1.5;
    }

    #screen-reports .reports-top-card{
      border-radius:22px;
      background:linear-gradient(135deg,#eff6ff,#ffffff);
      border:1px solid var(--reports-line-2);
      padding:14px 14px 12px;
      box-shadow:var(--reports-shadow);
      display:flex;
      flex-direction:column;
      gap:12px;
      margin:2px 2px 2px;
    }

    #screen-reports .reports-top-head{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
    }

    #screen-reports .reports-top-title{
      font-size:15px;
      font-weight:800;
      color:var(--reports-text);
      margin-bottom:4px;
    }

    #screen-reports .reports-top-sub{
      font-size:12px;
      color:var(--reports-muted);
      line-height:1.45;
    }

    #screen-reports .reports-pending-badge{
      min-width:54px;
      border-radius:999px;
      padding:8px 10px;
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
      color:#fff;
      font-size:12px;
      font-weight:800;
      text-align:center;
      box-shadow:0 12px 30px rgba(37,99,235,.20);
      white-space:nowrap;
    }

    #screen-reports .reports-stats{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:10px;
    }

    #screen-reports .reports-stat{
      min-height:78px;
      border-radius:18px;
      background:#fff;
      border:1px solid #e7eef8;
      padding:12px;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      gap:8px;
    }

    #screen-reports .reports-stat-label{
      font-size:11px;
      font-weight:700;
      color:var(--reports-muted);
      text-transform:uppercase;
      letter-spacing:.03em;
    }

    #screen-reports .reports-stat-value{
      font-size:20px;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--reports-text);
    }

    #screen-reports .reports-toolbar{
      display:flex;
      flex-direction:column;
      gap:10px;
      margin:0 2px;
    }

    #screen-reports .reports-tabs{
      display:flex;
      gap:8px;
      overflow-x:auto;
      padding-bottom:2px;
      scrollbar-width:none;
    }

    #screen-reports .reports-tabs::-webkit-scrollbar{
      display:none;
    }

    #screen-reports .reports-tab{
      border:none;
      background:#fff;
      color:var(--reports-text);
      border:1px solid var(--reports-line);
      padding:10px 14px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      white-space:nowrap;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
      box-shadow:0 6px 18px rgba(15,23,42,.04);
    }

    #screen-reports .reports-tab.active{
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
      color:#fff;
      border-color:transparent;
      box-shadow:0 14px 34px rgba(37,99,235,.22);
    }

    #screen-reports .reports-tab-count{
      min-width:20px;
      height:20px;
      border-radius:999px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size:11px;
      font-weight:800;
      background:rgba(15,23,42,.06);
      color:inherit;
      padding:0 6px;
    }

    #screen-reports .reports-tab.active .reports-tab-count{
      background:rgba(255,255,255,.18);
    }

    #screen-reports .reports-search{
      position:relative;
    }

    #screen-reports .reports-search svg{
      position:absolute;
      left:12px;
      top:50%;
      transform:translateY(-50%);
      width:16px;
      height:16px;
      color:#94a3b8;
      pointer-events:none;
    }

    #screen-reports .reports-search input{
      width:100%;
      border-radius:16px;
      border:1px solid var(--reports-line);
      background:#fff;
      color:var(--reports-text);
      font-size:13px;
      padding:12px 12px 12px 38px;
      outline:none;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
    }

    #screen-reports .reports-search input:focus{
      border-color:#93c5fd;
      box-shadow:0 0 0 3px rgba(37,99,235,.10);
    }

    #screen-reports .feed-list{
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-top:2px;
      padding:0 2px;
    }

    #screen-reports .feed-card{
      border-radius:22px;
      background:var(--reports-card);
      border:1px solid var(--reports-line);
      padding:13px;
      box-shadow:var(--reports-shadow);
      cursor:pointer;
      transition:transform .05s ease, box-shadow .15s ease;
    }

    #screen-reports .feed-card:active{
      transform:scale(.992);
    }

    #screen-reports .feed-card-top{
      display:flex;
      gap:12px;
      justify-content:space-between;
      align-items:flex-start;
      margin-bottom:10px;
    }

    #screen-reports .feed-card-head{
      min-width:0;
      flex:1;
    }

    #screen-reports .feed-source{
      font-size:11px;
      font-weight:800;
      color:var(--reports-muted);
      text-transform:uppercase;
      letter-spacing:.04em;
      margin-bottom:4px;
    }

    #screen-reports .feed-title{
      font-size:15px;
      font-weight:800;
      line-height:1.35;
      color:var(--reports-text);
      margin:0 0 4px;
      word-break:break-word;
    }

    #screen-reports .feed-subtitle{
      font-size:12px;
      color:var(--reports-muted);
      line-height:1.45;
      margin:0;
      word-break:break-word;
    }

    #screen-reports .feed-kind-badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      padding:5px 10px;
      font-size:11px;
      font-weight:800;
      white-space:nowrap;
      border:1px solid transparent;
    }

    #screen-reports .feed-kind-badge.revision{
      background:var(--reports-blue-soft);
      color:var(--reports-blue-dark);
    }

    #screen-reports .feed-kind-badge.assignment{
      background:var(--reports-purple-soft);
      color:#6d28d9;
    }

    #screen-reports .feed-kind-badge.test{
      background:var(--reports-amber-soft);
      color:#b45309;
    }

    #screen-reports .feed-kind-badge.form{
      background:#eef2ff;
      color:#4338ca;
    }

    #screen-reports .feed-kind-badge.closed{
      background:var(--reports-red-soft);
      color:var(--reports-red);
    }

    #screen-reports .feed-kind-badge.submitted{
      background:#f1f5f9;
      color:#475569;
    }

    #screen-reports .feed-meta{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-bottom:12px;
    }

    #screen-reports .feed-pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      border-radius:999px;
      padding:6px 10px;
      font-size:11px;
      font-weight:700;
      background:#f8fafc;
      border:1px solid #e5e7eb;
      color:var(--reports-muted);
      min-height:30px;
    }

    #screen-reports .feed-status-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
    }

    #screen-reports .feed-status{
      font-size:12px;
      font-weight:800;
    }

    #screen-reports .feed-status.not-started{
      color:var(--reports-green);
    }

    #screen-reports .feed-status.in-progress{
      color:var(--reports-blue-dark);
    }

    #screen-reports .feed-status.submitted{
      color:#475569;
    }

    #screen-reports .feed-status.expired,
    #screen-reports .feed-status.closed{
      color:var(--reports-red);
    }

    #screen-reports .feed-open-btn{
      border:none;
      border-radius:999px;
      padding:9px 14px;
      font-size:12px;
      font-weight:800;
      color:#fff;
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
      cursor:pointer;
      box-shadow:0 12px 28px rgba(37,99,235,.20);
    }

    #screen-reports .feed-open-btn.disabled{
      background:#cbd5e1;
      box-shadow:none;
      cursor:default;
      color:#fff;
    }

    #screen-reports .feed-empty{
      border-radius:22px;
      background:#fff;
      border:1px solid var(--reports-line);
      padding:18px 16px;
      font-size:12px;
      color:var(--reports-muted);
      text-align:center;
      box-shadow:var(--reports-shadow);
      line-height:1.55;
    }

    #screen-reports .panel-card{
      border-radius:22px;
      background:#fff;
      border:1px solid var(--reports-line);
      padding:14px;
      box-shadow:var(--reports-shadow);
      margin:8px 2px 14px;
    }

    #screen-reports .panel-back-btn{
      width:100%;
      margin:0 2px 10px;
      border-radius:999px;
      border:1px solid var(--reports-line);
      background:#fff;
      color:var(--reports-text);
      padding:11px 12px;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
    }

    #screen-reports .panel-title{
      font-size:19px;
      font-weight:900;
      color:var(--reports-text);
      letter-spacing:-.03em;
      margin-bottom:8px;
    }

    #screen-reports .panel-course{
      font-size:14px;
      font-weight:800;
      color:var(--reports-text);
      margin-bottom:10px;
    }

    #screen-reports .panel-meta{
      display:flex;
      flex-direction:column;
      gap:8px;
      margin-bottom:14px;
    }

    #screen-reports .panel-meta-item{
      font-size:13px;
      color:var(--reports-text);
      display:flex;
      justify-content:space-between;
      gap:10px;
      padding-bottom:8px;
      border-bottom:1px solid #f1f5f9;
    }

    #screen-reports .panel-meta-item strong{
      text-align:right;
    }

    #screen-reports .info-box{
      border-radius:16px;
      padding:12px;
      font-size:12px;
      line-height:1.55;
      margin-bottom:12px;
      border:1px solid;
    }

    #screen-reports .info-box.blue{
      background:var(--reports-blue-soft);
      border-color:#dbeafe;
      color:#1e3a8a;
    }

    #screen-reports .info-box.green{
      background:var(--reports-green-soft);
      border-color:#bbf7d0;
      color:#166534;
    }

    #screen-reports .info-box.amber{
      background:var(--reports-amber-soft);
      border-color:#fde68a;
      color:#92400e;
    }

    #screen-reports .timer-box{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      border-radius:16px;
      background:var(--reports-blue-soft);
      border:1px solid #dbeafe;
      color:#1e3a8a;
      padding:10px 12px;
      margin-bottom:12px;
    }

    #screen-reports .timer-label{
      font-size:12px;
      font-weight:800;
      color:#1e3a8a;
    }

    #screen-reports .timer-value{
      font-size:18px;
      font-weight:900;
      letter-spacing:.02em;
      color:var(--reports-blue-dark);
      font-variant-numeric:tabular-nums;
    }

    #screen-reports .timer-value.warning{
      color:var(--reports-red);
    }

    #screen-reports .progress-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:8px;
      font-size:12px;
      color:var(--reports-text);
      font-weight:700;
    }

    #screen-reports .progress-track{
      width:100%;
      height:6px;
      border-radius:999px;
      background:#e5e7eb;
      overflow:hidden;
      margin-bottom:14px;
    }

    #screen-reports .progress-bar{
      height:100%;
      width:0%;
      border-radius:999px;
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
    }

    #screen-reports .question-title{
      font-size:17px;
      font-weight:800;
      line-height:1.45;
      color:var(--reports-text);
      margin-bottom:14px;
    }

    #screen-reports .question-help{
      margin:-6px 0 14px;
      font-size:12px;
      color:var(--reports-muted);
      line-height:1.5;
    }

    #screen-reports .question-block{
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-bottom:14px;
    }

    #screen-reports .choice-list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    #screen-reports .choice-option{
      border-radius:16px;
      border:1px solid #e5e7eb;
      background:#fff;
      padding:12px;
      display:flex;
      align-items:flex-start;
      gap:10px;
      cursor:pointer;
      transition:border-color .15s ease, background .15s ease, box-shadow .15s ease;
    }

    #screen-reports .choice-option.active{
      border-color:var(--reports-blue);
      background:var(--reports-blue-soft);
      box-shadow:0 0 0 1px rgba(37,99,235,.18);
    }

    #screen-reports .choice-mark{
      width:28px;
      height:28px;
      border-radius:10px;
      background:#f3f4f6;
      color:var(--reports-text);
      font-size:13px;
      font-weight:800;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      border:1px solid #e5e7eb;
    }

    #screen-reports .choice-option.active .choice-mark{
      background:#dbeafe;
      color:var(--reports-blue-dark);
      border-color:#bfdbfe;
    }

    #screen-reports .choice-text{
      font-size:14px;
      line-height:1.5;
      color:var(--reports-text);
      flex:1;
      word-break:break-word;
    }

    #screen-reports .input-shell,
    #screen-reports .textarea-shell,
    #screen-reports .select-shell,
    #screen-reports .date-shell,
    #screen-reports .file-shell{
      border-radius:18px;
      background:#fff;
      border:1px solid #e5e7eb;
      padding:12px;
      box-shadow:0 8px 20px rgba(15,23,42,.03);
    }

    #screen-reports .text-input,
    #screen-reports .text-area,
    #screen-reports .select-input,
    #screen-reports .date-input{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      color:var(--reports-text);
      font-size:14px;
      padding:0;
      resize:none;
    }

    #screen-reports .text-area{
      min-height:140px;
      line-height:1.55;
    }

    #screen-reports .file-shell{
      border-style:dashed;
      border-color:#bfdbfe;
      background:linear-gradient(180deg,#f8fbff 0%, #ffffff 100%);
    }

    #screen-reports .file-drop{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      gap:8px;
      min-height:150px;
    }

    #screen-reports .file-drop-icon{
      width:52px;
      height:52px;
      border-radius:16px;
      background:#dbeafe;
      color:var(--reports-blue-dark);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    #screen-reports .file-drop-title{
      font-size:14px;
      font-weight:800;
      color:var(--reports-text);
    }

    #screen-reports .file-drop-sub{
      font-size:12px;
      color:var(--reports-muted);
      line-height:1.5;
      max-width:260px;
    }

    #screen-reports .file-drop-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:40px;
      padding:10px 16px;
      border-radius:999px;
      border:none;
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
      color:#fff;
      font-size:12px;
      font-weight:800;
      cursor:pointer;
      box-shadow:0 12px 28px rgba(37,99,235,.18);
    }

    #screen-reports .field-note{
      font-size:11px;
      color:var(--reports-muted);
      line-height:1.45;
      margin-top:2px;
    }

    #screen-reports .nav-row{
      display:flex;
      gap:10px;
    }

    #screen-reports .nav-row button{
      flex:1;
    }

    #screen-reports .ghost-btn{
      border-radius:999px;
      border:1px solid #d1d5db;
      padding:11px 14px;
      font-size:14px;
      font-weight:700;
      background:#fff;
      color:var(--reports-text);
      cursor:pointer;
    }

    #screen-reports .primary-btn{
      border:none;
      border-radius:999px;
      padding:12px 16px;
      font-size:14px;
      font-weight:800;
      background:linear-gradient(135deg,var(--reports-blue),var(--reports-blue-dark));
      color:#fff;
      cursor:pointer;
      box-shadow:0 16px 36px rgba(37,99,235,.22);
    }

    #screen-reports .review-list{
      display:flex;
      flex-direction:column;
      gap:10px;
      margin-bottom:14px;
    }

    #screen-reports .review-item{
      border-radius:16px;
      background:#f9fafb;
      border:1px solid #e5e7eb;
      padding:12px;
      cursor:pointer;
    }

    #screen-reports .review-q{
      font-size:13px;
      font-weight:800;
      color:var(--reports-text);
      margin-bottom:8px;
      line-height:1.45;
    }

    #screen-reports .review-a{
      font-size:13px;
      color:var(--reports-muted);
      line-height:1.5;
      word-break:break-word;
    }

    #screen-reports .review-a strong{
      color:var(--reports-text);
    }

    #screen-reports .submit-note{
      font-size:12px;
      color:var(--reports-muted);
      line-height:1.55;
      margin-bottom:12px;
    }

    #screen-reports .success-wrap{
      text-align:center;
    }

    #screen-reports .success-icon{
      width:80px;
      height:80px;
      border-radius:999px;
      background:var(--reports-green);
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      margin:6px auto 14px;
      box-shadow:0 12px 30px rgba(34,197,94,.25);
    }

    #screen-reports .success-icon svg{
      width:38px;
      height:38px;
    }

    #screen-reports .success-text{
      font-size:14px;
      color:var(--reports-text);
      text-align:center;
      line-height:1.55;
      margin-bottom:14px;
    }

    #screen-reports .success-note{
      border-radius:16px;
      background:var(--reports-blue-soft);
      border:1px solid #dbeafe;
      color:#1e3a8a;
      padding:12px;
      font-size:12px;
      line-height:1.5;
      margin-bottom:14px;
      text-align:center;
    }

    @media (max-width: 520px){
      #screen-reports .reports-stats{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width: 380px){
      #screen-reports .reports-stats{
        grid-template-columns:1fr;
      }

      #screen-reports .feed-status-row,
      #screen-reports .reports-top-head{
        flex-direction:column;
        align-items:stretch;
      }

      #screen-reports .nav-row{
        flex-direction:column;
      }
    }
  </style>

  <section class="reports-shell" id="studentReportsHomeView">
    <section class="hero">
      <div class="hero-line-1">School work</div>
      <h1 class="hero-title">
        Your <span>forms</span>, <span>class activities</span>, and <span>announcements</span>
      </h1>
      <p class="hero-sub">
        Revisions, tests, assignments, school forms, and announcements sent to you will show here in one clean place.
      </p>
    </section>

    <article class="reports-top-card">
      <div class="reports-top-head">
        <div>
          <div class="reports-top-title">Pending work</div>
          <div class="reports-top-sub">
            Open any item below to answer it. Activities, forms, and unread announcements that still need your attention will appear here.
          </div>
        </div>
