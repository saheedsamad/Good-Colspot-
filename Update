<script>
  window.studentClassActivityState = window.studentClassActivityState || {
    activities: [],
    forms: [],
    announcements: [],
    feedItems: [],
    filteredFeedItems: [],
    currentFilter: "all",
    searchTerm: "",
    currentActivity: null,
    currentForm: null,
    currentAnnouncement: null,
    activityQuestions: [],
    formQuestions: [],
    activityAnswers: {},
    formAnswers: {},
    currentActivityIndex: 0,
    currentFormIndex: 0,
    currentAttemptId: null,
    currentAttemptExpiresAt: null,
    currentFormResponseId: null,
    timerInterval: null
  };

  function studentReportEscape(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function studentNormalizeText(value) {
    return String(value ?? "").trim().replace(/\s+/g, " ");
  }

  function studentEnsureArray(value) {
    return Array.isArray(value) ? value : [];
  }

  function studentFmtDateTime(value, fallback = "No date") {
    if (!value) return fallback;
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return fallback;
      return d.toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    } catch {
      return fallback;
    }
  }

  function studentFormatDuration(minutes) {
    const n = Number(minutes || 0);
    if (!n || n <= 0) return "No limit";
    if (n === 1) return "1 minute";
    return `${n} minutes`;
  }

  function studentFormatCountdown(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
  }

  function studentIsExpiredByDate(value) {
    if (!value) return false;
    const time = new Date(value).getTime();
    if (Number.isNaN(time)) return false;
    return time < Date.now();
  }

  async function studentEnsureUser() {
    if (typeof ensureCurrentUser === "function") {
      return await ensureCurrentUser();
    }

    if (window.currentUser) return window.currentUser;
    if (typeof supabase === "undefined") return null;

    try {
      const { data, error } = await supabase.auth.getUser();
      if (error || !data?.user) return null;
      window.currentUser = data.user;
      return data.user;
    } catch {
      return null;
    }
  }

  async function studentInvokeHistoryManager(payload) {
    if (typeof supabase === "undefined") {
      throw new Error("Supabase is not available.");
    }

    console.log("STUDENT HISTORY BODY SENT:", payload);

    const { data, error } = await supabase.functions.invoke("student-history-manager", {
      body: payload
    });

    console.log("STUDENT HISTORY RAW DATA:", data);
    console.log("STUDENT HISTORY RAW ERROR:", error);

    if (error) {
      throw new Error(error.message || "Edge Function returned a non-2xx status code");
    }

    if (!data?.ok) {
      throw new Error(data?.error || "Student history manager failed.");
    }

    return data;
  }

  function studentStopTimer() {
    if (window.studentClassActivityState.timerInterval) {
      clearInterval(window.studentClassActivityState.timerInterval);
      window.studentClassActivityState.timerInterval = null;
    }
  }

  function studentSetTimerText(text, warning = false) {
    ["studentActivityTimerValue", "studentActivityReviewTimerValue"].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      el.classList.toggle("warning", !!warning);
    });
  }

  async function studentAutoSubmitFromTimer() {
    studentStopTimer();
    alert("Time is up. Your activity will be submitted now.");
    await studentSubmitActivity(true);
  }

  function studentStartTimer(expiresAt) {
    studentStopTimer();

    if (!expiresAt) {
      studentSetTimerText("--:--", false);
      return;
    }

    window.studentClassActivityState.currentAttemptExpiresAt = expiresAt;

    const tick = () => {
      const endMs = new Date(expiresAt).getTime();
      const diff = endMs - Date.now();

      if (Number.isNaN(endMs)) {
        studentSetTimerText("--:--", false);
        studentStopTimer();
        return;
      }

      if (diff <= 0) {
        studentSetTimerText("00:00", true);
        studentAutoSubmitFromTimer();
        return;
      }

      const warning = diff <= 5 * 60 * 1000;
      studentSetTimerText(studentFormatCountdown(diff), warning);
    };

    tick();
    window.studentClassActivityState.timerInterval = setInterval(tick, 1000);
  }

  function studentHideAllViews() {
    [
      "studentReportsHomeView",
      "studentActivityIntroView",
      "studentActivityQuestionView",
      "studentActivityReviewView",
      "studentActivitySubmittedView",
      "studentFormDetailsView",
      "studentFormQuestionView",
      "studentFormReviewView",
      "studentFormSubmittedView"
    ].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.classList.add("hidden");
    });
  }

  function studentShowReportsView(viewId) {
    studentHideAllViews();
    const el = document.getElementById(viewId);
    if (el) el.classList.remove("hidden");

    if (
      viewId === "studentReportsHomeView" ||
      viewId === "studentActivityIntroView" ||
      viewId === "studentActivitySubmittedView" ||
      viewId === "studentFormDetailsView" ||
      viewId === "studentFormSubmittedView"
    ) {
      if (viewId !== "studentActivitySubmittedView") {
        studentStopTimer();
      }
    }
  }

  function studentPendingItemCount(items) {
    return studentEnsureArray(items).filter((item) => {
      if (item.item_type === "announcement") return !item.is_read;
      return item.status === "not-started" || item.status === "in-progress";
    }).length;
  }

  function studentUpdateExternalNavBadge(count) {
    const possibleIds = [
      "studentReportsNavBadge",
      "reportsNavBadge",
      "navReportsBadge",
      "studentClassBadge",
      "studentRevisionBadge"
    ];

    possibleIds.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (count > 0) {
        el.textContent = count > 99 ? "99+" : String(count);
        el.style.display = "inline-flex";
      } else {
        el.textContent = "";
        el.style.display = "none";
      }
    });
  }

  function studentRenderFeedStats() {
    const state = window.studentClassActivityState;
    const total = state.feedItems.length;
    const forms = state.forms.length;
    const activities = state.activities.length;
    const announcements = state.announcements.length;
    const pending = studentPendingItemCount(state.feedItems);

    const setText = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    };

    setText("studentReportsTotalCount", total);
    setText("studentReportsFormCount", forms);
    setText("studentReportsActivityCount", activities);
    setText("studentReportsAnnouncementCount", announcements);
    setText("studentReportsAllCount", total);
    setText("studentReportsFormsCount", forms);
    setText("studentReportsActivitiesCount", activities);
    setText("studentReportsAnnouncementsCount", announcements);
    setText("studentReportsPendingCount", pending);

    const pendingBadge = document.getElementById("studentReportsPendingBadge");
    if (pendingBadge) {
      pendingBadge.textContent = pending === 1 ? "1 Pending" : `${pending} Pending`;
    }

    studentUpdateExternalNavBadge(pending);
  }

  function studentFilterFeedItems() {
    const state = window.studentClassActivityState;
    const filter = state.currentFilter || "all";
    const q = studentNormalizeText(state.searchTerm).toLowerCase();

    let list = [...state.feedItems];

    if (filter === "forms") {
      list = list.filter((item) => item.item_type === "form");
    } else if (filter === "activities") {
      list = list.filter((item) => item.item_type === "activity");
    } else if (filter === "announcements") {
      list = list.filter((item) => item.item_type === "announcement");
    } else if (filter === "pending") {
      list = list.filter((item) => {
        if (item.item_type === "announcement") return !item.is_read;
        return item.status === "not-started" || item.status === "in-progress";
      });
    }

    if (q) {
      list = list.filter((item) => {
        const hay = [
          item.title,
          item.sub_title,
          item.class_code,
          item.class_title,
          item.school_name,
          item.description,
          item.body,
          item.notification_body
        ].join(" ").toLowerCase();
        return hay.includes(q);
      });
    }

    state.filteredFeedItems = list;
  }

  function studentFeedKindClass(item) {
    if (item.item_type === "announcement") {
      return item.is_read ? "submitted" : "revision";
    }
    if (item.status === "closed" || item.status === "expired") return "closed";
    if (item.status === "submitted") return "submitted";
    if (item.item_type === "form") return "form";
    if (item.type === "assignment") return "assignment";
    if (item.type === "test") return "test";
    return "revision";
  }

  function studentFeedKindLabel(item) {
    if (item.item_type === "announcement") return "Announcement";
    if (item.status === "closed") return "Closed";
    if (item.status === "expired") return "Expired";
    if (item.status === "submitted") return "Submitted";
    if (item.item_type === "form") return "Form";
    if (item.type === "assignment") return "Assignment";
    if (item.type === "test") return "Test";
    return "Revision";
  }

  function studentFeedStatusClass(item) {
    if (item.item_type === "announcement") {
      return item.is_read ? "submitted" : "not-started";
    }
    if (item.status === "submitted") return "submitted";
    if (item.status === "in-progress") return "in-progress";
    if (item.status === "closed") return "closed";
    if (item.status === "expired") return "expired";
    return "not-started";
  }

  function studentFeedStatusLabel(item) {
    if (item.item_type === "announcement") {
      return item.is_read ? "Read" : "Unread";
    }
    if (item.status === "submitted") return "Submitted";
    if (item.status === "in-progress") return "In progress";
    if (item.status === "closed") return "Closed";
    if (item.status === "expired") return "Expired";
    return "Not started";
  }

  function studentFeedButtonLabel(item) {
    if (item.item_type === "announcement") return "View details";
    if (item.status === "submitted") return "Submitted";
    if (item.status === "in-progress") return "Continue";
    if (item.status === "closed" || item.status === "expired") {
      return item.status === "closed" ? "Closed" : "Expired";
    }
    return "Open";
  }

  function studentRenderFeedList() {
    studentFilterFeedItems();
    studentRenderFeedStats();

    const wrap = document.getElementById("studentReportsFeedList");
    if (!wrap) return;

    const items = window.studentClassActivityState.filteredFeedItems || [];

    if (!items.length) {
      wrap.innerHTML = `<div class="feed-empty">No form, class activity, or announcement matched your current filter.</div>`;
      return;
    }

    wrap.innerHTML = items.map((item) => {
      const kindClass = studentFeedKindClass(item);
      const kindLabel = studentFeedKindLabel(item);
      const statusClass = studentFeedStatusClass(item);
      const statusLabel = studentFeedStatusLabel(item);
      const btnLabel = studentFeedButtonLabel(item);

      const blocked =
        item.item_type !== "announcement" &&
        (item.status === "submitted" || item.status === "closed" || item.status === "expired");

      const sourceLabel =
        item.item_type === "form"
          ? "School form"
          : item.item_type === "announcement"
          ? "School announcement"
          : (item.class_code || "Class activity");

      return `
        <article class="feed-card" data-item-id="${studentReportEscape(item.id)}" data-item-type="${studentReportEscape(item.item_type)}">
          <div class="feed-card-top">
            <div class="feed-card-head">
              <div class="feed-source">${studentReportEscape(sourceLabel)}</div>
              <div class="feed-title">${studentReportEscape(item.title || "Untitled")}</div>
              <div class="feed-subtitle">${studentReportEscape(item.sub_title || "")}</div>
            </div>
            <div class="feed-kind-badge ${studentReportEscape(kindClass)}">${studentReportEscape(kindLabel)}</div>
          </div>

          <div class="feed-meta">
            ${
              item.item_type === "announcement"
                ? `
                  <div class="feed-pill">${studentReportEscape(item.is_read ? "Read" : "Unread")}</div>
                  <div class="feed-pill">${studentReportEscape(studentFmtDateTime(item.created_at, "No date"))}</div>
                  ${item.image_url || item.file_url || item.link_url ? `<div class="feed-pill">Has media</div>` : ""}
                `
                : `
                  ${item.questions_count != null ? `<div class="feed-pill">${studentReportEscape(item.questions_count)} Questions</div>` : ""}
                  ${item.item_type === "activity" ? `<div class="feed-pill">${studentReportEscape(item.time_limit ? studentFormatDuration(item.time_limit) : "No limit")}</div>` : ""}
                  <div class="feed-pill">${studentReportEscape(item.due_text || item.close_text || "No due date")}</div>
                  ${item.item_type === "form" && item.response_rule_text ? `<div class="feed-pill">${studentReportEscape(item.response_rule_text)}</div>` : ""}
                `
            }
          </div>

          <div class="feed-status-row">
            <div class="feed-status ${studentReportEscape(statusClass)}">${studentReportEscape(statusLabel)}</div>
            <button class="feed-open-btn ${blocked ? "disabled" : ""}" type="button" data-item-open="${studentReportEscape(item.id)}" data-item-type="${studentReportEscape(item.item_type)}">
              ${studentReportEscape(btnLabel)}
            </button>
          </div>
        </article>
      `;
    }).join("");
  }

  async function studentLoadReportsFeed() {
    const wrap = document.getElementById("studentReportsFeedList");
    if (wrap) {
      wrap.innerHTML = `<div class="feed-empty">Loading your school forms, class activities, and announcements...</div>`;
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again to continue.");

      const result = await studentInvokeHistoryManager({
        action: "student_feed_bundle",
        user_id: user.id
      });

      const feedItems = studentEnsureArray(result.feed_items);

      const state = window.studentClassActivityState;
      state.forms = feedItems.filter((item) => item.item_type === "form");
      state.activities = feedItems.filter((item) => item.item_type === "activity");
      state.announcements = feedItems.filter((item) => item.item_type === "announcement");
      state.feedItems = feedItems;
      state.filteredFeedItems = feedItems;

      studentRenderFeedList();
    } catch (err) {
      console.error("studentLoadReportsFeed failed:", err);
      if (wrap) {
        wrap.innerHTML = `<div class="feed-empty">Could not load your forms, class activities, and announcements right now.</div>`;
      }
    }
  }

  async function studentOpenActivityIntro(activityId) {
    const user = await studentEnsureUser();
    if (!user) {
      alert("Please sign in again.");
      return;
    }

    try {
      const result = await studentInvokeHistoryManager({
        action: "student_item_details",
        user_id: user.id,
        item_id: activityId,
        item_type: "activity"
      });

      const activity = result.activity || {};
      const questions = studentEnsureArray(result.questions);
      const attempt = result.attempt || null;
      const answers = studentEnsureArray(result.answers);

      const titleEl = document.getElementById("studentActivityIntroTitle");
      const courseEl = document.getElementById("studentActivityIntroCourse");
      const questionsEl = document.getElementById("studentActivityIntroQuestions");
      const timeEl = document.getElementById("studentActivityIntroTime");
      const dueEl = document.getElementById("studentActivityIntroDue");
      const warningEl = document.getElementById("studentActivityStartWarning");
      const startBtn = document.getElementById("studentStartActivityBtn");

      if (titleEl) titleEl.textContent = activity.title || "Activity";
      if (courseEl) courseEl.textContent = `${activity.class_code || ""} - ${activity.class_title || ""}`.trim();
      if (questionsEl) questionsEl.textContent = `${questions.length} Questions`;
      if (timeEl) timeEl.textContent = activity.time_limit_minutes ? studentFormatDuration(activity.time_limit_minutes) : "No limit";
      if (dueEl) dueEl.textContent = studentFmtDateTime(activity.due_at, "No due date");

      if (warningEl) {
        warningEl.textContent = activity.time_limit_minutes
          ? `Once you start, this activity will expire after ${studentFormatDuration(activity.time_limit_minutes)}. A countdown will show at the top while you answer. You can only submit once, and your score will not show immediately.`
          : `You can only submit once. Your score will not show immediately. You will only see confirmation after submission.`;
      }

      if (startBtn) {
        startBtn.textContent = (attempt && !attempt.submitted_at) ? "Continue activity" : "Start activity";
      }

      const state = window.studentClassActivityState;
      state.currentActivity = {
        id: activity.id,
        item_type: "activity",
        class_id: activity.class_id,
        class_code: activity.class_code || "Class",
        class_title: activity.class_title || "",
        title: activity.title || "Untitled activity",
        time_limit: activity.time_limit_minutes || null,
        due_at: activity.due_at || null,
        due_text: studentFmtDateTime(activity.due_at, "No due date"),
        attempt_id: attempt?.id || null,
        expires_at: attempt?.expires_at || null,
        status: activity.computed_status || "not-started"
      };

      state.activityQuestions = questions.map((q) => ({
        id: q.id,
        question: q.question_text,
        options: {
          A: q.option_a,
          B: q.option_b,
          C: q.option_c,
          D: q.option_d
        },
        position: q.position
      }));

      state.activityAnswers = {};
      answers.forEach((row) => {
        state.activityAnswers[row.question_id] = row.selected_option;
      });

      state.currentActivityIndex = 0;
      state.currentAttemptId = attempt?.id || null;
      state.currentAttemptExpiresAt = attempt?.expires_at || null;

      studentShowReportsView("studentActivityIntroView");
    } catch (err) {
      console.error("studentOpenActivityIntro failed:", err);
      alert(err?.message || "Could not open this activity.");
    }
  }

  async function studentOpenFormDetails(formId) {
    const user = await studentEnsureUser();
    if (!user) {
      alert("Please sign in again.");
      return;
    }

    try {
      const result = await studentInvokeHistoryManager({
        action: "student_item_details",
        user_id: user.id,
        item_id: formId,
        item_type: "form"
      });

      const form = result.form || {};
      const questions = studentEnsureArray(result.questions);
      const response = result.response || null;
      const answers = studentEnsureArray(result.answers);

      const titleEl = document.getElementById("studentFormDetailsTitle");
      const schoolEl = document.getElementById("studentFormDetailsSchool");
      const descriptionEl = document.getElementById("studentFormDetailsDescription");
      const questionsEl = document.getElementById("studentFormDetailsQuestions");
      const ruleEl = document.getElementById("studentFormDetailsRule");
      const identityEl = document.getElementById("studentFormDetailsIdentity");
      const openEl = document.getElementById("studentFormDetailsOpenAt");
      const closeEl = document.getElementById("studentFormDetailsCloseAt");
      const messageEl = document.getElementById("studentFormDetailsMessage");
      const startBtn = document.getElementById("studentStartFormBtn");

      if (titleEl) titleEl.textContent = form.title || "School Form";
      if (schoolEl) schoolEl.textContent = form.school_name || "School";
      if (descriptionEl) descriptionEl.textContent = form.description || "No description";
      if (questionsEl) questionsEl.textContent = `${questions.length} Questions`;
      if (ruleEl) ruleEl.textContent = form.response_rule === "many" ? "Multiple responses allowed" : "One response only";
      if (identityEl) identityEl.textContent = form.identity_mode === "anonymous" ? "Anonymous response" : "Logged in identity";
      if (openEl) openEl.textContent = studentFmtDateTime(form.open_at, "Now");
      if (closeEl) closeEl.textContent = studentFmtDateTime(form.close_at, "No close date");

      if (messageEl) {
        messageEl.textContent = response?.submitted_at
          ? "You already submitted this form. You can still review the details here."
          : "Read the form carefully before starting. Some forms may include file upload, date, written answers, or multiple response formats.";
      }

      if (startBtn) {
        startBtn.textContent = response?.submitted_at ? "View form" : "Start form";
      }

      const state = window.studentClassActivityState;
      state.currentForm = {
        ...form,
        id: form.id,
        status: form.computed_status || "not-started"
      };
      state.formQuestions = questions;
      state.formAnswers = {};
      state.currentFormIndex = 0;
      state.currentFormResponseId = response?.id || null;

      answers.forEach((row) => {
        const key = row.question_id;
        if (!key) return;

        if (Array.isArray(row.selected_options_json)) {
          state.formAnswers[key] = row.selected_options_json;
        } else if (row.answer_text != null) {
          state.formAnswers[key] = row.answer_text;
        } else if (row.file_url) {
          state.formAnswers[key] = row.file_url;
        } else if (Array.isArray(row.file_urls)) {
          state.formAnswers[key] = row.file_urls;
        }
      });

      studentShowReportsView("studentFormDetailsView");
    } catch (err) {
      console.error("studentOpenFormDetails failed:", err);
      alert(err?.message || "Could not open this form.");
    }
  }

  async function studentOpenAnnouncementDetails(announcementId) {
    const user = await studentEnsureUser();
    if (!user) {
      alert("Please sign in again.");
      return;
    }

    try {
      const details = await studentInvokeHistoryManager({
        action: "student_item_details",
        user_id: user.id,
        item_id: announcementId,
        item_type: "announcement"
      });

      await studentInvokeHistoryManager({
        action: "mark_announcement_read",
        user_id: user.id,
        announcement_id: announcementId
      });

      const item = (window.studentClassActivityState.feedItems || []).find(
        (x) => x.id === announcementId && x.item_type === "announcement"
      ) || null;

      if (item) item.is_read = true;

      localStorage.setItem("student_announcement_view_details", JSON.stringify({
        summary: item,
        details,
        saved_at: new Date().toISOString()
      }));

      window.location.href = `view_details.html?type=announcement&id=${encodeURIComponent(announcementId)}`;
    } catch (err) {
      console.error("studentOpenAnnouncementDetails failed:", err);
      alert(err?.message || "Could not open this announcement.");
    }
  }

  async function studentStartActivity() {
    const activity = window.studentClassActivityState.currentActivity;
    if (!activity) return;

    if (studentIsExpiredByDate(activity.due_at)) {
      alert("This activity has expired.");
      studentBackToReportsHome();
      return;
    }

    const btn = document.getElementById("studentStartActivityBtn");
    const oldText = btn ? btn.textContent : "Start activity";

    if (btn) {
      btn.disabled = true;
      btn.textContent = "Starting...";
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again.");

      const result = await studentInvokeHistoryManager({
        action: "start_activity_attempt",
        user_id: user.id,
        activity_id: activity.id
      });

      const questions = studentEnsureArray(result.questions);
      const attempt = result.attempt || null;
      const answers = studentEnsureArray(result.answers);

      const state = window.studentClassActivityState;
      state.activityQuestions = questions.map((q) => ({
        id: q.id,
        question: q.question_text,
        options: {
          A: q.option_a,
          B: q.option_b,
          C: q.option_c,
          D: q.option_d
        },
        position: q.position
      }));

      state.activityAnswers = {};
      answers.forEach((row) => {
        state.activityAnswers[row.question_id] = row.selected_option;
      });

      state.currentActivityIndex = 0;
      state.currentAttemptId = attempt?.id || null;
      state.currentAttemptExpiresAt = attempt?.expires_at || null;

      if (state.currentAttemptExpiresAt) {
        const endMs = new Date(state.currentAttemptExpiresAt).getTime();
        if (!Number.isNaN(endMs) && Date.now() >= endMs) {
          alert("This activity time has already expired.");
          studentBackToReportsHome();
          return;
        }
      }

      studentStartTimer(state.currentAttemptExpiresAt);
      studentRenderActivityQuestion();
      studentShowReportsView("studentActivityQuestionView");
    } catch (err) {
      console.error("studentStartActivity failed:", err);
      alert(err?.message || "Could not open this activity right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  function studentRenderActivityQuestion() {
    const state = window.studentClassActivityState;
    const questions = state.activityQuestions || [];
    const index = Number(state.currentActivityIndex || 0);
    const q = questions[index];
    if (!q) return;

    const titleEl = document.getElementById("studentActivityQuestionTitle");
    const listEl = document.getElementById("studentActivityOptionList");
    const progressTextEl = document.getElementById("studentActivityProgressText");
    const progressPercentEl = document.getElementById("studentActivityProgressPercent");
    const progressBarEl = document.getElementById("studentActivityProgressBar");
    const nextBtn = document.getElementById("studentActivityNextBtn");

    if (titleEl) titleEl.textContent = q.question || "Question";

    const total = questions.length || 1;
    const percent = Math.round(((index + 1) / total) * 100);

    if (progressTextEl) progressTextEl.textContent = `Question ${index + 1} of ${total}`;
    if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
    if (progressBarEl) progressBarEl.style.width = `${percent}%`;
    if (nextBtn) nextBtn.textContent = index === total - 1 ? "Review" : "Next";

    const selected = state.activityAnswers[q.id] || "";

    if (listEl) {
      const keys = ["A", "B", "C", "D"].filter((key) => studentNormalizeText(q.options[key]));
      listEl.innerHTML = keys.map((key) => {
        const active = selected === key;
        return `
          <div class="choice-option ${active ? "active" : ""}" data-activity-option="${studentReportEscape(key)}">
            <div class="choice-mark">${studentReportEscape(key)}</div>
            <div class="choice-text">${studentReportEscape(q.options[key])}</div>
          </div>
        `;
      }).join("");
    }
  }

  async function studentSaveCurrentActivityAnswer() {
    const state = window.studentClassActivityState;
    const questions = state.activityQuestions || [];
    const q = questions[state.currentActivityIndex];
    if (!q) return;

    const selected = state.activityAnswers[q.id];
    if (!selected) {
      throw new Error("Please select one option before continuing.");
    }

    const user = await studentEnsureUser();
    if (!user) throw new Error("Please sign in again.");

    const result = await studentInvokeHistoryManager({
      action: "save_activity_answer",
      user_id: user.id,
      activity_id: state.currentActivity?.id,
      question_id: q.id,
      selected_option: selected
    });

    state.currentAttemptId = result?.attempt?.id || state.currentAttemptId;
    state.currentAttemptExpiresAt = result?.attempt?.expires_at || state.currentAttemptExpiresAt;

    const returnedAnswers = studentEnsureArray(result?.answers);
    if (returnedAnswers.length) {
      const mapped = {};
      returnedAnswers.forEach((row) => {
        mapped[row.question_id] = row.selected_option;
      });
      state.activityAnswers = {
        ...state.activityAnswers,
        ...mapped
      };
    }
  }

  function studentGoPrevQuestion() {
    const state = window.studentClassActivityState;
    if (state.currentActivityIndex > 0) {
      state.currentActivityIndex -= 1;
      studentRenderActivityQuestion();
    } else {
      studentShowReportsView("studentActivityIntroView");
      studentStartTimer(state.currentAttemptExpiresAt);
    }
  }

  async function studentGoNextQuestion() {
    try {
      await studentSaveCurrentActivityAnswer();

      const state = window.studentClassActivityState;
      const total = (state.activityQuestions || []).length;

      if (state.currentActivityIndex >= total - 1) {
        studentRenderActivityReview();
        studentShowReportsView("studentActivityReviewView");
        studentStartTimer(state.currentAttemptExpiresAt);
        return;
      }

      state.currentActivityIndex += 1;
      studentRenderActivityQuestion();
    } catch (err) {
      alert(err?.message || "Could not save answer right now.");
    }
  }

  function studentRenderActivityReview() {
    const state = window.studentClassActivityState;
    const wrap = document.getElementById("studentActivityReviewList");
    if (!wrap) return;

    wrap.innerHTML = (state.activityQuestions || []).map((q, index) => {
      const selected = state.activityAnswers[q.id];
      const selectedText = selected && q.options[selected] ? `${selected}. ${q.options[selected]}` : "No answer selected";
      return `
        <div class="review-item" data-review-activity-index="${index}">
          <div class="review-q">${studentReportEscape(`Question ${index + 1}: ${q.question}`)}</div>
          <div class="review-a"><strong>Your answer:</strong> ${studentReportEscape(selectedText)}</div>
        </div>
      `;
