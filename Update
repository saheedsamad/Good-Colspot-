  async function studentLoadActivities() {
    if (typeof supabase === "undefined") {
      throw new Error("Supabase is not available.");
    }

    const user = await studentEnsureUser();
    if (!user) {
      throw new Error("Please sign in again to continue.");
    }

    const { data: memberships, error: membershipError } = await supabase
      .from("course_memberships")
      .select("course_id")
      .eq("user_id", user.id);

    if (membershipError) throw membershipError;

    const classIds = (memberships || []).map((x) => x.course_id).filter(Boolean);

    if (!classIds.length) {
      window.studentClassActivityState.activities = [];
      return [];
    }

    const { data: courses, error: coursesError } = await supabase
      .from("courses")
      .select("id, course_code, course_title")
      .in("id", classIds);

    if (coursesError) throw coursesError;

    const courseMap = {};
    (courses || []).forEach((c) => {
      courseMap[c.id] = c;
    });

    const { data: activities, error: activitiesError } = await supabase
      .from("class_activities")
      .select("id, class_id, activity_type, title, due_at, time_limit_minutes, attempts_allowed, is_published, status, created_at")
      .in("class_id", classIds)
      .eq("is_published", true)
      .eq("status", "published")
      .order("created_at", { ascending: false });

    if (activitiesError) throw activitiesError;

    const activityIds = (activities || []).map((a) => a.id).filter(Boolean);

    let attempts = [];
    if (activityIds.length) {
      const { data: attemptsData, error: attemptsError } = await supabase
        .from("class_activity_attempts")
        .select("id, activity_id, started_at, submitted_at, status, expires_at")
        .eq("user_id", user.id)
        .in("activity_id", activityIds);

      if (attemptsError) throw attemptsError;
      attempts = attemptsData || [];
    }

    let questionRows = [];
    if (activityIds.length) {
      const { data: qs, error: qsError } = await supabase
        .from("class_activity_questions")
        .select("id, activity_id")
        .in("activity_id", activityIds);

      if (qsError) throw qsError;
      questionRows = qs || [];
    }

    const countMap = {};
    questionRows.forEach((q) => {
      const key = q.activity_id;
      countMap[key] = (countMap[key] || 0) + 1;
    });

    const attemptMap = {};
    attempts.forEach((a) => {
      if (!attemptMap[a.activity_id]) {
        attemptMap[a.activity_id] = a;
      }
    });

    const items = (activities || []).map((a) => {
      const attempt = attemptMap[a.id] || null;
      const expiredByDueDate = studentIsExpiredByDate(a.due_at);
      const expiredByTimer = !!(attempt?.expires_at && new Date(attempt.expires_at).getTime() < Date.now());

      let status = "not-started";
      if (attempt?.status === "submitted" || attempt?.submitted_at) {
        status = "submitted";
      } else if (attempt) {
        status = "in-progress";
      }

      if ((expiredByDueDate || expiredByTimer) && status !== "submitted") {
        status = "expired";
      }

      const course = courseMap[a.class_id] || {};

      return {
        id: a.id,
        item_type: "activity",
        class_id: a.class_id,
        class_code: course.course_code || "Class",
        class_title: course.course_title || "",
        sub_title: course.course_title ? `${course.course_code} · ${course.course_title}` : (course.course_code || "Class"),
        type: a.activity_type || "revision",
        title: a.title || "Untitled activity",
        description: "",
        questions_count: countMap[a.id] || 0,
        time_limit: a.time_limit_minutes || null,
        due_at: a.due_at || null,
        due_text: studentFmtDateTime(a.due_at),
        sort_at: a.created_at || a.due_at || null,
        status,
        attempt_id: attempt?.id || null,
        expires_at: attempt?.expires_at || null,
        created_at: a.created_at || null
      };
    });

    window.studentClassActivityState.activities = items;
    return items;
  }

  async function studentLoadForms() {
    if (typeof supabase === "undefined") {
      throw new Error("Supabase is not available.");
    }

    const user = await studentEnsureUser();
    if (!user) {
      throw new Error("Please sign in again to continue.");
    }

    const { data: notifications, error: notifError } = await supabase
      .from("form_notifications")
      .select("id, form_id, user_id, title, message, school_name, programme, level, is_read, read_at, created_at")
      .eq("user_id", user.id)
      .order("created_at", { ascending: false });

    if (notifError) throw notifError;

    const formIds = [...new Set((notifications || []).map((x) => x.form_id).filter(Boolean))];

    if (!formIds.length) {
      window.studentClassActivityState.forms = [];
      return [];
    }

    const { data: forms, error: formsError } = await supabase
      .from("forms")
      .select("id, title, description, school_name, status, response_rule, identity_mode, open_at, close_at, published_at, created_at, audience_mode, programme_targets, is_active")
      .in("id", formIds);

    if (formsError) throw formsError;

    const formMap = {};
    (forms || []).forEach((f) => {
      formMap[f.id] = f;
    });

    const { data: questionRows, error: questionError } = await supabase
      .from("form_questions")
      .select("id, form_id")
      .in("form_id", formIds);

    if (questionError) throw questionError;

    const questionCountMap = {};
    (questionRows || []).forEach((q) => {
      questionCountMap[q.form_id] = (questionCountMap[q.form_id] || 0) + 1;
    });

    const { data: responseRows, error: responseError } = await supabase
      .from("form_responses")
      .select("id, form_id, submitted_by, submitted_at, status")
      .eq("submitted_by", user.id)
      .in("form_id", formIds);

    if (responseError) throw responseError;

    const responseMap = {};
    (responseRows || []).forEach((r) => {
      if (!responseMap[r.form_id]) responseMap[r.form_id] = r;
    });

    const items = (notifications || []).map((n) => {
      const form = formMap[n.form_id];
      if (!form) return null;

      const response = responseMap[form.id] || null;
      const closePassed = !!(form.close_at && studentIsExpiredByDate(form.close_at));
      const isClosed = form.status === "closed" || form.status === "archived" || closePassed || form.is_active === false;

      let status = "not-started";
      if (response?.submitted_at) {
        status = "submitted";
      } else if (isClosed) {
        status = "closed";
      }

      return {
        id: form.id,
        item_type: "form",
        notification_id: n.id,
        title: form.title || n.title || "School form",
        sub_title: n.message || form.description || "School form sent to you",
        description: form.description || "",
        school_name: form.school_name || n.school_name || "",
        programme: n.programme || null,
        level: n.level || null,
        questions_count: questionCountMap[form.id] || 0,
        response_rule: form.response_rule || "one",
        response_rule_text: form.response_rule === "many" ? "Multiple responses" : "One response only",
        identity_mode: form.identity_mode || "auto",
        open_at: form.open_at || null,
        close_at: form.close_at || null,
        due_text: studentFmtDateTime(form.close_at, "No close date"),
        close_text: studentFmtDateTime(form.close_at, "No close date"),
        sort_at: n.created_at || form.published_at || form.created_at || null,
        published_at: form.published_at || form.created_at || null,
        created_at: n.created_at || null,
        form_notification_created_at: n.created_at || null,
        status,
        is_read: !!n.is_read,
        read_at: n.read_at || null,
        response_id: response?.id || null,
        response_submitted_at: response?.submitted_at || null,
        audience_mode: form.audience_mode || "all_students",
        programme_targets: form.programme_targets || [],
        raw_form: form
      };
    }).filter(Boolean);

    window.studentClassActivityState.forms = items;
    return items;
  }

