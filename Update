  async function studentMarkFormNotificationRead(notificationId) {
    if (!notificationId || typeof supabase === "undefined") return;
    try {
      await supabase
        .from("form_notifications")
        .update({
          is_read: true,
          read_at: new Date().toISOString()
        })
        .eq("id", notificationId);
    } catch (err) {
      console.error("studentMarkFormNotificationRead failed:", err);
    }
  }

  async function studentStartForm() {
    const form = window.studentClassActivityState.currentForm;
    if (!form || typeof supabase === "undefined") return;

    if (form.status === "closed") {
      alert("This form is closed.");
      return;
    }

    if (form.status === "submitted" && form.response_rule !== "many") {
      alert("You have already submitted this form.");
      return;
    }

    const btn = document.getElementById("studentStartFormBtn");
    const oldText = btn ? btn.textContent : "Start form";
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Opening...";
    }

    try {
      const { data: questions, error } = await supabase
        .from("form_questions")
        .select("*")
        .eq("form_id", form.id)
        .order("sort_order", { ascending: true });

      if (error) throw error;

      window.studentClassActivityState.formQuestions = questions || [];
      window.studentClassActivityState.formAnswers = {};
      window.studentClassActivityState.currentFormIndex = 0;
      window.studentClassActivityState.currentFormResponseId = null;

      studentRenderFormQuestion();
      studentShowReportsView("studentFormQuestionView");
    } catch (err) {
      console.error("studentStartForm failed:", err);
      alert("Could not open this form right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

