      window.location.href = `view_details.html?type=announcement&id=${encodeURIComponent(announcementId)}`;
    } catch (err) {
      console.error("studentOpenAnnouncementDetails failed:", err);
      alert(err?.message || "Could not open this announcement.");
    }
  }

  async function studentOpenFormDetails(formId) {
    const found = (state.forms || []).find((x) => x.id === formId);
    if (!found) return;

    state.currentForm = found;
    state.formQuestions = [];
    state.formAnswers = {};
    state.currentFormIndex = 0;
    state.currentFormResponseId = found.response_id || null;

    const titleEl = document.getElementById("studentFormDetailsTitle");
    const schoolEl = document.getElementById("studentFormDetailsSchool");
    const descEl = document.getElementById("studentFormDetailsDescription");
    const questionsEl = document.getElementById("studentFormDetailsQuestions");
    const ruleEl = document.getElementById("studentFormDetailsRule");
    const identityEl = document.getElementById("studentFormDetailsIdentity");
    const openEl = document.getElementById("studentFormDetailsOpenAt");
    const closeEl = document.getElementById("studentFormDetailsCloseAt");
    const msgEl = document.getElementById("studentFormDetailsMessage");
    const startBtn = document.getElementById("studentStartFormBtn");

    if (titleEl) titleEl.textContent = found.title || "School Form";
    if (schoolEl) schoolEl.textContent = found.school_name || "School";
    if (descEl) descEl.textContent = found.description || "No description";
    if (questionsEl) questionsEl.textContent = `${found.questions_count || 0} Questions`;
    if (ruleEl) ruleEl.textContent = found.response_rule_text || "One response only";
    if (identityEl) identityEl.textContent = found.identity_mode || "auto";
    if (openEl) openEl.textContent = studentFmtDateTime(found.open_at, "Now");
