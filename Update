<script>
  window.studentClassActivityState = window.studentClassActivityState || {
    activities: [],
    forms: [],
    feedItems: [],
    filteredFeedItems: [],
    currentFilter: "all",
    searchTerm: "",
    currentActivity: null,
    currentForm: null,
    activityQuestions: [],
    formQuestions: [],
    activityAnswers: {},
    formAnswers: {},
    currentActivityIndex: 0,
    currentFormIndex: 0,
    currentAttemptId: null,
    currentAttemptExpiresAt: null,
    currentFormResponseId: null,
    timerInterval: null
  };

  function studentReportEscape(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function studentNormalizeText(value) {
    return String(value ?? "").trim().replace(/\s+/g, " ");
  }

  function studentNormalizeUpper(value) {
    return studentNormalizeText(value).toUpperCase();
  }

  function studentNormalizeLevel(value) {
    return studentNormalizeUpper(value).replace(/\bLEVEL\b/g, "").replace(/\s+/g, " ").trim();
  }

  function studentFmtDateTime(value, fallback = "No date") {
    if (!value) return fallback;
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return fallback;
      return d.toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    } catch {
      return fallback;
    }
  }

  function studentFmtDateOnly(value, fallback = "No date") {
    if (!value) return fallback;
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return fallback;
      return d.toLocaleDateString([], {
        year: "numeric",
        month: "short",
        day: "numeric"
      });
    } catch {
      return fallback;
    }
  }

  function studentFormatDuration(minutes) {
    const n = Number(minutes || 0);
    if (!n || n <= 0) return "No limit";
    if (n === 1) return "1 minute";
    return `${n} minutes`;
  }

  function studentFormatCountdown(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
  }

  function studentIsExpiredByDate(value) {
    if (!value) return false;
    const t = new Date(value).getTime();
    if (Number.isNaN(t)) return false;
    return Date.now() > t;
  }

  function studentEnsureArray(value) {
    return Array.isArray(value) ? value : [];
  }

  async function studentEnsureUser() {
    if (typeof ensureCurrentUser === "function") {
      return await ensureCurrentUser();
    }

    if (window.currentUser) return window.currentUser;
    if (typeof supabase === "undefined") return null;

    try {
      const { data, error } = await supabase.auth.getUser();
      if (error || !data?.user) return null;
      window.currentUser = data.user;
      return data.user;
    } catch {
      return null;
    }
  }

  function studentStopTimer() {
    if (window.studentClassActivityState.timerInterval) {
      clearInterval(window.studentClassActivityState.timerInterval);
      window.studentClassActivityState.timerInterval = null;
    }
  }

  function studentSetTimerText(text, warning = false) {
    ["studentActivityTimerValue", "studentActivityReviewTimerValue"].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      el.classList.toggle("warning", !!warning);
    });
  }

  async function studentAutoSubmitFromTimer() {
    studentStopTimer();
    alert("Time is up. Your activity will be submitted now.");
    await studentSubmitActivity(true);
  }

  function studentStartTimer(expiresAt) {
    studentStopTimer();

    if (!expiresAt) {
      studentSetTimerText("--:--", false);
      return;
    }

    window.studentClassActivityState.currentAttemptExpiresAt = expiresAt;

    const tick = () => {
      const endMs = new Date(expiresAt).getTime();
      const diff = endMs - Date.now();

      if (Number.isNaN(endMs)) {
        studentSetTimerText("--:--", false);
        studentStopTimer();
        return;
      }

      if (diff <= 0) {
        studentSetTimerText("00:00", true);
        studentAutoSubmitFromTimer();
        return;
      }

      const warning = diff <= 5 * 60 * 1000;
      studentSetTimerText(studentFormatCountdown(diff), warning);
    };

    tick();
    window.studentClassActivityState.timerInterval = setInterval(tick, 1000);
  }

  function studentHideAllViews() {
    [
      "studentReportsHomeView",
      "studentActivityIntroView",
      "studentActivityQuestionView",
      "studentActivityReviewView",
      "studentActivitySubmittedView",
      "studentFormDetailsView",
      "studentFormQuestionView",
      "studentFormReviewView",
      "studentFormSubmittedView"
    ].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.classList.add("hidden");
    });
  }

  function studentShowReportsView(viewId) {
    studentHideAllViews();
    const el = document.getElementById(viewId);
    if (el) el.classList.remove("hidden");

    if (
      viewId === "studentReportsHomeView" ||
      viewId === "studentActivityIntroView" ||
      viewId === "studentActivitySubmittedView" ||
      viewId === "studentFormDetailsView" ||
      viewId === "studentFormSubmittedView"
    ) {
      if (viewId !== "studentActivitySubmittedView") {
        studentStopTimer();
      }
    }
  }

  function studentPendingItemCount(items) {
    return studentEnsureArray(items).filter((item) => {
      return item.status === "not-started" || item.status === "in-progress";
    }).length;
  }

  function studentUpdateExternalNavBadge(count) {
    const possibleIds = [
      "studentReportsNavBadge",
      "reportsNavBadge",
      "navReportsBadge",
      "studentClassBadge",
      "studentRevisionBadge"
    ];

    possibleIds.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (count > 0) {
        el.textContent = count > 99 ? "99+" : String(count);
        el.style.display = "inline-flex";
      } else {
        el.textContent = "";
        el.style.display = "none";
      }
    });
  }

  function studentRenderFeedStats() {
    const state = window.studentClassActivityState;
    const total = state.feedItems.length;
    const forms = state.forms.length;
    const activities = state.activities.length;
    const pending = studentPendingItemCount(state.feedItems);

    const setText = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    };

    setText("studentReportsTotalCount", total);
    setText("studentReportsFormCount", forms);
    setText("studentReportsActivityCount", activities);
    setText("studentReportsAllCount", total);
    setText("studentReportsFormsCount", forms);
    setText("studentReportsActivitiesCount", activities);
    setText("studentReportsPendingCount", pending);

    const pendingBadge = document.getElementById("studentReportsPendingBadge");
    if (pendingBadge) {
      pendingBadge.textContent = pending === 1 ? "1 Pending" : `${pending} Pending`;
    }

    studentUpdateExternalNavBadge(pending);
  }

  function studentComputeFeedItems() {
    const state = window.studentClassActivityState;
    const merged = [...state.forms, ...state.activities];

    merged.sort((a, b) => {
      const aTime = new Date(a.sort_at || a.created_at || a.published_at || a.due_at || 0).getTime() || 0;
      const bTime = new Date(b.sort_at || b.created_at || b.published_at || b.due_at || 0).getTime() || 0;
      return bTime - aTime;
    });

    state.feedItems = merged;
  }

  function studentFilterFeedItems() {
    const state = window.studentClassActivityState;
    const filter = state.currentFilter || "all";
    const q = studentNormalizeText(state.searchTerm).toLowerCase();

    let list = [...state.feedItems];

    if (filter === "forms") {
      list = list.filter((item) => item.item_type === "form");
    } else if (filter === "activities") {
      list = list.filter((item) => item.item_type === "activity");
    } else if (filter === "pending") {
      list = list.filter((item) => item.status === "not-started" || item.status === "in-progress");
    }

    if (q) {
      list = list.filter((item) => {
        const hay = [
          item.title,
          item.sub_title,
          item.class_code,
          item.class_title,
          item.school_name,
          item.description
        ].join(" ").toLowerCase();
        return hay.includes(q);
      });
    }

    state.filteredFeedItems = list;
  }

  function studentFeedKindClass(item) {
    if (item.status === "closed" || item.status === "expired") return "closed";
    if (item.status === "submitted") return "submitted";
    if (item.item_type === "form") return "form";
    if (item.type === "assignment") return "assignment";
    if (item.type === "test") return "test";
    return "revision";
  }

  function studentFeedKindLabel(item) {
    if (item.status === "closed") return "Closed";
    if (item.status === "expired") return "Expired";
    if (item.status === "submitted") return item.item_type === "form" ? "Submitted" : "Submitted";
    if (item.item_type === "form") return "Form";
    if (item.type === "assignment") return "Assignment";
    if (item.type === "test") return "Test";
    return "Revision";
  }

  function studentFeedStatusClass(item) {
    if (item.status === "submitted") return "submitted";
    if (item.status === "in-progress") return "in-progress";
    if (item.status === "closed") return "closed";
    if (item.status === "expired") return "expired";
    return "not-started";
  }

  function studentFeedStatusLabel(item) {
    if (item.status === "submitted") return "Submitted";
    if (item.status === "in-progress") return "In progress";
    if (item.status === "closed") return "Closed";
    if (item.status === "expired") return "Expired";
    return "Not started";
  }

  function studentFeedButtonLabel(item) {
    if (item.status === "submitted") return "Submitted";
    if (item.status === "in-progress") return "Continue";
    if (item.status === "closed" || item.status === "expired") return item.status === "closed" ? "Closed" : "Expired";
    return "Open";
  }

  function studentRenderFeedList() {
    studentFilterFeedItems();
    studentRenderFeedStats();

    const wrap = document.getElementById("studentReportsFeedList");
    if (!wrap) return;

    const items = window.studentClassActivityState.filteredFeedItems || [];

    if (!items.length) {
      wrap.innerHTML = `<div class="feed-empty">No form or class activity matched your current filter.</div>`;
      return;
    }

    wrap.innerHTML = items.map((item) => {
      const kindClass = studentFeedKindClass(item);
      const kindLabel = studentFeedKindLabel(item);
      const statusClass = studentFeedStatusClass(item);
      const statusLabel = studentFeedStatusLabel(item);
      const btnLabel = studentFeedButtonLabel(item);
      const blocked = item.status === "submitted" || item.status === "closed" || item.status === "expired";

      return `
        <article class="feed-card" data-item-id="${studentReportEscape(item.id)}" data-item-type="${studentReportEscape(item.item_type)}">
          <div class="feed-card-top">
            <div class="feed-card-head">
              <div class="feed-source">${studentReportEscape(item.item_type === "form" ? "School form" : (item.class_code || "Class activity"))}</div>
              <div class="feed-title">${studentReportEscape(item.title || "Untitled")}</div>
              <div class="feed-subtitle">${studentReportEscape(item.sub_title || "")}</div>
            </div>
            <div class="feed-kind-badge ${studentReportEscape(kindClass)}">${studentReportEscape(kindLabel)}</div>
          </div>

          <div class="feed-meta">
            ${item.questions_count != null ? `<div class="feed-pill">${studentReportEscape(item.questions_count)} Questions</div>` : ""}
            ${item.item_type === "activity" ? `<div class="feed-pill">${studentReportEscape(item.time_limit ? studentFormatDuration(item.time_limit) : "No limit")}</div>` : ""}
            <div class="feed-pill">${studentReportEscape(item.due_text || item.close_text || "No due date")}</div>
            ${item.item_type === "form" && item.response_rule_text ? `<div class="feed-pill">${studentReportEscape(item.response_rule_text)}</div>` : ""}
          </div>

          <div class="feed-status-row">
            <div class="feed-status ${studentReportEscape(statusClass)}">${studentReportEscape(statusLabel)}</div>
            <button class="feed-open-btn ${blocked ? "disabled" : ""}" type="button" data-item-open="${studentReportEscape(item.id)}" data-item-type="${studentReportEscape(item.item_type)}">
              ${studentReportEscape(btnLabel)}
            </button>
          </div>
        </article>
      `;
    }).join("");
  }

  async function studentLoadActivities() {
    if (typeof supabase === "undefined") {
      throw new Error("Supabase is not available.");
    }

    const user = await studentEnsureUser();
    if (!user) {
      throw new Error("Please sign in again to continue.");
    }

    const { data: memberships, error: membershipError } = await supabase
      .from("course_memberships")
      .select("course_id")
      .eq("user_id", user.id);

    if (membershipError) throw membershipError;

    const classIds = (memberships || []).map((x) => x.course_id).filter(Boolean);

    if (!classIds.length) {
      window.studentClassActivityState.activities = [];
      return [];
    }

    const { data: courses, error: coursesError } = await supabase
      .from("courses")
      .select("id, course_code, course_title")
      .in("id", classIds);

    if (coursesError) throw coursesError;

    const courseMap = {};
    (courses || []).forEach((c) => {
      courseMap[c.id] = c;
    });

    const { data: activities, error: activitiesError } = await supabase
      .from("class_activities")
      .select("id, class_id, activity_type, title, due_at, time_limit_minutes, attempts_allowed, is_published, status, created_at")
      .in("class_id", classIds)
      .eq("is_published", true)
      .eq("status", "published")
      .order("created_at", { ascending: false });

    if (activitiesError) throw activitiesError;

    const activityIds = (activities || []).map((a) => a.id).filter(Boolean);

    let attempts = [];
    if (activityIds.length) {
      const { data: attemptsData, error: attemptsError } = await supabase
        .from("class_activity_attempts")
        .select("id, activity_id, started_at, submitted_at, status, expires_at")
        .eq("user_id", user.id)
        .in("activity_id", activityIds);

      if (attemptsError) throw attemptsError;
      attempts = attemptsData || [];
    }

    let questionRows = [];
    if (activityIds.length) {
      const { data: qs, error: qsError } = await supabase
        .from("class_activity_questions")
        .select("id, activity_id")
        .in("activity_id", activityIds);

      if (qsError) throw qsError;
      questionRows = qs || [];
    }

    const countMap = {};
    questionRows.forEach((q) => {
      const key = q.activity_id;
      countMap[key] = (countMap[key] || 0) + 1;
    });

    const attemptMap = {};
    attempts.forEach((a) => {
      attemptMap[a.activity_id] = a;
    });

    const items = (activities || []).map((a) => {
      const attempt = attemptMap[a.id] || null;
      const expiredByDueDate = studentIsExpiredByDate(a.due_at);
      const expiredByTimer = !!(attempt?.expires_at && new Date(attempt.expires_at).getTime() < Date.now());

      let status = "not-started";
      if (attempt?.status === "submitted" || attempt?.submitted_at) {
        status = "submitted";
      } else if (attempt) {
        status = "in-progress";
      }

      if ((expiredByDueDate || expiredByTimer) && status !== "submitted") {
        status = "expired";
      }

      const course = courseMap[a.class_id] || {};

      return {
        id: a.id,
        item_type: "activity",
        class_id: a.class_id,
        class_code: course.course_code || "Class",
        class_title: course.course_title || "",
        sub_title: course.course_title ? `${course.course_code} · ${course.course_title}` : (course.course_code || "Class"),
        type: a.activity_type || "revision",
        title: a.title || "Untitled activity",
        description: "",
        questions_count: countMap[a.id] || 0,
        time_limit: a.time_limit_minutes || null,
        due_at: a.due_at || null,
        due_text: studentFmtDateTime(a.due_at),
        sort_at: a.created_at || a.due_at || null,
        status,
        attempt_id: attempt?.id || null,
        expires_at: attempt?.expires_at || null,
        created_at: a.created_at || null
      };
    });

    window.studentClassActivityState.activities = items;
    return items;
  }

  async function studentLoadForms() {
    if (typeof supabase === "undefined") {
      throw new Error("Supabase is not available.");
    }

    const user = await studentEnsureUser();
    if (!user) {
      throw new Error("Please sign in again to continue.");
    }

    const { data: notifications, error: notifError } = await supabase
      .from("form_notifications")
      .select("id, form_id, user_id, title, message, school_name, programme, level, is_read, read_at, created_at")
      .eq("user_id", user.id)
      .order("created_at", { ascending: false });

    if (notifError) throw notifError;

    const formIds = [...new Set((notifications || []).map((x) => x.form_id).filter(Boolean))];

    if (!formIds.length) {
      window.studentClassActivityState.forms = [];
      return [];
    }

    const { data: forms, error: formsError } = await supabase
      .from("forms")
      .select("id, title, description, school_name, status, response_rule, identity_mode, open_at, close_at, published_at, created_at, audience_mode, programme_targets, is_active")
      .in("id", formIds);

    if (formsError) throw formsError;

    const formMap = {};
    (forms || []).forEach((f) => {
      formMap[f.id] = f;
    });

    const { data: questionRows, error: questionError } = await supabase
      .from("form_questions")
      .select("id, form_id")
      .in("form_id", formIds);

    if (questionError) throw questionError;

    const questionCountMap = {};
    (questionRows || []).forEach((q) => {
      questionCountMap[q.form_id] = (questionCountMap[q.form_id] || 0) + 1;
    });

    const { data: responseRows, error: responseError } = await supabase
      .from("form_responses")
      .select("id, form_id, submitted_by, submitted_at, status")
      .eq("submitted_by", user.id)
      .in("form_id", formIds);

    if (responseError) throw responseError;

    const responseMap = {};
    (responseRows || []).forEach((r) => {
      if (!responseMap[r.form_id]) responseMap[r.form_id] = r;
    });

    const items = (notifications || []).map((n) => {
      const form = formMap[n.form_id];
      if (!form) return null;

      const response = responseMap[form.id] || null;
      const closePassed = !!(form.close_at && studentIsExpiredByDate(form.close_at));
      const isClosed = form.status === "closed" || form.status === "archived" || closePassed || form.is_active === false;

      let status = "not-started";
      if (response?.submitted_at) {
        status = "submitted";
      } else if (isClosed) {
        status = "closed";
      }

      return {
        id: form.id,
        item_type: "form",
        notification_id: n.id,
        title: form.title || n.title || "School form",
        sub_title: n.message || form.description || "School form sent to you",
        description: form.description || "",
        school_name: form.school_name || n.school_name || "",
        programme: n.programme || null,
        level: n.level || null,
        questions_count: questionCountMap[form.id] || 0,
        response_rule: form.response_rule || "one",
        response_rule_text: form.response_rule === "many" ? "Multiple responses" : "One response only",
        identity_mode: form.identity_mode || "auto",
        open_at: form.open_at || null,
        close_at: form.close_at || null,
        due_text: studentFmtDateTime(form.close_at, "No close date"),
        close_text: studentFmtDateTime(form.close_at, "No close date"),
        sort_at: n.created_at || form.published_at || form.created_at || null,
        published_at: form.published_at || form.created_at || null,
        created_at: n.created_at || null,
        form_notification_created_at: n.created_at || null,
        status,
        is_read: !!n.is_read,
        read_at: n.read_at || null,
        response_id: response?.id || null,
        response_submitted_at: response?.submitted_at || null,
        audience_mode: form.audience_mode || "all_students",
        programme_targets: form.programme_targets || [],
        raw_form: form
      };
    }).filter(Boolean);

    window.studentClassActivityState.forms = items;
    return items;
  }

