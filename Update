            return !allowedTypes.some((type) => {
              const t = type.toLowerCase().trim();
              if (!t) return false;
              if (t.startsWith(".")) return name.endsWith(t);
              if (t.includes("/")) return f.type.toLowerCase() === t;
              return name.endsWith(`.${t}`);
            });
          });

          if (invalid) {
            alert(`"${invalid.name}" is not an allowed file type.`);
            fileInput.value = "";
            return;
          }
        }

        studentSetFormAnswer(q.id, {
          files: files.map((f) => ({
            name: f.name,
            size: f.size,
            type: f.type || "",
            lastModified: f.lastModified || null
          }))
        });

        studentSetFormFieldNote(files.length ? `${files.length} file selected.` : "Choose file to attach.");
      });
    }
  }

  (function bindStudentReportsScreen() {
    const originalShowScreen = window.showScreen;

    if (!window.__studentReportsShowScreenWrapped && typeof originalShowScreen === "function") {
      window.showScreen = function(name) {
        originalShowScreen(name);
        if (name === "reports") {
          studentBackToReportsHome();
        }
      };
      window.__studentReportsShowScreenWrapped = true;
    }

    document.addEventListener("DOMContentLoaded", () => {
      studentBindReportsEvents();
      studentLoadReportsFeed();
    });

    window.studentLoadReportsFeed = studentLoadReportsFeed;
    window.studentBackToReportsHome = studentBackToReportsHome;
    window.studentOpenActivityIntro = studentOpenActivityIntro;
    window.studentOpenFormDetails = studentOpenFormDetails;
  })();
</script>
