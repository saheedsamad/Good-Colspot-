  function studentBindReportsEvents() {
    const tabsWrap = document.getElementById("studentReportsTabs");
    if (tabsWrap && !tabsWrap.dataset.bound) {
      tabsWrap.dataset.bound = "1";
      tabsWrap.addEventListener("click", (e) => {
        const btn = e.target.closest(".reports-tab");
        if (!btn) return;

        tabsWrap.querySelectorAll(".reports-tab").forEach((el) => el.classList.remove("active"));
        btn.classList.add("active");

        window.studentClassActivityState.currentFilter = btn.getAttribute("data-feed-filter") || "all";
        studentRenderFeedList();
      });
    }

    const searchInput = document.getElementById("studentReportsSearchInput");
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.dataset.bound = "1";
      searchInput.addEventListener("input", () => {
        window.studentClassActivityState.searchTerm = searchInput.value || "";
        studentRenderFeedList();
      });
    }

    const feedWrap = document.getElementById("studentReportsFeedList");
    if (feedWrap && !feedWrap.dataset.bound) {
      feedWrap.dataset.bound = "1";
      feedWrap.addEventListener("click", (e) => {
        const openBtn = e.target.closest("[data-item-open]");
        const card = e.target.closest(".feed-card");

        if (openBtn) {
          const itemId = openBtn.getAttribute("data-item-open");
          const itemType = openBtn.getAttribute("data-item-type");
          const item = (window.studentClassActivityState.feedItems || []).find((x) => x.id === itemId && x.item_type === itemType);

          if (!item) return;

          if (item.item_type === "announcement") {
            studentHandleFeedOpen(itemId, itemType);
            return;
          }

          if (!(item.status === "submitted" || item.status === "closed" || item.status === "expired")) {
            studentHandleFeedOpen(itemId, itemType);
          }
          return;
        }

        if (card) {
          const itemId = card.getAttribute("data-item-id");
          const itemType = card.getAttribute("data-item-type");
          const item = (window.studentClassActivityState.feedItems || []).find((x) => x.id === itemId && x.item_type === itemType);

          if (!item) return;

          if (item.item_type === "announcement") {
            studentHandleFeedOpen(itemId, itemType);
            return;
          }

          if (!(item.status === "submitted" || item.status === "closed" || item.status === "expired")) {
            studentHandleFeedOpen(itemId, itemType);
          }
        }
      });
    }

    document.querySelectorAll("#studentActivityIntroView .panel-back-btn").forEach((btn) => {
      if (!btn.dataset.bound) {
        btn.dataset.bound = "1";
        btn.addEventListener("click", studentBackToReportsHome);
      }
    });

    const formDetailsBack = document.querySelector("#studentFormDetailsView .panel-back-btn");
    if (formDetailsBack && !formDetailsBack.dataset.bound) {
      formDetailsBack.dataset.bound = "1";
      formDetailsBack.addEventListener("click", studentBackToReportsHome);
    }

    const activityQuestionBack = document.querySelector("#studentActivityQuestionView .panel-back-btn");
    if (activityQuestionBack && !activityQuestionBack.dataset.bound) {
      activityQuestionBack.dataset.bound = "1";
      activityQuestionBack.addEventListener("click", () => {
        if (window.studentClassActivityState.currentActivityIndex > 0) {
          window.studentClassActivityState.currentActivityIndex -= 1;
          studentRenderActivityQuestion();
        } else {
          studentShowReportsView("studentActivityIntroView");
          studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
        }
      });
    }

    const activityReviewBack = document.querySelector("#studentActivityReviewView .panel-back-btn");
    if (activityReviewBack && !activityReviewBack.dataset.bound) {
      activityReviewBack.dataset.bound = "1";
      activityReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentActivityQuestionView");
        studentStartTimer(window.studentClassActivityState.currentAttemptExpiresAt);
      });
    }

    const formQuestionBack = document.querySelector("#studentFormQuestionView .panel-back-btn");
    if (formQuestionBack && !formQuestionBack.dataset.bound) {
      formQuestionBack.dataset.bound = "1";
      formQuestionBack.addEventListener("click", () => {
        if (window.studentClassActivityState.currentFormIndex > 0) {
          window.studentClassActivityState.currentFormIndex -= 1;
          studentRenderFormQuestion();
        } else {
          studentShowReportsView("studentFormDetailsView");
        }
      });
    }

    const formReviewBack = document.querySelector("#studentFormReviewView .panel-back-btn");
    if (formReviewBack && !formReviewBack.dataset.bound) {
      formReviewBack.dataset.bound = "1";
      formReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentFormQuestionView");
      });
    }

    const startActivityBtn = document.getElementById("studentStartActivityBtn");
    if (startActivityBtn && !startActivityBtn.dataset.bound) {
      startActivityBtn.dataset.bound = "1";
      startActivityBtn.addEventListener("click", studentStartActivity);
    }

    const activityPrevBtn = document.getElementById("studentActivityPrevBtn");
    if (activityPrevBtn && !activityPrevBtn.dataset.bound) {
      activityPrevBtn.dataset.bound = "1";
      activityPrevBtn.addEventListener("click", studentGoPrevQuestion);
    }

    const activityNextBtn = document.getElementById("studentActivityNextBtn");
    if (activityNextBtn && !activityNextBtn.dataset.bound) {
      activityNextBtn.dataset.bound = "1";
      activityNextBtn.addEventListener("click", studentGoNextQuestion);
    }

    const activityOptionList = document.getElementById("studentActivityOptionList");
    if (activityOptionList && !activityOptionList.dataset.bound) {
      activityOptionList.dataset.bound = "1";
      activityOptionList.addEventListener("click", (e) => {
        const option = e.target.closest("[data-activity-option]");
        if (!option) return;

        const state = window.studentClassActivityState;
        const q = (state.activityQuestions || [])[state.currentActivityIndex];
        if (!q) return;

        state.activityAnswers[q.id] = option.getAttribute("data-activity-option");
        studentRenderActivityQuestion();
      });
    }

    const submitActivityBtn = document.getElementById("studentSubmitActivityBtn");
    if (submitActivityBtn && !submitActivityBtn.dataset.bound) {
      submitActivityBtn.dataset.bound = "1";
      submitActivityBtn.addEventListener("click", () => studentSubmitActivity(false));
    }

    const activitySubmittedBack = document.querySelector("#studentActivitySubmittedView .primary-btn");
    if (activitySubmittedBack && !activitySubmittedBack.dataset.bound) {
      activitySubmittedBack.dataset.bound = "1";
      activitySubmittedBack.addEventListener("click", studentBackToReportsHome);
    }

    const startFormBtn = document.getElementById("studentStartFormBtn");
    if (startFormBtn && !startFormBtn.dataset.bound) {
      startFormBtn.dataset.bound = "1";
      startFormBtn.addEventListener("click", studentStartForm);
    }

    const formPrevBtn = document.getElementById("studentFormPrevBtn");
    if (formPrevBtn && !formPrevBtn.dataset.bound) {
      formPrevBtn.dataset.bound = "1";
      formPrevBtn.addEventListener("click", studentGoPrevFormQuestion);
    }

    const formNextBtn = document.getElementById("studentFormNextBtn");
    if (formNextBtn && !formNextBtn.dataset.bound) {
      formNextBtn.dataset.bound = "1";
      formNextBtn.addEventListener("click", studentGoNextFormQuestion);
    }

    const formMulti = document.getElementById("studentFormMultipleChoiceBlock");
    if (formMulti && !formMulti.dataset.bound) {
      formMulti.dataset.bound = "1";
      formMulti.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-single-option]");
        if (!option) return;
        studentSetCurrentFormValue(option.getAttribute("data-form-single-option"));
        studentRenderFormQuestion();
      });
    }

    const formYesNo = document.getElementById("studentFormYesNoBlock");
    if (formYesNo && !formYesNo.dataset.bound) {
      formYesNo.dataset.bound = "1";
      formYesNo.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-single-option]");
        if (!option) return;
        studentSetCurrentFormValue(option.getAttribute("data-form-single-option"));
        studentRenderFormQuestion();
      });
    }

    const formChecks = document.getElementById("studentFormCheckboxBlock");
    if (formChecks && !formChecks.dataset.bound) {
      formChecks.dataset.bound = "1";
      formChecks.addEventListener("click", (e) => {
        const option = e.target.closest("[data-form-check-option]");
        if (!option) return;

        const q = studentGetCurrentFormQuestion();
        if (!q) return;

        const value = option.getAttribute("data-form-check-option");
        const current = Array.isArray(window.studentClassActivityState.formAnswers[q.id])
          ? [...window.studentClassActivityState.formAnswers[q.id]]
          : [];

        const idx = current.indexOf(value);
        if (idx >= 0) current.splice(idx, 1);
        else current.push(value);

        studentSetCurrentFormValue(current);
        studentRenderFormQuestion();
      });
    }

    const shortInput = document.getElementById("studentFormShortAnswerInput");
    if (shortInput && !shortInput.dataset.bound) {
      shortInput.dataset.bound = "1";
      shortInput.addEventListener("input", () => {
        studentSetCurrentFormValue(shortInput.value || "");
      });
    }

    const paragraphInput = document.getElementById("studentFormParagraphInput");
    if (paragraphInput && !paragraphInput.dataset.bound) {
      paragraphInput.dataset.bound = "1";
      paragraphInput.addEventListener("input", () => {
        studentSetCurrentFormValue(paragraphInput.value || "");
      });
    }

    const dropdownInput = document.getElementById("studentFormDropdownInput");
    if (dropdownInput && !dropdownInput.dataset.bound) {
      dropdownInput.dataset.bound = "1";
      dropdownInput.addEventListener("change", () => {
        studentSetCurrentFormValue(dropdownInput.value || "");
      });
    }

    const dateInput = document.getElementById("studentFormDateInput");
    if (dateInput && !dateInput.dataset.bound) {
      dateInput.dataset.bound = "1";
      dateInput.addEventListener("change", () => {
        studentSetCurrentFormValue(dateInput.value || "");
      });
    }

    const chooseFileBtn = document.getElementById("studentFormChooseFileBtn");
    const fileInput = document.getElementById("studentFormFileInput");

    if (chooseFileBtn && fileInput && !chooseFileBtn.dataset.bound) {
      chooseFileBtn.dataset.bound = "1";
      chooseFileBtn.addEventListener("click", () => fileInput.click());
    }

    if (fileInput && !fileInput.dataset.bound) {
      fileInput.dataset.bound = "1";
      fileInput.addEventListener("change", studentHandleFormFileSelection);
    }

    const formReviewList = document.getElementById("studentFormReviewList");
    if (formReviewList && !formReviewList.dataset.bound) {
      formReviewList.dataset.bound = "1";
      formReviewList.addEventListener("click", (e) => {
        const item = e.target.closest("[data-review-form-index]");
        if (!item) return;
        const idx = Number(item.getAttribute("data-review-form-index"));
        if (!Number.isFinite(idx)) return;
        window.studentClassActivityState.currentFormIndex = idx;
        studentRenderFormQuestion();
        studentShowReportsView("studentFormQuestionView");
      });
    }

    const submitFormBtn = document.getElementById("studentSubmitFormBtn");
    if (submitFormBtn && !submitFormBtn.dataset.bound) {
      submitFormBtn.dataset.bound = "1";
      submitFormBtn.addEventListener("click", studentSubmitForm);
    }

    const formSubmittedBack = document.querySelector("#studentFormSubmittedView .primary-btn");
    if (formSubmittedBack && !formSubmittedBack.dataset.bound) {
      formSubmittedBack.dataset.bound = "1";
      formSubmittedBack.addEventListener("click", studentBackToReportsHome);
    }
  }

  function studentInitReportsScreen() {
    studentBindReportsEvents();
    studentShowReportsView("studentReportsHomeView");
    studentLoadReportsFeed();
  }

  window.studentInitReportsScreen = studentInitReportsScreen;
  window.studentLoadReportsFeed = studentLoadReportsFeed;
  window.studentBackToReportsHome = studentBackToReportsHome;
  window.studentOpenActivityIntro = studentOpenActivityIntro;
  window.studentOpenFormDetails = studentOpenFormDetails;
  window.studentOpenAnnouncementDetails = studentOpenAnnouncementDetails;
</script>
