  async function studentEnsureAttempt() {
    const activity = state.currentActivity;
    if (!activity) return null;

    const user = await studentEnsureUser();
    if (!user) return null;

    if (state.currentAttemptId) {
      return state.currentAttemptId;
    }

    const data = await studentInvokeHistoryManager({
      action: "start_activity_attempt",
      user_id: user.id,
      activity_id: activity.id
    });

    state.currentAttemptId = data?.attempt?.id || null;
    state.currentAttemptExpiresAt = data?.attempt?.expires_at || null;
    state.activityQuestions = studentEnsureArray(data?.questions).map((q) => ({
      ...q,
      question: q.question_text || q.question || "",
      options: studentQuestionOptions(q)
    }));

    const answers = {};
    studentEnsureArray(data?.answers).forEach((row) => {
      if (row?.question_id) answers[row.question_id] = row.selected_option || "";
    });
    state.activityAnswers = answers;

    return state.currentAttemptId;
  }

  async function studentLoadAnswersForAttempt() {
    return state.activityAnswers || {};
  }

  async function studentStartActivity() {
    const activity = state.currentActivity;
    if (!activity) return;

    if (studentIsExpiredByDate(activity.due_at)) {
      alert("This activity has expired.");
      studentBackToReportsHome();
      return;
    }

    const btn = document.getElementById("studentStartActivityBtn");
    const oldText = btn ? btn.textContent : "Start activity";
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Starting...";
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again to continue.");

      const data = await studentInvokeHistoryManager({
        action: "start_activity_attempt",
        user_id: user.id,
        activity_id: activity.id
      });

      state.activityQuestions = studentEnsureArray(data?.questions).map((q) => ({
        ...q,
        question: q.question_text || q.question || "",
        options: studentQuestionOptions(q)
      }));
      state.currentAttemptId = data?.attempt?.id || null;
      state.currentAttemptExpiresAt = data?.attempt?.expires_at || null;

      const answers = {};
      studentEnsureArray(data?.answers).forEach((row) => {
        if (row?.question_id) answers[row.question_id] = row.selected_option || "";
      });
      state.activityAnswers = answers;
      state.currentActivityIndex = 0;

      studentStartTimer(state.currentAttemptExpiresAt);
      studentRenderActivityQuestion();
      studentShowReportsView("studentActivityQuestionView");
    } catch (err) {
      console.error("studentStartActivity failed:", err);
      alert(err?.message || "Could not start this activity.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  function studentRenderActivityQuestion() {
    const question = state.activityQuestions[state.currentActivityIndex];
    if (!question) return;

    const total = state.activityQuestions.length;
    const current = state.currentActivityIndex + 1;
    const selected = state.activityAnswers[question.id] || "";

    const progressText = document.getElementById("studentActivityProgressText");
    const progressPercent = document.getElementById("studentActivityProgressPercent");
    const progressBar = document.getElementById("studentActivityProgressBar");
    const titleEl = document.getElementById("studentActivityQuestionTitle");
    const listEl = document.getElementById("studentActivityOptionList");
    const prevBtn = document.getElementById("studentActivityPrevBtn");
    const nextBtn = document.getElementById("studentActivityNextBtn");

    if (progressText) progressText.textContent = `Question ${current} of ${total}`;
    const percent = total ? Math.round((current / total) * 100) : 0;
    if (progressPercent) progressPercent.textContent = `${percent}%`;
    if (progressBar) progressBar.style.width = `${percent}%`;
    if (titleEl) titleEl.textContent = question.question || "Question";

    if (listEl) {
      const options = question.options || {};
      listEl.innerHTML = Object.entries(options)
        .filter(([, text]) => String(text || "").trim())
        .map(([key, text]) => `
          <button type="button" class="choice-option ${selected === key ? "active" : ""}" data-activity-choice="${studentReportEscape(key)}">
            <div class="choice-mark">${studentReportEscape(key)}</div>
            <div class="choice-text">${studentReportEscape(text)}</div>
          </button>
        `)
        .join("");
    }

    if (prevBtn) prevBtn.textContent = current === 1 ? "Back" : "Previous";
    if (nextBtn) nextBtn.textContent = current === total ? "Review" : "Next";
  }

  async function studentSaveCurrentActivityAnswer() {
    const question = state.activityQuestions[state.currentActivityIndex];
    if (!question) return;

    const selected = state.activityAnswers[question.id];
    if (!selected) throw new Error("Please select an answer before moving on.");

    const user = await studentEnsureUser();
    if (!user) throw new Error("Please sign in again to continue.");

    await studentEnsureAttempt();

    await studentInvokeHistoryManager({
      action: "save_activity_answer",
      user_id: user.id,
      activity_id: state.currentActivity.id,
      question_id: question.id,
      selected_option: selected
    });
  }

  async function studentGoNextQuestion() {
    try {
      await studentSaveCurrentActivityAnswer();

      const total = state.activityQuestions.length;
      if (state.currentActivityIndex >= total - 1) {
        studentRenderActivityReview();
        studentShowReportsView("studentActivityReviewView");
        studentStartTimer(state.currentAttemptExpiresAt);
        return;
      }

      state.currentActivityIndex += 1;
      studentRenderActivityQuestion();
    } catch (err) {
      alert(err?.message || "Could not save answer right now.");
    }
  }

  function studentGoPrevQuestion() {
    if (state.currentActivityIndex <= 0) {
      studentShowReportsView("studentActivityIntroView");
      return;
    }
    state.currentActivityIndex -= 1;
    studentRenderActivityQuestion();
  }

  function studentRenderActivityReview() {
    const wrap = document.getElementById("studentActivityReviewList");
    if (!wrap) return;

    wrap.innerHTML = state.activityQuestions.map((q, index) => {
      const options = q.options || {};
      const selected = state.activityAnswers[q.id];
      const selectedText = selected && options[selected] ? `${selected}. ${options[selected]}` : "No answer selected";
      return `
        <div class="review-item" data-review-activity-index="${index}">
          <div class="review-q">${studentReportEscape(`Question ${index + 1}: ${q.question}`)}</div>
          <div class="review-a"><strong>Your answer:</strong> ${studentReportEscape(selectedText)}</div>
        </div>
      `;
    }).join("");
  }

  async function studentSubmitActivity(fromTimer = false) {
    const btn = document.getElementById("studentSubmitActivityBtn");
    const oldText = btn ? btn.textContent : "Submit activity";

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again to continue.");

      if (!fromTimer) {
        for (const q of state.activityQuestions) {
          if (!state.activityAnswers[q.id]) {
            throw new Error("Please answer all questions before submitting.");
          }
        }
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Submitting...";
      }

      const answers = state.activityQuestions
        .map((q) => ({
          question_id: q.id,
          selected_option: state.activityAnswers[q.id] || ""
        }))
        .filter((row) => row.question_id && row.selected_option);

      await studentInvokeHistoryManager({
        action: "submit_activity_attempt",
        user_id: user.id,
        activity_id: state.currentActivity.id,
        answers
      });

      studentStopTimer();
      state.currentAttemptId = null;
      state.currentAttemptExpiresAt = null;
      studentShowReportsView("studentActivitySubmittedView");
      await studentLoadReportsFeed();
    } catch (err) {
      console.error("studentSubmitActivity failed:", err);
      alert(err?.message || "Could not submit this activity right now.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  async function studentStartForm() {
    const form = state.currentForm;
    if (!form) return;

    if (form.status === "submitted") {
      alert("You have already submitted this form.");
      return;
    }

    if (form.status === "closed") {
      alert("This form is closed.");
      return;
    }

    try {
      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again to continue.");

      const data = await studentInvokeHistoryManager({
        action: "student_item_details",
        user_id: user.id,
        item_id: form.id,
        item_type: "form"
      });

      state.formQuestions = studentEnsureArray(data.questions).map((q) => ({
        ...q,
        question: q.question_text || q.question || q.title || "",
        type: (q.question_type || q.type || "short_answer").toLowerCase(),
        options: q.options || q.choice_options || q.choices || []
      }));
      state.currentFormResponseId = data?.response?.id || null;
      state.currentFormIndex = 0;
      state.formAnswers = {};

      studentEnsureArray(data.answers).forEach((answer) => {
        const qid = answer.question_id;
        if (!qid) return;
        if (answer.answer_json != null) {
          state.formAnswers[qid] = answer.answer_json;
        } else if (answer.answer_text != null) {
          state.formAnswers[qid] = answer.answer_text;
        } else if (answer.answer_value != null) {
          state.formAnswers[qid] = answer.answer_value;
        }
      });

      studentRenderFormQuestion();
      studentShowReportsView("studentFormQuestionView");
    } catch (err) {
      console.error("studentStartForm failed:", err);
      alert(err?.message || "Could not start this form.");
    }
  }

  function studentFormQuestionOptions(question) {
    if (Array.isArray(question.options)) return question.options;
    if (typeof question.options === "string") {
      try {
        const parsed = JSON.parse(question.options);
        if (Array.isArray(parsed)) return parsed;
      } catch {}
    }
    return [];
  }

  function studentResetFormInputBlocks() {
    [
      "studentFormShortAnswerBlock",
      "studentFormParagraphBlock",
      "studentFormMultipleChoiceBlock",
      "studentFormCheckboxBlock",
      "studentFormDropdownBlock",
      "studentFormYesNoBlock",
      "studentFormDateBlock",
      "studentFormFileBlock"
    ].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.classList.add("hidden");
    });
  }

  function studentRenderFormQuestion() {
    const question = state.formQuestions[state.currentFormIndex];
    if (!question) return;

    const total = state.formQuestions.length;
    const current = state.currentFormIndex + 1;
    const percent = total ? Math.round((current / total) * 100) : 0;
    const answerValue = state.formAnswers[question.id];

    const progressText = document.getElementById("studentFormProgressText");
    const progressPercent = document.getElementById("studentFormProgressPercent");
    const progressBar = document.getElementById("studentFormProgressBar");
    const titleEl = document.getElementById("studentFormQuestionTitle");
    const helpEl = document.getElementById("studentFormQuestionHelp");
    const noteEl = document.getElementById("studentFormFieldNote");
    const prevBtn = document.getElementById("studentFormPrevBtn");
    const nextBtn = document.getElementById("studentFormNextBtn");

    if (progressText) progressText.textContent = `Question ${current} of ${total}`;
    if (progressPercent) progressPercent.textContent = `${percent}%`;
    if (progressBar) progressBar.style.width = `${percent}%`;
    if (titleEl) titleEl.textContent = question.question || "Question";
    if (helpEl) {
      const helpText = question.help_text || question.description || "";
      helpEl.textContent = helpText;
      helpEl.classList.toggle("hidden", !helpText);
    }
    if (noteEl) noteEl.textContent = question.required ? "This field is required." : "";
    if (prevBtn) prevBtn.textContent = current === 1 ? "Back" : "Previous";
    if (nextBtn) nextBtn.textContent = current === total ? "Review" : "Next";

    studentResetFormInputBlocks();

    const type = String(question.type || "short_answer").toLowerCase();
    const options = studentFormQuestionOptions(question);

    if (type === "paragraph" || type === "long_text") {
      const block = document.getElementById("studentFormParagraphBlock");
      const input = document.getElementById("studentFormParagraphInput");
      if (block) block.classList.remove("hidden");
      if (input) input.value = typeof answerValue === "string" ? answerValue : "";
      return;
    }

    if (type === "multiple_choice" || type === "radio") {
      const block = document.getElementById("studentFormMultipleChoiceBlock");
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = options.map((opt, index) => {
          const value = typeof opt === "string" ? opt : (opt.value || opt.label || `Option ${index + 1}`);
          return `
            <button type="button" class="choice-option ${answerValue === value ? "active" : ""}" data-form-radio="${studentReportEscape(value)}">
              <div class="choice-mark">${studentReportEscape(String.fromCharCode(65 + index))}</div>
              <div class="choice-text">${studentReportEscape(value)}</div>
            </button>
          `;
        }).join("");
      }
      return;
    }

    if (type === "checkbox") {
      const selectedValues = Array.isArray(answerValue) ? answerValue : [];
      const block = document.getElementById("studentFormCheckboxBlock");
      if (block) {
        block.classList.remove("hidden");
        block.innerHTML = options.map((opt, index) => {
          const value = typeof opt === "string" ? opt : (opt.value || opt.label || `Option ${index + 1}`);
          const active = selectedValues.includes(value);
          return `
            <button type="button" class="choice-option ${active ? "active" : ""}" data-form-checkbox="${studentReportEscape(value)}">
              <div class="choice-mark">${active ? "✓" : String.fromCharCode(65 + index)}</div>
              <div class="choice-text">${studentReportEscape(value)}</div>
            </button>
          `;
        }).join("");
      }
      return;
    }

    if (type === "dropdown" || type === "select") {
      const block = document.getElementById("studentFormDropdownBlock");
      const input = document.getElementById("studentFormDropdownInput");
      if (block) block.classList.remove("hidden");
      if (input) {
        input.innerHTML = `<option value="">Select an option</option>` + options.map((opt) => {
          const value = typeof opt === "string" ? opt : (opt.value || opt.label || "");
          return `<option value="${studentReportEscape(value)}">${studentReportEscape(value)}</option>`;
        }).join("");
        input.value = typeof answerValue === "string" ? answerValue : "";
      }
      return;
    }

    if (type === "yes_no" || type === "boolean") {
      const block = document.getElementById("studentFormYesNoBlock");
      if (block) {
        block.classList.remove("hidden");
        ["Yes", "No"].forEach((value, index) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `choice-option ${answerValue === value ? "active" : ""}`;
          btn.dataset.formRadio = value;
          btn.innerHTML = `
            <div class="choice-mark">${studentReportEscape(String.fromCharCode(65 + index))}</div>
            <div class="choice-text">${studentReportEscape(value)}</div>
          `;
          block.appendChild(btn);
        });
      }
      return;
    }

    if (type === "date") {
      const block = document.getElementById("studentFormDateBlock");
      const input = document.getElementById("studentFormDateInput");
      if (block) block.classList.remove("hidden");
      if (input) input.value = typeof answerValue === "string" ? answerValue : "";
      return;
    }

    if (type === "file" || type === "upload") {
      const block = document.getElementById("studentFormFileBlock");
      const rules = document.getElementById("studentFormFileRules");
      if (block) block.classList.remove("hidden");
      if (rules) {
        rules.textContent = typeof answerValue === "string" && answerValue
          ? `Selected file: ${answerValue}`
          : "Choose a file from your device.";
      }
      return;
    }

    const block = document.getElementById("studentFormShortAnswerBlock");
    const input = document.getElementById("studentFormShortAnswerInput");
    if (block) block.classList.remove("hidden");
    if (input) input.value = typeof answerValue === "string" ? answerValue : "";
  }

  function studentCaptureCurrentFormAnswer() {
    const question = state.formQuestions[state.currentFormIndex];
    if (!question) return;

    const type = String(question.type || "short_answer").toLowerCase();

    if (type === "paragraph" || type === "long_text") {
      const input = document.getElementById("studentFormParagraphInput");
      state.formAnswers[question.id] = input ? input.value.trim() : "";
      return;
    }

    if (type === "dropdown" || type === "select") {
      const input = document.getElementById("studentFormDropdownInput");
      state.formAnswers[question.id] = input ? input.value : "";
      return;
    }

    if (type === "date") {
      const input = document.getElementById("studentFormDateInput");
      state.formAnswers[question.id] = input ? input.value : "";
      return;
    }

    if (type === "file" || type === "upload") {
      return;
    }

    if (type === "checkbox") {
      if (!Array.isArray(state.formAnswers[question.id])) state.formAnswers[question.id] = [];
      return;
    }

    const input = document.getElementById("studentFormShortAnswerInput");
    state.formAnswers[question.id] = input ? input.value.trim() : "";
  }

  function studentValidateCurrentFormAnswer() {
    const question = state.formQuestions[state.currentFormIndex];
    if (!question) return true;

    if (!question.required) return true;

    const value = state.formAnswers[question.id];

    if (Array.isArray(value)) return value.length > 0;
    return !!String(value ?? "").trim();
  }

  function studentGoPrevFormQuestion() {
    if (state.currentFormIndex <= 0) {
      studentShowReportsView("studentFormDetailsView");
      return;
    }

    studentCaptureCurrentFormAnswer();
    state.currentFormIndex -= 1;
    studentRenderFormQuestion();
  }

  function studentGoNextFormQuestion() {
    studentCaptureCurrentFormAnswer();

    if (!studentValidateCurrentFormAnswer()) {
      alert("Please answer this question before moving on.");
      return;
    }

    const total = state.formQuestions.length;
    if (state.currentFormIndex >= total - 1) {
      studentRenderFormReview();
      studentShowReportsView("studentFormReviewView");
      return;
    }

    state.currentFormIndex += 1;
    studentRenderFormQuestion();
  }

  function studentRenderFormReview() {
    const wrap = document.getElementById("studentFormReviewList");
    if (!wrap) return;

    wrap.innerHTML = state.formQuestions.map((q, index) => {
      const value = state.formAnswers[q.id];
      let answerText = "No answer";
      if (Array.isArray(value)) answerText = value.join(", ");
      else if (typeof value === "string" && value.trim()) answerText = value.trim();

      return `
        <div class="review-item" data-review-form-index="${index}">
          <div class="review-q">${studentReportEscape(`Question ${index + 1}: ${q.question}`)}</div>
          <div class="review-a"><strong>Your answer:</strong> ${studentReportEscape(answerText)}</div>
        </div>
      `;
    }).join("");
  }

  async function studentSubmitForm() {
    const btn = document.getElementById("studentSubmitFormBtn");
    const oldText = btn ? btn.textContent : "Submit form";

    try {
      studentCaptureCurrentFormAnswer();

      for (const q of state.formQuestions) {
        if (q.required) {
          const value = state.formAnswers[q.id];
          if ((Array.isArray(value) && !value.length) || (!Array.isArray(value) && !String(value ?? "").trim())) {
            throw new Error("Please answer all required questions before submitting.");
          }
        }
      }

      const user = await studentEnsureUser();
      if (!user) throw new Error("Please sign in again to continue.");
      if (typeof supabase === "undefined") throw new Error("Supabase is not available.");

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Submitting...";
      }

      let responseId = state.currentFormResponseId;

      if (!responseId) {
        const { data: response, error: responseError } = await supabase
          .from("form_responses")
          .insert([{
            form_id: state.currentForm.id,
            submitted_by: user.id,
            submitted_at: new Date().toISOString(),
            status: "submitted"
          }])
          .select("id")
          .single();

        if (responseError) throw responseError;
        responseId = response.id;
      } else {
        const { error: updateResponseError } = await supabase
          .from("form_responses")
          .update({
            submitted_at: new Date().toISOString(),
            status: "submitted"
          })
          .eq("id", responseId);

        if (updateResponseError) throw updateResponseError;
      }

      state.currentFormResponseId = responseId;

      for (const q of state.formQuestions) {
        const rawValue = state.formAnswers[q.id];
        const answer_text = Array.isArray(rawValue) ? rawValue.join(", ") : String(rawValue ?? "");

        const { error: answerError } = await supabase
          .from("form_answers")
          .upsert([{
            response_id: responseId,
            question_id: q.id,
            answer_text
          }], {
            onConflict: "response_id,question_id"
          });

        if (answerError) throw answerError;
      }

      studentShowReportsView("studentFormSubmittedView");
      await studentLoadReportsFeed();
    } catch (err) {
      console.error("studentSubmitForm failed:", err);
      alert(err?.message || "Could not submit this form.");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  function studentBackToReportsHome() {
    state.currentActivity = null;
    state.currentForm = null;
    state.currentAnnouncement = null;
    state.activityQuestions = [];
    state.formQuestions = [];
    state.activityAnswers = {};
    state.formAnswers = {};
    state.currentActivityIndex = 0;
    state.currentFormIndex = 0;
    state.currentAttemptId = null;
    state.currentAttemptExpiresAt = null;
    state.currentFormResponseId = null;
    studentStopTimer();
    studentShowReportsView("studentReportsHomeView");
  }

  function studentBindReportsEvents() {
    const tabsWrap = document.getElementById("studentReportsTabs");
    if (tabsWrap && !tabsWrap.dataset.bound) {
      tabsWrap.dataset.bound = "1";
      tabsWrap.addEventListener("click", (event) => {
        const btn = event.target.closest(".reports-tab");
        if (!btn) return;

        const filter = btn.dataset.feedFilter || "all";
        state.currentFilter = filter;

        tabsWrap.querySelectorAll(".reports-tab").forEach((tab) => {
          tab.classList.toggle("active", tab === btn);
        });

        studentRenderFeedList();
      });
    }

    const input = document.getElementById("studentReportsSearchInput");
    if (input && !input.dataset.bound) {
      input.dataset.bound = "1";
      input.addEventListener("input", () => {
        state.searchTerm = input.value || "";
        studentRenderFeedList();
      });
    }

    const feedList = document.getElementById("studentReportsFeedList");
    if (feedList && !feedList.dataset.bound) {
      feedList.dataset.bound = "1";
      feedList.addEventListener("click", async (event) => {
        const openBtn = event.target.closest("[data-item-open]");
        if (!openBtn) return;

        const itemId = openBtn.dataset.itemOpen;
        const itemType = openBtn.dataset.itemType;

        if (itemType === "activity") {
          await studentOpenActivityIntro(itemId);
        } else if (itemType === "form") {
          await studentOpenFormDetails(itemId);
        } else if (itemType === "announcement") {
          await studentOpenAnnouncementDetails(itemId);
        }
      });
    }

    const startActivityBtn = document.getElementById("studentStartActivityBtn");
    if (startActivityBtn && !startActivityBtn.dataset.bound) {
      startActivityBtn.dataset.bound = "1";
      startActivityBtn.addEventListener("click", studentStartActivity);
    }

    const activityPrevBtn = document.getElementById("studentActivityPrevBtn");
    if (activityPrevBtn && !activityPrevBtn.dataset.bound) {
      activityPrevBtn.dataset.bound = "1";
      activityPrevBtn.addEventListener("click", studentGoPrevQuestion);
    }

    const activityNextBtn = document.getElementById("studentActivityNextBtn");
    if (activityNextBtn && !activityNextBtn.dataset.bound) {
      activityNextBtn.dataset.bound = "1";
      activityNextBtn.addEventListener("click", studentGoNextQuestion);
    }

    const submitActivityBtn = document.getElementById("studentSubmitActivityBtn");
    if (submitActivityBtn && !submitActivityBtn.dataset.bound) {
      submitActivityBtn.dataset.bound = "1";
      submitActivityBtn.addEventListener("click", () => studentSubmitActivity(false));
    }

    const startFormBtn = document.getElementById("studentStartFormBtn");
    if (startFormBtn && !startFormBtn.dataset.bound) {
      startFormBtn.dataset.bound = "1";
      startFormBtn.addEventListener("click", studentStartForm);
    }

    const formPrevBtn = document.getElementById("studentFormPrevBtn");
    if (formPrevBtn && !formPrevBtn.dataset.bound) {
      formPrevBtn.dataset.bound = "1";
      formPrevBtn.addEventListener("click", studentGoPrevFormQuestion);
    }

    const formNextBtn = document.getElementById("studentFormNextBtn");
    if (formNextBtn && !formNextBtn.dataset.bound) {
      formNextBtn.dataset.bound = "1";
      formNextBtn.addEventListener("click", studentGoNextFormQuestion);
    }

    const activityOptionList = document.getElementById("studentActivityOptionList");
    if (activityOptionList && !activityOptionList.dataset.bound) {
      activityOptionList.dataset.bound = "1";
      activityOptionList.addEventListener("click", (event) => {
        const choice = event.target.closest("[data-activity-choice]");
        if (!choice) return;
        const question = state.activityQuestions[state.currentActivityIndex];
        if (!question) return;
        state.activityAnswers[question.id] = choice.dataset.activityChoice;
        studentRenderActivityQuestion();
      });
    }

    const activityReviewList = document.getElementById("studentActivityReviewList");
    if (activityReviewList && !activityReviewList.dataset.bound) {
      activityReviewList.dataset.bound = "1";
      activityReviewList.addEventListener("click", (event) => {
        const item = event.target.closest("[data-review-activity-index]");
        if (!item) return;
        const idx = Number(item.dataset.reviewActivityIndex);
        if (!Number.isFinite(idx)) return;
        state.currentActivityIndex = idx;
        studentShowReportsView("studentActivityQuestionView");
        studentRenderActivityQuestion();
        studentStartTimer(state.currentAttemptExpiresAt);
      });
    }

    const activityIntroBack = document.querySelector("#studentActivityIntroView .panel-back-btn");
    if (activityIntroBack && !activityIntroBack.dataset.bound) {
      activityIntroBack.dataset.bound = "1";
      activityIntroBack.addEventListener("click", studentBackToReportsHome);
    }

    const activityQuestionBack = document.querySelector("#studentActivityQuestionView .panel-back-btn");
    if (activityQuestionBack && !activityQuestionBack.dataset.bound) {
      activityQuestionBack.dataset.bound = "1";
      activityQuestionBack.addEventListener("click", () => {
        studentShowReportsView("studentActivityIntroView");
      });
    }

    const activityReviewBack = document.querySelector("#studentActivityReviewView .panel-back-btn");
    if (activityReviewBack && !activityReviewBack.dataset.bound) {
      activityReviewBack.dataset.bound = "1";
      activityReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentActivityQuestionView");
        studentRenderActivityQuestion();
        studentStartTimer(state.currentAttemptExpiresAt);
      });
    }

    const activitySubmittedBack = document.querySelector("#studentActivitySubmittedView .primary-btn");
    if (activitySubmittedBack && !activitySubmittedBack.dataset.bound) {
      activitySubmittedBack.dataset.bound = "1";
      activitySubmittedBack.addEventListener("click", studentBackToReportsHome);
    }

    const formDetailsBack = document.querySelector("#studentFormDetailsView .panel-back-btn");
    if (formDetailsBack && !formDetailsBack.dataset.bound) {
      formDetailsBack.dataset.bound = "1";
      formDetailsBack.addEventListener("click", studentBackToReportsHome);
    }

    const formQuestionBack = document.querySelector("#studentFormQuestionView .panel-back-btn");
    if (formQuestionBack && !formQuestionBack.dataset.bound) {
      formQuestionBack.dataset.bound = "1";
      formQuestionBack.addEventListener("click", () => {
        studentShowReportsView("studentFormDetailsView");
      });
    }

    const formReviewBack = document.querySelector("#studentFormReviewView .panel-back-btn");
    if (formReviewBack && !formReviewBack.dataset.bound) {
      formReviewBack.dataset.bound = "1";
      formReviewBack.addEventListener("click", () => {
        studentShowReportsView("studentFormQuestionView");
        studentRenderFormQuestion();
      });
    }

    const shortInput = document.getElementById("studentFormShortAnswerInput");
    if (shortInput && !shortInput.dataset.bound) {
      shortInput.dataset.bound = "1";
      shortInput.addEventListener("input", () => {
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = shortInput.value || "";
      });
    }

    const paragraphInput = document.getElementById("studentFormParagraphInput");
    if (paragraphInput && !paragraphInput.dataset.bound) {
      paragraphInput.dataset.bound = "1";
      paragraphInput.addEventListener("input", () => {
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = paragraphInput.value || "";
      });
    }

    const dropdownInput = document.getElementById("studentFormDropdownInput");
    if (dropdownInput && !dropdownInput.dataset.bound) {
      dropdownInput.dataset.bound = "1";
      dropdownInput.addEventListener("change", () => {
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = dropdownInput.value || "";
      });
    }

    const dateInput = document.getElementById("studentFormDateInput");
    if (dateInput && !dateInput.dataset.bound) {
      dateInput.dataset.bound = "1";
      dateInput.addEventListener("change", () => {
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = dateInput.value || "";
      });
    }

    const formMultipleChoiceBlock = document.getElementById("studentFormMultipleChoiceBlock");
    if (formMultipleChoiceBlock && !formMultipleChoiceBlock.dataset.bound) {
      formMultipleChoiceBlock.dataset.bound = "1";
      formMultipleChoiceBlock.addEventListener("click", (e) => {
        const item = e.target.closest("[data-form-radio]");
        if (!item) return;
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = item.getAttribute("data-form-radio");
        studentRenderFormQuestion();
      });
    }

    const formCheckboxBlock = document.getElementById("studentFormCheckboxBlock");
    if (formCheckboxBlock && !formCheckboxBlock.dataset.bound) {
      formCheckboxBlock.dataset.bound = "1";
      formCheckboxBlock.addEventListener("click", (e) => {
        const item = e.target.closest("[data-form-checkbox]");
        if (!item) return;
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;

        const value = item.getAttribute("data-form-checkbox");
        const current = Array.isArray(state.formAnswers[question.id]) ? [...state.formAnswers[question.id]] : [];
        const idx = current.indexOf(value);

        if (idx >= 0) current.splice(idx, 1);
        else current.push(value);

        state.formAnswers[question.id] = current;
        studentRenderFormQuestion();
      });
    }

    const formYesNoBlock = document.getElementById("studentFormYesNoBlock");
    if (formYesNoBlock && !formYesNoBlock.dataset.bound) {
      formYesNoBlock.dataset.bound = "1";
      formYesNoBlock.addEventListener("click", (e) => {
        const item = e.target.closest("[data-form-radio]");
        if (!item) return;
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        state.formAnswers[question.id] = item.getAttribute("data-form-radio");
        studentRenderFormQuestion();
      });
    }

    const chooseFileBtn = document.getElementById("studentFormChooseFileBtn");
    const fileInput = document.getElementById("studentFormFileInput");

    if (chooseFileBtn && fileInput && !chooseFileBtn.dataset.bound) {
      chooseFileBtn.dataset.bound = "1";
      chooseFileBtn.addEventListener("click", () => fileInput.click());
    }

    if (fileInput && !fileInput.dataset.bound) {
      fileInput.dataset.bound = "1";
      fileInput.addEventListener("change", () => {
        const question = state.formQuestions[state.currentFormIndex];
        if (!question) return;
        const file = fileInput.files && fileInput.files[0];
        const name = file ? file.name : "";
        state.formAnswers[question.id] = name;
        const fileRules = document.getElementById("studentFormFileRules");
        if (fileRules) {
          fileRules.textContent = name ? `Selected file: ${name}` : "Choose a file from your device.";
        }
      });
    }

    const formReviewList = document.getElementById("studentFormReviewList");
    if (formReviewList && !formReviewList.dataset.bound) {
      formReviewList.dataset.bound = "1";
      formReviewList.addEventListener("click", (e) => {
        const item = e.target.closest("[data-review-form-index]");
        if (!item) return;
        const idx = Number(item.getAttribute("data-review-form-index"));
        if (!Number.isFinite(idx)) return;
        state.currentFormIndex = idx;
        studentRenderFormQuestion();
        studentShowReportsView("studentFormQuestionView");
      });
    }

    const submitFormBtn = document.getElementById("studentSubmitFormBtn");
    if (submitFormBtn && !submitFormBtn.dataset.bound) {
      submitFormBtn.dataset.bound = "1";
      submitFormBtn.addEventListener("click", studentSubmitForm);
    }

    const formSubmittedBack = document.querySelector("#studentFormSubmittedView .primary-btn");
    if (formSubmittedBack && !formSubmittedBack.dataset.bound) {
      formSubmittedBack.dataset.bound = "1";
      formSubmittedBack.addEventListener("click", studentBackToReportsHome);
    }
  }

  function studentInitReportsScreen() {
    studentBindReportsEvents();
    studentShowReportsView("studentReportsHomeView");
    studentLoadReportsFeed();
  }

  window.studentInitReportsScreen = studentInitReportsScreen;
  window.studentLoadReportsFeed = studentLoadReportsFeed;
  window.studentBackToReportsHome = studentBackToReportsHome;
  window.studentOpenActivityIntro = studentOpenActivityIntro;
  window.studentOpenFormDetails = studentOpenFormDetails;
  window.studentOpenAnnouncementDetails = studentOpenAnnouncementDetails;
})();
</script>
