<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • Reset HOS Password</title>

  <style>
    :root{
      --bg:#f4f7fb;
      --card:#ffffff;
      --soft:#f8fafc;
      --line:#e5e7eb;
      --text:#111827;
      --muted:#6b7280;
      --blue:#2563eb;
      --green:#15803d;
      --green-bg:#ecfdf5;
      --green-border:#bbf7d0;
      --red:#b91c1c;
      --red-bg:#fef2f2;
      --red-border:#fecaca;
      --shadow:0 16px 36px rgba(15,23,42,.08);
      --radius:24px;
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      padding:0;
      min-height:100%;
      background:var(--bg);
      color:var(--text);
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    }

    body{
      display:flex;
      justify-content:center;
    }

    .phone-shell{
      width:100%;
      max-width:420px;
      min-height:100vh;
      padding:16px 14px 32px;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin:4px 2px 14px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand-logo{
      width:42px;
      height:42px;
      border-radius:12px;
      background:linear-gradient(135deg,#60a5fa,#2563eb);
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:22px;
      font-weight:800;
      box-shadow:0 10px 22px rgba(37,99,235,.24);
      flex-shrink:0;
    }

    .brand-name{
      font-size:18px;
      font-weight:800;
      color:#111827;
    }

    .brand-sub{
      font-size:12px;
      color:var(--muted);
      margin-top:2px;
    }

    .top-actions{
      display:flex;
      gap:8px;
    }

    .pill-btn{
      border:1px solid var(--line);
      background:#fff;
      color:#111827;
      border-radius:999px;
      padding:9px 16px;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
    }

    .message{
      display:none;
      margin:0 0 14px;
      padding:12px 14px;
      border-radius:16px;
      font-size:13px;
      line-height:1.45;
      font-weight:600;
    }

    .message.show{
      display:block;
    }

    .message.error{
      background:var(--red-bg);
      border:1px solid var(--red-border);
      color:var(--red);
    }

    .message.success{
      background:var(--green-bg);
      border:1px solid var(--green-border);
      color:var(--green);
    }

    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:18px 16px;
      margin-bottom:14px;
    }

    .profile-head{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:8px;
      margin-bottom:12px;
    }

    .avatar{
      width:88px;
      height:88px;
      border-radius:999px;
      background:radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:38px;
      font-weight:800;
    }

    .title{
      font-size:21px;
      font-weight:900;
      letter-spacing:-.03em;
      text-align:center;
      margin:2px 0 4px;
    }

    .sub{
      font-size:13px;
      color:var(--muted);
      text-align:center;
      line-height:1.5;
      margin:0 auto 14px;
      max-width:290px;
    }

    .info-box{
      background:var(--soft);
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px;
      margin-bottom:14px;
    }

    .info-row{
      display:flex;
      align-items:flex-start;
      gap:10px;
    }

    .info-icon{
      width:34px;
      height:34px;
      border-radius:999px;
      background:#eef2ff;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .info-icon svg{
      width:16px;
      height:16px;
      stroke:#4f46e5;
      stroke-width:1.8;
      fill:none;
    }

    .info-label{
      font-size:12px;
      color:var(--muted);
      margin-bottom:2px;
    }

    .info-value{
      font-size:14px;
      font-weight:700;
      color:#111827;
      word-break:break-word;
    }

    .step-indicator{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      margin:8px 0 14px;
    }

    .step-dot{
      width:10px;
      height:10px;
      border-radius:999px;
      background:#d1d5db;
    }

    .step-dot.active{
      background:#2563eb;
    }

    .step-dot.done{
      background:#16a34a;
    }

    .step-card{
      display:none;
    }

    .step-card.active{
      display:block;
    }

    .field{
      margin-bottom:12px;
    }

    .field label{
      display:block;
      font-size:12px;
      font-weight:700;
      color:#334155;
      margin-bottom:6px;
    }

    .input{
      width:100%;
      border:1px solid var(--line);
      background:#fff;
      color:#111827;
      border-radius:14px;
      padding:12px 13px;
      font-size:14px;
      outline:none;
    }

    .helper{
      font-size:12px;
      color:var(--muted);
      line-height:1.45;
      margin:6px 0 0;
    }

    .btn-row{
      display:flex;
      gap:10px;
      margin-top:14px;
    }

    .btn{
      flex:1;
      border:none;
      border-radius:999px;
      padding:12px 14px;
      font-size:14px;
      font-weight:800;
      cursor:pointer;
    }

    .btn.primary{
      background:linear-gradient(135deg,#3b82f6,#2563eb);
      color:#fff;
      box-shadow:0 12px 24px rgba(37,99,235,.18);
    }

    .btn.secondary{
      background:#fff;
      border:1px solid var(--line);
      color:#111827;
    }

    .btn.success{
      background:var(--green-bg);
      border:1px solid var(--green-border);
      color:var(--green);
    }

    .btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }

    .result-card{
      background:#f8fbff;
      border:1px solid #dbeafe;
      border-radius:18px;
      padding:14px;
      margin-bottom:14px;
      display:none;
    }

    .result-line + .result-line{
      margin-top:10px;
    }

    .result-label{
      font-size:11px;
      color:var(--muted);
      margin-bottom:3px;
    }

    .result-value{
      font-size:15px;
      font-weight:800;
      color:#111827;
      word-break:break-word;
    }

    @media (max-width:360px){
      .btn-row{
        flex-direction:column;
      }
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <div class="topbar">
      <div class="brand">
        <div class="brand-logo">C</div>
        <div>
          <div class="brand-name">Colspot</div>
          <div class="brand-sub">Reset HOS password</div>
        </div>
      </div>

      <div class="top-actions">
        <button class="pill-btn" id="backBtn" type="button">Back</button>
      </div>
    </div>

    <div class="message" id="pageMessage"></div>

    <section class="card">
      <div class="profile-head">
        <div class="avatar" id="avatarInitial">H</div>
        <div class="title">Reset Password</div>
        <p class="sub">
          Confirm your linked email with a verification code before changing your password.
        </p>
      </div>

      <div class="info-box">
        <div class="info-row">
          <div class="info-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div>
            <div class="info-label">Linked email</div>
            <div class="info-value" id="linkedEmailText">No linked email</div>
          </div>
        </div>
      </div>

      <div class="info-box">
        <div class="info-row">
          <div class="info-icon">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="14" rx="2"></rect>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>
          </div>
          <div>
            <div class="info-label">Login ID</div>
            <div class="info-value" id="loginIdText">-</div>
          </div>
        </div>
      </div>

      <div class="step-indicator">
        <span class="step-dot active" id="dot1"></span>
        <span class="step-dot" id="dot2"></span>
        <span class="step-dot" id="dot3"></span>
      </div>

      <div class="step-card active" id="step1">
        <div class="field">
          <label>Email verification</label>
          <input class="input" id="emailPreviewInput" type="text" readonly>
          <p class="helper">
            A verification code will be sent to this linked email.
          </p>
        </div>

        <div class="btn-row">
          <button class="btn primary" id="sendCodeBtn" type="button">Send verification code</button>
          <button class="btn secondary" id="cancelBtn1" type="button">Cancel</button>
        </div>
      </div>

      <div class="step-card" id="step2">
        <div class="field">
          <label for="verificationCodeInput">Verification code</label>
          <input
            class="input"
            id="verificationCodeInput"
            type="text"
            inputmode="numeric"
            maxlength="6"
            placeholder="Enter 6-digit code"
          >
          <p class="helper" id="step2Helper">
            Enter the code sent to your linked email.
          </p>
        </div>

        <div class="btn-row">
          <button class="btn primary" id="verifyCodeBtn" type="button">Verify code</button>
          <button class="btn secondary" id="resendCodeBtn" type="button">Resend code</button>
        </div>

        <div class="btn-row">
          <button class="btn secondary" id="backToStep1Btn" type="button">Back</button>
        </div>
      </div>

      <div class="step-card" id="step3">
        <p class="helper" style="margin-bottom:14px;">
          Your email has been verified. Enter your new password below.
        </p>

        <div class="field">
          <label for="newPasswordInput">New password</label>
          <input
            class="input"
            id="newPasswordInput"
            type="password"
            placeholder="Enter new password"
          >
        </div>

        <div class="field">
          <label for="confirmPasswordInput">Confirm password</label>
          <input
            class="input"
            id="confirmPasswordInput"
            type="password"
            placeholder="Confirm new password"
          >
          <p class="helper">
            Use at least 6 characters.
          </p>
        </div>

        <div class="btn-row">
          <button class="btn success" id="savePasswordBtn" type="button">Save new password</button>
        </div>

        <div class="result-card" id="resultCard">
          <div class="result-line">
            <div class="result-label">Login ID</div>
            <div class="result-value" id="resultLoginId">-</div>
          </div>

          <div class="result-line">
            <div class="result-label">Password updated</div>
            <div class="result-value" id="resultPasswordStatus">Your new password has been saved successfully.</div>
          </div>
        </div>

        <div class="btn-row">
          <button class="btn primary" id="backToAccountBtn" type="button">Back to account</button>
        </div>
      </div>
    </section>
  </div>

  <script>
    (() => {
      const SUPABASE_URL = "https://wtlrfujfimxcmsnqrnig.supabase.co";
      const SUPABASE_ANON_KEY = "PASTE_YOUR_REAL_SUPABASE_ANON_KEY_HERE";
      const EDGE_BASE = `${SUPABASE_URL}/functions/v1`;

      const EDGE = {
        startResetVerification: "start-hos-password-reset-verification",
        verifyResetCode: "verify-hos-password-reset-code",
        completeReset: "complete-hos-password-reset"
      };

      let hosSession = null;
      let emailVerifiedForReset = false;

      function $(id) {
        return document.getElementById(id);
      }

      function getSession() {
        try {
          return JSON.parse(localStorage.getItem("colspot_admin_session") || "null");
        } catch {
          return null;
        }
      }

      function showMessage(text = "", type = "error") {
        const box = $("pageMessage");
        if (!text) {
          box.className = "message";
          box.textContent = "";
          return;
        }
        box.className = `message show ${type}`;
        box.textContent = text;
      }

      async function invokeEdge(name, payload = {}) {
        const res = await fetch(`${EDGE_BASE}/${name}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "apikey": SUPABASE_ANON_KEY,
            "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
          },
          body: JSON.stringify(payload)
        });

        const result = await res.json().catch(() => ({}));

        if (!res.ok || !result.ok) {
          throw new Error(result.error || `Edge function failed: ${name}`);
        }

        return result;
      }

      function setStep(step) {
        $("step1").classList.remove("active");
        $("step2").classList.remove("active");
        $("step3").classList.remove("active");

        $("dot1").className = "step-dot";
        $("dot2").className = "step-dot";
        $("dot3").className = "step-dot";

        if (step === 1) {
          $("step1").classList.add("active");
          $("dot1").classList.add("active");
        } else if (step === 2) {
          $("step2").classList.add("active");
          $("dot1").classList.add("done");
          $("dot2").classList.add("active");
        } else if (step === 3) {
          $("step3").classList.add("active");
          $("dot1").classList.add("done");
          $("dot2").classList.add("done");
          $("dot3").classList.add("active");
        }
      }

      function loadSessionData() {
        hosSession = getSession();

        if (!hosSession || String(hosSession.role || "").toLowerCase() !== "hos") {
          window.location.href = "index.html";
          return false;
        }

        const linkedEmail = String(hosSession.linked_email || "").trim();
        const loginId = hosSession.login_id || "-";
        const fullName = hosSession.full_name || "HOS";
        const initial = fullName.trim().charAt(0).toUpperCase() || "H";

        if (!linkedEmail) {
          showMessage("No linked email found for this HOS account. Please add an email first from the account page.");
          $("sendCodeBtn").disabled = true;
          return false;
        }

        $("avatarInitial").textContent = initial;
        $("linkedEmailText").textContent = linkedEmail;
        $("emailPreviewInput").value = linkedEmail;
        $("loginIdText").textContent = loginId;

        return true;
      }

      async function sendCode() {
        if (!hosSession) return;

        const btn = $("sendCodeBtn");
        const oldText = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Sending...";

        try {
          const result = await invokeEdge(EDGE.startResetVerification, {
            hos_id: hosSession.id
          });

          showMessage(result.message || "Verification code sent successfully.", "success");
          $("step2Helper").textContent = `Enter the code sent to ${hosSession.linked_email}.`;
          setStep(2);
        } catch (e) {
          console.error("sendCode error:", e);
          showMessage(e.message || "Could not send verification code.");
        } finally {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      }

      async function verifyCode() {
        if (!hosSession) return;

        const code = ($("verificationCodeInput").value || "").trim();
        if (!code) {
          showMessage("Please enter the verification code.");
          return;
        }

        const btn = $("verifyCodeBtn");
        const oldText = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Verifying...";

        try {
          const result = await invokeEdge(EDGE.verifyResetCode, {
            hos_id: hosSession.id,
            code
          });

          emailVerifiedForReset = true;
          showMessage(result.message || "Code verified successfully.", "success");
          setStep(3);
        } catch (e) {
          console.error("verifyCode error:", e);
          showMessage(e.message || "Could not verify code.");
        } finally {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      }

      async function resendCode() {
        await sendCode();
      }

      async function savePassword() {
        if (!hosSession) return;
        if (!emailVerifiedForReset) {
          showMessage("Please verify your email first.");
          return;
        }

        const newPassword = ($("newPasswordInput").value || "").trim();
        const confirmPassword = ($("confirmPasswordInput").value || "").trim();

        if (!newPassword) {
          showMessage("Please enter your new password.");
          return;
        }

        if (newPassword.length < 6) {
          showMessage("Password must be at least 6 characters.");
          return;
        }

        if (!confirmPassword) {
          showMessage("Please confirm your new password.");
          return;
        }

        if (newPassword !== confirmPassword) {
          showMessage("Passwords do not match.");
          return;
        }

        const btn = $("savePasswordBtn");
        const oldText = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Saving...";

        try {
          const result = await invokeEdge(EDGE.completeReset, {
            hos_id: hosSession.id,
            new_password: newPassword
          });

          $("resultCard").style.display = "block";
          $("resultLoginId").textContent = result.login_id || hosSession.login_id || "-";
          $("resultPasswordStatus").textContent = result.message || "Your new password has been saved successfully.";

          $("newPasswordInput").value = "";
          $("confirmPasswordInput").value = "";

          showMessage(result.message || "Password reset successfully.", "success");
        } catch (e) {
          console.error("savePassword error:", e);
          showMessage(e.message || "Could not save new password.");
        } finally {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      }

      function goBack() {
        window.location.href = "hos_account.html";
      }

      document.addEventListener("DOMContentLoaded", () => {
        loadSessionData();

        $("backBtn").addEventListener("click", goBack);
        $("cancelBtn1").addEventListener("click", goBack);
        $("backToAccountBtn").addEventListener("click", goBack);

        $("sendCodeBtn").addEventListener("click", sendCode);
        $("verifyCodeBtn").addEventListener("click", verifyCode);
        $("resendCodeBtn").addEventListener("click", resendCode);

        $("backToStep1Btn").addEventListener("click", () => {
          $("verificationCodeInput").value = "";
          setStep(1);
          showMessage("", "error");
        });

        $("savePasswordBtn").addEventListener("click", savePassword);
      });
    })();
  </script>
</body>
</html>
