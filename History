<script>
  if (typeof STUDENT_HISTORY_KEY === "undefined") {
    var STUDENT_HISTORY_KEY = "colspot_student_history";
  }

  const HISTORY_REFRESH_INTERVAL_MS = 10000;

  let studentHistoryEntries = [];
  let fullHistoryClasses = [];
  let scanHistoryItems = [];
  let schoolAnnouncementItems = [];
  let reportHistoryItems = [];
  let combinedHistoryItems = [];
  let combinedHistoryFiltered = [];

  function showFullHistoryError(msg) {
    const box = document.getElementById("fullHistoryError");
    if (!box) return;
    if (!msg) {
      box.textContent = "";
      box.style.display = "none";
    } else {
      box.textContent = msg;
      box.style.display = "block";
    }
  }

  function setFullHistoryStats(text) {
    const el = document.getElementById("fullStatsText");
    if (el) el.textContent = text;
  }

  function formatHistoryDateShort(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    return d.toLocaleDateString([], {
      year: "numeric",
      month: "short",
      day: "2-digit",
    });
  }

  function formatHistoryTimeShort(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    return d.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function isHistoryOffline() {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isBrowserOffline === "function"
      ) {
        return ColspotGuard.isBrowserOffline();
      }
    } catch (e) {}
    try {
      return typeof navigator !== "undefined" && navigator.onLine === false;
    } catch {
      return false;
    }
  }

  function isLikelyOfflineErrorHistory(err) {
    try {
      if (
        window.ColspotGuard &&
        typeof ColspotGuard.isLikelyOfflineError === "function"
      ) {
        if (ColspotGuard.isLikelyOfflineError(err)) return true;
      }
    } catch (e) {}
    return isHistoryOffline();
  }

  const SCAN_BUCKET = "colspot-scan-uploads-saheed";
  const SCAN_REGION = "eu-west-1";

  function buildScanDownloadUrl(scanRow) {
    if (scanRow.download_url) return scanRow.download_url;
    if (scanRow.result_json && scanRow.result_json.download_url) {
      return scanRow.result_json.download_url;
    }
    if (!scanRow.s3_object_key) return null;
    return (
      "https://" +
      SCAN_BUCKET +
      ".s3." +
      SCAN_REGION +
      ".amazonaws.com/" +
      encodeURIComponent(scanRow.s3_object_key)
    );
  }

  async function openScanDownload(url, filename) {
    if (!url) return;

    const isNative =
      !!window.Capacitor && !!window.Capacitor.isNativePlatform;
    const hasBrowserPlugin =
      !!window.Capacitor &&
      !!window.Capacitor.Plugins &&
      !!window.Capacitor.Plugins.Browser;

    try {
      if (isNative && hasBrowserPlugin) {
        await window.Capacitor.Plugins.Browser.open({ url });
      } else {
        const a = document.createElement("a");
        a.href = url;
        a.target = "_blank";
        a.rel = "noopener";
        if (filename) a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }
    } catch (err) {
      console.error("openScanDownload error:", err);
      window.open(url, "_blank");
    }
  }

  function loadStudentHistoryFromCache() {
    studentHistoryEntries = [];
    try {
      const raw = localStorage.getItem(STUDENT_HISTORY_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          studentHistoryEntries = parsed;
        }
      }
    } catch (e) {
      console.error("Failed to parse student history cache:", e);
    }
  }

  async function loadSchoolAnnouncementsForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    let schoolName = "";

    try {
      const { data: studentRow, error: studentErr } = await supabase
        .from("student_accounts")
        .select("school_name")
        .eq("user_id", user.id)
        .maybeSingle();

      if (!studentErr && studentRow?.school_name) {
        schoolName = studentRow.school_name;
      }

      if (!schoolName) {
        const { data: lecturerRow, error: lecturerErr } = await supabase
          .from("lecturer_accounts")
          .select("school_name")
          .eq("user_id", user.id)
          .maybeSingle();

        if (!lecturerErr && lecturerRow?.school_name) {
          schoolName = lecturerRow.school_name;
        }
      }

      if (!schoolName) return [];

      const { data, error } = await supabase
        .from("school_announcements")
        .select("id, school_name, title, message, created_at")
        .ilike("school_name", schoolName)
        .order("created_at", { ascending: false })
        .limit(50);

      if (error) {
        console.error("Announcement history load error:", error);
        return [];
      }

      return data || [];
    } catch (e) {
      console.error("loadSchoolAnnouncementsForHistory error:", e);
      return [];
    }
  }

  async function loadReportHistoryForHistory(user) {
    if (typeof supabase === "undefined" || !user?.id) return [];

    try {
      const { data, error } = await supabase.functions.invoke("get-my-school-reports", {
        body: {
          submitted_by_user_id: user.id
        }
      });

      if (error) {
        console.error("Report history function error:", error);
        return [];
      }

      if (!data?.ok) {
        console.error("Report history data error:", data?.error);
        return [];
      }

      return Array.isArray(data.reports) ? data.reports : [];
    } catch (e) {
      console.error("loadReportHistoryForHistory error:", e);
      return [];
    }
  }

  function rebuildCombinedHistory() {
    combinedHistoryItems = [];

    studentHistoryEntries.forEach((entry) => {
      combinedHistoryItems.push({
        type: "student",
        created_at: entry.attended_at || entry.created_at || null,
        entry,
      });
    });

    fullHistoryClasses.forEach((item) => {
      combinedHistoryItems.push({
        type: "class",
        created_at: item.course.created_at || null,
        course: item.course,
        memberCount: item.memberCount,
      });
    });

    scanHistoryItems.forEach((scan) => {
      combinedHistoryItems.push({
        type: "scan",
        created_at: scan.created_at,
        scan,
      });
    });

    schoolAnnouncementItems.forEach((announcement) => {
      combinedHistoryItems.push({
        type: "announcement",
        created_at: announcement.created_at || null,
        announcement,
      });
    });

    reportHistoryItems.forEach((report) => {
      combinedHistoryItems.push({
        type: "report",
        created_at: report.created_at || null,
        report,
      });
    });

    combinedHistoryItems.sort((a, b) => {
      const da = a.created_at ? new Date(a.created_at).getTime() : 0;
      const db = b.created_at ? new Date(b.created_at).getTime() : 0;
      return db - da;
    });

    applyFullHistorySearchFilter();
  }

  function openStudentHistoryDetail(entry) {
    const modal = document.getElementById("studentHistoryModal");
    if (!modal) return;

    const courseHeading = document.getElementById("shCourseHeading");
    const courseLine = document.getElementById("shCourseLine");
    const lecturerLine = document.getElementById("shLecturerLine");
    const statusLine = document.getElementById("shStatusLine");
    const timeLine = document.getElementById("shTimeLine");
    const pinLine = document.getElementById("shPinLine");
    const nameLine = document.getElementById("shNameLine");
    const matricLine = document.getElementById("shMatricLine");
    const deptLine = document.getElementById("shDeptLine");

    if (courseHeading)
      courseHeading.textContent =
        entry.course_code || "Attendance details";

    if (courseLine) courseLine.textContent = entry.course_code || "—";
    if (lecturerLine)
      lecturerLine.textContent = entry.lecturer_name || "—";
    if (statusLine) statusLine.textContent = entry.status || "Present";

    const datePart = formatHistoryDateShort(entry.attended_at);
    const timePart = formatHistoryTimeShort(entry.attended_at);
    if (timeLine)
      timeLine.textContent =
        datePart && timePart ? `${datePart} · ${timePart}` : datePart || "";

    if (pinLine) pinLine.textContent = entry.pin_used || "—";
    if (nameLine) nameLine.textContent = entry.student_name || "—";
    if (matricLine) matricLine.textContent = entry.student_matric || "—";
    if (deptLine) deptLine.textContent = entry.student_department || "—";

    modal.classList.add("active");
  }

  function closeStudentHistoryModal() {
    const modal = document.getElementById("studentHistoryModal");
    if (modal) modal.classList.remove("active");
  }

  async function loadFullHistory(options = {}) {
    const silent = options.silent === true;
    const listEl = document.getElementById("fullHistoryList");
    const emptyEl = document.getElementById("fullHistoryEmpty");
    if (!listEl || !emptyEl) return;

    if (loadFullHistory._loading) return;
    loadFullHistory._loading = true;

    const previousScrollY = window.scrollY;

    try {
      if (!silent) {
        showFullHistoryError("");
        setFullHistoryStats("Loading history...");
        listEl.innerHTML = "";
        emptyEl.style.display = "none";
      } else {
        showFullHistoryError("");
      }

      if (typeof supabase === "undefined") {
        if (!silent) {
          showFullHistoryError("Backend not available. Please reload later.");
          setFullHistoryStats("Error loading history.");
        }
        return;
      }

      let user = null;
      try {
        const { data, error } = await supabase.auth.getUser();

        if (error || !data || !data.user) {
          const offline = isLikelyOfflineErrorHistory(error);
          if (!silent) {
            if (offline) {
              showFullHistoryError(
                "No internet connection or bad network. We’ll refresh automatically when you reconnect."
              );
            } else {
              showFullHistoryError(
                "Could not verify your account right now. Please try again or sign in again from the main screen."
              );
            }
            setFullHistoryStats("0 items");
          }
          return;
        }
        user = data.user;
      } catch (e) {
        console.error(e);
        const offline = isLikelyOfflineErrorHistory(e);
        if (!silent) {
          if (offline) {
            showFullHistoryError(
              "No internet connection or bad network. We’ll refresh automatically when you reconnect."
            );
          } else {
            showFullHistoryError(
              "Could not check your account right now. Please try again or sign in again from the main screen."
            );
          }
          setFullHistoryStats("0 items");
        }
        return;
      }

      try {
        const { data: classes, error: classError } = await supabase
          .from("courses")
          .select(`
            id,
            course_code,
            course_title,
            creator_name,
            invite_code,
            academic_session,
            created_at,
            allowed_departments,
            allowed_levels,
            allowed_department_levels
          `)
          .eq("created_by", user.id)
          .order("created_at", { ascending: false });

        if (classError) {
          console.error(classError);
          if (!silent) {
            showFullHistoryError("Could not load class history. Please try again.");
          }
          fullHistoryClasses = [];
        } else if (!classes || classes.length === 0) {
          fullHistoryClasses = [];
        } else {
          const classIds = classes.map((c) => c.id);

          const { data: memberships, error: memError } = await supabase
            .from("course_memberships")
            .select("course_id")
            .in("course_id", classIds);

          if (memError && !silent) {
            console.error(memError);
            showFullHistoryError(
              "Could not load joined students count. Please try again."
            );
          }

          const countMap = {};
          (memberships || []).forEach((row) => {
            countMap[row.course_id] = (countMap[row.course_id] || 0) + 1;
          });

          fullHistoryClasses = classes.map((course) => ({
            course,
            memberCount: countMap[course.id] || 0
          }));
        }
      } catch (e) {
        console.error(e);
        if (!silent) {
          showFullHistoryError("Unexpected error while loading class history.");
        }
        fullHistoryClasses = [];
      }

      try {
        const { data: scans, error: scansError } = await supabase
          .from("scan_sheets")
          .select("id, title, created_at, status, s3_object_key, result_json")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false })
          .limit(50);

        if (scansError) {
          console.error(scansError);
          scanHistoryItems = [];
        } else {
          scanHistoryItems = scans || [];
        }
      } catch (e) {
        console.error(e);
        scanHistoryItems = [];
      }

      schoolAnnouncementItems = await loadSchoolAnnouncementsForHistory(user);
      reportHistoryItems = await loadReportHistoryForHistory(user);

      rebuildCombinedHistory();
      updateFullHistoryStatsSummary();

      const emptyElVisible = !combinedHistoryFiltered.length;
      if (emptyElVisible) {
        emptyEl.style.display = "block";
      } else {
        emptyEl.style.display = "none";
        renderFullHistoryList();
        if (silent) {
          window.scrollTo(0, previousScrollY);
        }
      }
    } finally {
      loadFullHistory._loading = false;
    }
  }

  function updateFullHistoryStatsSummary() {
    const totalItems = combinedHistoryItems.length;
    const totalClasses = fullHistoryClasses.length;
    const totalAnnouncements = schoolAnnouncementItems.length;
    const totalReports = reportHistoryItems.length;
    setFullHistoryStats(
      `${totalItems} items • ${totalClasses} classes • ${totalAnnouncements} announcements • ${totalReports} reports`
    );
  }

  function applyFullHistorySearchFilter() {
    const searchInput = document.getElementById("fullHistorySearch");
    if (!searchInput) return;

    const query = searchInput.value.trim().toLowerCase();
    if (!query) {
      combinedHistoryFiltered = combinedHistoryItems.slice();
      renderFullHistoryList();
      return;
    }

    combinedHistoryFiltered = combinedHistoryItems.filter((item) => {
      if (item.type === "student") {
        const e = item.entry;
        const course = (e.course_code || "").toLowerCase();
        const lecturer = (e.lecturer_name || "").toLowerCase();
        return course.includes(query) || lecturer.includes(query);
      } else if (item.type === "class") {
        const c = item.course;
        const code = (c.course_code || "").toLowerCase();
        const title = (c.course_title || "").toLowerCase();
        const invite = (c.invite_code || "").toLowerCase();
        const creator = (c.creator_name || "").toLowerCase();
        return (
          code.includes(query) ||
          title.includes(query) ||
          invite.includes(query) ||
          creator.includes(query)
        );
      } else if (item.type === "announcement") {
        const ann = item.announcement;
        const title = (ann.title || "").toLowerCase();
        const message = (ann.message || "").toLowerCase();
        return title.includes(query) || message.includes(query);
      } else if (item.type === "report") {
        const report = item.report;
        const title = (report.title || "").toLowerCase();
        const category = (report.category || "").toLowerCase();
        const message = (report.message || "").toLowerCase();
        const code = (report.tracking_code || "").toLowerCase();
        const status = (report.status || "").toLowerCase();
        return (
          title.includes(query) ||
          category.includes(query) ||
          message.includes(query) ||
          code.includes(query) ||
          status.includes(query)
        );
      } else {
        const scan = item.scan;
        const title = (scan.title || "").toLowerCase();
        return title.includes(query);
      }
    });

    renderFullHistoryList();
  }

  function openReportDetails(report) {
    try {
      localStorage.setItem("colspot_selected_report_id", report.id);
      localStorage.setItem("colspot_selected_report_tracking_code", report.tracking_code || "");
    } catch (e) {
      console.error("Failed to save selected report:", e);
    }
    window.location.href = "report_details.html";
  }

  function renderFullHistoryList() {
    const listEl = document.getElementById("fullHistoryList");
    const emptyEl = document.getElementById("fullHistoryEmpty");
    if (!listEl || !emptyEl) return;

    listEl.innerHTML = "";

    if (!combinedHistoryFiltered.length) {
      emptyEl.style.display = "block";
      return;
    }

    emptyEl.style.display = "none";

    combinedHistoryFiltered.forEach((item) => {
      if (item.type === "student") {
        const entry = item.entry;

        const card = document.createElement("div");
        card.className = "history-card";

        const left = document.createElement("div");
        left.className = "history-left";

        const icon = document.createElement("div");
        icon.className = "history-icon";
        icon.innerHTML = `
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
            <line x1="9" y1="3" x2="9" y2="7"></line>
            <line x1="15" y1="3" x2="15" y2="7"></line>
            <line x1="4" y1="11" x2="20" y2="11"></line>
          </svg>
        `;

        const texts = document.createElement("div");
        texts.className = "history-texts";

        const title = document.createElement("div");
        title.className = "history-title";
        title.textContent = entry.course_code || "Attendance";

        const sub = document.createElement("div");
        sub.className = "history-sub";
        sub.textContent =
          entry.lecturer_name ||
          entry.course_title ||
          "Submitted attendance";

        const meta = document.createElement("div");
        meta.className = "history-meta-row";
        const datePart = formatHistoryDateShort(entry.attended_at);
        const timePart = formatHistoryTimeShort(entry.attended_at);
        meta.textContent =
          datePart && timePart ? `${datePart} · ${timePart}` : datePart || "";

        texts.appendChild(title);
        texts.appendChild(sub);
        texts.appendChild(meta);

        left.appendChild(icon);
        left.appendChild(texts);

        const right = document.createElement("div");
        right.className = "history-right";

        const status = document.createElement("div");
        status.className = "status-chip";
        status.textContent = entry.status || "Attended";

        right.appendChild(status);

        card.appendChild(left);
        card.appendChild(right);

        card.addEventListener("click", () => openStudentHistoryDetail(entry));

        listEl.appendChild(card);
      } else if (item.type === "class") {
        const { course, memberCount } = item;

        const card = document.createElement("div");
        card.className = "history-card";

        const left = document.createElement("div");
        left.className = "history-left";

        const icon = document.createElement("div");
        icon.className = "history-icon";
        icon.innerHTML = `
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16"></path>
            <path d="M6 7v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7"></path>
            <path d="M9 11h6"></path>
            <path d="M9 14h6"></path>
          </svg>
        `;

        const texts = document.createElement("div");
        texts.className = "history-texts";

        const title = document.createElement("div");
        title.className = "history-title";
        title.textContent = course.course_code || "Created class";

        const sub = document.createElement("div");
        sub.className = "history-sub";
        sub.textContent =
          course.course_title ||
          course.creator_name ||
          "Class code created";

        const meta = document.createElement("div");
        meta.className = "history-meta-row";
        const createdDate = formatHistoryDateShort(course.created_at);
        const createdTime = formatHistoryTimeShort(course.created_at);
        meta.textContent =
          createdDate && createdTime
            ? `${createdDate} · ${createdTime} · Code: ${course.invite_code || "—"}`
            : `Code: ${course.invite_code || "—"}`;

        texts.appendChild(title);
        texts.appendChild(sub);
        texts.appendChild(meta);

        left.appendChild(icon);
        left.appendChild(texts);

        const right = document.createElement("div");
        right.className = "history-right";

        const status = document.createElement("div");
        status.className = "status-chip class";
        status.textContent = "Class";

        const countText = document.createElement("div");
        countText.className = "count-text";
        countText.textContent = `${memberCount} joined`;

        right.appendChild(status);
        right.appendChild(countText);

        card.appendChild(left);
        card.appendChild(right);

        card.addEventListener("click", () => {
          window.location.href = `class-live.html?course_id=${course.id}`;
        });

        listEl.appendChild(card);
      } else if (item.type === "announcement") {
        const ann = item.announcement;

        const card = document.createElement("div");
        card.className = "history-card";

        const left = document.createElement("div");
        left.className = "history-left";

        const icon = document.createElement("div");
        icon.className = "history-icon";
        icon.innerHTML = `
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 2L11 13"></path>
            <path d="M22 2L15 22l-4-9-9-4 20-7z"></path>
          </svg>
        `;

        const texts = document.createElement("div");
        texts.className = "history-texts";

        const title = document.createElement("div");
        title.className = "history-title";
        title.textContent = ann.title || "Announcement";

        const sub = document.createElement("div");
        sub.className = "history-sub";
        sub.textContent = ann.message || "";

        const meta = document.createElement("div");
        meta.className = "history-meta-row";
        const datePart = formatHistoryDateShort(ann.created_at);
        const timePart = formatHistoryTimeShort(ann.created_at);
        meta.textContent =
          datePart && timePart ? `${datePart} · ${timePart}` : datePart || "";

        texts.appendChild(title);
        texts.appendChild(sub);
        texts.appendChild(meta);

        left.appendChild(icon);
        left.appendChild(texts);

        const right = document.createElement("div");
        right.className = "history-right";

        const status = document.createElement("div");
        status.className = "status-chip announcement";
        status.textContent = "School";

        right.appendChild(status);

        card.appendChild(left);
        card.appendChild(right);

        listEl.appendChild(card);
      } else if (item.type === "report") {
        const report = item.report;

        const card = document.createElement("div");
        card.className = "history-card";

        const left = document.createElement("div");
        left.className = "history-left";

        const icon = document.createElement("div");
        icon.className = "history-icon";
        icon.innerHTML = `
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.7-2.9 8.6-7 10-4.1-1.4-7-5.3-7-10V6l7-3z"></path>
            <path d="M9.5 12.3l1.7 1.7 3.6-4"></path>
          </svg>
        `;

        const texts = document.createElement("div");
        texts.className = "history-texts";

        const title = document.createElement("div");
        title.className = "history-title";
        title.textContent = report.title || report.category || "Report";

        const sub = document.createElement("div");
        sub.className = "history-sub";
        sub.textContent = report.message || "";

        const meta = document.createElement("div");
        meta.className = "history-meta-row";
        const datePart = formatHistoryDateShort(report.created_at);
        const timePart = formatHistoryTimeShort(report.created_at);
        meta.textContent =
          datePart && timePart
            ? `${datePart} · ${timePart} · ${report.tracking_code || ""}`
            : report.tracking_code || "";

        texts.appendChild(title);
        texts.appendChild(sub);
        texts.appendChild(meta);

        left.appendChild(icon);
        left.appendChild(texts);

        const right = document.createElement("div");
        right.className = "history-right";

        const statusEl = document.createElement("div");
        statusEl.className = `status-chip report ${report.status || "new"}`;
        statusEl.textContent = report.status || "new";

        right.appendChild(statusEl);

        card.appendChild(left);
        card.appendChild(right);

        card.addEventListener("click", () => openReportDetails(report));

        listEl.appendChild(card);
      } else {
        const scan = item.scan;

        const card = document.createElement("div");
        card.className = "history-card";

        const left = document.createElement("div");
        left.className = "history-left";

        const icon = document.createElement("div");
        icon.className = "history-icon";
        icon.textContent = "📄";

        const texts = document.createElement("div");
        texts.className = "history-texts";

        const title = document.createElement("div");
        title.className = "history-title";
        title.textContent = scan.title || "Scanned sheet";

        const sub = document.createElement("div");
        sub.className = "history-sub";
        sub.textContent = "Scanned sheet";

        const meta = document.createElement("div");
        meta.className = "history-meta-row";
        const datePart = formatHistoryDateShort(scan.created_at);
        const timePart = formatHistoryTimeShort(scan.created_at);
        meta.textContent =
          datePart && timePart ? `${datePart} · ${timePart}` : datePart || "";

        texts.appendChild(title);
        texts.appendChild(sub);
        texts.appendChild(meta);

        left.appendChild(icon);
        left.appendChild(texts);

        const right = document.createElement("div");
        right.className = "history-right";

        const statusEl = document.createElement("div");
        statusEl.className = "status-chip scan";
        statusEl.textContent =
          scan.status === "completed"
            ? "Ready to download"
            : (scan.status || "Processing");

        const downloadBtn = document.createElement("button");
        downloadBtn.type = "button";
        downloadBtn.className = "download-btn";
        downloadBtn.textContent = "Download";

        if (scan.status !== "completed") {
          downloadBtn.disabled = true;
          downloadBtn.style.opacity = "0.6";
        } else {
          downloadBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const url = buildScanDownloadUrl(scan);
            if (!url) {
              alert("File not available yet. Please try again later.");
              return;
            }
            const filename = scan.title || "scan";
            openScanDownload(url, filename);
          });
        }

        right.appendChild(statusEl);
        right.appendChild(downloadBtn);

        card.appendChild(left);
        card.appendChild(right);

        listEl.appendChild(card);
      }
    });
  }

  async function downloadFullHistoryCsv() {
    if (!combinedHistoryItems.length) {
      alert("No history to export yet.");
      return;
    }

    const header = [
      "Type",
      "Title",
      "Subtitle",
      "Created at",
      "Extra"
    ];

    const esc = (v) => `"${String(v).replace(/"/g, '""')}"`;

    const rows = combinedHistoryItems.map((item) => {
      if (item.type === "student") {
        const e = item.entry;
        return [
          "Student attendance",
          e.course_code || "",
          e.lecturer_name || "",
          e.attended_at || "",
          e.student_matric || ""
        ].map(esc).join(",");
      }

      if (item.type === "class") {
        const c = item.course;
        return [
          "Created class",
          c.course_code || "",
          c.course_title || "",
          c.created_at || "",
          c.invite_code || ""
        ].map(esc).join(",");
      }

      if (item.type === "announcement") {
        const a = item.announcement;
        return [
          "School announcement",
          a.title || "",
          a.message || "",
          a.created_at || "",
          a.school_name || ""
        ].map(esc).join(",");
      }

      if (item.type === "report") {
        const r = item.report;
        return [
          "Student report",
          r.title || r.category || "",
          r.message || "",
          r.created_at || "",
          r.status || ""
        ].map(esc).join(",");
      }

      const s = item.scan;
      return [
        "Scan sheet",
        s.title || "",
        s.status || "",
        s.created_at || "",
        s.s3_object_key || ""
      ].map(esc).join(",");
    });

    const csv = [header.join(","), ...rows].join("\n");
    const filename = "colspot_full_history.csv";

    const Cap = window.Capacitor;
    const isNative = !!Cap && !!Cap.isNativePlatform;
    const Filesystem = Cap?.Plugins?.Filesystem;
    const Share = Cap?.Plugins?.Share;

    try {
      if (isNative && Filesystem) {
        const Directory = Filesystem.Directory || Filesystem?.Directory;
        const Encoding = Filesystem.Encoding || Filesystem?.Encoding;

        const writeRes = await Filesystem.writeFile({
          path: filename,
          data: csv,
          directory: Directory ? Directory.Documents : "DOCUMENTS",
          encoding: Encoding ? Encoding.UTF8 : "utf8",
        });

        if (Share && writeRes && writeRes.uri) {
          await Share.share({
            title: "Colspot Full History CSV",
            text: "Full history export",
            url: writeRes.uri,
            dialogTitle: "Share / Save CSV",
          });
          return;
        }

        alert(
          "CSV saved. Open your Files app / Documents and look for: " +
            filename
        );
        return;
      }

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    } catch (err) {
      console.error("downloadFullHistoryCsv error", err);
      alert("Could not start CSV download. Please try again.");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    loadStudentHistoryFromCache();
    loadFullHistory({ silent: false });

    setInterval(() => {
      const scr = document.getElementById("screen-history");
      if (!scr || !scr.classList.contains("active")) return;
      if (isHistoryOffline()) return;
      loadFullHistory({ silent: true });
    }, HISTORY_REFRESH_INTERVAL_MS);

    const closeBtn = document.getElementById("studentHistoryClose");
    const backdrop = document.querySelector(
      "#studentHistoryModal .student-history-backdrop"
    );
    if (closeBtn) closeBtn.addEventListener("click", closeStudentHistoryModal);
    if (backdrop) backdrop.addEventListener("click", closeStudentHistoryModal);

    const searchInput = document.getElementById("fullHistorySearch");
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        applyFullHistorySearchFilter();
      });
    }
  });
</script>
