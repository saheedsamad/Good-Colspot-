      color:var(--text-muted);
      margin-bottom:5px;
      font-weight:800;
    }

    #screen-classes .step-title{
      font-size:14px;
      font-weight:900;
      color:var(--text-main);
      margin-bottom:3px;
    }

    #screen-classes .step-note{
      font-size:12px;
      color:var(--text-muted);
      line-height:1.45;
    }

    #screen-classes .row{
      margin-bottom:12px;
    }

    #screen-classes .label{
      font-size:12px;
      color:#475569;
      font-weight:800;
      margin:0 0 7px;
      letter-spacing:.01em;
      display:block;
    }

    #screen-classes .input,
    #screen-classes .textarea{
      width:100%;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:13px 14px;
      font-size:16px;
      outline:none;
      background:#fff;
      color:var(--text-main);
      box-shadow:0 6px 16px rgba(15,23,42,.03);
      transition:.18s ease;
    }

    #screen-classes .textarea{
      min-height:100px;
      resize:vertical;
    }

    #screen-classes .input:focus,
    #screen-classes .textarea:focus{
      border-color:var(--blue);
      box-shadow:0 0 0 4px rgba(37,99,235,.12);
    }

    #screen-classes .grid-2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    #screen-classes .type-grid{
      display:grid;
      grid-template-columns:1fr 1fr 1fr;
      gap:10px;
      margin-top:4px;
    }

    #screen-classes .type-btn{
      border:1px solid #dbeafe;
      background:#fff;
      color:var(--text-main);
      border-radius:18px;
      padding:14px 10px;
