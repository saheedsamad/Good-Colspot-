<!-- 🔹 CLASSES SCREEN START -->
<div id="screen-classes" class="screen">
  <style>
    #screen-classes{
      padding:8px 6px 90px;
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
    }

    #screen-classes .hero{
      padding:4px 4px 6px;
      margin-bottom:6px;
    }

    #screen-classes .hero-line-1{
