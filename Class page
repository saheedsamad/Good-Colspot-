    }

    #screen-classes .message.error{
      color:#991b1b;
      background:#fef2f2;
      border:1px solid rgba(239,68,68,.16);
    }

    #screen-classes .message.success{
      color:#166534;
      background:#ecfdf5;
      border:1px solid rgba(22,163,74,.16);
    }

    #screen-classes .quick-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-bottom:10px;
    }

    #screen-classes .quick-card{
      border-radius:16px;
      padding:12px;
      border:1px solid #e5e7eb;
      background:#fff;
      box-shadow:0 10px 30px rgba(15,23,42,.06);
      cursor:pointer;
    }

    #screen-classes .quick-card.primary{
      background:#eff6ff;
      border-color:#dbeafe;
    }

    #screen-classes .quick-icon{
      width:36px;
      height:36px;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      margin-bottom:10px;
    }

    #screen-classes .quick-icon.blue{
      background:#dbeafe;
      color:#2563eb;
    }

    #screen-classes .quick-icon.purple{
      background:#ede9fe;
      color:#4f46e5;
    }

    #screen-classes .quick-icon svg{
      width:18px;
      height:18px;
      stroke:currentColor;
      fill:none;
      stroke-width:1.8;
    }

    #screen-classes .quick-title{
      font-size:13px;
      font-weight:800;
      color:var(--text-main);
      margin-bottom:4px;
    }

    #screen-classes .quick-note{
      font-size:11px;
      color:var(--text-muted);
      line-height:1.35;
    }

    #screen-classes .step-strip{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-bottom:12px;
    }

    #screen-classes .step-card{
      border-radius:18px;
      border:1px solid #dbeafe;
      background:#ffffff;
      padding:12px;
      box-shadow:0 8px 22px rgba(37,99,235,.08);
    }

    #screen-classes .step-card.active{
