    #screen-classes .hint{
      font-size:12px;
      color:var(--text-muted);
      line-height:1.45;
      margin-top:8px;
    }

    #screen-classes .hidden{
      display:none !important;
    }

    @media (max-width:360px){
      #screen-classes .quick-grid,
      #screen-classes .type-grid,
      #screen-classes .grid-2,
      #screen-classes .correct-grid,
      #screen-classes .saved-options{
        grid-template-columns:1fr;
      }

