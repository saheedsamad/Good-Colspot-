      font-weight:900;
      color:var(--blue);
      margin-bottom:4px;
    }

    #screen-classes .saved-q-text{
      font-size:14px;
      font-weight:800;
      color:var(--text-main);
      line-height:1.4;
    }

    #screen-classes .saved-points{
      font-size:11px;
      font-weight:800;
      color:#475569;
      background:#f8fafc;
      border:1px solid #e5e7eb;
      border-radius:999px;
      padding:6px 10px;
      white-space:nowrap;
    }

    #screen-classes .saved-options{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      margin-top:8px;
    }

    #screen-classes .saved-option{
      border-radius:14px;
      background:#f8fafc;
      border:1px solid #e2e8f0;
