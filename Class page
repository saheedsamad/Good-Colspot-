  </style>

  <section class="hero">
    <div class="hero-line-1" id="classesHeroLine">Classes</div>
    <h1 class="hero-title" id="classesHeroTitle">
      Manage your <span>classes</span>
    </h1>
    <p class="hero-sub" id="classesHeroSub">
      Create classes, manage them, and build assignments, revision, or tests.
    </p>
  </section>

  <section id="classesMainPanel">
    <div class="section-title">Quick actions</div>
    <div class="quick-grid">
      <button class="quick-card primary" type="button" onclick="openCreateClassPageFromClasses()">
        <div class="quick-icon blue">
          <svg viewBox="0 0 20 20">
            <path d="M10 4v12M4 10h12" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="quick-title">Create class</div>
        <div class="quick-note">Start a new class</div>
      </button>

      <button class="quick-card" type="button" onclick="openActivityBuilderFromClasses()">
        <div class="quick-icon purple">
          <svg viewBox="0 0 20 20">
            <rect x="4.5" y="3.5" width="11" height="13" rx="1.4"></rect>
            <path d="M7 7h6M7 10h6M7 13h4" stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="quick-title">Create activity</div>
        <div class="quick-note">Assignment, revision, or test</div>
      </button>
    </div>

    <div class="section-title">My classes</div>
    <div class="section-sub">Search and select a class to edit or use for activities.</div>

    <div class="card">
      <div class="search-row">
        <input
          id="classesSearchInput"
          type="text"
          class="search-input"
          placeholder="Search by course code, title or session…"
        />
      </div>

      <div id="classesList" class="recent-list"></div>

      <button class="secondary-btn" type="button" onclick="reloadClassesScreenData()">
        Refresh classes
      </button>
    </div>
  </section>

  <section id="activityBuilderPanel" class="hidden">
    <div class="step-strip">
      <div class="step-card active" id="activityStepCard1">
        <div class="step-label">Step 1</div>
        <div class="step-title">Activity setup</div>
        <div class="step-note">Choose type, class, title, time, due date, and attempts.</div>
      </div>
      <div class="step-card" id="activityStepCard2">
        <div class="step-label">Step 2</div>
        <div class="step-title">Add questions</div>
        <div class="step-note">Add one objective question at a time and choose the correct answer.</div>
      </div>
    </div>

    <div class="card">
      <div class="section-title">Activity details</div>

      <div class="row">
        <div class="label">Activity type</div>
        <div class="type-grid">
          <button class="type-btn active" type="button" data-type="assignment">
            <svg viewBox="0 0 24 24">
              <path d="M8 6h8M8 12h8M8 18h5"></path>
              <rect x="5" y="3" width="14" height="18" rx="2"></rect>
            </svg>
            <div class="type-btn-title">Assignment</div>
            <div class="type-btn-note">Take-home activity</div>
          </button>

          <button class="type-btn" type="button" data-type="revision">
            <svg viewBox="0 0 24 24">
              <path d="M12 6v6l4 2"></path>
              <circle cx="12" cy="12" r="8"></circle>
            </svg>
            <div class="type-btn-title">Revision</div>
            <div class="type-btn-note">Practice questions</div>
