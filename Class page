      margin:0 2px 8px;
      line-height:1.45;
    }

    #screen-classes .card{
      background:#f9fafb;
      border-radius:18px;
      padding:10px 10px;
      border:1px solid #e5e7eb;
      margin-bottom:14px;
      box-shadow:0 10px 30px rgba(15,23,42,.06);
    }

    #screen-classes .search-row{
      display:flex;
      gap:6px;
      margin-bottom:8px;
    }

    #screen-classes .search-input{
      flex:1;
      padding:10px 12px;
      border-radius:999px;
      border:1px solid #e5e7eb;
      font-size:16px;
