    }

    #screen-classes .recent-item-title{
      font-size:13px;
      font-weight:700;
      color:var(--text-main);
      padding-right:64px;
    }

    #screen-classes .recent-item-sub{
      font-size:11px;
      color:var(--text-muted);
      line-height:1.35;
