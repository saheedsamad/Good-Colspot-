  <section class="stats-grid">
    <article class="stat-card blue">
      <div class="stat-icon blue">
        <svg viewBox="0 0 20 20" fill="none">
          <rect x="4.5" y="3.5" width="11" height="13" rx="1.4" stroke="currentColor" stroke-width="1.4"/>
          <path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="stat-meta">
        <div class="stat-title">Total classes</div>
        <div class="stat-value" id="classesTotalValue">0</div>
      </div>
    </article>

    <article class="stat-card green">
      <div class="stat-icon green">
        <svg viewBox="0 0 20 20" fill="none">
          <path d="M13.5 16v-1.2a2.8 2.8 0 00-2.8-2.8H6.8A2.8 2.8 0 004 14.8V16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <circle cx="8.8" cy="7" r="2.7" stroke="currentColor" stroke-width="1.3"/>
