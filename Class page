  <section>
    <div id="lecturerClassesList" class="classes-list">
      <div class="empty-box">Loading your classes...</div>
    </div>
    <div id="classesMessage" class="classes-message error" style="display:none;"></div>
  </section>
</div>

<script>
  let lecturerClassesCache = [];

  function showClassesError(msg) {
    const el = document.getElementById("classesMessage");
    if (!el) return;
    el.textContent = msg;
    el.style.display = "block";
  }

  function clearClassesError() {
    const el = document.getElementById("classesMessage");
    if (!el) return;
    el.style.display = "none";
    el.textContent = "";
  }

  function escapeClassesHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function openCreateClass() {
    window.location.href = "create_class.html";
  }

  function openLecturerClass(classId) {
    if (!classId) return;
    window.location.href = "class_details.html?class_id=" + encodeURIComponent(classId);
  }

  function editLecturerClass(classId) {
    if (!classId) return;
    window.location.href = "create_class.html?edit=" + encodeURIComponent(classId);
  }

  function openClassAttendance(classId) {
    if (!classId) return;
    window.location.href = "attendance.html?class_id=" + encodeURIComponent(classId);
  }

  function openClassMenu(classId) {
    if (!classId) return;
    alert("More actions for this class will open here.");
  }

  function renderLecturerClasses(list = []) {
    const wrap = document.getElementById("lecturerClassesList");
    const totalEl = document.getElementById("classesTotalValue");
    const studentsEl = document.getElementById("classesStudentsValue");
    if (!wrap) return;

    if (totalEl) totalEl.textContent = String(list.length);

    const totalStudents = list.reduce((sum, item) => sum + Number(item.member_count || 0), 0);
    if (studentsEl) studentsEl.textContent = String(totalStudents);

    if (!list.length) {
      wrap.innerHTML = `<div class="empty-box">No class created yet.</div>`;
      return;
    }

    wrap.innerHTML = list.map((item) => {
      const badge = String(item.short_code || item.course_code || "CLS").slice(0, 3).toUpperCase();
      const courseCode = escapeClassesHtml(item.course_code || "Untitled class");
      const courseTitle = escapeClassesHtml(item.course_title || "No class title");
      const sessionName = escapeClassesHtml(item.academic_session || item.session_name || "Session not set");
      const deptName = escapeClassesHtml(item.department_name || "Department not set");
      const levelLabel = escapeClassesHtml(item.level_label || "");
      const memberCount = Number(item.member_count || 0);
      const inviteCode = escapeClassesHtml(item.invite_code || "—");
      const classId = String(item.id || "");

      return `
        <article class="class-card">
          <div class="class-top">
            <div class="class-badge">${badge}</div>

            <div class="class-main">
              <div class="class-code">${courseCode}</div>
              <div class="class-title">${courseTitle}</div>
              <div class="class-session">${sessionName}</div>

              <div class="class-meta-row">
                <div class="class-meta-left">
                  ${deptName}${levelLabel ? " | " + levelLabel : ""}
                </div>
                <div class="class-meta-right">${memberCount} members</div>
              </div>

              <div class="pill-row">
                <div class="pill">
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M6.8 8.2a2.3 2.3 0 100-4.6 2.3 2.3 0 000 4.6zM13.4 9.3a1.9 1.9 0 100-3.8 1.9 1.9 0 000 3.8zM3.5 14.9c0-2 1.8-3.6 4-3.6s4 1.6 4 3.6M11.1 14.9c.2-1.4 1.5-2.4 3.1-2.4 1.5 0 2.8 1 3 2.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  </svg>
                  <span>Invite code: ${inviteCode}</span>
                </div>

                <div class="pill">
                  <svg viewBox="0 0 20 20" fill="none">
                    <rect x="5" y="4" width="10" height="12" rx="1.6" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M7.5 8h5M7.5 11h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  </svg>
                  <span>${inviteCode}</span>
                </div>
              </div>

              <div class="actions-row">
                <button class="action-btn primary" type="button" onclick="openLecturerClass('${classId}')">Open</button>
                <button class="action-btn soft" type="button" onclick="editLecturerClass('${classId}')">Edit</button>
                <button class="action-btn soft" type="button" onclick="openClassAttendance('${classId}')">Attendance</button>
                <button class="action-btn icon" type="button" onclick="openClassMenu('${classId}')">
                  <svg viewBox="0 0 20 20" fill="none">
                    <circle cx="4" cy="10" r="1.4" fill="currentColor"/>
                    <circle cx="10" cy="10" r="1.4" fill="currentColor"/>
                    <circle cx="16" cy="10" r="1.4" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </article>
      `;
    }).join("");
  }

  function filterLecturerClasses(query = "") {
    const q = String(query || "").trim().toLowerCase();
    if (!q) {
      renderLecturerClasses(lecturerClassesCache);
      return;
    }

    const filtered = lecturerClassesCache.filter((item) => {
      return [
        item.course_code,
        item.course_title,
        item.department_name,
        item.academic_session,
        item.session_name,
        item.invite_code
      ]
        .map(v => String(v || "").toLowerCase())
        .some(v => v.includes(q));
    });

    renderLecturerClasses(filtered);
  }

  async function loadLecturerClasses() {
    clearClassesError();

    const wrap = document.getElementById("lecturerClassesList");
    if (wrap) {
      wrap.innerHTML = `<div class="empty-box">Loading your classes...</div>`;
    }

    try {
      if (typeof supabase === "undefined") {
        showClassesError("We couldn’t connect to the server. Please refresh and try again.");
        if (wrap) wrap.innerHTML = `<div class="empty-box">Could not load classes.</div>`;
        return;
      }

      const { data: userData, error: userError } = await supabase.auth.getUser();
      if (userError || !userData?.user) {
        showClassesError("Your session has expired. Please sign in again.");
        if (wrap) wrap.innerHTML = `<div class="empty-box">Could not load classes.</div>`;
        return;
      }

      const user = userData.user;

      const { data: classes, error: classesError } = await supabase
        .from("courses")
        .select("*")
        .eq("created_by", user.id)
        .order("created_at", { ascending: false });

      if (classesError) throw classesError;

      const rows = Array.isArray(classes) ? classes : [];
      if (!rows.length) {
        lecturerClassesCache = [];
        renderLecturerClasses([]);
        return;
      }

      const classIds = rows.map((r) => r.id).filter(Boolean);

      let memberships = [];
      if (classIds.length) {
        const { data: memberRows, error: memberError } = await supabase
          .from("course_memberships")
          .select("course_id")
          .in("course_id", classIds);

        if (!memberError && Array.isArray(memberRows)) {
          memberships = memberRows;
        }
      }

      const memberMap = {};
      memberships.forEach((m) => {
        const key = String(m.course_id || "");
        memberMap[key] = (memberMap[key] || 0) + 1;
      });

      lecturerClassesCache = rows.map((row) => {
        const code = String(row.course_code || "").trim();
        let shortCode = code.replace(/[^A-Za-z]/g, "").slice(0, 3).toUpperCase();
        if (!shortCode) shortCode = "CLS";

        return {
          ...row,
          short_code: shortCode,
          member_count: memberMap[String(row.id || "")] || 0
        };
      });

      renderLecturerClasses(lecturerClassesCache);
    } catch (err) {
      console.error("loadLecturerClasses failed:", err);
      showClassesError("We couldn’t load your classes right now. Please check your internet and try again.");
      if (wrap) {
        wrap.innerHTML = `<div class="empty-box">Could not load classes.</div>`;
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const classesSearchInput = document.getElementById("classesSearchInput");
    if (classesSearchInput) {
      classesSearchInput.addEventListener("input", (e) => {
        filterLecturerClasses(e.target.value);
      });
    }

    loadLecturerClasses();
  });
</script>
<!-- 🔹 CLASSES SCREEN END -->
