<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
  />
  <title>Colspot • My Classes</title>

  <style>
    :root{
      --blue:#2563eb;
      --blue2:#3b82f6;
      --blue-soft:#eef4ff;
      --bg:#f4f7ff;
      --card:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --line:#e5e7eb;
      --shadow:0 14px 34px rgba(15,23,42,.08);
      --shadow-soft:0 10px 24px rgba(37,99,235,.10);
      --radius:26px;
      --safe-top:env(safe-area-inset-top, 0px);
      --safe-bottom:env(safe-area-inset-bottom, 0px);
    }

    *{
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html,body{
      margin:0;
      min-height:100%;
      background:var(--bg);
      color:var(--text);
      font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
    }

    body{
      display:flex;
      justify-content:center;
    }

    body::-webkit-scrollbar{
      width:0;
      height:0;
      display:none;
    }

    button,input{
      font:inherit;
    }

    .app{
      width:100%;
      max-width:430px;
      min-height:100vh;
      padding:
        calc(16px + var(--safe-top))
        14px
        calc(110px + var(--safe-bottom));
      background:
        radial-gradient(circle at top, #fafdff 0%, #f4f7ff 45%, #eef4ff 100%);
    }

    .top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:16px;
    }

    .top-left h1{
      margin:0;
      font-size:28px;
      line-height:1.05;
      letter-spacing:-.03em;
      font-weight:900;
      color:#0f172a;
    }

    .top-left p{
      margin:10px 0 0;
      font-size:15px;
      color:var(--muted);
      line-height:1.5;
      max-width:250px;
    }

    .create-btn{
      border:none;
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      color:#fff;
      min-height:54px;
      padding:0 18px;
      border-radius:999px;
      font-size:16px;
      font-weight:800;
      display:inline-flex;
      align-items:center;
      gap:10px;
      box-shadow:0 14px 28px rgba(37,99,235,.22);
      cursor:pointer;
      white-space:nowrap;
      flex-shrink:0;
    }

    .create-btn svg{
      width:18px;
      height:18px;
      flex-shrink:0;
    }

    .stats{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:14px;
    }

    .stat-card{
      background:var(--card);
      border:1px solid #edf2fb;
      border-radius:24px;
      padding:14px 14px 16px;
      box-shadow:var(--shadow-soft);
      min-height:118px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .stat-top{
      display:flex;
      align-items:center;
      gap:10px;
      color:#475569;
      font-size:14px;
      font-weight:700;
    }

    .stat-icon{
      width:34px;
      height:34px;
      border-radius:12px;
      background:#edf4ff;
      display:flex;
      align-items:center;
      justify-content:center;
      color:var(--blue);
      flex-shrink:0;
    }

    .stat-icon.green{
      background:#ecfdf3;
      color:#16a34a;
    }

    .stat-icon svg{
      width:18px;
      height:18px;
    }

    .stat-value{
      font-size:24px;
      font-weight:900;
      color:#0f172a;
      padding-left:2px;
    }

    .search-wrap{
      position:relative;
      margin-bottom:16px;
    }

    .search-wrap svg{
      position:absolute;
      left:16px;
      top:50%;
      transform:translateY(-50%);
      width:22px;
      height:22px;
      color:#64748b;
      pointer-events:none;
    }

    .search-input{
      width:100%;
      height:58px;
      border-radius:999px;
      border:1px solid #e6edf9;
      background:#fff;
      padding:0 18px 0 52px;
      font-size:16px;
      color:#0f172a;
      outline:none;
      box-shadow:0 8px 20px rgba(15,23,42,.04);
    }

    .search-input::placeholder{
      color:#94a3b8;
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:10px;
    }

    .section-head h2{
      margin:0;
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#111827;
    }

    .small-note{
      font-size:13px;
      color:#64748b;
      font-weight:700;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .class-card{
      background:var(--card);
      border:1px solid #e9edf7;
      border-radius:30px;
      padding:16px;
      box-shadow:var(--shadow);
    }

    .class-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:8px;
    }

    .course-chip{
      min-width:60px;
      height:48px;
      border-radius:16px;
      background:#e8f0ff;
      color:#2563eb;
      font-size:16px;
      font-weight:900;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:0 12px;
      letter-spacing:.02em;
      flex-shrink:0;
    }

    .course-main{
      flex:1;
      min-width:0;
    }

    .course-code{
      font-size:18px;
      font-weight:900;
      letter-spacing:-.02em;
      color:#0f172a;
      margin:0;
    }

    .course-title{
      margin:6px 0 0;
      font-size:16px;
      line-height:1.35;
      font-weight:800;
      color:#0f172a;
    }

    .course-session{
      margin:10px 0 0;
      color:#6b7280;
      font-size:14px;
      font-weight:700;
    }

    .members{
      flex-shrink:0;
      align-self:center;
      font-size:15px;
      font-weight:900;
      color:#111827;
      white-space:nowrap;
      margin-top:8px;
    }

    .course-meta{
      margin-top:12px;
      color:#4b5563;
      font-size:14px;
      line-height:1.45;
      font-weight:700;
    }

    .pill-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:12px;
    }

    .pill{
      min-height:38px;
      border-radius:999px;
      background:#f4f7ff;
      color:#64748b;
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:0 14px;
      font-size:13px;
      font-weight:800;
      border:1px solid #edf2fb;
      max-width:100%;
    }

    .pill svg{
      width:15px;
      height:15px;
      flex-shrink:0;
    }

    .pill span{
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .action-row{
      margin-top:16px;
      display:grid;
      grid-template-columns:1fr 1fr 1.1fr auto;
      gap:10px;
    }

    .action-btn{
      min-height:48px;
      border:none;
      border-radius:999px;
      font-size:15px;
      font-weight:800;
      cursor:pointer;
      background:#edf4ff;
      color:#1f3b8a;
    }

    .action-btn.primary{
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      color:#fff;
      box-shadow:0 10px 24px rgba(37,99,235,.22);
    }

    .action-btn.more{
      width:54px;
      padding:0;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#edf4ff;
      color:#64748b;
    }

    .action-btn.more svg{
      width:20px;
      height:20px;
    }

    .empty{
      background:#fff;
      border:1px solid #e9edf7;
      border-radius:30px;
      padding:28px 18px;
      text-align:center;
      box-shadow:var(--shadow);
    }

    .empty h3{
      margin:0;
      font-size:20px;
      font-weight:900;
      color:#0f172a;
    }

    .empty p{
      margin:10px auto 0;
      max-width:280px;
      line-height:1.55;
      color:#6b7280;
      font-size:14px;
      font-weight:600;
    }

    .empty .create-btn{
      margin-top:16px;
    }

    .loading,
    .error-box{
      background:#fff;
      border-radius:24px;
      padding:16px;
      border:1px solid #e9edf7;
      box-shadow:var(--shadow-soft);
      font-size:14px;
      line-height:1.55;
      font-weight:700;
    }

    .error-box{
      color:#b91c1c;
      background:#fff5f5;
      border-color:#fecaca;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:calc(14px + var(--safe-bottom));
      width:min(402px, calc(100% - 20px));
      background:rgba(255,255,255,.95);
      backdrop-filter:blur(14px);
      border:1px solid rgba(226,232,240,.9);
      border-radius:28px;
      box-shadow:0 18px 40px rgba(15,23,42,.12);
      display:grid;
      grid-template-columns:repeat(4,1fr);
      padding:10px 8px;
      z-index:100;
    }

    .nav-item{
      border:none;
      background:transparent;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:6px;
      color:#9ca3af;
      font-size:12px;
      font-weight:700;
      padding:8px 4px;
      border-radius:18px;
      cursor:pointer;
    }

    .nav-item svg{
      width:22px;
      height:22px;
    }

    .nav-item.active{
      color:var(--blue);
    }

    @media (max-width:390px){
      .top{
        flex-direction:column;
        align-items:stretch;
      }

      .create-btn{
        width:100%;
        justify-content:center;
      }

      .action-row{
        grid-template-columns:1fr 1fr;
      }

      .action-btn.more{
        width:100%;
      }

      .members{
        font-size:14px;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="top">
      <div class="top-left">
        <h1>My Classes</h1>
        <p>Manage your classes, members, and attendance</p>
      </div>

      <button class="create-btn" id="createClassBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        Create class
      </button>
    </div>

    <div class="stats">
      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M8 7h8M8 11h8M8 15h5M7 3h10a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>Total classes</span>
        </div>
        <div class="stat-value" id="totalClasses">0</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon green">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6M23 11h-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>Total students</span>
        </div>
        <div class="stat-value" id="totalStudents">0</div>
      </div>
    </div>

    <div class="search-wrap">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M21 21l-4.35-4.35M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        id="searchInput"
        class="search-input"
        type="text"
        placeholder="Search by course code or title"
      />
    </div>

    <div class="section-head">
      <h2>Your classes</h2>
      <div class="small-note" id="classCountLabel">0 classes</div>
    </div>

    <div id="loadingBox" class="loading">Loading your classes...</div>
    <div id="errorBox" class="error-box" style="display:none;"></div>
    <div id="emptyState" class="empty" style="display:none;">
      <h3>No classes yet</h3>
      <p>Create your first class to start managing attendance and students.</p>
      <button class="create-btn" id="emptyCreateBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        Create class
      </button>
    </div>

    <div id="classList" class="list" style="display:none;"></div>
  </div>

  <nav class="bottom-nav">
    <button class="nav-item" onclick="window.location.href='main.html'">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      </svg>
      <span>Home</span>
    </button>

    <button class="nav-item active">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v13.5A2.5 2.5 0 0 0 17.5 15H4V6.5ZM4 15v2.5A2.5 2.5 0 0 0 6.5 20H20" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      </svg>
      <span>Classes</span>
    </button>

    <button class="nav-item" onclick="window.location.href='history.html'">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M3 12a9 9 0 1 0 3-6.708M3 4v5h5M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>History</span>
    </button>

    <button class="nav-item" onclick="window.location.href='report.html'">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 19h16M7 16V9M12 16V5M17 16v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Reports</span>
    </button>
  </nav>

  <script type="module" src="./client_supabase.js"></script>

  <script>
    const classListEl = document.getElementById("classList");
    const loadingBox = document.getElementById("loadingBox");
    const errorBox = document.getElementById("errorBox");
    const emptyState = document.getElementById("emptyState");
    const totalClassesEl = document.getElementById("totalClasses");
    const totalStudentsEl = document.getElementById("totalStudents");
    const classCountLabel = document.getElementById("classCountLabel");
    const searchInput = document.getElementById("searchInput");
    const createClassBtn = document.getElementById("createClassBtn");
    const emptyCreateBtn = document.getElementById("emptyCreateBtn");

    let allClasses = [];
    let membershipCountMap = {};

    function norm(value){
      return String(value || "").trim();
    }

    function escapeHtml(value){
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function shortCode(value){
      const txt = norm(value).toUpperCase();
      if (!txt) return "CLS";
      const first = txt.split(/\s+/)[0] || txt;
      return first.slice(0, 3);
    }

    function formatPrograms(course){
      const programs = Array.isArray(course.allowed_programs) ? course.allowed_programs : [];
      if (!programs.length) return "All programmes";
      return programs.join(", ");
    }

    function extractLevelsFromProgramLevels(input){
      if (!Array.isArray(input)) return [];
      const set = new Set();

      for (const item of input) {
        const levels = Array.isArray(item?.levels) ? item.levels : [];
        levels.forEach((lv) => {
          const n = Number(lv);
          if (Number.isFinite(n)) set.add(n);
        });
      }

      return [...set].sort((a, b) => a - b);
    }

    function formatLevels(course){
      let levels = [];

      if (Array.isArray(course.allowed_levels) && course.allowed_levels.length) {
        levels = course.allowed_levels
          .map((v) => Number(v))
          .filter((v) => Number.isFinite(v))
          .sort((a, b) => a - b);
      } else if (Array.isArray(course.allowed_program_levels) && course.allowed_program_levels.length) {
        levels = extractLevelsFromProgramLevels(course.allowed_program_levels);
      }

      if (!levels.length) return "All levels";
      return levels.join(", ");
    }

    function getMemberCount(courseId){
      return Number(membershipCountMap[courseId] || 0);
    }

    function setStats(classes){
      totalClassesEl.textContent = String(classes.length);

      const totalStudents = classes.reduce((sum, row) => {
        return sum + getMemberCount(row.id);
      }, 0);

      totalStudentsEl.textContent = String(totalStudents);
      classCountLabel.textContent = `${classes.length} ${classes.length === 1 ? "class" : "classes"}`;
    }

    function goToCreateClass(){
      window.location.href = "create_class.html";
    }

    function goToClassDetails(courseId){
      if (!courseId) return;
      window.location.href = `class_details.html?course_id=${encodeURIComponent(courseId)}`;
    }

    function goToEditClass(courseId){
      if (!courseId) return;
      window.location.href = `edit_class.html?course_id=${encodeURIComponent(courseId)}`;
    }

    function goToAttendance(courseId){
      if (!courseId) return;
      window.location.href = `create_attendance.html?course_id=${encodeURIComponent(courseId)}`;
    }

    function showMoreMenu(courseId, inviteCode){
      const lines = [
        "Class options",
        "",
        `Course ID: ${courseId || "—"}`,
        `Invite code: ${inviteCode || "—"}`
      ];
      alert(lines.join("\n"));
    }

    function renderClasses(rows){
      const q = norm(searchInput.value).toLowerCase();

      const filtered = rows.filter((row) => {
        if (!q) return true;
        const bag = [
          row.course_code,
          row.course_title,
          row.academic_session,
          formatPrograms(row),
          formatLevels(row),
          row.invite_code
        ].join(" ").toLowerCase();

        return bag.includes(q);
      });

      setStats(rows);

      if (!rows.length) {
        loadingBox.style.display = "none";
        errorBox.style.display = "none";
        emptyState.style.display = "block";
        classListEl.style.display = "none";
        return;
      }

      if (!filtered.length) {
        loadingBox.style.display = "none";
        errorBox.style.display = "none";
        emptyState.style.display = "none";
        classListEl.style.display = "block";
        classListEl.innerHTML = `
          <div class="empty">
            <h3>No matching class</h3>
            <p>Try another search by course code or title.</p>
          </div>
        `;
        return;
      }

      classListEl.innerHTML = filtered.map((row) => {
        const memberCount = getMemberCount(row.id);
        const courseCode = norm(row.course_code);
        const courseTitle = norm(row.course_title) || "Untitled class";
        const session = norm(row.academic_session) || "Session not set";
        const programs = formatPrograms(row);
        const levels = formatLevels(row);
        const inviteCode = norm(row.invite_code) || "No invite code";

        return `
          <div class="class-card">
            <div class="class-top">
              <div class="course-chip">${escapeHtml(shortCode(courseCode))}</div>

              <div class="course-main">
                <h3 class="course-code">${escapeHtml(courseCode || "CLASS")}</h3>
                <div class="course-title">${escapeHtml(courseTitle)}</div>
                <div class="course-session">${escapeHtml(session)} Session</div>
              </div>

              <div class="members">${memberCount} ${memberCount === 1 ? "member" : "members"}</div>
            </div>

            <div class="course-meta">
              ${escapeHtml(programs)} | ${escapeHtml(levels)}
            </div>

            <div class="pill-row">
              <div class="pill">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 13a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 19a5 5 0 0 1 10 0M13.5 19a4.5 4.5 0 0 1 7.5-3.354" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Invite code: ${escapeHtml(inviteCode)}</span>
              </div>
            </div>

            <div class="action-row">
              <button class="action-btn primary" onclick="goToClassDetails('${escapeHtml(row.id)}')">Open</button>
              <button class="action-btn" onclick="goToEditClass('${escapeHtml(row.id)}')">Edit</button>
              <button class="action-btn" onclick="goToAttendance('${escapeHtml(row.id)}')">Attendance</button>
              <button class="action-btn more" onclick="showMoreMenu('${escapeHtml(row.id)}','${escapeHtml(inviteCode)}')">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="5" cy="12" r="1.8" fill="currentColor"/>
                  <circle cx="12" cy="12" r="1.8" fill="currentColor"/>
                  <circle cx="19" cy="12" r="1.8" fill="currentColor"/>
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join("");

      loadingBox.style.display = "none";
      errorBox.style.display = "none";
      emptyState.style.display = "none";
      classListEl.style.display = "flex";
    }

    async function getCurrentUser(sb){
      const { data, error } = await sb.auth.getUser();
      if (error) throw error;
      if (!data?.user?.id) throw new Error("You need to sign in again.");
      return data.user;
    }

    async function loadMembershipCounts(sb, courseIds){
      membershipCountMap = {};
      if (!courseIds.length) return;

      const { data, error } = await sb
        .from("course_memberships")
        .select("course_id")
        .in("course_id", courseIds);

      if (error) throw error;

      for (const row of data || []) {
        const key = row.course_id;
        membershipCountMap[key] = (membershipCountMap[key] || 0) + 1;
      }
    }

    async function loadClasses(){
      const sb = window.supabase;
      if (!sb) {
        throw new Error("Supabase is not ready.");
      }

      const user = await getCurrentUser(sb);

      const { data, error } = await sb
        .from("courses")
        .select(`
          id,
          created_by,
          course_code,
          course_title,
          academic_session,
          allowed_programs,
          allowed_levels,
          allowed_program_levels,
          invite_code,
          created_at
        `)
        .eq("created_by", user.id)
        .order("created_at", { ascending: false });

      if (error) throw error;

      allClasses = data || [];
      await loadMembershipCounts(sb, allClasses.map((row) => row.id));
      renderClasses(allClasses);
    }

    async function boot(){
      try {
        loadingBox.style.display = "block";
        errorBox.style.display = "none";
        emptyState.style.display = "none";
        classListEl.style.display = "none";

        await loadClasses();
      } catch (err) {
        loadingBox.style.display = "none";
        errorBox.style.display = "block";
        errorBox.textContent = err?.message || "Failed to load classes.";
      }
    }

    createClassBtn.addEventListener("click", goToCreateClass);
    emptyCreateBtn.addEventListener("click", goToCreateClass);
    searchInput.addEventListener("input", () => renderClasses(allClasses));

    window.goToClassDetails = goToClassDetails;
    window.goToEditClass = goToEditClass;
    window.goToAttendance = goToAttendance;
    window.showMoreMenu = showMoreMenu;

    window.addEventListener("load", boot);
  </script>
</body>
</html>
