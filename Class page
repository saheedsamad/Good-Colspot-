      </div>

      <div class="row">
        <div class="label">Instruction</div>
        <textarea id="activityInstructionInput" class="textarea" placeholder="Write a short instruction for students..."></textarea>
      </div>

      <div class="row">
        <div class="label">Select class</div>
        <input
          id="activityClassSearchInput"
          type="text"
          class="search-input"
          placeholder="Search class by course code or title…"
        />
        <div id="activityClassList" class="recent-list" style="margin-top:8px;"></div>
      </div>

      <div class="grid-2">
        <div class="row">
          <div class="label">Due date</div>
          <input id="activityDueInput" class="input" type="datetime-local" />
