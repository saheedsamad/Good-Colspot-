<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colspot – Account</title>

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --bg1: #eef3fb;
      --bg2: #f8fbff;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --error: #dc2626;
      --success: #16a34a;
    }

    * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Inter, sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #dbeafe 0, #eef2ff 35%, #f9fafb 90%);
      display: flex;
      justify-content: center;
      padding: 16px;
    }

    .phone-shell {
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      background: linear-gradient(180deg, #f1f5ff 0%, #ffffff 30%, #ffffff 100%);
      border-radius: 26px;
      box-shadow: 0 20px 55px rgba(15, 23, 42, 0.18);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header {
      padding: 14px 16px 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .logo-img {
      height: 26px;
      width: auto;
      border-radius: 8px;
      display: block;
    }

    .header-title-block {
      display: flex;
      flex-direction: column;
    }

    .header-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
    }

    .header-sub {
      font-size: 12px;
      color: var(--text-muted);
    }

    .header-pill-btn {
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .header-pill-btn.primary {
      background: #e0ecff;
      border-color: #d1ddff;
      color: var(--blue-dark);
    }

    .back-btn-circle {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-right: 4px;
    }

    .back-btn-circle svg {
      width: 16px;
      height: 16px;
      stroke: #4b5563;
      stroke-width: 2;
      fill: none;
    }

    main {
      flex: 1;
      overflow-y: auto;
      padding: 0 16px 16px;
    }

    .profile-card {
      background: #f9fafb;
      border-radius: 24px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
      padding: 18px 16px 18px;
      margin-bottom: 14px;
    }

    .profile-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .avatar-circle {
      width: 88px;
      height: 88px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 20%, #bfdbfe 0, #2563eb 90%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 40px;
      font-weight: 700;
      position: relative;
      overflow: hidden;
    }

    .avatar-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .avatar-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.15);
    }

    .avatar-badge svg {
      width: 14px;
      height: 14px;
      stroke: #4b5563;
      stroke-width: 1.7;
      fill: none;
    }

    .change-avatar-btn {
      margin-top: 6px;
      padding: 6px 16px;
      border-radius: 999px;
      border: 1px solid #d1ddff;
      background: #e0ecff;
      font-size: 12px;
      font-weight: 500;
      color: var(--blue-dark);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .profile-name {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
    }

    .profile-meta-line,
    .profile-email-line {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .profile-meta-line svg,
    .profile-email-line svg {
      width: 14px;
      height: 14px;
      stroke-width: 1.7;
      stroke: #6b7280;
      fill: none;
    }

    .role-pill {
      margin-top: 8px;
      padding: 4px 14px;
      border-radius: 999px;
      background: #e5edff;
      color: #1e40af;
      font-size: 11px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .profile-detail-card {
      margin-top: 12px;
      border-radius: 20px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      padding: 4px 0;
    }

    .detail-row {
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .detail-row + .detail-row {
      border-top: 1px solid #e5e7eb;
    }

    .detail-icon {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: #eef2ff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .detail-icon svg {
      width: 16px;
      height: 16px;
      stroke-width: 1.7;
      stroke: #4f46e5;
      fill: none;
    }

    .detail-text {
      flex: 1;
      min-width: 0;
    }

    .detail-label {
      font-size: 12px;
      color: var(--text-muted);
    }

    .detail-value {
      font-size: 14px;
      color: var(--text-main);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .chevron {
      width: 16px;
      height: 16px;
      stroke: #d1d5db;
      stroke-width: 2;
      fill: none;
    }

    .section-heading {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      margin: 8px 4px 4px;
    }

    .actions-row {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }

    .action-btn {
      flex: 1;
      padding: 9px 10px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
    }

    .action-btn.logout {
      border-color: #fecaca;
      background: #fef2f2;
      color: #b91c1c;
    }

    .action-btn svg {
      width: 16px;
      height: 16px;
      stroke-width: 1.7;
      stroke: currentColor;
      fill: none;
    }

    .form-group {
      margin: 6px 4px;
    }

    .form-label {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .text-input {
      width: 100%;
      padding: 9px 12px;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      font-size: 14px;
    }

    .text-input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
    }

    .primary-btn-large {
      width: calc(100% - 32px);
      margin: 10px 16px 6px;
      padding: 11px 16px;
      border-radius: 999px;
      border: none;
      background: var(--blue);
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 14px 30px rgba(37, 99, 235, 0.45);
    }

    .primary-btn-large:active {
      transform: scale(0.97);
    }

    .status-text {
      font-size: 12px;
      margin: 0 18px 4px;
      min-height: 16px;
    }

    .status-text.success {
      color: var(--success);
    }

    .status-text.error {
      color: var(--error);
    }

    .bottom-nav {
      border-top: 1px solid #e5e7eb;
      padding: 6px 6px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: #ffffff;
    }

    .nav-btn {
      flex: 1;
      border: none;
      background: transparent;
      padding: 4px 4px 0;
      text-align: center;
      cursor: pointer;
      color: #9ca3af;
      font-size: 11px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .nav-btn span.icon svg {
      width: 18px;
      height: 18px;
      stroke-width: 1.7;
      stroke: #9ca3af;
      fill: none;
    }

    .nav-btn.active {
      color: var(--blue);
      font-weight: 600;
    }

    .nav-btn.active span.icon svg {
      stroke: var(--blue);
    }
  </style>
</head>
<body>
  <div class="phone-shell">
    <!-- VIEW HEADER -->
    <header id="headerView">
      <div class="header-left">
        <img src="asset/logo walpaper.jpeg" alt="Colspot logo" class="logo-img" />
        <div class="header-title-block">
          <div class="header-title">Colspot</div>
        </div>
      </div>
      <button class="header-pill-btn" onclick="enterEditMode()">
        Edit
      </button>
    </header>

    <!-- EDIT HEADER -->
    <header id="headerEdit" style="display:none;">
      <div class="header-left">
        <button class="back-btn-circle" onclick="exitEditMode(false)">
          <svg viewBox="0 0 24 24">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <div class="header-title-block">
          <div class="header-title">Edit profile</div>
          <div class="header-sub">View and update your personal details.</div>
        </div>
      </div>
      <button class="header-pill-btn primary" onclick="saveProfile()">
        Save changes
      </button>
    </header>

    <main>
      <!-- VIEW SCREEN -->
      <section id="viewScreen">
        <div class="profile-card">
          <div class="profile-top">
            <div class="avatar-circle">
              <span id="avatarInitial">S</span>
            </div>

            <div class="profile-name" id="viewNameDisplay">Lecturer</div>

            <div class="profile-meta-line">
              <svg viewBox="0 0 24 24">
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
              </svg>
              <span id="viewDeptDisplay">Department</span>
            </div>

            <div class="profile-email-line">
              <svg viewBox="0 0 24 24">
                <path d="M4 6h16v12H4z"></path>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
              <span id="viewEmailDisplay">you@example.com</span>
            </div>

            <div class="role-pill">
              Lecturer account
            </div>
          </div>

          <div class="profile-detail-card">
            <div class="detail-row">
              <div class="detail-icon">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="8" r="3.2"></circle>
                  <path d="M5 18c1-3 3-4.5 7-4.5s6 1.5 7 4.5"></path>
                </svg>
              </div>
              <div class="detail-text">
                <div class="detail-label">Full name</div>
                <div class="detail-value" id="viewNameValue">Lecturer</div>
              </div>
              <svg class="chevron" viewBox="0 0 24 24">
                <path d="M9 6l6 6-6 6"></path>
              </svg>
            </div>

            <div class="detail-row">
              <div class="detail-icon">
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="7" width="16" height="11" rx="2"></rect>
                  <path d="M8 7V5h8v2"></path>
                </svg>
              </div>
              <div class="detail-text">
                <div class="detail-label">Department</div>
                <div class="detail-value" id="viewDeptValue">Department</div>
              </div>
              <svg class="chevron" viewBox="0 0 24 24">
                <path d="M9 6l6 6-6 6"></path>
              </svg>
            </div>

            <div class="detail-row">
              <div class="detail-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M4 6h16v12H4z"></path>
                  <path d="M4 7l8 6 8-6"></path>
                </svg>
              </div>
              <div class="detail-text">
                <div class="detail-label">Email address</div>
                <div class="detail-value" id="viewEmailValue">you@example.com</div>
              </div>
              <!-- no chevron, read-only -->
            </div>
          </div>
        </div>

        <div class="section-heading">Account actions</div>
        <div class="actions-row">
          <button class="action-btn logout" onclick="signOut()">
            <svg viewBox="0 0 24 24">
              <path d="M15 3h4v18h-4"></path>
              <path d="M10 17l5-5-5-5"></path>
              <path d="M4 12h11"></path>
            </svg>
            Log out
          </button>
          <button class="action-btn" onclick="contactUs()">
            <svg viewBox="0 0 24 24">
              <path d="M4 5h16v10H5.5L4 16.5z"></path>
              <path d="M8 9h8"></path>
              <path d="M8 12h4"></path>
            </svg>
            Contact us
          </button>
        </div>
      </section>

      <!-- EDIT SCREEN -->
      <section id="editScreen" style="display:none;">
        <div class="profile-card">
          <div class="profile-top">
            <div class="avatar-circle">
              <span id="editAvatarInitial">S</span>
              <div class="avatar-badge">
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h16v11H4z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
            </div>

            <button class="change-avatar-btn" type="button">
              Change
            </button>

            <div class="profile-name" id="editNameHeading">Lecturer</div>

            <div class="profile-meta-line">
              <svg viewBox="0 0 24 24">
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
              </svg>
              <span id="editDeptHeading">Department</span>
            </div>

            <div class="profile-email-line">
              <svg viewBox="0 0 24 24">
                <path d="M4 6h16v12H4z"></path>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
              <span id="editEmailHeading">you@example.com</span>
            </div>
          </div>

          <div class="form-group">
            <div class="form-label">Full name</div>
            <input id="editFullName" class="text-input" type="text" />
          </div>

          <div class="form-group">
            <div class="form-label">Department</div>
            <input id="editDepartment" class="text-input" type="text" />
          </div>

          <!-- email is NOT editable in MVP -->
        </div>

        <p id="profileStatus" class="status-text"></p>
        <button class="primary-btn-large" onclick="saveProfile()">
          Save changes
        </button>
      </section>
    </main>

    <!-- bottom nav -->
    <nav class="bottom-nav">
      <button class="nav-btn active" onclick="goHome()">
        <span class="icon">
          <svg viewBox="0 0 24 24">
            <path d="M4 11l8-7 8 7"></path>
            <path d="M5 10v10h14V10"></path>
          </svg>
        </span>
        Home
      </button>
      <button class="nav-btn" onclick="goToAttendance()">
        <span class="icon">
          <svg viewBox="0 0 24 24">
            <rect x="5" y="3" width="14" height="18" rx="2"></rect>
            <path d="M9 7h6"></path>
            <path d="M9 11h4"></path>
            <path d="M9 15h4"></path>
          </svg>
        </span>
        Attendance
      </button>
      <button class="nav-btn" onclick="goToHistory()">
        <span class="icon">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8"></circle>
            <path d="M12 8v4l2.5 2.5"></path>
          </svg>
        </span>
        History
      </button>
      <button class="nav-btn" onclick="goToReports()">
        <span class="icon">
          <svg viewBox="0 0 24 24">
            <rect x="4" y="4" width="4" height="16"></rect>
            <rect x="10" y="8" width="4" height="12"></rect>
            <rect x="16" y="12" width="4" height="8"></rect>
          </svg>
        </span>
        Report
      </button>
    </nav>
  </div>

  <!-- Supabase client -->
  <script type="module" src="./client_supabase.js"></script>

  <script>
    let currentUser = null;
    let lecturerProfileLoaded = false;

    function goHome() {
      window.location.href = "main.html";
    }
    function goToAttendance() {
      window.location.href = "attendance.html";
    }
    function goToHistory() {
      window.location.href = "history.html";
    }
    function goToReports() {
      window.location.href = "reports.html";
    }

    function enterEditMode() {
      document.getElementById("headerView").style.display = "none";
      document.getElementById("viewScreen").style.display = "none";
      document.getElementById("headerEdit").style.display = "flex";
      document.getElementById("editScreen").style.display = "block";
    }

    function exitEditMode(saved) {
      if (!saved && lecturerProfileLoaded) {
        applyDataToEdit(getCurrentProfile());
      }
      document.getElementById("headerEdit").style.display = "none";
      document.getElementById("editScreen").style.display = "none";
      document.getElementById("headerView").style.display = "flex";
      document.getElementById("viewScreen").style.display = "block";
    }

    function setStatus(text, type = "") {
      const el = document.getElementById("profileStatus");
      if (!el) return;
      el.textContent = text || "";
      el.classList.remove("success", "error");
      if (type) el.classList.add(type);
    }

    function getCurrentProfile() {
      const name = document.getElementById("viewNameValue").textContent || "";
      const dept = document.getElementById("viewDeptValue").textContent || "";
      const email = document.getElementById("viewEmailValue").textContent || "";
      return { name, dept, email };
    }

    function applyDataToView({ name, dept, email }) {
      const safeName =
        name ||
        (currentUser && currentUser.user_metadata?.full_name) ||
        "Lecturer";  // <-- never fall back to email as name
      const safeDept = dept || "Department";
      const safeEmail = email || (currentUser && currentUser.email) || "";

      const initial = safeName.trim()[0]
        ? safeName.trim()[0].toUpperCase()
        : "C";

      document.getElementById("avatarInitial").textContent = initial;
      document.getElementById("editAvatarInitial").textContent = initial;

      document.getElementById("viewNameDisplay").textContent = safeName;
      document.getElementById("viewNameValue").textContent = safeName;
      document.getElementById("viewDeptDisplay").textContent = safeDept;
      document.getElementById("viewDeptValue").textContent = safeDept;
      document.getElementById("viewEmailDisplay").textContent = safeEmail;
      document.getElementById("viewEmailValue").textContent = safeEmail;

      document.getElementById("editNameHeading").textContent = safeName;
      document.getElementById("editDeptHeading").textContent = safeDept;
      document.getElementById("editEmailHeading").textContent = safeEmail;
    }

    function applyDataToEdit({ name, dept, email }) {
      document.getElementById("editFullName").value = name || "";
      document.getElementById("editDepartment").value = dept || "";
      // email not editable, just show in header
      document.getElementById("editEmailHeading").textContent =
        email || (currentUser && currentUser.email) || "";
    }

    document.addEventListener("DOMContentLoaded", async () => {
      await new Promise((r) => setTimeout(r, 50));

      if (typeof supabase === "undefined") {
        console.error("Supabase not available on account.html");
        setStatus("Backend not available. Please reload.", "error");
        return;
      }

      const { data, error } = await supabase.auth.getUser();
      if (error || !data || !data.user) {
        window.location.href = "index.html";
        return;
      }

      currentUser = data.user;

      // initial data from auth only – no email as name
      applyDataToView({
        name: currentUser.user_metadata?.full_name || "",
        dept: "",
        email: currentUser.email || ""
      });
      applyDataToEdit(getCurrentProfile());

      await loadLecturerProfile();
    });

    async function loadLecturerProfile() {
      try {
        const { data, error } = await supabase
          .from("lecturers")
          .select("full_name, department")
          .eq("id", currentUser.id)
          .limit(1);

        if (error) {
          console.warn("lecturers read error:", error.message);
        }

        let name =
          currentUser.user_metadata?.full_name ||
          ""; // don't default to email here
        let dept = "";
        const email = currentUser.email || "";

        if (data && data[0]) {
          if (data[0].full_name) name = data[0].full_name;
          if (data[0].department) dept = data[0].department;
        }

        applyDataToView({ name, dept, email });
        applyDataToEdit({ name, dept, email });
        lecturerProfileLoaded = true;
      } catch (e) {
        console.error("Error loading lecturer profile:", e);
      }
    }

    async function saveProfile() {
      if (!currentUser) return;
      setStatus("Saving...", "success");

      const name = document.getElementById("editFullName").value.trim();
      const dept = document.getElementById("editDepartment").value.trim();
      const email = currentUser.email || "";

      if (!name) {
        setStatus("Please enter your full name.", "error");
        return;
      }

      try {
        // 1) Upsert into lecturers table (id = auth user id)
        const { error: upsertError } = await supabase
          .from("lecturers")
          .upsert(
            {
              id: currentUser.id,
              full_name: name,
              department: dept || null
            },
            { onConflict: "id" }
          );

        if (upsertError) {
          console.error(upsertError);
          throw upsertError;
        }

        // 2) Update auth user metadata (name only, NOT email)
        const { data: updated, error: authError } =
          await supabase.auth.updateUser({
            data: { full_name: name }
          });

        if (authError) {
          console.error(authError);
          throw authError;
        }
        if (updated && updated.user) {
          currentUser = updated.user;
        }

        applyDataToView({ name, dept, email });
        applyDataToEdit({ name, dept, email });

        setStatus("Profile saved.", "success");
        lecturerProfileLoaded = true;
        exitEditMode(true);
      } catch (e) {
        console.error("saveProfile error:", e);
        setStatus(
          "Could not save your profile. Please try again.",
          "error"
        );
      }
    }

    async function signOut() {
      try {
        await supabase.auth.signOut();
      } catch (e) {
        console.error("Sign out error:", e);
      } finally {
        window.location.href = "index.html";
      }
    }

    function contactUs() {
      // UPDATED: go to contact.html screen
      window.location.href = "contact.html";
    }
  </script>
