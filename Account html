      if (rolePill) {
        rolePill.textContent = "Account";
      }
    }

    function applyAccountDataToEdit({ name, dept, email, matric }) {
      const fn = document.getElementById("editFullName");
      const fd = document.getElementById("editDepartment");
      const mInput = document.getElementById("editMatricNumber");
      const mHint = document.getElementById("matricHint");
      const eEmailHeading = document.getElementById("editEmailHeading");

      if (fn) fn.value = name || "";
      if (fd) fd.value = dept || "";
      if (eEmailHeading) {
        eEmailHeading.textContent =
          email || (accountCurrentUser && accountCurrentUser.email) || "";
      }

      if (mInput) {
        mInput.value = matric || "";
        mInput.readOnly = false;
        mInput.classList.remove("readonly");
      }
      if (mHint) {
        mHint.textContent =
          "This can be your matric number or staff ID. We’ll save it so you don’t have to type it again. You can only change it once every 30 days.";
      }
    }

    function getAccountStoredDeviceId() {
      try {
        return localStorage.getItem(ACCOUNT_DEVICE_STORAGE_KEY) || null;
      } catch {
        return null;
      }
    }

    function switchToLearnEarn() {
      window.location.href = "learn_auth.html";
    }

    function openVerificationPage() {
      const btn = document.getElementById("verifyUploadBtn");
      if (btn && btn.dataset.locked === "true") {
        return;
      }
      window.location.href = "verify_class.html";
    }

    function setVerificationUiVerified(message = "Your account has already been verified.") {
      const badge = document.getElementById("verifyBadge");
      const text = document.getElementById("verifyStatusText");
      const btn = document.getElementById("verifyUploadBtn");

      if (badge) {
        badge.textContent = "Verified";
        badge.style.background = "#ecfdf5";
        badge.style.borderColor = "#bbf7d0";
        badge.style.color = "#15803d";
      }

      if (text) {
        text.textContent = message;
        text.classList.remove("error");
        text.classList.add("success");
      }

      if (btn) {
        btn.textContent = "Verified";
        btn.dataset.locked = "true";
        btn.disabled = true;
      }
    }

    function setVerificationUiPending(message = "Your uploaded clearance form is under review.") {
      const badge = document.getElementById("verifyBadge");
      const text = document.getElementById("verifyStatusText");
      const btn = document.getElementById("verifyUploadBtn");

      if (badge) {
        badge.textContent = "Pending";
        badge.style.background = "#fff7ed";
        badge.style.borderColor = "#fed7aa";
        badge.style.color = "#c2410c";
      }

      if (text) {
        text.textContent = message;
        text.classList.remove("success");
        text.classList.remove("error");
      }

      if (btn) {
        btn.textContent = "Pending review";
        btn.dataset.locked = "true";
        btn.disabled = true;
      }
    }

    function setVerificationUiNotVerified(message = "Upload your clearance form to verify your account.") {
      const badge = document.getElementById("verifyBadge");
      const text = document.getElementById("verifyStatusText");
      const btn = document.getElementById("verifyUploadBtn");

      if (badge) {
        badge.textContent = "Not verified";
        badge.style.background = "#eff6ff";
        badge.style.borderColor = "#dbeafe";
        badge.style.color = "#1d4ed8";
      }

      if (text) {
        text.textContent = message;
        text.classList.remove("success");
        text.classList.remove("error");
      }

      if (btn) {
        btn.textContent = "Upload clearance form";
        btn.dataset.locked = "false";
        btn.disabled = false;
      }
    }

    async function loadAccountVerification() {
      if (!accountCurrentUser) return;

      try {
        const { data, error } = await supabase
          .from("verification_clearance")
          .select("status, created_at")
          .eq("user_id", accountCurrentUser.id)
          .order("created_at", { ascending: false })
          .limit(1);

        if (error) {
          console.error("loadAccountVerification error:", error);
          setVerificationUiNotVerified("Upload your clearance form to verify your account.");
          return;
        }

        const row = Array.isArray(data) && data.length ? data[0] : null;
        const status = String(row?.status || "").trim().toLowerCase();

        if (status === "successful" || status === "verified") {
          setVerificationUiVerified("Your clearance form has already been approved.");
          return;
        }

        if (status === "pending" || status === "under_review") {
          setVerificationUiPending("Your uploaded clearance form is under review.");
          return;
        }

        setVerificationUiNotVerified();
      } catch (e) {
        console.error("loadAccountVerification fatal:", e);
        setVerificationUiNotVerified("Upload your clearance form to verify your account.");
      }
    }

    document.addEventListener("DOMContentLoaded", async () => {
      await new Promise((r) => setTimeout(r, 50));

      if (typeof supabase === "undefined") {
        console.error("Supabase not available on account screen");
        setAccountStatus("Backend not available. Please reload.", "error");
        return;
      }

      const { data, error } = await supabase.auth.getUser();
      if (error || !data || !data.user) {
        return;
      }

      accountCurrentUser = data.user;

      applyAccountDataToView({
        name: accountCurrentUser.user_metadata?.full_name || "",
        dept: "",
        email: accountCurrentUser.email || "",
        matric: ""
      });
      applyAccountDataToEdit(getAccountCurrentProfile());

      await loadAccountProfile();
      await loadAccountDevices();
      await loadAccountVerification();
    });

    async function loadAccountProfile() {
      if (!accountCurrentUser) return;

      try {
        const { data: profiles, error } = await supabase
          .from("student_profiles")
          .select("full_name, department, matric_number")
          .eq("user_id", accountCurrentUser.id)
          .limit(1);

        if (!error && profiles && profiles[0]) {
          const row = profiles[0];

          const name =
            row.full_name ||
            accountCurrentUser.user_metadata?.full_name ||
            "";
          const dept = row.department || "";
          const matric = row.matric_number || "";
          const email = accountCurrentUser.email || "";

          applyAccountDataToView({
            name,
            dept,
            email,
            matric
          });
          applyAccountDataToEdit({ name, dept, email, matric });
          lecturerProfileLoaded = true;
          return;
        }

        const name =
          accountCurrentUser.user_metadata?.full_name || "Lecturer";
        const dept = "";
        const email = accountCurrentUser.email || "";
        const matric = "";

        applyAccountDataToView({
          name,
          dept,
          email,
          matric
        });
        applyAccountDataToEdit({ name, dept, email, matric });
        lecturerProfileLoaded = true;
      } catch (e) {
        console.error("Error loading account profile:", e);
      }
    }

    async function saveAccountProfile() {
      if (!accountCurrentUser) return;
      setAccountStatus("Saving...", "success");

      const fn = document.getElementById("editFullName");
      const fd = document.getElementById("editDepartment");
      const fm = document.getElementById("editMatricNumber");

      const name = fn ? fn.value.trim() : "";
      const dept = fd ? fd.value.trim() : "";
      const matric = fm ? fm.value.trim() : "";
      const email = accountCurrentUser.email || "";

      if (!name) {
        setAccountStatus("Please enter your full name.", "error");
        return;
      }

      try {
        let existingMatric = "";
        let existingLastUpdated = null;

        const { data: existingRows, error: existingError } = await supabase
          .from("student_profiles")
          .select("matric_number, matric_last_updated_at")
          .eq("user_id", accountCurrentUser.id)
          .limit(1);

        if (!existingError && existingRows && existingRows[0]) {
          existingMatric = existingRows[0].matric_number || "";
          existingLastUpdated =
            existingRows[0].matric_last_updated_at || null;
        }

        const changedMatric =
          (existingMatric || "") !== (matric || "");

        if (changedMatric && existingLastUpdated) {
          const last = new Date(existingLastUpdated);
          const now = new Date();
          const diffMs = now.getTime() - last.getTime();
          const diffDays = diffMs / (1000 * 60 * 60 * 24);

          if (diffDays < 30) {
            const remainingDays = Math.ceil(30 - diffDays);
            const nextDate = new Date(
              last.getTime() + 30 * 24 * 60 * 60 * 1000
            );
            const nextDateStr = nextDate.toLocaleDateString(undefined, {
              year: "numeric",
              month: "short",
              day: "numeric"
            });

            setAccountStatus(
              `You can only change your matric/staff ID once every 30 days. You last changed it on ${last.toLocaleDateString()}. You can change it again from ${nextDateStr} (about ${remainingDays} day(s) left).`,
              "error"
            );
            return;
          }
        }

        const updates = {
          user_id: accountCurrentUser.id,
          full_name: name,
          department: dept || null,
          matric_number: matric || null
        };

        if (changedMatric) {
          updates.matric_last_updated_at = new Date().toISOString();
        }

        const { error: upsertError } = await supabase
          .from("student_profiles")
          .upsert(updates, { onConflict: "user_id" });

        if (upsertError) {
          console.error(upsertError);
          throw upsertError;
        }

        const { data: updated, error: authError } =
          await supabase.auth.updateUser({
            data: { full_name: name }
          });

        if (authError) {
          console.error(authError);
          throw authError;
        }
        if (updated && updated.user) {
          accountCurrentUser = updated.user;
        }

        applyAccountDataToView({
          name,
          dept,
          email,
          matric
        });
        applyAccountDataToEdit({
          name,
          dept,
          email,
          matric
        });

        setAccountStatus("Profile saved.", "success");
        lecturerProfileLoaded = true;
        exitAccountEditMode(true);
      } catch (e) {
        console.error("saveAccountProfile error:", e);
        setAccountStatus(
          "Could not save your profile. Please try again.",
          "error"
        );
      }
    }

    async function loadAccountDevices() {
      const list = document.getElementById("devicesList");
      const statusEl = document.getElementById("devicesStatus");
      const badge = document.getElementById("devicesCountBadge");

      if (!accountCurrentUser || !list || !statusEl || !badge) return;

      list.innerHTML = "";
      statusEl.textContent = "Loading devices...";

      const currentDeviceId = getAccountStoredDeviceId();

      try {
        const { data, error } = await supabase
          .from("user_devices")
          .select("id, device_id, created_at")
          .eq("user_id", accountCurrentUser.id)
          .order("created_at", { ascending: true });

        if (error) {
          console.error("loadDevices error:", error);
          statusEl.textContent =
            "Could not load your devices. Please pull to refresh later.";
          return;
        }

        const devices = data || [];
        badge.textContent = `${devices.length} / 2`;

        if (devices.length === 0) {
          statusEl.textContent =
            "No devices linked yet. When you sign in on a phone, it will appear here.";
          return;
        }

        statusEl.textContent = "";

        devices.forEach((row) => {
          const isThis = currentDeviceId && row.device_id === currentDeviceId;

          const deviceRow = document.createElement("div");
          deviceRow.className = "device-row";

          const main = document.createElement("div");
          main.className = "device-main";

          const icon = document.createElement("div");
          icon.className = "device-icon";
          icon.innerHTML = `
            <svg viewBox="0 0 24 24">
              <rect x="7" y="3" width="10" height="18" rx="2"></rect>
              <circle cx="12" cy="17" r="1"></circle>
            </svg>
          `;

          const text = document.createElement("div");
          text.className = "device-text";

          const nameEl = document.createElement("div");
          nameEl.className = "device-name";
          nameEl.textContent = isThis ? "This phone" : "Other device";

          const metaEl = document.createElement("div");
          metaEl.className = "device-meta";
          const created = row.created_at
            ? new Date(row.created_at).toLocaleString()
            : "";
          metaEl.textContent = created
            ? `Linked on ${created}`
            : "Linked device";

          const tags = document.createElement("div");
          tags.className = "device-tags";

          const primaryPill = document.createElement("span");
          primaryPill.className = "device-pill primary";
          primaryPill.textContent = isThis ? "Active here" : "Signed in";

          tags.appendChild(primaryPill);

          if (!isThis) {
            const warnPill = document.createElement("span");
            warnPill.className = "device-pill";
            warnPill.textContent = "You can remove this";
            tags.appendChild(warnPill);
          }

          text.appendChild(nameEl);
          text.appendChild(metaEl);
          text.appendChild(tags);

          main.appendChild(icon);
          main.appendChild(text);
          deviceRow.appendChild(main);

          if (!isThis) {
            const removeBtn = document.createElement("button");
            removeBtn.className = "device-remove-btn";
            removeBtn.textContent = "Remove";
            removeBtn.onclick = () => removeAccountDevice(row.id);
            deviceRow.appendChild(removeBtn);
          }

          list.appendChild(deviceRow);
        });
      } catch (e) {
        console.error("loadDevices error:", e);
        statusEl.textContent =
          "Could not load your devices. Please try again later.";
      }
    }

    async function removeAccountDevice(id) {
      if (!id) return;
      const confirmed = window.confirm(
        "Remove this device? It will be signed out from Colspot."
      );
      if (!confirmed) return;

      try {
        const { error } = await supabase
          .from("user_devices")
          .delete()
          .eq("id", id);

        if (error) {
          console.error("removeDevice error:", error);
          alert("Could not remove this device. Please try again.");
          return;
        }

        await loadAccountDevices();
      } catch (e) {
        console.error("removeDevice error:", e);
        alert("Could not remove this device. Please try again.");
      }
    }

    async function accountSignOut() {
      try {
        if (typeof supabase !== "undefined") {
          await supabase.auth.signOut();
        }
      } catch (e) {
        console.error("Sign out error:", e);
      } finally {
        try {
          localStorage.removeItem("colspot_local_user");
        } catch (e) {
          console.error("Failed to clear local user cache on logout:", e);
        }

        window.location.href = "index.html";
      }
    }

    function accountContactUs() {
      window.location.href = "contact.html";
    }

    async function accountDeleteAccount() {
      if (!accountCurrentUser) {
        alert("We could not find your account. Please sign in again.");
        return;
      }

      const confirmed = window.confirm(
        "This will permanently delete your Colspot data for this account, including classes, attendance sessions, attendees, warmup locations, scans and linked devices. You won’t be able to undo this. Continue?"
      );
      if (!confirmed) return;

      const typed = window.prompt(
        "To confirm, type DELETE in capital letters and tap OK."
      );
      if (!typed || typed.trim().toUpperCase() !== "DELETE") {
        alert("Account deletion cancelled. You did not type DELETE.");
        return;
      }

      const userId = accountCurrentUser.id;

      try {
        if (typeof supabase !== "undefined") {
          let sessionIds = [];
          try {
            const { data: sessions, error: sessionsError } = await supabase
              .from("attendance_sessions")
              .select("id")
              .eq("created_by", userId);

            if (!sessionsError && sessions && sessions.length > 0) {
              sessionIds = sessions.map((s) => s.id);
            }
          } catch (e) {
            console.warn("Could not load lecturer sessions for delete:", e);
          }

          const deletions = [];

          if (sessionIds.length > 0) {
            deletions.push(
              supabase
                .from("attendance_records")
                .delete()
                .in("session_id", sessionIds)
            );
          }

          deletions.push(
            supabase.from("user_devices").delete().eq("user_id", userId)
          );

          deletions.push(
            supabase
              .from("attendance_warmup_main")
              .delete()
              .eq("lecturer_id", userId)
          );
          deletions.push(
            supabase
              .from("attendance_warmup_attendance")
              .delete()
              .eq("lecturer_id", userId)
          );

          deletions.push(
            supabase
              .from("attendance_sessions")
              .delete()
              .eq("created_by", userId)
          );

          deletions.push(
            supabase.from("scan_sheets").delete().eq("user_id", userId)
          );

          deletions.push(
            supabase.from("lecturers").delete().eq("id", userId)
          );

          await Promise.allSettled(deletions);

          try {
            if (supabase.functions && supabase.functions.invoke) {
              await supabase.functions.invoke("delete_my_account", {
                body: {}
              });
            }
          } catch (e) {
            console.warn("delete_my_account function failed:", e);
          }

          try {
            await supabase.auth.signOut();
          } catch (e) {
            console.warn("signOut after delete failed:", e);
          }
        }

        try {
          localStorage.removeItem("colspot_local_user");
          localStorage.removeItem("colspot_history_cache");
          localStorage.removeItem("colspot_scan_cache");
          localStorage.removeItem(ACCOUNT_DEVICE_STORAGE_KEY);
        } catch (e) {
          console.warn("Failed to clear local cache on delete:", e);
        }

        alert("Your Colspot data for this account has been deleted.");
        window.location.href = "index.html";
      } catch (e) {
        console.error("accountDeleteAccount error:", e);
        alert(
          "We could not delete your data. Please check your internet connection and try again."
        );
      }
    }

    window.enterAccountEditMode = enterAccountEditMode;
    window.saveAccountProfile = saveAccountProfile;
    window.accountSignOut = accountSignOut;
    window.accountContactUs = accountContactUs;
    window.accountDeleteAccount = accountDeleteAccount;
    window.switchToLearnEarn = switchToLearnEarn;
    window.openVerificationPage = openVerificationPage;
  </script>
